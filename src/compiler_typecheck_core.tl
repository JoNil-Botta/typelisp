            [body-env : TcTypeEnv
              (tc-bind-id keep-env slot (tc-resolve-type ctx slot-ty))]
            [keep-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone keep-locals) slot)]
            [outer-borrowed : TcMovedSet
              (try
                (tc-borrow-check-exprs
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  (ast.ast-expr-cons
                    start-box
                    (&
                      (ast.ast-expr-cons
                        end-box
                        (&
                          (ast.ast-expr-cons
                            init-box
                            (& (ast.ast-expr-list-new)))))))))]
            [keep-entry : TcMovedSet
              (tc-moved-remove-root-state (tc-moved-clone outer-borrowed) index)]
            [keep-borrowed
              (try
                (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  keep-env
                  env
                  keep-locals
                  (tc-global-shared-view keep-entry)
                  keep-entry
                  keep))]
            [body-entry : TcMovedSet
              (tc-moved-remove-root-state
                (tc-moved-remove-root-state
                  (tc-moved-clone keep-borrowed)
                  index)
                slot)]
            [body-borrowed
              (try
                (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  body-env
                  env
                  body-locals
                  (tc-global-shared-view body-entry)
                  body-entry
                  body))]
            (Ok
              (tc-borrow-check-loop-visible-body-borrows
                ctx
                env
                keep-borrowed
                (tc-moved-remove-root-state
                  (tc-moved-remove-root-state body-borrowed index)
                  slot))))])]
    [(or (SpmdBroadcast value-box lane-box) (SpmdShuffle value-box lane-box))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              value))]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed1 lane))]
    [(or (WithRegion _ exprs) (WithScratch exprs))
      (let
        [_
          (try
            (tc-borrow-check-exprs
              ctx
              expr-bases
              env
              locals
              (tc-moved-clone borrowed)
              exprs))]
        (Ok borrowed))]
    [(WithEscape scratch-box exprs)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              scratch))]
        [_
          (try
            (tc-borrow-check-exprs
              ctx
              expr-bases
              env
              locals
              (tc-moved-clone borrowed1)
              exprs))]
        (Ok borrowed1))]
    [(InArena arena-box exprs)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              arena))]
        [_
          (try
            (tc-borrow-check-exprs
              ctx
              expr-bases
              env
              locals
              (tc-moved-clone borrowed1)
              exprs))]
        (Ok borrowed1))]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings exprs)
          (match (tc-borrow-check-resource-bindings
            ctx
            expr-bases
            env
            locals
            (tc-moved-clone borrowed)
            bindings)
            [(Ok body-env body-locals body-borrowed)
              (let
                [_
                  (try
                    (tc-borrow-check-exprs-with-protected
                      ctx
                      expr-bases
                      body-env
                      body-locals
                      body-borrowed
                      (tc-global-shared-view borrowed)
                      exprs))]
                (Ok borrowed))]
            [(Err message) (Err message)])])]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              inner))]
        (tc-borrow-check-place-read-conflict
          expr-bases
          locals
          borrowed1
          (tc-global-shared-view expr)
          expr))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              (tc-global-shared-view inner)))]
        (match (tc-expr ctx env (tc-global-shared-view expr))
          [(Ok result-ty)
            (if (tc-type-move-only? ctx (tc-global-shared-view result-ty))
              (match (tc-expr ctx env (tc-global-shared-view inner))
                [(Ok receiver-ty)
                  (match (tc-type-strip-region
                    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
                    [(Box _)
                      (tc-borrow-check-after-consuming-value
                        ctx
                        expr-bases
                        env
                        locals
                        borrowed1
                        inner
                        receiver-ty)]
                    [(Ref _ _)
                      (Err
                        (tc-move-out-of-reference-message
                          expr-bases
                          expr
                          result-ty
                          1
                          (tc-move-out-of-deref-help)))]
                    [(MutRef _ _)
                      (Err
                        (tc-move-out-of-reference-message
                          expr-bases
                          expr
                          result-ty
                          2
                          (tc-move-out-of-deref-help)))]
                    [_ (Ok borrowed1)])]
                [(Err _) (Ok borrowed1)])
              (tc-borrow-check-place-read-conflict
                expr-bases
                locals
                borrowed1
                (tc-global-shared-view expr)
                expr))]
          [(Err _) (Ok borrowed1)]))]
    [(BoxSet box-box value-box)
      (let
        [box-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases box-box)]
        [_value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              (tc-global-shared-view box-expr)))]
        [borrowed2
          (try
            (tc-borrow-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed1
              value-box))]
        [borrowed3
          (try
            (tc-borrow-check-after-bind-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed2
              value-box))]
        [_
          (try
            (tc-borrow-check-root-mutation-conflict
              expr-bases
              locals
              (tc-global-shared-view borrowed3)
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-box-get box-box))
              box-expr))]
        (Ok borrowed3))]
    ;; As in move analysis, a folded CTFE subtree cannot retain a runtime
    ;; borrow. The ordinary typecheck/CTFE pass has already validated it.
    [(Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              (tc-global-shared-view inner)))]
        (match (tc-current-return-type env)
          [(Ok return-ty)
            (tc-borrow-check-after-consuming-value
              ctx
              expr-bases
              env
              locals
              borrowed1
              inner
              return-ty)]
          [(Err _) (Ok borrowed1)]))]
    ;; The loop-path walker collects these exit states when the `break` or
    ;; `continue` sits inside a form it has no arm for (#8671).
    [(Break)
      (tc-body-borrow-loop-exit-note!
        (tc-context-body-state ctx)
        (& borrowed)
        true)
      (Ok borrowed)]
    [(Continue)
      (tc-body-borrow-loop-exit-note!
        (tc-context-body-state ctx)
        (& borrowed)
        false)
      (Ok borrowed)]
    [(PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed place))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              ptr))]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed1 value))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              ptr))]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed1 offset))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              ptr))]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed1 len))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        [borrowed1
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              leaf))]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed1 subleaf))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-borrow-check-expr ctx expr-bases env locals borrowed index))]
    [(Syscall args)
      (tc-borrow-check-read-exprs ctx expr-bases env locals borrowed args)]
    ;; A foreach-active body is a loop body, checked like a foreach body.
    [(ForeachActive lane body-box)
      (let
        [body-entry : TcMovedSet
          (tc-moved-remove-root-state (tc-moved-clone borrowed) lane)]
        (tc-borrow-loop-result-exit-state
          ctx
          env
          (tc-global-shared-view body-entry)
          lane
          (tc-borrow-check-loop-body
            ctx
            expr-bases
            (tc-bind-id env lane (I64))
            env
            (tc-moved-add (tc-moved-clone locals) lane)
            (tc-global-shared-view body-entry)
            body-entry
            (ast.ast-expr-segment-bases-get expr-bases body-box))))]
    [(LaneValue value-box)
      (tc-borrow-check-expr
        ctx
        expr-bases
        env
        locals
        borrowed
        (ast.ast-expr-segment-bases-get expr-bases value-box))]))

;; --- borrow-check relevance gate --------------------------------------------
;;
;; The borrow checker can only fire on borrow-relevant constructs: `&` borrow
;; creation, consuming Box dereference, `with-region` blocks, calls to functions
;; whose signature mentions a region, and region-typed parameters/results
;; (which seed borrowed places). A body with none of those checks out as a pure
;; pass-through, so the gate answers
;; `Ok` without walking. A call whose recorded callee type (the body type
;; facts from the tc-expr walk) contains no region keeps its Fallback lifetime
;; handling, which cannot error either; a fact Miss stays conservative.
(define (tc-borrow-gate-call-has-region? [ctx : TcContext] [func-id : i64]) : bool
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) func-id)
    [(Hit fn-ty) (tc-type-contains-any-region fn-ty)]
    [(Miss) true]))

;; A callee that keeps no borrow past the call: each parameter is free of
;; lifetimes or a reference to a referent free of them, and so is the result.
;; Such a call's borrows end when it returns, so in a body with no other
;; borrow-relevant form the borrow check can only object to two of its
;; arguments using the same variable.
(define (tc-borrow-gate-call-scoped-callee? [ctx : TcContext] [func-id : i64]) : bool
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) func-id)
    [(Hit fn-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
        [(Func params ret)
          (and
            (not
              (tc-type-contains-any-region
                (tc-resolve-type ctx (ast.ty-node-get ret))))
            (tc-borrow-gate-call-scoped-params-at?
              ctx
              (ast.ast-type-list-box-shared-view params)
              0))]
        [_ false])]
    [(Miss) false]))

(define (tc-borrow-gate-call-scoped-params-at?
  [ctx : TcContext]
  [params : ast.AstTypeList]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len (& params)))
    true
    (let
      [param : ast.AstType
        (tc-resolve-type
          ctx
          (ast.ty-node-get
            (ast.ast-type-list-get (& params) index (ast.ast-type-id-fallback))))]
      [referent : i64
        (match (& param)
          [(or (Ref _ inner) (MutRef _ inner)) inner]
          [_ -1])]
      (and
        (not
          (tc-type-contains-any-region
            (if (>= referent 0)
              (tc-resolve-type ctx (ast.ty-node-get referent))
              param)))
        (tc-borrow-gate-call-scoped-params-at? ctx params (+ index 1))))))

;; The variable a call argument names as a place, borrowed explicitly or
;; possibly auto-borrowed: `x`, `x.f`, `(& x.f)` or `(&mut x)`. -1 for any
;; other argument, and -2 for a borrow the gate does not look through.
(define (tc-borrow-gate-arg-root [expr-bases : i64] [arg : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(Borrow _ lifetime-id operand-box)
      (match (ast.ast-borrow-lifetime-from-id lifetime-id)
        [(ast.AstBorrowLifetime.Inferred)
          (let
            [root : i64
              (tc-borrow-gate-place-root
                expr-bases
                (ast.ast-expr-segment-bases-get expr-bases operand-box))]
            (if (>= root 0)
              root
              (if (tc-borrow-operand-id-temporary? expr-bases operand-box)
                -1
                -2)))]
        [_ -2])]
    [_ (tc-borrow-gate-place-root expr-bases arg)]))

;; The root variable of a variable or field path, or -1.
(define (tc-borrow-gate-place-root [expr-bases : i64] [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name) name]
    [(StructGet receiver-box _)
      (tc-borrow-gate-place-root
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases receiver-box))]
    [_ -1]))

;; Whether a call-scoped call's arguments leave the borrow check nothing to
;; find: each is a borrow of a place or a temporary, or a form the gate finds
;; irrelevant, and no argument's place variable occurs in another argument.
(define (tc-borrow-gate-call-scoped-args-inert?
  [ctx : TcContext]
  [expr-bases : i64]
  [args : ast.AstExprList]) : bool
  (let
    [count : i64 (ast.ast-expr-list-len (& args))]
    [i : i64 0]
    [inert : bool true]
    (while (and inert (< i count))
      (let
        [arg : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get (& args) i 0))]
        [root : i64
          (tc-borrow-gate-arg-root expr-bases (tc-global-shared-view arg))]
        (cond
          [(= root -2) (set! inert false)]
          [(>= root 0)
            (when
              (or
                (tc-borrow-gate-dotted-name? ctx root)
                (tc-borrow-gate-name-in-other-args?
                  ctx
                  expr-bases
                  (& args)
                  i
                  root))
              (set! inert false))]
          [(tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
                [(Borrow _ _ operand-box)
                  (ast.ast-expr-segment-bases-get expr-bases operand-box)]
                [_ arg]))
            (set! inert false)]
          [else unit])
        (set! i (+ i 1))))
    inert))

(define (tc-borrow-gate-dotted-name? [ctx : TcContext] [name : i64]) : bool
  (>= (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name) 0))

(define (tc-borrow-gate-name-in-other-args?
  [ctx : TcContext]
  [expr-bases : i64]
  [args : (& args ast.AstExprList)]
  [skip : i64]
  [name : i64]) : bool
  (let
    [count : i64 (ast.ast-expr-list-len args)]
    [j : i64 0]
    [found : bool false]
    (while (and (not found) (< j count))
      (when
        (and
          (!= j skip)
          (tc-borrow-gate-expr-mentions?
            ctx
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get args j 0))
            name))
        (set! found true))
      (set! j (+ j 1)))
    found))

;; Whether an expression mentions a variable, or any dotted name that might
;; reach it. A called function's name is not a mention.
(define (tc-borrow-gate-expr-mentions?
  [ctx : TcContext]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : i64]) : bool
  (match (tc-global-shared-view expr)
    [(Var other) (or (= other name) (tc-borrow-gate-dotted-name? ctx other))]
    [(Set target value-box)
      (or
        (= target name)
        (tc-borrow-gate-dotted-name? ctx target)
        (tc-borrow-gate-expr-mentions?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases value-box)
          name))]
    [(Call _ args)
      (let
        [count : i64 (ast.ast-expr-list-len (& args))]
        [j : i64 0]
        [found : bool false]
        (while (and (not found) (< j count))
          (when
            (tc-borrow-gate-expr-mentions?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-list-get (& args) j 0))
              name)
            (set! found true))
          (set! j (+ j 1)))
        found)]
    [_
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
        [j : i64 0]
        [found : bool false]
        (while (and (not found) (< j children.len))
          (when
            (tc-borrow-gate-expr-mentions?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-list-get (& children) j -1))
              name)
            (set! found true))
          (set! j (+ j 1)))
        found)]))

(define (tc-borrow-gate-expr-ty-has-region? [ctx : TcContext] [expr-id : i64]) : bool
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) expr-id)
    [(Hit ty) (tc-type-contains-any-region ty)]
    [(Miss) true]))

(define (tc-borrow-gate-exprs-relevant?
  [ctx : TcContext]
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : bool
  (let
    [i : i64 0]
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    [found : bool false]
    (while (and (not found) (< i count))
      (if (tc-borrow-gate-expr-relevant?
        ctx
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& exprs) i 0)))
        (set! found true)
        (set! i (+ i 1))))
    found))

(define (tc-borrow-gate-let-bindings-relevant?
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len (& bindings)))
    false
    (match (ast.ast-let-binding-list-get
      (& bindings)
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ maybe-ty init-box)
        (or
          (match maybe-ty
            [(Some ty) (tc-type-contains-any-region (tc-resolve-type ctx ty))]
            [(No) false])
          (tc-borrow-gate-expr-relevant?
            ctx
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases init-box))
          (tc-borrow-gate-let-bindings-relevant?
            ctx
            expr-bases
            bindings
            (+ index 1)))])))

(define (tc-borrow-gate-match-arms-relevant?
  [ctx : TcContext]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [index : i64]) : bool
  (if (>= index (ast.ast-match-arm-list-len (& arms)))
    false
    (match (ast.ast-match-arm-list-get
      (& arms)
      index
      (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (or
          (tc-borrow-gate-expr-relevant?
            ctx
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box))
          (tc-borrow-gate-match-arms-relevant? ctx expr-bases arms (+ index 1)))])))

(define (tc-borrow-gate-resource-bindings-relevant?
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len (& bindings)))
    false
    (match (ast.ast-resource-binding-list-get
      (& bindings)
      index
      (ast.ast-resource-binding-fallback))
      [(Binding _ _ init-box _)
        (or
          (tc-borrow-gate-expr-relevant?
            ctx
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases init-box))
          (tc-borrow-gate-resource-bindings-relevant?
            ctx
            expr-bases
            bindings
            (+ index 1)))])))

(define (tc-borrow-gate-expr-relevant?
  [ctx : TcContext]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Literal _) (BinaryData _) (Var _) (TypeLiteral _) (Init _)
         (SpmdProgramIndex) (SpmdProgramCount) (Quote _) (Quasiquote _)
         (Unquote _) (UnquoteSplicing _) (Break) (Continue) (PtrNull _)
         (ProgramArgc) (ProgramArgv) (ProgramEnvp))
      false]
    [(or (Binary _ left-box right-box) (ArrayRef left-box right-box)
         (ArrayPush left-box right-box) (StringRef left-box right-box)
         (SpmdBroadcast left-box right-box) (SpmdShuffle left-box right-box)
         (StructSet left-box _ right-box) (BoxSet left-box right-box)
         (PtrWrite left-box right-box) (PtrOffset left-box right-box)
         (StringFromBytes left-box right-box) (CpuIdEax left-box right-box)
         (CpuIdEbx left-box right-box) (CpuIdEcx left-box right-box)
         (CpuIdEdx left-box right-box))
      (or
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases left-box))
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases right-box)))]
    [(or (Unary _ inner-box) (TupleRef inner-box _) (FixedMakeArray _ inner-box)
         (MakeArray _ inner-box) (Set _ inner-box) (Ann inner-box _)
         (Cast inner-box _) (StructGet inner-box _) (Box inner-box)
         (BoxGet inner-box) (Comptime inner-box) (Try inner-box)
         (Return inner-box) (PtrNullCheck inner-box) (PtrAddrOf inner-box)
         (PtrRead inner-box) (PtrCast inner-box _) (PtrToInt inner-box)
         (IntToPtr inner-box _) (StringData inner-box) (ArrayData inner-box)
         (Xgetbv inner-box) (ForeachActive _ inner-box) (LaneValue inner-box))
      (tc-borrow-gate-expr-relevant?
        ctx
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(Call func-box args)
      (or
        (tc-slice-view-call-spelling?
          expr-bases
          (tc-context-structural-session ctx)
          (ast.ast-expr-segment-bases-get expr-bases func-box))
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases func-box))
        (if (tc-borrow-gate-call-has-region? ctx func-box)
          (not
            (and
              (tc-borrow-gate-call-scoped-callee? ctx func-box)
              (tc-borrow-gate-call-scoped-args-inert? ctx expr-bases args)))
          (tc-borrow-gate-exprs-relevant? ctx expr-bases args)))]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items) (WithScratch items) (Syscall items))
      (tc-borrow-gate-exprs-relevant? ctx expr-bases items)]
    [(or (If cond-box then-box else-box) (ArraySet cond-box then-box else-box)
         (ArrayTake cond-box then-box else-box))
      (or
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases cond-box))
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases then-box))
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases else-box)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (or
            (tc-borrow-gate-let-bindings-relevant? ctx expr-bases bindings 0)
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (or
            (tc-borrow-gate-params-relevant? ctx params)
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(or (Replace _ _) (Borrow _ _ _) (WithRegion _ _) (BoxTake _)) true]
    [(or (While cond-box body-box) (WithEscape cond-box body-box)
         (InArena cond-box body-box))
      (or
        (tc-borrow-gate-expr-relevant?
          ctx
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases cond-box))
        (tc-borrow-gate-exprs-relevant? ctx expr-bases body-box))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (or
            (tc-borrow-gate-expr-ty-has-region? ctx scrutinee-box)
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box))
            (tc-borrow-gate-match-arms-relevant? ctx expr-bases arms 0))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ _ start-box end-box body-box)
          (or
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases start-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases end-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box body-box)
          (or
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases a-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases b-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases c-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases d-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases start-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases end-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases init-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases value-box)))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (or
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases start-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases end-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases init-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases value-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact _ _ start-box end-box _ _ init-box keep-box body-box)
          (or
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases start-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases end-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases init-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases keep-box))
            (tc-borrow-gate-expr-relevant?
              ctx
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (or
            (tc-borrow-gate-resource-bindings-relevant?
              ctx
              expr-bases
              bindings
              0)
            (tc-borrow-gate-exprs-relevant? ctx expr-bases body))])]
    [_ true]))

;; Region-typed parameters or results seed borrowed places, so the check must
;; run whenever a param or the return type mentions a region.
(define (tc-borrow-gate-params-relevant?
  [ctx : TcContext]
  [params : ast.AstParamList]) : bool
  (let
    [i : i64 0]
    [count : i64 (ast.ast-param-list-len (& params))]
    [found : bool false]
    (while (and (not found) (< i count))
      (match (ast.ast-param-list-get (& params) i (ast.ast-param-fallback))
        [(Param _ ty _)
          (if (tc-type-contains-any-region (tc-resolve-type ctx ty))
            (set! found true)
            (set! i (+ i 1)))])
      unit)
    found))

(define (tc-borrow-check-body-irrelevant?
  [ctx : TcContext]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-id : i64]) : bool
  (if (tc-borrow-gate-params-relevant? ctx params)
    false
    (if (tc-type-contains-any-region (tc-resolve-type ctx ret))
      false
      (let
        [expr-bases : i64 (tc-context-expr-bases ctx)]
        (not
          (tc-borrow-gate-expr-relevant?
            ctx
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-id)))))))

(define (tc-borrow-check-body-id-with-ret
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-id : i64]) : ResultTcUnit
  (if (tc-borrow-check-body-irrelevant?
    ctx
    (tc-global-shared-view params)
    ret
    body-id)
    Ok
    (tc-borrow-check-body-id ctx expr-bases env params body-id)))

(define (tc-borrow-check-body-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body-id : i64]) : ResultTcUnit
  (let
    [_
      (try
        (tc-borrow-check-expr-with-protected-id
          ctx
          expr-bases
          env
          (tc-move-params-locals params (tc-moved-empty))
          (tc-moved-empty)
          (tc-moved-empty)
          body-id))]
    Ok))

;; --- macro expansion phase --------------------------------------------------
;;
;; Pipeline: parse -> EXPAND -> typecheck. When a call head names a `defmacro`,
;; the unevaluated operand forms are passed as `Expr` values (CompilerCtfeValue.Expr) to the
;; transformer, which is run via CTFE; the produced `Expr` is spliced at the
;; call site and re-expanded to a fixpoint (depth-limited). Macro calls in
;; ordinary evaluated positions are expanded; quoted/quasiquoted code is left
;; as data. Programs without macro calls pass through unchanged. The normal
;; typechecker then runs over the expanded program as the post-expansion safety
;; net. Call-site arity and operand signature checks run before the transformer
;; so obvious operand type errors are reported at the macro call site.
(defenum MacroMaybeDecl
  (No)
  ;; Parsed name, definition module, and dense symbol declaration ID.
  ;; Lazy surface-only macros use -1 because they have no symbol-table entry.
  (Some i64 i64 i64 ast.AstMacroParamList ast.AstType ast.AstExpr))

(defstruct MacroHygieneContext
  (macro-name-id i64)
  (definition-module-id i64)
  (declaration-id i64)
  ;; The expanding context's shared block, whose first word addresses its
  ;; symbols; keeping the address instead of the symbols makes this Copy.
  (context-shared u64))

(define (macro-hygiene-symbols [hygiene : (& hygiene MacroHygieneContext)]) : (&
    hygiene
    csym.CompilerSymbols)
  (unsafe
    (ptr-read
      (int->ptr hygiene.context-shared : (Ptr (& hygiene csym.CompilerSymbols))))))

(defenum ResultMacroCallDecl
  (Ok MacroMaybeDecl)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroCallDeclModule
  (Ok MacroMaybeDecl String i64)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum TcMaybeMacroCallHead
  (Some i64 ast.AstSourceSpan)
  (No))

(define (tc-macro-call-head [ctx : TcContext] [expr : ast.AstExpr]) : TcMaybeMacroCallHead
  (match expr
    [(Spanned inner-id span)
      (match (tc-context-expr-get ctx inner-id)
        [(Var name-id) (Some name-id span)]
        [(Spanned nested-id nested-span)
          (tc-macro-call-head ctx (Spanned nested-id nested-span))]
        [(MacroExpansion expanded-id _ _)
          (tc-macro-call-head ctx (Spanned expanded-id span))]
        [_ No])]
    [(MacroExpansion inner-id _ _)
      (tc-macro-call-head ctx (tc-context-expr-get ctx inner-id))]
    [_ No]))

;; Record only call heads whose macro identity has already resolved. A source
;; declaration must still carry a parser-domain name ID; hygiene/template or
;; generated IDs are expansion internals and are not fabricated as editable
;; records. Calls in a generated declaration retain that declaration's explicit
;; generated provenance, with non-editable spans in the public index.
(define (tc-macro-call-site-note!
  [ctx : TcContext]
  [func : ast.AstExpr]
  [macro-name-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]) : unit
  (let
    [state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (if (not (deref data).enabled)
        unit
        (match (tc-macro-call-head ctx func)
          [(Some source-name-id span)
            (let
              [source-head : bool
                (and
                  (ci.intern-renderable-id? source-name-id)
                  (not (ci.intern-generated-id-active? source-name-id))
                  (> (ast.ast-source-span-start-line span) 0)
                  (> (ast.ast-source-span-start-col span) 0))]
              (if (if (deref data).active-editable
                source-head
                true)
                (tc-macro-call-site-state-record!
                  state
                  macro-name-id
                  definition-module-id
                  declaration-id
                  span)
                unit))]
          [(No) unit])))))

(defenum ResultMacroExpr
  (Ok i64)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroCompatCall
  (Ok i64)
  (No)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroExprList
  (Ok ast.AstExprList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroArms
  (Ok ast.AstMatchArmList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroLetBindings
  (Ok ast.AstLetBindingList TcTypeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroLetBindingsBuild
  (Ok TcTypeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroResourceBindings
  (Ok ast.AstResourceBindingList TcTypeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroResourceBindingsBuild
  (Ok TcTypeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroEnv
  (Ok ctfe_support.CtfeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroCheck
  (Ok)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroModuleArg
  (Ok String i64)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroClause
  (Ok ast.AstExprClause)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroClauseList
  (Ok ast.AstExprClauseList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroBindingClause
  (Ok ast.AstExprBindingClause)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroBindingClauseList
  (Ok ast.AstExprBindingClauseList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroDecl
  (Ok ast.AstDecl)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroDecls
  (Ok ast.AstDeclList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroDeclExpansion
  (Ok ast.AstDeclList ast.AstDeclPathList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroDeclsWithPaths
  (Ok ast.AstDeclList ast.AstDeclPathList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroExpand
  (Ok ast.AstProgram ast.AstDeclPathList)
  (Err (Box cdiag.CompilerDiagnostic)))

;; Plan P3 (C3.1): result of rebuilding the live symbols/registries/top-env over
;; the current program view when the decl walk forces a not-yet-materialized
;; generated module inline. Carries the freshly built context + top-env so the
;; walk can continue over the spliced body's tail in the same pass.
(defenum ResultMacroSpliceRebuild
  (Ok TcContext TcTypeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

;; Every forced splice is additive. Ordinary Decls and loaded-file deltas bind
;; only their new declarations; generated modules additionally bind their
;; isolated summary and trailing import marker. Existing unresolved signatures
;; are re-resolved through the cache-local candidate index before one delta
;; cache layer is published. No plan carries or scans the remaining source tail.
(defenum MacroSpliceEnvPlan
  (Extend TcTypeEnv ast.AstDeclList)
  (ExtendGeneratedModule TcTypeEnv ast.AstDeclList ast.AstDeclList))

(defenum MacroMaybeGeneratedModuleExtension
  (No)
  (Some ast.AstDeclList ast.AstDeclList))

(defenum ResultMacroValue
  (Ok ctfe_support.CompilerCtfeValue)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroCapturedValue
  (Ok ctfe_support.CompilerCtfeValue)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroCapturedOperands
  (Ok
    (__tl_dyn-array ctfe_support.CompilerCtfeValue)
    i64
    ctfe_support.CtfeEnv
    ast.AstNodePoolContext)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroValueEnv
  (Ok ctfe_support.CompilerCtfeValue ctfe_support.CtfeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroTypeArg
  (Ok ast.AstType)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum ResultMacroSexpr
  (Ok reader.SpannedSexpr)
  (Err (Box cdiag.CompilerDiagnostic)))

;; What stays fixed while macro output is converted to sexprs and parsed: the
;; expression pool's segment bases that child reads go through, and the
;; structural session that spells names. One reference carries both through
;; the recursive converters.
(defstruct MacroSexprOwner
  (expr-bases i64)
  (session-address i64))

(define (macro-sexpr-owner
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]) : MacroSexprOwner
  (MacroSexprOwner expr-bases session.address))

(define (macro-sexpr-session [owner : (& owner MacroSexprOwner)]) : cis.InternStructuralSessionHandle
  (cis.InternStructuralSessionHandle owner.session-address))

(defenum ResultMacroParsedDecls
  (Ok ast.AstDeclList)
  (Err (Box cdiag.CompilerDiagnostic)))

(defenum MacroMaybeDeclList
  (No)
  (Some ast.AstDeclList))

(defstruct MacroHygieneEnv
  (head i64)
  (state TcMacroState)
  (pools ast.AstNodePoolContext))

(defmacro (macro-hygiene-expr-push [env : Expr] [node : Expr]) : Expr
  `(ast.ast-node-pool-context-expr-push (__tl-project-field ,env pools) ,node))

(defmacro (macro-hygiene-expr-get [env : Expr] [id : Expr]) : Expr
  `(let
    [pools (__tl-project-field ,env pools)]
    (ast.ast-node-pool-context-expr-get (& pools) ,id)))

(defmacro (macro-hygiene-expr-segment-bases [env : Expr]) : Expr
  `(let
    [pools (__tl-project-field ,env pools)]
    (ast.ast-node-pool-context-expr-segment-bases (& pools))))

(defmacro (macro-hygiene-type-get [env : Expr] [id : Expr]) : Expr
  `(let
    [pools (__tl-project-field ,env pools)]
    (ast.ast-node-pool-context-type-get (& pools) ,id)))

;; Per-program traversal and CTFE handoff state. These fields have one owner and
;; lifetime, so keep one flat carrier and avoid compile-time dispatch through
;; artificial nested sections.
(defstruct TcMacroWalkStateData
  (macro-hygiene-env-kinds (__tl_dyn-array i64))
  (macro-hygiene-env-keys (__tl_dyn-array i64))
  (macro-hygiene-env-values (__tl_dyn-array i64))
  (macro-hygiene-env-parents (__tl_dyn-array i64))
  (macro-hygiene-env-slot-count i64)
  (macro-hygiene-env-root-depth i64)
  (macro-hygiene-env-storage-arena i64)
  (macro-expand-active-module String)
  (macro-expand-macro-name-set tc_i64_i64_map.Map)
  (macro-expand-expr-type-macro-name-set tc_i64_i64_map.Map)
  (macro-expand-ctfe-env-ready bool)
  (macro-expand-ctfe-env-value ctfe_support.CtfeEnv)
  (macro-expand-ctfe-env-has-metadata bool)
  (macro-expand-ctfe-env-owner-arena i64)
  (macro-expand-ctfe-env-build-generation i64)
  (macro-expand-ctfe-env-rebuild-pending bool)
  ;; How many lazy-import stubs the cached CTFE env's reflection aliases hold.
  (macro-expand-ctfe-env-import-stubs i64)
  (ctfe-needs-metadata bool)
  (ctfe-macro-state ctfe_support.CompilerCtfeMacroState)
  (macro-live-symbols-ready bool)
  (macro-live-symbols-value csym.CompilerSymbols)
  (macro-live-registries-cell (__tl_dyn-array csym.CompilerRegistries))
  (macro-live-symbols-fallback bool)
  (macro-live-registries-ready bool)
  (macro-live-registries-fallback bool)
  (macro-live-symbols-last-insert-index i64)
  (macro-live-symbols-arena i64)
  (macro-live-symbols-retired-arena i64)
  (macro-live-prescan-ready bool)
  (macro-live-prescan-has-defmacro bool)
  (macro-live-prescan-expr-type-names TcNameIdList)
  (macro-live-prescan-needs-expansion bool)
  (macro-live-prescan-summary-import bool)
  (macro-live-prescan-visible-names TcNameIdList)
  (macro-expand-scratch-enabled bool)
  (macro-expand-scratch-arena i64)
  (macro-decl-generation-arena i64)
  (macro-decl-generation-retired-arena i64)
  (macro-decl-generation-batch-size i64)
  (macro-decl-generation-batch-used i64)
  (macro-splice-generation-arena i64)
  (macro-splice-generation-retired-arena i64)
  ;; The empty-arena marks of the three generations above, recorded when each
  ;; was mapped, so a finished generation is rewound for reuse instead of
  ;; being unmapped and a fresh one mapped (see macro-generation-recycle!).
  (macro-decl-generation-mark i64)
  (macro-splice-generation-mark i64)
  (macro-splice-generation-retired-mark i64)
  (macro-decl-generation-escape-capacity i64)
  (macro-decl-generation-escape-kinds (__tl_dyn-array i64))
  (macro-decl-generation-escape-keys (__tl_dyn-array i64))
  (macro-decl-generation-escape-count i64)
  (macro-decl-generation-escape-overflow bool)
  (macro-decl-generation-active bool)
  (macro-expand-program-structurally-changed bool)
  (macro-active-decl-owner-id i64)
  (macro-active-decl-provenance-id i64)
  (macro-dependency-catalog-handle cload.CompilerLoadDependencyCatalogHandle)
  ;; Source-name provenance IDs repeat across every use of a dependency macro.
  ;; Cache their catalog slot in this compile-job-owned walk state so the hot
  ;; dispatch path does not canonicalize the same source path per invocation.
  (macro-dependency-catalog-slot-cache tc_i64_i64_map.Map)
  ;; Canonical dependency-catalog route metrics. The fixed cell belongs to the
  ;; TcJobState's lazy macro-walk storage, so interleaved jobs and resets never
  ;; observe or erase one another's verification counters.
  (macro-dependency-tlci-route-counters (__tl_dyn-array i64))
  (macro-expand-stdlib-tlci-route-active bool)
  (macro-expand-stdlib-tlci-module-ids sym_i64_env.SymI64Env)
  (dotted-macro-journal-pools (__tl_dyn-array ast.AstNodePoolContext))
  (dotted-macro-journal-ids (__tl_dyn-array i64))
  (dotted-macro-journal-exprs (__tl_dyn-array ast.AstExpr))
  (dotted-macro-journal-len i64)
  (dotted-macro-journal-depth i64))

;; Cold compile-profile census of the five independently reclaimed macro owner
;; classes. Sample only at generation handoffs and the final detach boundary;
;; allocator hot paths remain unchanged.
(cfg
  compile-profile
  (define (compiler-tc-macro-retention-arena-bytes [owner : i64]) : i64
    (allocation_profile.compiler-allocation-profile-arena-bump-bytes owner)))

(cfg
  compile-profile
  (define (compiler-tc-macro-retention-sample-symbols! [state : TcMacroState]) : unit
    (compiler-tc-macro-profile-metric-max!
      state
      tc-profile-live-symbols-max-bytes
      (compiler-tc-macro-retention-arena-bytes
        (tc-macro-walk-field state macro-live-symbols-arena)))
    (compiler-tc-macro-profile-metric-max!
      state
      tc-profile-retired-symbols-max-bytes
      (compiler-tc-macro-retention-arena-bytes
        (tc-macro-walk-field state macro-live-symbols-retired-arena)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-retention-sample-generations!
    [state : TcMacroState]) : unit
    (compiler-tc-macro-profile-metric-max!
      state
      tc-profile-active-generations-max-bytes
      (+
        (compiler-tc-macro-retention-arena-bytes
          (tc-macro-walk-field state macro-decl-generation-arena))
        (compiler-tc-macro-retention-arena-bytes
          (tc-macro-walk-field state macro-splice-generation-arena))))
    (compiler-tc-macro-profile-metric-max!
      state
      tc-profile-retired-generations-max-bytes
      (+
        (compiler-tc-macro-retention-arena-bytes
          (tc-macro-walk-field state macro-decl-generation-retired-arena))
        (compiler-tc-macro-retention-arena-bytes
          (tc-macro-walk-field state macro-splice-generation-retired-arena))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-retention-sample! [state : TcMacroState]) : unit
    (let
      [scratch : i64
        (compiler-tc-macro-retention-arena-bytes
          (tc-macro-walk-field state macro-expand-scratch-arena))]
      (compiler-tc-macro-retention-sample-symbols! state)
      (compiler-tc-macro-retention-sample-generations! state)
      (compiler-tc-macro-profile-metric-max!
        state
        tc-profile-expansion-scratch-max-bytes
        scratch))))

(define (tc-macro-walk-state-new) : TcMacroWalkStateData
  (TcMacroWalkStateData
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    0
    0
    0
    ""
    (tc_i64_i64_map.with-capacity 128)
    (tc_i64_i64_map.with-capacity 128)
    false
    (ctfe_support.ctfe-env-empty)
    false
    0
    0
    false
    0
    true
    (ctfe_support.compiler-ctfe-macro-state-new)
    false
    (csym.compiler-symbols-empty)
    (__tl_make-array (csym.compiler-registries-empty))
    false
    false
    true
    0
    0
    0
    false
    false
    (Nil)
    false
    false
    (Nil)
    false
    0
    0
    0
    2
    0
    0
    0
    0
    0
    0
    32
    (__tl_make-array i64 32)
    (__tl_make-array i64 32)
    0
    false
    false
    false
    cbi.compiler-builtin-id-fix-empty
    cbi.compiler-builtin-id-fix-empty
    (cload.compiler-load-session-state-dependency-catalog-handle
      (cload.compiler-load-serial-test-session-state))
    (tc_i64_i64_map.with-capacity 64)
    (__tl_make-array i64 13)
    false
    (sym_i64_env.sym-i64-empty)
    (__tl_make-array ast.AstNodePoolContext 0)
    (__tl_make-array i64 0)
    (__tl_make-array ast.AstExpr 0)
    0
    0))

(define (tc-macro-walk-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroWalkStateData
    tc-macro-state-slot-walk
    (tc-macro-walk-state-new)))

(define (tc-macro-walk-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast state 3 tc-macro-walk-state-address-initialize))

(define (tc-macro-walk-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroWalkStateData)
  (tc-state-cell-ptr (tc-macro-walk-state-address state) TcMacroWalkStateData))

;; Whole-struct snapshot and write-back, for tests that inspect or seed the
;; walk state. Compiler paths read and set single fields in place instead.
(define (tc-macro-walk-state-data [state : TcMacroState]) : TcMacroWalkStateData
  (tc-state-cell-read (tc-macro-walk-state-address state) TcMacroWalkStateData))

(define (tc-macro-walk-state-data-set!
  [state : TcMacroState]
  [data : TcMacroWalkStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-walk-state-address state)
    TcMacroWalkStateData
    data))

(defmacro (tc-macro-walk-field [state : Expr] [field : Expr]) : Expr
  `(unsafe
    (__tl-project-field (deref (tc-macro-walk-state-ptr ,state)) ,field)))

(define tc-dependency-tlci-catalog-hits : i64
  0)
(define tc-dependency-tlci-catalog-misses : i64
  1)
(define tc-dependency-tlci-load-failures : i64
  2)
(define tc-dependency-tlci-interpreted-fallbacks : i64
  3)
(define tc-dependency-tlci-native-dispatches : i64
  4)
(define tc-dependency-tlci-shell-learns : i64
  5)
(define tc-dependency-tlci-shell-cache-hits : i64
  6)
(define tc-dependency-tlci-parameter-name-lookups : i64
  7)
(define tc-dependency-tlci-native-expr-results : i64
  8)
(define tc-dependency-tlci-direct-expr-results : i64
  9)
(define tc-dependency-tlci-native-module-results : i64
  10)
(define tc-dependency-tlci-native-decls-results : i64
  11)
(define tc-dependency-tlci-direct-shell-env-folds : i64
  12)

(define (tc-dependency-tlci-route-counter-value
  [state : TcMacroState]
  [counter : i64]) : i64
  (array-ref
    (tc-macro-walk-field state macro-dependency-tlci-route-counters)
    counter))

(define (tc-dependency-tlci-route-counter-add!
  [state : TcMacroState]
  [counter : i64]
  [value : i64]) : unit
  (let
    [counters : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-dependency-tlci-route-counters)]
    (set! (array-ref counters counter) (+ (array-ref counters counter) value))))

(define (tc-dependency-tlci-route-counters-reset! [state : TcMacroState]) : unit
  (let
    [counters : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-dependency-tlci-route-counters)]
    [index : i64 0]
    (while (< index (array-length counters))
      (set! (array-ref counters index) 0)
      (set! index (+ index 1)))))

(cfg
  compile-profile
  (define (compiler-tc-dependency-tlci-route-profile-row [counter : i64]) : String
    (cond
      [(= counter tc-dependency-tlci-catalog-hits)
        "typecheck.macro.dependency_tlci_catalog_hits"]
      [(= counter tc-dependency-tlci-catalog-misses)
        "typecheck.macro.dependency_tlci_catalog_misses"]
      [(= counter tc-dependency-tlci-load-failures)
        "typecheck.macro.dependency_tlci_load_failures"]
      [(= counter tc-dependency-tlci-interpreted-fallbacks)
        "typecheck.macro.dependency_tlci_interpreted_fallbacks"]
      [(= counter tc-dependency-tlci-native-dispatches)
        "typecheck.macro.dependency_tlci_native_dispatches"]
      [(= counter tc-dependency-tlci-shell-learns)
        "typecheck.macro.dependency_tlci_shell_learns"]
      [(= counter tc-dependency-tlci-shell-cache-hits)
        "typecheck.macro.dependency_tlci_shell_cache_hits"]
      [(= counter tc-dependency-tlci-parameter-name-lookups)
        "typecheck.macro.dependency_tlci_parameter_name_lookups"]
      [(= counter tc-dependency-tlci-native-expr-results)
        "typecheck.macro.dependency_tlci_native_expr_results"]
      [(= counter tc-dependency-tlci-direct-expr-results)
        "typecheck.macro.dependency_tlci_direct_expr_results"]
      [(= counter tc-dependency-tlci-native-module-results)
        "typecheck.macro.dependency_tlci_native_module_results"]
      [(= counter tc-dependency-tlci-native-decls-results)
        "typecheck.macro.dependency_tlci_native_decls_results"]
      [else "typecheck.macro.dependency_tlci_direct_shell_env_folds"])))

;; The route counters are numbered in row order.
(cfg
  compile-profile
  (define (compiler-tc-dependency-tlci-route-profile-finish
    [state : TcMacroState]) : unit
    (let
      [counter : i64 tc-dependency-tlci-catalog-hits]
      (while (<= counter tc-dependency-tlci-direct-shell-env-folds)
        (counters.profile-counter-row!
          (compiler-tc-dependency-tlci-route-profile-row counter)
          (tc-dependency-tlci-route-counter-value state counter))
        (set! counter (+ counter 1))))))

;; Field reads and writes go through the cell pointer. The walk state is a
;; struct of several hundred bytes, and copying it whole to read or set one
;; field was a measurable share of every macro call.
(defmacro (tc-macro-walk-set! [state : Expr] [field : Expr] [value : Expr]) : Expr
  `(unsafe
    (__tl-project-set-field
      (deref (tc-macro-walk-state-ptr ,state))
      ,field
      ,value)))

(define (tc-macro-ctfe-state [state : TcMacroState]) : ctfe_support.CompilerCtfeMacroState
  (tc-macro-walk-field state ctfe-macro-state))

(define (tc-context-macro-state [ctx : TcContext]) : TcMacroState
  (tc-job-state-macro-state (tc-context-job-state ctx)))

(define (tc-context-ctfe-macro-state [ctx : TcContext]) : ctfe_support.CompilerCtfeMacroState
  (tc-macro-ctfe-state (tc-context-macro-state ctx)))

(define (tc-macro-state-bind-source-names!
  [state : TcMacroState]
  [source-names : ci.InternSourceNameSessionHandle]) : unit
  (let
    [address : i64 (tc-macro-state-slot-address state 13)]
    [next : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session source-names)]
    (if (= address 0)
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array ci.InternSourceNameSession)
              (__tl_make-array ci.InternSourceNameSession 1)]
            [next-address : i64
              (begin
                (set! (array-ref cell 0) next)
                (cast
                  (unsafe
                    (ptr->int
                      (ptr-cast
                        (__tl_array-data cell)
                        : (Ptr ci.InternSourceNameSession))))
                  : i64))]
            (tc-macro-state-slot-address-set! state 13 next-address))))
      ;; Slot 13 names a record allocated once in the job owner. Every bind is
      ;; authoritative: same-generation interning can grow the source-name
      ;; arrays and replace their snapshots. Refreshing the record in place
      ;; keeps those pointers current and batch retained bytes bounded, while
      ;; never dereferencing capability cells retired by nested compiler work.
      (unsafe
        (ptr-write!
          (int->ptr (cast address : u64) : (MutPtr ci.InternSourceNameSession))
          next)))))

(define (tc-macro-state-source-names-initialize [state : TcMacroState]) : ci.InternSourceNameSessionHandle
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (ci.intern-source-name-session-capture-active-handle)]
    ;; Compatibility-only lazy binding for serial/test adapters. The
    ;; production entry binds its explicit source-name owner before any
    ;; macro cache can be touched.
    (tc-macro-state-bind-source-names! state source-names)
    (ci.InternSourceNameSessionHandle (tc-macro-state-slot-address state 13))))

(define (tc-macro-state-source-names [state : TcMacroState]) : ci.InternSourceNameSessionHandle
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (ci.InternSourceNameSessionHandle (tc-macro-state-slot-address state 13))]
    (if (> source-names.address 0)
      source-names
      (tc-macro-state-source-names-initialize state))))

(define (tc-macro-state-structural-session [state : TcMacroState]) : cis.InternStructuralSessionHandle
  (cis.intern-structural-session-handle-from-source-names
    (tc-macro-state-source-names state)))

(define (tc-ctfe-env-structural-session [env : ctfe_support.CtfeEnv]) : cis.InternStructuralSessionHandle
  (cis.intern-structural-session-handle-from-source-names
    (ctfe_support.ctfe-env-source-names env)))

(define (tc-macro-state-source-name-table-id [state : TcMacroState]) : i64
  (ci.intern-source-name-session-handle-table-id
    (tc-macro-state-source-names state)))

(define (tc-macro-state-source-name-reset-generation [state : TcMacroState]) : i64
  (ci.intern-source-name-session-handle-reset-generation
    (tc-macro-state-source-names state)))

(define (tc-macro-state-source-name-session [state : TcMacroState]) : ci.InternSourceNameSession
  (ci.intern-source-name-session-handle-session
    (tc-macro-state-source-names state)))

;; Hygiene environments are immutable snapshots into this dense append-only
;; store. A branch extends a retained head without copying or mutating its
;; parent, so sibling expression/type/pattern walks remain isolated.
(defenum MacroMaybeHygieneName
  (No)
  (Some i64))

(defenum MacroHygieneName
  (Name i64 MacroHygieneEnv))

(defenum MacroHygieneParams
  (Params ast.AstParamList MacroHygieneEnv))

(defenum MacroHygieneLetBindings
  (LetBindings ast.AstLetBindingList MacroHygieneEnv))

(defenum MacroHygieneResourceBindings
  (ResourceBindings ast.AstResourceBindingList MacroHygieneEnv))

(defenum MacroHygienePattern
  (Pattern ast.AstPattern MacroHygieneEnv))

(defenum MacroHygienePatternList
  (PatternList ast.AstPatternList MacroHygieneEnv))

;; Set of macro (and compat-guard) names callable in the program. Used as a
;; cheap pre-filter in the macro-use detector so the common case (a plain
;; function call whose name is not a macro) avoids the allocating module-key
;; lookup in `macro-call-decl`. Populated once per expansion run.
;; Exact module-qualified macro identities whose transformer bodies can call
;; `expr-type`. Only those macros need fixed `Expr` operands to carry produced
;; type metadata. Keep the hot per-call membership check ID-keyed rather than
;; comparing module/name strings linearly for every expansion.
;; Cached CTFE base environment (reflection + layout metadata) for the current
;; expansion run. Building it via `tc-ctfe-env` runs
;; `ctfe-reflections-from-program` over the WHOLE program (O(program)), so it is
;; not rebuilt per macro call: reuse it across the
;; run unless a splice materializes a reflection-relevant nominal declaration.
;; Whether the cached CTFE env was built with the full reflection/layout metadata
;; (plan P2). The cache is built once per expansion run and reused across every
;; in-pass splice rebuild, but a run whose first build did not need metadata
;; caches an empty env; a later rebuild that does need metadata must not reuse
;; that empty env. Guarded by macro-expand-ctfe-env-build-once!.
;; Metadata vectors can grow after a splice. Keep those allocations in the
;; arena that owns the initial cache instead of whichever short-lived macro
;; generation happens to request the extension.
(define (compiler-typecheck-ctfe-env-cache-clear! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-expand-ctfe-env-ready false)
  (tc-macro-walk-set! state macro-expand-ctfe-env-has-metadata false)
  (tc-macro-walk-set! state macro-expand-ctfe-env-owner-arena 0)
  (tc-macro-walk-set! state macro-expand-ctfe-env-build-generation 0)
  (tc-macro-walk-set! state macro-expand-ctfe-env-rebuild-pending false)
  (tc-macro-walk-set!
    state
    macro-expand-ctfe-env-value
    (ctfe_support.ctfe-env-empty)))

(define (compiler-typecheck-ctfe-env-cache-clear-for-splice!
  [state : TcMacroState]
  [_reason : i64]) : unit
  (begin
    (cfg
      compile-profile
      (compiler-tc-macro-profile-metric-add!
        state
        tc-profile-splice-ctfe-cleared
        1))
    (tc-macro-walk-set! state macro-expand-ctfe-env-ready false)
    (tc-macro-walk-set! state macro-expand-ctfe-env-has-metadata false)
    (tc-macro-walk-set! state macro-expand-ctfe-env-rebuild-pending true)
    (tc-macro-walk-set!
      state
      macro-expand-ctfe-env-value
      (ctfe_support.ctfe-env-empty))))

(defenum CompilerCtfeSpliceExtensionResult
  (Extended)
  (AlreadyCurrent)
  (NoMetadata)
  (SemanticRejected)
  (CacheUnavailable))

(define (compiler-typecheck-ctfe-splice-key-fresh?
  [layouts : (& layouts ctfe_support.CtfeLayoutInfoList)]
  [reflections : (& reflections ctfe_support.CtfeReflectInfoList)]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [key-id : i64]) : bool
  (let
    [layouts : ctfe_support.CtfeLayoutInfoList
      (owned_view.compiler-owned-reference-shared-view layouts)]
    [reflections : ctfe_support.CtfeReflectInfoList
      (owned_view.compiler-owned-reference-shared-view reflections)]
    (if (or
      (ctfe_support.ctfe-layout-info-list-contains-key-id? layouts key-id)
      (ctfe_support.ctfe-reflect-info-list-contains-key-id? reflections key-id)
      (tc_i64_i64_map.contains? seen key-id))
      false
      (begin
        (tc_i64_i64_map.insert-ref! seen key-id 1)
        true))))

;; A delta is append-safe when every canonical nominal identity is fresh. An
;; arbitrary delta must also have fresh unqualified reflection aliases and no
;; imports: either can reorder first-wins/layout resolution. The isolated
;; generated-module classifier already proves its namespace and append-only
;; registry effects, so it may preserve earlier aliases and imports exactly as
;; the established generated-module extension did. Paths and registry identity
;; prove this classification is over the same post-splice ownership and symbol
;; generation the layout extension will consume.
(define (compiler-typecheck-ctfe-splice-append-safe?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [module-id : i64]
  [isolated-generated-module? : bool]
  [registries : csym.CompilerRegistries]
  [layouts : ctfe_support.CtfeLayoutInfoList]
  [reflections : ctfe_support.CtfeReflectInfoList]) : bool
  (if (or
    (not
      (=
        (ast.ast-decl-list-len (& decls))
        (ast.ast-decl-path-list-len (& paths))))
    (not
      (=
        (csym.compiler-registries-identity registries)
        (csym.compiler-registries-identity (tc-context-registries ctx)))))
    false
    (let
      [count : i64 (ast.ast-decl-list-len (& decls))]
      [position : i64 0]
      [current-module-id : i64 module-id]
      [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
      [decl-offset : i64 decls.offset]
      [seen : tc_i64_i64_map.Map
        (tc_i64_i64_map.with-capacity
          (+
            (*
              (ctfe_support.ctfe-metadata-decl-capacity
                (tc-global-shared-view decls))
              2)
            1))]
      [safe : bool true]
      (while (and safe (< position count))
        (match (tc-global-array-element-shared-view
          decl-slots
          (+ decl-offset position))
          [(Module next-module) (set! current-module-id next-module)]
          [(Import decl-meta _)
            (if isolated-generated-module?
              unit
              (set! safe false))]
          [(or (DefStruct _ name _ _ _) (DefStructLifetimes _ name _ _ _ _)
               (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _))
            (set!
              safe
              (compiler-typecheck-ctfe-splice-key-fresh?
                layouts
                reflections
                (&mut seen)
                (if (= current-module-id cbi.compiler-builtin-id-fix-empty)
                  name
                  (ctfe_support.ctfe-qualified-name-key-id
                    current-module-id
                    name))))
            (if (and
              safe
              (not isolated-generated-module?)
              (not (= current-module-id cbi.compiler-builtin-id-fix-empty)))
              (set!
                safe
                (compiler-typecheck-ctfe-splice-key-fresh?
                  layouts
                  reflections
                  (&mut seen)
                  name))
              unit)]
          [(Unsafe inner-box)
            (if (macro-decl-reflection-relevant?
              (ast.ast-decl-box-shared-view inner-box))
              (set! safe false)
              unit)]
          [(ModuleBody _ body-box)
            (if (macro-decls-reflection-relevant?
              (ast.ast-decl-list-box-shared-view body-box))
              (set! safe false)
              unit)]
          [_ unit])
        (set! position (+ position 1)))
      safe)))

;; Additively extend the cached CTFE metadata across any append-safe splice.
;; The caller supplies the declaration paths, active module ownership, and
;; post-splice registries used by the new context. A full build performed while
;; rebuilding that context already contains the delta, so its generation lets
;; the caller skip a duplicate extension.
(define (compiler-typecheck-ctfe-env-extend-for-splice!
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [module : String]
  [module-id : i64]
  [isolated-generated-module? : bool]
  [registries : csym.CompilerRegistries]
  [prior-build-generation : i64]) : CompilerCtfeSpliceExtensionResult
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    (cond
      [(not (tc-macro-walk-field state ctfe-needs-metadata)) NoMetadata]
      [(not
          (=
            prior-build-generation
            (tc-macro-walk-field state macro-expand-ctfe-env-build-generation)))
        AlreadyCurrent]
      [(and
          (tc-macro-walk-field state macro-expand-ctfe-env-ready)
          (tc-macro-walk-field state macro-expand-ctfe-env-has-metadata)
          (not
            (= (tc-macro-walk-field state macro-expand-ctfe-env-owner-arena) 0)))
        (let
          [ctfe-env-value : ctfe_support.CtfeEnv
            (tc-macro-walk-field state macro-expand-ctfe-env-value)]
          [layouts : ctfe_support.CtfeLayoutInfoList
            (ctfe_support.ctfe-env-layouts ctfe-env-value)]
          [reflections : ctfe_support.CtfeReflectInfoList
            (ctfe_support.ctfe-env-reflections ctfe-env-value)]
          [needed : i64
            (ctfe_support.ctfe-metadata-decl-capacity
              (tc-global-shared-view decls))]
          (if (compiler-typecheck-ctfe-splice-append-safe?
            ctx
            (tc-global-shared-view decls)
            paths
            module-id
            isolated-generated-module?
            registries
            (tc-global-shared-view layouts)
            (tc-global-shared-view reflections))
            (let
              [required-layouts : i64 (+ layouts.len needed)]
              [required-reflections : i64 (+ reflections.len needed)]
              [grew? : bool
                (or
                  (> required-layouts (array-length layouts.slots))
                  (> required-reflections (array-length reflections.slots)))]
              (in-arena
                (arena.Arena
                  (tc-macro-walk-field state macro-expand-ctfe-env-owner-arena))
                (let
                  [grown-layouts : ctfe_support.CtfeLayoutInfoList
                    (ctfe_support.ctfe-layout-info-list-ensure-capacity
                      layouts
                      required-layouts)]
                  [grown-reflections : ctfe_support.CtfeReflectInfoList
                    (ctfe_support.ctfe-reflect-info-list-ensure-capacity
                      reflections
                      required-reflections)]
                  [next-layouts : ctfe_support.CtfeLayoutInfoList
                    (tc-ctfe-layouts-from-decls
                      ctx
                      (tc-global-shared-view decls)
                      (tc-global-shared-view module)
                      module-id
                      grown-layouts)]
                  [next-reflections : ctfe_support.CtfeReflectInfoList
                    (ctfe_support.ctfe-reflections-from-decls
                      decls
                      module
                      module-id
                      grown-reflections)]
                  (begin
                    (tc-macro-walk-set!
                      state
                      macro-expand-ctfe-env-value
                      (ctfe_support.ctfe-env-with-metadata-and-pools-and-source-names-and-macro-state
                        next-layouts
                        next-reflections
                        (ctfe_support.ctfe-env-pools ctfe-env-value)
                        (ctfe_support.ctfe-env-source-names ctfe-env-value)
                        (tc-macro-ctfe-state state)))
                    (if grew?
                      (cfg
                        compile-profile
                        (compiler-tc-macro-profile-metric-add!
                          state
                          tc-profile-splice-ctfe-capacity-grows
                          1))
                      unit)
                    (cfg
                      compile-profile
                      (compiler-tc-macro-profile-metric-add!
                        state
                        tc-profile-splice-ctfe-extensions
                        1))
                    Extended))))
            (begin
              (cfg
                compile-profile
                (compiler-tc-macro-profile-metric-add!
                  state
                  tc-profile-splice-ctfe-semantic-rejections
                  1))
              SemanticRejected)))]
      [else
        (begin
          (cfg
            compile-profile
            (compiler-tc-macro-profile-metric-add!
              state
              tc-profile-splice-ctfe-cache-unavailable
              1))
          CacheUnavailable)])))

;; Build the CTFE base env (reflection + layout metadata) once per expansion run
;; and reuse it across in-pass splice rebuilds (plan P2). Append-safe reflection
;; splices extend it after context rebuild; semantic rejections invalidate and
;; immediately rebuild it. The one other exception is a run whose first build
;; did not need metadata (empty env) and a later rebuild that does; the
;; has-metadata guard rebuilds for that case. On reuse the cached env is only
;; rebased onto the active pools (cheap); a full build walks the whole program.
(define (macro-expand-ctfe-env-build-once! [ctx : TcContext]) : unit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [reuse? : bool
      (and
        (tc-macro-walk-field state macro-expand-ctfe-env-ready)
        (or
          (not (tc-macro-walk-field state ctfe-needs-metadata))
          (tc-macro-walk-field state macro-expand-ctfe-env-has-metadata)))]
    (if reuse?
      unit
      (let
        [_rebuild? : bool
          (tc-macro-walk-field state macro-expand-ctfe-env-rebuild-pending)]
        [owner-arena : i64
          (if (=
            (tc-macro-walk-field state macro-expand-ctfe-env-owner-arena)
            0)
            ;; Macro expansion itself runs in a reclaimable arena. The CTFE
            ;; metadata cache is the one session value reused by downstream
            ;; comptime checks, so keep both its initial build and any splice
            ;; extension in the checked AST pool's durable base owner.
            (ast.ast-node-pool-context-base-arena (tc-context-pools ctx))
            (tc-macro-walk-field state macro-expand-ctfe-env-owner-arena))]
        (in-arena
          (arena.Arena owner-arena)
          (begin
            (tc-macro-walk-set! state macro-expand-ctfe-env-ready false)
            (tc-macro-walk-set!
              state
              macro-expand-ctfe-env-owner-arena
              owner-arena)
            (tc-macro-walk-set!
              state
              macro-expand-ctfe-env-value
              (tc-ctfe-env ctx))
            (tc-macro-walk-set!
              state
              macro-expand-ctfe-env-has-metadata
              (tc-macro-walk-field state ctfe-needs-metadata))
            (tc-macro-walk-set! state macro-expand-ctfe-env-ready true)
            (tc-macro-walk-set!
              state
              macro-expand-ctfe-env-build-generation
              (+
                (tc-macro-walk-field
                  state
                  macro-expand-ctfe-env-build-generation)
                1))
            (tc-macro-walk-set!
              state
              macro-expand-ctfe-env-rebuild-pending
              false)
            (cfg
              compile-profile
              (compiler-tc-macro-profile-metric-add!
                state
                tc-profile-splice-ctfe-builds
                1))
            (cfg
              compile-profile
              (if _rebuild?
                (compiler-tc-macro-profile-metric-add!
                  state
                  tc-profile-splice-ctfe-rebuilds
                  1)
                unit)
              unit)))))))

(define (compiler-typecheck-ctfe-env-rebuild-for-splice!
  [ctx : TcContext]
  [reason : i64]) : unit
  (compiler-typecheck-ctfe-env-cache-clear-for-splice!
    (tc-context-macro-state ctx)
    reason)
  ;; Rebuild at the fallback boundary. Deferring this until an incidental
  ;; later macro could leave a terminal clear unpaired in the profile and
  ;; makes the actual whole-program rescan invisible to the splice reason.
  (macro-expand-ctfe-env-build-once! ctx))

;; Live compiler symbols/registries reused across the expansion run (plan P2).
;; Generated modules extend the symbol table at its logical end, keeping every
;; prior handle stable. Arbitrary declaration splices and freshly loaded source
;; files retain the conservative whole-program rebuild fallback.
;; TcContext values intentionally share the live macro registry's arena-backed
;; tables so append-only splices become visible to an in-flight expansion. Raw
;; pointer copy is confined to this cache boundary: ordinary source must borrow
;; non-Copy globals, while this internal view has the same lifetime as the live
;; macro arena and is cleared before that arena is destroyed.
(define (macro-live-registries-shared-view [state : TcMacroState]) : csym.CompilerRegistries
  (let
    [cell : (__tl_dyn-array csym.CompilerRegistries)
      (tc-macro-walk-field state macro-live-registries-cell)]
    (unsafe
      (ptr-read
        (ptr-cast (__tl_array-data cell) : (Ptr csym.CompilerRegistries))))))

;; Whole-program symbol/registry rebuilds replace the previous tables, but the
;; ordinary compile arena retains every obsolete generation until process exit.
;; Keep those tables in one independently owned arena so a successful rebuild
;; can retire its predecessor without putting the longer-lived macro output or
;; top environments in the same lifetime domain.
(define (macro-live-symbols-reset! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-live-symbols-ready false)
  (tc-macro-walk-set! state macro-live-symbols-fallback false)
  (tc-macro-walk-set! state macro-live-registries-ready false)
  (tc-macro-walk-set! state macro-live-registries-fallback true))

(define (macro-live-symbols-clear! [state : TcMacroState]) : unit
  (let
    [current : i64 (tc-macro-walk-field state macro-live-symbols-arena)]
    [retired : i64 (tc-macro-walk-field state macro-live-symbols-retired-arena)]
    (tc-macro-walk-set! state macro-live-symbols-ready false)
    (tc-macro-walk-set! state macro-live-symbols-fallback false)
    (tc-macro-walk-set! state macro-live-registries-ready false)
    (tc-macro-walk-set! state macro-live-registries-fallback true)
    (tc-macro-walk-set!
      state
      macro-live-symbols-value
      (csym.compiler-symbols-empty))
    (set!
      (array-ref (tc-macro-walk-field state macro-live-registries-cell) 0)
      (csym.compiler-registries-empty))
    ;; The completed expansion no longer has a consumer for either retained
    ;; generation. Release both here instead of carrying their raw handles
    ;; into the next independent typecheck entry.
    (tc-macro-walk-set! state macro-live-symbols-arena 0)
    (tc-macro-walk-set! state macro-live-symbols-retired-arena 0)
    (if (= current 0)
      unit
      (macro-generation-destroy! current))
    (if (or (= retired 0) (= retired current))
      unit
      (macro-generation-destroy! retired))))

;; A conservative whole-program rebuild keeps the replaced symbols reachable
;; while the replacement TcContext, top env, CTFE env, and hygiene state are
;; assembled. Once that rebuild has completed, every continuing consumer uses
;; the replacement context and the old registry has no escaping handle. Reclaim
;; it at that explicit handoff instead of retaining it until macro detach.
(define (macro-live-symbols-reclaim-retired! [state : TcMacroState]) : unit
  (let
    [retired : i64 (tc-macro-walk-field state macro-live-symbols-retired-arena)]
    (tc-macro-walk-set! state macro-live-symbols-retired-arena 0)
    (if (= retired 0)
      unit
      (macro-generation-destroy! retired))))

;; Force the next pass to rebuild the live symbols/registries. Called from the
;; decl walk's non-inert splice arm: an arbitrary (potentially shadowing) splice
;; may have introduced a name the reused symbols would resolve differently, so
;; drop the reuse conservatively.
(define (macro-live-symbols-invalidate! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-live-symbols-fallback true))

(define (macro-live-registries-invalidate! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-live-registries-fallback true))

(define (macro-live-symbols-insert-decls!
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [module-id : i64]) : bool
  (if (and
    (tc-macro-walk-field state macro-live-symbols-ready)
    (not (tc-macro-walk-field state macro-live-symbols-fallback)))
    (let
      [current-symbols : csym.CompilerSymbols
        (tc-macro-walk-field state macro-live-symbols-value)]
      [append-index : i64 (csym.compiler-symbols-decl-count current-symbols)]
      (match (csym.compiler-symbols-insert-decls
        current-symbols
        decls
        module-id)
        [(Ok symbols)
          (tc-macro-walk-set! state macro-live-symbols-value symbols)
          (tc-macro-walk-set!
            state
            macro-live-symbols-last-insert-index
            append-index)
          true]
        [(Err _) false]))
    false))

(define (macro-live-registries-append-decls!
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [module-id : i64]) : bool
  (if (and
    (tc-macro-walk-field state macro-live-registries-ready)
    (not (tc-macro-walk-field state macro-live-registries-fallback)))
    (match (csym.compiler-registries-append-decls
      (macro-live-registries-shared-view state)
      decls
      paths
      (tc-macro-walk-field state macro-live-symbols-last-insert-index)
      module-id)
      [(Ok registries)
        (set!
          (array-ref (tc-macro-walk-field state macro-live-registries-cell) 0)
          registries)
        true]
      [(Err _) false])
    false))

;; Return the live symbols (building both symbols and registries on demand),
;; reusing the cached pair across passes unless a rebuild was requested. Errors
;; from a fresh build propagate as ResultCompilerSymbols.Err; the registries are
;; read back from the macro-live registry cell by the caller.
(define (macro-live-registries-build-current
  [state : TcMacroState]
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]) : csym.ResultCompilerRegistries
  (if (and
    (tc-macro-walk-field state macro-live-registries-ready)
    (not (tc-macro-walk-field state macro-live-registries-fallback)))
    (begin
      (cfg
        compile-profile
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-live-registry-reuses
          1))
      (Ok (macro-live-registries-shared-view state)))
    (begin
      (cfg
        compile-profile
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-live-registry-rebuilds
          1))
      (let
        [registries : csym.CompilerRegistries
          (try (csym.build-compiler-registries-with-symbols program symbols))]
        (set!
          (array-ref (tc-macro-walk-field state macro-live-registries-cell) 0)
          registries)
        (tc-macro-walk-set! state macro-live-registries-ready true)
        (tc-macro-walk-set! state macro-live-registries-fallback false)
        (Ok (macro-live-registries-shared-view state))))))

(define (macro-live-symbols-reserved-capacity [program : ast.AstProgram]) : i64
  (match program
    [(Program decls-box)
      (let
        [decl-count : i64
          (csym.compiler-decl-list-index-count (deref decls-box))]
        (+
          decl-count
          (if (< decl-count 256)
            64
            (/ decl-count 4))))]))

(define (macro-live-symbols-build-fresh-current
  [state : TcMacroState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : csym.ResultCompilerSymbols
  (begin
    (cfg
      compile-profile
      (compiler-tc-macro-profile-metric-add! state tc-profile-live-rebuilds 1))
    (match (csym.build-compiler-symbols-diagnostic-with-paths-and-capacity
      (tc-global-shared-view program)
      paths
      (macro-live-symbols-reserved-capacity (tc-global-shared-view program)))
      [(Ok symbols)
        (let
          [registries
            (try
              (macro-live-registries-build-current
                state
                program
                (tc-global-shared-view symbols)))]
          (tc-macro-walk-set! state macro-live-symbols-value symbols)
          (set!
            (array-ref (tc-macro-walk-field state macro-live-registries-cell) 0)
            registries)
          (tc-macro-walk-set! state macro-live-symbols-ready true)
          (tc-macro-walk-set! state macro-live-symbols-fallback false)
          (Ok (tc-macro-walk-field state macro-live-symbols-value)))]
      [(Err diag)
        (let
          [diagnostic : cdiag.CompilerDiagnostic
            (cdiag.compiler-diagnostic-box-shared-view diag)]
          (Err (cdiag.compiler-diagnostic-typecheck-error-text (& diagnostic))))])))

(define (macro-live-symbols-build-fresh
  [state : TcMacroState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : csym.ResultCompilerSymbols
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [next-arena : i64 (arena.tl_arena_make)]
    [_switch : unit
      (unsafe
        (arena.tl_arena_set next-arena))]
    ;; A reused registry can still point into the previous symbols arena. Keep
    ;; the generation self-contained so retiring it cannot strand those maps.
    [_rebuild-registries : unit
      (tc-macro-walk-set! state macro-live-registries-fallback true)]
    [built : csym.ResultCompilerSymbols
      (macro-live-symbols-build-fresh-current state program paths)]
    (unsafe
      (arena.tl_arena_set enclosing))
    (match built
      [(Ok symbols)
        (let
          [previous : i64 (tc-macro-walk-field state macro-live-symbols-arena)]
          [retired : i64
            (tc-macro-walk-field state macro-live-symbols-retired-arena)]
          (begin
            (tc-macro-walk-set! state macro-live-symbols-arena next-arena)
            (tc-macro-walk-set! state macro-live-symbols-retired-arena previous)
            (cfg
              compile-profile
              (begin
                (if (= previous 0)
                  unit
                  (compiler-tc-macro-profile-metric-add!
                    state
                    tc-profile-retired-symbol-rotations
                    1))
                (compiler-tc-macro-retention-sample-symbols! state)))
            (macro-expand-allocation-profile-snapshot! state retired)
            (if (= retired 0)
              unit
              (unsafe
                (arena.tl_arena_destroy retired)))
            (Ok symbols)))]
      [(Err message)
        ;; Preserve the public error after releasing the failed generation.
        (let
          [stable-message : String (string.copy (& message))]
          (csym.compiler-symbols-stabilize-last-error!)
          (unsafe
            (arena.tl_arena_destroy next-arena))
          (Err stable-message))])))

(define (macro-live-symbols-build-or-reuse!
  [state : TcMacroState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : csym.ResultCompilerSymbols
  (if (and
    (tc-macro-walk-field state macro-live-symbols-ready)
    (not (tc-macro-walk-field state macro-live-symbols-fallback)))
    (begin
      (cfg
        compile-profile
        (compiler-tc-macro-profile-metric-add! state tc-profile-live-reuses 1))
      (let
        [registries
          (try
            (macro-live-registries-build-current
              state
              program
              (tc-macro-walk-field state macro-live-symbols-value)))]
        (set!
          (array-ref (tc-macro-walk-field state macro-live-registries-cell) 0)
          registries)
        (Ok (tc-macro-walk-field state macro-live-symbols-value))))
    (macro-live-symbols-build-fresh state program paths)))

;; Hoisted whole-program macro prescans. macro-program-has-defmacro?,
;; macro-collect-expr-type-macro-names, macro-program-needs-expansion?,
;; macro-program-has-summary-macro-import? and macro-collect-visible-macro-names
;; each walk the whole program. They are computed once per expansion run under
;; the additive-inert condition: generated splices add module decls in their own
;; namespace but no new defmacros/macro names, so the prescan results are stable
;; across the walk. The one exception is a generated file import loading new
;; declarations mid-walk -- the walk recomputes the prescan there (via
;; macro-live-symbols-invalidate! + macro-live-prescan-ensure!), matching the
;; symbols cache lifecycle.
(define (macro-live-prescan-reset! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-live-prescan-ready false))

(define (macro-live-prescan-ensure-current!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (let
    [expr-bases : i64 (ast.ast-node-pool-active-expr-segment-bases)]
    [has-defmacro : bool
      (macro-program-has-defmacro? (tc-global-shared-view decls))]
    [needs-expansion : bool
      (macro-program-needs-expansion?
        (tc-macro-state-structural-session state)
        expr-bases
        (tc-global-shared-view decls))]
    (tc-macro-walk-set! state macro-live-prescan-has-defmacro has-defmacro)
    (tc-macro-walk-set!
      state
      macro-live-prescan-expr-type-names
      (if has-defmacro
        (macro-collect-expr-type-macro-names expr-bases decls)
        (TcNameIdList.Nil)))
    (tc-macro-walk-set!
      state
      macro-live-prescan-needs-expansion
      needs-expansion)
    (tc-macro-walk-set!
      state
      macro-live-prescan-summary-import
      (and
        (not has-defmacro)
        (not needs-expansion)
        (macro-program-has-summary-macro-import? (tc-global-shared-view decls))))
    ;; The ctfe-module-macro-export map is populated as a side effect of
    ;; macro-collect-visible-macro-names (via the ID-keyed export map).
    ;; Since that walk runs once per program (cached with this prescan),
    ;; the export map is reset here -- immediately before it is repopulated --
    ;; and left intact while the prescan is reused across the walk.
    ;; Resetting it more often would clear the once-collected exports and
    ;; leave the map empty after the collection ran, breaking module-hook /
    ;; module-export-macro?. The export set is additive-inert (generated
    ;; splices add no new defmacros), so it is stable across the walk, exactly
    ;; like macro-live-prescan-visible-names; recomputed together on the
    ;; non-inert splice fallback (macro-live-symbols-fallback).
    (ctfe_support.ctfe-module-macro-export-reset-for-state!
      (tc-macro-ctfe-state state))
    (tc-macro-walk-set!
      state
      macro-live-prescan-visible-names
      (macro-collect-visible-macro-names state decls))
    (tc-macro-walk-set! state macro-live-prescan-ready true)))

(define (macro-live-prescan-ensure-fresh!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (if (tc-macro-walk-field state macro-expand-scratch-enabled)
    (let
      [scratch : i64 (macro-expand-scratch-arena-get state)]
      (in-arena
        (arena.Arena scratch)
        (macro-live-prescan-ensure-current! state decls)))
    (macro-live-prescan-ensure-current! state decls)))

(define (macro-live-prescan-ensure!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (if (and
    (tc-macro-walk-field state macro-live-prescan-ready)
    (not (tc-macro-walk-field state macro-live-symbols-fallback)))
    unit
    (macro-live-prescan-ensure-fresh! state decls)))

;; Publish a generated declaration segment directly into the hoisted prescan.
;; The splice walk will visit the delta itself, so this updates only the
;; whole-program facts and name sets that later declarations consult.
(define (macro-live-prescan-append-decls!
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [module-id : i64]) : unit
  (let
    [expr-bases : i64 (ast.ast-node-pool-active-expr-segment-bases)]
    [delta-has-defmacro : bool
      (macro-program-has-defmacro? (tc-global-shared-view decls))]
    (tc-macro-walk-set!
      state
      macro-live-prescan-has-defmacro
      (or
        (tc-macro-walk-field state macro-live-prescan-has-defmacro)
        delta-has-defmacro))
    (tc-macro-walk-set!
      state
      macro-live-prescan-needs-expansion
      (or
        (tc-macro-walk-field state macro-live-prescan-needs-expansion)
        (macro-program-needs-expansion?
          (tc-macro-state-structural-session state)
          expr-bases
          (tc-global-shared-view decls))))
    (tc-macro-walk-set!
      state
      macro-live-prescan-summary-import
      (or
        (tc-macro-walk-field state macro-live-prescan-summary-import)
        (macro-program-has-summary-macro-import? (tc-global-shared-view decls))))
    (when
      delta-has-defmacro
      (tc-macro-walk-set!
        state
        macro-live-prescan-expr-type-names
        (macro-collect-expr-type-macro-names-in
          expr-bases
          decls
          module-id
          (tc-macro-walk-field state macro-live-prescan-expr-type-names)))
      (tc-macro-walk-set!
        state
        macro-live-prescan-visible-names
        (macro-collect-macro-names-in
          state
          decls
          module-id
          (tc-macro-walk-field state macro-live-prescan-visible-names)))
      (macro-expand-set-expr-type-macro-names!
        state
        (tc-macro-walk-field state macro-live-prescan-expr-type-names))
      (macro-expand-set-macro-names!
        state
        (tc-macro-walk-field state macro-live-prescan-visible-names)))
    (tc-macro-walk-set! state macro-live-prescan-ready true)))

;; Whether the current compile needs the CTFE reflection/layout metadata at all
;; (i.e. the program contains a `(type T)` literal). Set per compile at the top of
;; macro-expand-program; when false, tc-ctfe-env returns an empty env and skips
;; the whole-program metadata build. Defaults true (build) for safety.
;; Macro expansion builds whole-program symbols, registries, top-env spines,
;; prescan lists, and splice-rebuild contexts that are dead once the final
;; expanded program has been produced. Keep that compiler-only state in a
;; scratch arena so it can be released at the macro/typecheck boundary while
;; final AST nodes and the CTFE env stay in their existing owners.
;; R3-P1: a firing declaration's expansion allocates superseded intermediate
;; forms -- hygiene copies and re-walk products -- into the ambient macro
;; arena, where they stay live for the whole walk and are only reclaimed by the
;; whole-program compaction at `macro_finalize`. Give each firing declaration
;; its own generation instead: expand into generation G, copy the surviving
;; declaration into the committed pool, and destroy G-1. The committed pool
;; then grows by the survivors only, and the existing `macro_finalize`
;; compaction becomes incremental rather than the sole reclamation point.
;;
;; One live declaration generation is sufficient at the next rotation boundary:
;; the copy-out finishes before the expansion returns, and the walk's own step
;; (`out-rev` prepend, module-id update, path reversal) finishes before the next
;; expansion can call `macro-decl-generation-enter!`. Thus a previous batch has
;; no reader when the next batch begins. The splice ring below deliberately keeps
;; its separate two-generation reset cadence because its caches have a different
;; proof.
;;
;; A generation spans a BATCH of firing declarations, not one. The survivor is
;; still copied out at every declaration boundary -- that is what makes the
;; garbage droppable -- but a fresh arena is only cut every
;; `macro-decl-generation-batch-size` declarations. One arena costs a reserve
;; and a release syscall pair, so a batch of one pays that pair per firing
;; declaration and slows the walk, while larger batches retain more superseded
;; garbage. Retention is alignment-sensitive: which large declarations share a
;; batch decides it, so an ordinary source change can push a mid-size batch
;; across the proportional retention gate. Shifting the ring's phase (a smaller
;; first batch) does not fix that; an unrelated source change moves it back.
;; The batch of two set in `tc-macro-walk-state-new` leaves enough
;; source-growth headroom that declaration ordering cannot immediately move a
;; large batch back across the gate.
;;
;; Retention is bounded by one batch, not by the walk. The completed batch is
;; reclaimed at this next-entry handoff: its arena is rewound to the mark it
;; had when mapped (macro-generation-recycle!) and becomes the live generation
;; again. Rewinding reclaims exactly what destroying would, and nothing reads a
;; completed batch after the handoff. It keeps the mapping, so the walk maps
;; one arena for its whole run rather than one per batch; each fresh mapping
;; cost a reserve, a first-touch page fault and a release, most of the walk's
;; kernel time (#7934). A rewound arena is marked reused, so array
;; zero-fills in it are no longer elided (#5599); that is cheaper than the
;; fresh mappings were.
(define (macro-decl-generation-rotate! [state : TcMacroState]) : i64
  (let
    [previous : i64 (tc-macro-walk-field state macro-decl-generation-arena)]
    [retired : i64
      (tc-macro-walk-field state macro-decl-generation-retired-arena)]
    [next : i64
      (if (= previous 0)
        (let
          [fresh : i64 (macro-generation-map!)]
          (tc-macro-walk-set!
            state
            macro-decl-generation-mark
            (macro-generation-base-mark fresh))
          fresh)
        (begin
          (macro-generation-recycle!
            previous
            (tc-macro-walk-field state macro-decl-generation-mark))
          previous))]
    (begin
      (cfg
        compile-profile
        (begin
          (compiler-tc-macro-retention-sample-generations! state)
          (if (= previous 0)
            (compiler-tc-macro-profile-metric-add!
              state
              tc-profile-generation-arenas-mapped
              1)
            unit)
          (counters.bump! tc-profile-decl-generation-rotations)))
      (tc-macro-walk-set! state macro-decl-generation-arena next)
      (tc-macro-walk-set! state macro-decl-generation-retired-arena 0)
      ;; Drain a legacy/test-injected retired slot without ever publishing two
      ;; retired owners or destroying the same arena twice.
      (if (or (= retired 0) (= retired previous))
        unit
        (macro-generation-destroy! retired))
      next)))

;: The arena this declaration's expansion runs in: the live generation while
;: its batch has room, otherwise the same arena rewound for a new batch.
(define (macro-decl-generation-enter! [state : TcMacroState]) : i64
  (if (and
    (not (= (tc-macro-walk-field state macro-decl-generation-arena) 0))
    (<
      (tc-macro-walk-field state macro-decl-generation-batch-used)
      (tc-macro-walk-field state macro-decl-generation-batch-size)))
    (begin
      (tc-macro-walk-set!
        state
        macro-decl-generation-batch-used
        (+ (tc-macro-walk-field state macro-decl-generation-batch-used) 1))
      (tc-macro-walk-field state macro-decl-generation-arena))
    (let
      [next : i64 (macro-decl-generation-rotate! state)]
      (tc-macro-walk-set! state macro-decl-generation-batch-used 1)
      next)))

;; R3-P2b: import-placeholder expansions get their OWN two-generation ring, not
;; a slot in the declaration-generation batch ring above. The difference is a
;; soundness argument rather than a tuning knob.
;;
;; Every splice arm resets the whole per-splice cache family before it hands the
;; walk on -- `macro-alias-derived-cache-reset!` (module/enum index, alias,
;; unqualified-import, flat-import targets, surface call-decl, the three source
;; key caches, imported-module identity), plus the job-owned nominal/type-name
;; cache reset and `tc-job-state-reset-derived-caches!`. So anything splice
;; N's expansion left in one of those caches is unreachable
;; from splice N+1 onwards BY CONSTRUCTION. Retiring one splice behind puts the
;; destroy at splice N+2 -- a full reset past the last instant any of it can be
;; read.
;;
;; That is the cadence rule this packet is built on: A GENERATION'S DESTROY
;; CADENCE MUST BE THE RESET CADENCE OF THE CACHES THAT ALLOCATE INTO IT. The
;; declaration-generation batch ring destroys on a counter with no relation to
;; the splice cadence, and putting the placeholder arm on it crashes the
;; self-compile.
;;
;; State that outlives the reset -- the two generated-module/decls memos, which
;; are per-RUN, not per-splice -- is not covered by the cadence argument and is
;; handled explicitly by the escape list below.
;: R3-P2c backstop. Every generation destroy or rewind in the walk goes
;: through here first: if the process-global pool context still aliases cells
;: this generation owns, reseat it into base-arena-owned cells before the pages
;: are reclaimed. See `ast-node-pool-active-context-reseat!` for why the guard
;: lives at the reclaim rather than at the producers.
(define (macro-generation-release-pool-context! [generation : i64]) : unit
  (if (ast.ast-node-pool-active-context-owned-by? generation)
    (ast.ast-node-pool-active-context-reseat!)
    unit))

(define (macro-generation-destroy! [generation : i64]) : unit
  (unless
    (= generation 0)
    (macro-generation-release-pool-context! generation)
    (unsafe
      (arena.tl_arena_destroy generation))))

;: A fresh generation arena. Both callers count every mapping, so the compile
;: profile can pin the number of mappings to a small constant.
(define (macro-generation-map!) : i64
  (arena.tl_arena_make))

;: The mark of `generation` while it is still empty.
(define (macro-generation-base-mark [generation : i64]) : i64
  (let
    [saved : i64 (arena.tl_arena_current)]
    [mark : i64
      (begin
        (unsafe
          (arena.tl_arena_set generation))
        (arena.tl_region_mark))]
    (unsafe
      (arena.tl_arena_set saved))
    mark))

;: Reclaim everything a finished generation allocated by rewinding it to its
;: empty `mark`, keeping the mapping for the next generation. Grown overflow
;: segments are released, and poisoning builds poison the reclaimed bytes
;: exactly as a destroy does.
(define (macro-generation-recycle! [generation : i64] [mark : i64]) : unit
  (let
    [saved : i64 (arena.tl_arena_current)]
    (macro-generation-release-pool-context! generation)
    (unsafe
      (arena.tl_arena_set generation)
      (arena.tl_region_reset mark)
      (arena.tl_arena_set saved))))

;: The splice ring keeps two generations: the live one and the one retired
;: behind it. Entering a splice reclaims the generation two behind, rewinding
;: its arena to become the live one.
(define (macro-splice-generation-enter! [state : TcMacroState]) : i64
  (let
    [previous : i64 (tc-macro-walk-field state macro-splice-generation-arena)]
    [previous-mark : i64
      (tc-macro-walk-field state macro-splice-generation-mark)]
    [retired : i64
      (tc-macro-walk-field state macro-splice-generation-retired-arena)]
    [retired-mark : i64
      (tc-macro-walk-field state macro-splice-generation-retired-mark)]
    [next : i64
      (if (= retired 0)
        (macro-generation-map!)
        (begin
          (macro-generation-recycle! retired retired-mark)
          retired))]
    [next-mark : i64
      (if (= retired 0)
        (macro-generation-base-mark next)
        retired-mark)]
    (begin
      (cfg
        compile-profile
        (begin
          (compiler-tc-macro-retention-sample-generations! state)
          (if (= retired 0)
            (compiler-tc-macro-profile-metric-add!
              state
              tc-profile-generation-arenas-mapped
              1)
            unit)
          (compiler-tc-macro-profile-metric-add!
            state
            tc-profile-splice-generation-rotations
            1)
          (if (= previous 0)
            unit
            (compiler-tc-macro-profile-metric-add!
              state
              tc-profile-retired-generation-rotations
              1))))
      (tc-macro-walk-set! state macro-splice-generation-arena next)
      (tc-macro-walk-set! state macro-splice-generation-mark next-mark)
      (tc-macro-walk-set! state macro-splice-generation-retired-arena previous)
      (tc-macro-walk-set!
        state
        macro-splice-generation-retired-mark
        previous-mark)
      next)))

;: True while either ring holds a live generation, i.e. while an "allocate into
;: whatever arena is current" cache can capture per-declaration storage.
(define (macro-generation-any-live? [state : TcMacroState]) : bool
  (not
    (and
      (= (tc-macro-walk-field state macro-decl-generation-arena) 0)
      (= (tc-macro-walk-field state macro-splice-generation-arena) 0))))

(define (macro-splice-generations-release! [state : TcMacroState]) : unit
  (let
    [current : i64 (tc-macro-walk-field state macro-splice-generation-arena)]
    [retired : i64
      (tc-macro-walk-field state macro-splice-generation-retired-arena)]
    (tc-macro-walk-set! state macro-splice-generation-arena 0)
    (tc-macro-walk-set! state macro-splice-generation-retired-arena 0)
    (tc-macro-walk-set! state macro-splice-generation-mark 0)
    (tc-macro-walk-set! state macro-splice-generation-retired-mark 0)
    (if (= current 0)
      unit
      (macro-generation-destroy! current))
    (if (or (= retired 0) (= retired current))
      unit
      (macro-generation-destroy! retired))))

;; R3-P2b generation escapes.
;;
;; R3-P1's generation covers ordinary firing declarations, whose entire product
;; is the survivor the copy-out persists. An IMPORT-PLACEHOLDER expansion is
;; different: besides its survivor it records the generated module in a
;; whole-RUN memo (`macro-generated-module-memo-*`,
;; `macro-generated-decls-memo-*`), and a later splice reads that entry -- and,
;; on a module-memo hit, SPLICES the recorded catalog straight into the program.
;; Those entries are built from the arena current at record time, so without
;; this they are a use-after-free two splices later.
;;
;; The memo puts stay exactly where they are -- so a nested read inside the same
;; expansion still sees the entry it just wrote -- but they NOTE their key here,
;; and the copy-out re-persists each noted entry's declaration lists with the
;; SAME id maps it used for the survivor. A node shared between the survivor and
;; a memo entry is therefore persisted once, and every memo entry ends up owned
;; by the pool's base arena, which outlives the walk.
;;
;; Fail-closed on overflow: a declaration that records more entries than this
;; list holds cannot have all of them persisted, so its generation is orphaned
;; instead of destroyed. That leaks one generation and is the safe direction.
;; True only while a declaration's expansion is running with its generation
;; current. Every other memo put already lands in a long-lived arena.
(define (macro-decl-generation-escape-reset! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-decl-generation-escape-count 0)
  (tc-macro-walk-set! state macro-decl-generation-escape-overflow false))

;: Record that memo `kind` (1 = generated-module memo, 2 = generated-decls memo)
;: now holds declaration lists owned by the live declaration generation.
(define (macro-decl-generation-escape-note!
  [state : TcMacroState]
  [kind : i64]
  [key : i64]) : unit
  (if (not (tc-macro-walk-field state macro-decl-generation-active))
    unit
    (if (>=
      (tc-macro-walk-field state macro-decl-generation-escape-count)
      (tc-macro-walk-field state macro-decl-generation-escape-capacity))
      (tc-macro-walk-set! state macro-decl-generation-escape-overflow true)
      (let
        [count : i64
          (tc-macro-walk-field state macro-decl-generation-escape-count)]
        [kinds : (__tl_dyn-array i64)
          (tc-macro-walk-field state macro-decl-generation-escape-kinds)]
        [keys : (__tl_dyn-array i64)
          (tc-macro-walk-field state macro-decl-generation-escape-keys)]
        (set! (array-ref kinds count) kind)
        (set! (array-ref keys count) key)
        (tc-macro-walk-set!
          state
          macro-decl-generation-escape-count
          (+ count 1))))))

(define (macro-decl-generations-release! [state : TcMacroState]) : unit
  (let
    [current : i64 (tc-macro-walk-field state macro-decl-generation-arena)]
    [retired : i64
      (tc-macro-walk-field state macro-decl-generation-retired-arena)]
    (tc-macro-walk-set! state macro-decl-generation-arena 0)
    (tc-macro-walk-set! state macro-decl-generation-retired-arena 0)
    (tc-macro-walk-set! state macro-decl-generation-mark 0)
    (tc-macro-walk-set! state macro-decl-generation-batch-used 0)
    (tc-macro-walk-set! state macro-decl-generation-active false)
    (macro-decl-generation-escape-reset! state)
    (macro-splice-generations-release! state)
    (if (= current 0)
      unit
      (macro-generation-destroy! current))
    (if (or (= retired 0) (= retired current))
      unit
      (macro-generation-destroy! retired))))

;; The checked-lowering pipeline compacts its parsed program before macro
;; expansion.  Keep an explicit proof of whether expansion changed the program
;; so lowering can retain that first compact generation when the walk only
;; shared declarations.  This is deliberately independent of dispatch counts:
;; declaration/import splices, generated-file loads, compatibility rewrites,
;; and post-walk generated-declaration normalization all note the same signal.
(cfg
  compile-profile
  (define macro-expand-program-structural-change-reasons : i64
    0))

(define (macro-expand-program-structural-change-reset! [state : TcMacroState]) : unit
  (begin
    (tc-macro-walk-set! state macro-expand-program-structurally-changed false)
    (cfg
      compile-profile
      (set! macro-expand-program-structural-change-reasons 0))))

(define (macro-expand-program-structural-change-note!
  [state : TcMacroState]
  [_reason : i64]) : unit
  (begin
    (tc-macro-walk-set! state macro-expand-program-structurally-changed true)
    (cfg
      compile-profile
      (set!
        macro-expand-program-structural-change-reasons
        (bit-or macro-expand-program-structural-change-reasons _reason)))))

(define (macro-expand-program-structurally-changed? [state : TcMacroState]) : bool
  (tc-macro-walk-field state macro-expand-program-structurally-changed))

(cfg
  compile-profile
  (define (macro-expand-program-structural-change-reasons-value) : i64
    macro-expand-program-structural-change-reasons))

(define (macro-expand-scratch-begin! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-expand-scratch-enabled true))

(define (macro-expand-scratch-arena-get [state : TcMacroState]) : i64
  (if (= (tc-macro-walk-field state macro-expand-scratch-arena) 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (tc-macro-walk-set! state macro-expand-scratch-arena scratch)
        (cfg
          compile-profile
          (compiler-tc-macro-profile-metric-add!
            state
            tc-profile-expansion-scratch-creations
            1))
        scratch))
    (tc-macro-walk-field state macro-expand-scratch-arena)))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-nonnegative [value : i64]) : i64
    (if (< value 0)
      0
      value)))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-arena-bytes [owner : i64]) : i64
    (allocation_profile.compiler-allocation-profile-arena-bump-bytes owner)))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-owner-delta [owner : i64] [start : i64]) : i64
    (compiler-tc-macro-lifetime-nonnegative
      (- (compiler-tc-macro-lifetime-arena-bytes owner) start))))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-row
    [boundary : String]
    [owner : String]
    [lifetime : String]
    [cumulative-alloc : i64]
    [retained-live : i64]
    [peak-delta : i64]) : String
    (str_cat.str-cat
      "compile-profile-lifetime|"
      boundary
      "|"
      owner
      "|"
      lifetime
      (compiler-tc-profile-field cumulative-alloc)
      (compiler-tc-profile-field retained-live)
      (compiler-tc-profile-field peak-delta)
      "\n")))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-emit-row!
    [boundary : String]
    [owner : String]
    [lifetime : String]
    [cumulative-alloc : i64]
    [retained-live : i64]
    [peak-delta : i64]) : unit
    (with-scratch
      (io.print-error
        (compiler-tc-macro-lifetime-row
          boundary
          owner
          lifetime
          cumulative-alloc
          retained-live
          peak-delta)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-start!
    [job-state : TcJobState]
    [pools : ast.AstNodePoolContext]) : unit
    (let
      [metrics-address : u64 (compiler-tc-profile-metrics-address job-state)]
      [enclosing-handle : i64 (arena.tl_arena_current)]
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-total-metric
        (profile.alloc-total))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-live-metric
        (profile.alloc-live))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-peak-metric
        (profile.compile-wide-peak-current))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-pool-base-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (ast.ast-node-pool-context-base-arena pools)))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-expr-pool-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (ast.ast-node-pool-context-expr-storage-arena pools)))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-type-pool-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (ast.ast-node-pool-context-type-storage-arena pools)))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-enclosing-handle-metric
        enclosing-handle)
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-enclosing-bytes-metric
        (compiler-tc-macro-lifetime-arena-bytes enclosing-handle))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-job-owner-bytes-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (tc-macro-state-owner-arena (tc-job-state-macro-state job-state))))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-scoped-env-bytes-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (tc-job-state-type-env-scoped-state-arena job-state)))
      (compiler-tc-profile-metric-set!
        metrics-address
        compiler-tc-macro-lifetime-start-intern-bytes-metric
        (compiler-tc-macro-lifetime-arena-bytes
          (ci.intern-persistent-arena-handle))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-lifetime-emit!
    [job-state : TcJobState]
    [pools : ast.AstNodePoolContext]
    [boundary : String]) : unit
    (let
      [metrics-address : u64 (compiler-tc-profile-metrics-address job-state)]
      [state : TcMacroState (tc-job-state-macro-state job-state)]
      [cumulative-alloc : i64
        (-
          (profile.alloc-total)
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-total-metric))]
      [live-delta : i64
        (compiler-tc-macro-lifetime-nonnegative
          (-
            (profile.alloc-live)
            (compiler-tc-profile-metric-value
              metrics-address
              compiler-tc-macro-lifetime-start-live-metric)))]
      [peak-delta : i64
        (compiler-tc-macro-lifetime-nonnegative
          (-
            (profile.compile-wide-peak-current)
            (compiler-tc-profile-metric-value
              metrics-address
              compiler-tc-macro-lifetime-start-peak-metric)))]
      [pool-base : i64
        (compiler-tc-macro-lifetime-owner-delta
          (ast.ast-node-pool-context-base-arena pools)
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-pool-base-metric))]
      [expr-pool : i64
        (compiler-tc-macro-lifetime-owner-delta
          (ast.ast-node-pool-context-expr-storage-arena pools)
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-expr-pool-metric))]
      [type-pool : i64
        (compiler-tc-macro-lifetime-owner-delta
          (ast.ast-node-pool-context-type-storage-arena pools)
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-type-pool-metric))]
      [symbols-current : i64
        (compiler-tc-macro-lifetime-arena-bytes
          (tc-macro-walk-field state macro-live-symbols-arena))]
      [symbols-retired : i64
        (compiler-tc-macro-lifetime-arena-bytes
          (tc-macro-walk-field state macro-live-symbols-retired-arena))]
      [expansion-pool : i64
        (compiler-tc-macro-lifetime-arena-bytes
          (tc-macro-walk-field state macro-expand-scratch-arena))]
      [active-generations : i64
        (+
          (compiler-tc-macro-lifetime-arena-bytes
            (tc-macro-walk-field state macro-decl-generation-arena))
          (compiler-tc-macro-lifetime-arena-bytes
            (tc-macro-walk-field state macro-splice-generation-arena)))]
      [retired-generations : i64
        (+
          (compiler-tc-macro-lifetime-arena-bytes
            (tc-macro-walk-field state macro-decl-generation-retired-arena))
          (compiler-tc-macro-lifetime-arena-bytes
            (tc-macro-walk-field state macro-splice-generation-retired-arena)))]
      [job-owner-handle : i64 (tc-macro-state-owner-arena state)]
      [scoped-env-handle : i64
        (tc-job-state-type-env-scoped-state-arena job-state)]
      [scoped-env : i64
        (compiler-tc-macro-lifetime-owner-delta
          scoped-env-handle
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-scoped-env-bytes-metric))]
      ;; Spellings interned during expansion (generated names, hygiene
      ;; renames) persist in the intern arena for the whole session.
      [intern-handle : i64 (ci.intern-persistent-arena-handle)]
      [interns : i64
        (compiler-tc-macro-lifetime-owner-delta
          intern-handle
          (compiler-tc-profile-metric-value
            metrics-address
            compiler-tc-macro-lifetime-start-intern-bytes-metric))]
      [job-owner : i64
        (if (or
          (= job-owner-handle (ast.ast-node-pool-context-base-arena pools))
          (=
            job-owner-handle
            (ast.ast-node-pool-context-expr-storage-arena pools))
          (=
            job-owner-handle
            (ast.ast-node-pool-context-type-storage-arena pools))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-live-symbols-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-live-symbols-retired-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-expand-scratch-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-decl-generation-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-decl-generation-retired-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-splice-generation-arena))
          (=
            job-owner-handle
            (tc-macro-walk-field state macro-splice-generation-retired-arena))
          (= job-owner-handle scoped-env-handle)
          (= job-owner-handle intern-handle))
          0
          (compiler-tc-macro-lifetime-owner-delta
            job-owner-handle
            (compiler-tc-profile-metric-value
              metrics-address
              compiler-tc-macro-lifetime-start-job-owner-bytes-metric)))]
      [enclosing-handle : i64
        (compiler-tc-profile-metric-value
          metrics-address
          compiler-tc-macro-lifetime-start-enclosing-handle-metric)]
      [enclosing : i64
        (if (or
          (= enclosing-handle job-owner-handle)
          (= enclosing-handle (ast.ast-node-pool-context-base-arena pools))
          (=
            enclosing-handle
            (ast.ast-node-pool-context-expr-storage-arena pools))
          (=
            enclosing-handle
            (ast.ast-node-pool-context-type-storage-arena pools))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-live-symbols-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-live-symbols-retired-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-expand-scratch-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-decl-generation-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-decl-generation-retired-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-splice-generation-arena))
          (=
            enclosing-handle
            (tc-macro-walk-field state macro-splice-generation-retired-arena))
          (= enclosing-handle scoped-env-handle)
          (= enclosing-handle intern-handle))
          0
          (compiler-tc-macro-lifetime-owner-delta
            enclosing-handle
            (compiler-tc-profile-metric-value
              metrics-address
              compiler-tc-macro-lifetime-start-enclosing-bytes-metric)))]
      [named : i64
        (+
          interns
          (+
            scoped-env
            (+
              job-owner
              (+
                enclosing
                (+
                  pool-base
                  (+
                    expr-pool
                    (+
                      type-pool
                      (+
                        symbols-current
                        (+
                          symbols-retired
                          (+
                            expansion-pool
                            (+ active-generations retired-generations)))))))))))]
      [remainder : i64 (- live-delta named)]
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "total"
        "boundary-total"
        cumulative-alloc
        live-delta
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "macro-enclosing"
        "session"
        cumulative-alloc
        enclosing
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "macro-job-registry-cache"
        "session"
        cumulative-alloc
        job-owner
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "intern-storage"
        "session"
        cumulative-alloc
        interns
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "scoped-env-index"
        "cache"
        cumulative-alloc
        scoped-env
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "output-pool-base"
        "lower-handoff"
        cumulative-alloc
        pool-base
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "output-expr-pool"
        "lower-handoff"
        cumulative-alloc
        expr-pool
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "output-type-pool"
        "lower-handoff"
        cumulative-alloc
        type-pool
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "live-symbols-registry"
        "macro-live"
        cumulative-alloc
        symbols-current
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "retired-symbols-registry"
        "retired"
        cumulative-alloc
        symbols-retired
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "expansion-pool"
        "scratch"
        cumulative-alloc
        expansion-pool
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "active-generation-pools"
        "scratch"
        cumulative-alloc
        active-generations
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        (tc-global-shared-view boundary)
        "retired-generation-pools"
        "retired"
        cumulative-alloc
        retired-generations
        peak-delta)
      (compiler-tc-macro-lifetime-emit-row!
        boundary
        "remainder"
        "unattributed"
        cumulative-alloc
        remainder
        peak-delta))))

;; Emit the dominant macro-expansion owners at the last boundary where all of
;; them are simultaneously live. The control query makes this a single cold
;; branch when profiling is disabled; allocator hot paths remain untouched.
(define (macro-expand-allocation-profile-snapshot!
  [state : TcMacroState]
  [reclaiming-symbols : i64]) : unit
  (if (= (allocation_profile.compiler-allocation-profile-control! 0 "" "" 0) 0)
    unit
    (begin
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-enclosing"
        (arena.tl_arena_current))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-scratch"
        (tc-macro-walk-field state macro-expand-scratch-arena))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-current"
        (tc-macro-walk-field state macro-live-symbols-arena))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-retired"
        (tc-macro-walk-field state macro-live-symbols-retired-arena))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-reclaiming"
        reclaiming-symbols)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-hygiene-cache"
        (unsafe
          (deref (tc-macro-module-env-state-view state)).hygiene-cache-arena))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-function-scratch"
        ;; Macro expansion runs before the job-owned typecheck scratch state is
        ;; active, so no function scratch arena is attributable here.
        0)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-body-facts"
        ;; Macro expansion runs before a function-body state is started. The
        ;; old singleton could expose an unrelated job's arena here.
        0)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-prefix-cache"
        (tc-prefix-snapshot-cache-arena-value-for-state
          tc-prefix-snapshot-serial-test-cache-state))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-module-index"
        tc-module-decl-index-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-clone-roots"
        (tc-clone-root-collection-arena-for-macro-state state))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "compiler-entry"
        (allocation_profile.compiler-allocation-profile-entry-arena-handle))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "source-pools"
        ast.node-pool-base-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "intern-persistent"
        (ci.intern-persistent-arena-handle))
      unit)))

(define (macro-expand-scratch-clear-owned-caches! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-expand-active-module "")
  (macro-expand-set-macro-names! state (Nil))
  (macro-expand-set-expr-type-macro-names! state (Nil))
  (macro-live-symbols-clear! state)
  (macro-live-prescan-reset! state)
  (ctfe_support.ctfe-module-macro-export-reset-for-state!
    (tc-macro-ctfe-state state))
  (macro-generated-module-memo-reset! state)
  (macro-generated-decls-memo-reset! state)
  (tc-macro-helper-env-cache-reset! state)
  (tc-macro-module-env-cache-clear! state)
  (tc-nominal-owner-cache-reset-for-macro-state! state)
  (macro-alias-derived-cache-reset-for-state! state)
  (tc-hygiene-module-env-cache-release! state))

(define (macro-expand-scratch-release! [state : TcMacroState]) : unit
  (if (= (tc-macro-walk-field state macro-expand-scratch-arena) 0)
    (begin
      (tc-macro-walk-set! state macro-expand-scratch-enabled false)
      (macro-decl-generations-release! state))
    (let
      [scratch : i64 (tc-macro-walk-field state macro-expand-scratch-arena)]
      [current : i64 (arena.tl_arena_current)]
      [home : i64
        (if (= current scratch)
          ast.node-pool-base-arena
          current)]
      (begin
        (unsafe
          (arena.tl_arena_set home))
        (tc-macro-walk-set! state macro-expand-scratch-enabled false)
        (tc-macro-walk-set! state macro-expand-scratch-arena 0)
        (macro-expand-scratch-clear-owned-caches! state)
        (macro-decl-generations-release! state)
        ;; Macro timing entries were emitted before this boundary and live in
        ;; scratch. Clear the global before destroying their backing storage so
        ;; a later lowering-time declaration macro starts from a valid list.
        (cfg compile-profile (compiler-tc-macro-profile-clear))
        ;; Cache clearing can release independently owned arenas. Start the
        ;; scratch counter after that work so this phase attributes only the
        ;; arena named by macro_scratch_release.
        (cfg compile-profile (compiler-tc-profile-start))
        (unsafe
          (arena.tl_arena_destroy scratch))
        (cfg
          compile-profile
          (compiler-tc-profile-finish "macro_scratch_release"))))))

(define (macro-zero-source-span) : token.SourceSpan
  (token.SourceSpan 1 1 1 1))

(define (macro-source-span-from-ast [span : ast.AstSourceSpan]) : token.SourceSpan
  (token.SourceSpan
    (ast.ast-source-span-start-line span)
    (ast.ast-source-span-start-col span)
    (ast.ast-source-span-end-line span)
    (ast.ast-source-span-end-col span)))

(define (macro-output-syntax-diag [origin : ast.AstExpr] [message : String]) : cdiag.CompilerDiagnostic
  (ctfe_support.ctfe-diagnostic-at-expr origin message))

(define (macro-expansion-site-span [ctx : TcContext] [call-expr : ast.AstExpr]) : TcMaybeAstSourceSpan
  (match (tc-global-shared-view call-expr)
    [(Spanned _ span) (Some span)]
    [(MacroExpansion inner-box _ _)
      (macro-expansion-site-span ctx (tc-context-expr-get ctx inner-box))]
    [(Call func-box _)
      (tc-expr-maybe-span
        (tc-context-expr-bases ctx)
        (tc-context-expr-get ctx func-box))]
    [_ (tc-expr-maybe-span (tc-context-expr-bases ctx) call-expr)]))

(define (macro-diagnostic-with-expansion-site
  [ctx : TcContext]
  [path : String]
  [call-expr : ast.AstExpr]
  [macro-name : String]
  [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (match (macro-expansion-site-span ctx call-expr)
    [(Some span)
      (cdiag.compiler-diagnostic-with-secondary-if-new
        diag
        (&
          (cdiag.CompilerDiagnosticSpan
            path
            (ast.ast-source-span-start-line span)
            (ast.ast-source-span-start-col span)
            (ast.ast-source-span-end-line span)
            (ast.ast-source-span-end-col span)))
        (&
          (CompilerDiagnosticSomeString
            (tc-macro-expansion-frame-label (ci.intern macro-name)))))]
    [(No) diag]))

(define (macro-active-decl-path-id [ctx : TcContext]) : i64
  (__tl-project-field
    (tc-macro-call-site-state-active-decl
      (tc-job-state-macro-call-sites (tc-context-job-state ctx)))
    path-id))

(define (macro-active-decl-path [ctx : TcContext]) : String
  (let
    [path-id : i64 (macro-active-decl-path-id ctx)]
    (if (< path-id 0)
      ""
      (ci.intern-str path-id))))

(define (macro-definition-path-record!
  [ctx : TcContext]
  [module-id : i64]
  [macro-name-id : i64]
  [path : String]) : unit
  (if (< macro-name-id 0)
    unit
    (let
      [state : TcMacroCallSiteState
        (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
      [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
      [display : String (macro-decl-name-display macro-name-id module-id)]
      [owner : arena.Arena (arena.Arena data.fixed-storage-arena)]
      (in-arena
        owner
        (tc_i64_i64_map.insert-ref!
          (&mut data.definition-paths)
          (ci.intern display)
          (ci.intern path))
        ;; Hash-table growth must remain owned by the job state. Indexing also
        ;; runs inside per-declaration generations, which are destroyed after
        ;; each splice; retaining their current arena would leave stale slots.
        (tc-macro-call-site-state-data-set! state data)))))

(define (macro-definition-path-id
  [ctx : TcContext]
  [macro-display-name-id : i64]) : i64
  (let
    [state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (match (tc_i64_i64_map.get (& data.definition-paths) macro-display-name-id)
      [(LookupFound path-id) path-id]
      [(LookupMissing) (macro-active-decl-path-id ctx)])))

(define (macro-definition-path-note-decl!
  [ctx : TcContext]
  [module-id : i64]
  [decl : ast.AstDecl]
  [path : String]) : unit
  (match decl
    [(DefMacro _ name _ _ _)
      (macro-definition-path-record! ctx module-id name path)]
    [(Unsafe inner)
      (macro-definition-path-note-decl!
        ctx
        module-id
        (ast.ast-decl-box-shared-view inner)
        path)]
    [_ unit]))

(define (macro-definition-paths-index!
  [ctx : TcContext]
  [decls : (& decls ast.AstDeclList)]
  [paths : (& paths ast.AstDeclPathList)]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
        [path : String (ast.ast-decl-path-list-get (& paths) index "")]
        (match (ast.ast-decl-unwrapped (& decl))
          [(Module name) (set! module-id name)]
          [_ (macro-definition-path-note-decl! ctx module-id decl path)])
        (set! index (+ index 1))))))

(define (macro-decl-expansion-with-frame
  [ctx : TcContext]
  [path : String]
  [call-expr : ast.AstExpr]
  [macro-name : String]
  [result : ResultMacroDeclExpansion]) : ResultMacroDeclExpansion
  (match result
    [(Ok decls paths) (Ok decls paths)]
    [(Err diag)
      (Err
        (box
          (macro-diagnostic-with-expansion-site
            ctx
            path
            call-expr
            macro-name
            (cdiag.compiler-diagnostic-box-shared-view diag))))]))

(define (macro-output-syntax-id-at
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [site : String]) : i64
  (cond
    [(cis.intern-structural-session-template-source-id? session name-id)
      (cis.intern-structural-session-template-source-name-id-or
        session
        name-id
        -1)]
    [(cis.intern-structural-session-fresh-local-id? session name-id)
      (cis.intern-structural-session-fresh-local-source-name-id-or
        session
        name-id
        -1)]
    [(or
        (macro-hygiene-global-id? session name-id)
        (macro-hygiene-local-id? session name-id))
      (macro-hygiene-structural-source-name-id session name-id)]
    [(or
        (csym.compiler-composite-pair-key-id? name-id)
        (csym.compiler-composite-triple-key-id? name-id))
      name-id]
    [else
      (let
        [name : String
          (macro-output-symbol-text-id
            session
            name-id
            (tc-global-shared-view site))]
        (if (tc-hygiene-template-name? name)
          (let
            [source-id : i64
              (tc-hygiene-template-source-id-or session name-id -1)]
            (if (>= source-id 0)
              source-id
              (io.panic
                (str_cat.str-cat
                  "macro template symbol missing source id at "
                  site))))
          name-id))]))

(define (macro-output-symbol-text-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [site : String]) : String
  (cond
    [(= name-id (ctfe_support.ctfe-internal-resolved-struct-type-marker-id))
      (macro-internal-resolved-struct-type-marker)]
    [(= name-id (ctfe_support.ctfe-internal-resolved-enum-type-marker-id))
      (macro-internal-resolved-enum-type-marker)]
    [(tc-structural-local-name-id? session name-id)
      (tc-hygiene-name-text-id-for-session session name-id)]
    [(macro-hygiene-global-id? session name-id)
      (ci.intern-str (macro-hygiene-structural-source-name-id session name-id))]
    [(cis.intern-structural-session-template-source-id? session name-id)
      (ci.intern-str
        (cis.intern-structural-session-template-source-name-id-or
          session
          name-id
          -1))]
    [(or
        (csym.compiler-composite-pair-key-id? name-id)
        (csym.compiler-composite-triple-key-id? name-id))
      (ast.ast-nominal-name-id-display name-id)]
    [(and (>= name-id 0) (< name-id (ci.intern-capacity)))
      (ci.intern-str name-id)]
    [else
      (io.panic
        (str_cat.str-cat
          "macro output received structural id at "
          site
          ": "
          (string.int->string name-id)))]))

;; id-taking variant: callers have the interned name id; avoids the (intern
;; source-name) the String variant does inside tc-source-slash-qualified?.
(define (macro-output-source-name-id-at
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [site : String]) : String
  (let
    [name : String
      (macro-output-symbol-text-id session name-id (tc-global-shared-view site))]
    [source-name : String
      (if (tc-hygiene-template-name? name)
        (tc-hygiene-template-base name)
        (tc-hygiene-global-symbol-name name))]
    [source-name-id : i64 (macro-output-syntax-id-at session name-id site)]
    (if (tc-source-slash-qualified-id?
      session
      (tc-global-shared-view source-name)
      source-name-id)
      (tc-name-slashes-to-dots source-name)
      source-name)))

(define (macro-output-source-identity-id-at
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [site : String]) : i64
  (cond
    [(or
        (macro-hygiene-global-id? session name-id)
        (tc-structural-local-name-id? session name-id))
      name-id]
    [(cis.intern-structural-session-template-source-id? session name-id)
      (cis.intern-structural-session-template-source-name-id-or
        session
        name-id
        -1)]
    [(or
        (csym.compiler-composite-pair-key-id? name-id)
        (csym.compiler-composite-triple-key-id? name-id))
      name-id]
    [else
      (csym.compiler-symbol-name-id-key
        (macro-output-syntax-id-at session name-id site))]))

(define (macro-decl-list-prepend-from-source
  [head : ast.AstDecl]
  [source : ast.AstDeclList]
  [source-index : i64]
  [rest : ast.AstDeclList]) : ast.AstDeclList
  (let
    [rest-key : i64 (parser.compiler-parse-decl-list-storage-key (& rest))]
    [source-key : i64 (parser.compiler-parse-decl-list-storage-key (& source))]
    [source-slot : i64 (+ source.offset source-index)]
    [out : ast.AstDeclList
      (ast.ast-decl-list-prepend-builder head (tc-global-shared-view rest))]
    [out-key : i64 (parser.compiler-parse-decl-list-storage-key (& out))]
    (if (or (!= out-key source-key) (!= out.offset source-slot))
      (parser.compiler-parse-decl-origin-register-alias-record!
        (& out)
        0
        1
        source-key
        source-slot
        false)
      unit)
    (if (!= out-key rest-key)
      (parser.compiler-parse-decl-origin-register-list-aliases! (& out) 1 rest)
      unit)
    out))

(define (macro-decl-list-reverse-into
  [items : ast.AstDeclList]
  [out : ast.AstDeclList]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& items))]
    [index : i64 0]
    [result : ast.AstDeclList out]
    (while (< index count)
      (set!
        result
        (macro-decl-list-prepend-from-source
          (ast.ast-decl-list-ref items index)
          (tc-global-shared-view items)
          index
          result))
      (set! index (+ index 1)))
    result))

(define (macro-decl-list-reverse [items : ast.AstDeclList]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& items))]
    [index : i64 count]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [item-offset : i64 items.offset]
    (while (> index 0)
      (set! index (- index 1))
      ;; `out` is freshly allocated here, so it cannot alias `items`.
      (ast.ast-decl-list-push-from
        (&mut out)
        (& items.slots)
        (+ item-offset index))
      (parser.compiler-parse-decl-origin-register-alias-record!
        (& out)
        (- (ast.ast-decl-list-len (& out)) 1)
        1
        (parser.compiler-parse-decl-list-storage-key (& items))
        (+ item-offset index)
        false))
    out))

(define (macro-decl-list-with-prefix-reserve
  [items : ast.AstDeclList]
  [reserve : i64]) : ast.AstDeclList
  (if (and (>= items.offset reserve) items.prependable)
    items
    (let
      [count : i64 (ast.ast-decl-list-len (& items))]
      [slots : (__tl_dyn-array ast.AstDecl)
        (__tl_make-array ast.AstDecl (+ reserve count))]
      [reserved : ast.AstDeclList (ast.AstDeclList slots reserve count true)]
      (ast.ast-decl-list-copy-to
        (&mut reserved.slots)
        (& items.slots)
        items.offset
        reserve
        0
        count)
      ;; Macro expansion reports diagnostics against this copied spine, so
      ;; keep each source declaration's cold parser-origin record reachable.
      (parser.compiler-parse-decl-origin-register-list-aliases!
        (& reserved)
        0
        items)
      reserved)))

(define (macro-decl-list-append-from
  [out : (&mut out ast.AstDeclList)]
  [items : (& items ast.AstDeclList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len items)]
    [item-offset : i64 items.offset]
    (while (< index count)
      (ast.ast-decl-list-push-from out (& items.slots) (+ item-offset index))
      (set! index (+ index 1)))))

(define (macro-decl-list-append
  [left : ast.AstDeclList]
  [right : ast.AstDeclList]) : ast.AstDeclList
  (let
    [left-len : i64 (ast.ast-decl-list-len (& left))]
    [right-len : i64 (ast.ast-decl-list-len (& right))]
    (if (and
      (<= left-len right.offset)
      right.prependable
      (not
        (unsafe
          (=
            (ptr->int (ptr-cast (__tl_array-data left.slots) : (Ptr u8)))
            (ptr->int (ptr-cast (__tl_array-data right.slots) : (Ptr u8)))))))
      (let
        [new-offset : i64 (- right.offset left-len)]
        [right-slots : (__tl_dyn-array ast.AstDecl) right.slots]
        ;; Macro expansion walks a suffix of the current whole-program vector.
        ;; Its consumed prefix is dead after the splice context is rebuilt, so
        ;; reconstruct the next view in that headroom instead of retaining a
        ;; fresh whole-program copy for every splice. Distinct backing storage
        ;; is required because the left copy may otherwise overlap the writes.
        (ast.ast-decl-list-copy-to
          (&mut right-slots)
          (& left.slots)
          left.offset
          new-offset
          0
          left-len)
        (let
          [out : ast.AstDeclList
            (ast.AstDeclList right-slots new-offset (+ left-len right-len) true)]
          (parser.compiler-parse-decl-origin-register-list-aliases!
            (& out)
            0
            left)
          out))
      (let
        [out : ast.AstDeclList
          (ast.ast-decl-list-with-capacity (+ left-len right-len))]
        (macro-decl-list-append-from (&mut out) (& left))
        (macro-decl-list-append-from (&mut out) (& right))
        (parser.compiler-parse-decl-origin-register-list-aliases!
          (& out)
          0
          left)
        (parser.compiler-parse-decl-origin-register-list-aliases!
          (& out)
          left-len
          right)
        out))))

(define (macro-flatten-module-body-decls-into-with-origins
  [decls : ast.AstDeclList]
  [module-id : i64]
  [result : (&mut result ast.AstDeclList)]
  [out-origins : (&mut out-origins parser.CompilerParseDeclOriginAliasVec)]) : unit
  (let
    [cursor : ast.AstDeclList decls]
    [current-module-id : i64 module-id]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (match (tc-global-shared-view decl)
            [(Module next-module)
              (ast.ast-decl-list-push result (tc-global-shared-view decl))
              (parser.compiler-parse-decl-origin-alias-vec-push-key-slot!
                out-origins
                (- (ast.ast-decl-list-len result) 1)
                1
                (parser.compiler-parse-decl-list-storage-key (& rest))
                (- rest.offset 1)
                decl
                false)
              (set! current-module-id next-module)]
            [(ModuleBody target-module-id body-box)
              (ast.ast-decl-list-push
                result
                (ast.ast-decl-module-id target-module-id))
              (parser.compiler-parse-decl-origin-alias-vec-push-key-slot!
                out-origins
                (- (ast.ast-decl-list-len result) 1)
                1
                (parser.compiler-parse-decl-list-storage-key (& rest))
                (- rest.offset 1)
                (tc-global-shared-view decl)
                false)
              (macro-flatten-module-body-decls-into-with-origins
                (ast.ast-decl-list-box-shared-view body-box)
                target-module-id
                result
                out-origins)
              (ast.ast-decl-list-push
                result
                (ast.ast-decl-module-id current-module-id))
              (parser.compiler-parse-decl-origin-alias-vec-push-key-slot!
                out-origins
                (- (ast.ast-decl-list-len result) 1)
                1
                (parser.compiler-parse-decl-list-storage-key (& rest))
                (- rest.offset 1)
                decl
                false)]
            [_
              (ast.ast-decl-list-push result (tc-global-shared-view decl))
              (parser.compiler-parse-decl-origin-alias-vec-push-key-slot!
                out-origins
                (- (ast.ast-decl-list-len result) 1)
                1
                (parser.compiler-parse-decl-list-storage-key (& rest))
                (- rest.offset 1)
                decl
                false)])
          (set! cursor rest)]))
    unit))

(define (macro-flatten-module-body-decls-into
  [decls : ast.AstDeclList]
  [module-id : i64]
  [out : ast.AstDeclList]) : ast.AstDeclList
  (let
    [out-origins : parser.CompilerParseDeclOriginAliasVec
      (parser.compiler-parse-decl-origin-alias-vec-with-capacity
        (ast.ast-decl-list-len (& decls)))]
    [result : ast.AstDeclList out]
    (macro-flatten-module-body-decls-into-with-origins
      decls
      module-id
      (&mut result)
      (&mut out-origins))
    (parser.compiler-parse-decl-origin-alias-vec-register!
      (& result)
      (& out-origins))
    result))

(define (macro-flatten-module-body-decls-in-module
  [decls : ast.AstDeclList]
  [module-id : i64]) : ast.AstDeclList
  (macro-flatten-module-body-decls-into decls module-id (ast.ast-decl-list-new)))

(define (macro-decl-path-list-reverse-into
  [items : ast.AstDeclPathList]
  [out : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [cursor : ast.AstDeclPathList items]
    [result : ast.AstDeclPathList out]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-path-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons head rest)
          (set!
            result
            (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
              head
              (ast.ast-decl-path-list-owner-id
                (& cursor)
                0
                cbi.compiler-builtin-id-fix-empty)
              (ast.ast-decl-path-list-provenance-id
                (& cursor)
                0
                cbi.compiler-builtin-id-fix-empty)
              result))
          (set! cursor rest)]))
    result))

(define (macro-decl-path-list-reverse [items : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [count : i64 (ast.ast-decl-path-list-len (& items))]
    [index : i64 count]
    [out : ast.AstDeclPathList (ast.ast-decl-path-list-with-capacity count)]
    (while (> index 0)
      (set! index (- index 1))
      (ast.ast-decl-path-list-push-with-owner-and-provenance-id
        (&mut out)
        (ast.ast-decl-path-list-get (& items) index "")
        (ast.ast-decl-path-list-owner-id
          (& items)
          index
          cbi.compiler-builtin-id-fix-empty)
        (ast.ast-decl-path-list-provenance-id
          (& items)
          index
          cbi.compiler-builtin-id-fix-empty)))
    out))

(define (macro-decl-path-list-with-prefix-reserve
  [items : ast.AstDeclPathList]
  [reserve : i64]) : ast.AstDeclPathList
  (if (and (>= items.offset reserve) items.prependable)
    items
    (let
      [count : i64 (ast.ast-decl-path-list-len (& items))]
      [capacity : i64 (+ reserve count)]
      [items-capacity : i64 (array-length items.slots)]
      [slots : (__tl_dyn-array String) (__tl_make-array String capacity)]
      [owner-ids : (__tl_dyn-array i64) (__tl_make-array i64 (* capacity 2))]
      (ast.ast-decl-path-list-copy-to
        (&mut slots)
        (& items.slots)
        items.offset
        reserve
        0
        count)
      (ast.ast-decl-module-list-copy-to
        (&mut owner-ids)
        (& items.owner-ids)
        items.offset
        reserve
        0
        count)
      (ast.ast-decl-module-list-copy-to
        (&mut owner-ids)
        (& items.owner-ids)
        (+ items-capacity items.offset)
        (+ capacity reserve)
        0
        count)
      (ast.AstDeclPathList slots owner-ids reserve count true))))

(define (macro-decl-path-list-append-from
  [out : (&mut out ast.AstDeclPathList)]
  [items : (& items ast.AstDeclPathList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast.ast-decl-path-list-len items)]
    (while (< index count)
      (ast.ast-decl-path-list-push-with-owner-and-provenance-id
        out
        (ast.ast-decl-path-list-get items index "")
        (ast.ast-decl-path-list-owner-id
          items
          index
          cbi.compiler-builtin-id-fix-empty)
        (ast.ast-decl-path-list-provenance-id
          items
          index
          cbi.compiler-builtin-id-fix-empty))
      (set! index (+ index 1)))))

(define (macro-decl-path-list-append
  [left : ast.AstDeclPathList]
  [right : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [left-len : i64 (ast.ast-decl-path-list-len (& left))]
    [right-len : i64 (ast.ast-decl-path-list-len (& right))]
    [left-capacity : i64 (array-length left.slots)]
    [right-capacity : i64 (array-length right.slots)]
    (if (and
      (<= left-len right.offset)
      right.prependable
      (not
        (unsafe
          (=
            (ptr->int (ptr-cast (__tl_array-data left.slots) : (Ptr u8)))
            (ptr->int (ptr-cast (__tl_array-data right.slots) : (Ptr u8)))))))
      (let
        [new-offset : i64 (- right.offset left-len)]
        [right-slots : (__tl_dyn-array String) right.slots]
        [right-owner-ids : (__tl_dyn-array i64) right.owner-ids]
        (ast.ast-decl-path-list-copy-to
          (&mut right-slots)
          (& left.slots)
          left.offset
          new-offset
          0
          left-len)
        (ast.ast-decl-module-list-copy-to
          (&mut right-owner-ids)
          (& left.owner-ids)
          left.offset
          new-offset
          0
          left-len)
        (ast.ast-decl-module-list-copy-to
          (&mut right-owner-ids)
          (& left.owner-ids)
          (+ left-capacity left.offset)
          (+ right-capacity new-offset)
          0
          left-len)
        (ast.AstDeclPathList
          right-slots
          right-owner-ids
          new-offset
          (+ left-len right-len)
          true))
      (let
        [out : ast.AstDeclPathList
          (ast.ast-decl-path-list-with-capacity (+ left-len right-len))]
        (macro-decl-path-list-append-from (&mut out) (& left))
        (macro-decl-path-list-append-from (&mut out) (& right))
        out))))

(defstruct MacroProgramSegmentNodeData
  (decls ast.AstDeclList)
  (paths ast.AstDeclPathList)
  ;; The ascending slot positions (`decls.offset + index`) of the declarations
  ;; that are, once unwrapped, a module marker or an import
  ;; (macro-decl-list-events). A zero-copy suffix slice shares its parent's
  ;; array: the slots are the same, and positions outside the slice are ignored.
  (events (__tl_dyn-array i64))
  (next i64))

(defstruct MacroSegmentedProgramViewData
  ;; Declarations already emitted by the walk retain its cheap reversed
  ;; builder shape. Logical indexed access reverses only the index; it never
  ;; copies the prefix merely to publish a new splice view.
  (prefix-rev ast.AstDeclList)
  (prefix-paths-rev ast.AstDeclPathList)
  ;; The unprocessed program is an immutable linked sequence of array slices.
  ;; A splice allocates one persisted delta node and, when necessary, one
  ;; zero-copy suffix slice node.
  (head i64)
  (cursor i64)
  (queue-len i64)
  (generation i64)
  ;; The prefix's event positions in program order (0 is the first emitted
  ;; declaration), for the first `prefix-scanned` declarations of it
  ;; (macro-segmented-prefix-events-sync!). The prefix only ever grows at its
  ;; logical end, so the positions stay valid. `storage` is the arena the view
  ;; and these arrays live in.
  (prefix-events (__tl_dyn-array i64))
  (prefix-event-count i64)
  (prefix-scanned i64)
  (storage i64))

(define (macro-program-segment-node-data [address : i64]) : MacroProgramSegmentNodeData
  (unsafe
    (ptr-read
      (int->ptr (cast address : u64) : (Ptr MacroProgramSegmentNodeData)))))

(define (macro-segmented-program-view-ptr [address : i64]) : (MutPtr
    MacroSegmentedProgramViewData)
  (unsafe
    (int->ptr (cast address : u64) : (MutPtr MacroSegmentedProgramViewData))))

(define (macro-segmented-program-view-data [address : i64]) : MacroSegmentedProgramViewData
  (unsafe
    (ptr-read
      (int->ptr (cast address : u64) : (Ptr MacroSegmentedProgramViewData)))))

(define (macro-segmented-program-view-data-set!
  [address : i64]
  [data : MacroSegmentedProgramViewData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (cast address : u64) : (MutPtr MacroSegmentedProgramViewData))
      data)))

;; Module markers and imports are the only declarations that change which
;; module the rows after them belong to or which aliases a module sees. The
;; whole-program walks a macro expansion repeats after every splice -- a module's
;; local environment, the alias index -- visit these positions and the rows of
;; the one or two modules they need, rather than every row of the program
;; (#8120).
(define (macro-decl-list-event-at?
  [decls : (& decls ast.AstDeclList)]
  [index : i64]) : bool
  (ast.ast-decl-list-unwrapped-module-or-import-at? decls index))

(define (macro-decl-list-events [decls : (& decls ast.AstDeclList)]) : (__tl_dyn-array
    i64)
  (let
    [count : i64 (ast.ast-decl-list-len decls)]
    [found : i64 0]
    [index : i64 0]
    (while (< index count)
      (if (macro-decl-list-event-at? decls index)
        (set! found (+ found 1))
        unit)
      (set! index (+ index 1)))
    (let
      [events : (__tl_dyn-array i64) (__tl_make-array i64 found)]
      [slot : i64 0]
      (set! index 0)
      (while (< index count)
        (when
          (macro-decl-list-event-at? decls index)
          (set! (array-ref events slot) (+ decls.offset index))
          (set! slot (+ slot 1)))
        (set! index (+ index 1)))
      events)))

(define (macro-program-segment-node-new-current
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [events : (__tl_dyn-array i64)]
  [next : i64]) : i64
  (let
    [cell : (__tl_dyn-array MacroProgramSegmentNodeData)
      (__tl_make-array MacroProgramSegmentNodeData 1)]
    (set!
      (array-ref cell 0)
      (MacroProgramSegmentNodeData decls paths events next))
    (cast
      (unsafe
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr MacroProgramSegmentNodeData))))
      : i64)))

(define (macro-segmented-program-view-new-current
  [prefix-rev : ast.AstDeclList]
  [prefix-paths-rev : ast.AstDeclPathList]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [storage : i64]) : i64
  (let
    [head : i64
      (if (<= (ast.ast-decl-list-len (& decls)) 0)
        0
        (macro-program-segment-node-new-current
          (tc-global-shared-view decls)
          paths
          (macro-decl-list-events (& decls))
          0))]
    [cell : (__tl_dyn-array MacroSegmentedProgramViewData)
      (__tl_make-array MacroSegmentedProgramViewData 1)]
    (set!
      (array-ref cell 0)
      (MacroSegmentedProgramViewData
        prefix-rev
        prefix-paths-rev
        head
        0
        (ast.ast-decl-list-len (& decls))
        0
        (__tl_make-array i64 0)
        0
        0
        storage))
    (cast
      (unsafe
        (ptr->int
          (ptr-cast
            (__tl_array-data cell)
            : (Ptr MacroSegmentedProgramViewData))))
      : i64)))

(define (macro-segmented-program-begin!
  [state : TcJobState]
  [prefix-rev : ast.AstDeclList]
  [prefix-paths-rev : ast.AstDeclPathList]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state state)]
    [enclosing : i64 (arena.tl_arena_current)]
    [storage : i64
      (if (tc-macro-walk-field macro-state macro-expand-scratch-enabled)
        (macro-expand-scratch-arena-get macro-state)
        enclosing)]
    [address : i64
      (in-arena
        (arena.Arena storage)
        (macro-segmented-program-view-new-current
          prefix-rev
          prefix-paths-rev
          decls
          paths
          storage))]
    (tc-job-state-set-macro-program-view-address! state address)))

(define (macro-segmented-program-end! [state : TcJobState]) : unit
  (tc-job-state-set-macro-program-view-address! state 0))

(define (macro-segmented-program-active? [state : TcJobState]) : bool
  (> (tc-job-state-macro-program-view-address state) 0))

(define (macro-segmented-program-prefix-set!
  [state : TcJobState]
  [prefix-rev : ast.AstDeclList]
  [prefix-paths-rev : ast.AstDeclPathList]) : unit
  (let
    [address : i64 (tc-job-state-macro-program-view-address state)]
    (if (= address 0)
      unit
      (let
        [data : (MutPtr MacroSegmentedProgramViewData)
          (macro-segmented-program-view-ptr address)]
        (unsafe
          (set! (deref data).prefix-rev prefix-rev)
          (set! (deref data).prefix-paths-rev prefix-paths-rev))))))

(define (macro-segmented-program-normalize-head! [state : TcJobState]) : MacroSegmentedProgramViewData
  (let
    [address : i64 (tc-job-state-macro-program-view-address state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data address)]
    [done : bool false]
    (while (and (not done) (> data.head 0))
      (let
        [node : MacroProgramSegmentNodeData
          (macro-program-segment-node-data data.head)]
        (if (< data.cursor (ast.ast-decl-list-len (& node.decls)))
          (set! done true)
          (begin
            (set! data.head node.next)
            (set! data.cursor 0)))))
    (macro-segmented-program-view-data-set!
      address
      (tc-global-shared-view data))
    data))

(define (macro-segmented-program-empty? [state : TcJobState]) : bool
  (if (not (macro-segmented-program-active? state))
    true
    (let
      [data : MacroSegmentedProgramViewData
        (macro-segmented-program-normalize-head! state)]
      (or (<= data.queue-len 0) (= data.head 0)))))

(define (macro-segmented-program-current-decl [state : TcJobState]) : ast.AstDecl
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    (ast.ast-decl-list-ref node.decls data.cursor)))

(define (macro-segmented-program-prepend-current
  [state : TcJobState]
  [rest : ast.AstDeclList]) : ast.AstDeclList
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    (macro-decl-list-prepend-from-source
      (ast.ast-decl-list-ref node.decls data.cursor)
      node.decls
      data.cursor
      rest)))

(define (macro-segmented-program-register-current-origin!
  [state : TcJobState]
  [expanded : (& expanded ast.AstDeclList)]) : unit
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    [count : i64 (ast.ast-decl-list-len expanded)]
    (parser.compiler-parse-decl-origin-register-alias-record!
      expanded
      0
      count
      (parser.compiler-parse-decl-list-storage-key (& node.decls))
      (+ node.decls.offset data.cursor)
      (!= count 1))))

(define (macro-segmented-program-current-path [state : TcJobState]) : String
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    (ast.ast-decl-path-list-get (& node.paths) data.cursor "")))

(define (macro-segmented-program-current-owner-id [state : TcJobState]) : i64
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    (ast.ast-decl-path-list-owner-id
      (& node.paths)
      data.cursor
      cbi.compiler-builtin-id-fix-empty)))

(define (macro-segmented-program-current-provenance-id [state : TcJobState]) : i64
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    (ast.ast-decl-path-list-provenance-id
      (& node.paths)
      data.cursor
      cbi.compiler-builtin-id-fix-empty)))

(define (macro-segmented-program-advance! [state : TcJobState]) : unit
  (let
    [address : i64 (tc-job-state-macro-program-view-address state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    (when
      (> data.queue-len 0)
      (set! data.cursor (+ data.cursor 1))
      (set! data.queue-len (- data.queue-len 1)))
    (macro-segmented-program-view-data-set! address data)
    (macro-segmented-program-normalize-head! state)
    unit))

(define (macro-segmented-path-drop [paths : ast.AstDeclPathList] [count : i64]) : ast.AstDeclPathList
  (let
    [len : i64 (ast.ast-decl-path-list-len (& paths))]
    [drop : i64 (cond [(< count 0) 0] [(> count len) len] [else count])]
    (ast.AstDeclPathList
      paths.slots
      paths.owner-ids
      (+ paths.offset drop)
      (- len drop)
      false)))

(define (macro-segmented-decl-copy-current [decls : ast.AstDeclList]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [capacity : i64
      (if (< count 1)
        1
        count)]
    [slots : (__tl_dyn-array ast.AstDecl)
      (__tl_make-array ast.AstDecl capacity)]
    [src-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [src-offset : i64 decls.offset]
    [index : i64 0]
    (while (< index count)
      (set! (array-ref slots index) (array-ref src-slots (+ src-offset index)))
      (set! index (+ index 1)))
    (ast.AstDeclList slots 0 count true)))

(define (macro-segmented-path-copy-current
  [paths : ast.AstDeclPathList]
  [decl-count : i64]) : ast.AstDeclPathList
  (let
    [capacity : i64
      (if (< decl-count 1)
        1
        decl-count)]
    [slots : (__tl_dyn-array String) (__tl_make-array String capacity)]
    [owner-ids : (__tl_dyn-array i64) (__tl_make-array i64 (* capacity 2))]
    [index : i64 0]
    (while (< index decl-count)
      (set!
        (array-ref slots index)
        (ast.ast-decl-path-list-get (& paths) index ""))
      (set!
        (array-ref owner-ids index)
        (ast.ast-decl-path-list-owner-id
          (& paths)
          index
          cbi.compiler-builtin-id-fix-empty))
      (set!
        (array-ref owner-ids (+ capacity index))
        (ast.ast-decl-path-list-provenance-id
          (& paths)
          index
          cbi.compiler-builtin-id-fix-empty))
      (set! index (+ index 1)))
    (ast.AstDeclPathList slots owner-ids 0 decl-count true)))

(define (macro-segmented-decl-list-affects-clone-set?
  [decls : (& decls ast.AstDeclList)]) : bool
  (let
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len decls)]
    [found : bool false]
    (while (and (not found) (< index count))
      (if (or
        (ast.ast-decl-list-unwrapped-module-or-import-at? decls index)
        (ast.ast-decl-list-unwrapped-module-or-type-definition-at? decls index))
        (set! found true)
        unit)
      (set! index (+ index 1)))
    found))

(define (macro-segmented-program-splice-current-in-scratch!
  [state : TcJobState]
  [middle : ast.AstDeclList]
  [middle-paths : ast.AstDeclPathList]) : unit
  (let
    [address : i64 (tc-job-state-macro-program-view-address state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-normalize-head! state)]
    [node : MacroProgramSegmentNodeData
      (macro-program-segment-node-data data.head)]
    [next-index : i64 (+ data.cursor 1)]
    [node-decls : ast.AstDeclList node.decls]
    [node-paths : ast.AstDeclPathList node.paths]
    [node-count : i64 (ast.ast-decl-list-len (& node-decls))]
    [clone-set-changed : bool
      (or
        (ast.ast-decl-list-unwrapped-module-or-import-at?
          (& node-decls)
          data.cursor)
        (ast.ast-decl-list-unwrapped-module-or-type-definition-at?
          (& node-decls)
          data.cursor)
        (macro-segmented-decl-list-affects-clone-set? (& middle)))]
    [suffix-count : i64 (- node-count next-index)]
    [suffix-head : i64
      (if (> suffix-count 0)
        (macro-program-segment-node-new-current
          (ast.AstDeclList
            node-decls.slots
            (+ node-decls.offset next-index)
            suffix-count
            false)
          (macro-segmented-path-drop node-paths next-index)
          node.events
          node.next)
        node.next)]
    [middle-count : i64 (ast.ast-decl-list-len (& middle))]
    [stable-middle : ast.AstDeclList (macro-segmented-decl-copy-current middle)]
    [middle-events : (__tl_dyn-array i64)
      (macro-decl-list-events (& stable-middle))]
    [stable-paths : ast.AstDeclPathList
      (macro-segmented-path-copy-current middle-paths middle-count)]
    [next-head : i64
      (if (> middle-count 0)
        (macro-program-segment-node-new-current
          stable-middle
          stable-paths
          middle-events
          suffix-head)
        suffix-head)]
    (begin
      (if clone-set-changed
        (tc-clone-able-cache-reset-for-job! state)
        unit)
      (cfg
        compile-profile
        (begin
          (compiler-tc-macro-profile-metric-add!
            (tc-job-state-macro-state state)
            tc-profile-segment-splits
            1)
          (compiler-tc-macro-profile-metric-add!
            (tc-job-state-macro-state state)
            tc-profile-segment-delta-decls
            middle-count)))
      (set! data.head next-head)
      (set! data.cursor 0)
      (set! data.queue-len (+ (- data.queue-len 1) middle-count))
      (set! data.generation (+ data.generation 1))
      (macro-segmented-program-view-data-set! address data))))

(define (macro-segmented-program-splice-current!
  [state : TcJobState]
  [middle : ast.AstDeclList]
  [middle-paths : ast.AstDeclPathList]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state state)]
    [storage : i64 (macro-expand-scratch-arena-get macro-state)]
    (in-arena
      (arena.Arena storage)
      (macro-segmented-program-splice-current-in-scratch!
        state
        middle
        middle-paths))))

(define (macro-segmented-program-decl-count [state : TcJobState]) : i64
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data
        (tc-job-state-macro-program-view-address state))]
    (+ (ast.ast-decl-list-len (& data.prefix-rev)) data.queue-len)))

(defstruct MacroSegmentedProgramIter
  ;; The current row descriptors are owned by the iterator. They change only
  ;; when the cursor leaves the reversed prefix or enters another segment;
  ;; advancing within one segment updates scalar indexes only.
  (decls ast.AstDeclList)
  (paths ast.AstDeclPathList)
  (index i64)
  (prefix-index i64)
  (node-address i64)
  (node-index i64)
  (has-current bool))

(define (macro-segmented-program-iter-current-decl
  [iter : (& iter MacroSegmentedProgramIter)]) : ast.AstDecl
  (tc-global-array-element-shared-view
    iter.decls.slots
    (+ iter.decls.offset iter.index)))

;; Move an exhausted prefix or segment cursor to the next non-empty segment.
;; Descriptor copies happen once per segment rather than once per declaration.
(define (macro-segmented-program-iter-normalize-node!
  [iter : (&mut iter MacroSegmentedProgramIter)]) : unit
  (let
    [done : bool false]
    (set! iter.has-current false)
    (while (and (not done) (> iter.node-address 0))
      (let
        [node : MacroProgramSegmentNodeData
          (macro-program-segment-node-data iter.node-address)]
        [decls : ast.AstDeclList node.decls]
        (if (< iter.node-index (ast.ast-decl-list-len (& decls)))
          (begin
            (set! iter.decls decls)
            (set! iter.paths node.paths)
            (set! iter.index iter.node-index)
            (set! iter.has-current true)
            (set! done true))
          (begin
            (set! iter.node-address node.next)
            (set! iter.node-index 0)))))))

(define (macro-segmented-program-iter [state : TcJobState]) : MacroSegmentedProgramIter
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data
        (tc-job-state-macro-program-view-address state))]
    [prefix : ast.AstDeclList data.prefix-rev]
    [prefix-index : i64 (- (ast.ast-decl-list-len (& prefix)) 1)]
    [iter : MacroSegmentedProgramIter
      (MacroSegmentedProgramIter
        prefix
        data.prefix-paths-rev
        prefix-index
        prefix-index
        data.head
        data.cursor
        (>= prefix-index 0))]
    (if iter.has-current
      unit
      (macro-segmented-program-iter-normalize-node! (&mut iter)))
    iter))

;; Allocation-free logical cursor across the reversed prefix and ordered
;; segment chain. The caller consumes the current row immediately, then moves
;; the job-local iterator in place; no borrow-plus-successor step aggregate is
;; constructed or retained across pool/segment mutation.
(define (macro-segmented-program-iter-advance!
  [iter : (&mut iter MacroSegmentedProgramIter)]) : unit
  (if (not iter.has-current)
    unit
    (if (>= iter.prefix-index 0)
      (if (> iter.prefix-index 0)
        (begin
          (set! iter.prefix-index (- iter.prefix-index 1))
          (set! iter.index iter.prefix-index))
        (begin
          (set! iter.prefix-index -1)
          (macro-segmented-program-iter-normalize-node! iter)))
      (begin
        (set! iter.node-index (+ iter.node-index 1))
        (if (< iter.node-index (ast.ast-decl-list-len (& iter.decls)))
          (set! iter.index iter.node-index)
          (macro-segmented-program-iter-normalize-node! iter))))))

(define (macro-segmented-clone-name-set-note-decl
  [names : clone_support.CloneNameSet]
  [module-id : i64]
  [decl : ast.AstDecl]) : clone_support.CloneNameSet
  (match (ast.ast-decl-unwrapped (& decl))
    [(Import _ (Spec _ _ (Some target) (Some alias) _))
      (clone_support.clone-name-set-insert-alias-id
        names
        module-id
        alias
        target)]
    [(or (DefEnum _ name _ _) (DefStruct _ name _ _ _))
      (clone_support.clone-name-set-insert-id
        names
        (clone_support.clone-name-key-id-in-module module-id name))]
    [_ names]))

(define (macro-segmented-clone-name-set-for-program [state : TcJobState]) : clone_support.CloneNameSet
  (let
    [empty : clone_support.CloneNameSet (clone_support.clone-name-set-empty)]
    [names : clone_support.CloneNameSet
      (clone_support.clone-name-set-with-capacity
        (macro-segmented-program-decl-count state)
        empty.aliases)]
    [module-id : i64 (clone_support.clone-root-module-id)]
    [iter : MacroSegmentedProgramIter (macro-segmented-program-iter state)]
    (while iter.has-current
      (if (or
        (ast.ast-decl-list-unwrapped-module-or-import-at?
          (& iter.decls)
          iter.index)
        (ast.ast-decl-list-unwrapped-module-or-type-definition-at?
          (& iter.decls)
          iter.index))
        (let
          [decl : ast.AstDecl
            (ast.ast-decl-unwrapped
              (& (macro-segmented-program-iter-current-decl (& iter))))]
          (match (tc-global-shared-view decl)
            [(Module next-module) (set! module-id next-module)]
            [_
              (set!
                names
                (macro-segmented-clone-name-set-note-decl names module-id decl))]))
        unit)
      (macro-segmented-program-iter-advance! (&mut iter)))
    names))

(define (macro-segmented-clone-fixpoint-step
  [state : TcJobState]
  [pools : ast.AstNodePoolContext]
  [names : (& names clone_support.CloneNameSet)]) : clone_support.CloneNameSet
  (let
    [out : clone_support.CloneNameSet
      (clone_support.clone-name-set-with-capacity
        (clone_support.clone-name-set-capacity names)
        (clone names.aliases))]
    [module-id : i64 (clone_support.clone-root-module-id)]
    [iter : MacroSegmentedProgramIter (macro-segmented-program-iter state)]
    (while iter.has-current
      (if (ast.ast-decl-list-unwrapped-module-or-type-definition-at?
        (& iter.decls)
        iter.index)
        (match (ast.ast-decl-unwrapped
          (& (macro-segmented-program-iter-current-decl (& iter))))
          [(Module next-module) (set! module-id next-module)]
          [(DefEnum _ name _ variants)
            (if (clone_support.clone-variant-list-able?
              pools
              variants
              names
              module-id)
              (set!
                out
                (clone_support.clone-name-set-insert-id
                  out
                  (clone_support.clone-name-key-id-in-module module-id name)))
              unit)]
          [(DefStruct _ name _ _ fields)
            (if (clone_support.clone-struct-fields-able?
              pools
              fields
              names
              module-id)
              (set!
                out
                (clone_support.clone-name-set-insert-id
                  out
                  (clone_support.clone-name-key-id-in-module module-id name)))
              unit)]
          [_ unit])
        unit)
      (macro-segmented-program-iter-advance! (&mut iter)))
    out))

(define (macro-segmented-clone-able-set-build
  [state : TcJobState]
  [pools : ast.AstNodePoolContext]) : clone_support.CloneNameSet
  (let
    [names : clone_support.CloneNameSet
      (macro-segmented-clone-name-set-for-program state)]
    [done : bool false]
    (while (not done)
      (let
        [next : clone_support.CloneNameSet
          (macro-segmented-clone-fixpoint-step state pools names)]
        (if (=
          (clone_support.clone-name-set-len next)
          (clone_support.clone-name-set-len names))
          (begin
            (set! names next)
            (set! done true))
          (set! names next))))
    names))

(defstruct MacroSegmentedProgramFlatView
  (decls ast.AstDeclList)
  (paths ast.AstDeclPathList))

(define (macro-segmented-program-flatten-raw [state : TcJobState]) : MacroSegmentedProgramFlatView
  (let
    [count : i64 (macro-segmented-program-decl-count state)]
    [capacity : i64
      (if (< count 1)
        1
        count)]
    [decl-slots : (__tl_dyn-array ast.AstDecl)
      (__tl_make-array ast.AstDecl capacity)]
    [path-slots : (__tl_dyn-array String) (__tl_make-array String capacity)]
    [owner-ids : (__tl_dyn-array i64) (__tl_make-array i64 (* capacity 2))]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data
        (tc-job-state-macro-program-view-address state))]
    [prefix-decls : ast.AstDeclList data.prefix-rev]
    [prefix-paths : ast.AstDeclPathList data.prefix-paths-rev]
    [prefix-count : i64 (ast.ast-decl-list-len (& prefix-decls))]
    [index : i64 0]
    ;; The prefix builder is reversed, so write it back-to-front. The queued
    ;; suffix is already ordered inside each segment; walk every node once
    ;; instead of paying an indexed head scan for every output declaration.
    (while (< index prefix-count)
      (set!
        (array-ref decl-slots index)
        (ast.ast-decl-list-ref prefix-decls (- (- prefix-count 1) index)))
      (set!
        (array-ref path-slots index)
        (ast.ast-decl-path-list-get
          (& prefix-paths)
          (- (- prefix-count 1) index)
          ""))
      (set!
        (array-ref owner-ids index)
        (ast.ast-decl-path-list-owner-id
          (& prefix-paths)
          (- (- prefix-count 1) index)
          cbi.compiler-builtin-id-fix-empty))
      (set!
        (array-ref owner-ids (+ capacity index))
        (ast.ast-decl-path-list-provenance-id
          (& prefix-paths)
          (- (- prefix-count 1) index)
          cbi.compiler-builtin-id-fix-empty))
      (set! index (+ index 1)))
    (let
      [node-address : i64 data.head]
      [node-index : i64 data.cursor]
      (while (and (< index count) (> node-address 0))
        (let
          [node : MacroProgramSegmentNodeData
            (macro-program-segment-node-data node-address)]
          [decls : ast.AstDeclList node.decls]
          [paths : ast.AstDeclPathList node.paths]
          [node-count : i64 (ast.ast-decl-list-len (& decls))]
          (while (and (< index count) (< node-index node-count))
            (set!
              (array-ref decl-slots index)
              (ast.ast-decl-list-ref decls node-index))
            (set!
              (array-ref path-slots index)
              (ast.ast-decl-path-list-get (& paths) node-index ""))
            (set!
              (array-ref owner-ids index)
              (ast.ast-decl-path-list-owner-id
                (& paths)
                node-index
                cbi.compiler-builtin-id-fix-empty))
            (set!
              (array-ref owner-ids (+ capacity index))
              (ast.ast-decl-path-list-provenance-id
                (& paths)
                node-index
                cbi.compiler-builtin-id-fix-empty))
            (set! index (+ index 1))
            (set! node-index (+ node-index 1)))
          (set! node-address node.next)
          (set! node-index 0))))
    (MacroSegmentedProgramFlatView
      (ast.AstDeclList decl-slots 0 count true)
      (ast.AstDeclPathList path-slots owner-ids 0 count true))))

;; Intermediate materialization is reserved for the documented conservative
;; source-file/alias fallback. Ordinary marker and generated-module splices
;; remain segmented until the walk's single final reverse.
(define (macro-segmented-program-flatten-fallback
  [state : TcJobState]
  [_reason : i64]) : MacroSegmentedProgramFlatView
  (let
    [out : MacroSegmentedProgramFlatView
      (macro-segmented-program-flatten-raw state)]
    (begin
      (cfg
        compile-profile
        (compiler-tc-walk-segment-fallback-flatten-note!
          (tc-job-state-macro-state state)
          _reason))
      out)))

(define (macro-segmented-program-current-starts-module-import-placeholder?
  [state : TcJobState]) : bool
  (if (macro-segmented-program-empty? state)
    false
    (macro-decl-module-import-placeholder?
      (macro-segmented-program-current-decl state))))

(define (macro-segmented-bind-import-alias-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]) : ResultTcEnv
  (let
    [state : TcJobState (tc-context-job-state ctx)]
    [cur-env : TcTypeEnv env]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [message : String ""]
    [ok : bool true]
    [iter : MacroSegmentedProgramIter (macro-segmented-program-iter state)]
    (while (and ok iter.has-current)
      (match (macro-segmented-program-iter-current-decl (& iter))
        [(Module _)
          (set!
            cur-module-id
            (ast.ast-decl-list-module-id-at
              (& iter.decls)
              iter.index
              cbi.compiler-builtin-id-fix-empty))]
        [(or (Import _ _) (IncludeStr _ _) (IncludeStrComptime _ _)
             (IncludeStrLzss _ _) (IncludeBin _ _) (Test _ _ _ _))
          unit]
        [_
          (if (= cur-module-id target-module)
            (match (tc-bind-import-alias-decl-in-module
              ctx
              cur-env
              alias
              importer-module
              import-unqualified
              cur-module-id
              (macro-segmented-program-iter-current-decl (& iter)))
              [(Ok next-env) (set! cur-env next-env)]
              [(Err step-message)
                (set! message step-message)
                (set! ok false)])
            unit)])
      (macro-segmented-program-iter-advance! (&mut iter)))
    (if (string.eq message "")
      (Ok cur-env)
      (Err message))))

(define (macro-segmented-imported-module-identity-ids?
  [session : cis.InternStructuralSessionHandle]
  [state : TcJobState]
  [current-module-id : i64]
  [target-id : i64]) : bool
  (let
    [iter : MacroSegmentedProgramIter (macro-segmented-program-iter state)]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [found : bool false]
    (while (and (not found) iter.has-current)
      (let
        [decls : ast.AstDeclList iter.decls]
        [index : i64 iter.index]
        ;; The iterator owns these row descriptors through this immediate
        ;; tag/payload probe. Advance only after the borrow ends; no row
        ;; survives segment growth, pool rotation, or reset.
        (match (ast.ast-decl-list-ref-borrowed (& decls) index)
          [(Module _)
            (set!
              module-id
              (ast.ast-decl-list-module-id-at
                (& decls)
                index
                cbi.compiler-builtin-id-fix-empty))]
          [(Import _ (Spec _ _ expected _ _))
            (if (= module-id current-module-id)
              (match expected
                [(Some target)
                  (if (tc-module-identity-id-eq? session target target-id)
                    (set! found true)
                    unit)]
                [(No) unit])
              unit)]
          [_ unit])
        (macro-segmented-program-iter-advance! (&mut iter))))
    found))

;; Extend the prefix's event positions over the rows emitted since the last
;; sync, and return the updated view. Logical position `p` is reversed index
;; `len - 1 - p`.
(define (macro-segmented-prefix-events-sync! [state : TcJobState]) : MacroSegmentedProgramViewData
  (let
    [address : i64 (tc-job-state-macro-program-view-address state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data address)]
    [prefix : ast.AstDeclList data.prefix-rev]
    [len : i64 (ast.ast-decl-list-len (& prefix))]
    (if (= data.prefix-scanned len)
      data
      (in-arena
        (arena.Arena data.storage)
        (let
          [restart? : bool (< len data.prefix-scanned)]
          [events : (__tl_dyn-array i64) data.prefix-events]
          [count : i64
            (if restart?
              0
              data.prefix-event-count)]
          [position : i64
            (if restart?
              0
              data.prefix-scanned)]
          (while (< position len)
            (when
              (macro-decl-list-event-at? (& prefix) (- (- len 1) position))
              (if (< count (array-length events))
                unit
                (let
                  [grown : (__tl_dyn-array i64)
                    (__tl_make-array
                      i64
                      (if (< count 8)
                        16
                        (* count 2)))]
                  [index : i64 0]
                  (while (< index count)
                    (set! (array-ref grown index) (array-ref events index))
                    (set! index (+ index 1)))
                  (set! events grown)))
              (set! (array-ref events count) position)
              (set! count (+ count 1)))
            (set! position (+ position 1)))
          (set! data.prefix-events events)
          (set! data.prefix-event-count count)
          (set! data.prefix-scanned len)
          (macro-segmented-program-view-data-set!
            address
            (tc-global-shared-view data))
          data)))))

;; The first index of the ascending `events` whose position is at least `bound`.
(define (macro-events-lower-bound
  [events : (& events (__tl_dyn-array i64))]
  [bound : i64]) : i64
  (let
    [low : i64 0]
    [high : i64 (array-length events)]
    (while (< low high)
      (let
        [middle : i64 (/ (+ low high) 2)]
        (if (< (array-ref events middle) bound)
          (set! low (+ middle 1))
          (set! high middle))))
    low))

;; One pass of a module's local environment build over the segmented program,
;; in program order: the rows of module `interest` are added to the environment
;; the pass threads through (`add?`) or noted as root shadows. Every row a
;; module marker can hide in is an event, so the walk reads the event rows and
;; the rows of `interest`'s regions only.
(defstruct MacroSegmentedModuleWalk
  (interest i64)
  (add? bool)
  (module i64)
  (ok bool)
  (message String))

(define (macro-segmented-module-walk-row!
  [ctx : TcContext]
  [walk : (&mut walk MacroSegmentedModuleWalk)]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [env : TcTypeEnv]
  [decls : (& decls ast.AstDeclList)]
  [index : i64]) : TcTypeEnv
  (match (ast.ast-decl-list-ref-borrowed decls index)
    [(Module _)
      (set!
        walk.module
        (ast.ast-decl-list-module-id-at
          decls
          index
          cbi.compiler-builtin-id-fix-empty))
      env]
    [_
      (cond
        [(or (not walk.ok) (not (= walk.module walk.interest))) env]
        [walk.add?
          (match (tc-module-local-env-add-decl
            ctx
            env
            seen
            (ast.ast-decl-list-ref (deref decls) index))
            [(Ok next-env) next-env]
            [(Err message)
              (set! walk.message message)
              (set! walk.ok false)
              env])]
        [else
          (tc-module-local-root-shadow-decl-note!
            (tc-context-structural-session ctx)
            seen
            (tc-global-array-element-shared-view
              decls.slots
              (+ decls.offset index)))
          env])]))

(define (macro-segmented-module-walk!
  [ctx : TcContext]
  [data : (& data MacroSegmentedProgramViewData)]
  [walk : (&mut walk MacroSegmentedModuleWalk)]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [env : TcTypeEnv]) : TcTypeEnv
  (let
    [cur-env : TcTypeEnv env]
    [prefix : ast.AstDeclList data.prefix-rev]
    [len : i64 (ast.ast-decl-list-len (& prefix))]
    [position : i64 0]
    [event : i64 0]
    [node-address : i64 data.head]
    [start : i64 data.cursor]
    ;; The emitted prefix: logical positions, stored reversed. The rows up
    ;; to each event belong to the module the walk is in; the event row may
    ;; change it.
    (while (<= event data.prefix-event-count)
      (let
        [at : i64
          (if (< event data.prefix-event-count)
            (array-ref data.prefix-events event)
            len)]
        (if (= walk.module walk.interest)
          (while (< position at)
            (set!
              cur-env
              (macro-segmented-module-walk-row!
                ctx
                walk
                seen
                cur-env
                (& prefix)
                (- (- len 1) position)))
            (set! position (+ position 1)))
          unit)
        (if (< event data.prefix-event-count)
          (set!
            cur-env
            (macro-segmented-module-walk-row!
              ctx
              walk
              seen
              cur-env
              (& prefix)
              (- (- len 1) at)))
          unit)
        (set! position (+ at 1))
        (set! event (+ event 1))))
    ;; The unprocessed segments: slot positions.
    (while (> node-address 0)
      (let
        [node : MacroProgramSegmentNodeData
          (macro-program-segment-node-data node-address)]
        [decls : ast.AstDeclList node.decls]
        [events : (__tl_dyn-array i64) node.events]
        [event-count : i64 (array-length events)]
        [end : i64 (+ decls.offset (ast.ast-decl-list-len (& decls)))]
        [slot : i64 (+ decls.offset start)]
        [next-event : i64
          (macro-events-lower-bound (& events) (+ decls.offset start))]
        [more? : bool true]
        (while more?
          (let
            [at : i64
              (if (and
                (< next-event event-count)
                (< (array-ref events next-event) end))
                (array-ref events next-event)
                end)]
            (if (= walk.module walk.interest)
              (while (< slot at)
                (set!
                  cur-env
                  (macro-segmented-module-walk-row!
                    ctx
                    walk
                    seen
                    cur-env
                    (& decls)
                    (- slot decls.offset)))
                (set! slot (+ slot 1)))
              unit)
            (if (< at end)
              (begin
                (set!
                  cur-env
                  (macro-segmented-module-walk-row!
                    ctx
                    walk
                    seen
                    cur-env
                    (& decls)
                    (- at decls.offset)))
                (set! slot (+ at 1))
                (set! next-event (+ next-event 1)))
              (set! more? false))))
        (set! node-address node.next)
        (set! start 0)))
    cur-env))

(define (macro-segmented-module-local-env-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [target-module-id : i64]) : ResultTcEnv
  (let
    [data : MacroSegmentedProgramViewData
      (macro-segmented-prefix-events-sync! (tc-context-job-state ctx))]
    ;; This map grows only to root plus target-module names. A whole-program
    ;; reserve retained hundreds of MiB across cached module environments.
    [seen : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 64)]
    ;; Root declarations shadow imported module-local aliases regardless of
    ;; segment boundaries, matching tc-module-local-env-list's index pass.
    [shadows : MacroSegmentedModuleWalk
      (MacroSegmentedModuleWalk
        cbi.compiler-builtin-id-fix-empty
        false
        cbi.compiler-builtin-id-fix-empty
        true
        "")]
    [_shadows : TcTypeEnv
      (macro-segmented-module-walk! ctx (& data) (&mut shadows) (&mut seen) env)]
    [adds : MacroSegmentedModuleWalk
      (MacroSegmentedModuleWalk
        target-module-id
        true
        cbi.compiler-builtin-id-fix-empty
        true
        "")]
    [local-env : TcTypeEnv
      (macro-segmented-module-walk! ctx (& data) (&mut adds) (&mut seen) env)]
    (if adds.ok
      (Ok local-env)
      (Err adds.message))))

(define (macro-expand-scratch-program
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : ast.AstProgram
  (if (tc-macro-walk-field state macro-expand-scratch-enabled)
    (in-arena
      (arena.Arena (macro-expand-scratch-arena-get state))
      (ast.ast-program decls))
    (ast.ast-program decls)))

(define (macro-paths-for-decls
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [path : String]) : ast.AstDeclPathList
  (let
    [out : ast.AstDeclPathList
      (ast.ast-decl-path-list-with-capacity (ast.ast-decl-list-len (& decls)))]
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    (while (< index count)
      (ast.ast-decl-path-list-push-with-owner-and-provenance-id
        (&mut out)
        (tc-global-shared-view path)
        (if (>= (tc-macro-walk-field state macro-active-decl-owner-id) 0)
          (tc-macro-walk-field state macro-active-decl-owner-id)
          cbi.compiler-builtin-id-fix-empty)
        (if (>= (tc-macro-walk-field state macro-active-decl-provenance-id) 0)
          (tc-macro-walk-field state macro-active-decl-provenance-id)
          cbi.compiler-builtin-id-fix-empty))
      (set! index (+ index 1)))
    out))

(define (macro-decls-final-module-id
  [decls : ast.AstDeclList]
  [module-id : i64]) : i64
  (match (ast.ast-decl-list-step decls)
    [(Nil) module-id]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(Module next-module) (macro-decls-final-module-id rest next-module)]
          [(ModuleBody next-module body-box)
            (macro-decls-final-module-id
              (ast.ast-decl-list-box-shared-view body-box)
              next-module)]
          [_ (macro-decls-final-module-id rest module-id)]))]))

(define (macro-decls-module-count [decls : ast.AstDeclList]) : i64
  (match (ast.ast-decl-list-step decls)
    [(Nil) 0]
    [(Cons decl rest)
      (let
        [rest-count : i64 (macro-decls-module-count rest)]
        (match decl
          [(Module _) (+ rest-count 1)]
          [(ModuleBody _ body-box)
            (+
              rest-count
              (+
                1
                (macro-decls-module-count
                  (ast.ast-decl-list-box-shared-view body-box))))]
          [_ rest-count]))]))

(define (macro-identity-key-join [head : String] [tail : String]) : String
  (if (> (string.string-length tail) 0)
    (str_cat.str-cat head ";" tail)
    head))

(define (macro-identity-key-string-expr
  [expr : ast.AstExpr]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]) : spec.ResultGenKey
  (match (ctfe_support.compiler-ctfe-eval (tc-global-shared-view expr) env fuel)
    [(Ok value next-fuel)
      (match value
        [(String text _) (Ok (spec.spec-string-key text) next-fuel)]
        [(Name text _) (Ok (spec.spec-string-key text) next-fuel)]
        [(I64 n) (Ok (str_cat.str-cat "i64:" (string.int->string n)) next-fuel)]
        [_
          (Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                expr
                "typecheck: Module macro identity key expression must evaluate to String or i64")))])]
    [(Err diag) (Err diag)]))

(define (macro-identity-key-string-exprs-at
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]) : spec.ResultGenKey
  (if (>= index exprs.len)
    (Ok "" fuel)
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-string-expr head-expr env fuel)
        [(Ok head-key head-fuel)
          (match (macro-identity-key-string-exprs-at
            expr-bases
            exprs
            (+ index 1)
            env
            head-fuel)
            [(Ok tail tail-fuel)
              (Ok (macro-identity-key-join head-key tail) tail-fuel)]
            [(Err diag) (Err diag)])]
        [(Err diag) (Err diag)]))))

;; A cons cell's key is `cons:<n>:`, its head's key (n bytes) and then its
;; tail's key. The head's length prefix makes the encoding injective without
;; escaping keys that are already encoded, so a key stays linear in the syntax
;; it encodes (#8675). Escaping every sub-key again grew the key about four times
;; per nesting level, which overflowed the stack for moderately nested
;; declaration-macro arguments.
(define (macro-identity-key-sexpr-into
  [session : cis.InternStructuralSessionHandle]
  [sexpr : reader.SpannedSexpr]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match (reader.spanned-sexpr-view sexpr)
    [(Int _ text _)
      (text_buf.append (text_buf.append buf "int:") (spec.spec-string-key text))]
    [(Sym name _)
      (text_buf.append
        (text_buf.append buf "sym:")
        (spec.spec-string-key
          (macro-output-symbol-text-id
            session
            (ci.intern-syntax-id-value name)
            "identity-key")))]
    [(List list-items _)
      (match list-items
        [(slice) (text_buf.append buf "nil")]
        [(slice head & _)
          (let
            [tail (reader.spanned-sexpr-drop sexpr 1)]
            [head-key : String (macro-identity-key-sexpr session head)]
            (macro-identity-key-sexpr-into
              session
              tail
              (text_buf.append
                (text_buf.append
                  (text_buf.append-int
                    (text_buf.append buf "cons:")
                    (string.string-length head-key))
                  ":")
                head-key)))])]
    [(Str string-id _)
      (text_buf.append
        (text_buf.append buf "str:")
        (spec.spec-string-key (ci.intern-id-str string-id)))]
    [(Char c _)
      (text_buf.append-int (text_buf.append buf "char:") (cast c : i64))]
    [(Float text _)
      (text_buf.append
        (text_buf.append buf "float:")
        (spec.spec-string-key text))]
    [(BracketList _ _)
      (let
        [items (reader.spanned-sexpr-drop sexpr 0)]
        (macro-identity-key-sexpr-into
          session
          items
          (text_buf.append buf "bracket:")))]))

(define (macro-identity-key-sexpr
  [session : cis.InternStructuralSessionHandle]
  [sexpr : reader.SpannedSexpr]) : String
  (text_buf.render
    (macro-identity-key-sexpr-into session sexpr (text_buf.empty))))

(define (macro-identity-key-syntax-expr
  [owner : (& owner MacroSexprOwner)]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [fuel : i64]) : spec.ResultGenKey
  (let
    [sexpr (try (macro-expr-to-spanned-sexpr owner expr origin))]
    (Ok
      (str_cat.str-cat
        "syntax:"
        (macro-identity-key-sexpr (macro-sexpr-session owner) sexpr))
      fuel)))

(define (macro-identity-syntax-param-type?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        ty)]
    (or
      (tc-type-eq (tc-global-shared-view resolved) (Expr))
      (tc-type-eq (tc-global-shared-view resolved) (ExprList))
      (tc-macro-expr-clause-type? (tc-global-shared-view resolved))
      (tc-macro-expr-clause-list-type? (tc-global-shared-view resolved))
      (tc-macro-expr-binding-clause-type? (tc-global-shared-view resolved))
      (tc-macro-expr-binding-clause-list-type? resolved))))

(define (macro-identity-key-param-expr
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]
  [expr : ast.AstExpr]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (if (macro-identity-syntax-param-type?
    ctx
    fallback-module
    fallback-module-id
    ty)
    (match (macro-identity-key-string-expr
      (tc-global-shared-view expr)
      env
      fuel)
      [(Ok key next-fuel) (Ok key next-fuel)]
      [(Err _)
        (let
          [sexpr-owner : MacroSexprOwner
            (macro-sexpr-owner
              (tc-context-expr-bases ctx)
              (tc-context-structural-session ctx))]
          (macro-identity-key-syntax-expr (& sexpr-owner) expr call-expr fuel))])
    (macro-identity-key-string-expr expr env fuel)))

(define (macro-identity-key-param-exprs-at
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [end : i64]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (if (>= index end)
    (Ok "" fuel)
    (let
      [head-expr : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-param-expr
        ctx
        (tc-global-shared-view fallback-module)
        fallback-module-id
        (tc-global-shared-view ty)
        head-expr
        env
        fuel
        (tc-global-shared-view call-expr))
        [(Ok head-key head-fuel)
          (match (macro-identity-key-param-exprs-at
            ctx
            fallback-module
            fallback-module-id
            ty
            exprs
            (+ index 1)
            end
            env
            head-fuel
            call-expr)
            [(Ok tail tail-fuel)
              (Ok (macro-identity-key-join head-key tail) tail-fuel)]
            [(Err diag) (Err diag)])]
        [(Err diag) (Err diag)]))))

(define (macro-identity-key-params
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (macro-identity-key-params-at
    ctx
    decls
    fallback-module
    fallback-module-id
    macro-name
    (& params)
    (& args)
    0
    0
    env
    fuel
    call-expr))

(define (macro-identity-key-fixed-param
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [param-name : i64]
  [ty : ast.AstType]
  [type-kinds : ast.AstMacroTypeKindList]
  [head-expr : ast.AstExpr]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (cond
    [(tc-macro-type-param-kind? (tc-global-shared-view ty))
      (let
        [resolved-ty
          (try
            (macro-type-arg-with-fallback
              ctx
              decls
              fallback-module
              fallback-module-id
              (tc-global-shared-view head-expr)))]
        [_
          (try
            (macro-validate-type-kind-constraint
              ctx
              macro-name
              param-name
              (tc-global-shared-view resolved-ty)
              (& type-kinds)
              head-expr))]
        (Ok
          (str_cat.str-cat "type_" (ctfe_support.ctfe-type-key resolved-ty))
          fuel))]
    [(tc-macro-module-param-kind? (tc-global-shared-view ty))
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        fallback-module-id
        head-expr)
        [(Ok module _)
          (Ok (str_cat.str-cat "module_" (spec.spec-string-key module)) fuel)]
        [(Err diag) (Err diag)])]
    [else
      (macro-identity-key-param-expr
        ctx
        fallback-module
        fallback-module-id
        ty
        head-expr
        env
        fuel
        call-expr)]))

(define (macro-identity-key-params-at
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]
  [fuel : i64]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (cond
    [(>= param-index (ast.ast-macro-param-list-len params))
      (if (>= arg-index args.len)
        (Ok "" fuel)
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              (tc-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0))
              "macro call has too many arguments"))))]
    [else
      (match (ast.ast-macro-param-list-get
        params
        param-index
        (ast.ast-macro-param-fallback))
        [(Param param-name ty variadic type-kinds)
          (if variadic
            (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
              (cond
                [(tc-macro-type-param-kind? (tc-global-shared-view ty))
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: type macro operand cannot be variadic")))]
                [(tc-macro-module-param-kind? (tc-global-shared-view ty))
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Module macro operand cannot be variadic")))]
                [(macro-identity-syntax-param-type?
                    ctx
                    (tc-global-shared-view fallback-module)
                    fallback-module-id
                    (tc-global-shared-view ty))
                  (macro-identity-key-param-exprs-at
                    ctx
                    fallback-module
                    fallback-module-id
                    ty
                    args
                    arg-index
                    args.len
                    env
                    fuel
                    call-expr)]
                [else
                  (macro-identity-key-string-exprs-at
                    (tc-context-expr-bases ctx)
                    args
                    arg-index
                    env
                    fuel)])
              (if (macro-param-expr-binding-clause?
                ctx
                (tc-global-shared-view fallback-module)
                fallback-module-id
                (tc-global-shared-view ty))
                (let
                  [clauses
                    (try
                      (macro-expr-binding-clause-prefix-from-args
                        (tc-context-expr-bases ctx)
                        args
                        arg-index))]
                  [next-arg-index : i64 (+ arg-index clauses.len)]
                  (match (macro-identity-key-param-exprs-at
                    ctx
                    (tc-global-shared-view fallback-module)
                    fallback-module-id
                    ty
                    args
                    arg-index
                    next-arg-index
                    env
                    fuel
                    (tc-global-shared-view call-expr))
                    [(Ok head-key head-fuel)
                      (match (macro-identity-key-params-at
                        ctx
                        decls
                        fallback-module
                        fallback-module-id
                        macro-name
                        params
                        args
                        (+ param-index 1)
                        next-arg-index
                        env
                        head-fuel
                        call-expr)
                        [(Ok tail tail-fuel)
                          (Ok (macro-identity-key-join head-key tail) tail-fuel)]
                        [(Err diag) (Err diag)])]
                    [(Err diag) (Err diag)]))
                (Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")))))
            (if (>= arg-index args.len)
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [head-expr : ast.AstExpr
                  (tc-context-expr-get
                    ctx
                    (ast.ast-expr-list-get args arg-index 0))]
                (match (macro-identity-key-fixed-param
                  ctx
                  (tc-global-shared-view decls)
                  (tc-global-shared-view fallback-module)
                  fallback-module-id
                  (tc-global-shared-view macro-name)
                  param-name
                  ty
                  type-kinds
                  head-expr
                  env
                  fuel
                  (tc-global-shared-view call-expr))
                  [(Ok head-key head-fuel)
                    (match (macro-identity-key-params-at
                      ctx
                      decls
                      fallback-module
                      fallback-module-id
                      macro-name
                      params
                      args
                      (+ param-index 1)
                      (+ arg-index 1)
                      env
                      head-fuel
                      call-expr)
                      [(Ok tail tail-fuel)
                        (Ok (macro-identity-key-join head-key tail) tail-fuel)]
                      [(Err diag) (Err diag)])]
                  [(Err diag) (Err diag)]))))])]))

(define (macro-module-identity
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [definition-module : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [call-expr : ast.AstExpr]) : spec.ResultGenKey
  (match (macro-identity-key-params
    ctx
    decls
    fallback-module
    fallback-module-id
    (tc-global-shared-view macro-name)
    params
    args
    env
    (ctfe_support.ctfe-fuel-limit)
    call-expr)
    [(Ok arg-key fuel)
      (Ok
        (str_cat.str-cat definition-module ":" macro-name "(" arg-key ")")
        fuel)]
    [(Err diag) (Err diag)]))

(define (macro-decls-generated-key [identity : String]) : String
  (str_cat.str-cat "decls:" identity))

(define (macro-generated-meta
  [generator : String]
  [item : String]
  [key : String]) : ast.AstGeneratedDeclMeta
  (Some generator item (ast.ast-expr-list-new) key))

(define (macro-import-placeholder-kind? [kind : ast.AstImportKind]) : bool
  (match kind
    [(or (Macro _ _) (MacroDecls _ _)) true]
    [_ false]))

(define (macro-decl-import-placeholder? [decl : ast.AstDecl]) : bool
  (match decl
    [(Import decl-meta (Spec kind _ _ _ _))
      (macro-import-placeholder-kind? kind)]
    [_ false]))

(define (macro-decl-module-import-placeholder? [decl : ast.AstDecl]) : bool
  (match decl
    [(Import decl-meta (Spec kind _ _ _ _))
      (match kind
        [(Macro _ _) true]
        [_ false])]
    [_ false]))

(define (macro-expansion-wrap-expr-id
  [expr-id : i64]
  [path-id : i64]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [span : ast.AstSourceSpan]) : i64
  (ast.ast-expr-spanned
    (ast.ast-expr-macro-expansion
      expr-id
      (macro-expansion-provenance-id path-id origin-path-id)
      macro-name-id)
    span))

(define (macro-expansion-wrap-decl
  [decl : ast.AstDecl]
  [path-id : i64]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [span : ast.AstSourceSpan]) : ast.AstDecl
  (match (tc-global-shared-view decl)
    [(Import meta (Spec kind path expected alias _))
      ;; Generated declaration paths belong to the requesting expansion. Keep
      ;; the import span in that same source file, even for an imported macro.
      (Import meta (Spec kind path expected alias (box span)))]
    [(Def meta name maybe-ty expr-id)
      (Def
        meta
        name
        maybe-ty
        (macro-expansion-wrap-expr-id
          expr-id
          path-id
          origin-path-id
          macro-name-id
          span))]
    [(DefFn meta name params ret body-id fn-meta)
      (DefFn
        meta
        name
        params
        ret
        (macro-expansion-wrap-expr-id
          body-id
          path-id
          origin-path-id
          macro-name-id
          span)
        fn-meta)]
    [(DefMacro meta name params ret body-id)
      (DefMacro
        meta
        name
        params
        ret
        (macro-expansion-wrap-expr-id
          body-id
          path-id
          origin-path-id
          macro-name-id
          span))]
    [(Test name expr-id metadata test-span)
      (Test
        name
        (macro-expansion-wrap-expr-id
          expr-id
          path-id
          origin-path-id
          macro-name-id
          span)
        metadata
        test-span)]
    [(Unsafe inner)
      (Unsafe
        (box
          (macro-expansion-wrap-decl
            (ast.ast-decl-box-shared-view inner)
            path-id
            origin-path-id
            macro-name-id
            span)))]
    [_ decl]))

;; Module and Decls output share this wrapper. Imports have namespace effects
;; despite having no visible declaration name: their generated metadata makes
;; the fixed-point walker resolve and materialize them before typechecking.
(define (macro-wrap-generated-decl
  [decl : ast.AstDecl]
  [generator : String]
  [key : String]
  [path-id : i64]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [span : ast.AstSourceSpan]) : ast.AstDecl
  (let
    [framed : ast.AstDecl
      (macro-expansion-wrap-decl
        (tc-global-shared-view decl)
        path-id
        origin-path-id
        macro-name-id
        span)]
    (match (tc-global-shared-view framed)
      [(Module _) decl]
      [(Import decl-meta _)
        (ast.ast-decl-comptime-decl-with-meta
          (macro-generated-meta generator "import" key)
          framed)]
      [_
        (match (spec.gen-decl-visible-name (tc-global-shared-view framed))
          [(Some item)
            (ast.ast-decl-comptime-decl-with-meta
              (macro-generated-meta generator item key)
              framed)]
          [(None) framed])])))

(define (macro-wrap-generated-decls
  [decls : ast.AstDeclList]
  [generator : String]
  [key : String]
  [path : String]
  [origin-path-id : i64]
  [span : ast.AstSourceSpan]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [cursor : ast.AstDeclList decls]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [path-id : i64 (ci.intern path)]
    [macro-name-id : i64 (ci.intern (tc-global-shared-view generator))]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (ast.ast-decl-list-push
            (&mut out)
            (macro-wrap-generated-decl
              decl
              (tc-global-shared-view generator)
              (tc-global-shared-view key)
              path-id
              origin-path-id
              macro-name-id
              span))
          (set! cursor rest)]))
    out))

(define (macro-generated-context-import-kind
  [kind : ast.AstImportKind]
  [definition-module : i64]) : ast.AstImportKind
  (match kind
    [(Macro call-id context)
      (match context
        [(No) (Macro call-id (Some definition-module))]
        [_ kind])]
    [(MacroDecls call-id context)
      (match context
        [(No) (MacroDecls call-id (Some definition-module))]
        [_ kind])]
    [_ kind]))

(define (macro-generated-context-decl
  [decl : ast.AstDecl]
  [definition-module : i64]) : ast.AstDecl
  (match (tc-global-shared-view decl)
    [(Import decl-meta (Spec kind path target alias span))
      (Import
        decl-meta
        (Spec
          (macro-generated-context-import-kind kind definition-module)
          path
          target
          alias
          span))]
    [(Unsafe inner-box)
      (ast.ast-decl-unsafe
        (macro-generated-context-decl
          (ast.ast-decl-box-shared-view inner-box)
          definition-module))]
    [(ModuleBody name body-box)
      (ast.ast-decl-module-body-id
        name
        (macro-generated-context-decls
          (ast.ast-decl-list-box-shared-view body-box)
          definition-module))]
    [_ decl]))

(define (macro-generated-context-decls
  [decls : ast.AstDeclList]
  [definition-module : i64]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [cursor : ast.AstDeclList decls]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (ast.ast-decl-list-push
            (&mut out)
            (macro-generated-context-decl decl definition-module))
          (set! cursor rest)]))
    out))

(define (macro-decl-generated-key? [decl : ast.AstDecl] [key : String]) : bool
  (match (ast.ast-decl-generated-meta decl)
    [(Some _ _ _ meta-key) (string.eq meta-key key)]
    [(No) false]))

(define (macro-decl-import? [decl : ast.AstDecl]) : bool
  (match decl
    [(Import decl-meta _) true]
    [(Unsafe inner-box)
      (macro-decl-import? (ast.ast-decl-box-shared-view inner-box))]
    [_ false]))

(define (macro-decls-contain-generated-key?
  [decls : ast.AstDeclList]
  [key : String]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (macro-decl-generated-key? decl (tc-global-shared-view key))
        (macro-decls-contain-generated-key? rest key))]))

(define (macro-decls-filter-generated-key
  [decls : ast.AstDeclList]
  [key : String]) : ast.AstDeclList
  (let
    [cursor : ast.AstDeclList decls]
    [out-rev : ast.AstDeclList (ast.ast-decl-list-new)]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (if (and
            (macro-decl-generated-key?
              (tc-global-shared-view decl)
              (tc-global-shared-view key))
            (not (macro-decl-import? (tc-global-shared-view decl))))
            (set! out-rev (ast.ast-decl-list-prepend-builder decl out-rev))
            unit)
          (set! cursor rest)]))
    (macro-decl-list-reverse out-rev)))

(define (macro-decl-list-contains-structural?
  [decls : ast.AstDeclList]
  [want : ast.AstDecl]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (spec.gen-decl-eq? decl (tc-global-shared-view want))
        (macro-decl-list-contains-structural? rest want))]))

(define (macro-decls-missing-generated-imports
  [generated-body : ast.AstDeclList]
  [existing-body : ast.AstDeclList]) : ast.AstDeclList
  (let
    [cursor : ast.AstDeclList generated-body]
    [out-rev : ast.AstDeclList (ast.ast-decl-list-new)]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (if (and
            (macro-decl-import? (tc-global-shared-view decl))
            (not
              (macro-decl-list-contains-structural?
                (tc-global-shared-view existing-body)
                (tc-global-shared-view decl))))
            (set! out-rev (ast.ast-decl-list-prepend-builder decl out-rev))
            unit)
          (set! cursor rest)]))
    (macro-decl-list-reverse out-rev)))

(define (macro-decls-missing-generated-visible
  [generated-body : ast.AstDeclList]
  [existing-body : ast.AstDeclList]) : ast.AstDeclList
  (let
    [cursor : ast.AstDeclList generated-body]
    [out-rev : ast.AstDeclList (ast.ast-decl-list-new)]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (match (macro-generated-visible-name (tc-global-shared-view decl))
            [(Some name)
              (match (macro-find-generated-visible-decl
                (tc-global-shared-view existing-body)
                name)
                [(Some _) unit]
                [(No)
                  (set!
                    out-rev
                    (ast.ast-decl-list-prepend-builder decl out-rev))])]
            [(None) unit])
          (set! cursor rest)]))
    (macro-decl-list-reverse out-rev)))

(define (macro-decls-missing-generated-body
  [generated-body : ast.AstDeclList]
  [existing-body : ast.AstDeclList]) : ast.AstDeclList
  (macro-decl-list-append
    (macro-decls-missing-generated-imports
      (tc-global-shared-view generated-body)
      (tc-global-shared-view existing-body))
    (macro-decls-missing-generated-visible generated-body existing-body)))

(define (macro-module-replay-marker-decls
  [target-module : String]
  [target-module-id : i64]
  [owner-module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [generated-body : ast.AstDeclList]
  [existing-body : ast.AstDeclList]) : ast.AstDeclList
  (let
    [marker-decls : ast.AstDeclList
      (macro-module-import-marker-decls
        target-module
        target-module-id
        alias
        span)]
    [missing-body : ast.AstDeclList
      (macro-decls-missing-generated-body generated-body existing-body)]
    (match (ast.ast-decl-list-step missing-body)
      [(Nil) marker-decls]
      [_
        (macro-decl-list-append
          (ast.ast-decl-list-prepend-builder
            (ast.ast-decl-module-id target-module-id)
            missing-body)
          (ast.ast-decl-list-prepend-builder
            (ast.ast-decl-module-id owner-module-id)
            marker-decls))])))

(define (macro-find-generated-identity-module-in
  [decls : ast.AstDeclList]
  [identity : String]
  [module-id : i64]) : TcMaybeNameId
  (match (ast.ast-decl-list-step decls)
    [(Nil) (No)]
    [(Cons decl rest-box)
      (match (tc-global-shared-view decl)
        [(Module next-module)
          (macro-find-generated-identity-module-in
            rest-box
            identity
            next-module)]
        [_
          (if (and
            (not (= module-id cbi.compiler-builtin-id-fix-empty))
            (macro-decl-generated-key? decl (tc-global-shared-view identity)))
            (Some module-id)
            (macro-find-generated-identity-module-in
              rest-box
              identity
              module-id))])]))

(define (macro-find-generated-identity-module
  [decls : ast.AstDeclList]
  [identity : String]) : TcMaybeNameId
  (macro-find-generated-identity-module-in
    decls
    identity
    cbi.compiler-builtin-id-fix-empty))

(defenum MacroMaybeAstDecl
  (No)
  (Some ast.AstDecl))

(defenum MacroGeneratedTargetReplayScan
  (NoRelevant)
  (AllMatched)
  (MissingOnly)
  (Incompatible))

(defenum MacroGeneratedTargetReplay
  (NoReplay)
  (ReplayCompatible)
  (ReplayAppendMissing)
  (ReplayIncompatible))

;; Content-addressed module memo (plan P1). Program-global, spanning every file
;; and module: a generated module is expanded + materialized exactly once per
;; (generator-id, canonical-type-args) — the `identity` string produced by
;; macro-module-identity, whose type-args are already canonicalized via type-key.
;; The key maps to the single canonical target module name; every later import of
;; the same identity (in any file, in any pass) resolves to that module and emits
;; only an alias/marker import. The memo persists across the whole expansion run
;; (it is only reset at the per-program macro-expand entry and self-clears when the
;; intern generation changes), which is what makes the identity shortcut
;; authoritative. A memoized module is never re-expanded, so there is nothing
;; to replay or compare.
(defenum MacroGeneratedCatalogClosure
  (Full))

;; First-class immutable catalog owner. `catalog` is the complete wrapped body
;; without its module header; `summary` is the currently materialized surface.
;; The explicit closure field is the handoff point for #4831's later subset.
(defenum MacroGeneratedModuleCatalogEntry
  (Empty)
  (Catalog
    i64
    ast.AstDeclList
    String
    String
    ast.AstDeclList
    MacroGeneratedCatalogClosure))

(defstruct TcMacroGeneratedModuleStateData
  (capacity i64)
  (keys (__tl_dyn-array i64))
  (catalog-entries (__tl_dyn-array MacroGeneratedModuleCatalogEntry))
  (count i64)
  (owner-table-id i64)
  (owner-reset-generation i64)
  (ready bool))

(define (tc-macro-generated-module-state-new) : TcMacroGeneratedModuleStateData
  (TcMacroGeneratedModuleStateData
    4096
    (__tl_make-array i64 0)
    (__tl_make-array MacroGeneratedModuleCatalogEntry 0)
    0
    -1
    -1
    false))

(define (tc-macro-generated-module-state-address-initialize
  [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroGeneratedModuleStateData
    tc-macro-state-slot-generated-module
    (tc-macro-generated-module-state-new)))

(define (tc-macro-generated-module-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    4
    tc-macro-generated-module-state-address-initialize))

(define (tc-macro-generated-module-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroGeneratedModuleStateData)
  (tc-state-cell-ptr
    (tc-macro-generated-module-state-address state)
    TcMacroGeneratedModuleStateData))

(define (tc-macro-generated-module-state-view [state : TcMacroState]) : (Ptr
    TcMacroGeneratedModuleStateData)
  (tc-state-cell-view
    (tc-macro-generated-module-state-address state)
    TcMacroGeneratedModuleStateData))

(define (tc-macro-generated-module-state-data [state : TcMacroState]) : TcMacroGeneratedModuleStateData
  (tc-state-cell-read
    (tc-macro-generated-module-state-address state)
    TcMacroGeneratedModuleStateData))

(define (macro-generated-module-memo-reset! [state : TcMacroState]) : unit
  (unsafe
    (set! (deref (tc-macro-generated-module-state-ptr state)).ready false)))

(define (macro-generated-module-memo-ensure! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [memo : (MutPtr TcMacroGeneratedModuleStateData)
      (tc-macro-generated-module-state-ptr state)]
    (unsafe
      (if (and
        (deref memo).ready
        (= (deref memo).owner-table-id table-id)
        (= (deref memo).owner-reset-generation reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (let
              [_allocate : unit
                (unless
                  (= (array-length (deref memo).keys) (deref memo).capacity)
                  (set!
                    (deref memo).keys
                    (__tl_make-array i64 (deref memo).capacity))
                  (set!
                    (deref memo).catalog-entries
                    (__tl_make-array
                      MacroGeneratedModuleCatalogEntry
                      (deref memo).capacity)))]
              [i : i64 0]
              (while (< i (deref memo).capacity)
                (set! (array-ref (deref memo).keys i) 0)
                (set!
                  (array-ref (deref memo).catalog-entries i)
                  (MacroGeneratedModuleCatalogEntry.Empty))
                (set! i (+ i 1)))
              (set! (deref memo).count 0)
              (set! (deref memo).owner-table-id table-id)
              (set! (deref memo).owner-reset-generation reset-generation)
              (set! (deref memo).ready true))))))))

(define (macro-generated-module-memo-bucket
  [state : TcMacroState]
  [identity-id : i64]) : i64
  (bit-and
    (* identity-id 2654435761)
    (-
      (unsafe
        (deref (tc-macro-generated-module-state-view state)).capacity)
      1)))

(define (macro-generated-identity-id [state : TcMacroState] [identity : String]) : i64
  (tc-macro-identity-intern-for-state state identity))

;; Store the first canonical catalog for an identity. Re-storing an equal
;; identity preserves its immutable catalog, provenance, validation, and closure
;; state while refreshing only the current materialized summary. The shortcut
;; normally makes the insertion path run once per identity for the whole program.
(define (macro-generated-module-memo-put!
  [state : TcMacroState]
  [identity : String]
  [target-id : i64]
  [summary : ast.AstDeclList]
  [catalog : ast.AstDeclList]
  [generator : String]
  [import-path : String]) : unit
  (let
    [identity-id : i64 (macro-generated-identity-id state identity)]
    ;; R3-P2b: the stored lists and provenance strings are built from whatever
    ;; arena is current, which under a declaration generation is that
    ;; declaration's. Note the key so the copy-out re-persists this entry into
    ;; the pool's base arena before the generation dies.
    [_escape : unit
      (macro-decl-generation-escape-note! state 1 (+ identity-id 1))]
    [_ensure : unit (macro-generated-module-memo-ensure! state)]
    [memo : (MutPtr TcMacroGeneratedModuleStateData)
      (tc-macro-generated-module-state-ptr state)]
    (unsafe
      (if (>= (* (deref memo).count 2) (deref memo).capacity)
        unit
        (let
          [cursor : i64 (macro-generated-module-memo-bucket state identity-id)]
          [key : i64 (+ identity-id 1)]
          [steps : i64 0]
          [done : bool false]
          (while (if done
            false
            (< steps (deref memo).capacity))
            (let
              [slot : i64 (array-ref (deref memo).keys cursor)]
              (if (= slot 0)
                (begin
                  (set! (array-ref (deref memo).keys cursor) key)
                  (set!
                    (array-ref (deref memo).catalog-entries cursor)
                    (Catalog
                      target-id
                      (tc-global-shared-view catalog)
                      (tc-global-shared-view generator)
                      (tc-global-shared-view import-path)
                      (tc-global-shared-view summary)
                      (Full)))
                  (set! (deref memo).count (+ (deref memo).count 1))
                  (set! done true))
                (if (= slot key)
                  (begin
                    ;; A same-identity catalog is immutable. Syntax-sensitive
                    ;; calls bypass the shortcut and retain the existing
                    ;; incompatible-output diagnostic instead of replacing it.
                    (match (tc-global-array-element-shared-view
                      (deref memo).catalog-entries
                      cursor)
                      [(Catalog
                          entry-target
                          entry-catalog
                          entry-generator
                          entry-path
                          _
                          closure)
                        (set!
                          (array-ref (deref memo).catalog-entries cursor)
                          (Catalog
                            entry-target
                            entry-catalog
                            entry-generator
                            entry-path
                            (tc-global-shared-view summary)
                            closure))]
                      [(Empty) unit])
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and (+ cursor 1) (- (deref memo).capacity 1)))
                    (set! steps (+ steps 1))))))))))))

;; Retrieve the export-summary (materialized module decl list) recorded for an
;; identity, or the empty list when the identity is not (yet) memoized. Used by
;; env-extend-with-module to fold an already-materialized module into the live
;; top-env without a whole-program rebuild (plan P2).
(define (macro-generated-module-memo-get-summary
  [state : TcMacroState]
  [identity : String]) : ast.AstDeclList
  (let
    [identity-id : i64 (macro-generated-identity-id state identity)]
    [_ensure : unit (macro-generated-module-memo-ensure! state)]
    [memo : (Ptr TcMacroGeneratedModuleStateData)
      (tc-macro-generated-module-state-view state)]
    [cursor : i64 (macro-generated-module-memo-bucket state identity-id)]
    [key : i64 (+ identity-id 1)]
    [steps : i64 0]
    [out : ast.AstDeclList (ast.ast-decl-list-new)]
    [done : bool false]
    (unsafe
      (while (if done
        false
        (< steps (deref memo).capacity))
        (let
          [slot : i64 (array-ref (deref memo).keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot key)
              (begin
                (match (tc-global-array-element-shared-view
                  (deref memo).catalog-entries
                  cursor)
                  [(Catalog _ _ _ _ summary _) (set! out summary)]
                  [(Empty) unit])
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) (- (deref memo).capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

;; Retrieve the immutable full catalog for a canonical identity. It is separate
;; from the materialized summary so later demand selection can reuse parsed
;; declarations without re-running CTFE or reconstructing them from a program.
(define (macro-generated-module-memo-get-catalog
  [state : TcMacroState]
  [identity : String]) : MacroGeneratedModuleCatalogEntry
  (let
    [identity-id : i64 (macro-generated-identity-id state identity)]
    [_ensure : unit (macro-generated-module-memo-ensure! state)]
    [memo : (Ptr TcMacroGeneratedModuleStateData)
      (tc-macro-generated-module-state-view state)]
    [cursor : i64 (macro-generated-module-memo-bucket state identity-id)]
    [key : i64 (+ identity-id 1)]
    [steps : i64 0]
    [out : MacroGeneratedModuleCatalogEntry (Empty)]
    [done : bool false]
    (unsafe
      (while (if done
        false
        (< steps (deref memo).capacity))
        (let
          [slot : i64 (array-ref (deref memo).keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot key)
              (begin
                (set!
                  out
                  (tc-global-array-element-shared-view
                    (deref memo).catalog-entries
                    cursor))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) (- (deref memo).capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(defenum MacroMaybeSpliceDecls
  (No)
  (Some ast.AstDeclList))

;; Decls-macro splice memo. A Decls-position macro call splices its generated
;; declarations inline, and the demand-driven walk rebuilds the whole-program
;; symbols right after every splice -- so a second call with the same generated
;; identity would put two copies of every generated item in front of the
;; symbols builder before gen-normalize's registry dedup ever runs (the retired
;; fixed-point loop normalized between passes, so its symbols never saw the
;; transient duplicate). Memoize the first expansion per identity: a repeat
;; splice with a structurally identical payload contributes nothing (and skips
;; the context rebuild entirely); an incompatible payload errors exactly like
;; gen-register-generated-decl. Same lifecycle as the module memo: reset per
;; program, self-clears on intern-generation change.
(defstruct TcMacroGeneratedDeclsStateData
  (capacity i64)
  (keys (__tl_dyn-array i64))
  (decls (__tl_dyn-array ast.AstDeclList))
  (count i64)
  (owner-table-id i64)
  (owner-reset-generation i64)
  (ready bool))

(define (tc-macro-generated-decls-state-new) : TcMacroGeneratedDeclsStateData
  (TcMacroGeneratedDeclsStateData
    1024
    (__tl_make-array i64 0)
    (__tl_make-array ast.AstDeclList 0)
    0
    -1
    -1
    false))

(define (tc-macro-generated-decls-state-address-initialize
  [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroGeneratedDeclsStateData
    tc-macro-state-slot-generated-decls
    (tc-macro-generated-decls-state-new)))

(define (tc-macro-generated-decls-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    5
    tc-macro-generated-decls-state-address-initialize))

(define (tc-macro-generated-decls-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroGeneratedDeclsStateData)
  (tc-state-cell-ptr
    (tc-macro-generated-decls-state-address state)
    TcMacroGeneratedDeclsStateData))

(define (tc-macro-generated-decls-state-view [state : TcMacroState]) : (Ptr
    TcMacroGeneratedDeclsStateData)
  (tc-state-cell-view
    (tc-macro-generated-decls-state-address state)
    TcMacroGeneratedDeclsStateData))

(define (tc-macro-generated-decls-state-data [state : TcMacroState]) : TcMacroGeneratedDeclsStateData
  (tc-state-cell-read
    (tc-macro-generated-decls-state-address state)
    TcMacroGeneratedDeclsStateData))

(define (macro-generated-decls-memo-reset! [state : TcMacroState]) : unit
  (unsafe
    (set! (deref (tc-macro-generated-decls-state-ptr state)).ready false)))

(define (macro-generated-decls-memo-ensure! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [memo : (MutPtr TcMacroGeneratedDeclsStateData)
      (tc-macro-generated-decls-state-ptr state)]
    (unsafe
      (if (and
        (deref memo).ready
        (= (deref memo).owner-table-id table-id)
        (= (deref memo).owner-reset-generation reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (let
              [_allocate : unit
                (unless
                  (= (array-length (deref memo).keys) (deref memo).capacity)
                  (set!
                    (deref memo).keys
                    (__tl_make-array i64 (deref memo).capacity))
                  (set!
                    (deref memo).decls
                    (__tl_make-array ast.AstDeclList (deref memo).capacity)))]
              [i : i64 0]
              ;; Re-arming clears only the keys. Every read of `decls` needs a
              ;; matching key and `put!` replaces the element, so a previous
              ;; generation's lists are never read; refilling them would leave
              ;; `capacity` dead lists in the owner arena on every re-arm.
              (while (< i (deref memo).capacity)
                (set! (array-ref (deref memo).keys i) 0)
                (set! i (+ i 1)))
              (set! (deref memo).count 0)
              (set! (deref memo).owner-table-id table-id)
              (set! (deref memo).owner-reset-generation reset-generation)
              (set! (deref memo).ready true))))))))

(define (macro-generated-decls-memo-bucket
  [state : TcMacroState]
  [identity-id : i64]) : i64
  (bit-and
    (* identity-id 2654435761)
    (-
      (unsafe
        (deref (tc-macro-generated-decls-state-view state)).capacity)
      1)))

(define (macro-generated-decls-memo-get
  [state : TcMacroState]
  [identity : String]) : MacroMaybeSpliceDecls
  (let
    [identity-id : i64 (macro-generated-identity-id state identity)]
    [_ensure : unit (macro-generated-decls-memo-ensure! state)]
    [memo : (Ptr TcMacroGeneratedDeclsStateData)
      (tc-macro-generated-decls-state-view state)]
    [cursor : i64 (macro-generated-decls-memo-bucket state identity-id)]
    [key : i64 (+ identity-id 1)]
    [steps : i64 0]
    [out : MacroMaybeSpliceDecls (No)]
    [done : bool false]
    (unsafe
      (while (if done
        false
        (< steps (deref memo).capacity))
        (let
          [slot : i64 (array-ref (deref memo).keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot key)
              (begin
                (set!
                  out
                  (Some
                    (tc-global-array-element-shared-view
                      (deref memo).decls
                      cursor)))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) (- (deref memo).capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-generated-decls-memo-put!
  [state : TcMacroState]
  [identity : String]
  [decls : ast.AstDeclList]) : unit
  (let
    [identity-id : i64 (macro-generated-identity-id state identity)]
    ;; R3-P2b: see macro-generated-module-memo-put!.
    [_escape : unit
      (macro-decl-generation-escape-note! state 2 (+ identity-id 1))]
    [_ensure : unit (macro-generated-decls-memo-ensure! state)]
    [memo : (MutPtr TcMacroGeneratedDeclsStateData)
      (tc-macro-generated-decls-state-ptr state)]
    (unsafe
      (if (>= (* (deref memo).count 2) (deref memo).capacity)
        unit
        (let
          [cursor : i64 (macro-generated-decls-memo-bucket state identity-id)]
          [key : i64 (+ identity-id 1)]
          [steps : i64 0]
          [done : bool false]
          (while (if done
            false
            (< steps (deref memo).capacity))
            (let
              [slot : i64 (array-ref (deref memo).keys cursor)]
              (if (= slot 0)
                (begin
                  (set! (array-ref (deref memo).keys cursor) key)
                  (set! (array-ref (deref memo).decls cursor) decls)
                  (set! (deref memo).count (+ (deref memo).count 1))
                  (set! done true))
                (if (= slot key)
                  (begin
                    (set! (array-ref (deref memo).decls cursor) decls)
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and (+ cursor 1) (- (deref memo).capacity 1)))
                    (set! steps (+ steps 1))))))))))))

;; R3-P2b: move one memoized declaration list out of the live declaration
;; generation and into the pool's base arena, in place, with the caller's id
;; maps. Sharing the maps with the survivor's copy-out is what keeps a node that
;; appears in both from being persisted (and re-allocated) twice.
;;
;; Sequencing mirrors `macro-decl-generation-copy-out`: resume from the pool's
;; stable root, allocate the program shell there, and then call the copy, which
;; restores the caller's arena itself.
(define (macro-decl-generation-persist-decls
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map-address : u64]
  [type-map-address : u64]) : ast.AstDeclList
  (let
    [_resume : unit
      (unsafe
        (arena.tl_arena_set (ast.ast-node-pool-context-base-arena pools)))]
    [program : ast.AstProgram (ast.ast-program decls)]
    (match (ast.ast-program-copy-append-above-with-maps
      pools
      pools
      (& program)
      shared-expr-base
      shared-type-base
      expr-map-address
      type-map-address
      true)
      [(AstProgramCompaction copied _)
        (match copied
          [(Program decls-box) (__tl-box-place decls-box)])])))

(define (macro-generated-module-memo-persist-entry!
  [state : TcMacroState]
  [key : i64]
  [pools : ast.AstNodePoolContext]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map-address : u64]
  [type-map-address : u64]) : unit
  (let
    [memo : TcMacroGeneratedModuleStateData
      (tc-macro-generated-module-state-data state)]
    [cursor : i64 (macro-generated-module-memo-bucket state (- key 1))]
    [steps : i64 0]
    [done : bool false]
    (while (if done
      false
      (< steps memo.capacity))
      (let
        [slot : i64 (array-ref memo.keys cursor)]
        (if (= slot 0)
          (set! done true)
          (if (= slot key)
            (begin
              (match (tc-global-array-element-shared-view
                memo.catalog-entries
                cursor)
                [(Catalog
                    target-id
                    catalog
                    generator
                    import-path
                    summary
                    closure)
                  (let
                    [owned-catalog : ast.AstDeclList
                      (macro-decl-generation-persist-decls
                        pools
                        catalog
                        shared-expr-base
                        shared-type-base
                        expr-map-address
                        type-map-address)]
                    [owned-summary : ast.AstDeclList
                      (macro-decl-generation-persist-decls
                        pools
                        summary
                        shared-expr-base
                        shared-type-base
                        expr-map-address
                        type-map-address)]
                    [_resume : unit
                      (unsafe
                        (arena.tl_arena_set
                          (ast.ast-node-pool-context-base-arena pools)))]
                    [owned-generator : String (string.copy (& generator))]
                    [owned-path : String (string.copy (& import-path))]
                    [_store : unit
                      (set!
                        (array-ref memo.catalog-entries cursor)
                        (Catalog
                          target-id
                          owned-catalog
                          owned-generator
                          owned-path
                          owned-summary
                          closure))]
                    unit)]
                [(Empty) unit])
              (set! done true))
            (begin
              (set! cursor (bit-and (+ cursor 1) (- memo.capacity 1)))
              (set! steps (+ steps 1)))))))
    unit))

(define (macro-generated-decls-memo-persist-entry!
  [state : TcMacroState]
  [key : i64]
  [pools : ast.AstNodePoolContext]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map-address : u64]
  [type-map-address : u64]) : unit
  (let
    [memo : TcMacroGeneratedDeclsStateData
      (tc-macro-generated-decls-state-data state)]
    [cursor : i64 (macro-generated-decls-memo-bucket state (- key 1))]
    [steps : i64 0]
    [done : bool false]
    (while (if done
      false
      (< steps memo.capacity))
      (let
        [slot : i64 (array-ref memo.keys cursor)]
        (if (= slot 0)
          (set! done true)
          (if (= slot key)
            (let
              [owned : ast.AstDeclList
                (macro-decl-generation-persist-decls
                  pools
                  (tc-global-array-element-shared-view memo.decls cursor)
                  shared-expr-base
                  shared-type-base
                  expr-map-address
                  type-map-address)]
              (set! (array-ref memo.decls cursor) owned)
              (set! done true))
            (begin
              (set! cursor (bit-and (+ cursor 1) (- memo.capacity 1)))
              (set! steps (+ steps 1)))))))
    unit))

;: Re-persist every memo entry this declaration's expansion recorded. Runs after
;: the survivor's copy-out, with the same maps, and leaves the pool's base arena
;: head published.
(define (macro-decl-generation-escapes-persist!
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map-address : u64]
  [type-map-address : u64]
  [splice? : bool]) : unit
  (let
    [index : i64 0]
    [count : i64 (tc-macro-walk-field state macro-decl-generation-escape-count)]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-decl-generation-escape-kinds)]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-decl-generation-escape-keys)]
    (while (< index count)
      (let
        [kind : i64 (array-ref kinds index)]
        [key : i64 (array-ref keys index)]
        (if (= kind 1)
          (macro-generated-module-memo-persist-entry!
            state
            key
            pools
            shared-expr-base
            shared-type-base
            expr-map-address
            type-map-address)
          (macro-generated-decls-memo-persist-entry!
            state
            key
            pools
            shared-expr-base
            shared-type-base
            expr-map-address
            type-map-address))
        (set! index (+ index 1))))
    ;; Fail-closed: a declaration that recorded more escapes than the list
    ;; holds has entries this pass could not reach, so its generation must not
    ;; be destroyed. Orphan it -- the next enter cuts a fresh arena and the
    ;; ring never sees this one again.
    (if (tc-macro-walk-field state macro-decl-generation-escape-overflow)
      (if splice?
        (tc-macro-walk-set! state macro-splice-generation-arena 0)
        (begin
          (tc-macro-walk-set! state macro-decl-generation-arena 0)
          (tc-macro-walk-set! state macro-decl-generation-batch-used 0)))
      unit)
    (macro-decl-generation-escape-reset! state)))

;; Structural equality between two Decls-macro splices, mirroring the
;; per-declaration gen-decl-eq? comparison gen-register-generated-decl applies
;; in gen-normalize: unwrap the generated-meta wrappers and compare templates.
(define (macro-generated-decls-splice-template [decl : ast.AstDecl]) : ast.AstDecl
  decl)

(define (macro-generated-decls-splice-equal?
  [a : ast.AstDeclList]
  [b : ast.AstDeclList]) : bool
  (if (not (= (ast.ast-decl-list-len (& a)) (ast.ast-decl-list-len (& b))))
    false
    (let
      [cursor-a : ast.AstDeclList a]
      [cursor-b : ast.AstDeclList b]
      [equal : bool true]
      [done : bool false]
      (while (not done)
        (match (ast.ast-decl-list-step cursor-a)
          [(Nil) (set! done true)]
          [(Cons decl-a rest-a)
            (match (ast.ast-decl-list-step cursor-b)
              [(Nil)
                (set! equal false)
                (set! done true)]
              [(Cons decl-b rest-b)
                (if (spec.gen-decl-eq?
                  (macro-generated-decls-splice-template decl-a)
                  (macro-generated-decls-splice-template decl-b))
                  (begin
                    (set! cursor-a rest-a)
                    (set! cursor-b rest-b))
                  (begin
                    (set! equal false)
                    (set! done true)))])]))
      equal)))

(define (macro-generated-decls-splice-first-item [decls : ast.AstDeclList]) : String
  (match (ast.ast-decl-list-step decls)
    [(Nil) ""]
    [(Cons decl _)
      (match (spec.gen-decl-visible-name
        (macro-generated-decls-splice-template decl))
        [(Some item) item]
        [(None) ""])]))

;; Resolve a Decls-macro splice against the memo: first expansion is recorded
;; and spliced; a structurally identical repeat contributes an empty splice; an
;; incompatible repeat errors with the same diagnostic gen-normalize's registry
;; would produce.
(define (macro-decls-splice-with-memo
  [expr-bases : i64]
  [state : TcMacroState]
  [identity : String]
  [wrapped : ast.AstDeclList]
  [decl-path : String]
  [call-expr : ast.AstExpr]) : ResultMacroDeclExpansion
  (match (macro-generated-decls-memo-get state (tc-global-shared-view identity))
    [(No)
      (macro-generated-decls-memo-put!
        state
        identity
        (tc-global-shared-view wrapped))
      (Ok
        (tc-global-shared-view wrapped)
        (macro-paths-for-decls state wrapped decl-path))]
    [(Some existing)
      (if (macro-generated-decls-splice-equal?
        existing
        (tc-global-shared-view wrapped))
        (Ok (ast.ast-decl-list-new) (ast.ast-decl-path-list-new))
        (Err
          (let
            [diag : cdiag.CompilerDiagnostic
              (spec.gen-incompatible-diag
                (macro-generated-decls-splice-first-item wrapped)
                (macro-decls-generated-key identity))]
            [located : cdiag.CompilerDiagnostic
              (tc-expr-diag
                expr-bases
                call-expr
                (cdiag.compiler-diagnostic-typecheck-error-text (& diag)))]
            (box
              (cdiag.compiler-diagnostic-with-primary-span
                (& diag)
                (cdiag.compiler-diagnostic-primary-span located))))))]))

(define (macro-decl-generated? [decl : ast.AstDecl]) : bool
  (match (ast.ast-decl-generated-meta decl)
    [(Some _ _ _ _) true]
    [(No) false]))

(define (macro-generated-visible-name [decl : ast.AstDecl]) : spec.SpecMaybeString
  (if (and
    (macro-decl-generated? (tc-global-shared-view decl))
    (not (macro-decl-import? (tc-global-shared-view decl))))
    (spec.gen-decl-visible-name decl)
    (None)))

(define (macro-find-generated-visible-decl
  [decls : ast.AstDeclList]
  [name : String]) : MacroMaybeAstDecl
  (match (ast.ast-decl-list-step decls)
    [(Nil) (No)]
    [(Cons decl rest-box)
      (match (macro-generated-visible-name (tc-global-shared-view decl))
        [(Some candidate)
          (if (string.eq candidate name)
            (Some decl)
            (macro-find-generated-visible-decl rest-box name))]
        [(None) (macro-find-generated-visible-decl rest-box name)])]))

(define (macro-generated-target-replay-scan-step
  [state : MacroGeneratedTargetReplayScan]
  [matched? : bool]
  [same? : bool]) : MacroGeneratedTargetReplayScan
  (if matched?
    (if same?
      (match state
        [(or (NoRelevant) (AllMatched)) (AllMatched)]
        [(or (MissingOnly) (Incompatible)) (Incompatible)])
      (Incompatible))
    (match state
      [(or (NoRelevant) (AllMatched) (MissingOnly)) (MissingOnly)]
      [(Incompatible) (Incompatible)])))

(define (macro-generated-target-replay-scan-in
  [existing-body : ast.AstDeclList]
  [generated-body : ast.AstDeclList]
  [state : MacroGeneratedTargetReplayScan]) : MacroGeneratedTargetReplayScan
  (match (ast.ast-decl-list-step generated-body)
    [(Nil) state]
    [(Cons decl rest-box)
      (match (macro-generated-visible-name (tc-global-shared-view decl))
        [(Some name)
          (match (macro-find-generated-visible-decl
            (tc-global-shared-view existing-body)
            name)
            [(Some existing-decl)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step
                  state
                  true
                  (spec.gen-decl-eq? existing-decl decl)))]
            [(No)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step state false false))])]
        [(None)
          (macro-generated-target-replay-scan-in existing-body rest-box state)])]))

(define (macro-generated-target-replay
  [existing-body : ast.AstDeclList]
  [generated-body : ast.AstDeclList]) : MacroGeneratedTargetReplay
  (match (macro-generated-target-replay-scan-in
    existing-body
    generated-body
    (NoRelevant))
    [(AllMatched) (ReplayCompatible)]
    [(MissingOnly) (ReplayAppendMissing)]
    [(Incompatible) (ReplayIncompatible)]
    [_ (NoReplay)]))

;; Index cursor rather than `ast-decl-list-step`: the scan only needs a tag per
;; declaration and a module id on the module arm, so the tag is read through a
;; borrow and the id is loaded straight out of the row.
(define (macro-module-exists?
  [decls : ast.AstDeclList]
  [target-module : String]) : bool
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (ast.ast-decl-list-ref-borrowed (& decls) index)
        [(Module _)
          (if (string.eq
            (tc-env-key-name-text
              (ast.ast-decl-list-module-id-at
                (& decls)
                index
                cbi.compiler-builtin-id-fix-empty))
            target-module)
            (set! found true)
            unit)]
        [_ unit])
      (set! index (+ index 1)))
    found))

;; Index cursor rather than `ast-decl-list-step`. Only the module arm reads a
;; payload from the row; the collected declarations are copied straight out of
;; the backing array into the builder, so the step result's 144 B and the
;; module-arm row copies are both gone.
(define (macro-collect-module-body-decls
  [decls : ast.AstDeclList]
  [target-module : String]
  [current-module : String]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [module : String current-module]
    [out-rev : ast.AstDeclList (ast.ast-decl-list-new)]
    (while (< index count)
      (match (ast.ast-decl-list-ref-borrowed (& decls) index)
        [(Module _)
          (set!
            module
            (tc-env-key-name-text
              (ast.ast-decl-list-module-id-at
                (& decls)
                index
                cbi.compiler-builtin-id-fix-empty)))]
        [_
          (if (string.eq module target-module)
            (set!
              out-rev
              (ast.ast-decl-list-prepend-builder
                (tc-global-array-element-shared-view
                  decl-slots
                  (+ decl-offset index))
                out-rev))
            unit)])
      (set! index (+ index 1)))
    (macro-decl-list-reverse out-rev)))

(define (macro-segmented-find-module-body-decls
  [state : TcJobState]
  [target-module : String]) : MacroMaybeDeclList
  (let
    [iter : MacroSegmentedProgramIter (macro-segmented-program-iter state)]
    [module : String ""]
    [found : bool false]
    [out-rev : ast.AstDeclList (ast.ast-decl-list-new)]
    (while iter.has-current
      (let
        [decls : ast.AstDeclList iter.decls]
        [index : i64 iter.index]
        ;; This pass is tag-only for almost every declaration. The iterator
        ;; owns the current row descriptor until the final in-place advance;
        ;; a full row is copied only when it is appended to `out-rev`.
        (match (ast.ast-decl-list-ref-borrowed (& decls) index)
          [(Module _)
            (set!
              module
              (tc-env-key-name-text
                (ast.ast-decl-list-module-id-at
                  (& decls)
                  index
                  cbi.compiler-builtin-id-fix-empty)))
            (if (string.eq module target-module)
              (set! found true)
              unit)]
          [_
            (if (string.eq module target-module)
              (set!
                out-rev
                (ast.ast-decl-list-prepend-builder
                  (tc-global-array-element-shared-view
                    decls.slots
                    (+ decls.offset index))
                  out-rev))
              unit)])
        (macro-segmented-program-iter-advance! (&mut iter))))
    (if found
      (Some (macro-decl-list-reverse out-rev))
      (No))))

(define (macro-find-module-body-decls-in-context
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [target-module : String]) : MacroMaybeDeclList
  (if (macro-segmented-program-active? (tc-context-job-state ctx))
    (macro-segmented-find-module-body-decls
      (tc-context-job-state ctx)
      target-module)
    (if (macro-module-exists?
      (tc-global-shared-view decls)
      (tc-global-shared-view target-module))
      (Some (macro-collect-module-body-decls decls target-module ""))
      (No))))

(define (macro-generated-identity-shortcut-safe-params?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]) : bool
  (macro-generated-identity-shortcut-safe-params-at?
    ctx
    definition-module
    definition-module-id
    (& params)
    (& args)
    0))

(define (macro-generated-identity-shortcut-safe-params-at?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-macro-param-list-len params))
    true
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param _ ty variadic _)
        (and
          (if (macro-identity-syntax-param-type?
            ctx
            (tc-global-shared-view definition-module)
            definition-module-id
            ty)
            ;; A syntax parameter can choose output by syntax even when its
            ;; value-derived identity key collides, so it normally disables
            ;; the authoritative memo shortcut. An empty trailing variadic
            ;; syntax parameter has no operand syntax to distinguish and is
            ;; therefore safe; this preserves the identity of legacy calls
            ;; when a generator adds an optional syntax capability tail.
            (and variadic (>= index args.len))
            true)
          (macro-generated-identity-shortcut-safe-params-at?
            ctx
            definition-module
            definition-module-id
            params
            args
            (+ index 1)))])))

(define (macro-spanned-symbol-id [name-id : i64] [span : token.SourceSpan]) : reader.SpannedSexpr
  (Sym (ci.intern-syntax-id-from-raw name-id) span))

(define (macro-expr-list-with-head-symbol-id
  [owner : (& owner MacroSexprOwner)]
  [name-id : i64]
  [exprs : ast.AstExprList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [tail : reader.SpannedSexpr
      (try (macro-expr-list-to-spanned-sexpr owner exprs span origin))]
    (Ok
      (reader.spanned-sexpr-list-prepend
        (macro-spanned-symbol-id name-id span)
        tail
        span))))

;; Serialize a child expression node (referenced by node-pool id) back to a
;; spanned sexpr. Used by the declaration-emitting macro output serializer to
;; rebuild non-trivial function bodies (arithmetic, struct/array access, let,
;; while, set!, ...) that the quasiquote evaluator stores as typed AST nodes.
(define (macro-child-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span
    owner
    (ast.ast-expr-segment-bases-get owner.expr-bases id)
    span
    origin))

(define (macro-form1-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-list2 (macro-spanned-symbol-id name-id span) a span))

(define (macro-form0-id [name-id : i64] [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-list1 (macro-spanned-symbol-id name-id span) span))

(define (macro-form2-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [b : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-list3 (macro-spanned-symbol-id name-id span) a b span))

(define (macro-form3-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [b : reader.SpannedSexpr]
  [c : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-list4 (macro-spanned-symbol-id name-id span) a b c span))

(define (macro-binop-symbol-id [op : ast.AstBinOp]) : i64
  (match op
    [(Add) (cbi.compiler-builtin-ctfe "+")]
    [(Sub) (cbi.compiler-builtin-ctfe "-")]
    [(Mul) (cbi.compiler-builtin-ctfe "*")]
    [(Div) (cbi.compiler-builtin-ctfe "/")]
    [(Mod) (cbi.compiler-builtin-ctfe "%")]
    [(Eq) (cbi.compiler-builtin-ctfe "=")]
    [(Ne) (cbi.compiler-builtin-ctfe "!=")]
    [(Lt) (cbi.compiler-builtin-ctfe "<")]
    [(Le) (cbi.compiler-builtin-ctfe "<=")]
    [(Gt) (cbi.compiler-builtin-ctfe ">")]
    [(Ge) (cbi.compiler-builtin-ctfe ">=")]
    [(And) (cbi.compiler-builtin-ctfe "and")]
    [(Or) (cbi.compiler-builtin-ctfe "or")]
    [(BitAnd) (cbi.compiler-builtin-ctfe "bit-and")]
    [(BitOr) (cbi.compiler-builtin-ctfe "bit-or")]
    [(BitXor) (cbi.compiler-builtin-ctfe "bit-xor")]
    [(Shl) (cbi.compiler-builtin-ctfe "shl")]
    [(Shr) (cbi.compiler-builtin-ctfe "shr")]))

(define (macro-unop-symbol-id [op : ast.AstUnOp]) : i64
  (match op
    [(Neg) (cbi.compiler-builtin-ctfe "-")]
    [(Not) (cbi.compiler-builtin-ctfe "not")]
    [(BitNot) (cbi.compiler-builtin-ctfe "bit-not")]))

(define (macro-lifetime-list-to-spanned-sexpr
  [items : ast.AstLifetimeList]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (macro-lifetime-list-to-spanned-sexpr-at (& items) span 0))

(define (macro-lifetime-list-to-spanned-sexpr-at
  [items : (& items ast.AstLifetimeList)]
  [span : token.SourceSpan]
  [index : i64]) : reader.SpannedSexpr
  (let
    [builder : reader.SpannedSexprBuilder (reader.spanned-sexpr-builder-new)]
    [i : i64 index]
    (while (< i (ast.ast-lifetime-list-len items))
      (set!
        builder
        (reader.spanned-sexpr-builder-push
          builder
          (macro-spanned-symbol-id
            (ast.ast-lifetime-list-get items i (ast.ast-lifetime-fallback))
            span)))
      (set! i (+ i 1)))
    (reader.spanned-sexpr-list-from-builder builder span)))

(define (macro-internal-resolved-struct-type-marker) : String
  "__typelisp internal resolved struct type")

(define (macro-internal-resolved-enum-type-marker) : String
  "__typelisp internal resolved enum type")

(define (macro-resolved-nominal-type-sexpr
  [marker-id : i64]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-list-from-builder
    (reader.spanned-sexpr-builder-extend
      (reader.spanned-sexpr-builder-push
        (reader.spanned-sexpr-builder-push
          (reader.spanned-sexpr-builder-new)
          (macro-spanned-symbol-id marker-id span))
        (macro-spanned-symbol-id name-id span))
      (macro-lifetime-list-to-spanned-sexpr lifetimes span))
    span))

(define (macro-type-list-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [items : ast.AstTypeList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-type-list-to-spanned-sexpr-at owner (& items) span origin 0))

(define (macro-type-list-to-spanned-sexpr-at
  [owner : (& owner MacroSexprOwner)]
  [items : (& items ast.AstTypeList)]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [index : i64]) : ResultMacroSexpr
  (macro-type-list-to-spanned-sexpr-into
    owner
    items
    span
    origin
    index
    (reader.spanned-sexpr-builder-new)))

(define (macro-type-list-to-spanned-sexpr-into
  [owner : (& owner MacroSexprOwner)]
  [items : (& items ast.AstTypeList)]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [index : i64]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index (ast.ast-type-list-len items))
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (match (macro-type-to-spanned-sexpr
      owner
      (ast.ty-node-get
        (ast.ast-type-list-get items index (ast.ast-type-id-fallback)))
      span
      (tc-global-shared-view origin))
      [(Ok shead)
        (macro-type-list-to-spanned-sexpr-into
          owner
          items
          span
          origin
          (+ index 1)
          (reader.spanned-sexpr-builder-push builder shead))]
      [(Err diag)
        (reader.spanned-sexpr-builder-discard! builder)
        (Err diag)])))

(define (macro-type-unary-sexpr-id
  [owner : (& owner MacroSexprOwner)]
  [name-id : i64]
  [inner-id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sinner
      (try
        (macro-type-to-spanned-sexpr
          owner
          (ast.ty-node-get inner-id)
          span
          origin))]
    (Ok (macro-form1-id name-id sinner span))))

(define (macro-type-named-args-sexpr
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [span : token.SourceSpan]) : ResultMacroSexpr
  (Ok
    (reader.spanned-sexpr-list-prepend
      (macro-spanned-symbol-id name-id span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)))

(define (macro-output-origin-arg-name [expr-bases : i64] [expr : ast.AstExpr]) : String
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name-id)
      (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
        (ci.intern-str name-id)
        (str_cat.str-cat "<var:" (string.int->string name-id) ">"))]
    [(TypeLiteral ty-id)
      (let
        [ty : ast.AstType (ast.ty-node-get ty-id)]
        (match (tc-global-shared-view ty)
          [(Var name-id)
            (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
              (ci.intern-str name-id)
              (str_cat.str-cat "<type-var:" (string.int->string name-id) ">"))]
          [_ (tc-type-render ty)]))]
    [_ "<expression>"]))

(define (macro-output-origin-name [expr-bases : i64] [origin : ast.AstExpr]) : String
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& origin))
    [(Call func-box args)
      (let
        [func-name : String
          (match (ast.ast-expr-unspan-with-segment-bases
            expr-bases
            (& (ast.ast-expr-segment-bases-get expr-bases func-box)))
            [(Var name-id)
              (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
                (ci.intern-str name-id)
                "<invalid-call-name>")]
            [_ "<indirect-call>"])]
        [arg-name : String
          (if (> (ast.ast-expr-list-len (& args)) 0)
            (macro-output-origin-arg-name
              expr-bases
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-list-get (& args) 0 0)))
            "<no-args>")]
        (str_cat.str-cat func-name "(" arg-name ")"))]
    [(Var name-id)
      (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
        (ci.intern-str name-id)
        "<invalid-var>")]
    [_ "<non-call-expression>"]))

;; Serialize an AstType back to a spanned sexpr so type positions embedded in
;; expression nodes (__tl_make-array, cast, ann, typed let bindings) round-trip.
(define (macro-type-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [ty : ast.AstType]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match ty
    [(I64)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "i64") span))]
    [(I32)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "i32") span))]
    [(I16)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "i16") span))]
    [(I8) (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "i8") span))]
    [(U64)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "u64") span))]
    [(U32)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "u32") span))]
    [(U16)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "u16") span))]
    [(U8) (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "u8") span))]
    [(F64)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "f64") span))]
    [(F32)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "f32") span))]
    [(Bool)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "bool") span))]
    [(Char)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "char") span))]
    [(String)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "String") span))]
    [(Str)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "str") span))]
    [(Bytes)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "bytes") span))]
    [(Unit)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "unit") span))]
    [(Never)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "never") span))]
    [(Expr)
      (Ok (macro-spanned-symbol-id cbi.compiler-builtin-id-fix-Expr span))]
    [(ExprList)
      (Ok (macro-spanned-symbol-id cbi.compiler-builtin-id-fix-ExprList span))]
    [(DynArray elem)
      (macro-type-unary-sexpr-id
        owner
        (ci.intern "__tl_dyn-array")
        elem
        span
        origin)]
    [(Slice elem)
      (macro-type-unary-sexpr-id owner (ci.intern "Slice") elem span origin)]
    [(Array elem count)
      (let
        [selem : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get elem)
              span
              origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "Array")
            selem
            (Int count (reader.sp-text-id (string.int->string count)) span)
            span)))]
    [(Box inner)
      (macro-type-unary-sexpr-id
        owner
        cbi.compiler-builtin-id-fix-Box
        inner
        span
        origin)]
    [(Ptr inner)
      (macro-type-unary-sexpr-id
        owner
        (cbi.compiler-builtin-ctfe "Ptr")
        inner
        span
        origin)]
    [(MutPtr inner)
      (macro-type-unary-sexpr-id
        owner
        (cbi.compiler-builtin-ctfe "MutPtr")
        inner
        span
        origin)]
    [(Tuple items)
      (let
        [stail : reader.SpannedSexpr
          (try
            (macro-type-list-to-spanned-sexpr
              owner
              (ast.ast-type-list-box-shared-view items)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "Tuple") span)
            stail
            span)))]
    [(Func args ret)
      (let
        [sargs
          (try
            (macro-type-list-to-spanned-sexpr
              owner
              (ast.ast-type-list-box-shared-view args)
              span
              (tc-global-shared-view origin)))]
        [sret : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ret)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-from-builder
            (reader.spanned-sexpr-builder-push
              (reader.spanned-sexpr-builder-extend
                (reader.spanned-sexpr-builder-push
                  (reader.spanned-sexpr-builder-new)
                  (macro-spanned-symbol-id
                    (cbi.compiler-builtin-ctfe "->")
                    span))
                sargs)
              sret)
            span)))]
    [(CFunc signature mode)
      (let
        [signature-sexpr : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get signature)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-from-builder
            (reader.spanned-sexpr-builder-push
              (reader.spanned-sexpr-builder-push
                (reader.spanned-sexpr-builder-push
                  (reader.spanned-sexpr-builder-new)
                  (macro-spanned-symbol-id
                    (ci.intern-generated-name "CFunc")
                    span))
                (macro-spanned-symbol-id
                  (ci.intern-generated-name
                    (& (ast.ast-c-function-mode-name mode)))
                  span))
              signature-sexpr)
            span)))]
    [(Struct name)
      (Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe "__typelisp internal resolved struct type")
          name
          (ast.ast-lifetime-list-new)
          span))]
    [(Enum name)
      (Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe "__typelisp internal resolved enum type")
          name
          (ast.ast-lifetime-list-new)
          span))]
    [(Var name)
      (if (< name 0)
        (io.panic
          (str_cat.str-cat
            "macro output received invalid type-var id in origin "
            (macro-output-origin-name owner.expr-bases origin)))
        (Ok
          (macro-spanned-symbol-id
            (macro-output-source-identity-id-at
              (macro-sexpr-session owner)
              name
              "type-var")
            span)))]
    [(StructArgs name lifetimes)
      (Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe "__typelisp internal resolved struct type")
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes)
          span))]
    [(EnumArgs name lifetimes)
      (Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe "__typelisp internal resolved enum type")
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes)
          span))]
    [(VarArgs name lifetimes)
      (macro-type-named-args-sexpr
        (macro-output-source-identity-id-at
          (macro-sexpr-session owner)
          name
          "type-var-args")
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        span)]
    [(Ref region inner)
      (let
        [sinner : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get inner)
              span
              origin))]
        (Ok
          (if (= region cbi.compiler-builtin-id-fix-empty)
            (macro-form1-id (cbi.compiler-builtin-ctfe "&") sinner span)
            (macro-form2-id
              (cbi.compiler-builtin-ctfe "&")
              (macro-spanned-symbol-id region span)
              sinner
              span))))]
    [(MutRef region inner)
      (let
        [sinner : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get inner)
              span
              origin))]
        (Ok
          (if (= region cbi.compiler-builtin-id-fix-empty)
            (macro-form1-id (cbi.compiler-builtin-ctfe "&mut") sinner span)
            (macro-form2-id
              (cbi.compiler-builtin-ctfe "&mut")
              (macro-spanned-symbol-id region span)
              sinner
              span))))]
    [(Region region inner)
      (let
        [sinner : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get inner)
              span
              origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "in")
            (macro-spanned-symbol-id region span)
            sinner
            span)))]
    [(Invalidate lifetime inner)
      (let
        [sinner : reader.SpannedSexpr
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get inner)
              span
              origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe ":invalidate")
            (macro-spanned-symbol-id lifetime span)
            sinner
            span)))]))

(define (macro-child-form1-id
  [owner : (& owner MacroSexprOwner)]
  [name-id : i64]
  [id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sexpr (try (macro-child-to-spanned-sexpr owner id span origin))]
    (Ok (macro-form1-id name-id sexpr span))))

(define (macro-child-form2-id
  [owner : (& owner MacroSexprOwner)]
  [name-id : i64]
  [left-id : i64]
  [right-id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sleft
      (try
        (macro-child-to-spanned-sexpr
          owner
          left-id
          span
          (tc-global-shared-view origin)))]
    [sright : reader.SpannedSexpr
      (try (macro-child-to-spanned-sexpr owner right-id span origin))]
    (Ok (macro-form2-id name-id sleft sright span))))

(define (macro-child-type-form3-id
  [owner : (& owner MacroSexprOwner)]
  [name-id : i64]
  [expr-id : i64]
  [ty : ast.AstType]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sexpr
      (try
        (macro-child-to-spanned-sexpr
          owner
          expr-id
          span
          (tc-global-shared-view origin)))]
    [sty : reader.SpannedSexpr
      (try (macro-type-to-spanned-sexpr owner ty span origin))]
    (Ok
      (macro-form3-id
        name-id
        sexpr
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
        sty
        span))))

(define (macro-literal-to-spanned-sexpr
  [lit : ast.AstLiteral]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (match lit
    [(Int n text) (Int n (reader.sp-text-id text) span)]
    [(Float text) (Float (reader.sp-text-id text) span)]
    [(Bool value)
      (macro-spanned-symbol-id
        (if value
          (cbi.compiler-builtin-ctfe "true")
          (cbi.compiler-builtin-ctfe "false"))
        span)]
    [(Char c) (Char c span)]
    [(String string-id) (Str (ci.intern-id-from-renderable string-id) span)]
    [(Unit) (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "unit") span)]))

(define (macro-pattern-list-to-spanned-sexpr
  [session : cis.InternStructuralSessionHandle]
  [patterns : ast.AstPatternList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-pattern-list-to-spanned-sexpr-at session (& patterns) 0 span origin))

(define (macro-pattern-list-to-spanned-sexpr-at
  [session : cis.InternStructuralSessionHandle]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-pattern-list-to-spanned-sexpr-into
    session
    patterns
    index
    span
    origin
    (reader.spanned-sexpr-builder-new)))

(define (macro-pattern-list-to-spanned-sexpr-into
  [session : cis.InternStructuralSessionHandle]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index patterns.len)
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (match (macro-pattern-to-spanned-sexpr
      session
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
      span
      (tc-global-shared-view origin))
      [(Ok shead)
        (macro-pattern-list-to-spanned-sexpr-into
          session
          patterns
          (+ index 1)
          span
          origin
          (reader.spanned-sexpr-builder-push builder shead))]
      [(Err diag)
        (reader.spanned-sexpr-builder-discard! builder)
        (Err diag)])))

;; `(slice p1 ... pk)`, with the `&` marker restored before a rest item.
(define (macro-slice-pattern-to-spanned-sexpr
  [session : cis.InternStructuralSessionHandle]
  [items : ast.AstPatternList]
  [has-rest : bool]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [builder : reader.SpannedSexprBuilder
      (reader.spanned-sexpr-builder-push
        (reader.spanned-sexpr-builder-new)
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "slice") span))]
    [index : i64 0]
    (while (< index items.len)
      (when
        (and has-rest (= index (- items.len 1)))
        (set!
          builder
          (reader.spanned-sexpr-builder-push
            builder
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "&") span))))
      (match (macro-pattern-to-spanned-sexpr
        session
        (ast.ast-pattern-list-get (& items) index (ast.ast-pattern-fallback))
        span
        (tc-global-shared-view origin))
        [(Ok item)
          (set! builder (reader.spanned-sexpr-builder-push builder item))]
        [(Err diag)
          (reader.spanned-sexpr-builder-discard! builder)
          (return (Err diag))])
      (set! index (+ index 1)))
    (Ok (reader.spanned-sexpr-list-from-builder builder span))))

(define (macro-pattern-to-spanned-sexpr
  [session : cis.InternStructuralSessionHandle]
  [pattern : ast.AstPattern]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match pattern
    [(Binding name)
      (Ok
        (macro-spanned-symbol-id
          (macro-output-source-identity-id-at session name "pattern-binding")
          span))]
    [(Wildcard)
      (Ok (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "_") span))]
    [(Literal lit) (Ok (macro-literal-to-spanned-sexpr lit span))]
    [(Variant name args-box)
      (let
        [args : reader.SpannedSexpr
          (try
            (macro-pattern-list-to-spanned-sexpr
              session
              (ast.ast-pattern-list-box-shared-view args-box)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id
              (macro-output-source-identity-id-at
                session
                name
                "pattern-variant")
              span)
            args
            span)))]
    [(Tuple patterns-box)
      (let
        [patterns : reader.SpannedSexpr
          (try
            (macro-pattern-list-to-spanned-sexpr
              session
              (ast.ast-pattern-list-box-shared-view patterns-box)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "tuple") span)
            patterns
            span)))]
    [(Array patterns-box)
      (let
        [patterns : reader.SpannedSexpr
          (try
            (macro-pattern-list-to-spanned-sexpr
              session
              (ast.ast-pattern-list-box-shared-view patterns-box)
              span
              origin))]
        (Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "array") span)
            patterns
            span)))]
    [(Slice items-box has-rest)
      (macro-slice-pattern-to-spanned-sexpr
        session
        (ast.ast-pattern-list-box-shared-view items-box)
        has-rest
        span
        origin)]
    [(ast.AstPattern.Or patterns-box)
      (let
        [patterns : reader.SpannedSexpr
          (try
            (macro-pattern-list-to-spanned-sexpr
              session
              (ast.ast-pattern-list-box-shared-view patterns-box)
              span
              origin))]
        (ResultMacroSexpr.Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "or") span)
            patterns
            span)))]
    [(ast.AstPattern.Fields patterns-box)
      (let
        [patterns : reader.SpannedSexpr
          (try
            (macro-pattern-list-to-spanned-sexpr
              session
              (ast.ast-pattern-list-box-shared-view patterns-box)
              span
              origin))]
        (ResultMacroSexpr.Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (ci.intern "fields") span)
            patterns
            span)))]
    ;; Always the explicit `[pattern field]` spelling, which also covers the
    ;; bare-name shorthand.
    [(ast.AstPattern.Field name patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        [sub : reader.SpannedSexpr
          (try
            (macro-pattern-to-spanned-sexpr
              session
              (ast.ast-pattern-field-sub (& patterns))
              span
              origin))]
        (ResultMacroSexpr.Ok
          (reader.spanned-sexpr-bracket-list
            (reader.spanned-sexpr-list2
              sub
              (macro-spanned-symbol-id
                (macro-output-source-identity-id-at
                  session
                  name
                  "pattern-field")
                span)
              span)
            span)))]
    [(ast.AstPattern.Var _ _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output typed patterns cannot be parsed as source declarations")))]))

(define (macro-match-arm-bracket
  [owner : (& owner MacroSexprOwner)]
  [arm : ast.AstMatchArm]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match arm
    [(Arm pattern body-id)
      (let
        [spattern
          (try
            (macro-pattern-to-spanned-sexpr
              (macro-sexpr-session owner)
              pattern
              span
              (tc-global-shared-view origin)))]
        [sbody : reader.SpannedSexpr
          (try (macro-child-to-spanned-sexpr owner body-id span origin))]
        (Ok
          (reader.spanned-sexpr-bracket-list
            (reader.spanned-sexpr-list2 spattern sbody span)
            span)))]))

(define (macro-match-arm-list-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [arms : ast.AstMatchArmList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-match-arm-list-to-spanned-sexpr-at owner (& arms) 0 span origin))

(define (macro-match-arm-list-to-spanned-sexpr-at
  [owner : (& owner MacroSexprOwner)]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-match-arm-list-to-spanned-sexpr-into
    owner
    arms
    index
    span
    origin
    (reader.spanned-sexpr-builder-new)))

(define (macro-match-arm-list-to-spanned-sexpr-into
  [owner : (& owner MacroSexprOwner)]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index arms.len)
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (match (macro-match-arm-bracket
      owner
      (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      span
      (tc-global-shared-view origin))
      [(Ok shead)
        (macro-match-arm-list-to-spanned-sexpr-into
          owner
          arms
          (+ index 1)
          span
          origin
          (reader.spanned-sexpr-builder-push builder shead))]
      [(Err diag)
        (reader.spanned-sexpr-builder-discard! builder)
        (Err diag)])))

(define (macro-let-binding-bracket
  [owner : (& owner MacroSexprOwner)]
  [binding : ast.AstLetBinding]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match binding
    [(Binding name maybe-ty value-id)
      (let
        [svalue
          (try
            (macro-child-to-spanned-sexpr
              owner
              value-id
              span
              (tc-global-shared-view origin)))]
        (match maybe-ty
          [(No)
            (Ok
              (reader.spanned-sexpr-bracket-list
                (reader.spanned-sexpr-list2
                  (macro-spanned-symbol-id
                    (macro-output-source-identity-id-at
                      (macro-sexpr-session owner)
                      name
                      "let-binding")
                    span)
                  svalue
                  span)
                span))]
          [(Some ty)
            (let
              [sty : reader.SpannedSexpr
                (try (macro-type-to-spanned-sexpr owner ty span origin))]
              (Ok
                (reader.spanned-sexpr-bracket-list
                  (reader.spanned-sexpr-list4
                    (macro-spanned-symbol-id
                      (macro-output-source-identity-id-at
                        (macro-sexpr-session owner)
                        name
                        "typed-let-binding")
                      span)
                    (macro-spanned-symbol-id
                      (cbi.compiler-builtin-ctfe ":")
                      span)
                    sty
                    svalue
                    span)
                  span)))]))]))

(define (macro-let-tail
  [owner : (& owner MacroSexprOwner)]
  [bindings : ast.AstLetBindingList]
  [body : reader.SpannedSexpr]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-let-tail-at
    owner
    (& bindings)
    body
    span
    origin
    0
    (reader.spanned-sexpr-builder-new)))

(define (macro-let-tail-at
  [owner : (& owner MacroSexprOwner)]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body : reader.SpannedSexpr]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [index : i64]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok
      (reader.spanned-sexpr-list-from-builder
        (reader.spanned-sexpr-builder-push builder body)
        span))
    (match (macro-let-binding-bracket
      owner
      (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
      span
      (tc-global-shared-view origin))
      [(Ok sbracket)
        (macro-let-tail-at
          owner
          bindings
          body
          span
          origin
          (+ index 1)
          (reader.spanned-sexpr-builder-push builder sbracket))]
      [(Err diag)
        (reader.spanned-sexpr-builder-discard! builder)
        (Err diag)])))

(define (macro-expr-list-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [exprs : ast.AstExprList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-expr-list-to-spanned-sexpr-at
    owner
    (& exprs)
    0
    span
    origin
    (reader.spanned-sexpr-builder-new)))

(define (macro-expr-list-to-spanned-sexpr-at
  [owner : (& owner MacroSexprOwner)]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index exprs.len)
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          owner.expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (match (macro-expr-to-spanned-sexpr-with-span
        owner
        head-expr
        span
        (tc-global-shared-view origin))
        [(Ok shead)
          (macro-expr-list-to-spanned-sexpr-at
            owner
            exprs
            (+ index 1)
            span
            origin
            (reader.spanned-sexpr-builder-push builder shead))]
        [(Err diag)
          (reader.spanned-sexpr-builder-discard! builder)
          (Err diag)]))))

(define (macro-call-head-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [expr : ast.AstExpr]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match (tc-global-shared-view expr)
    [(Spanned inner-box ast-span)
      (macro-call-head-to-spanned-sexpr
        owner
        (ast.ast-expr-segment-bases-get owner.expr-bases inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(MacroExpansion inner-box _ _)
      (macro-call-head-to-spanned-sexpr
        owner
        (ast.ast-expr-segment-bases-get owner.expr-bases inner-box)
        span
        origin)]
    [(Var name-id)
      (let
        [source-id : i64
          (macro-output-syntax-id-at
            (macro-sexpr-session owner)
            name-id
            "call-head")]
        [tag : i64
          (parser.compiler-parse-dispatch-tag-id
            (parser.compiler-parse-dispatch-env)
            source-id)]
        (Ok
          (macro-spanned-symbol-id
            (if (or
              (= tag (parser.compiler-parse-tag-unknown))
              (macro-hygiene-global-id? (macro-sexpr-session owner) name-id))
              (macro-output-source-identity-id-at
                (macro-sexpr-session owner)
                name-id
                "call-head")
              source-id)
            span)))]
    [_ (macro-expr-to-spanned-sexpr-with-span owner expr span origin)]))

(define (macro-expr-to-spanned-sexpr-with-span
  [owner : (& owner MacroSexprOwner)]
  [expr : ast.AstExpr]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (match expr
    [(Spanned inner-box ast-span)
      (macro-expr-to-spanned-sexpr-with-span
        owner
        (ast.ast-expr-segment-bases-get owner.expr-bases inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(MacroExpansion inner-box _ _)
      (macro-expr-to-spanned-sexpr-with-span
        owner
        (ast.ast-expr-segment-bases-get owner.expr-bases inner-box)
        span
        origin)]
    [(Literal lit) (Ok (macro-literal-to-spanned-sexpr lit span))]
    [(Var name)
      (Ok
        (macro-spanned-symbol-id
          (macro-output-source-identity-id-at
            (macro-sexpr-session owner)
            name
            "expr-var")
          span))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get owner.expr-bases func-box)]
        [head
          (try
            (macro-call-head-to-spanned-sexpr
              owner
              func
              span
              (tc-global-shared-view origin)))]
        [tail (try (macro-expr-list-to-spanned-sexpr owner args span origin))]
        (Ok (reader.spanned-sexpr-list-prepend head tail span)))]
    [(BracketClause items)
      (let
        [list (try (macro-expr-list-to-spanned-sexpr owner items span origin))]
        (Ok (reader.spanned-sexpr-bracket-list list span)))]
    [(If cond-box then-box else-box)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "if")
        (ast.ast-expr-cons
          cond-box
          (&
            (ast.ast-expr-cons
              then-box
              (& (ast.ast-expr-cons else-box (& (ast.ast-expr-list-new)))))))
        span
        origin)]
    [(Begin exprs)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "begin")
        exprs
        span
        origin)]
    [(Unsafe exprs)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "unsafe")
        exprs
        span
        origin)]
    [(Tuple exprs)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "tuple")
        exprs
        span
        origin)]
    [(Array exprs)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "array")
        exprs
        span
        origin)]
    [(DynArray exprs)
      (macro-expr-list-with-head-symbol-id
        owner
        (ci.intern "__tl_make-array")
        exprs
        span
        origin)]
    [(Quote inner-box)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "quote")
        (ast.ast-expr-cons inner-box (& (ast.ast-expr-list-new)))
        span
        origin)]
    [(Quasiquote inner-box)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "quasiquote")
        (ast.ast-expr-cons inner-box (& (ast.ast-expr-list-new)))
        span
        origin)]
    [(Unquote inner-box)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "unquote")
        (ast.ast-expr-cons inner-box (& (ast.ast-expr-list-new)))
        span
        origin)]
    [(UnquoteSplicing inner-box)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "unquote-splicing")
        (ast.ast-expr-cons inner-box (& (ast.ast-expr-list-new)))
        span
        origin)]
    [(Binary op left-id right-id)
      (let
        [sleft
          (try
            (macro-child-to-spanned-sexpr
              owner
              left-id
              span
              (tc-global-shared-view origin)))]
        [sright (try (macro-child-to-spanned-sexpr owner right-id span origin))]
        (Ok (macro-form2-id (macro-binop-symbol-id op) sleft sright span)))]
    [(Unary op inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (macro-unop-symbol-id op) sinner span)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-id)
          (let
            [sbody
              (try
                (macro-child-to-spanned-sexpr
                  owner
                  body-id
                  span
                  (tc-global-shared-view origin)))]
            [stail (try (macro-let-tail owner bindings sbody span origin))]
            (Ok
              (reader.spanned-sexpr-list-prepend
                (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "let") span)
                stail
                span)))])]
    [(While cond-id body-id)
      (macro-operand-body-form owner "while" cond-id body-id span origin)]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-id arms)
          (let
            [sscrutinee
              (try
                (macro-child-to-spanned-sexpr
                  owner
                  scrutinee-id
                  span
                  (tc-global-shared-view origin)))]
            [sarms
              (try
                (macro-match-arm-list-to-spanned-sexpr owner arms span origin))]
            (Ok
              (reader.spanned-sexpr-list-from-builder
                (reader.spanned-sexpr-builder-extend
                  (reader.spanned-sexpr-builder-push
                    (reader.spanned-sexpr-builder-push
                      (reader.spanned-sexpr-builder-new)
                      (macro-spanned-symbol-id
                        (cbi.compiler-builtin-ctfe "match")
                        span))
                    sscrutinee)
                  sarms)
                span)))])]
    [(Set name value-id)
      (let
        [svalue (try (macro-child-to-spanned-sexpr owner value-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "set!")
            (macro-spanned-symbol-id
              (macro-output-source-identity-id-at
                (macro-sexpr-session owner)
                name
                "expr-set")
              span)
            svalue
            span)))]
    [(FixedMakeArray ty-id len-id)
      (let
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              (tc-global-shared-view origin)))]
        [slen (try (macro-child-to-spanned-sexpr owner len-id span origin))]
        (Ok (macro-form2-id (ci.intern "make-array") sty slen span)))]
    [(MakeArray ty-id len-id)
      (let
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              (tc-global-shared-view origin)))]
        [slen (try (macro-child-to-spanned-sexpr owner len-id span origin))]
        (Ok (macro-form2-id (ci.intern "__tl_make-array") sty slen span)))]
    [(ArrayRef array-id index-id)
      (let
        [sarray
          (try
            (macro-child-to-spanned-sexpr
              owner
              array-id
              span
              (tc-global-shared-view origin)))]
        [sindex (try (macro-child-to-spanned-sexpr owner index-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "array-ref")
            sarray
            sindex
            span)))]
    [(ArraySet array-id index-id value-id)
      (let
        [sarray
          (try
            (macro-child-to-spanned-sexpr
              owner
              array-id
              span
              (tc-global-shared-view origin)))]
        [sindex
          (try
            (macro-child-to-spanned-sexpr
              owner
              index-id
              span
              (tc-global-shared-view origin)))]
        [svalue (try (macro-child-to-spanned-sexpr owner value-id span origin))]
        (Ok
          (macro-form3-id
            (ci.intern "__tl_array-set!")
            sarray
            sindex
            svalue
            span)))]
    [(ArrayTake array-id live-id index-id)
      (let
        [sarray
          (try
            (macro-child-to-spanned-sexpr
              owner
              array-id
              span
              (tc-global-shared-view origin)))]
        [slive
          (try
            (macro-child-to-spanned-sexpr
              owner
              live-id
              span
              (tc-global-shared-view origin)))]
        [sindex (try (macro-child-to-spanned-sexpr owner index-id span origin))]
        (Ok
          (macro-form3-id
            (ci.intern "__tl_array-take!")
            sarray
            slive
            sindex
            span)))]
    [(Replace place-id replacement-id)
      (let
        [splace
          (try
            (macro-child-to-spanned-sexpr
              owner
              place-id
              span
              (tc-global-shared-view origin)))]
        [sreplacement
          (try (macro-child-to-spanned-sexpr owner replacement-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "expr-replace")
            splace
            sreplacement
            span)))]
    [(ArrayPush array-id value-id)
      (let
        [sarray
          (try
            (macro-child-to-spanned-sexpr
              owner
              array-id
              span
              (tc-global-shared-view origin)))]
        [svalue (try (macro-child-to-spanned-sexpr owner value-id span origin))]
        (Ok (macro-form2-id (ci.intern "__tl_array-push!") sarray svalue span)))]
    [(StringRef string-id index-id)
      (let
        [sstring
          (try
            (macro-child-to-spanned-sexpr
              owner
              string-id
              span
              (tc-global-shared-view origin)))]
        [sindex (try (macro-child-to-spanned-sexpr owner index-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "string-ref")
            sstring
            sindex
            span)))]
    [(StructGet receiver-id field)
      (let
        [sreceiver
          (try (macro-child-to-spanned-sexpr owner receiver-id span origin))]
        (Ok
          (macro-form2-id
            (ci.intern "__tl_struct-get")
            sreceiver
            (macro-spanned-symbol-id field span)
            span)))]
    [(StructSet receiver-id field value-id)
      (let
        [sreceiver
          (try
            (macro-child-to-spanned-sexpr
              owner
              receiver-id
              span
              (tc-global-shared-view origin)))]
        [svalue (try (macro-child-to-spanned-sexpr owner value-id span origin))]
        [starget : reader.SpannedSexpr
          (if (ast.ast-tuple-set-field-id? field)
            (let
              [index : i64 (ast.ast-tuple-set-index-from-field-id field)]
              (macro-form2-id
                (cbi.compiler-builtin-ctfe "tuple-ref")
                sreceiver
                (Int index (reader.sp-text-id (string.int->string index)) span)
                span))
            (macro-form2-id
              (ci.intern "__tl_struct-get")
              sreceiver
              (macro-spanned-symbol-id field span)
              span))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "set!")
            starget
            svalue
            span)))]
    [(Cast inner-id ty-id)
      (let
        [sinner
          (try
            (macro-child-to-spanned-sexpr
              owner
              inner-id
              span
              (tc-global-shared-view origin)))]
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              origin))]
        (Ok
          (macro-form3-id
            (cbi.compiler-builtin-ctfe "cast")
            sinner
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
            sty
            span)))]
    [(Ann inner-id ty-id)
      (let
        [sinner
          (try
            (macro-child-to-spanned-sexpr
              owner
              inner-id
              span
              (tc-global-shared-view origin)))]
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              origin))]
        (Ok
          (macro-form3-id
            (cbi.compiler-builtin-ctfe "ann")
            sinner
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
            sty
            span)))]
    [(Borrow mutable lifetime-id place-id)
      (let
        [splace (try (macro-child-to-spanned-sexpr owner place-id span origin))]
        [head-id : i64
          (if mutable
            (cbi.compiler-builtin-ctfe "&mut")
            (cbi.compiler-builtin-ctfe "&"))]
        (match (ast.ast-borrow-lifetime-from-id lifetime-id)
          [(Inferred) (Ok (macro-form1-id head-id splace span))]
          [(Named name)
            (Ok
              (macro-form2-id
                head-id
                (macro-spanned-symbol-id name span)
                splace
                span))]))]
    [(Return inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (cbi.compiler-builtin-ctfe "return") sinner span)))]
    [(Try inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (cbi.compiler-builtin-ctfe "try") sinner span)))]
    [(Box inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (cbi.compiler-builtin-ctfe "box") sinner span)))]
    [(BoxGet inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (ci.intern "__tl_box-get") sinner span)))]
    [(BoxTake inner-id)
      (let
        [sinner (try (macro-child-to-spanned-sexpr owner inner-id span origin))]
        (Ok (macro-form1-id (ci.intern "__tl_box-take") sinner span)))]
    [(BoxSet receiver-id value-id)
      (let
        [sreceiver
          (try
            (macro-child-to-spanned-sexpr
              owner
              receiver-id
              span
              (tc-global-shared-view origin)))]
        [svalue (try (macro-child-to-spanned-sexpr owner value-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "set!")
            (macro-form1-id (ci.intern "__tl_box-get") sreceiver span)
            svalue
            span)))]
    [(TupleRef tuple-id index)
      (let
        [stuple (try (macro-child-to-spanned-sexpr owner tuple-id span origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "tuple-ref")
            stuple
            (Int index (reader.sp-text-id (string.int->string index)) span)
            span)))]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id maybe-ty-id)
        [(No)
          (Ok
            (reader.spanned-sexpr-list1
              (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe "init") span)
              span))]
        [(Some ty)
          (let
            [sty (try (macro-type-to-spanned-sexpr owner ty span origin))]
            (Ok
              (macro-form2-id
                (cbi.compiler-builtin-ctfe "init")
                (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
                sty
                span)))])]
    [(TypeLiteral ty-id)
      (let
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              origin))]
        (Ok (macro-form1-id (cbi.compiler-builtin-ctfe "type") sty span)))]
    [(PtrNull ty-id)
      (let
        [sty
          (try
            (macro-type-to-spanned-sexpr
              owner
              (ast.ty-node-get ty-id)
              span
              origin))]
        (Ok
          (macro-form2-id
            (cbi.compiler-builtin-ctfe "ptr-null")
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
            sty
            span)))]
    [(PtrNullCheck ptr-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-null?")
        ptr-id
        span
        origin)]
    [(PtrAddrOf place-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-addr-of")
        place-id
        span
        origin)]
    [(PtrRead ptr-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-read")
        ptr-id
        span
        origin)]
    [(PtrWrite ptr-id value-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-write!")
        ptr-id
        value-id
        span
        origin)]
    [(PtrOffset ptr-id offset-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-offset")
        ptr-id
        offset-id
        span
        origin)]
    [(PtrCast ptr-id ty-id)
      (macro-child-type-form3-id
        owner
        (cbi.compiler-builtin-ctfe "ptr-cast")
        ptr-id
        (ast.ty-node-get ty-id)
        span
        origin)]
    [(PtrToInt ptr-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "ptr->int")
        ptr-id
        span
        origin)]
    [(IntToPtr value-id ty-id)
      (macro-child-type-form3-id
        owner
        (cbi.compiler-builtin-ctfe "int->ptr")
        value-id
        (ast.ty-node-get ty-id)
        span
        origin)]
    [(StringData value-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "string-data")
        value-id
        span
        origin)]
    [(StringFromBytes ptr-id len-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "string-from-bytes")
        ptr-id
        len-id
        span
        origin)]
    [(ArrayData value-id)
      (macro-child-form1-id
        owner
        (ci.intern "__tl_array-data")
        value-id
        span
        origin)]
    [(BinaryData bytes)
      (Ok
        (macro-form1-id
          (cbi.compiler-builtin-ctfe "__typelisp internal binary data")
          (Str
            (ci.intern-id-from-renderable
              (ci.intern-generated-canonical-name bytes))
            span)
          span))]
    [(ProgramArgc)
      (Ok (macro-form0-id (cbi.compiler-builtin-ctfe "program-argc") span))]
    [(ProgramArgv)
      (Ok (macro-form0-id (cbi.compiler-builtin-ctfe "program-argv") span))]
    [(ProgramEnvp)
      (Ok (macro-form0-id (cbi.compiler-builtin-ctfe "program-envp") span))]
    [(CpuIdEax leaf-id subleaf-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "cpuid-eax")
        leaf-id
        subleaf-id
        span
        origin)]
    [(CpuIdEbx leaf-id subleaf-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "cpuid-ebx")
        leaf-id
        subleaf-id
        span
        origin)]
    [(CpuIdEcx leaf-id subleaf-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "cpuid-ecx")
        leaf-id
        subleaf-id
        span
        origin)]
    [(CpuIdEdx leaf-id subleaf-id)
      (macro-child-form2-id
        owner
        (cbi.compiler-builtin-ctfe "cpuid-edx")
        leaf-id
        subleaf-id
        span
        origin)]
    [(Xgetbv index-id)
      (macro-child-form1-id
        owner
        (cbi.compiler-builtin-ctfe "xgetbv")
        index-id
        span
        origin)]
    [(Syscall args)
      (macro-expr-list-with-head-symbol-id
        owner
        (cbi.compiler-builtin-ctfe "syscall")
        args
        span
        origin)]
    ;; Scoped forms: a head, sometimes one leading operand or binder, then the
    ;; body list exactly as the parser keeps it (#7918).
    [(InArena arena-id body)
      (macro-operand-body-form owner "in-arena" arena-id body span origin)]
    [(WithEscape scratch-id body)
      (macro-operand-body-form owner "with-escape" scratch-id body span origin)]
    [(WithScratch body)
      (macro-expr-list-with-head-symbol-id
        owner
        (ci.intern "with-scratch")
        body
        span
        origin)]
    [(WithRegion region body)
      (let
        [sbody : reader.SpannedSexpr
          (try (macro-expr-list-to-spanned-sexpr owner body span origin))]
        (Ok
          (reader.spanned-sexpr-list-prepend
            (macro-spanned-symbol-id (ci.intern "with-arena") span)
            (reader.spanned-sexpr-list-prepend
              (macro-binder-symbol owner region "with-arena-region" span)
              sbody
              span)
            span)))]
    [(WithResource resource-box)
      (match (__tl-box-place resource-box)
        [(WithResource bindings body)
          (let
            [sbindings-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sbindings : reader.SpannedSexpr
              (try
                (macro-resource-bindings-to-spanned-sexpr
                  owner
                  (& bindings)
                  0
                  span
                  sbindings-origin
                  (reader.spanned-sexpr-builder-new)))]
            [sbody : reader.SpannedSexpr
              (try (macro-expr-list-to-spanned-sexpr owner body span origin))]
            (Ok
              (reader.spanned-sexpr-list-prepend
                (macro-spanned-symbol-id (ci.intern "with") span)
                (reader.spanned-sexpr-list-prepend sbindings sbody span)
                span)))])]
    [(Break) (Ok (macro-form0-id (ci.intern "break") span))]
    [(Continue) (Ok (macro-form0-id (ci.intern "continue") span))]
    [(Comptime inner-id)
      (macro-child-form1-id owner (ci.intern "comptime") inner-id span origin)]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-id)
          (let
            [sparams-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sparams : reader.SpannedSexpr
              (try
                (macro-lambda-params-to-spanned-sexpr
                  owner
                  (& params)
                  0
                  span
                  sparams-origin
                  (reader.spanned-sexpr-builder-new)))]
            [sbody-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sbody : reader.SpannedSexpr
              (try
                (macro-child-to-spanned-sexpr owner body-id span sbody-origin))]
            [head : reader.SpannedSexpr
              (macro-spanned-symbol-id (ci.intern "lambda") span)]
            (match maybe-ret
              [(No) (Ok (reader.spanned-sexpr-list3 head sparams sbody span))]
              [(Some ret)
                (let
                  [sret : reader.SpannedSexpr
                    (try (macro-type-to-spanned-sexpr owner ret span origin))]
                  (Ok
                    (reader.spanned-sexpr-list-from-builder
                      (reader.spanned-sexpr-builder-push
                        (reader.spanned-sexpr-builder-push
                          (reader.spanned-sexpr-builder-push
                            (reader.spanned-sexpr-builder-push
                              (reader.spanned-sexpr-builder-push
                                (reader.spanned-sexpr-builder-new)
                                head)
                              sparams)
                            (macro-spanned-symbol-id
                              (cbi.compiler-builtin-ctfe ":")
                              span))
                          sret)
                        sbody)
                      span)))]))])]
    [(Foreach foreach-box)
      (match (__tl-box-place foreach-box)
        [(Foreach name index-ty start-id end-id body-id)
          (let
            [srange-origin : ast.AstExpr (tc-global-shared-view origin)]
            [srange : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  name
                  "foreach-index"
                  index-ty
                  start-id
                  end-id
                  span
                  srange-origin))]
            [sbody : reader.SpannedSexpr
              (try (macro-child-to-spanned-sexpr owner body-id span origin))]
            (Ok
              (reader.spanned-sexpr-list3
                (macro-spanned-symbol-id (ci.intern "foreach") span)
                (reader.spanned-sexpr-list1 srange span)
                sbody
                span)))]
        [(Foreach2
            outer
            outer-ty
            outer-start-id
            outer-end-id
            inner
            inner-ty
            inner-start-id
            inner-end-id
            body-id)
          (let
            [souter-origin : ast.AstExpr (tc-global-shared-view origin)]
            [souter : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  outer
                  "foreach-index"
                  outer-ty
                  outer-start-id
                  outer-end-id
                  span
                  souter-origin))]
            [sinner-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sinner : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  inner
                  "foreach-index"
                  inner-ty
                  inner-start-id
                  inner-end-id
                  span
                  sinner-origin))]
            [sbody : reader.SpannedSexpr
              (try (macro-child-to-spanned-sexpr owner body-id span origin))]
            (Ok
              (reader.spanned-sexpr-list3
                (macro-spanned-symbol-id (ci.intern "foreach") span)
                (reader.spanned-sexpr-list2 souter sinner span)
                sbody
                span)))])]
    [(ForeachActive lane body-id)
      (let
        [sbody : reader.SpannedSexpr
          (try (macro-child-to-spanned-sexpr owner body-id span origin))]
        (Ok
          (reader.spanned-sexpr-list3
            (macro-spanned-symbol-id (ci.intern "foreach-active") span)
            (reader.spanned-sexpr-bracket-list
              (reader.spanned-sexpr-list3
                (macro-binder-symbol owner lane "foreach-active-lane" span)
                (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
                (macro-spanned-symbol-id (ci.intern "i64") span)
                span)
              span)
            sbody
            span)))]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce op name ty start-id end-id init-id value-id)
          (let
            [srange-origin : ast.AstExpr (tc-global-shared-view origin)]
            [srange : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  name
                  "spmd-reduce-index"
                  ty
                  start-id
                  end-id
                  span
                  srange-origin))]
            [sinit-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sinit : reader.SpannedSexpr
              (try
                (macro-child-to-spanned-sexpr owner init-id span sinit-origin))]
            [svalue : reader.SpannedSexpr
              (try (macro-child-to-spanned-sexpr owner value-id span origin))]
            (Ok
              (reader.spanned-sexpr-list-from-builder
                (reader.spanned-sexpr-builder-push
                  (reader.spanned-sexpr-builder-push
                    (reader.spanned-sexpr-builder-push
                      (reader.spanned-sexpr-builder-push
                        (reader.spanned-sexpr-builder-push
                          (reader.spanned-sexpr-builder-new)
                          (macro-spanned-symbol-id
                            (ci.intern "spmd-reduce")
                            span))
                        (macro-reduce-op-symbol op span))
                      (reader.spanned-sexpr-list1 srange span))
                    sinit)
                  svalue)
                span)))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan
            op
            name
            ty
            start-id
            end-id
            prefix
            prefix-ty
            init-id
            value-id
            body-id)
          (let
            [srange-origin : ast.AstExpr (tc-global-shared-view origin)]
            [srange : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  name
                  "spmd-scan-index"
                  ty
                  start-id
                  end-id
                  span
                  srange-origin))]
            [sprefix-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sprefix : reader.SpannedSexpr
              (try
                (macro-state-binder-bracket
                  owner
                  prefix
                  "spmd-scan-prefix"
                  prefix-ty
                  init-id
                  span
                  sprefix-origin))]
            [svalue-origin : ast.AstExpr (tc-global-shared-view origin)]
            [svalue : reader.SpannedSexpr
              (try
                (macro-child-to-spanned-sexpr owner value-id span svalue-origin))]
            [sbody : reader.SpannedSexpr
              (try (macro-child-to-spanned-sexpr owner body-id span origin))]
            (Ok
              (reader.spanned-sexpr-list-from-builder
                (reader.spanned-sexpr-builder-push
                  (reader.spanned-sexpr-builder-push
                    (reader.spanned-sexpr-builder-push
                      (reader.spanned-sexpr-builder-push
                        (reader.spanned-sexpr-builder-push
                          (reader.spanned-sexpr-builder-new)
                          (macro-spanned-symbol-id (ci.intern "spmd-scan") span))
                        (macro-reduce-op-symbol op span))
                      (reader.spanned-sexpr-list2 srange sprefix span))
                    svalue)
                  sbody)
                span)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact name ty start-id end-id slot slot-ty init-id keep-id body-id)
          (let
            [srange-origin : ast.AstExpr (tc-global-shared-view origin)]
            [srange : reader.SpannedSexpr
              (try
                (macro-range-binder-bracket
                  owner
                  name
                  "spmd-compact-index"
                  ty
                  start-id
                  end-id
                  span
                  srange-origin))]
            [sslot-origin : ast.AstExpr (tc-global-shared-view origin)]
            [sslot : reader.SpannedSexpr
              (try
                (macro-state-binder-bracket
                  owner
                  slot
                  "spmd-compact-slot"
                  slot-ty
                  init-id
                  span
                  sslot-origin))]
            [skeep-origin : ast.AstExpr (tc-global-shared-view origin)]
            [skeep : reader.SpannedSexpr
              (try
                (macro-child-to-spanned-sexpr owner keep-id span skeep-origin))]
            [sbody : reader.SpannedSexpr
              (try (macro-child-to-spanned-sexpr owner body-id span origin))]
            (Ok
              (reader.spanned-sexpr-list4
                (macro-spanned-symbol-id (ci.intern "spmd-compact") span)
                (reader.spanned-sexpr-list2 srange sslot span)
                skeep
                sbody
                span)))])]
    [(SpmdBroadcast value-id lane-id)
      (macro-child-form2-id
        owner
        (ci.intern "spmd-broadcast")
        value-id
        lane-id
        span
        origin)]
    [(SpmdShuffle value-id lane-id)
      (macro-child-form2-id
        owner
        (ci.intern "spmd-shuffle")
        value-id
        lane-id
        span
        origin)]
    [(SpmdProgramIndex) (Ok (macro-form0-id (ci.intern "program-index") span))]
    [(SpmdProgramCount) (Ok (macro-form0-id (ci.intern "program-count") span))]
    [(LaneValue value-id)
      (macro-child-form1-id owner (ci.intern "lane-value") value-id span origin)]
    ;; The compiler-private owned-iteration forms keep their operands as
    ;; expression ids. A step's expected type is -1 unless it was written with
    ;; the typed spelling, which takes it as an extra fourth operand.
    [(ForOwnedState payload)
      (macro-expr-list-with-head-symbol-id
        owner
        (ci.intern "__tl_for-owned-state")
        payload
        span
        origin)]
    [(ForOwnedStep payload)
      (if (< (ast.ast-for-owned-payload-get (& payload) 3) 0)
        (macro-expr-list-with-head-symbol-id
          owner
          (ci.intern "__tl_for-owned-step")
          (macro-expr-list-without (& payload) 3)
          span
          origin)
        (macro-expr-list-with-head-symbol-id
          owner
          (ci.intern "__tl_for-owned-step-typed")
          payload
          span
          origin))]))

;; A binder the output declares again -- a loop index, lambda parameter,
;; resource or region name -- spelled with its macro-output source identity,
;; as `let` names are.
(define (macro-binder-symbol
  [owner : (& owner MacroSexprOwner)]
  [name : i64]
  [label : String]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (macro-spanned-symbol-id
    (macro-output-source-identity-id-at (macro-sexpr-session owner) name label)
    span))

;; `(HEAD operand body...)`: `in-arena` and `with-escape`.
(define (macro-operand-body-form
  [owner : (& owner MacroSexprOwner)]
  [head : String]
  [operand-id : i64]
  [body : ast.AstExprList]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [soperand-origin : ast.AstExpr (tc-global-shared-view origin)]
    [soperand : reader.SpannedSexpr
      (try (macro-child-to-spanned-sexpr owner operand-id span soperand-origin))]
    [sbody : reader.SpannedSexpr
      (try (macro-expr-list-to-spanned-sexpr owner body span origin))]
    (Ok
      (reader.spanned-sexpr-list-prepend
        (macro-spanned-symbol-id (ci.intern head) span)
        (reader.spanned-sexpr-list-prepend soperand sbody span)
        span))))

;; `[name : T start end]`, the SPMD and `foreach` range binding.
(define (macro-range-binder-bracket
  [owner : (& owner MacroSexprOwner)]
  [name : i64]
  [label : String]
  [ty : ast.AstType]
  [start-id : i64]
  [end-id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sty-origin : ast.AstExpr (tc-global-shared-view origin)]
    [sty : reader.SpannedSexpr
      (try (macro-type-to-spanned-sexpr owner ty span sty-origin))]
    [sstart-origin : ast.AstExpr (tc-global-shared-view origin)]
    [sstart : reader.SpannedSexpr
      (try (macro-child-to-spanned-sexpr owner start-id span sstart-origin))]
    [send : reader.SpannedSexpr
      (try (macro-child-to-spanned-sexpr owner end-id span origin))]
    (Ok
      (reader.spanned-sexpr-bracket-list
        (reader.spanned-sexpr-list-from-builder
          (reader.spanned-sexpr-builder-push
            (reader.spanned-sexpr-builder-push
              (reader.spanned-sexpr-builder-push
                (reader.spanned-sexpr-builder-push
                  (reader.spanned-sexpr-builder-push
                    (reader.spanned-sexpr-builder-new)
                    (macro-binder-symbol owner name label span))
                  (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span))
                sty)
              sstart)
            send)
          span)
        span))))

;; `[name : T init]`, the SPMD scan prefix and compact slot binding.
(define (macro-state-binder-bracket
  [owner : (& owner MacroSexprOwner)]
  [name : i64]
  [label : String]
  [ty : ast.AstType]
  [init-id : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (let
    [sty-origin : ast.AstExpr (tc-global-shared-view origin)]
    [sty : reader.SpannedSexpr
      (try (macro-type-to-spanned-sexpr owner ty span sty-origin))]
    [sinit : reader.SpannedSexpr
      (try (macro-child-to-spanned-sexpr owner init-id span origin))]
    (Ok
      (reader.spanned-sexpr-bracket-list
        (reader.spanned-sexpr-list4
          (macro-binder-symbol owner name label span)
          (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe ":") span)
          sty
          sinit
          span)
        span))))

(define (macro-reduce-op-symbol
  [op : ast.AstReduceOp]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (macro-spanned-symbol-id
    (match op
      [(Sum) (cbi.compiler-builtin-ctfe "sum")]
      [(Min) (cbi.compiler-builtin-ctfe "min")]
      [(Max) (cbi.compiler-builtin-ctfe "max")]
      [(All) (cbi.compiler-builtin-ctfe "all")]
      [(Any) (cbi.compiler-builtin-ctfe "any")])
    span))

;; `([name init cleanup] ...)`, a `with` binding list.
(define (macro-resource-bindings-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-id cleanup-id move-aware?)
        ;; A move-aware scope (`expr-resource-scope ... true`) disarms its
        ;; cleanup when the resource moves. Declaration syntax has no spelling
        ;; for that, and a plain `with` would run the cleanup anyway.
        (if move-aware?
          (begin
            (reader.spanned-sexpr-builder-discard! builder)
            (Err
              (box
                (macro-output-syntax-diag
                  origin
                  "typecheck: module macro output contains a move-aware resource scope, which declaration syntax cannot spell"))))
          (match (macro-child-to-spanned-sexpr
            owner
            init-id
            span
            (tc-global-shared-view origin))
            [(Err diag)
              (reader.spanned-sexpr-builder-discard! builder)
              (Err diag)]
            [(Ok sinit)
              (match (macro-child-to-spanned-sexpr
                owner
                cleanup-id
                span
                (tc-global-shared-view origin))
                [(Err diag)
                  (reader.spanned-sexpr-builder-discard! builder)
                  (Err diag)]
                [(Ok scleanup)
                  (macro-resource-bindings-to-spanned-sexpr
                    owner
                    bindings
                    (+ index 1)
                    span
                    origin
                    (reader.spanned-sexpr-builder-push
                      builder
                      (reader.spanned-sexpr-bracket-list
                        (reader.spanned-sexpr-list3
                          (macro-binder-symbol owner name "with-binding" span)
                          sinit
                          scleanup
                          span)
                        span)))])]))])))

;; `([name : T)] ...)`, a lambda's parameter list. The parser refuses comptime
;; parameters on a lambda, so every parameter is a plain typed one.
(define (macro-lambda-params-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : ast.AstExpr]
  [builder : reader.SpannedSexprBuilder]) : ResultMacroSexpr
  (if (>= index (ast.ast-param-list-len params))
    (Ok (reader.spanned-sexpr-list-from-builder builder span))
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (match (macro-type-to-spanned-sexpr
          owner
          ty
          span
          (tc-global-shared-view origin))
          [(Err diag)
            (reader.spanned-sexpr-builder-discard! builder)
            (Err diag)]
          [(Ok sty)
            (macro-lambda-params-to-spanned-sexpr
              owner
              params
              (+ index 1)
              span
              origin
              (reader.spanned-sexpr-builder-push
                builder
                (reader.spanned-sexpr-bracket-list
                  (reader.spanned-sexpr-list3
                    (macro-binder-symbol owner name "lambda-param" span)
                    (macro-spanned-symbol-id
                      (cbi.compiler-builtin-ctfe ":")
                      span)
                    sty
                    span)
                  span)))])])))

;; `exprs` without the element at `skip`.
(define (macro-expr-list-without
  [exprs : (& exprs ast.AstExprList)]
  [skip : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    [i : i64 0]
    (while (< i exprs.len)
      (if (= i skip)
        unit
        (ast.ast-expr-list-push (&mut out) (ast.ast-expr-list-get exprs i 0)))
      (set! i (+ i 1)))
    out))

(define (macro-expr-to-spanned-sexpr
  [owner : (& owner MacroSexprOwner)]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span
    owner
    expr
    (macro-zero-source-span)
    origin))

(define (macro-parse-decl-sexpr
  [dispatch : sym_i64_env.SymI64Env]
  [form : reader.SpannedSexpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (match (parser.parse-ast-decl-maybe dispatch form)
    [(SomeDecl decl)
      (Ok (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new))))]
    [(Decls decls) (Ok decls)]
    [(NoDecl) (Ok (ast.ast-decl-list-new))]
    [(Err message) (Err (box (macro-output-syntax-diag origin message)))]))

(define (macro-parse-decls-from-one-expr
  [owner : (& owner MacroSexprOwner)]
  [dispatch : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (let
    [mark : i64 (reader.sp-node-pool-len)]
    (match (macro-expr-to-spanned-sexpr
      owner
      expr
      (tc-global-shared-view origin))
      [(Ok form)
        (match (macro-parse-decl-sexpr dispatch form origin)
          [(Ok decls)
            (reader.sp-node-pool-truncate! mark)
            (Ok decls)]
          [(Err diag)
            (reader.sp-node-pool-truncate! mark)
            (Err diag)])]
      [(Err diag)
        (reader.sp-node-pool-truncate! mark)
        (Err diag)])))

(define (macro-parse-decls-from-exprs
  [owner : (& owner MacroSexprOwner)]
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : ast.AstExprList]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (macro-parse-decls-from-exprs-at owner dispatch (& exprs) 0 origin))

(define (macro-parse-decls-from-exprs-at
  [owner : (& owner MacroSexprOwner)]
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (if (>= index exprs.len)
    (Ok (ast.ast-decl-list-new))
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          owner.expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [head-decls
        (try
          (macro-parse-decls-from-expr
            owner
            dispatch
            head-expr
            (tc-global-shared-view origin)))]
      [rest-decls : ast.AstDeclList
        (try
          (macro-parse-decls-from-exprs-at
            owner
            dispatch
            exprs
            (+ index 1)
            origin))]
      (Ok (macro-decl-list-append head-decls rest-decls)))))

(define (macro-parse-decls-from-expr
  [owner : (& owner MacroSexprOwner)]
  [dispatch : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (match (ast.ast-expr-unspan-with-segment-bases owner.expr-bases (& expr))
    [(Begin exprs) (macro-parse-decls-from-exprs owner dispatch exprs origin)]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get owner.expr-bases func-box)]
        (match (ast.ast-expr-unspan-with-segment-bases
          owner.expr-bases
          (& func))
          [(Var name)
            (if (=
              (parser.compiler-parse-dispatch-tag-id
                dispatch
                (macro-output-syntax-id-at
                  (macro-sexpr-session owner)
                  name
                  "parse-call-head"))
              (parser.compiler-parse-tag-expr-begin))
              (macro-parse-decls-from-exprs owner dispatch args origin)
              (macro-parse-decls-from-one-expr owner dispatch expr origin))]
          [_ (macro-parse-decls-from-one-expr owner dispatch expr origin)]))]
    [_ (macro-parse-decls-from-one-expr owner dispatch expr origin)]))

(define (macro-module-decls-from-ctfe-value
  [owner : (& owner MacroSexprOwner)]
  [value : ctfe_support.CompilerCtfeValue]
  [origin : ast.AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(Expr node _)
      (macro-parse-decls-from-expr
        owner
        dispatch
        (ast.ast-expr-segment-bases-get owner.expr-bases node)
        origin)]
    [_
      (Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Module macro transformer did not produce Expr")))]))

(define (macro-decls-from-ctfe-value
  [owner : (& owner MacroSexprOwner)]
  [value : ctfe_support.CompilerCtfeValue]
  [origin : ast.AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(Expr node _)
      (macro-parse-decls-from-expr
        owner
        dispatch
        (ast.ast-expr-segment-bases-get owner.expr-bases node)
        origin)]
    [_
      (Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Decls macro transformer did not produce Expr")))]))

(define (macro-hygiene-ctfe-output
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]
  [value : ctfe_support.CompilerCtfeValue]
  [hygiene : MacroHygieneContext]
  [params : (& params ast.AstMacroParamList)]
  [depth : i64]) : ctfe_support.CompilerCtfeValue
  (match (tc-global-shared-view value)
    [(Expr node produced)
      (macro-hygiene-env-root-begin! state)
      (let
        [expr-bases : i64 (ast.ast-node-pool-context-expr-segment-bases pools)]
        [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases node)]
        [param-env : MacroHygieneEnv
          (macro-hygiene-output-macro-param-env
            (& params)
            0
            (macro-hygiene-env-empty state pools))]
        [output-env : MacroHygieneEnv
          (macro-hygiene-output-decl-env expr param-env)]
        [output-pools : ast.AstNodePoolContext output-env.pools]
        [out : ctfe_support.CompilerCtfeValue
          (Expr
            (macro-hygiene-produced-expr node output-env hygiene depth)
            produced)]
        ;; Hygiene owns every push while the copied tree is being built.
        ;; Publish only at this durable output boundary so declaration and
        ;; expression consumers using legacy global getters see the
        ;; committed root and all of its children.
        (ast.ast-node-pool-context-publish-to-compat! output-pools)
        (macro-hygiene-env-root-finish! state)
        out)]
    [_ value]))

(define (macro-collect-decl-name
  [state : TcMacroState]
  [decl : ast.AstDecl]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl
    [(DefMacro decl-meta name _ _ _)
      (ctfe_support.ctfe-module-macro-export-add-id-for-state!
        (tc-macro-ctfe-state state)
        module-id
        name)
      (tc-name-id-list-add acc name)]
    [(Import decl-meta (Spec (ModuleItem _) _ _ (Some alias) _))
      ;; Selected imports can rename a macro. Include the local spelling in
      ;; the prescan so the call reaches normal symbol-table resolution; a
      ;; selected value/type is harmless here and resolves as a non-macro.
      (tc-name-id-list-add acc alias)]
    [(Unsafe inner-box)
      (macro-collect-decl-name
        state
        (ast.ast-decl-box-shared-view inner-box)
        module-id
        acc)]
    [_ acc]))

;; Index cursor rather than `ast-decl-list-step`: the module arm reads one id
;; out of the row and the other arm hands the row to `macro-collect-decl-name`,
;; so the step result's 144 B and its row copy are both pure overhead.
(define (macro-collect-macro-names-in
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : TcNameIdList acc]
    (while (< index count)
      (match (ast.ast-decl-list-ref-borrowed (& decls) index)
        [(Module _)
          (set!
            cur-module-id
            (ast.ast-decl-list-module-id-at
              (& decls)
              index
              cbi.compiler-builtin-id-fix-empty))]
        [_
          (set!
            out
            (macro-collect-decl-name
              state
              (tc-global-array-element-shared-view
                decl-slots
                (+ decl-offset index))
              cur-module-id
              out))])
      (set! index (+ index 1)))
    out))

(define (macro-collect-macro-names
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [acc : TcNameIdList]) : TcNameIdList
  (macro-collect-macro-names-in
    state
    decls
    cbi.compiler-builtin-id-fix-empty
    acc))

(define (macro-collect-surface-decl-name
  [state : TcMacroState]
  [decl : (& decl cload.CompilerLoadSurfaceDecl)]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl.kind
    [(CompilerLoadSurfaceMacro)
      (let
        [module-id : i64 decl.module]
        [name-id : i64 decl.name]
        (ctfe_support.ctfe-module-macro-export-add-id-for-state!
          (tc-macro-ctfe-state state)
          module-id
          name-id)
        (tc-name-id-list-add acc name-id))]
    [_ acc]))

(define (macro-collect-surface-decl-names
  [state : TcMacroState]
  [decls : cload.CompilerLoadSurfaceDeclList]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [index : i64 0]
    [out : TcNameIdList acc]
    (while (< index (cload.compiler-load-surface-decl-list-count decls))
      (set!
        out
        (macro-collect-surface-decl-name
          state
          (cload.compiler-load-surface-decl-list-borrow-at (& decls) index)
          out))
      (set! index (+ index 1)))
    out))

(define (macro-collect-surface-summary-macro-names
  [state : TcMacroState]
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [index : i64 0]
    [out : TcNameIdList acc]
    (while (< index (cload.compiler-load-surface-summary-list-count summaries))
      (let
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at summaries index)]
        (set! out (macro-collect-surface-decl-names state summary.decls out))
        (set! index (+ index 1))))
    out))

(define (macro-collect-visible-macro-names
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : TcNameIdList
  (macro-collect-surface-summary-macro-names
    state
    (cload.compiler-load-surface-summaries)
    (macro-collect-macro-names state decls (Nil))))

(define (macro-name-set-add-all
  [state : TcMacroState]
  [names : TcNameIdList]
  [set : (&mut set tc_i64_i64_map.Map)]) : unit
  (let
    [cursor : TcNameIdList names]
    (while (not (tc-name-id-list-empty? cursor))
      (if (tc_i64_i64_map.needs-grow? set)
        (in-arena
          (arena.Arena (tc-macro-state-owner-arena state))
          (tc_i64_i64_map.grow! set))
        unit)
      (tc_i64_i64_map.insert-ref! set (tc-name-id-list-head cursor) 1)
      (set! cursor (tc-name-id-list-rest cursor)))))

(define (macro-name-set-rebuild!
  [state : TcMacroState]
  [names : TcNameIdList]
  [set : (&mut set tc_i64_i64_map.Map)]) : unit
  (tc_i64_i64_map.clear-ref! set)
  (macro-name-set-add-all state names set))

(define (macro-ctfe-visible-name-set-add-all
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [cursor : TcNameIdList names]
    (while (not (tc-name-id-list-empty? cursor))
      (ctfe_support.ctfe-visible-macro-name-add-for-state!
        (tc-macro-ctfe-state state)
        (tc-name-id-list-head cursor))
      (set! cursor (tc-name-id-list-rest cursor)))))

(define (macro-expand-set-macro-names!
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [set : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-macro-name-set)]
    (macro-name-set-rebuild! state names (&mut set))
    (tc-macro-walk-set! state macro-expand-macro-name-set set)
    (ctfe_support.ctfe-visible-macro-names-reset-for-state!
      (tc-macro-ctfe-state state))
    (macro-ctfe-visible-name-set-add-all state names)))

(define (macro-expand-set-expr-type-macro-names!
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [set : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-expr-type-macro-name-set)]
    (macro-name-set-rebuild! state names (&mut set))
    (tc-macro-walk-set! state macro-expand-expr-type-macro-name-set set)))

(define (macro-expand-expr-type-macro?
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]) : bool
  (let
    [names : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-expr-type-macro-name-set)]
    (tc_i64_i64_map.contains?
      (& names)
      (csym.compiler-symbol-module-key-id-by-id module-id name-id))))

(define (macro-surface-decl-macro-in-module?
  [decl : (& decl cload.CompilerLoadSurfaceDecl)]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (and
    (= decl.module target-module-id)
    (= decl.name base-id)
    (match decl.kind
      [(CompilerLoadSurfaceMacro) true]
      [_ false])))

(define (macro-surface-decls-macro-in-module?
  [decls : cload.CompilerLoadSurfaceDeclList]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (let
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-decl-list-count decls))
      (if (macro-surface-decl-macro-in-module?
        (cload.compiler-load-surface-decl-list-borrow-at (& decls) index)
        target-module-id
        base-id)
        (return true)
        (set! index (+ index 1))))
    false))

(define (macro-surface-summaries-macro-in-module?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (let
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-summary-list-count summaries))
      (let
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at summaries index)]
        (if (macro-surface-decls-macro-in-module?
          summary.decls
          target-module-id
          base-id)
          (return true)
          (set! index (+ index 1)))))
    false))

(define (macro-surface-macro-in-module?
  [target-module-id : i64]
  [base-id : i64]) : bool
  (macro-surface-summaries-macro-in-module?
    (cload.compiler-load-surface-summaries)
    target-module-id
    base-id))

(define (macro-surface-decls-module-has-macro?
  [decls : cload.CompilerLoadSurfaceDeclList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-decl-list-count decls))
      (let
        [decl : (& decls cload.CompilerLoadSurfaceDecl)
          (cload.compiler-load-surface-decl-list-borrow-at (& decls) index)]
        (if (and
          (= decl.module target-module-id)
          (match decl.kind
            [(CompilerLoadSurfaceMacro) true]
            [_ false]))
          (return true)
          (set! index (+ index 1)))))
    false))

(define (macro-surface-summaries-module-has-macro?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-summary-list-count summaries))
      (let
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at summaries index)]
        (if (macro-surface-decls-module-has-macro?
          summary.decls
          target-module-id)
          (return true)
          (set! index (+ index 1)))))
    false))

(define (macro-surface-module-has-macro? [target-module-id : i64]) : bool
  (macro-surface-summaries-module-has-macro?
    (cload.compiler-load-surface-summaries)
    target-module-id))

(defenum MacroSurfaceCallDeclCacheLookup
  (Miss)
  (Hit MacroMaybeDecl))

(defstruct TcMacroSurfaceCallStateData
  (capacity i64)
  (module-keys (__tl_dyn-array i64))
  (base-keys (__tl_dyn-array i64))
  (values (__tl_dyn-array MacroMaybeDecl))
  (count i64)
  (owner-table-id i64)
  (owner-reset-generation i64)
  (ready bool)
  ;; The surface macro index (see `macro-surface-index-ensure!`): open
  ;; addressing over (module + 1, name), each slot holding the winning
  ;; declaration's position. It stores positions, never values, so it may
  ;; outlive the expansion scratch arena the value cache above may not.
  (index-modules (__tl_dyn-array i64))
  (index-names (__tl_dyn-array i64))
  (index-positions (__tl_dyn-array i64))
  (index-epoch i64)
  (index-count i64)
  (index-session i64)
  (index-table-id i64)
  (index-reset-generation i64))

(define (tc-macro-surface-call-state-new) : TcMacroSurfaceCallStateData
  (TcMacroSurfaceCallStateData
    8192
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array MacroMaybeDecl 0)
    0
    -1
    -1
    false
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    -1
    -1
    -1
    -1
    -1))

(define (tc-macro-surface-call-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroSurfaceCallStateData
    tc-macro-state-slot-surface-call
    (tc-macro-surface-call-state-new)))

(define (tc-macro-surface-call-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    6
    tc-macro-surface-call-state-address-initialize))

(define (tc-macro-surface-call-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroSurfaceCallStateData)
  (tc-state-cell-ptr
    (tc-macro-surface-call-state-address state)
    TcMacroSurfaceCallStateData))

(define (tc-macro-surface-call-state-view [state : TcMacroState]) : (Ptr
    TcMacroSurfaceCallStateData)
  (tc-state-cell-view
    (tc-macro-surface-call-state-address state)
    TcMacroSurfaceCallStateData))

(define (macro-surface-call-decl-cache-reset! [state : TcMacroState]) : unit
  (unsafe
    (set! (deref (tc-macro-surface-call-state-ptr state)).ready false)))

(define (macro-surface-call-decl-cache-ensure! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [cache : (MutPtr TcMacroSurfaceCallStateData)
      (tc-macro-surface-call-state-ptr state)]
    (unsafe
      (if (and
        (deref cache).ready
        (= (deref cache).owner-table-id table-id)
        (= (deref cache).owner-reset-generation reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (let
              [i : i64 0]
              (when
                (= (array-length (deref cache).module-keys) 0)
                (set!
                  (deref cache).module-keys
                  (__tl_make-array i64 (deref cache).capacity))
                (set!
                  (deref cache).base-keys
                  (__tl_make-array i64 (deref cache).capacity))
                (set!
                  (deref cache).values
                  (__tl_make-array MacroMaybeDecl (deref cache).capacity)))
              (while (< i (deref cache).capacity)
                (set! (array-ref (deref cache).module-keys i) 0)
                (set! i (+ i 1)))
              (set! (deref cache).count 0)
              (set! (deref cache).owner-table-id table-id)
              (set! (deref cache).owner-reset-generation reset-generation)
              (set! (deref cache).ready true))))))))

(define (macro-surface-call-decl-cache-bucket [module-id : i64] [base-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) (* base-id 40503)) 8191))

(define (macro-surface-call-decl-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [base-id : i64]) : MacroSurfaceCallDeclCacheLookup
  (let
    [cache : (Ptr TcMacroSurfaceCallStateData)
      (tc-macro-surface-call-state-view state)]
    [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
    [module-key : i64 (+ module-id 1)]
    [base-key : i64 (+ base-id 1)]
    [steps : i64 0]
    [out : MacroSurfaceCallDeclCacheLookup (Miss)]
    [done : bool false]
    (unsafe
      (while (if done
        false
        (< steps (deref cache).capacity))
        (let
          [slot : i64 (array-ref (deref cache).module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (= (array-ref (deref cache).base-keys cursor) base-key))
              (begin
                (set!
                  out
                  (Hit
                    (tc-global-array-element-shared-view
                      (deref cache).values
                      cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and (+ cursor 1) (- (deref cache).capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-surface-call-decl-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [base-id : i64]
  [value : MacroMaybeDecl]) : unit
  (let
    [cache : (MutPtr TcMacroSurfaceCallStateData)
      (tc-macro-surface-call-state-ptr state)]
    (unsafe
      (if (>= (* (deref cache).count 2) (deref cache).capacity)
        unit
        (let
          [cursor : i64
            (macro-surface-call-decl-cache-bucket module-id base-id)]
          [module-key : i64 (+ module-id 1)]
          [base-key : i64 (+ base-id 1)]
          [steps : i64 0]
          [done : bool false]
          (while (if done
            false
            (< steps (deref cache).capacity))
            (let
              [slot : i64 (array-ref (deref cache).module-keys cursor)]
              (if (= slot 0)
                (begin
                  (set! (array-ref (deref cache).module-keys cursor) module-key)
                  (set! (array-ref (deref cache).base-keys cursor) base-key)
                  (set! (array-ref (deref cache).values cursor) value)
                  (set! (deref cache).count (+ (deref cache).count 1))
                  (set! done true))
                (if (and
                  (= slot module-key)
                  (= (array-ref (deref cache).base-keys cursor) base-key))
                  (begin
                    (set! (array-ref (deref cache).values cursor) value)
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and (+ cursor 1) (- (deref cache).capacity 1)))
                    (set! steps (+ steps 1))))))))))))

(define (macro-surface-decl-call-decl-in-module
  [expr-bases : i64]
  [state : TcMacroState]
  [decl : (& decl cload.CompilerLoadSurfaceDecl)]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (if (and
    (= decl.module target-module-id)
    (= decl.name base-id)
    (match decl.kind
      [(CompilerLoadSurfaceMacro) true]
      [_ false]))
    (match decl.signature
      [(CompilerLoadSurfaceMacroSignature params ret body-box)
        (tc-lazy-import-summary-macro-force-record-for-state! state)
        (Some
          decl.name
          decl.module
          -1
          (clone params)
          (clone ret)
          (ast.ast-expr-segment-bases-get expr-bases body-box))]
      [_ (No)])
    (No)))

;; The surface macro index answers `macro-surface-summaries-call-decl-in-module`
;; without its per-lookup walk over every declaration of every loaded summary,
;; which the value cache below cannot absorb: that cache dies at every splice
;; (its values live in the expansion scratch arena), so each declaration that
;; names a macro paid one full walk per distinct macro it used.
;;
;; The walk returned the first declaration matching (module, name) that is a
;; macro with a macro signature, visiting summaries newest first and each
;; summary's declarations in source order. The index records exactly that
;; winner: it visits physical summaries oldest to newest and declarations in
;; reverse source order, letting every later visit overwrite. A slot packs the
;; summary's physical index above bit 32 and the declaration index below it.
;;
;; The index is valid for one summary list. Appends keep every physical index,
;; so a longer list from the same session at the same epoch only needs its new
;; summaries visited; `compiler-load-surface-summaries-epoch` moves on every
;; reset or removal, which forces a rebuild. Names are intern ids, so the
;; source-name table identity is part of the key as well.
(define (macro-surface-index-decl-indexable?
  [decl : (& decl cload.CompilerLoadSurfaceDecl)]) : bool
  (and
    (match decl.kind
      [(CompilerLoadSurfaceMacro) true]
      [_ false])
    (match decl.signature
      [(CompilerLoadSurfaceMacroSignature _ _ _) true]
      [_ false])))

(define (macro-surface-index-slot [mask : i64] [module-key : i64] [name : i64]) : i64
  (bit-and
    (bit-xor
      (* module-key -7046029254386353131)
      (* (+ name 1) 1442695040888963407))
    mask))

;; Insert or overwrite (module, name) -> position. The table is sized to at
;; least twice the macro declarations it can hold, so a free slot always ends
;; the probe.
(define (macro-surface-index-put!
  [cache : (MutPtr TcMacroSurfaceCallStateData)]
  [module-id : i64]
  [name : i64]
  [position : i64]) : unit
  (unsafe
    (let
      [mask : i64 (- (array-length (deref cache).index-modules) 1)]
      [module-key : i64 (+ module-id 1)]
      [slot : i64 (macro-surface-index-slot mask module-key name)]
      [done : bool false]
      (while (not done)
        (let
          [present : i64 (array-ref (deref cache).index-modules slot)]
          (cond
            [(= present 0)
              (set! (array-ref (deref cache).index-modules slot) module-key)
              (set! (array-ref (deref cache).index-names slot) name)
              (set! (array-ref (deref cache).index-positions slot) position)
              (set! done true)]
            [(and
              (= present module-key)
              (= (array-ref (deref cache).index-names slot) name))
              (set! (array-ref (deref cache).index-positions slot) position)
              (set! done true)]
            [else (set! slot (bit-and (+ slot 1) mask))]))))))

;; Visit physical summaries `[from, to)` oldest first, declarations in reverse.
(define (macro-surface-index-visit!
  [cache : (MutPtr TcMacroSurfaceCallStateData)]
  [summaries : (& summaries cload.CompilerLoadSurfaceSummaryList)]
  [from : i64]
  [to : i64]) : unit
  (let
    [count : i64 (cload.compiler-load-surface-summary-list-count summaries)]
    [physical : i64 from]
    (while (< physical to)
      (let
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at
            summaries
            (- (- count physical) 1))]
        [decls : cload.CompilerLoadSurfaceDeclList summary.decls]
        [index : i64 (cload.compiler-load-surface-decl-list-count (& decls))]
        (while (> index 0)
          (set! index (- index 1))
          (let
            [decl : (& decls cload.CompilerLoadSurfaceDecl)
              (cload.compiler-load-surface-decl-list-borrow-at (& decls) index)]
            (when
              (macro-surface-index-decl-indexable? decl)
              (macro-surface-index-put!
                cache
                decl.module
                decl.name
                (+ (* physical 4294967296) index))))))
      (set! physical (+ physical 1)))))

;; The macro declarations of `summaries`, counted to size the table.
(define (macro-surface-index-macro-count
  [summaries : (& summaries cload.CompilerLoadSurfaceSummaryList)]) : i64
  (let
    [count : i64 (cload.compiler-load-surface-summary-list-count summaries)]
    [total : i64 0]
    [index : i64 0]
    (while (< index count)
      (let
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at summaries index)]
        [decls : cload.CompilerLoadSurfaceDeclList summary.decls]
        [decl-index : i64 0]
        (while (<
          decl-index
          (cload.compiler-load-surface-decl-list-count (& decls)))
          (when
            (macro-surface-index-decl-indexable?
              (cload.compiler-load-surface-decl-list-borrow-at
                (& decls)
                decl-index))
            (set! total (+ total 1)))
          (set! decl-index (+ decl-index 1))))
      (set! index (+ index 1)))
    total))

(define (macro-surface-index-ensure!
  [state : TcMacroState]
  [summaries : (& summaries cload.CompilerLoadSurfaceSummaryList)]) : unit
  (let
    [cache : (MutPtr TcMacroSurfaceCallStateData)
      (tc-macro-surface-call-state-ptr state)]
    [count : i64 (cload.compiler-load-surface-summary-list-count summaries)]
    [epoch : i64 (cload.compiler-load-surface-summaries-epoch-value)]
    [session : i64 (cload.compiler-load-active-session-owner-arena)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (unsafe
      (let
        [same-list : bool
          (and
            (= (deref cache).index-epoch epoch)
            (= (deref cache).index-session session)
            (= (deref cache).index-table-id table-id)
            (= (deref cache).index-reset-generation reset-generation)
            (>= (deref cache).index-count 0)
            (>= count (deref cache).index-count))]
        (unless
          (and same-list (= count (deref cache).index-count))
          (let
            [needed : i64
              (* (+ (macro-surface-index-macro-count summaries) 1) 2)]
            [capacity : i64 64]
            (while (< capacity needed)
              (set! capacity (* capacity 2)))
            (if (and
              same-list
              (>= (array-length (deref cache).index-modules) capacity))
              ;; Appends only: visit the new summaries over the kept table.
              (macro-surface-index-visit!
                cache
                summaries
                (deref cache).index-count
                count)
              (begin
                (if (>= (array-length (deref cache).index-modules) capacity)
                  (let
                    [slot : i64 0]
                    (while (< slot (array-length (deref cache).index-modules))
                      (set! (array-ref (deref cache).index-modules slot) 0)
                      (set! slot (+ slot 1))))
                  (in-arena
                    (arena.Arena (tc-macro-state-owner-arena state))
                    (set!
                      (deref cache).index-modules
                      (__tl_make-array i64 capacity))
                    (set!
                      (deref cache).index-names
                      (__tl_make-array i64 capacity))
                    (set!
                      (deref cache).index-positions
                      (__tl_make-array i64 capacity))))
                (macro-surface-index-visit! cache summaries 0 count)))
            (set! (deref cache).index-epoch epoch)
            (set! (deref cache).index-count count)
            (set! (deref cache).index-session session)
            (set! (deref cache).index-table-id table-id)
            (set! (deref cache).index-reset-generation reset-generation)))))))

;; The winning position for (module, name), or -1.
(define (macro-surface-index-get
  [state : TcMacroState]
  [module-id : i64]
  [name : i64]) : i64
  (let
    [cache : (Ptr TcMacroSurfaceCallStateData)
      (tc-macro-surface-call-state-view state)]
    (unsafe
      (let
        [mask : i64 (- (array-length (deref cache).index-modules) 1)]
        [module-key : i64 (+ module-id 1)]
        [slot : i64 (macro-surface-index-slot mask module-key name)]
        [found : i64 -1]
        [done : bool false]
        (while (not done)
          (let
            [present : i64 (array-ref (deref cache).index-modules slot)]
            (cond
              [(= present 0) (set! done true)]
              [(and
                (= present module-key)
                (= (array-ref (deref cache).index-names slot) name))
                (set! found (array-ref (deref cache).index-positions slot))
                (set! done true)]
              [else (set! slot (bit-and (+ slot 1) mask))])))
        found))))

(define (macro-surface-summaries-call-decl-in-module
  [expr-bases : i64]
  [state : TcMacroState]
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (macro-surface-index-ensure! state (& summaries))
  (let
    [position : i64 (macro-surface-index-get state target-module-id base-id)]
    (if (< position 0)
      (No)
      (let
        [count : i64
          (cload.compiler-load-surface-summary-list-count (& summaries))]
        [physical : i64 (shr position 32)]
        [decl-index : i64 (bit-and position 4294967295)]
        [summary : cload.CompilerLoadSurfaceSummary
          (cload.compiler-load-surface-summary-list-at
            summaries
            (- (- count physical) 1))]
        [decls : cload.CompilerLoadSurfaceDeclList summary.decls]
        (macro-surface-decl-call-decl-in-module
          expr-bases
          state
          (cload.compiler-load-surface-decl-list-borrow-at (& decls) decl-index)
          target-module-id
          base-id)))))

(define (macro-surface-call-decl-fill-in-module
  [expr-bases : i64]
  [state : TcMacroState]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (let
    [result : MacroMaybeDecl
      (match (macro-surface-summaries-call-decl-in-module
        expr-bases
        state
        (cload.compiler-load-surface-summaries)
        target-module-id
        base-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Some macro-name def-module declaration-id params ret body)]
        [(No) (No)])]
    (macro-surface-call-decl-cache-put!
      state
      target-module-id
      base-id
      (tc-global-shared-view result))
    result))

;; R3-P2 hardening of R3-P1's residual hazard class (its section 6.1: "a
;; per-declaration ambient arena turns every allocate-into-whatever-arena-is-
;; current cache into a use-after-free").
;;
;; This is a VALUE cache: rebuilding `MacroMaybeDecl.Some` heap-copies the enum
;; payload into whatever arena is current -- the struct-assignment variant of
;; the grow-while-transient hazard documented in `compiler_ast_types.tl`
;; ("assigning a struct value heap-copies it in the current arena"). The cache
;; is cleared at EVERY splice by `macro-alias-derived-cache-reset!` and refilled
;; from inside the next declaration's expansion, which under R3-P1 runs in that
;; declaration's generation; the entry then outlives its arena while the cache
;; keeps handing it out. Nothing on the current workload reads a stale entry
;; late enough to fault, so this is a latent defect rather than an observed one.
;;
;; Same owner and same argument as R3-P1's `macro-flat-import-targets` fix: the
;; macro-expansion scratch arena, whose lifetime is exactly this cache's --
;; `macro-expand-scratch-clear-owned-caches!` runs the reset immediately before
;; that arena is destroyed. The payloads the entry points at (`params`, `ret`,
;; `body`, the name strings) are owned by the load surface summaries and are
;; untouched; only the enum cell moves. Redirected only while a generation is
;; live, so every non-generational caller keeps its existing owner.
(define (macro-surface-call-decl-in-module
  [expr-bases : i64]
  [state : TcMacroState]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (macro-surface-call-decl-cache-ensure! state)
  (match (macro-surface-call-decl-cache-get state target-module-id base-id)
    [(Hit cached) cached]
    [(Miss)
      (if (not (macro-generation-any-live? state))
        (macro-surface-call-decl-fill-in-module
          expr-bases
          state
          target-module-id
          base-id)
        (in-arena
          (arena.Arena (macro-expand-scratch-arena-get state))
          (macro-surface-call-decl-fill-in-module
            expr-bases
            state
            target-module-id
            base-id)))]))

;; The comptime reflection helpers a macro body may name, in every spelling the
;; body can reach them by. A transformer naming one has its operands captured
;; with their produced types and binding-clause callees. One walk tests all of
;; them: the walker's shadowing is per name (every binder is recorded, whatever
;; it binds), so "some spelling occurs free" is exactly the disjunction of the
;; per-spelling walks this made one at a time. The spellings are distinct, so
;; the list is consed without `tc-string-list-add`'s membership scan. The newer
;; `expr-binding-clause-init-callee` lists only spellings a body can still
;; reach; source names with `/` are rejected.
(define (macro-expr-type-helper-names) : TcStringList
  (let
    [names : TcStringList Nil]
    (set! names (tc-string-list-cons names "expr-type"))
    (set! names (tc-string-list-cons names "comptime.expr-type"))
    (set! names (tc-string-list-cons names "comptime/expr-type"))
    (set! names (tc-string-list-cons names "stdlib.comptime.expr-type"))
    (set! names (tc-string-list-cons names "stdlib.comptime/expr-type"))
    (set! names (tc-string-list-cons names "stdlib/comptime.expr-type"))
    (set! names (tc-string-list-cons names "stdlib/comptime/expr-type"))
    (set! names (tc-string-list-cons names "expr-string?"))
    (set! names (tc-string-list-cons names "comptime.expr-string?"))
    (set! names (tc-string-list-cons names "comptime/expr-string?"))
    (set! names (tc-string-list-cons names "stdlib.comptime.expr-string?"))
    (set! names (tc-string-list-cons names "stdlib.comptime/expr-string?"))
    (set! names (tc-string-list-cons names "stdlib/comptime.expr-string?"))
    (set! names (tc-string-list-cons names "expr-string-value"))
    (set! names (tc-string-list-cons names "comptime.expr-string-value"))
    (set! names (tc-string-list-cons names "comptime/expr-string-value"))
    (set! names (tc-string-list-cons names "stdlib.comptime.expr-string-value"))
    (set! names (tc-string-list-cons names "stdlib.comptime/expr-string-value"))
    (set! names (tc-string-list-cons names "stdlib/comptime.expr-string-value"))
    (set! names (tc-string-list-cons names "string-slice"))
    (set! names (tc-string-list-cons names "comptime.string-slice"))
    (set! names (tc-string-list-cons names "comptime/string-slice"))
    (set! names (tc-string-list-cons names "stdlib.comptime.string-slice"))
    (set! names (tc-string-list-cons names "stdlib.comptime/string-slice"))
    (set! names (tc-string-list-cons names "stdlib/comptime.string-slice"))
    (set! names (tc-string-list-cons names "expr-binding-clause-init-callee"))
    (set!
      names
      (tc-string-list-cons names "comptime.expr-binding-clause-init-callee"))
    (set!
      names
      (tc-string-list-cons
        names
        "stdlib.comptime.expr-binding-clause-init-callee"))
    names))

(define (macro-expr-uses-expr-type? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (tc-expr-uses-free-names?
    expr-bases
    expr
    (macro-expr-type-helper-names)
    Nil
    false))

(define (macro-collect-expr-type-decl-name
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl
    [(DefMacro decl-meta name _ _ body-box)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (if (macro-expr-uses-expr-type? expr-bases body)
          (tc-name-id-list-add
            acc
            (csym.compiler-symbol-module-key-id-by-id module-id name))
          acc))]
    [(Unsafe inner-box)
      (macro-collect-expr-type-decl-name
        expr-bases
        (ast.ast-decl-box-shared-view inner-box)
        module-id
        acc)]
    [_ acc]))

(define (macro-collect-expr-type-macro-names-in
  [expr-bases : i64]
  [decls : (& decls ast.AstDeclList)]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  ;; Index cursor rather than `ast-decl-list-step`, as in
  ;; `macro-collect-macro-names`.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : TcNameIdList acc]
    (while (< index count)
      (match (ast.ast-decl-list-ref-borrowed (& decls) index)
        [(Module _)
          (set!
            cur-module-id
            (ast.ast-decl-list-module-id-at
              (& decls)
              index
              cbi.compiler-builtin-id-fix-empty))]
        [_
          (set!
            out
            (macro-collect-expr-type-decl-name
              expr-bases
              (tc-global-array-element-shared-view
                decl-slots
                (+ decl-offset index))
              cur-module-id
              out))])
      (set! index (+ index 1)))
    out))

(define (macro-collect-expr-type-macro-names
  [expr-bases : i64]
  [decls : (& decls ast.AstDeclList)]) : TcNameIdList
  (macro-collect-expr-type-macro-names-in
    expr-bases
    decls
    cbi.compiler-builtin-id-fix-empty
    Nil))

(define (macro-hygiene-global-id
  [session : cis.InternStructuralSessionHandle]
  [module-id : i64]
  [source-name-id : i64]
  [legacy? : bool]) : i64
  (cis.intern-macro-global-identity-raw
    (cis.intern-structural-session-macro-global-identity
      session
      (if legacy?
        Legacy
        Context)
      module-id
      source-name-id)))

(define (macro-hygiene-definition-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (and
    (>= name-id (ci.intern-structural-key-base))
    (=
      (cis.intern-structural-session-record-kind-for-structural-or
        session
        name-id
        -1)
      (ci.intern-structural-kind-macro-definition))))

;; Classify an already-decoded structural record without revalidating its key.
;; Macro locals additionally prove that their definition lane names a definition
;; record in the same explicit session.
(define (macro-hygiene-record-source-name-id-or
  [session : cis.InternStructuralSessionHandle]
  [record : cis.InternStructuralRecord]
  [fallback : i64]) : i64
  (cond
    [(and
        (= record.kind (ci.intern-structural-kind-template-source))
        (= record.left-id 0)
        (= record.middle-id 0)
        (>= record.right-id 0)
        (<
          record.right-id
          (ci.intern-source-name-session-handle-capacity
            (cis.intern-structural-session-handle-source-names session))))
      record.right-id]
    [(and
        (= record.kind (ci.intern-structural-kind-fresh-local))
        (>= record.left-id 0)
        (= record.middle-id 0)
        (>= record.right-id 0)
        (<
          record.right-id
          (ci.intern-source-name-session-handle-capacity
            (cis.intern-structural-session-handle-source-names session))))
      record.right-id]
    [(and
        (= record.kind (ci.intern-structural-kind-macro-global))
        (or (= record.left-id 0) (= record.left-id 1)))
      record.right-id]
    [(and
        (= record.kind (ci.intern-structural-kind-macro-local))
        (macro-hygiene-definition-id? session record.left-id))
      record.right-id]
    [else fallback]))

(define (macro-hygiene-source-name-id-or
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [fallback : i64]) : i64
  (if (< name-id (ci.intern-structural-key-base))
    fallback
    (match (cis.intern-structural-session-record-for-raw session name-id)
      [(Some record)
        (macro-hygiene-record-source-name-id-or session record fallback)]
      [(No) fallback])))

(define (macro-hygiene-global-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (and
    (>= name-id (ci.intern-structural-key-base))
    (=
      (cis.intern-structural-session-record-kind-for-structural-or
        session
        name-id
        -1)
      (ci.intern-structural-kind-macro-global))))

(define (macro-hygiene-global-legacy-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (< name-id (ci.intern-structural-key-base))
    false
    (match (cis.intern-structural-session-macro-global-record-for-raw
      session
      name-id)
      [(No) false]
      [(Some record)
        (match record.role
          [(Legacy) true]
          [(Context) false])])))

;; Does the macro-hygiene global `name-id` name a binding the macro's
;; definition site resolved into a module other than the runtime prelude and
;; stdlib.string? Hygiene records `m.f`, and a bare `f` bound at the definition
;; site, as (owner module, `f`), so the bare spelling alone would read as a
;; builtin or string helper. Only those two modules own the definitions that
;; builtin spellings name; any other owner's `f` is that module's function.
(define (macro-hygiene-global-user-binding-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (< name-id (ci.intern-structural-key-base))
    false
    (match (cis.intern-structural-session-macro-global-record-for-raw
      session
      name-id)
      [(No) false]
      [(Some record)
        (match record.role
          [(Legacy) false]
          [(Context)
            (not
              (or
                (=
                  record.definition-module-id
                  cbi.compiler-builtin-id-runtime-module)
                (=
                  record.definition-module-id
                  cbi.compiler-builtin-id-fix-stdlib_dot_string)))])])))

(define (macro-hygiene-global-module-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (match (cis.intern-structural-session-macro-global-record-for-raw
    session
    name-id)
    [(No)
      (io.panic
        "typecheck: expected hygienic global identity for module decode")]
    [(Some record) record.definition-module-id]))

;; Hygienic locals are namespaced by the macro that produced them. That
;; namespace must be a *stable* property of the macro itself: the identical
;; macro is re-expanded for every import of a generated module whose parameter
;; list disables the content-addressed memo shortcut (a syntax parameter --
;; see macro-generated-identity-shortcut-safe-params?), and
;; macro-generated-target-replay then compares the fresh body against the
;; already-materialized one declaration by declaration. The macro's dense
;; symbol declaration id is *not* stable across that window: splicing a
;; generated module into the program declaration list re-indexes every
;; declaration after the splice point, so the same `defmacro` answers to
;; different dense ids at two expansions and the two bodies disagree on nothing
;; but their renamed locals. Deriving the namespace from the macro's owning
;; module and name -- the encoding lazy surface macros have always used --
;; keeps the renaming a pure function of (macro, depth, source name).
(define (macro-hygiene-local-id
  [session : cis.InternStructuralSessionHandle]
  [hygiene : MacroHygieneContext]
  [depth : i64]
  [source-name-id : i64]) : i64
  (let
    [definition : cis.InternMacroDefinitionIdentity
      (cis.intern-structural-session-macro-definition-identity
        session
        hygiene.definition-module-id
        hygiene.macro-name-id)]
    (cis.intern-macro-local-identity-raw
      (cis.intern-structural-session-macro-local-identity
        session
        definition
        depth
        source-name-id))))

(define (macro-hygiene-local-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (and
    (>= name-id (ci.intern-structural-key-base))
    (=
      (cis.intern-structural-session-record-kind-for-structural-or
        session
        name-id
        -1)
      (ci.intern-structural-kind-macro-local))))

(define (macro-hygiene-structural-source-name-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (let
    [source-id : i64 (macro-hygiene-source-name-id-or session name-id -1)]
    (if (>= source-id 0)
      source-id
      (io.panic "typecheck: expected hygienic identity for source-name decode"))))

(define (macro-hygiene-global-source-name-id-or
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [fallback : i64]) : i64
  ;; Ids inside the intern pool range are the common case and can never be
  ;; structural/hygiene ids (every structural family's base is >= stride^2),
  ;; so dispatch on the pool range first and keep the layered predicate
  ;; checks for the out-of-pool families only.
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (if (and
      (ci.intern-qualified? name-id)
      (ci.intern-macro-global-name-id? name-id))
      (ci.intern-qualified-base-id name-id)
      fallback)
    (cond
      [(>= name-id (ci.intern-structural-key-base))
        (cis.intern-structural-session-syntax-source-name-id-or
          session
          name-id
          fallback)]
      [else fallback])))

(define (macro-hygiene-env-bind-kind) : i64
  0)

(define (macro-hygiene-env-pattern-name-kind) : i64
  1)

;; A nested Module-macro import exposes its flat output surface only after this
;; hygiene walk. Mark that deferred output scope so incidental definition-site
;; names do not capture the generated module's imported bare references.
(define (macro-hygiene-env-output-flat-import-kind) : i64
  2)

(define (macro-hygiene-env-kind-mask) : i64
  3)

(define (macro-hygiene-env-output-flat-import-flag) : i64
  4)

(define (macro-hygiene-env-empty
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]) : MacroHygieneEnv
  (MacroHygieneEnv -1 state pools))

(define (macro-hygiene-env-head [env : MacroHygieneEnv]) : i64
  env.head)

(define (macro-hygiene-env-reset! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-hygiene-env-slot-count 0))

(define (macro-hygiene-env-storage-retire! [state : TcMacroState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcMacroWalkStateData) (tc-macro-walk-state-ptr state)]
      [storage : i64 (deref data).macro-hygiene-env-storage-arena]
      (unless
        (= (deref data).macro-hygiene-env-root-depth 0)
        (io.panic "typecheck: cannot retire an active macro hygiene owner"))
      (set! (deref data).macro-hygiene-env-kinds (__tl_make-array i64 0))
      (set! (deref data).macro-hygiene-env-keys (__tl_make-array i64 0))
      (set! (deref data).macro-hygiene-env-values (__tl_make-array i64 0))
      (set! (deref data).macro-hygiene-env-parents (__tl_make-array i64 0))
      (set! (deref data).macro-hygiene-env-slot-count 0)
      (set! (deref data).macro-hygiene-env-storage-arena 0)
      (if (> storage 0)
        (ast.compiler-arena-retire-protected-owner! storage)
        unit))))

(define (macro-hygiene-env-root-begin! [state : TcMacroState]) : unit
  ;; Transformer evaluation can recursively expand another macro while the
  ;; caller still retains snapshot heads. Reuse slots only at the outermost
  ;; root; nested roots append until their caller has finished.
  (if (= (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
    (macro-hygiene-env-reset! state)
    unit)
  (tc-macro-walk-set!
    state
    macro-hygiene-env-root-depth
    (+ (tc-macro-walk-field state macro-hygiene-env-root-depth) 1)))

(define (macro-hygiene-env-root-finish! [state : TcMacroState]) : unit
  (if (> (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
    (tc-macro-walk-set!
      state
      macro-hygiene-env-root-depth
      (- (tc-macro-walk-field state macro-hygiene-env-root-depth) 1))
    (io.panic "typecheck: macro hygiene root depth underflow")))

(define (macro-hygiene-env-storage-handle [state : TcMacroState]) : i64
  (when
    (= (tc-macro-walk-field state macro-hygiene-env-storage-arena) 0)
    ;; The retained slot table is small (thousands of 32-byte entries in a
    ;; self-compile), so avoid the default arena's larger virtual reservation.
    (tc-macro-walk-set!
      state
      macro-hygiene-env-storage-arena
      (arena.tl_arena_make_small))
    (ast.compiler-arena-debug-protect-never-reset!
      (tc-macro-walk-field state macro-hygiene-env-storage-arena)))
  (tc-macro-walk-field state macro-hygiene-env-storage-arena))

(define (macro-hygiene-env-grow-copy!
  [dst-kinds : (&mut dst-kinds (__tl_dyn-array i64))]
  [dst-keys : (&mut dst-keys (__tl_dyn-array i64))]
  [dst-values : (&mut dst-values (__tl_dyn-array i64))]
  [dst-parents : (&mut dst-parents (__tl_dyn-array i64))]
  [src-kinds : (& src-kinds (__tl_dyn-array i64))]
  [src-keys : (& src-keys (__tl_dyn-array i64))]
  [src-values : (& src-values (__tl_dyn-array i64))]
  [src-parents : (& src-parents (__tl_dyn-array i64))]
  [slot-count : i64]
  [index : i64]) : unit
  (let
    [i : i64 index]
    (while (< i slot-count)
      (set! (array-ref dst-kinds i) (array-ref src-kinds i))
      (set! (array-ref dst-keys i) (array-ref src-keys i))
      (set! (array-ref dst-values i) (array-ref src-values i))
      (set! (array-ref dst-parents i) (array-ref src-parents i))
      (set! i (+ i 1)))))

(define (macro-hygiene-env-ensure-capacity! [state : TcMacroState]) : unit
  (let
    [slot-count : i64 (tc-macro-walk-field state macro-hygiene-env-slot-count)]
    [old-kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [old-keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [old-values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [old-parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    (if (< slot-count (array-length old-keys))
      unit
      (let
        [old-capacity : i64 (array-length old-keys)]
        [next-capacity : i64
          (if (< old-capacity 1)
            64
            (* old-capacity 2))]
        [storage : i64 (macro-hygiene-env-storage-handle state)]
        ;; Snapshots can cross every scratch rewind involved in an expansion.
        ;; The stable storage root remains valid across physical chain growth.
        (in-arena
          (arena.Arena storage)
          (let
            [next-kinds : (__tl_dyn-array i64)
              (__tl_make-array i64 next-capacity)]
            [next-keys : (__tl_dyn-array i64)
              (__tl_make-array i64 next-capacity)]
            [next-values : (__tl_dyn-array i64)
              (__tl_make-array i64 next-capacity)]
            [next-parents : (__tl_dyn-array i64)
              (__tl_make-array i64 next-capacity)]
            (macro-hygiene-env-grow-copy!
              (&mut next-kinds)
              (&mut next-keys)
              (&mut next-values)
              (&mut next-parents)
              (& old-kinds)
              (& old-keys)
              (& old-values)
              (& old-parents)
              slot-count
              0)
            (tc-macro-walk-set! state macro-hygiene-env-kinds next-kinds)
            (tc-macro-walk-set! state macro-hygiene-env-keys next-keys)
            (tc-macro-walk-set! state macro-hygiene-env-values next-values)
            (tc-macro-walk-set! state macro-hygiene-env-parents next-parents)))))))

(define (macro-hygiene-env-push
  [kind : i64]
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (let
    [state : TcMacroState env.state]
    [_ensure : unit (macro-hygiene-env-ensure-capacity! state)]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [index : i64 (tc-macro-walk-field state macro-hygiene-env-slot-count)]
    [stored-kind : i64
      (if (or
        (= kind (macro-hygiene-env-output-flat-import-kind))
        (macro-hygiene-env-has-output-flat-import? env))
        (bit-or kind (macro-hygiene-env-output-flat-import-flag))
        kind)]
    (set! (array-ref kinds index) stored-kind)
    (set! (array-ref keys index) key-id)
    (set! (array-ref values index) value-id)
    (set! (array-ref parents index) (macro-hygiene-env-head env))
    (tc-macro-walk-set! state macro-hygiene-env-slot-count (+ index 1))
    (MacroHygieneEnv index state env.pools)))

(define (macro-hygiene-env-lookup [env : MacroHygieneEnv] [name-id : i64]) : MacroMaybeHygieneName
  (let
    [state : TcMacroState env.state]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [cursor : i64 (macro-hygiene-env-head env)]
    (while (>= cursor 0)
      (if (= (array-ref keys cursor) name-id)
        (return (Some (array-ref values cursor)))
        (set! cursor (array-ref parents cursor))))
    (No)))

(define (macro-hygiene-env-lookup-pattern-name
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroMaybeHygieneName
  (let
    [state : TcMacroState env.state]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [cursor : i64 (macro-hygiene-env-head env)]
    (while (>= cursor 0)
      (if (and
        (=
          (bit-and (array-ref kinds cursor) (macro-hygiene-env-kind-mask))
          (macro-hygiene-env-pattern-name-kind))
        (= (array-ref keys cursor) name-id))
        (return (Some (array-ref values cursor)))
        (set! cursor (array-ref parents cursor))))
    (No)))

(define (macro-hygiene-env-has-output-flat-import? [env : MacroHygieneEnv]) : bool
  (let
    [state : TcMacroState env.state]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [head : i64 (macro-hygiene-env-head env)]
    (and
      (>= head 0)
      (not
        (=
          (bit-and
            (array-ref kinds head)
            (macro-hygiene-env-output-flat-import-flag))
          0)))))

(define (macro-hygiene-env-bind-raw
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (macro-hygiene-env-push (macro-hygiene-env-bind-kind) env key-id value-id))

(define (macro-hygiene-env-bind-pattern-name-raw
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (macro-hygiene-env-push
    (macro-hygiene-env-pattern-name-kind)
    env
    key-id
    value-id))

(define (macro-hygiene-env-bind-output-flat-import [env : MacroHygieneEnv]) : MacroHygieneEnv
  (macro-hygiene-env-push (macro-hygiene-env-output-flat-import-kind) env 0 0))

(defmacro (macro-hygiene-env-structural-session [env : Expr]) : cis.InternStructuralSessionHandle
  `(tc-macro-state-structural-session (__tl-project-field-name ,env "state")))

(define (macro-hygiene-output-bind-id [env : MacroHygieneEnv] [name-id : i64]) : MacroHygieneEnv
  (if (cis.intern-structural-session-template-source-id?
    (macro-hygiene-env-structural-session env)
    name-id)
    (let
      [source-name-id : i64
        (cis.intern-structural-session-template-source-name-id-or
          (macro-hygiene-env-structural-session env)
          name-id
          -1)]
      (macro-hygiene-env-bind-raw env name-id source-name-id))
    env))

(define (macro-hygiene-output-pattern-name-id
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroHygieneEnv
  (if (cis.intern-structural-session-template-source-id?
    (macro-hygiene-env-structural-session env)
    name-id)
    (let
      [source-name-id : i64
        (cis.intern-structural-session-template-source-name-id-or
          (macro-hygiene-env-structural-session env)
          name-id
          -1)]
      (macro-hygiene-env-bind-pattern-name-raw env name-id source-name-id))
    env))

(define (macro-hygiene-output-macro-param-env
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param name-id _ _ _)
        (let
          [template-id : i64
            (cis.intern-template-source-identity-raw
              (cis.intern-structural-session-template-source-identity
                (macro-hygiene-env-structural-session env)
                name-id))]
          (macro-hygiene-output-macro-param-env
            params
            (+ index 1)
            (macro-hygiene-env-bind-raw env template-id name-id)))])))

(define (macro-hygiene-output-param-env
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(BracketClause items)
      (if (> items.len 0)
        (match (ast.ast-expr-unspan-with-segment-bases
          expr-bases
          (&
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get (& items) 0 0))))
          [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
          [_ env])
        env)]
    [_ env]))

(define (macro-hygiene-output-param-list-env
  [expr-bases : i64]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-param-list-env
      expr-bases
      items
      (+ index 1)
      (macro-hygiene-output-param-env
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-signature-env
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(Call func-box params)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [with-name : MacroHygieneEnv
          (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
            [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
            [_ env])]
        (macro-hygiene-output-param-list-env expr-bases (& params) 0 with-name))]
    [_ env]))

(define (macro-hygiene-output-declaration-name-env
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases
    (macro-hygiene-expr-segment-bases env)
    (& expr))
    [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(Call func-box _)
      (match (ast.ast-expr-unspan-with-segment-bases
        (macro-hygiene-expr-segment-bases env)
        (& (macro-hygiene-expr-get env func-box)))
        [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-bind-var-expr
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases
    (macro-hygiene-expr-segment-bases env)
    (& expr))
    [(Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [_ env]))

(define (macro-hygiene-output-bind-var-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-bind-var-list-env
      items
      (+ index 1)
      (macro-hygiene-output-bind-var-expr
        (macro-hygiene-expr-get env (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-aggregate-member-env
  [expr : ast.AstExpr]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases
    (macro-hygiene-expr-segment-bases env)
    (& expr))
    [(Var name-id)
      (if pattern-name?
        (macro-hygiene-output-pattern-name-id env name-id)
        (macro-hygiene-output-bind-id env name-id))]
    [(Call func-box _)
      (match (ast.ast-expr-unspan-with-segment-bases
        (macro-hygiene-expr-segment-bases env)
        (& (macro-hygiene-expr-get env func-box)))
        [(Var name-id)
          (let
            [source-id : i64
              (tc-hygiene-template-source-id-or
                (macro-hygiene-env-structural-session env)
                name-id
                name-id)]
            (cond
              [(and
                  (ci.intern-colon-keyword-id? source-id)
                  (string.eq (ci.intern-str source-id) ":lifetimes"))
                (match (ast.ast-expr-unspan-with-segment-bases
                  (macro-hygiene-expr-segment-bases env)
                  (& expr))
                  [(Call _ args)
                    (macro-hygiene-output-bind-var-list-env (& args) 0 env)]
                  [_ env])]
              [(ci.intern-colon-keyword-id? source-id) env]
              [pattern-name? (macro-hygiene-output-pattern-name-id env name-id)]
              [else (macro-hygiene-output-bind-id env name-id)]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-aggregate-member-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-aggregate-member-list-env
      items
      (+ index 1)
      pattern-name?
      (macro-hygiene-output-aggregate-member-env
        (macro-hygiene-expr-get env (ast.ast-expr-list-get items index 0))
        pattern-name?
        env))))

(define (macro-hygiene-output-import-env
  [items : (& items ast.AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (let
    [count : i64 items.len]
    [session : cis.InternStructuralSessionHandle
      (macro-hygiene-env-structural-session env)]
    [with-target : MacroHygieneEnv
      (if (> count 0)
        (match (ast.ast-expr-unspan-with-segment-bases
          (macro-hygiene-expr-segment-bases env)
          (& (macro-hygiene-expr-get env (ast.ast-expr-list-get items 0 0))))
          [(Var target-id) (macro-hygiene-output-bind-id env target-id)]
          [(Call _ _)
            (if (= count 1)
              (macro-hygiene-env-bind-output-flat-import env)
              env)]
          [_ env])
        env)]
    (if (>= count 3)
      (let
        [as-expr : ast.AstExpr
          (macro-hygiene-expr-get
            with-target
            (ast.ast-expr-list-get items (- count 2) 0))]
        [alias-expr : ast.AstExpr
          (macro-hygiene-expr-get
            with-target
            (ast.ast-expr-list-get items (- count 1) 0))]
        (match (ast.ast-expr-unspan-with-segment-bases
          (macro-hygiene-expr-segment-bases env)
          (& as-expr))
          [(Var as-id)
            (if (string.eq
              (ci.intern-str
                (tc-hygiene-template-source-id-or session as-id as-id))
              "as")
              (match (ast.ast-expr-unspan-with-segment-bases
                (macro-hygiene-expr-segment-bases env)
                (& alias-expr))
                [(Var alias-id)
                  (macro-hygiene-output-bind-id
                    (macro-hygiene-output-bind-id with-target as-id)
                    alias-id)]
                [_ with-target])
              with-target)]
          [_ with-target]))
      (if (= count 1)
        (match (ast.ast-expr-unspan-with-segment-bases
          (macro-hygiene-expr-segment-bases env)
          (&
            (macro-hygiene-expr-get
              with-target
              (ast.ast-expr-list-get items 0 0))))
          [(Var target-id)
            (let
              [source-id : i64
                (tc-hygiene-template-source-id-or session target-id target-id)]
              [tail-id : i64 (ci.intern-dotted-tail-id source-id)]
              (if (>= tail-id 0)
                (macro-hygiene-output-bind-id
                  with-target
                  (cis.intern-template-source-identity-raw
                    (cis.intern-structural-session-template-source-identity
                      session
                      tail-id)))
                with-target))]
          [_ with-target])
        with-target))))

(define (macro-hygiene-output-decl-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-decl-list-env
      items
      (+ index 1)
      (macro-hygiene-output-decl-env
        (macro-hygiene-expr-get env (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-decl-env
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases
    (macro-hygiene-expr-segment-bases env)
    (& expr))
    [(or (Begin items) (Unsafe items))
      (macro-hygiene-output-decl-list-env (& items) 0 env)]
    [(Comptime inner-box)
      (macro-hygiene-output-decl-env (macro-hygiene-expr-get env inner-box) env)]
    [(Call func-box args)
      (match (ast.ast-expr-unspan-with-segment-bases
        (macro-hygiene-expr-segment-bases env)
        (& (macro-hygiene-expr-get env func-box)))
        [(Var head-id)
          (let
            [source-head-id : i64
              (tc-hygiene-template-source-id-or
                (macro-hygiene-env-structural-session env)
                head-id
                head-id)]
            [tag : i64
              (parser.compiler-parse-dispatch-tag-id
                (parser.compiler-parse-dispatch-env)
                source-head-id)]
            [count : i64 args.len]
            (cond
              [(= source-head-id (cbi.compiler-builtin-ctfe "begin"))
                (macro-hygiene-output-decl-list-env (& args) 0 env)]
              [(= tag (parser.compiler-parse-tag-decl-module))
                (macro-hygiene-output-decl-list-env (& args) 1 env)]
              [(= tag (parser.compiler-parse-tag-decl-import))
                (macro-hygiene-output-import-env (& args) env)]
              [(= tag (parser.compiler-parse-tag-decl-defenum))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    true
                    (macro-hygiene-output-declaration-name-env
                      (macro-hygiene-expr-get
                        env
                        (ast.ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(= tag (parser.compiler-parse-tag-decl-defstruct))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    false
                    (macro-hygiene-output-declaration-name-env
                      (macro-hygiene-expr-get
                        env
                        (ast.ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(or
                  (= tag (parser.compiler-parse-tag-decl-define))
                  (= tag (parser.compiler-parse-tag-decl-extern))
                  (= tag (parser.compiler-parse-tag-decl-defmacro))
                  (= tag (parser.compiler-parse-tag-decl-defdispatch)))
                (if (> count 0)
                  (macro-hygiene-output-declaration-name-env
                    (macro-hygiene-expr-get
                      env
                      (ast.ast-expr-list-get (& args) 0 0))
                    env)
                  env)]
              [else env]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-binding-owner-module-id-or
  [hygiene : MacroHygieneContext]
  [module-id : i64]
  [source-name-id : i64]
  [fallback : i64]) : i64
  (let
    [lookup-module-id : i64
      (if (csym.compiler-symbol-root-module-id? module-id)
        cbi.compiler-builtin-id-fix-empty
        module-id)]
    [value-handle : i64
      (csym.compiler-symbols-lookup-value-in-module-id-or
        (macro-hygiene-symbols hygiene)
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [type-handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (macro-hygiene-symbols hygiene)
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [macro-handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (macro-hygiene-symbols hygiene)
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [declaration-id : i64
      (cond
        [(csym.compiler-symbols-handle-found? value-handle)
          (csym.compiler-symbol-handle-index value-handle)]
        [(csym.compiler-symbols-handle-found? type-handle)
          (csym.compiler-symbol-handle-index type-handle)]
        [(csym.compiler-symbols-handle-found? macro-handle)
          (csym.compiler-symbol-handle-index macro-handle)]
        [else -1])]
    (if (< declaration-id 0)
      fallback
      (let
        [owner-module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            (macro-hygiene-symbols hygiene)
            declaration-id
            fallback)]
        ;; A prior expansion can add a flat unqualified alias after a root
        ;; macro declaration. It is output scope, not a definition-site capture.
        (if (and
          (csym.compiler-symbol-root-module-id? module-id)
          (>= hygiene.declaration-id 0)
          (> declaration-id hygiene.declaration-id)
          (ci.intern-generated-id-active? owner-module-id))
          fallback
          owner-module-id)))))

(define (macro-hygiene-global-name-id
  [state : TcMacroState]
  [source-name-id : i64]
  [hygiene : MacroHygieneContext]) : i64
  (let
    [definition-module-id : i64 hygiene.definition-module-id]
    [legacy? : bool (= source-name-id hygiene.macro-name-id)]
    [first-dot : i64
      (tc-name-first-dot-id
        (tc-macro-state-structural-session state)
        source-name-id)]
    (if (< first-dot 0)
      (let
        [binding-owner-module-id : i64
          (macro-hygiene-binding-owner-module-id-or
            hygiene
            definition-module-id
            source-name-id
            -2)]
        (if (or legacy? (>= binding-owner-module-id -1))
          (macro-hygiene-global-id
            (tc-macro-state-structural-session state)
            (if legacy?
              definition-module-id
              binding-owner-module-id)
            source-name-id
            legacy?)
          source-name-id))
      (let
        [alias-id : i64 (ci.intern-leading-dot-id source-name-id)]
        [tail-id : i64 (ci.intern-dotted-tail-id source-name-id)]
        [full-module-id : i64 (ci.intern-dotted-prefix-id source-name-id)]
        [final-id : i64 (ci.intern-dotted-final-id source-name-id)]
        [lookup-module-id : i64
          (if (csym.compiler-symbol-root-module-id? definition-module-id)
            cbi.compiler-builtin-id-fix-empty
            definition-module-id)]
        [full-binding-owner-module-id : i64
          (if (or (< full-module-id 0) (< final-id 0))
            -2
            (macro-hygiene-binding-owner-module-id-or
              hygiene
              full-module-id
              final-id
              -2))]
        (if (>= full-binding-owner-module-id -1)
          (macro-hygiene-global-id
            (tc-macro-state-structural-session state)
            full-binding-owner-module-id
            final-id
            false)
          (if (or (< alias-id 0) (< tail-id 0))
            source-name-id
            (match (tc-lazy-import-stub-target-id-for-state
              state
              lookup-module-id
              alias-id)
              [(Some target-module-id)
                (let
                  [binding-owner-module-id : i64
                    (if (<
                      (tc-name-first-dot-id
                        (tc-macro-state-structural-session state)
                        tail-id)
                      0)
                      (macro-hygiene-binding-owner-module-id-or
                        hygiene
                        target-module-id
                        tail-id
                        target-module-id)
                      target-module-id)]
                  (macro-hygiene-global-id
                    (tc-macro-state-structural-session state)
                    binding-owner-module-id
                    tail-id
                    false))]
              [(No)
                ;; `Enum.Variant` names a variant of an enum the macro's module
                ;; sees, wherever the macro is used.
                (let
                  [enum-owner-module-id : i64
                    (if (csym.compiler-symbols-handle-found?
                      (csym.compiler-symbols-lookup-type-in-module-id-or
                        (macro-hygiene-symbols hygiene)
                        lookup-module-id
                        alias-id
                        (csym.compiler-symbols-missing-handle)))
                      (macro-hygiene-binding-owner-module-id-or
                        hygiene
                        definition-module-id
                        alias-id
                        -2)
                      -2)]
                  (if (>= enum-owner-module-id -1)
                    (macro-hygiene-global-id
                      (tc-macro-state-structural-session state)
                      enum-owner-module-id
                      source-name-id
                      false)
                    source-name-id))])))))))

(define (macro-hygiene-rename-var-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (let
    [session : cis.InternStructuralSessionHandle
      (macro-hygiene-env-structural-session env)]
    [template-source-id : i64
      (tc-hygiene-template-source-id-or session name-id -1)]
    [result : i64
      (if (tc-hygiene-template-name-id? session name-id)
        (let
          [name : String (ci.intern-str template-source-id)]
          [base : String
            (if (cis.intern-structural-session-template-source-id?
              session
              name-id)
              name
              (tc-hygiene-template-base name))]
          [syntax-tag : i64
            (parser.compiler-parse-dispatch-tag-id
              (parser.compiler-parse-dispatch-env)
              template-source-id)]
          (match (macro-hygiene-env-lookup env name-id)
            [(Some renamed-id) renamed-id]
            [(No)
              (if (or
                (not (= syntax-tag (parser.compiler-parse-tag-unknown)))
                (= template-source-id cbi.compiler-builtin-id-fix-colon)
                (ci.intern-colon-keyword-id? template-source-id))
                template-source-id
                (let
                  [source-name-id : i64 template-source-id]
                  [leading-id : i64 (ci.intern-leading-dot-id source-name-id)]
                  [renamed-leading-id : i64
                    (if (>= leading-id 0)
                      (match (macro-hygiene-env-lookup
                        env
                        (cis.intern-template-source-identity-raw
                          (cis.intern-structural-session-template-source-identity
                            session
                            leading-id)))
                        [(Some renamed-id) renamed-id]
                        [(No) -1])
                      -1)]
                  (if (>= renamed-leading-id 0)
                    (tc-dotted-name-with-source-id
                      (tc-macro-state-structural-session env.state)
                      renamed-leading-id
                      source-name-id)
                    (begin
                      (when
                        (< source-name-id 0)
                        (io.panic
                          (str_cat.str-cat
                            "typecheck: missing macro template source id: "
                            base)))
                      (if (and
                        (<
                          (tc-name-first-dot-id
                            (tc-macro-state-structural-session env.state)
                            source-name-id)
                          0)
                        (macro-hygiene-env-has-output-flat-import? env))
                        source-name-id
                        (macro-hygiene-global-name-id
                          env.state
                          source-name-id
                          macro-name))))))]))
        name-id)]
    result))

(define (macro-hygiene-bind-name-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [name-id : i64]) : MacroHygieneName
  (let
    [session : cis.InternStructuralSessionHandle
      (macro-hygiene-env-structural-session env)]
    [source-name-id : i64 (tc-hygiene-template-source-id-or session name-id -1)]
    (if (tc-hygiene-template-name-id? session name-id)
      (let
        [renamed-id : i64
          (macro-hygiene-local-id
            (tc-macro-state-structural-session env.state)
            macro-name
            depth
            source-name-id)]
        (when
          (< source-name-id 0)
          (io.panic "typecheck: missing macro template binding source id"))
        (Name renamed-id (macro-hygiene-env-bind-raw env name-id renamed-id)))
      (Name name-id env))))

;; A transformer appends newly constructed syntax after its bound operands and
;; captured source syntax. Hygiene may therefore rewrite a fresh node in place
;; when it has one reachable occurrence, while keeping the copy path for
;; source/captured nodes and DAG nodes reused in multiple lexical contexts.
;;
;; Refcounts are saturated at two. When a second path reaches a node, its whole
;; descendant subgraph is marked shared as well: even a child with one incoming
;; AST edge is observed twice through a shared parent and must not retain the
;; hygiene environment from the first occurrence.
(defstruct TcMacroHygieneProducedStateData
  (active bool)
  (floor i64)
  (limit i64)
  (refcounts (__tl_dyn-array i64)))

(define (tc-macro-hygiene-produced-state-new) : TcMacroHygieneProducedStateData
  (TcMacroHygieneProducedStateData false 0 0 (__tl_make-array i64 0)))

(define (tc-macro-hygiene-produced-state-address-initialize
  [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroHygieneProducedStateData
    tc-macro-state-slot-hygiene-produced
    (tc-macro-hygiene-produced-state-new)))

(define (tc-macro-hygiene-produced-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    7
    tc-macro-hygiene-produced-state-address-initialize))

(define (tc-macro-hygiene-produced-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroHygieneProducedStateData)
  (tc-state-cell-ptr
    (tc-macro-hygiene-produced-state-address state)
    TcMacroHygieneProducedStateData))

(define (tc-macro-hygiene-produced-state-view [state : TcMacroState]) : (Ptr
    TcMacroHygieneProducedStateData)
  (tc-state-cell-view
    (tc-macro-hygiene-produced-state-address state)
    TcMacroHygieneProducedStateData))

(define (tc-macro-hygiene-produced-state-data [state : TcMacroState]) : TcMacroHygieneProducedStateData
  (tc-state-cell-read
    (tc-macro-hygiene-produced-state-address state)
    TcMacroHygieneProducedStateData))

(define (tc-macro-hygiene-produced-state-data-set!
  [state : TcMacroState]
  [data : TcMacroHygieneProducedStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-hygiene-produced-state-address state)
    TcMacroHygieneProducedStateData
    data))

(define (macro-hygiene-produced-eval-start-with-pools!
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]) : unit
  (let
    [produced : (MutPtr TcMacroHygieneProducedStateData)
      (tc-macro-hygiene-produced-state-ptr state)]
    (unsafe
      (set! (deref produced).active false)
      (set! (deref produced).floor (ast.ast-node-pool-context-expr-len pools)))))

(define (macro-hygiene-produced-eval-start!
  [state : TcMacroState]
  [env : (& env ctfe_support.CtfeEnv)]) : unit
  (macro-hygiene-produced-eval-start-with-pools!
    state
    (ctfe_support.ctfe-env-syntax-pool-context env)))

(define (macro-hygiene-produced-refcounts-ensure!
  [state : TcMacroState]
  [needed : i64]) : unit
  (let
    [produced : (MutPtr TcMacroHygieneProducedStateData)
      (tc-macro-hygiene-produced-state-ptr state)]
    (unsafe
      (if (<= needed (array-length (deref produced).refcounts))
        unit
        (let
          [capacity : i64
            (if (= (array-length (deref produced).refcounts) 0)
              1
              (array-length (deref produced).refcounts))]
          (while (< capacity needed)
            (set! capacity (* capacity 2)))
          (in-arena
            (arena.Arena (tc-macro-state-owner-arena state))
            (set! (deref produced).refcounts (__tl_make-array i64 capacity))))))))

(define (macro-hygiene-produced-note-id!
  [produced : (& produced TcMacroHygieneProducedStateData)]
  [expr-bases : i64]
  [expr-id : i64]
  [shared-path? : bool]) : unit
  (let
    [produced : TcMacroHygieneProducedStateData
      (owned_view.compiler-owned-reference-shared-view produced)]
    (if (or (< expr-id produced.floor) (>= expr-id produced.limit))
      unit
      (let
        [index : i64 (- expr-id produced.floor)]
        [old : i64 (array-ref produced.refcounts index)]
        [next : i64
          (if shared-path?
            2
            (if (= old 0)
              1
              2))]
        (unless
          (= old next)
          (set! (array-ref produced.refcounts index) next)
          (macro-hygiene-produced-note-children!
            produced
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases expr-id)
            (= next 2)))))))

(define (macro-hygiene-produced-note-expr-list!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index exprs.len)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        (ast.ast-expr-list-get (& exprs) index 0)
        shared-path?)
      (set! index (+ index 1)))))

(define (macro-hygiene-produced-note-let-bindings!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index (ast.ast-let-binding-list-len (& bindings)))
      (match (ast.ast-let-binding-list-get
        (& bindings)
        index
        (ast.ast-let-binding-fallback))
        [(Binding _ _ init-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            init-box
            shared-path?)])
      (set! index (+ index 1)))))

(define (macro-hygiene-produced-note-arms!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index arms.len)
      (match (ast.ast-match-arm-list-get
        (& arms)
        index
        (ast.ast-match-arm-fallback))
        [(Arm _ body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])
      (set! index (+ index 1)))))

(define (macro-hygiene-produced-note-resource-bindings!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index (ast.ast-resource-binding-list-len (& bindings)))
      (match (ast.ast-resource-binding-list-get
        (& bindings)
        index
        (ast.ast-resource-binding-fallback))
        [(Binding _ init-box cleanup-box _)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            init-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            cleanup-box
            shared-path?)])
      (set! index (+ index 1)))))

(define (macro-hygiene-produced-note-children!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [shared-path? : bool]) : unit
  (match expr
    [(or (Spanned inner-box _) (Unary _ inner-box) (TupleRef inner-box _)
         (FixedMakeArray _ inner-box) (MakeArray _ inner-box) (Set _ inner-box)
         (Ann inner-box _) (Cast inner-box _) (Borrow _ _ inner-box)
         (StructGet inner-box _) (Box inner-box) (BoxGet inner-box)
         (BoxTake inner-box) (Comptime inner-box) (Try inner-box)
         (Return inner-box) (PtrNullCheck inner-box) (PtrAddrOf inner-box)
         (PtrRead inner-box) (PtrCast inner-box _) (PtrToInt inner-box)
         (IntToPtr inner-box _) (StringData inner-box) (ArrayData inner-box)
         (Xgetbv inner-box) (ForeachActive _ inner-box) (LaneValue inner-box))
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    ;; A provenance marker encloses syntax that was already hygienized by the
    ;; expansion which produced it, or caller syntax intentionally captured by
    ;; a later expansion.  It is an ownership boundary for this hygiene pass.
    [(MacroExpansion _ _ _) unit]
    [(or (Binary _ left-box right-box) (ArrayRef left-box right-box)
         (Replace left-box right-box) (ArrayPush left-box right-box)
         (StringRef left-box right-box) (SpmdBroadcast left-box right-box)
         (SpmdShuffle left-box right-box) (StructSet left-box _ right-box)
         (BoxSet left-box right-box) (PtrWrite left-box right-box)
         (PtrOffset left-box right-box) (StringFromBytes left-box right-box)
         (CpuIdEax left-box right-box) (CpuIdEbx left-box right-box)
         (CpuIdEcx left-box right-box) (CpuIdEdx left-box right-box))
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        left-box
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        right-box
        shared-path?)]
    [(or (Call func-box args) (While func-box args) (WithEscape func-box args)
         (InArena func-box args))
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        func-box
        shared-path?)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        args
        shared-path?)]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items) (WithRegion _ items) (WithScratch items)
         (Syscall items))
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        items
        shared-path?)]
    [(or (If cond-box then-box else-box) (ArraySet cond-box then-box else-box)
         (ArrayTake cond-box then-box else-box))
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        cond-box
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        then-box
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        else-box
        shared-path?)]
    [(Let payload)
      (match (__tl-box-place payload)
        [(Let bindings body-box)
          (macro-hygiene-produced-note-let-bindings!
            (tc-global-shared-view produced)
            expr-bases
            bindings
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(Lambda payload)
      (match (__tl-box-place payload)
        [(Lambda _ _ body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(ForOwnedState payload)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        (ast.ast-for-owned-state-source-name (& payload))
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        (ast.ast-for-owned-state-index-name (& payload))
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        (ast.ast-for-owned-state-source (& payload))
        shared-path?)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        (ast.ast-for-owned-state-body (& payload))
        shared-path?)]
    [(ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-step-source-name (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-step-index-name (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-step-binding-name (& payload))
          shared-path?)
        (when
          (>= expected-type 0)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            expected-type
            shared-path?))
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-step-done-name (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-step-body (& payload))
          shared-path?))]
    [(Match payload)
      (match (__tl-box-place payload)
        [(Match scrutinee-box arms)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            scrutinee-box
            shared-path?)
          (macro-hygiene-produced-note-arms!
            produced
            expr-bases
            arms
            shared-path?)])]
    [(Foreach payload)
      (match (__tl-box-place payload)
        [(Foreach _ _ start-box end-box body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            start-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            end-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            a-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            b-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            c-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            d-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(SpmdReduce payload)
      (match (__tl-box-place payload)
        [(Reduce _ _ _ start-box end-box init-box value-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            start-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            end-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            init-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            value-box
            shared-path?)])]
    [(SpmdScan payload)
      (match (__tl-box-place payload)
        [(Scan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            start-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            end-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            init-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            value-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(SpmdCompact payload)
      (match (__tl-box-place payload)
        [(Compact _ _ start-box end-box _ _ init-box keep-box body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            start-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            end-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            init-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            keep-box
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(WithResource payload)
      (match (__tl-box-place payload)
        [(WithResource bindings body)
          (macro-hygiene-produced-note-resource-bindings!
            (tc-global-shared-view produced)
            expr-bases
            bindings
            shared-path?)
          (macro-hygiene-produced-note-expr-list!
            produced
            expr-bases
            body
            shared-path?)])]
    ;; Quote payloads intentionally stay opaque to this hygiene walker.
    [_ unit]))

(define (macro-hygiene-produced-prepare!
  [state : TcMacroState]
  [expr-bases : i64]
  [root-id : i64]) : unit
  (let
    [produced : TcMacroHygieneProducedStateData
      (tc-macro-hygiene-produced-state-data state)]
    (set! produced.limit (ast.ast-node-pool-len))
    (tc-macro-hygiene-produced-state-data-set!
      state
      (tc-global-shared-view produced))
    (if (or (< produced.floor 0) (> produced.floor produced.limit))
      (begin
        (set! produced.active false)
        (tc-macro-hygiene-produced-state-data-set! state produced))
      (let
        [needed : i64 (- produced.limit produced.floor)]
        [index : i64 0]
        (macro-hygiene-produced-refcounts-ensure! state needed)
        (set! produced (tc-macro-hygiene-produced-state-data state))
        (while (< index needed)
          (set! (array-ref produced.refcounts index) 0)
          (set! index (+ index 1)))
        (set! produced.active true)
        (tc-macro-hygiene-produced-state-data-set!
          state
          (tc-global-shared-view produced))
        (macro-hygiene-produced-note-id! produced expr-bases root-id false)))))

(define (macro-hygiene-produced-owned? [state : TcMacroState] [expr-id : i64]) : bool
  (let
    [produced : (Ptr TcMacroHygieneProducedStateData)
      (tc-macro-hygiene-produced-state-view state)]
    (unsafe
      (and
        (deref produced).active
        (>= expr-id (deref produced).floor)
        (< expr-id (deref produced).limit)
        (=
          (array-ref
            (deref produced).refcounts
            (- expr-id (deref produced).floor))
          1)))))

(define (macro-hygiene-expr-list
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    (macro-hygiene-expr-list-into
      expr-bases
      (& exprs)
      0
      env
      macro-name
      depth
      (&mut out))
    out))

(define (macro-hygiene-expr-list-into
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstExprList)]) : unit
  (unless
    (>= index exprs.len)
    (ast.ast-expr-list-push
      out
      (macro-hygiene-expr
        expr-bases
        (ast.ast-expr-list-get exprs index 0)
        env
        macro-name
        depth))
    (macro-hygiene-expr-list-into
      expr-bases
      exprs
      (+ index 1)
      env
      macro-name
      depth
      out)))

(define (macro-hygiene-module-call-args
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    [index : i64 0]
    (while (< index exprs.len)
      (ast.ast-expr-list-push
        (&mut out)
        (if (= index 0)
          (ast.ast-expr-list-get (& exprs) index 0)
          (macro-hygiene-expr
            expr-bases
            (ast.ast-expr-list-get (& exprs) index 0)
            env
            macro-name
            depth)))
      (set! index (+ index 1)))
    out))

(define (macro-hygiene-output-call-env
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Var head-id)
      (let
        [source-head-id : i64
          (tc-hygiene-template-source-id-or
            (macro-hygiene-env-structural-session env)
            head-id
            head-id)]
        [tag : i64
          (parser.compiler-parse-dispatch-tag-id
            (parser.compiler-parse-dispatch-env)
            source-head-id)]
        [count : i64 args.len]
        (cond
          [(= tag (parser.compiler-parse-tag-decl-import))
            (macro-hygiene-output-import-env args env)]
          [(or
              (= tag (parser.compiler-parse-tag-decl-defenum))
              (= tag (parser.compiler-parse-tag-decl-defstruct)))
            (if (> count 0)
              (macro-hygiene-output-aggregate-member-list-env
                args
                1
                (= tag (parser.compiler-parse-tag-decl-defenum))
                (macro-hygiene-output-signature-env
                  expr-bases
                  (ast.ast-expr-segment-bases-get
                    expr-bases
                    (ast.ast-expr-list-get args 0 0))
                  env))
              env)]
          [(or
              (= tag (parser.compiler-parse-tag-decl-define))
              (= tag (parser.compiler-parse-tag-decl-extern))
              (= tag (parser.compiler-parse-tag-decl-defmacro))
              (= tag (parser.compiler-parse-tag-decl-defdispatch)))
            (if (> count 0)
              (macro-hygiene-output-signature-env
                expr-bases
                (ast.ast-expr-segment-bases-get
                  expr-bases
                  (ast.ast-expr-list-get args 0 0))
                env)
              env)]
          [else env]))]
    [_ env]))

(define (macro-hygiene-lifetime-list
  [lifetimes : ast.AstLifetimeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstLifetimeList
  (let
    [count : i64 (ast.ast-lifetime-list-len (& lifetimes))]
    [out : ast.AstLifetimeList (ast.ast-lifetime-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (ast.ast-lifetime-list-push
        (&mut out)
        (macro-hygiene-rename-lifetime-id
          env
          macro-name
          (ast.ast-lifetime-list-get
            (& lifetimes)
            index
            (ast.ast-lifetime-fallback))))
      (set! index (+ index 1)))
    out))

(define (macro-hygiene-rename-lifetime-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (match (macro-hygiene-env-lookup env name-id)
    [(Some renamed-id) renamed-id]
    [(No)
      (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
        (match (macro-hygiene-env-lookup
          env
          (cis.intern-template-source-identity-raw
            (cis.intern-structural-session-template-source-identity
              (macro-hygiene-env-structural-session env)
              name-id)))
          [(Some renamed-id) renamed-id]
          [(No) (macro-hygiene-rename-var-id env macro-name name-id)])
        (macro-hygiene-rename-var-id env macro-name name-id))]))

(define (macro-hygiene-type-list
  [types : ast.AstTypeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstTypeList
  (let
    [count : i64 (ast.ast-type-list-len (& types))]
    [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (ast.ast-type-list-push
        (&mut out)
        (ast.ast-node-pool-context-type-push
          env.pools
          (macro-hygiene-type
            (macro-hygiene-type-get
              env
              (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback)))
            env
            macro-name)))
      (set! index (+ index 1)))
    out))

(define (macro-hygiene-type
  [ty : ast.AstType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (ast.ast-ty-func
        (macro-hygiene-type-list
          (ast.ast-type-list-box-shared-view args)
          env
          macro-name)
        (& (macro-hygiene-type (macro-hygiene-type-get env ret) env macro-name)))]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (macro-hygiene-type-list
          (ast.ast-type-list-box-shared-view elems)
          env
          macro-name))]
    [(Array elem count)
      (ast.ast-ty-array
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name))
        count)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name)))]
    [(Slice elem)
      (ast.ast-ty-slice
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name)))]
    [(Box elem)
      (ast.ast-ty-box
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name)))]
    [(Ptr elem)
      (ast.ast-ty-ptr
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name)))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr
        (&
          (macro-hygiene-type (macro-hygiene-type-get env elem) env macro-name)))]
    [(Ref region inner)
      (ast.ast-ty-ref
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (&
          (macro-hygiene-type (macro-hygiene-type-get env inner) env macro-name)))]
    [(MutRef region inner)
      (ast.ast-ty-mut-ref
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (&
          (macro-hygiene-type (macro-hygiene-type-get env inner) env macro-name)))]
    [(Region region inner)
      (ast.ast-ty-region
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (&
          (macro-hygiene-type (macro-hygiene-type-get env inner) env macro-name)))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        (macro-hygiene-rename-lifetime-id env macro-name lifetime)
        (&
          (macro-hygiene-type (macro-hygiene-type-get env inner) env macro-name)))]
    [(EnumArgs name lifetimes)
      (ast.ast-ty-enum-args
        name
        (macro-hygiene-lifetime-list
          (ast.ast-lifetime-list-box-shared-view lifetimes)
          env
          macro-name))]
    [(StructArgs name lifetimes)
      (ast.ast-ty-struct-args
        name
        (macro-hygiene-lifetime-list
          (ast.ast-lifetime-list-box-shared-view lifetimes)
          env
          macro-name))]
    [(VarArgs name lifetimes)
      (ast.ast-ty-var-args
        name
        (macro-hygiene-lifetime-list
          (ast.ast-lifetime-list-box-shared-view lifetimes)
          env
          macro-name))]
    [_ ty]))

(define (macro-hygiene-maybe-type
  [maybe-ty : ast.AstMaybeType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstMaybeType
  (match maybe-ty
    [(Some ty) (Some (macro-hygiene-type ty env macro-name))]
    [(No) No]))

(define (macro-hygiene-borrow-lifetime
  [lifetime : ast.AstBorrowLifetime]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstBorrowLifetime
  (match lifetime
    [(Named name)
      (Named (macro-hygiene-rename-lifetime-id env macro-name name))]
    [(Inferred) Inferred]))

(define (macro-hygiene-param-list
  [params : ast.AstParamList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (macro-hygiene-param-list-at (& params) 0 env macro-name depth))

(define (macro-hygiene-param-list-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (if (>= index (ast.ast-param-list-len params))
    (Params (ast.ast-param-list-new) env)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty comptime?)
        (let
          [nty : ast.AstType (macro-hygiene-type ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(Name renamed-id next-env)
              (match (macro-hygiene-param-list-at
                params
                (+ index 1)
                next-env
                macro-name
                depth)
                [(Params nrest final-env)
                  (Params
                    (ast.ast-param-cons
                      (& (ast.ast-param-id renamed-id nty comptime?))
                      (& nrest))
                    final-env)])]))])))

(define (macro-hygiene-pattern-list
  [patterns : ast.AstPatternList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-with-capacity patterns.len)]
    [final-env : MacroHygieneEnv
      (macro-hygiene-pattern-list-into
        (& patterns)
        0
        env
        macro-name
        depth
        (&mut out))]
    (PatternList out final-env)))

(define (macro-hygiene-pattern-list-into
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstPatternList)]) : MacroHygieneEnv
  (if (>= index patterns.len)
    env
    (match (macro-hygiene-pattern
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
      env
      macro-name
      depth)
      [(Pattern npattern next-env)
        (ast.ast-pattern-list-push out npattern)
        (macro-hygiene-pattern-list-into
          patterns
          (+ index 1)
          next-env
          macro-name
          depth
          out)])))

(define (macro-hygiene-pattern
  [pattern : ast.AstPattern]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePattern
  (match pattern
    [(Var name maybe-ty)
      (let
        [nmaybe-ty : ast.AstMaybeType
          (macro-hygiene-maybe-type maybe-ty env macro-name)]
        (match (macro-hygiene-bind-name-id env macro-name depth name)
          [(Name renamed-id next-env)
            (Pattern (Var renamed-id nmaybe-ty) next-env)]))]
    [(Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(PatternList npatterns next-env)
            (Pattern (ast.ast-pat-tuple npatterns) next-env)]))]
    [(Array patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(PatternList npatterns next-env)
            (Pattern (ast.ast-pat-array npatterns) next-env)]))]
    [(Slice items-box has-rest)
      (let
        [items : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view items-box)]
        (match (macro-hygiene-pattern-list items env macro-name depth)
          [(PatternList nitems next-env)
            (Pattern (ast.ast-pat-slice nitems has-rest) next-env)]))]
    [(Wildcard) (Pattern Wildcard env)]
    [(Binding name)
      (let
        [source-name-id : i64
          (tc-hygiene-template-source-id-or
            (macro-hygiene-env-structural-session env)
            name
            name)]
        (if (>=
          (tc-name-first-dot-id
            (tc-macro-state-structural-session env.state)
            source-name-id)
          0)
          (Pattern
            (ast.ast-pat-binding-id
              (macro-hygiene-rename-var-id env macro-name name))
            env)
          (match (macro-hygiene-env-lookup-pattern-name env name)
            [(Some pattern-name-id)
              (Pattern (ast.ast-pat-binding-id pattern-name-id) env)]
            [(No)
              (match (macro-hygiene-bind-name-id env macro-name depth name)
                [(Name renamed-id next-env)
                  (Pattern (ast.ast-pat-binding-id renamed-id) next-env)])])))]
    [(Variant name args-box)
      (let
        [args : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view args-box)]
        (match (macro-hygiene-pattern-list args env macro-name depth)
          [(PatternList nargs next-env)
            (Pattern
              (ast.ast-pat-variant-id
                (macro-hygiene-rename-var-id env macro-name name)
                nargs)
              next-env)]))]
    [(ast.AstPattern.Literal lit)
      (MacroHygienePattern.Pattern (ast.AstPattern.Literal lit) env)]
    ;; A binder's renamed id depends only on its template name and depth, so
    ;; every alternative renames a shared binder alike.
    [(ast.AstPattern.Or patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast.ast-pat-or npatterns) next-env)]))]
    [(ast.AstPattern.Fields patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern
              (ast.ast-pat-fields npatterns)
              next-env)]))]
    ;; A field name names a declared struct field, not a binder.
    [(ast.AstPattern.Field name patterns-box)
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern
              (ast.AstPattern.Field name (box npatterns))
              next-env)]))]))

(define (macro-hygiene-let-bindings
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-let-bindings-into
        expr-bases
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (LetBindings out final-env)))

(define (macro-hygiene-let-bindings-into
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : MacroHygieneEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    env
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [ninit : i64
            (macro-hygiene-expr expr-bases init-box env macro-name depth)]
          [nmaybe-ty : ast.AstMaybeType
            (macro-hygiene-maybe-type maybe-ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(Name renamed-id next-env)
              (ast.ast-let-binding-list-push
                out
                (ast.ast-let-binding-id renamed-id nmaybe-ty ninit))
              (macro-hygiene-let-bindings-into
                expr-bases
                bindings
                next-env
                macro-name
                depth
                (+ index 1)
                out)]))])))

(define (macro-hygiene-resource-bindings
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneResourceBindings
  (let
    [out : ast.AstResourceBindingList
      (ast.ast-resource-binding-list-with-capacity
        (ast.ast-resource-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-resource-bindings-into
        expr-bases
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (ResourceBindings out final-env)))

(define (macro-hygiene-resource-bindings-into
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out ast.AstResourceBindingList)]) : MacroHygieneEnv
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    env
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box cleanup-box move-aware?)
        (let
          [ninit : i64
            (macro-hygiene-expr expr-bases init-box env macro-name depth)]
          [ncleanup : i64
            (macro-hygiene-expr expr-bases cleanup-box env macro-name depth)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(Name renamed-id next-env)
              (ast.ast-resource-binding-list-push
                out
                (ast.AstResourceBinding.Binding
                  renamed-id
                  ninit
                  ncleanup
                  move-aware?))
              (macro-hygiene-resource-bindings-into
                expr-bases
                bindings
                next-env
                macro-name
                depth
                (+ index 1)
                out)]))])))

(define (macro-hygiene-arm-list
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstMatchArmList
  (let
    [out : ast.AstMatchArmList (ast.ast-match-arm-list-with-capacity arms.len)]
    (macro-hygiene-arm-list-into
      expr-bases
      (& arms)
      0
      env
      macro-name
      depth
      (&mut out))
    out))

(define (macro-hygiene-arm-list-into
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstMatchArmList)]) : unit
  (if (>= index arms.len)
    unit
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (match (macro-hygiene-pattern pattern env macro-name depth)
          [(Pattern npattern arm-env)
            (ast.ast-match-arm-list-push
              out
              (ast.ast-match-arm
                npattern
                (macro-hygiene-expr
                  expr-bases
                  body-box
                  arm-env
                  macro-name
                  depth)))
            (macro-hygiene-arm-list-into
              expr-bases
              arms
              (+ index 1)
              env
              macro-name
              depth
              out)])])))

;; Profile shim and copy-on-write commit. The inner walker still constructs one
;; replacement node so its exhaustive syntax logic stays shared with captured
;; syntax. For an owned node, immediately move that replacement into the
;; transformer's original slot and rewind the one-node append.
(define (macro-hygiene-expr
  [expr-bases : i64]
  [expr-id : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (let
    [_profile-start : unit
      (cfg compile-profile (compiler-tc-walk-hygiene-start!))]
    [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
    [result : i64
      (macro-hygiene-expr-inner expr-bases expr env macro-name depth)]
    [reuse? : bool
      (and
        (macro-hygiene-produced-owned? env.state expr-id)
        (= (+ result 1) (ast.ast-node-pool-context-expr-len env.pools)))]
    [out : i64
      (if reuse?
        (let
          [replacement : ast.AstExpr (macro-hygiene-expr-get env result)]
          (ast.ast-node-pool-context-expr-set!
            env.pools
            expr-id
            (& replacement))
          (ast.ast-node-pool-context-expr-truncate! env.pools result)
          expr-id)
        result)]
    (begin
      (cfg
        compile-profile
        (if reuse?
          (counters.bump! tc-profile-hygiene-nodes-reused)
          (counters.bump! tc-profile-hygiene-nodes-copied)))
      (cfg compile-profile (compiler-tc-walk-hygiene-finish!))
      out)))

;; Include ownership discovery in the hygiene profile lane, then disable the
;; transient side table before produced-node expansion starts.
(define (macro-hygiene-produced-expr
  [expr-id : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (begin
    (cfg compile-profile (compiler-tc-walk-hygiene-start!))
    (let
      [expr-bases : i64 (macro-hygiene-expr-segment-bases env)]
      [_prepare : unit
        (macro-hygiene-produced-prepare! env.state expr-bases expr-id)]
      [result : i64
        (macro-hygiene-expr expr-bases expr-id env macro-name depth)]
      [produced : (MutPtr TcMacroHygieneProducedStateData)
        (tc-macro-hygiene-produced-state-ptr env.state)]
      (begin
        (unsafe
          (set! (deref produced).active false))
        ;; The recursive walker uses one-node copy-on-write replacements. Keep
        ;; those transient cursors private and publish only the committed root.
        (ast.ast-node-pool-context-publish-to-compat! env.pools)
        (cfg compile-profile (compiler-tc-walk-hygiene-finish!))
        result))))

(define (macro-hygiene-expr-inner
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (match (tc-global-shared-view expr)
    [(Spanned inner-box span)
      (let
        [inner : i64 inner-box]
        [pools : ast.AstNodePoolContext env.pools]
        (ast.ast-expr-spanned-with-pools
          pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          span))]
    ;; Do not apply a later expansion's hygiene environment to syntax behind a
    ;; provenance boundary.  Macro discovery still walks through the marker so
    ;; nested, not-yet-expanded calls can fire in their own hygiene pass.
    [(MacroExpansion _ _ _)
      (ast.ast-node-pool-context-expr-push env.pools expr)]
    [(Var name)
      (macro-hygiene-expr-push
        env
        (ast.AstExpr.Var (macro-hygiene-rename-var-id env macro-name name)))]
    [(Binary op left-box right-box)
      (let
        [left : i64 left-box]
        [right : i64 right-box]
        (ast.ast-expr-binary-with-pools
          env.pools
          op
          (macro-hygiene-expr expr-bases left env macro-name depth)
          (macro-hygiene-expr expr-bases right env macro-name depth)))]
    [(Unary op inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-unary-with-pools
          env.pools
          op
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [call-env : MacroHygieneEnv
          (macro-hygiene-output-call-env
            expr-bases
            (tc-global-shared-view func)
            (& args)
            env)]
        (ast.ast-expr-call-with-pools
          env.pools
          (macro-hygiene-expr expr-bases func-box env macro-name depth)
          (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
            [(Var name-id)
              (if (=
                (tc-hygiene-template-source-id-or
                  (macro-hygiene-env-structural-session env)
                  name-id
                  name-id)
                cbi.compiler-builtin-id-fix-module)
                (macro-hygiene-module-call-args
                  expr-bases
                  args
                  env
                  macro-name
                  depth)
                (macro-hygiene-expr-list
                  expr-bases
                  args
                  call-env
                  macro-name
                  depth))]
            [_
              (macro-hygiene-expr-list
                expr-bases
                args
                call-env
                macro-name
                depth)])))]
    [(BracketClause items)
      (ast.ast-expr-bracket-clause-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases items env macro-name depth))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : i64 cond-box]
        [then-branch : i64 then-branch-box]
        [else-branch : i64 else-branch-box]
        (ast.ast-expr-if-with-pools
          env.pools
          (macro-hygiene-expr expr-bases cond env macro-name depth)
          (macro-hygiene-expr expr-bases then-branch env macro-name depth)
          (macro-hygiene-expr expr-bases else-branch env macro-name depth)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : i64 body-box]
            (match (macro-hygiene-let-bindings
              expr-bases
              bindings
              env
              macro-name
              depth)
              [(LetBindings nbindings body-env)
                (ast.ast-expr-let-with-pools
                  env.pools
                  nbindings
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : i64 body-box]
            (match (macro-hygiene-param-list params env macro-name depth)
              [(Params nparams body-env)
                (ast.ast-expr-lambda-with-pools
                  env.pools
                  nparams
                  (macro-hygiene-maybe-type maybe-ret body-env macro-name)
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))])]
    [(Tuple exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (Tuple (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(TupleRef tuple-expr-box index)
      (let
        [tuple-expr : i64 tuple-expr-box]
        (ast.ast-expr-tuple-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases tuple-expr env macro-name depth)
          index))]
    [(Array exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (Array (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(DynArray exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (DynArray
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(FixedMakeArray ty-id len-box)
      (let
        [len : i64 len-box]
        (ast.ast-expr-fixed-make-array-with-pools
          env.pools
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))
          (macro-hygiene-expr expr-bases len env macro-name depth)))]
    [(MakeArray ty-id len-box)
      (let
        [len : i64 len-box]
        (ast.ast-expr-make-array-with-pools
          env.pools
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))
          (macro-hygiene-expr expr-bases len env macro-name depth)))]
    [(ArrayRef array-box index-box)
      (let
        [array : i64 array-box]
        [index : i64 index-box]
        (ast.ast-expr-array-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : i64 array-box]
        [index : i64 index-box]
        [value : i64 value-box]
        (ast.ast-expr-array-set-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array : i64 array-box]
        [live : i64 live-box]
        [index : i64 index-box]
        (ast.ast-expr-array-take-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases live env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ArrayPush array-box value-box)
      (let
        [array : i64 array-box]
        [value : i64 value-box]
        (ast.ast-expr-array-push-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(StringRef text-box index-box)
      (let
        [text : i64 text-box]
        [index : i64 index-box]
        (ast.ast-expr-string-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases text env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(While cond-box body-box)
      (let
        [cond : i64 cond-box]
        (ast.ast-node-pool-context-expr-push
          env.pools
          (While
            (macro-hygiene-expr expr-bases cond env macro-name depth)
            (macro-hygiene-expr-list expr-bases body-box env macro-name depth))))]
    [(ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source : i64 (ast.ast-for-owned-state-source (& payload))]
        [body : i64 (ast.ast-for-owned-state-body (& payload))]
        [source-name-id : i64 (tc-for-owned-name-id expr-bases source-name)]
        [index-name-id : i64 (tc-for-owned-name-id expr-bases index-name)]
        (if (or (< source-name-id 0) (< index-name-id 0))
          (ast.ast-expr-for-owned-state-with-pools
            env.pools
            (macro-hygiene-expr expr-bases source-name env macro-name depth)
            (macro-hygiene-expr expr-bases index-name env macro-name depth)
            (macro-hygiene-expr expr-bases source env macro-name depth)
            (macro-hygiene-expr expr-bases body env macro-name depth))
          (match (macro-hygiene-bind-name-id
            env
            macro-name
            depth
            source-name-id)
            [(Name nsource-name source-env)
              (match (macro-hygiene-bind-name-id
                source-env
                macro-name
                depth
                index-name-id)
                [(Name nindex-name body-env)
                  (ast.ast-expr-for-owned-state-with-pools
                    env.pools
                    (macro-hygiene-expr-push env (ast.AstExpr.Var nsource-name))
                    (macro-hygiene-expr-push env (ast.AstExpr.Var nindex-name))
                    (macro-hygiene-expr expr-bases source env macro-name depth)
                    (macro-hygiene-expr
                      expr-bases
                      body
                      body-env
                      macro-name
                      depth))])])))]
    [(ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name-id : i64 (tc-for-owned-name-id expr-bases binding-name)]
        (if (< binding-name-id 0)
          (ast.ast-expr-for-owned-step-with-pools
            env.pools
            (macro-hygiene-expr expr-bases source-name env macro-name depth)
            (macro-hygiene-expr expr-bases index-name env macro-name depth)
            (macro-hygiene-expr expr-bases binding-name env macro-name depth)
            (if (>= expected-type 0)
              (macro-hygiene-expr expr-bases expected-type env macro-name depth)
              -1)
            (macro-hygiene-expr expr-bases done-name env macro-name depth)
            (macro-hygiene-expr expr-bases body env macro-name depth))
          (let
            ;; This binder is reconstructed from the user clause's name. Map
            ;; its generated template identity back to that source identity so
            ;; captured body references (including a nested `for` source) and
            ;; generated cleanup references resolve to the same local.
            [nbinding-name : i64
              (tc-hygiene-template-source-id-or
                (macro-hygiene-env-structural-session env)
                binding-name-id
                binding-name-id)]
            [body-env : MacroHygieneEnv
              (macro-hygiene-env-bind-raw env binding-name-id nbinding-name)]
            (ast.ast-expr-for-owned-step-with-pools
              env.pools
              (macro-hygiene-expr expr-bases source-name env macro-name depth)
              (macro-hygiene-expr expr-bases index-name env macro-name depth)
              (macro-hygiene-expr-push env (ast.AstExpr.Var nbinding-name))
              (if (>= expected-type 0)
                (macro-hygiene-expr
                  expr-bases
                  expected-type
                  env
                  macro-name
                  depth)
                -1)
              (macro-hygiene-expr expr-bases done-name env macro-name depth)
              (macro-hygiene-expr expr-bases body body-env macro-name depth)))))]
    [(Begin exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (Begin (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(Unsafe exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (Unsafe (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(Set name rhs-box)
      (let
        [rhs : i64 rhs-box]
        (ast.ast-expr-set-id-with-pools
          env.pools
          (macro-hygiene-rename-var-id env macro-name name)
          (macro-hygiene-expr expr-bases rhs env macro-name depth)))]
    [(Ann inner-box ty-id)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-ann-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))))]
    [(Cast inner-box ty-id)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-cast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))))]
    [(Borrow mutable lifetime-id place-box)
      (let
        [place : i64 place-box]
        (ast.ast-expr-borrow-with-pools
          env.pools
          mutable
          (macro-hygiene-borrow-lifetime
            (ast.ast-borrow-lifetime-from-id lifetime-id)
            env
            macro-name)
          (macro-hygiene-expr expr-bases place env macro-name depth)))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrut-box arms)
          (let
            [scrut : i64 scrut-box]
            (ast.ast-expr-match-with-pools
              env.pools
              (macro-hygiene-expr expr-bases scrut env macro-name depth)
              (macro-hygiene-arm-list expr-bases arms env macro-name depth)))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index index-ty start-box end-box body-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [body : i64 body-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(Name nindex-id body-env)
                (ast.ast-expr-foreach-id-with-pools
                  env.pools
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr expr-bases start env macro-name depth)
                  (macro-hygiene-expr expr-bases end env macro-name depth)
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))]
        [(Foreach2 outer outer-ty a b inner inner-ty c d body)
          (match (macro-hygiene-bind-name-id env macro-name depth outer)
            [(Name nouter-id outer-env)
              (match (macro-hygiene-bind-name-id
                outer-env
                macro-name
                depth
                inner)
                [(Name ninner-id body-env)
                  (ast.ast-expr-foreach2-id-with-pools
                    env.pools
                    nouter-id
                    (macro-hygiene-type outer-ty env macro-name)
                    (macro-hygiene-expr expr-bases a env macro-name depth)
                    (macro-hygiene-expr expr-bases b env macro-name depth)
                    ninner-id
                    (macro-hygiene-type inner-ty env macro-name)
                    (macro-hygiene-expr expr-bases c env macro-name depth)
                    (macro-hygiene-expr expr-bases d env macro-name depth)
                    (macro-hygiene-expr
                      expr-bases
                      body
                      body-env
                      macro-name
                      depth))])])])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce op index index-ty start-box end-box init-box value-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [init : i64 init-box]
            [value : i64 value-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(Name nindex-id body-env)
                (ast.ast-expr-spmd-reduce-id-with-pools
                  env.pools
                  op
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr expr-bases start env macro-name depth)
                  (macro-hygiene-expr expr-bases end env macro-name depth)
                  (macro-hygiene-expr expr-bases init env macro-name depth)
                  (macro-hygiene-expr
                    expr-bases
                    value
                    body-env
                    macro-name
                    depth))]))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [init : i64 init-box]
            [value : i64 value-box]
            [body : i64 body-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(Name nindex-id value-env)
                (match (macro-hygiene-bind-name-id
                  value-env
                  macro-name
                  depth
                  prefix)
                  [(Name nprefix-id body-env)
                    (ast.ast-expr-spmd-scan-id-with-pools
                      env.pools
                      op
                      nindex-id
                      (macro-hygiene-type index-ty env macro-name)
                      (macro-hygiene-expr expr-bases start env macro-name depth)
                      (macro-hygiene-expr expr-bases end env macro-name depth)
                      nprefix-id
                      (macro-hygiene-type prefix-ty value-env macro-name)
                      (macro-hygiene-expr expr-bases init env macro-name depth)
                      (macro-hygiene-expr
                        expr-bases
                        value
                        value-env
                        macro-name
                        depth)
                      (macro-hygiene-expr
                        expr-bases
                        body
                        body-env
                        macro-name
                        depth))])]))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [init : i64 init-box]
            [keep : i64 keep-box]
            [body : i64 body-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(Name nindex-id keep-env)
                (match (macro-hygiene-bind-name-id
                  keep-env
                  macro-name
                  depth
                  slot)
                  [(Name nslot-id body-env)
                    (ast.ast-expr-spmd-compact-id-with-pools
                      env.pools
                      nindex-id
                      (macro-hygiene-type index-ty env macro-name)
                      (macro-hygiene-expr expr-bases start env macro-name depth)
                      (macro-hygiene-expr expr-bases end env macro-name depth)
                      nslot-id
                      (macro-hygiene-type slot-ty keep-env macro-name)
                      (macro-hygiene-expr expr-bases init env macro-name depth)
                      (macro-hygiene-expr
                        expr-bases
                        keep
                        keep-env
                        macro-name
                        depth)
                      (macro-hygiene-expr
                        expr-bases
                        body
                        body-env
                        macro-name
                        depth))])]))])]
    [(SpmdBroadcast value-box lane-box)
      (let
        [value : i64 value-box]
        [lane : i64 lane-box]
        (ast.ast-expr-spmd-broadcast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (macro-hygiene-expr expr-bases lane env macro-name depth)))]
    [(SpmdShuffle value-box lane-box)
      (let
        [value : i64 value-box]
        [lane : i64 lane-box]
        (ast.ast-expr-spmd-shuffle-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (macro-hygiene-expr expr-bases lane env macro-name depth)))]
    [(StructGet inner-box field)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-struct-get-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          field))]
    [(StructSet inner-box field value-box)
      (let
        [inner : i64 inner-box]
        [value : i64 value-box]
        (ast.ast-expr-struct-set-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          field
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(WithRegion name body)
      (match (macro-hygiene-bind-name-id env macro-name depth name)
        [(Name nname-id body-env)
          (ast.ast-node-pool-context-expr-push
            env.pools
            (WithRegion
              nname-id
              (macro-hygiene-expr-list
                expr-bases
                body
                body-env
                macro-name
                depth)))])]
    [(WithEscape scratch-box body)
      (let
        [scratch : i64 scratch-box]
        (ast.ast-expr-with-escape-with-pools
          env.pools
          (macro-hygiene-expr expr-bases scratch env macro-name depth)
          (macro-hygiene-expr-list expr-bases body env macro-name depth)))]
    [(WithScratch body)
      (ast.ast-expr-with-scratch-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases body env macro-name depth))]
    [(InArena arena-box body)
      (let
        [arena : i64 arena-box]
        (ast.ast-expr-in-arena-with-pools
          env.pools
          (macro-hygiene-expr expr-bases arena env macro-name depth)
          (macro-hygiene-expr-list expr-bases body env macro-name depth)))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (match (macro-hygiene-resource-bindings
            expr-bases
            bindings
            env
            macro-name
            depth)
            [(ResourceBindings nbindings body-env)
              (ast.ast-node-pool-context-expr-push
                env.pools
                (WithResource
                  (box
                    (ast.AstWithResource.WithResource
                      nbindings
                      (macro-hygiene-expr-list
                        expr-bases
                        body
                        body-env
                        macro-name
                        depth)))))])])]
    [(Box inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(BoxGet inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-get-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(BoxTake inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-take-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(BoxSet inner-box value-box)
      (let
        [inner : i64 inner-box]
        [value : i64 value-box]
        (ast.ast-expr-box-set-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(TypeLiteral ty-id)
      (ast.ast-expr-type-literal-with-pools
        env.pools
        (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name)))]
    [(Init maybe-ty-id)
      (ast.ast-expr-init-maybe-with-pools
        env.pools
        (&
          (macro-hygiene-maybe-type
            (ast.ast-maybe-type-from-id maybe-ty-id)
            env
            macro-name)))]
    [(Comptime inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-comptime-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(Return inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-return-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(Try inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-try-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(PtrNull ty-id)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (PtrNull
          (ast.ty-node-push
            (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name)))))]
    [(PtrNullCheck ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-null-check-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(PtrAddrOf place-box)
      (let
        [place : i64 place-box]
        (ast.ast-expr-ptr-addr-of-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases place env macro-name depth)))]
    [(PtrRead ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-read-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : i64 ptr-box]
        [value : i64 value-box]
        (ast.ast-expr-ptr-write-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : i64 ptr-box]
        [offset : i64 offset-box]
        (ast.ast-expr-ptr-offset-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases offset env macro-name depth)))]
    [(PtrCast ptr-box ty-id)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-cast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))))]
    [(PtrToInt ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-to-int-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(IntToPtr value-box ty-id)
      (let
        [value : i64 value-box]
        (ast.ast-expr-int-to-ptr-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (& (macro-hygiene-type (ast.ty-node-get ty-id) env macro-name))))]
    [(StringData inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-string-data-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : i64 ptr-box]
        [len : i64 len-box]
        (ast.ast-expr-string-from-bytes-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases len env macro-name depth)))]
    [(ArrayData inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-array-data-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(BinaryData bytes)
      (ast.ast-node-pool-context-expr-push env.pools (BinaryData bytes))]
    [(SpmdProgramIndex) (ast.ast-expr-spmd-program-index-with-pools env.pools)]
    [(SpmdProgramCount) (ast.ast-expr-spmd-program-count-with-pools env.pools)]
    [(CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-eax-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-ebx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-ecx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-edx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(Xgetbv index-box)
      (let
        [index : i64 index-box]
        (ast.ast-expr-xgetbv-with-pools
          env.pools
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(Syscall args)
      (ast.ast-expr-syscall-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases args env macro-name depth))]
    [(ForeachActive lane body-box)
      (match (macro-hygiene-bind-name-id env macro-name depth lane)
        [(Name nlane-id body-env)
          (ast.ast-expr-foreach-active-with-pools
            env.pools
            nlane-id
            (macro-hygiene-expr expr-bases body-box body-env macro-name depth))])]
    [(LaneValue value-box)
      (ast.ast-expr-lane-value-with-pools
        env.pools
        (macro-hygiene-expr expr-bases value-box env macro-name depth))]
    [(or (Quote _) (Quasiquote _) (Unquote _) (UnquoteSplicing _))
      (macro-hygiene-expr-push env expr)]
    [_ (macro-hygiene-expr-push env expr)]))

(define (macro-expand-depth-limit) : i64
  512)

(define (macro-decl-from-decl
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [module-id : i64]
  [declaration-id : i64]) : MacroMaybeDecl
  (match decl
    [(DefMacro decl-meta name params ret body-box)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (Some name module-id declaration-id params ret body))]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (macro-decl-from-decl expr-bases inner module-id declaration-id))]
    [_ (No)]))

;; Resolve a macro decl from its symbol-table index in O(1). The symbols decls
;; array is populated (compiler-symbols-index-decl) at the SAME index that
;; compiler-symbol-handle-index returns: build-compiler-symbol-list-in-module
;; writes the array slot and registers the handle with one shared `index`,
;; skipping the Import/IncludeStr/IncludeBin/Export/Module/Test set. The array
;; already stores the unwrapped decl
;; (compiler-symbol-indexed-decl peels AstDecl.Unsafe the same
;; way macro-decl-from-decl does), so direct module lookups return the identical
;; MacroMaybeDecl.Some an O(decls) declaration scan would produce.
(define (macro-decl-owner-module-or
  [symbols : (& symbols csym.CompilerSymbols)]
  [target : i64]
  [fallback-id : i64]) : i64
  (let
    [module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        symbols
        target
        (csym.compiler-symbol-root-module-id))]
    (if (csym.compiler-symbol-root-module-id? module-id)
      fallback-id
      module-id)))

;; Imported macro aliases can be looked up from the importing module. In that
;; path, use the indexed owner module so the transformer still runs as its
;; original definition module. The dense declaration ID is carried with it.
(define (macro-decl-at-index-with-owner-module
  [_ctx : TcContext]
  [symbols : (& symbols csym.CompilerSymbols)]
  [target : i64]
  [module-id : i64]) : MacroMaybeDecl
  (match (csym.compiler-symbols-decl-at-index symbols target)
    [(Ok decl)
      (macro-decl-from-decl
        (tc-context-expr-bases _ctx)
        decl
        (macro-decl-owner-module-or symbols target module-id)
        target)]
    [(Err _) (No)]))

;; The module accumulator and the current module compare as INTERN IDS, so a
;; qualified-alias resolution never converts a walked AstDecl.Module's interned
;; name back to a fresh String (`intern-str` allocates) to string-compare it.
;; Import aliases still compare by
;; content, but only for imports declared in the current module.
(define (macro-import-kind-module-alias? [kind : ast.AstImportKind]) : bool
  (match kind
    [(or (Module) (Macro _ _) (MacroDecls _ _)) true]
    [(or (ModuleAll) (ModuleItem _)) false]))

(define (macro-import-alias-target-from-spec
  [spec : ast.AstImportSpec]
  [alias-id : i64]) : TcMaybeNameId
  (match spec
    [(Spec kind _ expected maybe-alias _)
      ;; This lookup walks declarations for every uncached qualified macro
      ;; alias. Keep the cheap alias rejection before import-kind
      ;; classification so unrelated imports do not pay for the enum match.
      (match maybe-alias
        [(Some import-alias)
          (if (= import-alias alias-id)
            (if (macro-import-kind-module-alias? kind)
              (match expected
                [(Some target) (Some target)]
                [(No) (Some alias-id)])
              (No))
            (No))]
        [(No) (No)])]))

(define (macro-import-alias-target-from-wrapped-decl
  [decl : ast.AstDecl]
  [alias-id : i64]) : TcMaybeNameId
  (match (ast.ast-decl-unwrapped (& decl))
    [(Import decl-meta spec)
      (macro-import-alias-target-from-spec spec alias-id)]
    [_ (No)]))

(define (macro-import-alias-target-ids
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : TcMaybeNameId
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [slot : i64 (tc-module-decl-index-slot current-module-id)]
    [decl-offset : i64 decls.offset]
    [result : TcMaybeNameId (No)]
    (if (< slot 0)
      result
      (let
        [index : i64 (array-ref tc-module-import-index-starts slot)]
        [end : i64 (array-ref tc-module-import-index-ends slot)]
        [done : bool false]
        (while (and (not done) (< index end))
          (let
            [position : i64 (array-ref tc-module-import-index-positions index)]
            [target : TcMaybeNameId
              (macro-import-alias-target-from-wrapped-decl
                (tc-global-array-element-shared-view
                  decls.slots
                  (+ decl-offset position))
                alias-id)]
            (match target
              [(Some target-id)
                (if (= target-id alias-id)
                  (match result
                    [(No) (set! result (Some alias-id))]
                    [_ unit])
                  (begin
                    (set! result (Some target-id))
                    (set! done true)))]
              [(No) unit])
            (set! index (+ index 1))))
        result))))

;; --- import-aware macro resolution caches -------------------------------------
;;
;; Qualified-alias lookup and unqualified flat-import lookup both derive from the
;; program's AstDecl.Module/AstDecl.Import declarations. Cache them at the same
;; per-program boundary so generated macro bodies do not repeatedly rescan the
;; whole declaration list.
(defstruct MacroFlatImportTargetList
  (slots (__tl_dyn-array i64))
  (len i64))

(defenum MacroFlatImportTargetCacheLookup
  (Missing)
  (Hit MacroFlatImportTargetList))

;; Even with id compares, each resolution walks the ENTIRE declaration list
;; (most declarations are neither modules nor imports), and the same
;; (current-module, qualifier) pair resolves identically for the whole
;; program: the mapping is derived only from AstDecl.Module/AstDecl.Import
;; declarations, which macro expansion, comptime generation, and
;; specialization never insert or reorder mid-compile. Memoize per
;; generation (same idiom as the marker name-id memos), open-addressed and
;; keyed by the two intern ids. Module key slots store module-id+1 so the zeroed
;; table is empty; qualifier slots store qualifier-id+1, and values store the
;; resolved target's intern id, -1 for "no alias import", or -3 for an alias
;; definitively resolved to its own qualifier id. The distinct self sentinel
;; prevents every later query from rescanning that module while still allowing
;; a subsequently materialized lazy-import stub to replace it. Inserts stop at
;; half load -- only memoization, never correctness, degrades.
(defstruct TcMacroImportIndexStateData
  (alias-module-keys (__tl_dyn-array i64))
  (alias-qualifier-keys (__tl_dyn-array i64))
  (alias-values (__tl_dyn-array i64))
  (unqualified-module-keys (__tl_dyn-array i64))
  (unqualified-name-keys (__tl_dyn-array i64))
  (unqualified-values (__tl_dyn-array i64))
  (flat-module-keys (__tl_dyn-array i64))
  (flat-values (__tl_dyn-array MacroFlatImportTargetList))
  ;; Scalar slots, kept in shared storage so nested index builders can update
  ;; them without a process-global selector or copying the state carrier.
  ;; 0..10 alias, 11..14 unqualified, 15..22 flat-import targets.
  (control (__tl_dyn-array i64)))

(define (tc-macro-import-index-state-new) : TcMacroImportIndexStateData
  (let
    [control : (__tl_dyn-array i64) (__tl_make-array i64 23)]
    (set! (array-ref control 1) -1)
    (set! (array-ref control 2) -1)
    (set! (array-ref control 7) -1)
    (set! (array-ref control 8) -1)
    (set! (array-ref control 9) -1)
    (set! (array-ref control 10) -1)
    (set! (array-ref control 12) -1)
    (set! (array-ref control 13) -1)
    (set! (array-ref control 16) -1)
    (set! (array-ref control 17) -1)
    (set! (array-ref control 21) -1)
    (set! (array-ref control 22) -1)
    (TcMacroImportIndexStateData
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      (__tl_make-array MacroFlatImportTargetList 0)
      control)))

(define (tc-macro-import-index-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroImportIndexStateData
    tc-macro-state-slot-import-index
    (tc-macro-import-index-state-new)))

(define (tc-macro-import-index-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    8
    tc-macro-import-index-state-address-initialize))

(define (tc-macro-import-index-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroImportIndexStateData)
  (tc-state-cell-ptr
    (tc-macro-import-index-state-address state)
    TcMacroImportIndexStateData))

(define (tc-macro-import-index-state-view [state : TcMacroState]) : (Ptr
    TcMacroImportIndexStateData)
  (tc-state-cell-view
    (tc-macro-import-index-state-address state)
    TcMacroImportIndexStateData))

(defmacro (tc-macro-import-index-control [state : Expr] [index : Expr]) : Expr
  `(array-ref
    (unsafe
      (ptr-read
        (ptr-offset
          (int->ptr
            (cast (tc-macro-import-index-state-address ,state) : u64)
            : (Ptr (__tl_dyn-array i64)))
          8)))
    ,index))

(define (tc-macro-import-index-control-set!
  [state : TcMacroState]
  [index : i64]
  [value : i64]) : unit
  (set!
    (array-ref
      (unsafe
        (ptr-read
          (ptr-offset
            (int->ptr
              (cast (tc-macro-import-index-state-address state) : u64)
              : (Ptr (__tl_dyn-array i64)))
            8)))
      index)
    value))

(defmacro (tc-macro-import-index-array [state : Expr] [field : Expr]) : Expr
  (match field
    [(comptime.Expr.Var name)
      (let
        [index : i64
          (match name
            ["alias-module-keys" 0]
            ["alias-qualifier-keys" 1]
            ["alias-values" 2]
            ["unqualified-module-keys" 3]
            ["unqualified-name-keys" 4]
            ["unqualified-values" 5]
            ["flat-module-keys" 6]
            ["flat-values" 7]
            [_ -1])]
        (if (< index 0)
          (if (string.eq name "field")
            `(unsafe
              (ptr-read
                (int->ptr
                  (cast (tc-macro-import-index-state-address ,state) : u64)
                  : (Ptr (__tl_dyn-array i64)))))
            (comptime.comptime-error
              (comptime.string-append "unknown macro import index array: " name)))
          (if (string.eq name "flat-values")
            `(unsafe
              (ptr-read
                (ptr-offset
                  (int->ptr
                    (cast (tc-macro-import-index-state-address ,state) : u64)
                    : (Ptr (__tl_dyn-array MacroFlatImportTargetList)))
                  7)))
            `(unsafe
              (ptr-read
                (ptr-offset
                  (int->ptr
                    (cast (tc-macro-import-index-state-address ,state) : u64)
                    : (Ptr (__tl_dyn-array i64)))
                  ,(comptime.expr-int index)))))))]
    [_ (comptime.comptime-error "macro import index expects a field name")]))

(define (macro-unqualified-import-cache-storage-ensure! [state : TcMacroState]) : unit
  (let
    [data : (MutPtr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-ptr state)]
    (unsafe
      (if (= (array-length (deref data).unqualified-module-keys) 65536)
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (set!
              (deref data).unqualified-module-keys
              (__tl_make-array i64 65536))
            (set!
              (deref data).unqualified-name-keys
              (__tl_make-array i64 65536))
            (set! (deref data).unqualified-values (__tl_make-array i64 65536))))))))

(define (macro-decl-list-slots-data-addr [decls : (& decls ast.AstDeclList)]) : i64
  (cast
    (unsafe
      (ptr->int (ptr-cast (__tl_array-data decls.slots) : (Ptr u8))))
    : i64))

;; The mapping is program-derived, so the cache must not survive into the next
;; program of a multi-program process (smoke batteries, REPL, LSP, package
;; builds). macro-expand-program and the REPL typecheck entry reset it at the
;; same per-program boundary that resets the CTFE-env and clone-able caches;
;; the intern generation gate additionally covers intern-reset! boundaries.
(define (macro-alias-derived-cache-reset-for-state! [state : TcMacroState]) : unit
  (tc-module-decl-index-reset!)
  (macro-import-derived-cache-reset-for-state! state))

;; A splice that keeps the context's flat program keeps its module decl index:
;; the index covers exactly that list, while the import-derived caches below
;; also read the segmented view the splice changed.
(define (macro-import-derived-cache-reset-for-state! [state : TcMacroState]) : unit
  (tc-program-enum-index-reset!)
  (tc-macro-import-index-control-set! state 3 0)
  (tc-macro-import-index-control-set! state 14 0)
  (tc-macro-import-index-control-set! state 18 0)
  (macro-surface-call-decl-cache-reset! state)
  (tc-source-dotted-alias-key-cache-reset!)
  (tc-source-dotted-full-path-key-cache-reset!)
  (tc-source-qualified-variant-key-cache-reset!)
  (tc-imported-module-identity-cache-reset!))

;; Standalone callers and focused smoke tests use the serial compatibility job.
(define (macro-alias-derived-cache-reset!) : unit
  (macro-alias-derived-cache-reset-for-state!
    (tc-job-state-macro-state (tc-serial-job-state))))

(define (macro-alias-cache-reset!) : unit
  (macro-alias-derived-cache-reset!))

(define (macro-unqualified-import-cache-initialize! [state : TcMacroState]) : unit
  (macro-unqualified-import-cache-storage-ensure! state)
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (if (and
      (= (tc-macro-import-index-control state 14) 1)
      (= (tc-macro-import-index-control state 12) table-id)
      (= (tc-macro-import-index-control state 13) reset-generation))
      unit
      (let
        [i : i64 0]
        (while (< i 65536)
          (set!
            (array-ref
              (tc-macro-import-index-array state unqualified-module-keys)
              i)
            0)
          (set! i (+ i 1)))
        (tc-macro-import-index-control-set! state 11 0)
        (tc-macro-import-index-control-set! state 12 table-id)
        (tc-macro-import-index-control-set! state 13 reset-generation)
        (tc-macro-import-index-control-set! state 14 1)))))

(define (macro-unqualified-import-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : (Ptr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-view state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (unsafe
      (if (and
        (= (array-ref (deref data).control 14) 1)
        (= (array-ref (deref data).control 12) table-id)
        (= (array-ref (deref data).control 13) reset-generation))
        unit
        (macro-unqualified-import-cache-initialize! state)))))

(define (macro-unqualified-import-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) (* name-id 40503)) 65535))

;; Returns the cached target module id, -1 for "no imported macro", or -2 when
;; absent.
(define (macro-unqualified-import-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]) : i64
  (let
    [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (while (if done
      false
      (< steps 65536))
      (let
        [slot : i64
          (array-ref
            (tc-macro-import-index-array state unqualified-module-keys)
            cursor)]
        (if (= slot 0)
          (set! done true)
          (if (and
            (= slot module-key)
            (=
              (array-ref
                (tc-macro-import-index-array state unqualified-name-keys)
                cursor)
              name-key))
            (begin
              (set!
                out
                (array-ref
                  (tc-macro-import-index-array state unqualified-values)
                  cursor))
              (set! done true))
            (begin
              (set! cursor (bit-and (+ cursor 1) 65535))
              (set! steps (+ steps 1)))))))
    out))

(define (macro-unqualified-import-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (if (>= (* (tc-macro-import-index-control state 11) 2) 65536)
    unit
    (let
      [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      [steps : i64 0]
      [done : bool false]
      (while (if done
        false
        (< steps 65536))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state unqualified-module-keys)
              cursor)]
          (if (= slot 0)
            (begin
              (set!
                (array-ref
                  (tc-macro-import-index-array state unqualified-module-keys)
                  cursor)
                module-key)
              (set!
                (array-ref
                  (tc-macro-import-index-array state unqualified-name-keys)
                  cursor)
                name-key)
              (set!
                (array-ref
                  (tc-macro-import-index-array state unqualified-values)
                  cursor)
                value)
              (tc-macro-import-index-control-set!
                state
                11
                (+ (tc-macro-import-index-control state 11) 1))
              (set! done true))
            (if (and
              (= slot module-key)
              (=
                (array-ref
                  (tc-macro-import-index-array state unqualified-name-keys)
                  cursor)
                name-key))
              (set! done true)
              (begin
                (set! cursor (bit-and (+ cursor 1) 65535))
                (set! steps (+ steps 1)))))))
      unit)))

(define (macro-flat-import-target-cache-initialize! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [data : (MutPtr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-ptr state)]
    (unsafe
      (if (and
        (= (array-ref (deref data).control 18) 1)
        (= (array-ref (deref data).control 16) table-id)
        (= (array-ref (deref data).control 17) reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          [i : i64 0]
          (in-arena
            (arena.Arena owner)
            (when
              (= (array-length (deref data).flat-module-keys) 0)
              (set! (deref data).flat-module-keys (__tl_make-array i64 1024))
              (set!
                (deref data).flat-values
                (__tl_make-array MacroFlatImportTargetList 1024)))
            (while (< i 1024)
              (set! (array-ref (deref data).flat-module-keys i) 0)
              (set! i (+ i 1)))
            (set! (array-ref (deref data).control 15) 0)
            (set! (array-ref (deref data).control 16) table-id)
            (set! (array-ref (deref data).control 17) reset-generation)
            (set! (array-ref (deref data).control 18) 1)
            (set! (array-ref (deref data).control 19) 0)
            (set! (array-ref (deref data).control 20) 0)))))))

(define (macro-flat-import-target-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : (Ptr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-view state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (unsafe
      (if (and
        (= (array-ref (deref data).control 18) 1)
        (= (array-ref (deref data).control 16) table-id)
        (= (array-ref (deref data).control 17) reset-generation))
        unit
        (macro-flat-import-target-cache-initialize! state)))))

(define (macro-flat-import-target-cache-bucket [module-id : i64]) : i64
  (bit-and (* module-id 2654435761) 1023))

(define (macro-flat-import-target-cache-get
  [state : TcMacroState]
  [module-id : i64]) : MacroFlatImportTargetCacheLookup
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [out : MacroFlatImportTargetCacheLookup (Missing)]
    [done : bool false]
    (while (if done
      false
      (< steps 1024))
      (let
        [slot : i64
          (array-ref
            (tc-macro-import-index-array state flat-module-keys)
            cursor)]
        (if (= slot 0)
          (set! done true)
          (if (= slot module-key)
            (begin
              (set!
                out
                (Hit
                  (tc-global-array-element-shared-view
                    (tc-macro-import-index-array state flat-values)
                    cursor)))
              (set! done true))
            (begin
              (set! cursor (bit-and (+ cursor 1) 1023))
              (set! steps (+ steps 1)))))))
    out))

(define (macro-flat-import-target-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (if (>= (* (tc-macro-import-index-control state 15) 2) 1024)
    unit
    (let
      [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
      [module-key : i64 (+ module-id 1)]
      [steps : i64 0]
      [done : bool false]
      (while (if done
        false
        (< steps 1024))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state flat-module-keys)
              cursor)]
          (if (= slot 0)
            (begin
              (set!
                (array-ref
                  (tc-macro-import-index-array state flat-module-keys)
                  cursor)
                module-key)
              (set!
                (array-ref
                  (tc-macro-import-index-array state flat-values)
                  cursor)
                targets)
              (tc-macro-import-index-control-set!
                state
                15
                (+ (tc-macro-import-index-control state 15) 1))
              (set! done true))
            (if (= slot module-key)
              (set! done true)
              (begin
                (set! cursor (bit-and (+ cursor 1) 1023))
                (set! steps (+ steps 1)))))))
      unit)))

(define (macro-flat-import-target-list-empty) : MacroFlatImportTargetList
  (MacroFlatImportTargetList (__tl_make-array i64 0) 0))

;; Appends in program order, so no reversal pass is needed on store. The
;; per-module lists are a handful of entries, so the dedup scan and the
;; append-copy both stay well inside a cache line's worth of work.
(define (macro-flat-import-target-list-add
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : MacroFlatImportTargetList
  (let
    [slots : (__tl_dyn-array i64) targets.slots]
    [len : i64 targets.len]
    [index : i64 0]
    [found : bool false]
    (while (if found
      false
      (< index len))
      (if (= (array-ref slots index) target-id)
        (set! found true)
        unit)
      (set! index (+ index 1)))
    (if found
      (MacroFlatImportTargetList slots len)
      (begin
        (__tl_array-push! slots target-id)
        (MacroFlatImportTargetList slots (+ len 1))))))

(define (macro-flat-import-targets-from-list
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (let
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [cur-module-id : i64 module-id]
    [cur-targets : MacroFlatImportTargetList targets]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (tc-global-array-element-shared-view
            decls.slots
            (+ decl-offset index))]
        (match (ast.ast-decl-unwrapped (& decl))
          [(Module next-module) (set! cur-module-id next-module)]
          [(Import decl-meta (Spec _ _ expected maybe-alias _))
            (match maybe-alias
              [(Some alias)
                (if (and
                  (= cur-module-id current-module-id)
                  (= alias cbi.compiler-builtin-id-fix-empty))
                  (match expected
                    [(Some target-module)
                      (if (= target-module current-module-id)
                        unit
                        (set!
                          cur-targets
                          (macro-flat-import-target-list-add
                            cur-targets
                            target-module)))]
                    [(No) unit])
                  unit)]
              [(No) unit])]
          [_ unit])
        (set! index (+ index 1))))
    cur-targets))

;; Overwrite the stored list for a module id already present in the table
;; (macro-flat-import-target-cache-put! keeps existing entries untouched).
(define (macro-flat-import-target-cache-overwrite!
  [state : TcMacroState]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [done : bool false]
    (while (if done
      false
      (< steps 1024))
      (let
        [slot : i64
          (array-ref
            (tc-macro-import-index-array state flat-module-keys)
            cursor)]
        (if (= slot module-key)
          (begin
            (set!
              (array-ref (tc-macro-import-index-array state flat-values) cursor)
              targets)
            (set! done true))
          (if (= slot 0)
            (set! done true)
            (begin
              (set! cursor (bit-and (+ cursor 1) 1023))
              (set! steps (+ steps 1)))))))
    unit))

;; One-pass eager build of every module's flat-import target list. The cache
;; resets at every in-pass splice rebuild, so a per-module miss that rescanned
;; the whole declaration list would repeat that scan per module per epoch.
;; Lists are appended in program order, matching
;; macro-flat-import-targets-from-list exactly. If the table's half-load insert
;; cap is hit, complete stays false and misses fall back to the exact scan, so
;; only memoization -- never correctness -- degrades.
(define (macro-flat-import-target-cache-build!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [truncated : bool false]
    [i : i64 0]
    (while (< i count)
      ;; Classify through a borrow first: only module markers and imports
      ;; carry a payload this index reads, so every other declaration is
      ;; skipped without the two 104 B rows `ast-decl-unwrapped` copies.
      (if (ast.ast-decl-list-unwrapped-module-or-import-at? (& decls) i)
        (match (ast.ast-decl-unwrapped
          (& (array-ref decl-slots (+ decl-offset i))))
          [(Module next-module) (set! cur-module-id next-module)]
          [(Import decl-meta (Spec _ _ expected maybe-alias _))
            (match maybe-alias
              [(Some alias)
                (if (= alias cbi.compiler-builtin-id-fix-empty)
                  (match expected
                    [(Some target-module)
                      (if (= target-module cur-module-id)
                        unit
                        (match (macro-flat-import-target-cache-get
                          state
                          cur-module-id)
                          [(Hit existing)
                            (macro-flat-import-target-cache-overwrite!
                              state
                              cur-module-id
                              (macro-flat-import-target-list-add
                                existing
                                target-module))]
                          [(Missing)
                            (if (>=
                              (* (tc-macro-import-index-control state 15) 2)
                              1024)
                              (set! truncated true)
                              (macro-flat-import-target-cache-put!
                                state
                                cur-module-id
                                (macro-flat-import-target-list-add
                                  (macro-flat-import-target-list-empty)
                                  target-module)))]))]
                    [(No) unit])
                  unit)]
              [(No) unit])]
          [_ unit])
        unit)
      (set! i (+ i 1)))
    (tc-macro-import-index-control-set! state 19 1)
    (tc-macro-import-index-control-set!
      state
      21
      (ast.ast-decl-list-len (& decls)))
    (tc-macro-import-index-control-set! state 22 decls.offset)
    (tc-macro-import-index-control-set!
      state
      20
      (if truncated
        0
        1))))

;; R3-P1: this cache outlives the declaration whose expansion first populated
;; it, but its per-module lists are built from whatever arena happens to be
;; current -- during a firing declaration's expansion that is that
;; declaration's generation, which is destroyed a declaration later. Build them
;; in the macro-expansion scratch arena instead. That owner's lifetime is
;; exactly the cache's: `macro-expand-scratch-clear-owned-caches!` runs
;; `macro-alias-derived-cache-reset!` immediately before the scratch is
;; destroyed. Only redirected while a generation is live, so every non-
;; generational caller keeps its existing owner.
(define (macro-flat-import-targets
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (if (not (macro-generation-any-live? state))
    (macro-flat-import-targets-into-current state decls current-module-id)
    (in-arena
      (arena.Arena (macro-expand-scratch-arena-get state))
      (macro-flat-import-targets-into-current state decls current-module-id))))

(define (macro-flat-import-targets-into-current
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (macro-flat-import-target-cache-ensure! state)
  (if (= (tc-macro-import-index-control state 19) 1)
    unit
    (macro-flat-import-target-cache-build! state decls))
  (match (macro-flat-import-target-cache-get state current-module-id)
    [(Hit targets) targets]
    [(Missing)
      (if (and
        (= (tc-macro-import-index-control state 20) 1)
        (=
          (tc-macro-import-index-control state 21)
          (ast.ast-decl-list-len (& decls)))
        (= (tc-macro-import-index-control state 22) decls.offset))
        (macro-flat-import-target-list-empty)
        (let
          [targets : MacroFlatImportTargetList
            (macro-flat-import-targets-from-list
              decls
              current-module-id
              cbi.compiler-builtin-id-fix-empty
              (macro-flat-import-target-list-empty))]
          (macro-flat-import-target-cache-put!
            state
            current-module-id
            (tc-global-shared-view targets))
          targets))]))

(define (macro-alias-cache-initialize! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [data : (MutPtr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-ptr state)]
    (unsafe
      (if (and
        (= (array-ref (deref data).control 3) 1)
        (= (array-ref (deref data).control 1) table-id)
        (= (array-ref (deref data).control 2) reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          [i : i64 0]
          (in-arena
            (arena.Arena owner)
            (when
              (= (array-length (deref data).alias-module-keys) 0)
              (set! (deref data).alias-module-keys (__tl_make-array i64 16384))
              (set!
                (deref data).alias-qualifier-keys
                (__tl_make-array i64 16384))
              (set! (deref data).alias-values (__tl_make-array i64 16384)))
            (while (< i 16384)
              (set! (array-ref (deref data).alias-module-keys i) 0)
              (set! i (+ i 1)))
            (set! (array-ref (deref data).control 0) 0)
            (set! (array-ref (deref data).control 1) table-id)
            (set! (array-ref (deref data).control 2) reset-generation)
            (set! (array-ref (deref data).control 3) 1)
            (set! (array-ref (deref data).control 4) 0)
            (set! (array-ref (deref data).control 5) 0)
            (set! (array-ref (deref data).control 6) 0)))))))

(define (macro-alias-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : (Ptr TcMacroImportIndexStateData)
      (tc-macro-import-index-state-view state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (unsafe
      (if (and
        (= (array-ref (deref data).control 3) 1)
        (= (array-ref (deref data).control 1) table-id)
        (= (array-ref (deref data).control 2) reset-generation))
        unit
        (macro-alias-cache-initialize! state)))))

(define (macro-alias-cache-bucket [module-id : i64] [qualifier-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) qualifier-id) 16383))

;; Returns the cached value for `(module-id, qualifier-id)`, or -2 when absent.
(define (macro-alias-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [qualifier-id : i64]) : i64
  (let
    [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
    [module-key : i64 (+ module-id 1)]
    [qualifier-key : i64 (+ qualifier-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (while (if done
      false
      (< steps 16384))
      (let
        [slot : i64
          (array-ref
            (tc-macro-import-index-array state alias-module-keys)
            cursor)]
        (if (= slot 0)
          (set! done true)
          (if (and
            (= slot module-key)
            (=
              (array-ref
                (tc-macro-import-index-array state alias-qualifier-keys)
                cursor)
              qualifier-key))
            (begin
              (set!
                out
                (array-ref
                  (tc-macro-import-index-array state alias-values)
                  cursor))
              (set! done true))
            (begin
              (set! cursor (bit-and (+ cursor 1) 16383))
              (set! steps (+ steps 1)))))))
    out))

(define (macro-alias-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [qualifier-id : i64]
  [value : i64]) : unit
  (if (>= (* (tc-macro-import-index-control state 0) 2) 16384)
    unit
    (let
      [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
      [module-key : i64 (+ module-id 1)]
      [qualifier-key : i64 (+ qualifier-id 1)]
      [steps : i64 0]
      [done : bool false]
      (while (if done
        false
        (< steps 16384))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state alias-module-keys)
              cursor)]
          (if (= slot 0)
            (begin
              (set!
                (array-ref
                  (tc-macro-import-index-array state alias-module-keys)
                  cursor)
                module-key)
              (set!
                (array-ref
                  (tc-macro-import-index-array state alias-qualifier-keys)
                  cursor)
                qualifier-key)
              (set!
                (array-ref
                  (tc-macro-import-index-array state alias-values)
                  cursor)
                value)
              (tc-macro-import-index-control-set!
                state
                0
                (+ (tc-macro-import-index-control state 0) 1))
              (set! done true))
            (if (and
              (= slot module-key)
              (=
                (array-ref
                  (tc-macro-import-index-array state alias-qualifier-keys)
                  cursor)
                qualifier-key))
              (begin
                (let
                  [existing : i64
                    (array-ref
                      (tc-macro-import-index-array state alias-values)
                      cursor)]
                  (if (and
                    (or (= value -3) (>= value 0))
                    (or (< existing 0) (= existing qualifier-id))
                    (not (= value existing)))
                    (set!
                      (array-ref
                        (tc-macro-import-index-array state alias-values)
                        cursor)
                      value)
                    unit))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) 16383))
                (set! steps (+ steps 1)))))))
      unit)))

;; The alias index's step for one row that is, once unwrapped, a module
;; marker or an import: returns the module the rows after it belong to.
(define (macro-alias-cache-index-at!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]
  [index : i64]
  [cur-module-id : i64]) : i64
  (match (ast.ast-decl-unwrapped
    (& (array-ref decls.slots (+ decls.offset index))))
    [(Module next-module) next-module]
    [(Import _decl-meta (Spec kind _ expected maybe-alias _))
      (if (macro-import-kind-module-alias? kind)
        (match maybe-alias
          [(Some alias)
            (let
              [target-id : i64
                (match expected
                  [(Some target) target]
                  [(No) alias])]
              (if (>= (* (tc-macro-import-index-control state 0) 2) 16384)
                (tc-macro-import-index-control-set! state 6 0)
                (macro-alias-cache-put! state cur-module-id alias target-id)))]
          [(No) unit])
        unit)
      cur-module-id]
    [_ cur-module-id]))

(define (macro-alias-cache-index-range!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]
  [start : i64]
  [count : i64]
  [start-module-id : i64]) : i64
  (let
    [cur-module-id : i64 start-module-id]
    [i : i64 start]
    (while (< i count)
      ;; Classify through a borrow first: only module markers and imports
      ;; carry a payload this index reads, so every other declaration is
      ;; skipped without the two 104 B rows `ast-decl-unwrapped` copies.
      (if (macro-decl-list-event-at? decls i)
        (set!
          cur-module-id
          (macro-alias-cache-index-at! state decls i cur-module-id))
        unit)
      (set! i (+ i 1)))
    cur-module-id))

;; One-pass eager index over the program's aliased imports: record every
;; (module, alias) -> target mapping in program order (first import wins,
;; matching macro-import-alias-target-ids' first-match scan). The cache is
;; reset at every in-pass splice rebuild, so a per-pair miss that rescanned the
;; whole declaration list would repeat that scan after every splice. One pass
;; makes every later query O(1); if the table's
;; half-load insert cap is ever hit, complete stays false and misses fall back
;; to the exact scan, so only memoization -- never correctness -- degrades.
(define (macro-alias-cache-build!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    (tc-macro-import-index-control-set! state 6 1)
    (tc-macro-import-index-control-set!
      state
      10
      (macro-alias-cache-index-range!
        state
        decls
        0
        count
        cbi.compiler-builtin-id-fix-empty))
    (tc-macro-import-index-control-set! state 4 1)
    (tc-macro-import-index-control-set! state 5 0)
    (tc-macro-import-index-control-set! state 7 count)
    (tc-macro-import-index-control-set! state 8 decls.offset)
    (tc-macro-import-index-control-set!
      state
      9
      (macro-decl-list-slots-data-addr decls))))

(define (macro-alias-cache-build-segmented! [job-state : TcJobState]) : unit
  (let
    [state : TcMacroState (tc-job-state-macro-state job-state)]
    [count : i64 (macro-segmented-program-decl-count job-state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-prefix-events-sync! job-state)]
    [prefix : ast.AstDeclList data.prefix-rev]
    [len : i64 (ast.ast-decl-list-len (& prefix))]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [event : i64 0]
    [node-address : i64 data.head]
    [start : i64 data.cursor]
    (tc-macro-import-index-control-set! state 6 1)
    ;; Only event rows carry what the index reads (macro-decl-list-events).
    (while (< event data.prefix-event-count)
      (set!
        cur-module-id
        (macro-alias-cache-index-at!
          state
          (& prefix)
          (- (- len 1) (array-ref data.prefix-events event))
          cur-module-id))
      (set! event (+ event 1)))
    (while (> node-address 0)
      (let
        [node : MacroProgramSegmentNodeData
          (macro-program-segment-node-data node-address)]
        [decls : ast.AstDeclList node.decls]
        [events : (__tl_dyn-array i64) node.events]
        [end : i64 (+ decls.offset (ast.ast-decl-list-len (& decls)))]
        [next-event : i64
          (macro-events-lower-bound (& events) (+ decls.offset start))]
        (while (and
          (< next-event (array-length events))
          (< (array-ref events next-event) end))
          (set!
            cur-module-id
            (macro-alias-cache-index-at!
              state
              (& decls)
              (- (array-ref events next-event) decls.offset)
              cur-module-id))
          (set! next-event (+ next-event 1)))
        (set! node-address node.next)
        (set! start 0)))
    (tc-macro-import-index-control-set! state 10 cur-module-id)
    (tc-macro-import-index-control-set! state 4 1)
    (tc-macro-import-index-control-set! state 5 1)
    (tc-macro-import-index-control-set! state 7 count)
    (tc-macro-import-index-control-set! state 8 -1)
    (tc-macro-import-index-control-set! state 9 0)))

;; Macro expansion appends generated declarations to the active program view.
;; Keep the eager index synchronized once per larger view. When the backing
;; array is stable, consume only the new tail. Growth may reallocate the list;
;; in that case rebuild the index once over the replacement view rather than
;; making every later miss rescan it. Smaller/offset views remain transient and
;; retain the exact fallback below.
(define (macro-alias-cache-adopt-larger-view!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    (if (and
      (= (tc-macro-import-index-control state 8) decls.offset)
      (> count (tc-macro-import-index-control state 7)))
      (if (=
        (tc-macro-import-index-control state 9)
        (macro-decl-list-slots-data-addr decls))
        (begin
          (tc-macro-import-index-control-set!
            state
            10
            (macro-alias-cache-index-range!
              state
              decls
              (tc-macro-import-index-control state 7)
              count
              (tc-macro-import-index-control state 10)))
          (tc-macro-import-index-control-set! state 7 count))
        (begin
          (tc-macro-import-index-control-set! state 3 0)
          (macro-alias-cache-ensure! state)
          (macro-alias-cache-build! state decls)))
      unit)))

(define (macro-import-alias-target-cached-id
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeNameId
  (macro-alias-cache-ensure! state)
  (if (= (tc-macro-import-index-control state 4) 1)
    unit
    (macro-alias-cache-build! state decls))
  (macro-alias-cache-adopt-larger-view! state decls)
  (let
    [cached : i64 (macro-alias-cache-get state current-module-id qualifier-id)]
    (cond
      [(= cached -3)
        (match (tc-lazy-import-stub-target-indexed-for-state
          state
          current-module-id
          qualifier-id)
          [(Some target-id)
            (macro-alias-cache-put!
              state
              current-module-id
              qualifier-id
              (if (= target-id qualifier-id)
                -3
                target-id))
            (Some target-id)]
          [(No) (Some qualifier-id)])]
      [(= cached -2)
        (match (tc-lazy-import-stub-target-indexed-for-state
          state
          current-module-id
          qualifier-id)
          [(Some target-id)
            (macro-alias-cache-put!
              state
              current-module-id
              qualifier-id
              (if (= target-id qualifier-id)
                -3
                target-id))
            (Some target-id)]
          [(No)
            (match (macro-import-alias-target-ids
              decls
              current-module-id
              qualifier-id
              cbi.compiler-builtin-id-fix-empty)
              [(Some target-id)
                (macro-alias-cache-put!
                  state
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (Some target-id)]
              [(No)
                (macro-alias-cache-put! state current-module-id qualifier-id -1)
                (No)])])]
      [(< cached 0) (No)]
      [(= cached qualifier-id)
        (match (tc-lazy-import-stub-target-indexed-for-state
          state
          current-module-id
          qualifier-id)
          [(Some target-id)
            (macro-alias-cache-put!
              state
              current-module-id
              qualifier-id
              (if (= target-id qualifier-id)
                -3
                target-id))
            (Some target-id)]
          [(No)
            (match (macro-import-alias-target-ids
              decls
              current-module-id
              qualifier-id
              cbi.compiler-builtin-id-fix-empty)
              [(Some target-id)
                (macro-alias-cache-put!
                  state
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (Some target-id)]
              [(No)
                (macro-alias-cache-put! state current-module-id qualifier-id -3)
                (Some cached)])])]
      [else (Some cached)])))

(define (macro-import-alias-target-cached-id-in-context
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeNameId
  (let
    [job-state : TcJobState (tc-context-job-state ctx)]
    [state : TcMacroState (tc-context-macro-state ctx)]
    (when
      (macro-segmented-program-active? job-state)
      (macro-alias-cache-ensure! state)
      (unless
        (and
          (= (tc-macro-import-index-control state 4) 1)
          (= (tc-macro-import-index-control state 5) 1))
        (tc-macro-import-index-control-set! state 3 0)
        (macro-alias-cache-ensure! state)
        (macro-alias-cache-build-segmented! job-state)))
    (macro-import-alias-target-cached-id
      state
      decls
      current-module-id
      qualifier-id)))

(define (macro-resolve-qualified-module-id
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : i64
  (match (macro-import-alias-target-cached-id-in-context
    ctx
    decls
    current-module-id
    qualifier-id)
    [(Some target-id) target-id]
    [(No) qualifier-id]))

(define (macro-missing-macro-message [name : String]) : String
  (str_cat.str-cat "typecheck: missing macro " name))

(define (macro-source-module-id [module-id : i64]) : i64
  (if (csym.compiler-symbol-root-module-id? module-id)
    cbi.compiler-builtin-id-fix-empty
    module-id))

(define (macro-decl-module-display [module-id : i64]) : String
  (if (csym.compiler-symbol-root-module-id? module-id)
    ""
    (tc-env-key-name-text module-id)))

(define (macro-decl-name-display [name-id : i64] [module-id : i64]) : String
  (csym.compiler-symbol-module-key
    (macro-decl-module-display module-id)
    (tc-env-key-name-text name-id)))

(define (macro-qualified-call-decl-in-module
  [ctx : TcContext]
  [target-module-id : i64]
  [base-id : i64]
  [name : String]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [macro-handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        base-id
        (csym.compiler-symbols-missing-handle))]
    ;; A macro that exists in the target module resolves directly from the
    ;; symbol table.
    (if (csym.compiler-symbols-handle-found? macro-handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index macro-handle)
        target-module-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No)
          (Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                call-expr
                (macro-missing-macro-message name))))])
      (match (macro-surface-call-decl-in-module
        (tc-context-expr-bases ctx)
        (tc-context-macro-state ctx)
        target-module-id
        base-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No)
          (if (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              target-module-id
              base-id
              (csym.compiler-symbols-missing-handle)))
            (Ok (No))
            (Err
              (box
                (ctfe_support.ctfe-diagnostic-at-expr
                  call-expr
                  (macro-missing-macro-message name)))))]))))

(define (macro-qualified-call-decl
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [hygiene-source-id : i64
      (macro-hygiene-global-source-name-id-or
        (tc-context-structural-session ctx)
        source-name-id
        source-name-id)]
    [source-id : i64 hygiene-source-id]
    [lookup-qualifier-id : i64 (tc-qualified-name-module-id lookup-name-id)]
    [source-qualifier-id : i64 (tc-qualified-name-module-id source-id)]
    [qualifier-id : i64
      (if (>= lookup-qualifier-id 0)
        lookup-qualifier-id
        (if (>= source-qualifier-id 0)
          source-qualifier-id
          definition-module-id))]
    [base-id : i64 (tc-qualified-name-base-id lookup-name-id)]
    (if (and (>= qualifier-id 0) (>= base-id 0))
      (let
        [target-module-id : i64
          (macro-resolve-qualified-module-id
            ctx
            decls
            (tc-context-module-id ctx)
            qualifier-id)]
        (macro-qualified-call-decl-in-module
          ctx
          target-module-id
          base-id
          name
          call-expr))
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            (str_cat.str-cat
              "typecheck: qualified macro has no source id: "
              name)))))))

;; The implicit core macro prelude module (stdlib/core_macros.tl). A bare name
;; that is not bound as a macro in the current module falls back to this module's
;; available macros, so `and`/`or`/`when`/`unless`/`cond` resolve without an
;; explicit import. Local macros and explicit imports therefore take
;; precedence over the prelude. Returns MacroMaybeDecl.No (an ordinary call, not an
;; error) when the name is not a prelude macro, leaving plain calls unaffected.
(define (macro-prelude-resolve-module
  [ctx : TcContext]
  [symbols : (& symbols csym.CompilerSymbols)]
  [module-id : i64]
  [lookup-id : i64]) : ResultMacroCallDecl
  ;; The implicit core_macros prelude resolves its macros straight from the
  ;; module's symbol table. core_macros declares exactly the prelude macros, so
  ;; this resolves the same set (`and`, `or`, `when`, `unless`, `cond`).
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        symbols
        module-id
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        symbols
        (csym.compiler-symbol-handle-index handle)
        module-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No) (Ok (No))])
      (Ok (No)))))

(define (macro-prelude-resolve
  [ctx : TcContext]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : ResultMacroCallDecl
  (let
    [maybe-decl : MacroMaybeDecl
      (try
        (macro-prelude-resolve-module
          ctx
          symbols
          cbi.compiler-builtin-id-core-macros-module
          lookup-id))]
    (match (tc-global-shared-view maybe-decl)
      [(No)
        ;; Compatibility fallback for sources loaded with the old module
        ;; identity before the core_macros spelling migration.
        (macro-prelude-resolve-module
          ctx
          symbols
          cbi.compiler-builtin-id-core-macros-legacy-module
          lookup-id)]
      [_ (Ok maybe-decl)])))

(define (macro-prelude-call-decl
  [ctx : TcContext]
  [_decls : ast.AstDeclList]
  [lookup-name-id : i64]
  [_call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (macro-prelude-resolve ctx (tc-context-symbols ctx) lookup-name-id))

(defstruct TcMacroResultIdentityStateData
  (table-id i64)
  (reset-generation i64)
  (source-count i64)
  (module-id i64)
  (macro-id i64))

(define (tc-macro-result-identity-state-address-initialize
  [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroResultIdentityStateData
    tc-macro-state-slot-result-identity
    (TcMacroResultIdentityStateData -1 -1 -1 -1 -1)))

(define (tc-macro-result-identity-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    9
    tc-macro-result-identity-state-address-initialize))

(define (tc-macro-result-identity-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroResultIdentityStateData)
  (tc-state-cell-ptr
    (tc-macro-result-identity-state-address state)
    TcMacroResultIdentityStateData))

(define (tc-macro-result-identity-state-view [state : TcMacroState]) : (Ptr
    TcMacroResultIdentityStateData)
  (tc-state-cell-view
    (tc-macro-result-identity-state-address state)
    TcMacroResultIdentityStateData))

(define (tc-macro-result-identity-state-data [state : TcMacroState]) : TcMacroResultIdentityStateData
  (tc-state-cell-read
    (tc-macro-result-identity-state-address state)
    TcMacroResultIdentityStateData))

(define (tc-macro-result-identity-state-data-set!
  [state : TcMacroState]
  [data : TcMacroResultIdentityStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-result-identity-state-address state)
    TcMacroResultIdentityStateData
    data))

(define (macro-stdlib-result-identity-ensure! [state : TcMacroState]) : unit
  (let
    [session : ci.InternSourceNameSession
      (tc-macro-state-source-name-session state)]
    [identity : (MutPtr TcMacroResultIdentityStateData)
      (tc-macro-result-identity-state-ptr state)]
    (unsafe
      (unless
        (and
          (= (deref identity).table-id session.table-id)
          (= (deref identity).reset-generation session.reset-generation)
          (= (deref identity).source-count session.source-count))
        (set!
          (deref identity).module-id
          (match (ci.intern-source-name-session-lookup session "stdlib.result")
            [(InternLookupFound module-id) module-id]
            [(InternLookupMissing) -1]))
        (set!
          (deref identity).macro-id
          (match (ci.intern-source-name-session-lookup session "result")
            [(InternLookupFound macro-id) macro-id]
            [(InternLookupMissing) -1]))
        (set! (deref identity).table-id session.table-id)
        (set! (deref identity).reset-generation session.reset-generation)
        (set! (deref identity).source-count session.source-count)))))

(define (macro-refresh-stdlib-result-surface-if-needed!
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : unit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [_ensure : unit (macro-stdlib-result-identity-ensure! state)]
    [identity : (Ptr TcMacroResultIdentityStateData)
      (tc-macro-result-identity-state-view state)]
    (unsafe
      (if (and
        (= target-module-id (deref identity).module-id)
        (= lookup-name-id (deref identity).macro-id))
        (match (cload.compiler-load-surface-summary-find-module
          target-module-id)
          [(CompilerLoadSomeSurfaceSummary summary)
            (cload.compiler-load-surface-summary-refresh-with-pools
              summary.source-path
              summary.source-path-id
              (svec.new)
              (Some target-module-id)
              "stdlib"
              (parser.compiler-cfg-empty)
              (tc-context-pools ctx))
            ;; The surface parser pushes through the explicit context. The retry below
            ;; reads the retained body through ast-node-get, so publish that updated
            ;; context before materializing the macro declaration.
            (tc-context-install-pools! ctx)
            (macro-surface-call-decl-cache-reset! (tc-context-macro-state ctx))]
          [(CompilerLoadNoSurfaceSummary) unit])
        unit))))

(define (macro-unqualified-imported-target-call-decl
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]
  [_call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        lookup-name-id
        (csym.compiler-symbols-missing-handle))]
    ;; Resolve an imported macro that exists in the target module directly from
    ;; the symbol table.
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        target-module-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No) (Ok (No))])
      (match (macro-surface-call-decl-in-module
        (tc-context-expr-bases ctx)
        (tc-context-macro-state ctx)
        target-module-id
        lookup-name-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No)
          (macro-refresh-stdlib-result-surface-if-needed!
            ctx
            target-module-id
            lookup-name-id)
          (match (macro-surface-call-decl-in-module
            (tc-context-expr-bases ctx)
            (tc-context-macro-state ctx)
            target-module-id
            lookup-name-id)
            [(Some
                retry-name
                retry-module
                retry-declaration-id
                retry-params
                retry-ret
                retry-body)
              (Ok
                (Some
                  retry-name
                  retry-module
                  retry-declaration-id
                  retry-params
                  retry-ret
                  retry-body))]
            [(No) (Ok (No))])]))))

(define (macro-unqualified-imported-call-target
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : i64
  ;; Any macro present in the target module is a resolution candidate.
  (if (csym.compiler-symbols-handle-found?
    (csym.compiler-symbols-lookup-macro-in-module-id-or
      (tc-context-symbols ctx)
      target-module-id
      lookup-name-id
      (csym.compiler-symbols-missing-handle)))
    target-module-id
    (if (macro-surface-macro-in-module? target-module-id lookup-name-id)
      target-module-id
      -1)))

(define (macro-unqualified-imported-call-target-from-imports
  [ctx : TcContext]
  [targets : MacroFlatImportTargetList]
  [lookup-name-id : i64]) : i64
  (let
    [slots : (__tl_dyn-array i64) targets.slots]
    [len : i64 targets.len]
    [index : i64 0]
    [target : i64 -1]
    (while (if (= target -1)
      (< index len)
      false)
      (set!
        target
        (macro-unqualified-imported-call-target
          ctx
          (array-ref slots index)
          lookup-name-id))
      (set! index (+ index 1)))
    target))

(define (macro-unqualified-imported-call-decl-from-target
  [ctx : TcContext]
  [target : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (>= target 0)
    (macro-unqualified-imported-target-call-decl
      ctx
      target
      lookup-name-id
      call-expr)
    (Ok (No))))

(define (macro-unqualified-imported-call-decl-cached
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-import-cache-ensure! (tc-context-macro-state ctx))
  (let
    [cached : i64
      (macro-unqualified-import-cache-get
        (tc-context-macro-state ctx)
        module-id
        lookup-name-id)]
    [target : i64
      (if (= cached -2)
        (let
          [resolved : i64
            (macro-unqualified-imported-call-target-from-imports
              ctx
              (macro-flat-import-targets
                (tc-context-macro-state ctx)
                decls
                module-id)
              lookup-name-id)]
          (macro-unqualified-import-cache-put!
            (tc-context-macro-state ctx)
            module-id
            lookup-name-id
            resolved)
          resolved)
        cached)]
    (macro-unqualified-imported-call-decl-from-target
      ctx
      target
      lookup-name-id
      call-expr)))

(define (macro-unqualified-imported-call-decl
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-imported-call-decl-cached
    ctx
    decls
    module-id
    lookup-name-id
    call-expr))

(define (macro-unqualified-call-decl-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [_ : String]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        module-id
        lookup-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        module-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No) (Ok (No))])
      (match (macro-surface-call-decl-in-module
        (tc-context-expr-bases ctx)
        (tc-context-macro-state ctx)
        module-id
        lookup-name-id)
        [(Some macro-name def-module declaration-id params ret body)
          (Ok (Some macro-name def-module declaration-id params ret body))]
        [(No)
          (let
            [imported-decl
              (try
                (macro-unqualified-imported-call-decl
                  ctx
                  (tc-global-shared-view decls)
                  module-id
                  lookup-name-id
                  (tc-global-shared-view call-expr)))]
            (match (tc-global-shared-view imported-decl)
              [(No)
                (macro-prelude-call-decl
                  (tc-context-with-module-id ctx module module-id)
                  decls
                  lookup-name-id
                  call-expr)]
              [_ (Ok imported-decl)]))]))))

(define (macro-call-decl-from-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [slash : i64 (tc-qualified-name-last-slash lookup-name)]
    (if (and (> slash 0) (< slash (- (string.string-length lookup-name) 1)))
      (macro-qualified-call-decl
        (tc-context-with-module-id ctx module module-id)
        decls
        lookup-name
        lookup-name-id
        source-name-id
        definition-module-id
        call-expr)
      (macro-unqualified-call-decl-in-module
        ctx
        decls
        module
        module-id
        lookup-name
        lookup-name-id
        call-expr))))

(define (macro-call-decl-from-source-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (tc-source-legacy-core-macro-compat? (tc-global-shared-view lookup-name))
    (macro-call-decl-from-name
      ctx
      decls
      module
      module-id
      lookup-name
      lookup-name-id
      lookup-name-id
      -1
      call-expr)
    (let
      [source-ctx : TcContext
        (tc-context-with-program
          (tc-context-with-module-id
            ctx
            (tc-global-shared-view module)
            module-id)
          (ast.ast-program (tc-global-shared-view decls)))]
      (match (tc-source-type-name-lookup-from-id
        source-ctx
        lookup-name
        lookup-name-id)
        [(Ok resolved-name resolved-id)
          (macro-call-decl-from-name
            ctx
            decls
            module
            module-id
            resolved-name
            resolved-id
            lookup-name-id
            -1
            call-expr)]
        [(Err message)
          (Err (box (ctfe_support.ctfe-diagnostic-at-expr call-expr message)))]))))

(define (macro-call-decl-from-hygiene-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [definition-module : String]
  [definition-module-id : i64]
  [lookup-name : String]
  [lookup-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (< lookup-id 0)
    (Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          (str_cat.str-cat
            "typecheck: macro hygiene source id unavailable: "
            lookup-name))))
    (if (and
      (>=
        (tc-name-first-dot-id (tc-context-structural-session ctx) lookup-id)
        0)
      (not
        (tc-name-qualified-id? (tc-context-structural-session ctx) lookup-id))
      (< (tc-qualified-name-last-slash lookup-name) 0))
      (macro-call-decl-from-source-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        call-expr)
      (macro-call-decl-from-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        lookup-id
        definition-module-id
        call-expr))))

;; If `func` names a visible macro, return that macro's decl. Bare local macros
;; are module-scope visible regardless of source order; qualified macro calls
;; must pass the export table. A bare name not bound locally falls back to the
;; implicit core macro prelude.
(define (macro-call-decl
  [ctx : TcContext]
  [func : ast.AstExpr]
  [decls : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (match func
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _))
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(Var name)
      (if (or
        (csym.compiler-composite-pair-key-id? name)
        (csym.compiler-composite-triple-key-id? name))
        (macro-call-decl-from-name
          ctx
          decls
          (tc-context-module ctx)
          (macro-source-module-id (tc-context-module-id ctx))
          (tc-nominal-name-id-display name)
          name
          name
          -1
          call-expr)
        (if (tc-hygiene-global-name-id?
          (tc-context-structural-session ctx)
          name)
          (if (macro-hygiene-global-id?
            (tc-context-structural-session ctx)
            name)
            (let
              [module-id : i64
                (macro-hygiene-global-module-id
                  (tc-context-structural-session ctx)
                  name)]
              [lookup-name-id : i64
                (macro-hygiene-global-source-name-id-or
                  (tc-context-structural-session ctx)
                  name
                  -1)]
              (macro-call-decl-from-hygiene-name
                ctx
                decls
                (macro-decl-module-display module-id)
                (macro-source-module-id module-id)
                (ci.intern-str lookup-name-id)
                lookup-name-id
                call-expr))
            (match (tc-hygiene-global-decode (tc-env-key-name-text name))
              [(Legacy lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  (tc-context-module ctx)
                  (macro-source-module-id (ci.intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or
                    (tc-context-structural-session ctx)
                    name
                    -1)
                  call-expr)]
              [(Context module lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  module
                  (macro-source-module-id (ci.intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or
                    (tc-context-structural-session ctx)
                    name
                    -1)
                  call-expr)]))
          (macro-call-decl-from-source-name
            ctx
            decls
            (tc-context-module ctx)
            (macro-source-module-id (tc-context-module-id ctx))
            (tc-hygiene-name-text-id-for-session
              (tc-context-structural-session ctx)
              name)
            name
            call-expr)))]
    [_ (Ok (No))]))

(define (macro-call-decl-with-context
  [ctx : TcContext]
  [func : ast.AstExpr]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [context : ast.AstMaybeModuleName]
  [call-expr : ast.AstExpr]) : ResultMacroCallDeclModule
  (match (macro-call-decl
    (tc-context-with-module-id ctx (tc-global-shared-view module) module-id)
    (tc-global-shared-view func)
    (tc-global-shared-view decls)
    (tc-global-shared-view call-expr))
    [(Ok maybe-decl)
      (match (tc-global-shared-view maybe-decl)
        [(No)
          (match context
            [(Some context-module-id)
              (let
                [context-module : String (ci.intern-str context-module-id)]
                (if (= context-module-id module-id)
                  (Ok maybe-decl module module-id)
                  (let
                    [context-decl
                      (try
                        (macro-call-decl
                          (tc-context-with-module-id
                            ctx
                            (tc-global-shared-view context-module)
                            context-module-id)
                          func
                          decls
                          call-expr))]
                    (match (tc-global-shared-view context-decl)
                      [(No) (Ok maybe-decl module module-id)]
                      [_ (Ok context-decl context-module context-module-id)]))))]
            [(No) (Ok maybe-decl module module-id)])]
        [_ (Ok maybe-decl module module-id)])]
    [(Err primary-diag)
      (match context
        [(Some context-module-id)
          (let
            [context-module : String (ci.intern-str context-module-id)]
            (if (= context-module-id module-id)
              (Err primary-diag)
              (match (macro-call-decl
                (tc-context-with-module-id
                  ctx
                  (tc-global-shared-view context-module)
                  context-module-id)
                func
                decls
                call-expr)
                [(Ok context-decl)
                  (match (tc-global-shared-view context-decl)
                    [(No) (Err primary-diag)]
                    [_ (Ok context-decl context-module context-module-id)])]
                [(Err _) (Err primary-diag)])))]
        [(No) (Err primary-diag)])]))

(define (macro-operand-mismatch-message
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got "
    (tc-type-render actual)))

(define (macro-clause-shape-message) : String
  "typecheck: ExprClause macro operand expects bracket clause [expr expr ...]")

(define (macro-binding-clause-shape-message) : String
  "typecheck: ExprBindingClause macro operand expects bracket clause [name expr] or [name : Type expr]")

(define (macro-clause-operand-mismatch-message [expected : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got bracket clause"))

(define (macro-type-arg-module-qualify-id [ctx : TcContext] [name : i64]) : i64
  (let
    [module : String (tc-context-module ctx)]
    [structural-session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (macro-hygiene-global-id? structural-session name))
      (not (tc-structural-local-name-id? structural-session name))
      (not (csym.compiler-composite-pair-key-id? name))
      (not (csym.compiler-composite-triple-key-id? name))
      (not (tc-name-qualified-id? structural-session name))
      (not
        (tc-source-slash-qualified-id?
          structural-session
          (tc-env-key-name-text name)
          name)))
      (tc-module-name-id-by-id (tc-context-module-id ctx) name)
      name)))

(define (macro-type-arg-module-qualify-list
  [ctx : TcContext]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (macro-type-arg-module-qualify-list-at ctx (& types) 0))

(define (macro-type-arg-module-qualify-list-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (macro-type-arg-module-qualify
          ctx
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (& (macro-type-arg-module-qualify-list-at ctx types (+ index 1))))))

(define (macro-type-arg-module-qualify [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (ast.ast-ty-func
        (macro-type-arg-module-qualify-list
          ctx
          (ast.ast-type-list-box-shared-view args))
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get ret))))]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (macro-type-arg-module-qualify-list
          ctx
          (ast.ast-type-list-box-shared-view elems)))]
    [(Array elem len)
      (ast.ast-ty-array
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))
        len)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))))]
    [(Slice elem)
      (ast.ast-ty-slice
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))))]
    [(Box elem)
      (ast.ast-ty-box
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))))]
    [(Ptr elem)
      (ast.ast-ty-ptr
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))))]
    [(Ref region inner)
      (ast.ast-ty-ref
        region
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get inner))))]
    [(MutRef region inner)
      (ast.ast-ty-mut-ref
        region
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get inner))))]
    [(Region region inner)
      (ast.ast-ty-region
        region
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get inner))))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        lifetime
        (& (macro-type-arg-module-qualify ctx (ast.ty-node-get inner))))]
    [(Var name) (Var (macro-type-arg-module-qualify-id ctx name))]
    [(VarArgs name lifetimes)
      (ast.ast-ty-var-args
        (macro-type-arg-module-qualify-id ctx name)
        (ast.ast-lifetime-list-box-shared-view lifetimes))]
    [_ ty]))

(define (macro-type-arg-reflections-from-decls [decls : ast.AstDeclList]) : ctfe_support.CtfeReflectInfoList
  (ctfe_support.ctfe-build-seen-reset!)
  (ctfe_support.ctfe-reflections-from-decls
    (tc-global-shared-view decls)
    ""
    cbi.compiler-builtin-id-fix-empty
    (ctfe_support.ctfe-reflect-info-list-with-capacity
      (ctfe_support.ctfe-metadata-decl-capacity decls))))

(define (macro-type-arg-reflect-resolve
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [ty : ast.AstType]) : ast.AstType
  (let
    [infos : ctfe_support.CtfeReflectInfoList
      (macro-type-arg-reflections-from-decls decls)]
    [reflected : ast.AstType
      (ctfe_support.ctfe-reflect-resolve-type-with-pools
        (tc-context-pools ctx)
        infos
        ty)]
    (if (tc-type-needs-resolution-for-context?
      ctx
      (tc-global-shared-view reflected))
      (let
        [qualified-reflected : ast.AstType
          (ctfe_support.ctfe-reflect-resolve-type-with-pools
            (tc-context-pools ctx)
            infos
            (macro-type-arg-module-qualify
              ctx
              (tc-global-shared-view reflected)))]
        (if (tc-type-needs-resolution-for-context?
          ctx
          (tc-global-shared-view qualified-reflected))
          reflected
          qualified-reflected))
      reflected)))

(define (macro-type-arg-resolve
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (if (tc-type-needs-resolution-for-context?
      ctx
      (tc-global-shared-view resolved))
      (let
        [reflected : ast.AstType
          (macro-type-arg-reflect-resolve ctx decls resolved)]
        (if (tc-type-needs-resolution-for-context?
          ctx
          (tc-global-shared-view reflected))
          (macro-type-arg-module-qualify ctx reflected)
          reflected))
      resolved)))

(define (macro-type-arg-source-policy-ok [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (match (tc-resolve-type ctx (tc-global-shared-view ty))
    [(Slice elem)
      ;; A top-level Slice is a compile-time type operand, not a runtime
      ;; storage declaration.  Keep the runtime policy for every nested shape
      ;; while validating the element recursively.
      (tc-source-type-policy-ok ctx (ast.ty-node-get elem))]
    [_ (tc-source-type-policy-ok ctx ty)]))

(define (macro-type-arg
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [arg : ast.AstExpr]) : ResultMacroTypeArg
  (tc-context-capture-active-pools! ctx)
  (match (ctfe_support.ctfe-expr-to-type
    (tc-global-shared-view arg)
    (tc-global-shared-view arg)
    (ctfe_support.ctfe-env-empty-with-pools (tc-context-pools ctx))
    (ctfe_support.ctfe-fuel-limit))
    [(Ok ty _)
      (match (macro-type-arg-source-policy-ok ctx (tc-global-shared-view ty))
        [(Ok) (Ok (macro-type-arg-resolve ctx decls ty))]
        [(Err message)
          (Err (box (ctfe_support.ctfe-diagnostic-at-expr arg message)))])]
    [(Err diag) (Err diag)]))

(define (macro-type-arg-with-fallback
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : ast.AstExpr]) : ResultMacroTypeArg
  (match (macro-type-arg
    ctx
    (tc-global-shared-view decls)
    (tc-global-shared-view arg))
    [(Ok resolved-ty) (Ok resolved-ty)]
    [(Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (Err primary-diag)
        (match (macro-type-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          decls
          arg)
          [(Ok resolved-ty) (Ok resolved-ty)]
          [(Err _) (Err primary-diag)]))]))

(define (macro-type-kind-list-render-from
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [index : i64]) : String
  (if (>= index (ast.ast-macro-type-kind-list-len kinds))
    ""
    (str_cat.str-cat
      (if (= index 0)
        ""
        ", ")
      (ci.intern-str (ast.ast-macro-type-kind-list-get kinds index 0))
      (macro-type-kind-list-render-from kinds (+ index 1)))))

(define (macro-type-kind-list-render
  [kinds : (& kinds ast.AstMacroTypeKindList)]) : String
  (macro-type-kind-list-render-from kinds 0))

(define (macro-type-kind-list-contains-text-from?
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [index : i64]
  [kind : String]) : bool
  (if (>= index (ast.ast-macro-type-kind-list-len kinds))
    false
    (if (string.eq
      (ci.intern-str (ast.ast-macro-type-kind-list-get kinds index 0))
      kind)
      true
      (macro-type-kind-list-contains-text-from? kinds (+ index 1) kind))))

(define (macro-type-kind-list-contains-text?
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [kind : String]) : bool
  (macro-type-kind-list-contains-text-from? kinds 0 kind))

(define (macro-type-kind-constraint-message
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : ast.AstType]
  [type-kinds : (& type-kinds ast.AstMacroTypeKindList)]) : String
  (str_cat.str-cat
    "typecheck: macro "
    (tc-name-slashes-to-dots macro-name)
    " type operand "
    (ci.intern-str param-name)
    " rejects "
    (tc-type-render resolved-ty)
    ": expected one of :kind "
    (macro-type-kind-list-render type-kinds)))

(define (macro-validate-type-kind-constraint
  [ctx : TcContext]
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : ast.AstType]
  [type-kinds : (& type-kinds ast.AstMacroTypeKindList)]
  [arg-expr : ast.AstExpr]) : ResultMacroCheck
  (if (ast.ast-macro-type-kind-list-empty? type-kinds)
    Ok
    (let
      [empty-infos : ctfe_support.CtfeReflectInfoList
        (ctfe_support.ctfe-reflect-info-list-empty)]
      [actual-kind : String
        (ctfe_support.ctfe-type-kind-with-reflections-and-pools
          (tc-context-pools ctx)
          empty-infos
          (tc-global-shared-view resolved-ty))]
      (if (macro-type-kind-list-contains-text? type-kinds actual-kind)
        Ok
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              arg-expr
              (macro-type-kind-constraint-message
                macro-name
                param-name
                resolved-ty
                type-kinds))))))))

(define (macro-module-strategy-unknown-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown module strategy "
    name
    "; import the module or use a visible dotted module alias"))

(define (macro-module-strategy-arg [ctx : TcContext] [arg : ast.AstExpr]) : ResultMacroModuleArg
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& arg))
    [(Var name-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            name-id
            name-id)]
        [name : String (ci.intern-str source-id)]
        (if (tc-source-slash-qualified-id?
          (tc-context-structural-session ctx)
          (tc-global-shared-view name)
          source-id)
          (Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                arg
                (tc-source-slash-qualified-message name))))
          (let
            [program : ast.AstProgram (tc-context-program ctx)]
            [current-module : String (tc-context-module ctx)]
            [current-module-id : i64 (tc-context-module-id ctx)]
            (match program
              [(Program decls-box)
                (match (macro-import-alias-target-cached-id-in-context
                  ctx
                  (ast.ast-decl-list-box-shared-view decls-box)
                  current-module-id
                  name-id)
                  [(Some target-id)
                    (Ok (tc-env-key-name-text target-id) target-id)]
                  [(No)
                    (if (or
                      (string.eq name current-module)
                      (tc-imported-module-identity-id? ctx name-id))
                      (Ok name source-id)
                      (Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            arg
                            (macro-module-strategy-unknown-message name)))))])]))))]
    [_
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: Module macro operand expects a module name")))]))

(define (macro-module-strategy-arg-with-fallback
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : ast.AstExpr]) : ResultMacroModuleArg
  (match (macro-module-strategy-arg ctx (tc-global-shared-view arg))
    [(Ok module module-id) (Ok module module-id)]
    [(Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (Err primary-diag)
        (match (macro-module-strategy-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          arg)
          [(Ok module module-id) (Ok module module-id)]
          [(Err _) (Err primary-diag)]))]))

(define (macro-expr-clause-shape-error [arg : ast.AstExpr]) : ResultMacroClause
  (Err
    (box
      (ctfe_support.ctfe-diagnostic-at-expr arg (macro-clause-shape-message)))))

;; `[first second]` captures both expressions. Like a `let` body, a clause body
;; may be several forms, `[first form ...]`, captured as one implicit `begin`
;; pushed into the checked program's pool; a `:` after the first element is
;; binding-clause syntax and stays rejected.
(define (macro-expr-clause-from-items
  [ctx : TcContext]
  [arg : ast.AstExpr]
  [items : ast.AstExprList]) : ResultMacroClause
  (cond
    [(< items.len 2) (macro-expr-clause-shape-error arg)]
    [(= items.len 2)
      (Ok
        (ast.ast-expr-clause
          (ast.ast-expr-list-get (& items) 0 0)
          (ast.ast-expr-list-get (& items) 1 0)))]
    [(macro-expr-colon?
        (tc-context-expr-bases ctx)
        (ast.ast-expr-list-get (& items) 1 0))
      (macro-expr-clause-shape-error arg)]
    [else
      (Ok
        (ast.ast-expr-clause
          (ast.ast-expr-list-get (& items) 0 0)
          (tc-context-expr-push-cell-addresses
            (tc-context-expr-cell-address-live ctx)
            (tc-context-type-cell-address-live ctx)
            (Begin (ast.ast-expr-list-tail-from-ref (& items) 1)))))]))

(define (macro-expr-clause-from-arg [ctx : TcContext] [arg : ast.AstExpr]) : ResultMacroClause
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& arg))
    [(BracketClause items) (macro-expr-clause-from-items ctx arg items)]
    [_
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprClause macro operand expects bracket syntax")))]))

(define (macro-expr-clause-list-from-args
  [ctx : TcContext]
  [args : ast.AstExprList]) : ResultMacroClauseList
  (let
    [out : ast.AstExprClauseList
      (ast.ast-expr-clause-list-with-capacity args.len)]
    [_ (try (macro-expr-clause-list-from-args-into ctx (& args) 0 (&mut out)))]
    (Ok out)))

(define (macro-expr-clause-list-from-args-into
  [ctx : TcContext]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          (tc-context-expr-bases ctx)
          (ast.ast-expr-list-get args index 0))]
      [clause (try (macro-expr-clause-from-arg ctx head-expr))]
      (ast.ast-expr-clause-list-push out clause)
      (macro-expr-clause-list-from-args-into ctx args (+ index 1) out))))

(define (macro-expr-span-or-zero [expr-bases : i64] [arg : ast.AstExpr]) : ast.AstSourceSpan
  (match arg
    [(Spanned _ span) span]
    [(MacroExpansion inner-box _ _)
      (macro-expr-span-or-zero
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (ast.ast-source-span 0 0 0 0)]))

(define (macro-expr-colon? [expr-bases : i64] [expr-id : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    expr-bases
    (& (ast.ast-expr-segment-bases-get expr-bases expr-id)))
    [(Var name) (= name cbi.compiler-builtin-id-fix-colon)]
    [_ false]))

(define (macro-expr-binding-clause-shape-error [arg : ast.AstExpr]) : ResultMacroBindingClause
  (Err
    (box
      (ctfe_support.ctfe-diagnostic-at-expr
        arg
        (macro-binding-clause-shape-message)))))

(define (macro-expr-binding-clause-from-name
  [expr-bases : i64]
  [arg : ast.AstExpr]
  [name : i64]
  [rest : ast.AstExprList]) : ResultMacroBindingClause
  (let
    [len : i64 rest.len]
    (if (<= len 0)
      (macro-expr-binding-clause-shape-error arg)
      (let
        [first : i64 (ast.ast-expr-list-get (& rest) 0 0)]
        (if (macro-expr-colon? expr-bases first)
          (if (= len 3)
            (Ok
              (ast.ast-expr-binding-clause-id
                (ci.intern-syntax-id-from-raw name)
                true
                (ast.ast-expr-list-get (& rest) 1 0)
                (ast.ast-expr-list-get (& rest) 2 0)
                (ctfe_support.ctfe-untyped-expr-type)
                (macro-expr-span-or-zero expr-bases arg)))
            (macro-expr-binding-clause-shape-error arg))
          (if (= len 1)
            (Ok
              (ast.ast-expr-binding-clause-id
                (ci.intern-syntax-id-from-raw name)
                false
                (ast.ast-node-push (Literal (Unit)))
                first
                (ctfe_support.ctfe-untyped-expr-type)
                (macro-expr-span-or-zero expr-bases arg)))
            (macro-expr-binding-clause-shape-error arg)))))))

(define (macro-expr-binding-clause-from-items
  [expr-bases : i64]
  [arg : ast.AstExpr]
  [items : ast.AstExprList]) : ResultMacroBindingClause
  (if (ast.ast-expr-list-empty? (& items))
    (macro-expr-binding-clause-shape-error arg)
    (let
      [name-expr : i64 (ast.ast-expr-list-get (& items) 0 0)]
      (match (ast.ast-expr-unspan-with-segment-bases
        expr-bases
        (& (ast.ast-expr-segment-bases-get expr-bases name-expr)))
        [(Var name)
          (macro-expr-binding-clause-from-name
            expr-bases
            arg
            name
            (ast.ast-expr-list-tail-from-ref (& items) 1))]
        [_ (macro-expr-binding-clause-shape-error arg)]))))

(define (macro-expr-binding-clause-from-arg
  [expr-bases : i64]
  [arg : ast.AstExpr]) : ResultMacroBindingClause
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(BracketClause items)
      (macro-expr-binding-clause-from-items expr-bases arg items)]
    [_
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprBindingClause macro operand expects bracket syntax")))]))

(define (macro-expr-binding-clause-list-from-args
  [expr-bases : i64]
  [args : ast.AstExprList]) : ResultMacroBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity args.len)]
    [_
      (try
        (macro-expr-binding-clause-list-from-args-into
          expr-bases
          (& args)
          0
          (&mut out)))]
    (Ok out)))

(define (macro-expr-binding-clause-list-from-args-into
  [expr-bases : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get args index 0))]
      [clause (try (macro-expr-binding-clause-from-arg expr-bases head-expr))]
      (ast.ast-expr-binding-clause-list-push out clause)
      (macro-expr-binding-clause-list-from-args-into
        expr-bases
        args
        (+ index 1)
        out))))

(define (macro-expr-binding-clause-prefix-from-args
  [expr-bases : i64]
  [args : (& args ast.AstExprList)]
  [start : i64]) : ResultMacroBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity (- args.len start))]
    [_
      (try
        (macro-expr-binding-clause-prefix-from-args-into
          expr-bases
          args
          start
          (&mut out)))]
    (Ok out)))

(define (macro-expr-binding-clause-prefix-from-args-into
  [expr-bases : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get args index 0))]
      (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& head-expr))
        [(BracketClause _)
          (let
            [clause
              (try (macro-expr-binding-clause-from-arg expr-bases head-expr))]
            (ast.ast-expr-binding-clause-list-push out clause)
            (macro-expr-binding-clause-prefix-from-args-into
              expr-bases
              args
              (+ index 1)
              out))]
        [_ Ok]))))

(define (macro-signature-resolution-context-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]) : TcContext
  (if (> (string.string-length fallback-module) 0)
    (tc-context-with-module-id ctx fallback-module fallback-module-id)
    ctx))

(define (macro-normalize-signature-syntax-type [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Var name)
      (match (tc-stdlib-comptime-syntax-type-id name)
        [(Some syntax-ty) syntax-ty]
        [(No) ty])]
    [_ ty]))

(define (macro-diagnostic-with-active-path
  [ctx : TcContext]
  [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (cdiag.compiler-diagnostic-with-fallback-path
    diag
    (macro-active-decl-path ctx)))

(define (macro-resolve-signature-type-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : ast.AstType
  (macro-normalize-signature-syntax-type
    (tc-resolve-type
      (macro-signature-resolution-context-id
        ctx
        fallback-module
        fallback-module-id)
      (tc-macro-signature-type ty))))

(define (macro-check-ordinary-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (if (tc-type-eq (tc-global-shared-view resolved-expected) (Expr))
    Ok
    (let
      [macro-state : TcMacroState (tc-context-macro-state ctx)]
      [journal-mark : i64 (tc-dotted-macro-journal-start! macro-state)]
      [result : ResultMacroCheck
        (match (tc-expr-with-expected-or-actual
          ctx
          env
          (tc-global-shared-view arg)
          (tc-global-shared-view resolved-expected))
          [(Ok actual)
            (if (tc-type-compatible?
              (tc-global-shared-view resolved-expected)
              (tc-global-shared-view actual))
              Ok
              (Err
                (box
                  (macro-diagnostic-with-active-path
                    ctx
                    (tc-expr-diag
                      (tc-context-expr-bases ctx)
                      arg
                      (macro-operand-mismatch-message resolved-expected actual))))))]
          [(Err message)
            (Err
              (box
                (macro-diagnostic-with-active-path
                  ctx
                  (tc-expr-diag
                    (tc-context-expr-bases ctx)
                    arg
                    (if (tc-encoded-error? message)
                      message
                      (tc-message-with-prefix
                        "typecheck: macro operand typecheck failed: "
                        message))))))])]
      (tc-dotted-macro-journal-restore-to! macro-state journal-mark)
      result)))

(define (macro-operand-bracket-clause? [expr-bases : i64] [arg : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(BracketClause _) true]
    [_ false]))

(define (macro-check-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? (tc-global-shared-view expected))
    (let
      [_
        (try
          (macro-type-arg
            ctx
            (match (tc-context-program ctx)
              [(Program decls-box)
                (ast.ast-decl-list-box-shared-view decls-box)])
            arg))]
      Ok)
    (macro-check-operand-with-resolved
      ctx
      env
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        expected)
      arg)))

;; Operand check for a param whose signature type is already resolved;
;; callers that resolve once for several checks use this entry directly.
(define (macro-check-operand-with-resolved
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (cond
    [(tc-macro-expr-clause-type? (tc-global-shared-view resolved-expected))
      (let
        [_ (try (macro-expr-clause-from-arg ctx arg))]
        Ok)]
    [(tc-macro-expr-binding-clause-type?
        (tc-global-shared-view resolved-expected))
      (let
        [_
          (try
            (macro-expr-binding-clause-from-arg (tc-context-expr-bases ctx) arg))]
        Ok)]
    [(macro-operand-bracket-clause?
        (tc-context-expr-bases ctx)
        (tc-global-shared-view arg))
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            (macro-clause-operand-mismatch-message resolved-expected))))]
    [else (macro-check-ordinary-operand ctx env resolved-expected arg)]))

(define (macro-check-variadic-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [args : (& args ast.AstExprList)]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? (tc-global-shared-view expected))
    (macro-check-variadic-operands-at
      ctx
      env
      fallback-module
      fallback-module-id
      expected
      (& args)
      0)
    ;; Resolve the shared signature type once for the whole operand list
    ;; instead of once per operand.
    (macro-check-variadic-operands-resolved-at
      ctx
      env
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        expected)
      (& args)
      0)))

(define (macro-check-variadic-operands-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      [_
        (try
          (macro-check-operand
            ctx
            env
            (tc-global-shared-view fallback-module)
            fallback-module-id
            (tc-global-shared-view expected)
            head))]
      (macro-check-variadic-operands-at
        ctx
        env
        fallback-module
        fallback-module-id
        expected
        args
        (+ index 1)))))

(define (macro-check-variadic-operands-resolved-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      [_
        (try
          (macro-check-operand-with-resolved
            ctx
            env
            (tc-global-shared-view resolved-expected)
            head))]
      (macro-check-variadic-operands-resolved-at
        ctx
        env
        resolved-expected
        args
        (+ index 1)))))

(define (macro-param-expr-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : bool
  (tc-macro-expr-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-param-expr-binding-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : bool
  (tc-macro-expr-binding-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-captured-expr-type-with-context
  [ctx : TcContext]
  [ty : ast.AstType]) : ast.AstType
  (Region
    (ctfe_support.ctfe-captured-expr-type-id)
    (tc-context-type-push ctx ty)))

(define (macro-caller-origin-expr-type-with-context
  [ctx : TcContext]
  [ty : ast.AstType]
  [path-id : i64]) : ast.AstType
  (if (< path-id 0)
    ty
    (Region
      (ctfe_support.ctfe-caller-origin-expr-type-id)
      (ci.intern-composite-pair-id path-id (tc-context-type-push ctx ty)))))

;; Typecheck `expr` for a caller that keeps only a successful type and drops any
;; error unseen. The suppression scope is closed on both outcomes before the
;; result is inspected.
(define (tc-expr-discarding-errors
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcType
  (tc-unbound-suggestions-suppress-push! env)
  (let
    [observer : TcSemanticObserver (tc-context-semantic-observer ctx)]
    [_suspend : unit
      (when
        (!= observer.address 0)
        (tc-context-set-semantic-observer! ctx (TcSemanticObserver 0))
        (tc-scoped-state-set-semantic-observer!
          (tc-type-env-scoped-state env)
          (TcSemanticObserver 0)))]
    [result : ResultTcType (tc-expr ctx env expr)]
    (when
      (!= observer.address 0)
      (tc-context-set-semantic-observer! ctx observer)
      (tc-scoped-state-set-semantic-observer!
        (tc-type-env-scoped-state env)
        observer))
    (tc-unbound-suggestions-suppress-pop! env)
    result))

(define (macro-captured-expr-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [capture-expr-types : bool]
  [arg : ast.AstExpr]) : ast.AstType
  (if (tc-type-eq (tc-global-shared-view resolved-expected) (Expr))
    (if capture-expr-types
      (begin
        ;; Capturing the operand can append caller-origin expression wrappers
        ;; through the owned context before speculative typechecking starts.
        ;; Publish those nodes first, then retain any expression/type children
        ;; appended by `tc-expr` before allocating the captured-type wrapper.
        (tc-context-install-pools! ctx)
        (match (tc-expr-discarding-errors ctx env arg)
          [(Ok actual)
            (tc-context-capture-active-pools! ctx)
            (let
              [captured : ast.AstType
                (ctfe_support.ctfe-captured-expr-type-with-pools
                  (tc-context-pools ctx)
                  (tc-resolve-type ctx actual))]
              (tc-context-install-pools! ctx)
              captured)]
          [(Err _) (ctfe_support.ctfe-untyped-expr-type)]))
      (ctfe_support.ctfe-untyped-expr-type))
    resolved-expected))

(define (macro-captured-binding-init-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ast.AstType
  ;; As in `macro-captured-expr-produced-type`: the clause list and earlier
  ;; clauses' caller-origin wrappers were appended through `ctx`. Publish
  ;; them before the speculative check pushes through the global pushers, or
  ;; a fresh structural type such as a `Slice` element reuses an id those
  ;; nodes hold and type resolution recurses forever.
  (tc-context-publish-newer-pools! ctx)
  (match (tc-expr-discarding-errors ctx env arg)
    [(Ok actual)
      ;; Binding-clause initializers can append structural referent types
      ;; after the context snapshot used to begin macro expansion. Refresh
      ;; before pushing the wrapper so those type IDs cannot alias.
      (tc-context-capture-active-pools! ctx)
      (let
        [captured : ast.AstType
          (macro-captured-expr-type-with-context
            ctx
            (tc-resolve-type ctx actual))]
        (tc-context-install-pools! ctx)
        captured)]
    [(Err _) (ctfe_support.ctfe-untyped-expr-type)]))

;; The declaration a call head names, as the `module/name` key the
;; typechecker resolves it to, when that declaration is a `define`d function of
;; a named module; otherwise -1. The head is resolved the way a call target is
;; at this site: a local binding (bare, or the leading segment of a dotted
;; place) shadows every declaration, and hygiene names, macro heads, values,
;; constructors, variants, externs, dispatches and root-module functions report
;; none. The key's module and name must be those of the declaration it maps
;; to, since an import alias can map a key to another module's declaration.
(define (macro-call-head-function-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [call : ast.AstExpr]) : i64
  (let
    [session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    (match (ast.ast-expr-unspan-with-segment-bases
      (tc-context-expr-segment-bases ctx)
      (& func))
      [(Var name)
        (if (or
          (not (tc-env-key-has-name-id? name))
          (tc-hygiene-global-name-id? session name)
          (tc-hygiene-local-name-id? session name)
          (and
            (tc-type-env-scoped-runtime-active? env)
            (>= (tc-type-env-scoped-runtime-lookup-index env name) 0))
          (tc-name-local-bound-before-module-scan-id? env name)
          (tc-dotted-place-name-id? ctx env name))
          -1
          (match (tc-unqualified-import-ambiguity-message ctx env name)
            [(Some _) -1]
            [(No)
              (match (tc-source-name-lookup-key-with-field-check-lookup
                ctx
                env
                (tc-hygiene-name-text-id-for-session session name)
                name
                false)
                [(Err _) -1]
                [(Ok _ key)
                  (let
                    [module-id : i64 (tc-qualified-name-module-id key)]
                    [base-id : i64 (tc-qualified-name-base-id key)]
                    [handle : i64
                      (if (and
                        (csym.compiler-composite-pair-key-id? key)
                        (ci.intern-renderable-id? module-id)
                        (ci.intern-renderable-id? base-id)
                        (not (csym.compiler-symbol-root-module-id? module-id)))
                        (csym.compiler-symbols-lookup-value-in-module-id-or
                          (tc-context-symbols ctx)
                          module-id
                          base-id
                          (csym.compiler-symbols-missing-handle))
                        (csym.compiler-symbols-missing-handle))]
                    (if (and
                      (csym.compiler-symbols-handle-found? handle)
                      (=
                        (csym.compiler-symbol-handle-kind handle)
                        (csym.compiler-symbol-kind-function-define))
                      (=
                        (csym.compiler-symbols-owner-module-id-at-index-or
                          (tc-context-symbols ctx)
                          (csym.compiler-symbol-handle-index handle)
                          -1)
                        module-id)
                      (match (csym.compiler-symbols-decl-at-index
                        (tc-context-symbols ctx)
                        (csym.compiler-symbol-handle-index handle))
                        [(Ok decl)
                          (match (ast.ast-decl-unwrapped (& decl))
                            [(DefFn _ decl-name _ _ _ _) (= decl-name base-id)]
                            [_ false])]
                        [(Err _) false])
                      ;; The checked call reads the head's type from this
                      ;; binding; without it the call does not resolve here.
                      (match (tc-lookup-unsafe-key-id
                        env
                        (tc-env-name-key-id session key))
                        [(Ok _ _) true]
                        [(Err _) false])
                      (match (tc-context-program ctx)
                        [(Program decls-box)
                          (match (macro-call-decl
                            ctx
                            (tc-global-shared-view func)
                            (ast.ast-decl-list-box-shared-view decls-box)
                            (tc-global-shared-view call))
                            [(Ok maybe-decl)
                              (match (tc-global-shared-view maybe-decl)
                                [(No) true]
                                [_ false])]
                            [(Err _) false])]))
                      key
                      -1))])]))]
      [_ -1])))

;; `macro-call-head-function-key` for a binding clause's initializer when it
;; is a call, otherwise -1.
(define (macro-captured-binding-init-callee-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init-id : i64]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& (tc-context-expr-get ctx init-id)))
    [(Call func-id _)
      (let
        [key : i64
          (macro-call-head-function-key
            ctx
            env
            (tc-context-expr-get ctx func-id)
            (tc-context-expr-get ctx init-id))]
        ;; Checking a dotted head for a local place can type its leading
        ;; segment through the global pushers. Adopt those nodes before the
        ;; transformer pushes through `ctx`.
        (tc-context-publish-newer-pools! ctx)
        key)]
    [_ -1]))

(define (macro-captured-binding-clause
  [ctx : TcContext]
  [env : TcTypeEnv]
  [capture-expr-types : bool]
  [clause : ast.AstExprBindingClause]) : ast.AstExprBindingClause
  (let
    [init-id : i64 clause.init]
    [init : ast.AstExpr (tc-context-expr-get ctx init-id)]
    [raw-init-produced : ast.AstType
      (if capture-expr-types
        (macro-captured-binding-init-produced-type ctx env init)
        clause.init-produced)]
    [init-produced : ast.AstType
      (macro-caller-origin-expr-type-with-context
        ctx
        raw-init-produced
        (macro-active-decl-path-id ctx))]
    ;; The origin/type payload is appended through the explicit context while
    ;; the variadic environment still observes the previously installed pool.
    ;; Publish it before another clause is checked or the transformer projects
    ;; this initializer and materializes its caller-origin expression marker.
    [_publish-captured : unit (tc-context-install-pools! ctx)]
    [callee-key : i64
      (if capture-expr-types
        (macro-captured-binding-init-callee-key ctx env init-id)
        -1)]
    (ast.AstExprBindingClause
      clause.name
      clause.has-type
      clause.ty
      init-id
      init-produced
      (if capture-expr-types
        (tc-qualified-name-module-id callee-key)
        clause.init-callee-module)
      (if capture-expr-types
        (tc-qualified-name-base-id callee-key)
        clause.init-callee-name)
      clause.span)))

(define (macro-captured-binding-clause-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [capture-expr-types : bool]
  [clauses : ast.AstExprBindingClauseList]) : ast.AstExprBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity clauses.len)]
    [index : i64 0]
    (while (< index clauses.len)
      (ast.ast-expr-binding-clause-list-push
        (&mut out)
        (macro-captured-binding-clause
          ctx
          env
          capture-expr-types
          (ast.ast-expr-binding-clause-list-get
            (& clauses)
            index
            (ast.ast-expr-binding-clause-fallback))))
      (set! index (+ index 1)))
    out))

;; Concrete variadic operands are checked before their transformer runs. That
;; check can advance the active caller pool beyond the definition pool held by
;; the CTFE environment. Preserve the newer pool on the bound syntax list so
;; CTFE constructors do not allocate over the checked operands.
(define (macro-captured-syntax-pools [env : ctfe_support.CtfeEnv]) : ctfe_support.CtfeMaybeSyntaxPools
  (let
    [definition-pools : ast.AstNodePoolContext
      (ctfe_support.ctfe-env-pools env)]
    [caller-pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-capture-active)]
    (if (>
      (ast.ast-node-pool-context-expr-len caller-pools)
      (ast.ast-node-pool-context-expr-len definition-pools))
      (Some caller-pools)
      (None))))

(define (macro-caller-origin-expr-list
  [ctx : TcContext]
  [args : ast.AstExprList]) : ast.AstExprList
  (let
    [count : i64 args.len]
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (let
        [arg-id : i64 (ast.ast-expr-list-get (& args) index 0)]
        [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
        (ast.ast-expr-list-push
          (&mut out)
          (macro-captured-expr-node
            ctx
            (tc-context-expr-cell-address-live ctx)
            (tc-context-type-cell-address-live ctx)
            arg-id
            arg
            true))
        (set! index (+ index 1))))
    out))

(define (macro-captured-expr-list-value
  [ctx : TcContext]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [args : ast.AstExprList]) : ctfe_support.CompilerCtfeValue
  (match syntax-pools
    [(Some pools)
      (let
        [captured-items : ast.AstExprList
          (macro-caller-origin-expr-list ctx args)]
        ;; Caller-origin wrapping appends through `ctx`, after `pools` was
        ;; selected. Advance the captured value's own state cell before CTFE
        ;; allocates a parent beside those wrappers.
        (ast.ast-node-pool-context-adopt-newer!
          (ast.ast-node-pool-context-shared-view (& pools))
          (tc-context-pools-live ctx))
        (CapturedExprList
          captured-items
          (ast.ast-node-pool-context-shared-view (& pools))))]
    [(None) (ExprList args)]))

(define (macro-caller-origin-expr-clause
  [ctx : TcContext]
  [clause : ast.AstExprClause]) : ast.AstExprClause
  (let
    [first-id : i64 clause.first]
    [second-id : i64 clause.second]
    (ast.AstExprClause
      (macro-captured-expr-node
        ctx
        (tc-context-expr-cell-address-live ctx)
        (tc-context-type-cell-address-live ctx)
        first-id
        (tc-context-expr-get ctx first-id)
        true)
      (macro-captured-expr-node
        ctx
        (tc-context-expr-cell-address-live ctx)
        (tc-context-type-cell-address-live ctx)
        second-id
        (tc-context-expr-get ctx second-id)
        true))))

(define (macro-caller-origin-expr-clause-list
  [ctx : TcContext]
  [clauses : ast.AstExprClauseList]) : ast.AstExprClauseList
  (let
    [count : i64 clauses.len]
    [out : ast.AstExprClauseList (ast.ast-expr-clause-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (ast.ast-expr-clause-list-push
        (&mut out)
        (macro-caller-origin-expr-clause
          ctx
          (ast.ast-expr-clause-list-get
            (& clauses)
            index
            (ast.ast-expr-clause-fallback))))
      (set! index (+ index 1)))
    out))

(define (macro-captured-expr-clause-list-value
  [ctx : TcContext]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [clauses : ast.AstExprClauseList]) : ctfe_support.CompilerCtfeValue
  (match syntax-pools
    [(Some pools)
      (let
        [captured-clauses : ast.AstExprClauseList
          (macro-caller-origin-expr-clause-list ctx clauses)]
        (ast.ast-node-pool-context-adopt-newer!
          (ast.ast-node-pool-context-shared-view (& pools))
          (tc-context-pools-live ctx))
        (CapturedExprClauseList
          captured-clauses
          (ast.ast-node-pool-context-shared-view (& pools))))]
    [(None) (ExprClauseList clauses)]))

(define (macro-captured-binding-clause-list-value
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [capture-expr-types : bool]
  [clauses : ast.AstExprBindingClauseList]) : ctfe_support.CompilerCtfeValue
  (ExprBindingClauseList
    (macro-captured-binding-clause-list ctx type-env capture-expr-types clauses)))

;; Operand checking can append typed proxy nodes to the active caller pool.
;; Select the capture pool only after that check, retaining an already selected
;; pool when it is newer still.
(define (macro-variadic-syntax-pools-after-check
  [env : ctfe_support.CtfeEnv]
  [current : ctfe_support.CtfeMaybeSyntaxPools]) : ctfe_support.CtfeMaybeSyntaxPools
  (match (macro-captured-syntax-pools env)
    [(Some active-pools)
      (match current
        [(Some current-pools)
          (if (>
            (ast.ast-node-pool-context-expr-len current-pools)
            (ast.ast-node-pool-context-expr-len active-pools))
            current
            (Some active-pools))]
        [(None) (Some active-pools)])]
    [(None) current]))

;; Binding-clause-list values carry child expression IDs but no pool-bearing
;; value variant. The scalar `for` shape needs the caller pool after checking
;; its prefix, while unrelated definition-owned suffixes must retain the
;; definition pool. Other captured values select their owner normally.
(define (macro-captured-param-syntax-pools-after-check
  [current : ctfe_support.CtfeMaybeSyntaxPools]
  [value : ctfe_support.CompilerCtfeValue]
  [rebase-binding-clauses? : bool]) : ctfe_support.CtfeMaybeSyntaxPools
  (match (tc-global-shared-view value)
    [(ExprBindingClauseList _)
      (if rebase-binding-clauses?
        (Some (ast.ast-node-pool-context-capture-active))
        current)]
    [_ (ctfe_support.ctfe-syntax-pools-for-value current value)]))

(define (macro-capture-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [name : i64]
  [ty : ast.AstType]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [capture-expr-types : bool]) : ResultMacroCapturedValue
  (cond
    [(tc-macro-type-param-kind? (tc-global-shared-view ty))
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            (Var name)
            "typecheck: type macro operand cannot be variadic")))]
    [(tc-macro-module-param-kind? (tc-global-shared-view ty))
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            (Var name)
            "typecheck: Module macro operand cannot be variadic")))]
    [(macro-param-expr-clause?
        ctx
        (tc-global-shared-view fallback-module)
        fallback-module-id
        (tc-global-shared-view ty))
      (let
        [clauses : ast.AstExprClauseList
          (try (macro-expr-clause-list-from-args ctx args))]
        (Ok
          (macro-captured-expr-clause-list-value
            ctx
            (macro-variadic-syntax-pools-after-check env syntax-pools)
            clauses)))]
    [(macro-param-expr-binding-clause?
        ctx
        (tc-global-shared-view fallback-module)
        fallback-module-id
        (tc-global-shared-view ty))
      (let
        [clauses : ast.AstExprBindingClauseList
          (try
            (macro-expr-binding-clause-list-from-args
              (tc-context-expr-bases ctx)
              args))]
        (Ok
          (macro-captured-binding-clause-list-value
            ctx
            type-env
            capture-expr-types
            clauses)))]
    [else
      (let
        [_
          (try
            (macro-check-variadic-operands
              ctx
              type-env
              fallback-module
              fallback-module-id
              ty
              args))]
        (Ok
          (macro-captured-expr-list-value
            ctx
            (macro-variadic-syntax-pools-after-check env syntax-pools)
            args)))]))

(define (macro-bind-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [name : i64]
  [ty : ast.AstType]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]) : ResultMacroEnv
  (let
    [value : ctfe_support.CompilerCtfeValue
      (try
        (macro-capture-variadic-param
          ctx
          type-env
          fallback-module
          fallback-module-id
          name
          ty
          args
          env
          (ctfe_support.ctfe-env-syntax-pools env)
          capture-expr-types))]
    ;; Binding-clause values carry child expression IDs but no pool-bearing
    ;; value variant. Rebase after operand typing so CTFE builders cannot
    ;; allocate over a newly appended borrow/place child and form a cycle.
    [captured-env : ctfe_support.CtfeEnv
      (match (& value)
        [(ExprBindingClauseList _)
          (ctfe_support.ctfe-env-rebase-syntax-pools
            env
            (ast.ast-node-pool-context-capture-active))]
        [_ env])]
    (Ok (ctfe_support.ctfe-env-extend-id captured-env name value))))

;; A direct caller string literal is the one `Expr` shape that public macro
;; code can inspect without evaluating. Keep its literal node in the active
;; CTFE pool instead of passing a transient macro-expansion proxy variable.
;; Other expressions retain their original node and hygiene unchanged.
(define (macro-private-place-bridge-name? [macro-name : (& macro-name str)]) : bool
  (or
    (string.eq macro-name "stdlib.core_macros/__tl-project-field")
    (string.eq macro-name "stdlib.core_macros/__tl-project-set-field")
    (string.eq macro-name "stdlib.core_macros/__tl-project-field-name")
    (string.eq macro-name "stdlib.core_macros/__tl-project-set-field-name")
    (string.eq macro-name "stdlib.core_macros/__tl-box-place")))

(define (macro-captured-expr-node
  [ctx : TcContext]
  [expr-cell-address : u64]
  [type-cell-address : u64]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [record-caller-origin : bool]) : i64
  (let
    [captured : i64
      (match (tc-global-shared-view arg-expr)
        [(Spanned inner span)
          (match (tc-context-expr-get ctx inner)
            [(Literal (String string-id))
              (tc-context-expr-push-cell-addresses
                expr-cell-address
                type-cell-address
                (Spanned
                  (tc-context-expr-push-cell-addresses
                    expr-cell-address
                    type-cell-address
                    (Literal (String string-id)))
                  span))]
            [_ arg-id])]
        [(Literal (String string-id))
          (tc-context-expr-push-cell-addresses
            expr-cell-address
            type-cell-address
            (Literal (String string-id)))]
        [_ arg-id])]
    [path-id : i64 (macro-active-decl-path-id ctx)]
    [out : i64
      (if record-caller-origin
        (match (tc-expr-maybe-span (tc-context-expr-bases ctx) arg-expr)
          [(Some span)
            (tc-context-expr-push-cell-addresses
              expr-cell-address
              type-cell-address
              (Spanned
                (tc-context-expr-push-cell-addresses
                  expr-cell-address
                  type-cell-address
                  (MacroExpansion
                    captured
                    (macro-expansion-provenance-id -1 path-id)
                    -1))
                span))]
          [(No) captured])
        captured)]
    out))

(define (macro-env-extend-captured-param
  [env : ctfe_support.CtfeEnv]
  [name : i64]
  [ty : ast.AstType]
  [value : ctfe_support.CompilerCtfeValue]) : ctfe_support.CtfeEnv
  (if (tc-macro-module-param-kind? ty)
    (ctfe_support.ctfe-env-extend-typed-id env name value (String))
    (ctfe_support.ctfe-env-extend-id env name value)))

(define (macro-capture-fixed-param
  [ctx : TcContext]
  [expr-cell-address : u64]
  [type-cell-address : u64]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [name : i64]
  [ty : ast.AstType]
  [type-kinds : ast.AstMacroTypeKindList]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [capture-expr-types : bool]) : ResultMacroCapturedValue
  (cond
    [(tc-macro-type-param-kind? (tc-global-shared-view ty))
      (let
        [resolved-ty
          (try
            (macro-type-arg-with-fallback
              ctx
              decls
              fallback-module
              fallback-module-id
              (tc-global-shared-view arg-expr)))]
        [_
          (try
            (macro-validate-type-kind-constraint
              ctx
              macro-name
              name
              (tc-global-shared-view resolved-ty)
              (& type-kinds)
              arg-expr))]
        (Ok (Type resolved-ty)))]
    [(tc-macro-module-param-kind? (tc-global-shared-view ty))
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        fallback-module-id
        arg-expr)
        [(Ok module module-id) (Ok (String module module-id))]
        [(Err diag) (Err diag)])]
    [else
      ;; Every remaining param kind needs the resolved signature type;
      ;; resolve it once instead of once per kind predicate plus once per
      ;; operand check.
      (let
        [resolved-expected : ast.AstType
          (macro-resolve-signature-type-id
            ctx
            fallback-module
            fallback-module-id
            ty)]
        (cond
          [(tc-macro-expr-clause-type?
              (tc-global-shared-view resolved-expected))
            (let
              [clause : ast.AstExprClause
                (try (macro-expr-clause-from-arg ctx arg-expr))]
              (Ok (ExprClause (macro-caller-origin-expr-clause ctx clause))))]
          [(tc-macro-expr-binding-clause-type?
              (tc-global-shared-view resolved-expected))
            (let
              [clause : ast.AstExprBindingClause
                (try
                  (macro-expr-binding-clause-from-arg
                    (tc-context-expr-bases ctx)
                    arg-expr))]
              (Ok
                (ExprBindingClause
                  (macro-captured-binding-clause
                    ctx
                    type-env
                    capture-expr-types
                    clause))))]
          [else
            (let
              [_
                (try
                  (macro-check-operand-with-resolved
                    ctx
                    type-env
                    (tc-global-shared-view resolved-expected)
                    (tc-global-shared-view arg-expr)))]
              [record-caller-origin : bool
                (not (macro-private-place-bridge-name? macro-name))]
              [node : i64
                (macro-captured-expr-node
                  ctx
                  expr-cell-address
                  type-cell-address
                  arg-id
                  (tc-global-shared-view arg-expr)
                  record-caller-origin)]
              ;; Caller-origin wrapping advances the context cell directly.
              ;; Publish that newer state before `expr-type` checking can
              ;; capture the installed pool back into the context; otherwise
              ;; the older installed count discards the wrapper nodes.
              [_install-captured-pools : unit (tc-context-install-pools! ctx)]
              [produced : ast.AstType
                (macro-captured-expr-produced-type
                  ctx
                  type-env
                  resolved-expected
                  capture-expr-types
                  arg-expr)]
              (Ok (Expr node produced)))]))]))

(define (macro-bind-fixed-param
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [name : i64]
  [ty : ast.AstType]
  [type-kinds : ast.AstMacroTypeKindList]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [capture-expr-types : bool]
  [env : ctfe_support.CtfeEnv]) : ResultMacroEnv
  (let
    [value
      (try
        (macro-capture-fixed-param
          ctx
          (tc-context-expr-cell-address-live ctx)
          (tc-context-type-cell-address-live ctx)
          decls
          fallback-module
          fallback-module-id
          type-env
          macro-name
          name
          (tc-global-shared-view ty)
          type-kinds
          arg-id
          arg-expr
          capture-expr-types))]
    ;; Caller-origin wrappers are appended after the transformer environment
    ;; snapshot was captured. Fixed syntax values do not carry their own
    ;; pool context, so advance the evaluator's read/write view before CTFE
    ;; can allocate a quoted parent over one of those newly appended nodes.
    ;; Otherwise a dotted-field template over `state` can reuse the
    ;; wrapper slot and create a Spanned <-> StructGet cycle.
    [captured-env : ctfe_support.CtfeEnv
      (begin
        ;; Explicit context pushes advance `ctx` but not the compatibility
        ;; allocator used by a few legacy CTFE constructors. Publish the
        ;; same advanced snapshot before binding the next operand.
        (tc-context-install-pools! ctx)
        (ctfe_support.ctfe-env-rebase-pools env (tc-context-pools-live ctx)))]
    (Ok (macro-env-extend-captured-param captured-env name ty value))))

;; Bind the unevaluated operand forms to the macro parameters as `Expr` values.
;; A trailing variadic parameter collects the remaining operands. A non-final
;; ExprBindingClause variadic instead collects the maximal bracket-clause
;; prefix, then binding continues with the first ordinary operand.
(define (macro-bind-params
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (macro-bind-params-at
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name
    (& params)
    (& args)
    0
    0
    env
    capture-expr-types
    call-expr))

(define (macro-bind-params-at
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (cond
    [(>= param-index (ast.ast-macro-param-list-len params))
      (if (>= arg-index args.len)
        (Ok env)
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast.ast-macro-param-list-get
        params
        param-index
        (ast.ast-macro-param-fallback))
        [(Param pname pty variadic type-kinds)
          (if variadic
            (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
              (macro-bind-variadic-param
                ctx
                type-env
                fallback-module
                fallback-module-id
                pname
                pty
                (ast.ast-expr-list-tail-from-ref args arg-index)
                env
                capture-expr-types)
              (if (macro-param-expr-binding-clause?
                ctx
                (tc-global-shared-view fallback-module)
                fallback-module-id
                pty)
                (let
                  [clauses : ast.AstExprBindingClauseList
                    (try
                      (macro-expr-binding-clause-prefix-from-args
                        (tc-context-expr-bases ctx)
                        args
                        arg-index))]
                  ;; Capture this definition-owned flag before typing a
                  ;; caller clause can install a newer active syntax pool.
                  [rebase-captured-env? : bool
                    (match (ast.ast-macro-param-list-get
                      params
                      (+ param-index 1)
                      (ast.ast-macro-param-fallback))
                      [(Param _ _ next-variadic _) next-variadic])]
                  [value : ctfe_support.CompilerCtfeValue
                    (macro-captured-binding-clause-list-value
                      ctx
                      type-env
                      capture-expr-types
                      (tc-global-shared-view clauses))]
                  [captured-env : ctfe_support.CtfeEnv
                    (if rebase-captured-env?
                      (ctfe_support.ctfe-env-rebase-syntax-pools
                        env
                        (ast.ast-node-pool-context-capture-active))
                      env)]
                  (macro-bind-params-at
                    ctx
                    decls
                    fallback-module
                    fallback-module-id
                    type-env
                    macro-name
                    params
                    args
                    (+ param-index 1)
                    (+ arg-index clauses.len)
                    (ctfe_support.ctfe-env-extend-id captured-env pname value)
                    capture-expr-types
                    call-expr))
                (Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")))))
            (if (>= arg-index args.len)
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast.ast-expr-list-get args arg-index 0)]
                [arg-expr : ast.AstExpr (tc-context-expr-get ctx arg)]
                [next-env
                  (try
                    (macro-bind-fixed-param
                      ctx
                      (tc-global-shared-view decls)
                      (tc-global-shared-view fallback-module)
                      fallback-module-id
                      type-env
                      (tc-global-shared-view macro-name)
                      pname
                      pty
                      type-kinds
                      arg
                      arg-expr
                      capture-expr-types
                      env))]
                (macro-bind-params-at
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  params
                  args
                  (+ param-index 1)
                  (+ arg-index 1)
                  next-env
                  capture-expr-types
                  call-expr))))])]))

;; Capture checked operands directly into an exact native ABI array. This
;; walker deliberately mirrors `macro-bind-params-at`; the shared capture
;; helpers above own all validation and value construction, while this layer
;; owns only arity, mixed-prefix traversal, and syntax-pool selection. The
;; caller has already enforced the compiler-host operand ABI limit, so the
;; declared parameter count is both the required live prefix and the exact
;; capacity.
(define (macro-capture-params-direct
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCapturedOperands
  (let
    [operand-count : i64 params.len]
    (macro-capture-params-direct-at
      ctx
      decls
      fallback-module
      fallback-module-id
      type-env
      macro-name
      (& params)
      (& args)
      0
      0
      env
      (ctfe_support.ctfe-env-syntax-pools env)
      (__tl_make-array ctfe_support.CompilerCtfeValue operand-count)
      capture-expr-types
      call-expr)))

(define (macro-capture-params-direct-at
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCapturedOperands
  (cond
    [(>= param-index (ast.ast-macro-param-list-len params))
      (if (>= arg-index args.len)
        (Ok
          operands
          param-index
          env
          (match syntax-pools
            [(Some pools) pools]
            [(None) (ctfe_support.ctfe-env-pools env)]))
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast.ast-macro-param-list-get
        params
        param-index
        (ast.ast-macro-param-fallback))
        [(Param pname pty variadic type-kinds)
          (if variadic
            (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
              (let
                [value
                  (try
                    (macro-capture-variadic-param
                      ctx
                      type-env
                      (tc-global-shared-view fallback-module)
                      fallback-module-id
                      pname
                      pty
                      (ast.ast-expr-list-tail-from-ref args arg-index)
                      env
                      syntax-pools
                      capture-expr-types))]
                (set! (array-ref operands param-index) value)
                (macro-capture-params-direct-at
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  params
                  args
                  (+ param-index 1)
                  args.len
                  env
                  (macro-captured-param-syntax-pools-after-check
                    syntax-pools
                    value
                    true)
                  operands
                  capture-expr-types
                  call-expr))
              (if (macro-param-expr-binding-clause?
                ctx
                (tc-global-shared-view fallback-module)
                fallback-module-id
                pty)
                (let
                  [clauses
                    (try
                      (macro-expr-binding-clause-prefix-from-args
                        (tc-context-expr-bases ctx)
                        args
                        arg-index))]
                  ;; Capture this definition-owned flag before typing a
                  ;; caller clause can install a newer active syntax pool.
                  [rebase-captured-pools? : bool
                    (match (ast.ast-macro-param-list-get
                      params
                      (+ param-index 1)
                      (ast.ast-macro-param-fallback))
                      [(Param _ _ next-variadic _) next-variadic])]
                  [value : ctfe_support.CompilerCtfeValue
                    (macro-captured-binding-clause-list-value
                      ctx
                      type-env
                      capture-expr-types
                      (tc-global-shared-view clauses))]
                  (set! (array-ref operands param-index) value)
                  (macro-capture-params-direct-at
                    ctx
                    decls
                    fallback-module
                    fallback-module-id
                    type-env
                    macro-name
                    params
                    args
                    (+ param-index 1)
                    (+ arg-index clauses.len)
                    env
                    (macro-captured-param-syntax-pools-after-check
                      syntax-pools
                      value
                      rebase-captured-pools?)
                    operands
                    capture-expr-types
                    call-expr))
                (Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")))))
            (if (>= arg-index args.len)
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast.ast-expr-list-get args arg-index 0)]
                [arg-expr : ast.AstExpr (tc-context-expr-get ctx arg)]
                [value
                  (try
                    (macro-capture-fixed-param
                      ctx
                      (tc-context-expr-cell-address-live ctx)
                      (tc-context-type-cell-address-live ctx)
                      (tc-global-shared-view decls)
                      (tc-global-shared-view fallback-module)
                      fallback-module-id
                      type-env
                      (tc-global-shared-view macro-name)
                      pname
                      pty
                      type-kinds
                      arg
                      arg-expr
                      capture-expr-types))]
                ;; Fixed captures append caller-origin wrappers through
                ;; `ctx`, just as the interpreted binder does. Publish
                ;; that advanced pool and hand it to the native host;
                ;; the definition snapshot can share the old argument
                ;; ids but cannot address the newly appended wrapper.
                (tc-context-install-pools! ctx)
                (set! (array-ref operands param-index) value)
                (macro-capture-params-direct-at
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  params
                  args
                  (+ param-index 1)
                  (+ arg-index 1)
                  env
                  (Some (tc-context-pools ctx))
                  operands
                  capture-expr-types
                  call-expr))))])]))

(define (macro-fold-captured-operands-env
  [params : ast.AstMacroParamList]
  [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
  [count : i64]
  [base-env : ctfe_support.CtfeEnv]) : ctfe_support.CtfeEnv
  (let
    [env : ctfe_support.CtfeEnv base-env]
    [index : i64 0]
    (while (< index count)
      (match (ast.ast-macro-param-list-get
        (& params)
        index
        (ast.ast-macro-param-fallback))
        [(Param pname pty _ _)
          (set!
            env
            (macro-env-extend-captured-param
              env
              pname
              pty
              (tc-global-array-element-shared-view operands index)))
          (set! index (+ index 1))]))
    env))

;; Route trusted embedded-stdlib macro calls through the TLCI catalog before
;; the semantic CTFE fallback. The mapped catalog owns its package-agnostic
;; index and terminal shell state for the mapping lifetime. Loader provenance
;; is per compilation session: embedded source and byte-identical disk source
;; may enter this branch, while modified or otherwise untrusted roots cannot.
(cfg
  embedded-stdlib-tlci
  (define (macro-expand-stdlib-tlci-catalog-lookup-cached [name : String]) : embedded_tlci.CompilerEmbeddedStdlibTlciLookup
    (embedded_tlci.compiler-embedded-stdlib-tlci-catalog-lookup name)))

;; The same lookup timed into the job's view. Callers select it with
;; `(cfg compile-profile ...)`, so ordinary builds keep the plain lookup.
(cfg
  (all embedded-stdlib-tlci compile-profile)
  (define (macro-expand-stdlib-tlci-catalog-lookup-profiled
    [state : TcMacroState]
    [name : String]) : embedded_tlci.CompilerEmbeddedStdlibTlciLookup
    (compiler-tc-stdlib-tlci-entry-timer-start!
      state
      tc-profile-stdlib-entry-resolution-start-ns)
    (let
      [lookup : embedded_tlci.CompilerEmbeddedStdlibTlciLookup
        (macro-expand-stdlib-tlci-catalog-lookup-cached name)]
      (compiler-tc-stdlib-tlci-entry-timer-finish!
        state
        tc-profile-stdlib-entry-resolution-start-ns
        tc-profile-stdlib-entry-resolution-ns
        tc-profile-stdlib-entry-resolution-calls)
      lookup)))

(define (macro-dependency-tlci-catalog-lookup
  [ctx : TcContext]
  [slot : i64]
  [identity : String]) : cload.CompilerLoadDependencyCatalogLookup
  (cload.compiler-load-dependency-catalog-handle-lookup-macro
    (tc-macro-walk-field
      (tc-context-macro-state ctx)
      macro-dependency-catalog-handle)
    slot
    identity))

(define (macro-dependency-catalog-slot-cache-reset! [state : TcMacroState]) : unit
  (let
    [cache : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-dependency-catalog-slot-cache)]
    (tc_i64_i64_map.clear-ref! (&mut cache))
    (tc-macro-walk-set! state macro-dependency-catalog-slot-cache cache)))

(define (macro-dependency-catalog-slot-cache-value-or
  [state : TcMacroState]
  [provenance-id : i64]
  [fallback : i64]) : i64
  (let
    [cache : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-dependency-catalog-slot-cache)]
    (tc_i64_i64_map.get-value-or (& cache) provenance-id fallback)))

(define (macro-dependency-catalog-slot-cache-store!
  [state : TcMacroState]
  [provenance-id : i64]
  [slot : i64]) : i64
  (let
    [cache : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-dependency-catalog-slot-cache)]
    (if (tc_i64_i64_map.needs-grow? (&mut cache))
      (in-arena
        (arena.Arena (tc-macro-state-owner-arena state))
        (tc_i64_i64_map.grow! (&mut cache)))
      unit)
    (tc_i64_i64_map.insert-ref! (&mut cache) provenance-id slot)
    (tc-macro-walk-set! state macro-dependency-catalog-slot-cache cache)
    slot))

(define (macro-dependency-tlci-catalog-slot-for-declaration
  [ctx : TcContext]
  [declaration-id : i64]) : i64
  (if (< declaration-id 0)
    -1
    (let
      [provenance-id : i64
        (csym.compiler-symbols-provenance-id-at-index-or
          (tc-context-symbols ctx)
          declaration-id
          cbi.compiler-builtin-id-fix-empty)]
      [source-names : ci.InternSourceNameSession
        (ci.intern-source-name-session-handle-session
          (tc-context-source-names ctx))]
      [state : TcMacroState (tc-context-macro-state ctx)]
      (if (or
        (< provenance-id 0)
        (>= provenance-id source-names.source-count)
        (>= provenance-id (array-length source-names.pool-slots)))
        -1
        (let
          [missing : i64 -2]
          [cached : i64
            (macro-dependency-catalog-slot-cache-value-or
              state
              provenance-id
              missing)]
          (if (not (= cached missing))
            cached
            (macro-dependency-catalog-slot-cache-store!
              state
              provenance-id
              (cload.compiler-load-dependency-catalog-handle-slot-for-provenance-path
                (tc-macro-walk-field state macro-dependency-catalog-handle)
                (owned_view.compiler-owned-array-element-shared-view
                  source-names.pool-slots
                  provenance-id)))))))))

(define (macro-expand-stdlib-tlci-module-id?
  [state : TcMacroState]
  [module : String]) : bool
  (let
    [ids : sym_i64_env.SymI64Env
      (tc-macro-walk-field state macro-expand-stdlib-tlci-module-ids)]
    (sym_i64_env.sym-i64-contains-id ids (ci.intern module))))

;; Both embedded stdlib and dependency catalogs enter through this selection
;; contract after ordinary macro lookup has chosen the defining declaration.
;; The dependency payload is a registry-generation-bound capability, never a
;; free-standing mapped-image index.
(cfg
  embedded-stdlib-tlci
  (defenum MacroTlciResolvedCatalog
    (Dependency cload.CompilerLoadDependencyCatalogCapability)
    (Embedded tlci_loader_support.TlciResolvedMacroEntry)))

(cfg
  embedded-stdlib-tlci
  (defenum MacroTlciCatalogSelection
    (None)
    (Resolved MacroTlciResolvedCatalog)
    (Shell MacroTlciResolvedCatalog)
    (MetadataOnly)
    (Missing)
    (Unavailable)))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-catalog-select
    [ctx : TcContext]
    [definition-module : String]
    [identity : String]
    [declaration-id : i64]) : MacroTlciCatalogSelection
    (match (macro-dependency-tlci-catalog-lookup
      ctx
      (macro-dependency-tlci-catalog-slot-for-declaration ctx declaration-id)
      (tc-global-shared-view identity))
      [(NoCatalog)
        (if (and
          (tc-macro-walk-field
            (tc-context-macro-state ctx)
            macro-expand-stdlib-tlci-route-active)
          (macro-expand-stdlib-tlci-module-id?
            (tc-context-macro-state ctx)
            definition-module))
          (match (cfg
            compile-profile
            (macro-expand-stdlib-tlci-catalog-lookup-profiled
              (tc-context-macro-state ctx)
              identity)
            (macro-expand-stdlib-tlci-catalog-lookup-cached identity))
            [(Resolved resolved) (Resolved (Embedded resolved))]
            [(Shell resolved) (Shell (Embedded resolved))]
            [(Missing) Missing]
            [(Unavailable _) Unavailable])
          None)]
      [(Resolved capability)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-catalog-hits
          1)
        (Resolved (Dependency capability))]
      [(Shell capability)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-catalog-hits
          1)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-shell-cache-hits
          1)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-interpreted-fallbacks
          1)
        (Shell (Dependency capability))]
      [(MetadataOnly)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-catalog-misses
          1)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-interpreted-fallbacks
          1)
        MetadataOnly]
      [(Missing)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-catalog-misses
          1)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-interpreted-fallbacks
          1)
        Missing]
      [(Unavailable _)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-load-failures
          1)
        (tc-dependency-tlci-route-counter-add!
          (tc-context-macro-state ctx)
          tc-dependency-tlci-interpreted-fallbacks
          1)
        Unavailable])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-open?
    [catalog : (& catalog MacroTlciResolvedCatalog)]) : bool
    (match catalog
      [(Dependency _) true]
      [(Embedded _) (embedded_tlci.compiler-embedded-stdlib-tlci-session-open!)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-dependency?
    [catalog : (& catalog MacroTlciResolvedCatalog)]) : bool
    (match catalog
      [(Dependency _) true]
      [(Embedded _) false])))

(cfg
  embedded-stdlib-tlci
  (define (macro-dependency-tlci-note-if!
    [state : TcMacroState]
    [catalog : (& catalog MacroTlciResolvedCatalog)]
    [counter : i64]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      (tc-dependency-tlci-route-counter-add! state counter 1)
      unit)))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-dispatch
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]
    [session-cookie : i64]) : tlci_loader_support.ResultTlciMacroDispatch
    (match catalog
      [(Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-dispatch
          capability
          identity
          session-cookie)]
      [(Embedded resolved)
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-dispatch
          resolved
          session-cookie)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-mark-shell!
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]) : tlci_loader_support.ResultTlciLoaderUnit
    (match catalog
      [(Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-mark-shell!
          capability
          identity)]
      [(Embedded resolved)
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-mark-shell!
          resolved)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-status-diagnostic
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]
    [message : String]) : String
    (match catalog
      [(Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-error
          capability
          identity
          message)]
      [(Embedded _) message])))

(cfg
  tlci-bootstrap-mutation-witness
  (define (macro-tlci-bootstrap-mutation-witness-requested?) : bool
    (let
      [name : String "TYPELISP_TLCI_MUTATION_WITNESS"]
      (match (mutation_witness_env.get (& name))
        [(EnvSomeString value) (string.eq value "1")]
        [(EnvNoString) false]))))

(cfg
  tlci-bootstrap-mutation-witness
  (define (macro-tlci-bootstrap-mutation-witness-emit!
    [identity : String]
    [route : String]
    [result : String]) : unit
    (if (and
      (string.eq identity "stdlib.core_macros/when")
      (macro-tlci-bootstrap-mutation-witness-requested?))
      (io.print-error
        (str_cat.str-cat
          "tlci-bootstrap-mutation-route|identity="
          identity
          "|route="
          route
          "|result="
          result
          "\n"))
      unit)))

(define (macro-tlci-catalog-identity
  [definition-module : String]
  [macro-name : String]) : String
  ;; Symbol lookup hands the executor either a local declaration name or its
  ;; already canonical `module/name` display. Package catalogs are produced
  ;; from the latter, so never qualify an identity a second time.
  (if (>= (tc-qualified-name-last-slash macro-name) 0)
    macro-name
    (csym.compiler-symbol-module-key definition-module macro-name)))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-identity-differential-requested?) : bool
    (let
      [name : String "TYPELISP_TLCI_IDENTITY_DIFFERENTIAL"]
      (match (stress_env.get (& name))
        [(EnvSomeString value) (string.eq value "1")]
        [(EnvNoString) false]))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-identity-result-kind [ret : ast.AstType]) : String
    (if (tc-macro-result-module? (tc-global-shared-view ret))
      "module"
      (if (tc-macro-result-decls? ret)
        "decls"
        "expr"))))

;; Runtime-gated, identity-specific evidence for #6609's required differential.
;; Ordinary compiler builds omit this code; ordinary profile runs do not emit
;; records unless the focused environment gate is enabled.
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-identity-route-emit!
    [route : String]
    [result-kind : String]
    [identity : String]
    [definition-module : String]) : unit
    (if (compiler-tc-tlci-identity-differential-requested?)
      (io.print-error
        (str_cat.str-cat
          "tlci-identity-route|"
          route
          "|"
          result-kind
          "|"
          identity
          "|"
          definition-module
          "\n"))
      unit)))

(define (macro-note-stdlib-tlci-route
  [state : TcMacroState]
  [definition-module : String]
  ;; lint-allow: unused-variable -- used by embedded-stdlib-tlci builds.
  [macro-name : String]
  ;; lint-allow: unused-variable -- used by the focused differential build.
  [ret : ast.AstType]) : unit
  (if (or
    (ctfe_support.ctfe-string-prefix?
      (tc-global-shared-view definition-module)
      "stdlib.")
    (ctfe_support.ctfe-string-prefix?
      (tc-global-shared-view macro-name)
      "stdlib."))
    (begin
      (cfg
        (all embedded-stdlib-tlci tlci-native-route-stress)
        (compiler-tc-tlci-identity-route-emit!
          "source"
          (compiler-tc-tlci-identity-result-kind ret)
          (macro-tlci-catalog-identity
            (tc-global-shared-view definition-module)
            (tc-global-shared-view macro-name))
          (tc-global-shared-view definition-module)))
      (cfg
        tlci-bootstrap-mutation-witness
        (macro-tlci-bootstrap-mutation-witness-emit!
          (macro-tlci-catalog-identity
            (tc-global-shared-view definition-module)
            (tc-global-shared-view macro-name))
          "source"
          "interpreted"))
      (if (and
        (tc-macro-walk-field state macro-expand-stdlib-tlci-route-active)
        (macro-expand-stdlib-tlci-module-id?
          state
          (tc-global-shared-view definition-module)))
        (begin
          (cfg
            embedded-stdlib-tlci
            (match (cfg
              compile-profile
              (macro-expand-stdlib-tlci-catalog-lookup-profiled
                state
                (macro-tlci-catalog-identity definition-module macro-name))
              (macro-expand-stdlib-tlci-catalog-lookup-cached
                (macro-tlci-catalog-identity definition-module macro-name)))
              [(or (Resolved _) (Shell _))
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-metric-add!
                    state
                    tc-profile-stdlib-catalog-hits
                    1))]
              [(Missing)
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-metric-add!
                    state
                    tc-profile-stdlib-catalog-misses
                    1))]
              [(Unavailable _)
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-metric-add!
                    state
                    tc-profile-stdlib-load-failures
                    1))]))
          (cfg
            (not embedded-stdlib-tlci)
            (cfg
              compile-profile
              (compiler-tc-macro-profile-metric-add!
                state
                tc-profile-stdlib-load-failures
                1)))
          (cfg
            compile-profile
            (compiler-tc-macro-profile-metric-add!
              state
              tc-profile-stdlib-interpreted-fallbacks
              1)))
        (cfg
          compile-profile
          (compiler-tc-macro-profile-metric-add!
            state
            tc-profile-stdlib-source-interpreted
            1))))
    unit))

(defenum MacroNativeStdlibTlciResult
  (No)
  (Shell)
  (Value ctfe_support.CompilerCtfeValue)
  (Err cdiag.CompilerDiagnostic))

;; A cataloged entry is attempted natively; the image is self-describing, so
;; an entry that commits a result was a compiled native body and an entry
;; that commits nothing (a registration shell) falls back to interpretation.
;; No per-identity list is needed. Refs #5212, #5213.
(define (macro-stdlib-tlci-native-cookie) : i64
  0x1cf1)

;; #5926: production-route sustained stress telemetry. The declarations only
;; exist in the focused profile compiler, and a runtime environment key gates
;; record emission without changing the production routing policy. A
;; fixed-width stderr record is emitted at pass boundaries, lifecycle/result
;; transitions, dispatch one, every 256 dispatches, and the historical
;; 13,552-dispatch boundary. The redirected record survives a later allocator
;; or mapping crash and names the last completed production macro dispatch
;; without retaining an unbounded log.
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-active : bool
    false))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-route-status : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-pass : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-pass-dispatch : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-total-dispatch : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-canary-a : i64
    1597463007))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-canary-b : i64
    324508639))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pad [text : String] [width : i64]) : String
    (if (>= (string.string-length text) width)
      text
      (compiler-tc-tlci-native-stress-pad (str_cat.str-cat "0" text) width))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-requested?) : bool
    (let
      [name : String "TYPELISP_TLCI_NATIVE_ROUTE_STRESS"]
      (match (stress_env.get (& name))
        [(EnvSomeString value) (string.eq value "1")]
        [(EnvNoString) false]))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-canaries-ok?) : bool
    (and
      (= compiler-tc-tlci-native-stress-canary-a 1597463007)
      (= compiler-tc-tlci-native-stress-canary-b 324508639)
      (embedded_tlci.compiler-embedded-stdlib-tlci-stress-canaries-ok?))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-record!
    [pools : ast.AstNodePoolContext]
    [catalog-generation : i64]
    [identity-index : i64]
    [route-status : i64]
    [result-kind : i64]
    [status : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "tlci-native-stress|pass="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-pass)
          6)
        "|dispatch="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-pass-dispatch)
          12)
        "|total="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-total-dispatch)
          12)
        "|catalog="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string catalog-generation)
          8)
        "|identity="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string identity-index)
          6)
        "|route="
        (compiler-tc-tlci-native-stress-pad (string.int->string route-status) 3)
        "|result="
        (compiler-tc-tlci-native-stress-pad (string.int->string result-kind) 3)
        "|status="
        (compiler-tc-tlci-native-stress-pad (string.int->string status) 3)
        "|expr="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ast-node-pool-context-expr-len pools))
          12)
        "|type="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ast-node-pool-context-type-len pools))
          12)
        "|poolgen="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ty-node-pool-generation-value))
          12)
        "|image="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-image-generation))
          8)
        "|release="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-release-generation))
          8)
        "|session="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-session-generation))
          12)
        "|canary="
        (if (compiler-tc-tlci-native-stress-canaries-ok?)
          "11"
          "00")
        "\n"))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pass-start!
    [pools : ast.AstNodePoolContext]
    [route-active : bool]) : unit
    (set!
      compiler-tc-tlci-native-stress-active
      (compiler-tc-tlci-native-stress-requested?))
    (set!
      compiler-tc-tlci-native-stress-route-status
      (if route-active
        1
        0))
    (when
      compiler-tc-tlci-native-stress-active
      (set!
        compiler-tc-tlci-native-stress-pass
        (+ compiler-tc-tlci-native-stress-pass 1))
      (set! compiler-tc-tlci-native-stress-pass-dispatch 0)
      (compiler-tc-tlci-native-stress-record!
        pools
        0
        999999
        compiler-tc-tlci-native-stress-route-status
        0
        0))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-dispatch!
    [pools : ast.AstNodePoolContext]
    [resolved : tlci_loader_support.TlciResolvedMacroEntry]
    [result-kind : i64]
    [status : i64]) : unit
    (when
      compiler-tc-tlci-native-stress-active
      (set!
        compiler-tc-tlci-native-stress-pass-dispatch
        (+ compiler-tc-tlci-native-stress-pass-dispatch 1))
      (set!
        compiler-tc-tlci-native-stress-total-dispatch
        (+ compiler-tc-tlci-native-stress-total-dispatch 1))
      (if (or
        (= compiler-tc-tlci-native-stress-pass-dispatch 1)
        (= (% compiler-tc-tlci-native-stress-pass-dispatch 256) 0)
        (= compiler-tc-tlci-native-stress-pass-dispatch 13552)
        (not (= result-kind 1)))
        (compiler-tc-tlci-native-stress-record!
          pools
          resolved.catalog-generation
          resolved.entry-index
          1
          result-kind
          status)
        unit))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-catalog-dispatch!
    [pools : ast.AstNodePoolContext]
    [catalog : MacroTlciResolvedCatalog]
    [result-kind : i64]
    [status : i64]) : unit
    (match catalog
      [(Dependency _) unit]
      [(Embedded resolved)
        (compiler-tc-tlci-native-stress-dispatch!
          pools
          resolved
          result-kind
          status)])))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pass-finish!
    [pools : ast.AstNodePoolContext]
    [status : i64]) : unit
    (if compiler-tc-tlci-native-stress-active
      (begin
        (compiler-tc-tlci-native-stress-record!
          pools
          0
          999999
          compiler-tc-tlci-native-stress-route-status
          6
          status)
        (set! compiler-tc-tlci-native-stress-active false))
      unit)))

;; Execute a resolved native entry with either directly prepared operands or
;; the exact values in an interpreted binding. The direct mode starts at
;; `index = count`, so it performs no parameter-name lookup. A successful call
;; that commits no result permanently marks this catalog entry as a shell for
;; the mapping generation. Any nonzero status remains retryable and surfaces
;; as the same diagnostic contract the interpreter uses.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-native-resolved
    [host-pools : ast.AstNodePoolContext]
    [route-state : TcMacroState]
    [identity : String]
    [catalog : MacroTlciResolvedCatalog]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [env : ctfe_support.CtfeEnv]
    [call-expr : ast.AstExpr]
    [prepared-operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
    [prepared-count : i64]
    [prepared : bool]) : MacroNativeStdlibTlciResult
    (if (not (macro-tlci-resolved-catalog-open? catalog))
      No
      (let
        [count : i64
          (if prepared
            prepared-count
            params.len)]
        [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)
          prepared-operands]
        [index : i64
          (if prepared
            count
            0)]
        [ok : bool (<= count embedded_tlci.compiler-comptime-host-operand-cap)]
        (while (and (not prepared) ok (< index count))
          (match (array-ref params.slots index)
            [(Param pname _ _ _)
              (macro-dependency-tlci-note-if!
                route-state
                catalog
                tc-dependency-tlci-parameter-name-lookups)
              (match (ctfe_support.ctfe-env-lookup-id env pname)
                [(Some value)
                  (set! (array-ref operands index) value)
                  (set! index (+ index 1))]
                [(None) (set! ok false)])]))
        (if (not ok)
          (begin
            (macro-dependency-tlci-note-if!
              route-state
              catalog
              tc-dependency-tlci-interpreted-fallbacks)
            No)
          (begin
            (embedded_tlci.compiler-comptime-host-session-open-with-macro-state!
              host-pools
              (& operands)
              count
              (ctfe_support.ctfe-fuel-limit)
              (macro-stdlib-tlci-native-cookie)
              (ctfe_support.ctfe-env-reflections env)
              (ctfe_support.ctfe-env-source-names env)
              (ctfe_support.ctfe-env-macro-state env))
            (cfg
              compile-profile
              (if (macro-tlci-resolved-catalog-dependency? catalog)
                unit
                (compiler-tc-stdlib-tlci-entry-timer-start!
                  route-state
                  tc-profile-stdlib-entry-invoke-start-ns)))
            (macro-dependency-tlci-note-if!
              route-state
              catalog
              tc-dependency-tlci-native-dispatches)
            (let
              [dispatch-result : tlci_loader_support.ResultTlciMacroDispatch
                (macro-tlci-resolved-catalog-dispatch
                  (tc-global-shared-view catalog)
                  (tc-global-shared-view identity)
                  (macro-stdlib-tlci-native-cookie))]
              (begin
                (cfg
                  compile-profile
                  (if (macro-tlci-resolved-catalog-dependency? catalog)
                    unit
                    (compiler-tc-stdlib-tlci-entry-timer-finish!
                      route-state
                      tc-profile-stdlib-entry-invoke-start-ns
                      tc-profile-stdlib-entry-invoke-ns
                      tc-profile-stdlib-entry-invoke-calls)))
                (match dispatch-result
                  [(Err message)
                    (begin
                      (cfg
                        (all embedded-stdlib-tlci tlci-native-route-stress)
                        (compiler-tc-tlci-native-stress-catalog-dispatch!
                          host-pools
                          catalog
                          5
                          9))
                      (embedded_tlci.compiler-comptime-host-session-close!)
                      (Err
                        (ctfe_support.ctfe-diagnostic-at-expr call-expr message)))]
                  [(Ok dispatch)
                    (let
                      [status : i64 dispatch.status]
                      (cond
                        [(and
                            (= status 0)
                            (embedded_tlci.compiler-comptime-host-result-ready?))
                          (let
                            [value : ctfe_support.CompilerCtfeValue
                              (embedded_tlci.compiler-comptime-host-result-value)]
                            (begin
                              (cfg
                                tlci-bootstrap-mutation-witness
                                (macro-tlci-bootstrap-mutation-witness-emit!
                                  (tc-global-shared-view identity)
                                  "native"
                                  "value"))
                              (cfg
                                (all
                                  embedded-stdlib-tlci
                                  tlci-native-route-stress)
                                (compiler-tc-tlci-identity-route-emit!
                                  "native"
                                  (compiler-tc-tlci-identity-result-kind
                                    (tc-global-shared-view ret))
                                  identity
                                  ""))
                              (cfg
                                (all
                                  embedded-stdlib-tlci
                                  tlci-native-route-stress)
                                (compiler-tc-tlci-native-stress-catalog-dispatch!
                                  host-pools
                                  (tc-global-shared-view catalog)
                                  (if (tc-macro-result-module?
                                    (tc-global-shared-view ret))
                                    2
                                    (if (tc-macro-result-decls?
                                      (tc-global-shared-view ret))
                                      3
                                      1))
                                  0))
                              (embedded_tlci.compiler-comptime-host-session-close!)
                              (cfg
                                compile-profile
                                (if (macro-tlci-resolved-catalog-dependency?
                                  catalog)
                                  unit
                                  (begin
                                    (compiler-tc-macro-profile-metric-add!
                                      route-state
                                      tc-profile-stdlib-catalog-hits
                                      1)
                                    (compiler-tc-macro-profile-metric-add!
                                      route-state
                                      tc-profile-stdlib-native-dispatches
                                      1)
                                    (if (tc-macro-result-module?
                                      (tc-global-shared-view ret))
                                      (compiler-tc-macro-profile-metric-add!
                                        route-state
                                        tc-profile-stdlib-native-module-results
                                        1)
                                      (if (tc-macro-result-decls?
                                        (tc-global-shared-view ret))
                                        (compiler-tc-macro-profile-metric-add!
                                          route-state
                                          tc-profile-stdlib-native-decls-results
                                          1)
                                        (compiler-tc-macro-profile-metric-add!
                                          route-state
                                          tc-profile-stdlib-native-expr-results
                                          1))))))
                              (if (tc-macro-result-module?
                                (tc-global-shared-view ret))
                                (macro-dependency-tlci-note-if!
                                  route-state
                                  catalog
                                  tc-dependency-tlci-native-module-results)
                                (if (tc-macro-result-decls? ret)
                                  (macro-dependency-tlci-note-if!
                                    route-state
                                    catalog
                                    tc-dependency-tlci-native-decls-results)
                                  (begin
                                    (macro-dependency-tlci-note-if!
                                      route-state
                                      catalog
                                      tc-dependency-tlci-native-expr-results)
                                    (if prepared
                                      (macro-dependency-tlci-note-if!
                                        route-state
                                        catalog
                                        tc-dependency-tlci-direct-expr-results)
                                      unit))))
                              (Value value)))]
                        [(= status 0)
                          (match (macro-tlci-resolved-catalog-mark-shell!
                            (tc-global-shared-view catalog)
                            (tc-global-shared-view identity))
                            [(Ok)
                              (begin
                                (cfg
                                  (all
                                    embedded-stdlib-tlci
                                    tlci-native-route-stress)
                                  (compiler-tc-tlci-identity-route-emit!
                                    "native"
                                    "shell"
                                    identity
                                    ""))
                                (cfg
                                  (all
                                    embedded-stdlib-tlci
                                    tlci-native-route-stress)
                                  (compiler-tc-tlci-native-stress-catalog-dispatch!
                                    host-pools
                                    (tc-global-shared-view catalog)
                                    4
                                    0))
                                (embedded_tlci.compiler-comptime-host-session-close!)
                                (cfg
                                  compile-profile
                                  (if (macro-tlci-resolved-catalog-dependency?
                                    catalog)
                                    unit
                                    (compiler-tc-macro-profile-metric-add!
                                      route-state
                                      tc-profile-stdlib-shell-learns
                                      1)))
                                (macro-dependency-tlci-note-if!
                                  route-state
                                  catalog
                                  tc-dependency-tlci-shell-learns)
                                (macro-dependency-tlci-note-if!
                                  route-state
                                  catalog
                                  tc-dependency-tlci-interpreted-fallbacks)
                                Shell)]
                            [(Err message)
                              (begin
                                (cfg
                                  (all
                                    embedded-stdlib-tlci
                                    tlci-native-route-stress)
                                  (compiler-tc-tlci-native-stress-catalog-dispatch!
                                    host-pools
                                    catalog
                                    5
                                    9))
                                (embedded_tlci.compiler-comptime-host-session-close!)
                                (Err
                                  (ctfe_support.ctfe-diagnostic-at-expr
                                    call-expr
                                    message)))])]
                        ;; A transformer that called `comptime-error` left
                        ;; its own message in the session diagnostic slot;
                        ;; that message is the author's, and reporting the
                        ;; raw status instead would make a macro's own
                        ;; rejection unreadable and route-dependent. The
                        ;; generic status text stays for statuses with no
                        ;; recorded message (bad request, panic). Refs #5701.
                        [else
                          (let
                            [recorded : String
                              (embedded_tlci.compiler-comptime-host-diagnostic-text)]
                            [message : String
                              (macro-tlci-resolved-catalog-status-diagnostic
                                (tc-global-shared-view catalog)
                                (tc-global-shared-view identity)
                                (if (and
                                  (=
                                    status
                                    tlci.tlci-host-callback-status-diagnostic)
                                  (> (string.string-length recorded) 0))
                                  recorded
                                  (tlci_loader_support.tlci-loader-macro-status-diagnostic
                                    (tc-global-shared-view identity)
                                    status)))]
                            (begin
                              (cfg
                                (all
                                  embedded-stdlib-tlci
                                  tlci-native-route-stress)
                                (compiler-tc-tlci-identity-route-emit!
                                  "native"
                                  "error"
                                  identity
                                  ""))
                              (cfg
                                (all
                                  embedded-stdlib-tlci
                                  tlci-native-route-stress)
                                (compiler-tc-tlci-native-stress-catalog-dispatch!
                                  host-pools
                                  catalog
                                  5
                                  status))
                              (embedded_tlci.compiler-comptime-host-session-close!)
                              (Err
                                (ctfe_support.ctfe-diagnostic-at-expr
                                  call-expr
                                  message))))]))])))))))))

;; The provenance gate comes before identity construction and catalog access,
;; so source stdlib macros and unrelated packages pay neither cost.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-native
    [ctx : TcContext]
    [definition-module : String]
    [declaration-id : i64]
    [macro-name : String]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [env : ctfe_support.CtfeEnv]
    [call-expr : ast.AstExpr]) : MacroNativeStdlibTlciResult
    (let
      [identity : String
        (macro-tlci-catalog-identity
          (tc-global-shared-view definition-module)
          macro-name)]
      (match (macro-tlci-catalog-select
        ctx
        definition-module
        (tc-global-shared-view identity)
        declaration-id)
        [(Resolved catalog)
          (macro-try-stdlib-tlci-native-resolved
            (tc-context-pools ctx)
            (tc-context-macro-state ctx)
            identity
            catalog
            (tc-global-shared-view params)
            ret
            env
            call-expr
            (__tl_make-array
              ctfe_support.CompilerCtfeValue
              embedded_tlci.compiler-comptime-host-operand-cap)
            params.len
            false)]
        [(Shell catalog)
          (cfg
            compile-profile
            (if (macro-tlci-resolved-catalog-dependency? catalog)
              unit
              (compiler-tc-macro-profile-metric-add!
                (tc-context-macro-state ctx)
                tc-profile-stdlib-shell-cache-hits
                1)))
          No]
        [(or (None) (MetadataOnly) (Missing) (Unavailable)) No]))))

(cfg
  (not embedded-stdlib-tlci)
  (define (macro-try-stdlib-tlci-native
    [_ctx : TcContext]
    [_definition-module : String]
    [_declaration-id : i64]
    [_macro-name : String]
    [_params : ast.AstMacroParamList]
    [_ret : ast.AstType]
    [_env : ctfe_support.CtfeEnv]
    [_call-expr : ast.AstExpr]) : MacroNativeStdlibTlciResult
    No))

(define (macro-result-provenance-reset-with-captured-body!
  [state : ctfe_support.CompilerCtfeMacroState]
  [captured-body? : bool]) : unit
  (ctfe_support.ctfe-result-macro-provenance-reset-for-state! state)
  ;; A transformer can splice a captured operand without reconstructing its
  ;; call nodes. Preserve that input provenance so a nested macro is rewalked
  ;; in the lexical environment introduced by the generated syntax.
  (if captured-body?
    (ctfe_support.ctfe-result-may-contain-macro-note-for-state! state)
    unit))

(defenum MacroDirectStdlibTlciResult
  (No)
  (BoundFallback)
  (Value ctfe_support.CompilerCtfeValue)
  (PreparedEnv ctfe_support.CtfeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

;; Stdlib fallbacks from the direct-expression route, counted into the job's
;; view. Only compile-profile builds call these; dependency catalogs and slots
;; are reported by their own rows instead.
(cfg
  (all embedded-stdlib-tlci compile-profile)
  (define (macro-note-embedded-tlci-resolved-fallback!
    [state : TcMacroState]
    [catalog : (& catalog MacroTlciResolvedCatalog)]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      unit
      (begin
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-catalog-hits
          1)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-interpreted-fallbacks
          1)))))

(cfg
  (all embedded-stdlib-tlci compile-profile)
  (define (macro-note-embedded-tlci-shell-fallback!
    [state : TcMacroState]
    [catalog : (& catalog MacroTlciResolvedCatalog)]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      unit
      (begin
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-catalog-hits
          1)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-shell-cache-hits
          1)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-interpreted-fallbacks
          1)))))

(cfg
  compile-profile
  (define (macro-note-embedded-tlci-slot-fallback!
    [state : TcMacroState]
    [dependency-slot : i64]
    [metric : i64]) : unit
    (if (>= dependency-slot 0)
      unit
      (begin
        (compiler-tc-macro-profile-metric-add! state metric 1)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-stdlib-interpreted-fallbacks
          1)))))

;; Expression position can resolve the catalog before binding. A native
;; commit consumes the shared capture values directly. If the first dispatch
;; learns a registration shell, fold those same values into the semantic
;; fallback environment once rather than checking the operands again.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-direct-expression
    [ctx : TcContext]
    [decls : ast.AstDeclList]
    [fallback-module : String]
    [fallback-module-id : i64]
    [type-env : TcTypeEnv]
    [macro-name-id : i64]
    [declaration-id : i64]
    [macro-name : String]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [expanded-args : ast.AstExprList]
    [call-expr : ast.AstExpr]) : MacroDirectStdlibTlciResult
    (if (or
      (not
        (tc-macro-walk-field
          (tc-context-macro-state ctx)
          macro-expand-stdlib-tlci-route-active))
      (> params.len embedded_tlci.compiler-comptime-host-operand-cap))
      No
      (let
        [dependency-slot : i64
          (macro-dependency-tlci-catalog-slot-for-declaration
            ctx
            declaration-id)]
        [identity : String
          (macro-tlci-catalog-identity
            (tc-global-shared-view fallback-module)
            (tc-global-shared-view macro-name))]
        (match (macro-tlci-catalog-select
          ctx
          (tc-global-shared-view fallback-module)
          (tc-global-shared-view identity)
          declaration-id)
          [(None) No]
          [(Resolved catalog)
            (cfg compile-profile (compiler-tc-walk-direct-marshal-start!))
            (match (let
              [capture-result : ResultMacroCapturedOperands
                (macro-capture-params-direct
                  ctx
                  decls
                  (tc-global-shared-view fallback-module)
                  fallback-module-id
                  type-env
                  (tc-global-shared-view macro-name)
                  (tc-global-shared-view params)
                  (tc-global-shared-view expanded-args)
                  (tc-ctfe-env ctx)
                  (macro-expand-expr-type-macro?
                    (tc-context-macro-state ctx)
                    fallback-module-id
                    macro-name-id)
                  (tc-global-shared-view call-expr))]
              (cfg compile-profile (compiler-tc-walk-direct-marshal-finish!))
              capture-result)
              [(Err diag) (Err diag)]
              [(Ok operands count base-env syntax-pools)
                (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
                  (tc-context-ctfe-macro-state ctx))
                (macro-result-provenance-reset-with-captured-body!
                  (tc-context-ctfe-macro-state ctx)
                  (macro-binding-prefix-transformer?
                    ctx
                    fallback-module
                    fallback-module-id
                    macro-name-id
                    (tc-global-shared-view params)))
                (macro-hygiene-produced-eval-start-with-pools!
                  (tc-context-macro-state ctx)
                  syntax-pools)
                (cfg compile-profile (compiler-tc-macro-profile-start))
                (match (let
                  [native-result : MacroNativeStdlibTlciResult
                    (macro-try-stdlib-tlci-native-resolved
                      syntax-pools
                      (tc-context-macro-state ctx)
                      identity
                      (tc-global-shared-view catalog)
                      (tc-global-shared-view params)
                      ret
                      base-env
                      call-expr
                      (tc-global-shared-view operands)
                      count
                      true)]
                  native-result)
                  [(Value value)
                    (tc-context-install-pools! ctx)
                    (cfg
                      compile-profile
                      (begin
                        (if (macro-tlci-resolved-catalog-dependency? catalog)
                          unit
                          (compiler-tc-macro-profile-metric-add!
                            (tc-context-macro-state ctx)
                            tc-profile-stdlib-direct-expr-results
                            1))
                        (compiler-tc-macro-profile-finish
                          (tc-context-macro-state ctx)
                          (ci.intern-composite-pair-id
                            fallback-module-id
                            macro-name-id)
                          macro-name
                          expanded-args)))
                    (Value
                      (ctfe_support.ctfe-capture-syntax-value-with-pools
                        value
                        syntax-pools))]
                  [(Err diag)
                    (cfg
                      compile-profile
                      (compiler-tc-macro-profile-finish
                        (tc-context-macro-state ctx)
                        (ci.intern-composite-pair-id
                          fallback-module-id
                          macro-name-id)
                        macro-name
                        expanded-args))
                    (Err (box diag))]
                  [(Shell)
                    (cfg
                      compile-profile
                      (macro-note-embedded-tlci-resolved-fallback!
                        (tc-context-macro-state ctx)
                        catalog)
                      unit)
                    (macro-dependency-tlci-note-if!
                      (tc-context-macro-state ctx)
                      catalog
                      tc-dependency-tlci-direct-shell-env-folds)
                    (cfg
                      compile-profile
                      (compiler-tc-macro-profile-metric-add!
                        (tc-context-macro-state ctx)
                        tc-profile-stdlib-direct-shell-env-folds
                        1))
                    (PreparedEnv
                      (macro-fold-captured-operands-env
                        params
                        operands
                        count
                        (ctfe_support.ctfe-env-rebase-syntax-pools
                          base-env
                          syntax-pools)))]
                  [(No)
                    (cfg
                      compile-profile
                      (macro-note-embedded-tlci-resolved-fallback!
                        (tc-context-macro-state ctx)
                        catalog)
                      unit)
                    BoundFallback])])]
          [(Shell catalog)
            (cfg
              compile-profile
              (macro-note-embedded-tlci-shell-fallback!
                (tc-context-macro-state ctx)
                catalog)
              unit)
            BoundFallback]
          [(or (MetadataOnly) (Missing))
            (cfg
              compile-profile
              (macro-note-embedded-tlci-slot-fallback!
                (tc-context-macro-state ctx)
                dependency-slot
                tc-profile-stdlib-catalog-misses)
              unit)
            BoundFallback]
          [(Unavailable)
            (cfg
              compile-profile
              (macro-note-embedded-tlci-slot-fallback!
                (tc-context-macro-state ctx)
                dependency-slot
                tc-profile-stdlib-load-failures)
              unit)
            BoundFallback])))))

(cfg
  (not embedded-stdlib-tlci)
  (define (macro-try-stdlib-tlci-direct-expression
    [ctx : TcContext]
    [_decls : ast.AstDeclList]
    [fallback-module : String]
    [_fallback-module-id : i64]
    [_type-env : TcTypeEnv]
    [_macro-name-id : i64]
    [declaration-id : i64]
    [macro-name : String]
    [_params : ast.AstMacroParamList]
    [_ret : ast.AstType]
    [_expanded-args : ast.AstExprList]
    [_call-expr : ast.AstExpr]) : MacroDirectStdlibTlciResult
    (match (macro-dependency-tlci-catalog-lookup
      ctx
      (macro-dependency-tlci-catalog-slot-for-declaration ctx declaration-id)
      (macro-tlci-catalog-identity fallback-module macro-name))
      [(NoCatalog) No]
      [_ BoundFallback])))

(define (macro-prepare-transformer-pools! [ctx : TcContext]) : unit
  ;; Argument normalization may extend the owned context while the global
  ;; active pool still points at an older caller snapshot. Outside the compat
  ;; context the active pool's lengths are the pool globals that
  ;; `ast-node-pool-context-capture-active` would copy, so they are read
  ;; directly instead of through a fresh snapshot on every preparation.
  (if (ast.ast-node-pool-compat-context-active?)
    unit
    (let
      [owned-pools : ast.AstNodePoolContext (tc-context-pools ctx)]
      (if (or
        (>
          (ast.ast-node-pool-context-expr-len owned-pools)
          (ast.ast-node-pool-len))
        (>
          (ast.ast-node-pool-context-type-len owned-pools)
          (ast.ty-node-pool-len)))
        (begin
          (cfg
            compile-profile
            (counters.bump! tc-profile-prepare-pools-installs)
            unit)
          (tc-context-install-pools! ctx))
        (tc-context-capture-active-pools! ctx)))))

(define (macro-adopt-transformer-env-pools!
  [ctx : TcContext]
  [env : (& env ctfe_support.CtfeEnv)]) : unit
  ;; CTFE syntax builders append through the transformer's retained syntax
  ;; context. Publish that newer state through the caller-owned cells before
  ;; hygiene reads the active pool boundary.
  (let
    [syntax-pools : ast.AstNodePoolContext
      (ctfe_support.ctfe-env-syntax-pool-context env)]
    (ast.ast-node-pool-context-adopt-newer!
      (tc-context-pools-live ctx)
      (ast.ast-node-pool-context-shared-view (& syntax-pools)))
    (tc-context-install-pools! ctx)))

(define (macro-eval-transformer-interpreted-with-env
  [ctx : TcContext]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [fallback-module-id : i64]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [macro-name-id : i64]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [macro-name : String]
  [body : ast.AstExpr]
  [captured-body? : bool]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [expanded-args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]) : ResultMacroValueEnv
  (begin
    (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
      (tc-context-ctfe-macro-state ctx))
    (macro-result-provenance-reset-with-captured-body!
      (tc-context-ctfe-macro-state ctx)
      captured-body?)
    (macro-hygiene-produced-eval-start! (tc-context-macro-state ctx) env)
    (cfg compile-profile (compiler-tc-macro-profile-start))
    (match (ctfe_support.ctfe-eval-node
      body
      (ctfe_support.ctfe-env-extend-id
        env
        (ctfe_support.ctfe-hygiene-enabled-id)
        (Bool true))
      (ctfe_support.ctfe-fuel-limit))
      [(Ok value _)
        (begin
          (macro-adopt-transformer-env-pools! ctx env)
          (cfg
            compile-profile
            (compiler-tc-macro-profile-finish
              (tc-context-macro-state ctx)
              (ci.intern-composite-pair-id fallback-module-id macro-name-id)
              macro-name
              expanded-args))
          (Ok value env))]
      [(Err diag)
        (begin
          (cfg
            compile-profile
            (compiler-tc-macro-profile-finish
              (tc-context-macro-state ctx)
              (ci.intern-composite-pair-id fallback-module-id macro-name-id)
              macro-name
              expanded-args))
          (Err diag))])))

(define (macro-bind-transformer-expanded-profiled
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (macro-prepare-transformer-pools! ctx)
  (let
    [bind-result : ResultMacroEnv
      (macro-bind-params
        ctx
        decls
        fallback-module
        fallback-module-id
        type-env
        macro-name
        params
        expanded-args
        (tc-ctfe-env ctx)
        (macro-expand-expr-type-macro?
          (tc-context-macro-state ctx)
          fallback-module-id
          macro-name-id)
        call-expr)]
    (begin
      (cfg compile-profile (counters.bump! compiler-tc-walk-operand-captures))
      bind-result)))

;; Run a macro transformer via CTFE. Module/declaration macro expansion also
;; needs the bound CTFE environment while normalizing generated import operands.
(define (macro-eval-transformer-expanded-with-env
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroValueEnv
  (let
    [env
      (try
        (macro-bind-transformer-expanded-profiled
          ctx
          decls
          (tc-global-shared-view fallback-module)
          fallback-module-id
          type-env
          macro-name-id
          (tc-global-shared-view macro-name)
          (tc-global-shared-view params)
          (tc-global-shared-view expanded-args)
          (tc-global-shared-view call-expr)))]
    (begin
      ;; Both routes publish per-transformer syntax metadata. Reset before
      ;; native dispatch as well as before an interpreted fallback so an
      ;; earlier expansion cannot leak either marker into this result.
      (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
        (tc-context-ctfe-macro-state ctx))
      (macro-result-provenance-reset-with-captured-body!
        (tc-context-ctfe-macro-state ctx)
        (macro-binding-prefix-transformer?
          ctx
          (tc-global-shared-view fallback-module)
          fallback-module-id
          macro-name-id
          (tc-global-shared-view params)))
      (macro-hygiene-produced-eval-start! (tc-context-macro-state ctx) env)
      (cfg compile-profile (compiler-tc-macro-profile-start))
      (match (let
        [native-result : MacroNativeStdlibTlciResult
          (macro-try-stdlib-tlci-native
            ctx
            (tc-global-shared-view fallback-module)
            declaration-id
            (tc-global-shared-view macro-name)
            (tc-global-shared-view params)
            (tc-global-shared-view ret)
            env
            call-expr)]
        native-result)
        [(Value value)
          (begin
            (macro-adopt-transformer-env-pools! ctx env)
            (cfg
              compile-profile
              (compiler-tc-macro-profile-finish
                (tc-context-macro-state ctx)
                (ci.intern-composite-pair-id fallback-module-id macro-name-id)
                macro-name
                expanded-args))
            (Ok value env))]
        [(Err diag)
          (begin
            (cfg
              compile-profile
              (compiler-tc-macro-profile-finish
                (tc-context-macro-state ctx)
                (ci.intern-composite-pair-id fallback-module-id macro-name-id)
                macro-name
                expanded-args))
            (Err (box diag)))]
        [(or (No) (Shell))
          (macro-note-stdlib-tlci-route
            (tc-context-macro-state ctx)
            (tc-global-shared-view fallback-module)
            (tc-global-shared-view macro-name)
            ret)
          (macro-eval-transformer-interpreted-with-env
            ctx
            fallback-module-id
            macro-name-id
            macro-name
            body
            (macro-binding-prefix-transformer?
              ctx
              fallback-module
              fallback-module-id
              macro-name-id
              params)
            expanded-args
            env)]))))

;; Run a macro transformer via CTFE. Callers decide how to interpret the
;; returned syntax value for expression, module, or declaration positions.
(define (macro-eval-transformer-expanded
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroValue
  (macro-prepare-transformer-pools! ctx)
  (match (macro-try-stdlib-tlci-direct-expression
    ctx
    (tc-global-shared-view decls)
    (tc-global-shared-view fallback-module)
    fallback-module-id
    type-env
    macro-name-id
    declaration-id
    (tc-global-shared-view macro-name)
    (tc-global-shared-view params)
    (tc-global-shared-view ret)
    (tc-global-shared-view expanded-args)
    (tc-global-shared-view call-expr))
    [(Value value) (Ok value)]
    [(Err diag) (Err diag)]
    [(PreparedEnv env)
      (match (macro-eval-transformer-interpreted-with-env
        ctx
        fallback-module-id
        macro-name-id
        macro-name
        body
        (macro-binding-prefix-transformer?
          ctx
          fallback-module
          fallback-module-id
          macro-name-id
          params)
        expanded-args
        env)
        [(Ok value _) (Ok value)]
        [(Err diag) (Err diag)])]
    [(BoundFallback)
      (let
        [env
          (try
            (macro-bind-transformer-expanded-profiled
              ctx
              decls
              (tc-global-shared-view fallback-module)
              fallback-module-id
              type-env
              macro-name-id
              (tc-global-shared-view macro-name)
              (tc-global-shared-view params)
              (tc-global-shared-view expanded-args)
              call-expr))]
        (match (macro-eval-transformer-interpreted-with-env
          ctx
          fallback-module-id
          macro-name-id
          macro-name
          body
          (macro-binding-prefix-transformer?
            ctx
            fallback-module
            fallback-module-id
            macro-name-id
            params)
          expanded-args
          env)
          [(Ok value _) (Ok value)]
          [(Err diag) (Err diag)]))]
    [(No)
      (match (macro-eval-transformer-expanded-with-env
        ctx
        decls
        fallback-module
        fallback-module-id
        type-env
        macro-name-id
        declaration-id
        macro-name
        params
        ret
        body
        expanded-args
        call-expr)
        [(Ok value _) (Ok value)]
        [(Err diag) (Err diag)])]))

(define (macro-binding-prefix-form? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(BracketClause _) true]
    [_ false]))

(define (macro-expand-binding-prefix-items
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [items : ast.AstExprList]) : ResultMacroExpr
  (let
    [len : i64 items.len]
    (if (<= len 1)
      (Ok (ast.ast-expr-bracket-clause items))
      (let
        [ninit : i64
          (try
            (macro-expand-node
              ctx
              type-env
              decls
              depth
              (ast.ast-expr-list-get (& items) (- len 1) 0)))]
        [out : ast.AstExprList (ast.ast-expr-list-with-capacity len)]
        [index : i64 0]
        (while (< index (- len 1))
          (ast.ast-expr-list-push
            (&mut out)
            (ast.ast-expr-list-get (& items) index 0))
          (set! index (+ index 1)))
        (ast.ast-expr-list-push (&mut out) ninit)
        (Ok (ast.ast-expr-bracket-clause out))))))

(define (macro-expand-binding-prefix-form
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  (match (tc-global-shared-view expr)
    [(Spanned inner span)
      (let
        [ninner
          (try
            (macro-expand-binding-prefix-form
              ctx
              type-env
              decls
              depth
              (tc-context-expr-get ctx inner)))]
        (Ok (ast.ast-expr-spanned ninner span)))]
    [(MacroExpansion inner provenance-id macro-name-id)
      (let
        [ninner
          (try
            (macro-expand-binding-prefix-form
              ctx
              type-env
              decls
              depth
              (tc-context-expr-get ctx inner)))]
        (Ok (ast.ast-expr-macro-expansion ninner provenance-id macro-name-id)))]
    [(BracketClause items)
      (macro-expand-binding-prefix-items ctx type-env decls depth items)]
    [_
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            expr
            "typecheck: expected binding clause")))]))

(define (macro-expand-binding-prefix-args-into
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : ResultMacroCheck
  (if (>= index args.len)
    Ok
    (let
      [head-id : i64 (ast.ast-expr-list-get args index 0)]
      [head : ast.AstExpr (tc-context-expr-get ctx head-id)]
      (if (macro-binding-prefix-form?
        (tc-context-expr-bases ctx)
        (tc-global-shared-view head))
        (let
          [nhead
            (try
              (macro-expand-binding-prefix-form
                ctx
                type-env
                (tc-global-shared-view decls)
                depth
                head))]
          (ast.ast-expr-list-push out nhead)
          (macro-expand-binding-prefix-args-into
            ctx
            type-env
            decls
            depth
            args
            (+ index 1)
            out))
        (begin
          ;; The remaining Expr operands are captured syntax. They must be
          ;; expanded after the binding transformer introduces their lexical
          ;; scope, not as arguments to the transformer itself.
          (ast.ast-expr-list-append-from out args index)
          Ok)))))

(define (macro-expand-binding-prefix-args
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [args : ast.AstExprList]) : ResultMacroExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity args.len)]
    [_
      (try
        (macro-expand-binding-prefix-args-into
          ctx
          type-env
          decls
          depth
          (& args)
          0
          (&mut out)))]
    (Ok out)))

(define (macro-binding-prefix-transformer?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name-id : i64]
  [params : ast.AstMacroParamList]) : bool
  (if (or
    (not (string.eq (ci.intern-str macro-name-id) "for"))
    (not (= (ast.ast-macro-param-list-len (& params)) 2)))
    false
    (match (ast.ast-macro-param-list-get
      (& params)
      0
      (ast.ast-macro-param-fallback))
      [(Param _ binding-ty binding-variadic _)
        (match (ast.ast-macro-param-list-get
          (& params)
          1
          (ast.ast-macro-param-fallback))
          [(Param _ body-ty body-variadic _)
            (and
              binding-variadic
              body-variadic
              (macro-param-expr-binding-clause?
                ctx
                (tc-global-shared-view fallback-module)
                fallback-module-id
                binding-ty)
              (tc-type-eq
                (macro-resolve-signature-type-id
                  ctx
                  fallback-module
                  fallback-module-id
                  body-ty)
                (Expr)))])])))

(define (macro-eval-transformer
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroValue
  ;; Expand ordinary operands first so a macro call passed as an argument (e.g.
  ;; a nested `str_cat.str-cat`) is reduced before it is typechecked. A
  ;; binding-prefix transformer is different: only its clause initializers are
  ;; in the caller's current scope; captured Expr bodies are expanded after the
  ;; transformer introduces their binders.
  (let
    [expanded-args
      (try
        (if (macro-binding-prefix-transformer?
          ctx
          (tc-global-shared-view fallback-module)
          fallback-module-id
          macro-name-id
          (tc-global-shared-view params))
          (macro-expand-binding-prefix-args
            ctx
            type-env
            (tc-global-shared-view decls)
            depth
            args)
          (macro-expand-exprs
            ctx
            type-env
            (tc-global-shared-view decls)
            depth
            args)))]
    (macro-eval-transformer-expanded
      ctx
      decls
      fallback-module
      fallback-module-id
      type-env
      macro-name-id
      declaration-id
      macro-name
      params
      ret
      body
      expanded-args
      call-expr)))

(define (macro-generated-type-param-expr-list
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [exprs : ast.AstExprList]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    (macro-generated-type-param-expr-list-into pools env (& exprs) 0 (&mut out))
    out))

(define (macro-generated-type-param-expr-list-into
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : unit
  (unless
    (>= index exprs.len)
    (ast.ast-expr-list-push
      out
      (macro-generated-type-param-expr
        pools
        env
        (ast.ast-node-pool-context-expr-get
          pools
          (ast.ast-expr-list-get exprs index 0))))
    (macro-generated-type-param-expr-list-into pools env exprs (+ index 1) out)))

;; Generated import operands and their existing child ids belong to the
;; typechecker's syntax pool. Pass that pool explicitly so rewriting cannot
;; consult or mutate whichever compatibility pool another compile job installed.
(define (macro-generated-type-param-expr
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [expr : ast.AstExpr]) : i64
  (match (tc-global-shared-view expr)
    [(Spanned inner-box span)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (ast.ast-node-pool-context-expr-push
          pools
          (Spanned (macro-generated-type-param-expr pools env inner) span)))]
    [(MacroExpansion inner-box provenance-id macro-name-id)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (ast.ast-node-pool-context-expr-push
          pools
          (MacroExpansion
            (macro-generated-type-param-expr pools env inner)
            provenance-id
            macro-name-id)))]
    [(Var name)
      (let
        [lookup-id : i64
          (macro-output-source-identity-id-at
            (tc-ctfe-env-structural-session env)
            name
            "generated-type-param")]
        (match (if (>= lookup-id 0)
          (ctfe_support.ctfe-env-lookup-id env lookup-id)
          (ctfe_support.CtfeMaybeValue.None))
          [(Some value)
            (match value
              [(Type ty)
                (ast.ast-node-pool-context-expr-push
                  pools
                  (TypeLiteral (ast.ast-node-pool-context-type-push pools ty)))]
              [_ (ast.ast-node-pool-context-expr-push pools expr)])]
          [(None) (ast.ast-node-pool-context-expr-push pools expr)]))]
    [(Call func-box args)
      (ast.ast-node-pool-context-expr-push
        pools
        (Call func-box (macro-generated-type-param-expr-list pools env args)))]
    [_ (ast.ast-node-pool-context-expr-push pools expr)]))

(define (macro-generated-call-func-for-lookup
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [expr : ast.AstExpr]) : ast.AstExpr
  (match (ast.ast-expr-unspan-with-pools pools (& expr))
    [(Var name)
      (Var
        (macro-output-source-identity-id-at session name "generated-call-func"))]
    [_ expr]))

(define (macro-generated-import-type-arg
  [pools : ast.AstNodePoolContext]
  [ty : ast.AstType]
  [arg : i64]
  [env : ctfe_support.CtfeEnv]) : i64
  (if (tc-macro-type-param-kind? ty)
    (macro-generated-type-param-expr
      pools
      env
      (ast.ast-node-pool-context-expr-get pools arg))
    arg))

(define (macro-generated-import-bracket-prefix-count
  [pools : ast.AstNodePoolContext]
  [args : (& args ast.AstExprList)]
  [index : i64]) : i64
  (if (>= index args.len)
    0
    (match (ast.ast-expr-unspan-with-pools
      pools
      (&
        (ast.ast-node-pool-context-expr-get
          pools
          (ast.ast-expr-list-get args index 0))))
      [(BracketClause _)
        (+
          1
          (macro-generated-import-bracket-prefix-count pools args (+ index 1)))]
      [_ 0])))

(define (macro-generated-import-prepend-range
  [args : (& args ast.AstExprList)]
  [index : i64]
  [end : i64]
  [tail : ast.AstExprList]) : ast.AstExprList
  (if (>= index end)
    tail
    (ast.ast-expr-cons
      (ast.ast-expr-list-get args index 0)
      (& (macro-generated-import-prepend-range args (+ index 1) end tail)))))

(define (macro-generated-import-type-args-for-param
  [pools : ast.AstNodePoolContext]
  [param : ast.AstMacroParam]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (match param
    [(Param _ ty variadic _)
      (if variadic
        (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
          (let
            [remaining : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref args arg-index)]
            (if (tc-macro-type-param-kind? ty)
              (macro-generated-type-param-expr-list pools env remaining)
              remaining))
          (let
            [prefix-count : i64
              (macro-generated-import-bracket-prefix-count pools args arg-index)]
            [next-arg-index : i64 (+ arg-index prefix-count)]
            (macro-generated-import-prepend-range
              args
              arg-index
              next-arg-index
              (macro-generated-import-type-args-at
                pools
                params
                args
                (+ param-index 1)
                next-arg-index
                env))))
        (ast.ast-expr-cons
          (macro-generated-import-type-arg
            pools
            ty
            (ast.ast-expr-list-get args arg-index 0)
            env)
          (&
            (macro-generated-import-type-args-at
              pools
              params
              args
              (+ param-index 1)
              (+ arg-index 1)
              env))))]))

(define (macro-generated-import-type-args
  [pools : ast.AstNodePoolContext]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (macro-generated-import-type-args-at pools (& params) (& args) 0 0 env))

(define (macro-generated-import-type-args-at
  [pools : ast.AstNodePoolContext]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (if (>= param-index (ast.ast-macro-param-list-len params))
    (ast.ast-expr-list-tail-from-ref args arg-index)
    (if (>= arg-index args.len)
      (ast.ast-expr-list-new)
      (macro-generated-import-type-args-for-param
        pools
        (ast.ast-macro-param-list-get
          params
          param-index
          (ast.ast-macro-param-fallback))
        params
        args
        param-index
        arg-index
        env))))

(define (macro-rewrite-generated-import-call-with-decl
  [pools : ast.AstNodePoolContext]
  [func-box : i64]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [fallback : i64]
  [maybe-decl : MacroMaybeDecl]) : i64
  (match maybe-decl
    [(Some _ _ _ params _ _)
      (ast.ast-node-pool-context-expr-push
        pools
        (Call func-box (macro-generated-import-type-args pools params args env)))]
    [(No) fallback]))

(define (macro-rewrite-generated-import-direct-call
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [_ : String]
  [module-id : i64]
  [func : ast.AstExpr]
  [call-expr : ast.AstExpr]
  [func-box : i64]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [fallback : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (ctfe_support.ctfe-env-pools env)]
    (match (ast.ast-expr-unspan-with-pools pools (& func))
      [(Var name)
        (let
          [lookup-name : String
            (macro-output-source-name-id-at
              (tc-context-structural-session ctx)
              name
              "generated-import-call")]
          [source-id : i64
            (macro-output-syntax-id-at
              (tc-context-structural-session ctx)
              name
              "generated-import-call")]
          (if (or
            (tc-name-qualified-id?
              (tc-context-structural-session ctx)
              source-id)
            (tc-source-slash-qualified-id?
              (tc-context-structural-session ctx)
              lookup-name
              source-id)
            (>=
              (tc-name-first-dot-id
                (tc-context-structural-session ctx)
                source-id)
              0))
            fallback
            (match (macro-import-alias-target-cached-id-in-context
              ctx
              decls
              module-id
              source-id)
              [(Some target-id)
                (match (macro-unqualified-imported-target-call-decl
                  ctx
                  target-id
                  source-id
                  call-expr)
                  [(Ok maybe-decl)
                    (match (tc-global-shared-view maybe-decl)
                      [(Some _ _ _ _ _ _)
                        (macro-rewrite-generated-import-call-with-decl
                          pools
                          func-box
                          args
                          env
                          fallback
                          maybe-decl)]
                      [(No)
                        (ast.ast-node-pool-context-expr-push
                          pools
                          (Call
                            func-box
                            (macro-generated-type-param-expr-list
                              pools
                              env
                              args)))])]
                  [(Err _) fallback])]
              [(No) fallback])))]
      [_ fallback])))

(define (macro-rewrite-generated-import-call-id
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [call-id : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (ctfe_support.ctfe-env-pools env)]
    [call-expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools call-id)]
    [rewritten : i64
      (match (ast.ast-expr-unspan-with-pools pools (& call-expr))
        [(Call func-box args)
          (let
            [func : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools func-box)]
            [lookup-func : ast.AstExpr
              (macro-generated-call-func-for-lookup
                (tc-context-structural-session ctx)
                pools
                func)]
            (match (macro-call-decl-with-context
              ctx
              (tc-global-shared-view lookup-func)
              (tc-global-shared-view orig-decls)
              (tc-global-shared-view module)
              module-id
              (Some definition-module-id)
              (tc-global-shared-view call-expr))
              [(Ok maybe-decl _ _)
                (match (tc-global-shared-view maybe-decl)
                  [(Some _ _ _ _ _ _)
                    (macro-rewrite-generated-import-call-with-decl
                      pools
                      func-box
                      args
                      env
                      call-id
                      maybe-decl)]
                  [(No)
                    (macro-rewrite-generated-import-direct-call
                      ctx
                      orig-decls
                      module
                      module-id
                      lookup-func
                      call-expr
                      func-box
                      args
                      env
                      call-id)])]
              [(Err _)
                (macro-rewrite-generated-import-direct-call
                  ctx
                  orig-decls
                  module
                  module-id
                  lookup-func
                  call-expr
                  func-box
                  args
                  env
                  call-id)]))]
        [_ call-id])]
    ;; Explicit pushes update the context cell, while compatibility pushers
    ;; still read the installed scalar state. Publish the rewritten context
    ;; before the next declaration can append through that legacy surface.
    (tc-install-pools! pools)
    rewritten))

(define (macro-rewrite-generated-import-kind
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [kind : ast.AstImportKind]) : ast.AstImportKind
  (match kind
    [(Macro call-id context)
      (Macro
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [(MacroDecls call-id context)
      (MacroDecls
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [_ kind]))

(define (macro-rewrite-generated-import-decl
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decl : ast.AstDecl]) : ast.AstDecl
  (match (tc-global-shared-view decl)
    [(Import decl-meta (Spec kind path expected alias span))
      (Import
        decl-meta
        (Spec
          (macro-rewrite-generated-import-kind
            ctx
            orig-decls
            module
            module-id
            definition-module-id
            env
            kind)
          path
          expected
          alias
          span))]
    [(Unsafe inner-box)
      (ast.ast-decl-unsafe
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          (ast.ast-decl-box-shared-view inner-box)))]
    [(ModuleBody name body-box)
      (ast.ast-decl-module-body-id
        name
        (macro-rewrite-generated-import-decls-with-env
          ctx
          orig-decls
          (tc-env-key-name-text name)
          name
          definition-module-id
          env
          (ast.ast-decl-list-box-shared-view body-box)))]
    [_ decl]))

(define (macro-rewrite-generated-import-decls-with-env
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decls : ast.AstDeclList]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [cursor : ast.AstDeclList decls]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (ast.ast-decl-list-push
            (&mut out)
            (macro-rewrite-generated-import-decl
              ctx
              (tc-global-shared-view orig-decls)
              (tc-global-shared-view module)
              module-id
              definition-module-id
              env
              decl))
          (set! cursor rest)]))
    out))

(define (macro-rewrite-generated-import-decls
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decls : ast.AstDeclList]) : ast.AstDeclList
  (let
    ;; Parsing and hygiene may have appended generated syntax after `ctx` was
    ;; captured. The installed live context owns those ids and shares its cells
    ;; with compatibility pushers, so select it once at this migration
    ;; boundary and keep every rewrite below explicit.
    [rewrite-pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-active-live)]
    [rewrite-env : ctfe_support.CtfeEnv
      (ctfe_support.ctfe-env-extend-id
        (ctfe_support.ctfe-env-rebase-pools env rewrite-pools)
        (ctfe_support.ctfe-hygiene-enabled-id)
        (Bool true))]
    (macro-rewrite-generated-import-decls-with-env
      ctx
      orig-decls
      module
      module-id
      definition-module-id
      rewrite-env
      decls)))

;; Run an expression-position macro transformer via CTFE and re-expand its
;; produced form to a fixpoint.
(define (macro-expand-produced-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr-id : i64]) : ResultMacroExpr
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    ;; A transformer result may live in its scratch pool rather than `ctx`.
    ;; Capture the installed table after evaluation and keep it for this
    ;; read-only fire scan.
    [expr-bases : i64 (ast.ast-node-pool-active-expr-segment-bases)]
    [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
    (if (not
      (ctfe_support.ctfe-result-may-contain-macro-for-state?
        (tc-macro-ctfe-state state)))
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-rewalk-provenance-skips))
        ;; Produced roots can belong to a transformer scratch pool. Match the
        ;; old value-entry no-fire path by copying the root into the active AST
        ;; pool before that scratch storage is released.
        (Ok (ast.ast-node-push expr)))
      (let
        [fires : bool
          (macro-expr-might-fire? state expr-bases (tc-global-shared-view expr))]
        (begin
          (cfg
            compile-profile
            (if fires
              unit
              (counters.bump! tc-profile-rewalk-zero-fire-calls)))
          (if (or (not fires) (< (macro-expand-depth-limit) depth))
            (if (not fires)
              (Ok (ast.ast-node-push expr))
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    expr
                    "macro expansion exceeded depth limit"))))
            (macro-expand-expr-fire ctx env decls depth expr)))))))

(define (macro-expand-call-unframed
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [definition-module : String]
  [definition-module-id : i64]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroExpr
  (if (tc-macro-result-module? (tc-global-shared-view ret))
    (Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          "typecheck: Module macro can only be used in import position")))
    (if (tc-macro-result-decls? (tc-global-shared-view ret))
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Decls macro can only be used at module scope")))
      (let
        [value
          (try
            (macro-eval-transformer
              ctx
              type-env
              (tc-global-shared-view decls)
              definition-module
              definition-module-id
              macro-name-id
              declaration-id
              macro-name
              params
              (tc-global-shared-view ret)
              body
              args
              depth
              (tc-global-shared-view call-expr)))]
        (match value
          [(Expr expanded produced)
            (if (tc-macro-produced-type-compatible? ctx ret produced)
              (begin
                (cfg compile-profile (compiler-tc-walk-rewalk-start!))
                (let
                  [rewalk-result : ResultMacroExpr
                    (macro-expand-produced-node
                      ctx
                      type-env
                      decls
                      (+ depth 1)
                      (if (=
                        expanded
                        (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                          (tc-context-ctfe-macro-state ctx)))
                        expanded
                        (begin
                          (macro-hygiene-env-root-begin!
                            (tc-context-macro-state ctx))
                          (let
                            [out : i64
                              (macro-hygiene-produced-expr
                                expanded
                                (macro-hygiene-env-empty
                                  (tc-context-macro-state ctx)
                                  (tc-context-type-pools ctx))
                                (MacroHygieneContext
                                  macro-name-id
                                  definition-module-id
                                  declaration-id
                                  ctx.shared)
                                (+ depth 1))]
                            (macro-hygiene-env-root-finish!
                              (tc-context-macro-state ctx))
                            out))))]
                  (begin
                    (cfg compile-profile (compiler-tc-walk-rewalk-finish!))
                    rewalk-result)))
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "typecheck: macro expansion produced type does not match declaration"))))]
          [(CapturedExpr expanded produced pools)
            (if (tc-macro-produced-type-compatible? ctx ret produced)
              (begin
                ;; CTFE built this syntax beside the checked caller operands.
                ;; Adopt its newer state into the caller-owned cells before
                ;; applying hygiene; the captured context's descriptors may
                ;; themselves belong to the declaration generation.
                (ast.ast-node-pool-context-adopt-newer!
                  (tc-context-pools-live ctx)
                  (ast.ast-node-pool-context-shared-view (& pools)))
                (tc-context-install-pools! ctx)
                (cfg compile-profile (compiler-tc-walk-rewalk-start!))
                (let
                  [rewalk-result : ResultMacroExpr
                    (macro-expand-produced-node
                      ctx
                      type-env
                      decls
                      (+ depth 1)
                      (if (=
                        expanded
                        (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                          (tc-context-ctfe-macro-state ctx)))
                        expanded
                        (begin
                          (macro-hygiene-env-root-begin!
                            (tc-context-macro-state ctx))
                          (let
                            [out : i64
                              (macro-hygiene-produced-expr
                                expanded
                                (macro-hygiene-env-empty
                                  (tc-context-macro-state ctx)
                                  pools)
                                (MacroHygieneContext
                                  macro-name-id
                                  definition-module-id
                                  declaration-id
                                  ctx.shared)
                                (+ depth 1))]
                            (macro-hygiene-env-root-finish!
                              (tc-context-macro-state ctx))
                            out))))]
                  (begin
                    (cfg compile-profile (compiler-tc-walk-rewalk-finish!))
                    rewalk-result)))
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "typecheck: macro expansion produced type does not match declaration"))))]
          [_
            (Err
              (box
                (ctfe_support.ctfe-diagnostic-at-expr
                  call-expr
                  "macro transformer did not produce an Expr")))])))))

(define (macro-expand-call
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [definition-module : String]
  [definition-module-id : i64]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroExpr
  (match (macro-expand-call-unframed
    ctx
    type-env
    decls
    macro-name-id
    declaration-id
    (tc-global-shared-view macro-name)
    definition-module
    definition-module-id
    params
    ret
    body
    args
    depth
    (tc-global-shared-view call-expr))
    [(Ok expanded)
      (Ok
        (if (macro-private-place-bridge-name? macro-name)
          ;; These private one-epoch source bridges only materialize parser AST
          ;; operations. Keeping their expansion transparent avoids treating an
          ;; implementation spelling as a user-facing diagnostic frame and
          ;; preserves nested place operands in the caller pool.
          expanded
          (ast.ast-expr-macro-expansion
            expanded
            (macro-expansion-provenance-id
              (macro-active-decl-path-id ctx)
              (macro-definition-path-id
                ctx
                (ci.intern (tc-global-shared-view macro-name))))
            (ci.intern macro-name))))]
    [(Err diag)
      (Err
        (box
          (macro-diagnostic-with-expansion-site
            ctx
            (macro-active-decl-path ctx)
            call-expr
            macro-name
            (cdiag.compiler-diagnostic-box-shared-view diag))))]))

(define (macro-expand-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [exprs : ast.AstExprList]) : ResultMacroExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    [_
      (try (macro-expand-exprs-into ctx env decls depth (& exprs) 0 (&mut out)))]
    (Ok out)))

(define (macro-expand-exprs-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : ResultMacroCheck
  (if (>= index exprs.len)
    (Ok)
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [nhead (try (macro-expand-node ctx env decls depth head-id))]
      (ast.ast-expr-list-push out nhead)
      (macro-expand-exprs-into ctx env decls depth exprs (+ index 1) out))))

;; Expand a node after its might-fire result is already known. Match arms use
;; this entry so deciding whether an arm needs a type environment does not make
;; the firing arm pay for the same recursive predicate walk a second time.
(define (macro-expand-node-with-fire-decision
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr-id : i64]
  [expr : ast.AstExpr]
  [fires : bool]) : ResultMacroExpr
  (if (or (not fires) (< (macro-expand-depth-limit) depth))
    (if (not fires)
      (Ok expr-id)
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            expr
            "macro expansion exceeded depth limit"))))
    (macro-expand-expr-fire ctx env decls depth expr)))

(define (macro-expand-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [scrut-ty : ast.AstType]
  [first-fire-index : i64]
  [arms : ast.AstMatchArmList]) : ResultMacroArms
  (let
    [out : ast.AstMatchArmList (ast.ast-match-arm-list-with-capacity arms.len)]
    [_
      (try
        (macro-expand-arms-into
          ctx
          env
          decls
          depth
          scrut-ty
          first-fire-index
          (& arms)
          0
          (&mut out)))]
    (Ok out)))

(define (macro-expand-arms-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [scrut-ty : ast.AstType]
  [first-fire-index : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [out : (&mut out ast.AstMatchArmList)]) : ResultMacroCheck
  (if (>= index arms.len)
    (Ok)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
          [body-fires : bool
            (if (<= index first-fire-index)
              (= index first-fire-index)
              (macro-expr-might-fire?
                (tc-context-macro-state ctx)
                (tc-context-expr-bases ctx)
                (tc-global-shared-view body)))]
          (if (not body-fires)
            (let
              [nbody
                (try
                  (macro-expand-node-with-fire-decision
                    ctx
                    env
                    (tc-global-shared-view decls)
                    depth
                    body-box
                    body
                    false))]
              (ast.ast-match-arm-list-push
                out
                (ast.ast-match-arm pattern nbody))
              (macro-expand-arms-into
                ctx
                env
                decls
                depth
                scrut-ty
                first-fire-index
                arms
                (+ index 1)
                out))
            (let
              [arm-env-result : ResultTcEnv
                (tc-bind-match-pattern
                  ctx
                  env
                  (tc-global-shared-view scrut-ty)
                  (tc-global-shared-view pattern))]
              (match arm-env-result
                [(Ok arm-env)
                  (let
                    [nbody
                      (try
                        (macro-expand-node-with-fire-decision
                          ctx
                          arm-env
                          (tc-global-shared-view decls)
                          depth
                          body-box
                          body
                          true))]
                    (ast.ast-match-arm-list-push
                      out
                      (ast.ast-match-arm pattern nbody))
                    (macro-expand-arms-into
                      ctx
                      env
                      decls
                      depth
                      scrut-ty
                      first-fire-index
                      arms
                      (+ index 1)
                      out))]
                [(Err message)
                  (Err
                    (box
                      (tc-expr-diag (tc-context-expr-bases ctx) body message)))]))))])))

(define (macro-expand-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : ast.AstLetBindingList]) : ResultMacroLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    [final-env
      (try
        (macro-expand-bindings-into
          ctx
          env
          decls
          depth
          (& bindings)
          0
          (&mut out)))]
    (Ok out final-env)))

(define (macro-expand-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : ResultMacroLetBindingsBuild
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [ninit (try (macro-expand-node ctx env decls depth init-box))]
          (match (let
            [let-bind-result : ResultTcEnv
              (tc-let-bindings
                ctx
                env
                (ast.ast-let-binding-cons
                  (&
                    (ast.ast-let-binding-id
                      name
                      (tc-global-shared-view maybe-ty)
                      ninit))
                  (& (ast.ast-let-binding-list-new))))]
            ;; Expansion checks the binders that enclose a macro call (here,
            ;; for `with` bindings and for `match` scrutinees) so the call
            ;; sees their types. The check pushes through both `ctx`'s cells
            ;; and the global pushers, and the next transformer install
            ;; would roll back whichever side is ahead: later pushes then
            ;; overwrite checked types behind their dedup entries, and a
            ;; parameter of type `(& a S)` reads back as `bool`. Neither an
            ;; install before the check nor a capture after it is enough.
            [_publish : unit (tc-context-publish-newer-pools! ctx)]
            let-bind-result)
            [(Ok next-env)
              (ast.ast-let-binding-list-push
                out
                (ast.ast-let-binding-id name maybe-ty ninit))
              (macro-expand-bindings-into
                ctx
                next-env
                decls
                depth
                bindings
                (+ index 1)
                out)]
            [(Err message)
              (Err
                (box
                  (tc-expr-diag
                    (tc-context-expr-bases ctx)
                    (tc-context-expr-get ctx ninit)
                    message)))]))])))

(define (macro-expand-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : ast.AstResourceBindingList]) : ResultMacroResourceBindings
  (let
    [out : ast.AstResourceBindingList
      (ast.ast-resource-binding-list-with-capacity
        (ast.ast-resource-binding-list-len (& bindings)))]
    [final-env
      (try
        (macro-expand-resource-bindings-into
          ctx
          env
          decls
          depth
          (& bindings)
          0
          (&mut out)))]
    (Ok out final-env)))

(define (macro-expand-resource-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]
  [out : (&mut out ast.AstResourceBindingList)]) : ResultMacroResourceBindingsBuild
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok env)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box cleanup-box move-aware?)
        (let
          [ninit (try (macro-expand-node ctx env decls depth init-box))]
          [ncleanup (try (macro-expand-node ctx env decls depth cleanup-box))]
          [binding : ast.AstResourceBinding
            (Binding name ninit ncleanup move-aware?)]
          [single : ast.AstResourceBindingList
            (ast.ast-resource-binding-cons
              binding
              (& (ast.ast-resource-binding-list-new)))]
          [checked : ResultTcEnv (tc-resource-bindings ctx env single)]
          [_publish : unit (tc-context-publish-newer-pools! ctx)]
          (match checked
            [(Ok next-env)
              (ast.ast-resource-binding-list-push out binding)
              (macro-expand-resource-bindings-into
                ctx
                next-env
                decls
                depth
                bindings
                (+ index 1)
                out)]
            [(Err message)
              (Err
                (box
                  (tc-expr-diag
                    (tc-context-expr-bases ctx)
                    (tc-context-expr-get ctx ninit)
                    message)))]))])))

(define (macro-compat-unit-expr) : i64
  (ast.ast-node-push (Literal Unit)))

(define (macro-compat-append-unit [exprs : ast.AstExprList]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity (+ exprs.len 1))]
    (ast.ast-expr-list-append-from (&mut out) (& exprs) 0)
    (ast.ast-expr-list-push (&mut out) (macro-compat-unit-expr))
    out))

(define (macro-compat-call-name [ctx : TcContext] [func : ast.AstExpr]) : TcMaybeString
  (let
    [structural-session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    (match (ast.ast-expr-unspan-with-segment-bases
      (tc-context-expr-bases ctx)
      (& func))
      [(Var name)
        (if (or
          (macro-hygiene-global-id? structural-session name)
          (tc-structural-local-name-id? structural-session name)
          (csym.compiler-composite-pair-key-id? name)
          (csym.compiler-composite-triple-key-id? name))
          (No)
          (Some (tc-env-key-name-text name)))]
      [_ (No)])))

(define (macro-compat-guard-message [name : String]) : String
  (if (string.eq name "unless")
    "parse: unless expects a condition and at least one body expression"
    "parse: when expects a condition and at least one body expression"))

(define (macro-expand-compat-guard-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [cond : ast.AstExpr]
  [body : ast.AstExprList]
  [is-unless : bool]) : ResultMacroCompatCall
  (match (macro-expand-expr ctx env (tc-global-shared-view decls) depth cond)
    [(Ok ncond)
      (match (macro-expand-exprs ctx env decls depth body)
        [(Ok nbody)
          (let
            [unit-expr : i64 (macro-compat-unit-expr)]
            [body-expr : i64
              (ast.ast-node-push (Begin (macro-compat-append-unit nbody)))]
            (if is-unless
              (Ok (ast.ast-expr-if ncond unit-expr body-expr))
              (Ok (ast.ast-expr-if ncond body-expr unit-expr))))]
        [(Err diag) (Err diag)])]
    [(Err diag) (Err diag)]))

(define (macro-expand-compat-guard-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [name : String]
  [args : ast.AstExprList]
  [is-unless : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCompatCall
  (if (< args.len 2)
    (Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          (macro-compat-guard-message name))))
    (macro-expand-compat-guard-body
      ctx
      env
      decls
      depth
      (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))
      (ast.ast-expr-list-tail-from-ref (& args) 1)
      is-unless)))

(define (macro-expand-compat-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroCompatCall
  (match (macro-compat-call-name ctx func)
    [(Some name)
      (if (string.eq name "when")
        (macro-expand-compat-guard-call
          ctx
          env
          decls
          depth
          name
          args
          false
          call-expr)
        (if (string.eq name "unless")
          (macro-expand-compat-guard-call
            ctx
            env
            decls
            depth
            name
            args
            true
            call-expr)
          (No)))]
    [(No) (No)]))

(define (macro-expand-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  ;; Value entry: for callers that hold only an expression value (synthesized
  ;; or unspanned forms). The no-fire arm must allocate a node for the value.
  (let
    [fires : bool
      (macro-expr-might-fire?
        (tc-context-macro-state ctx)
        (tc-context-expr-bases ctx)
        (tc-global-shared-view expr))]
    (if (or (not fires) (< (macro-expand-depth-limit) depth))
      (if (not fires)
        (Ok (ast.ast-node-push expr))
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              expr
              "macro expansion exceeded depth limit"))))
      (macro-expand-expr-fire ctx env decls depth expr))))

;; Node entry: walk recursion goes through here so a subtree in which no
;; macro can fire is shared into the output by its original node id instead
;; of being re-pushed. The original program is a strict tree, and the
;; existing no-fire push was already shallow (children stayed shared), so
;; identity-sharing the top node keeps the same output structure without
;; the copy.
(define (macro-expand-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : (& decls ast.AstDeclList)]
  [depth : i64]
  [expr-id : i64]) : ResultMacroExpr
  (let
    [decls : ast.AstDeclList
      (owned_view.compiler-owned-reference-shared-view decls)]
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    [fires : bool
      (macro-expr-might-fire?
        (tc-context-macro-state ctx)
        (tc-context-expr-bases ctx)
        (tc-global-shared-view expr))]
    (macro-expand-node-with-fire-decision
      ctx
      env
      decls
      depth
      expr-id
      expr
      fires)))

;; One subtree scan per visit: the caller's single `fires` answer both picks
;; the no-fire arm and gates this call.
(define (macro-expand-expr-fire
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  (match (tc-global-shared-view expr)
    [(Spanned inner-box span)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-spanned ninner span)))]
    [(MacroExpansion inner-box provenance-id macro-name-id)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-macro-expansion ninner provenance-id macro-name-id)))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
        [callee-maybe-macro : bool
          (macro-call-callee-maybe-macro?
            (tc-context-expr-bases ctx)
            (tc-context-macro-state ctx)
            (tc-global-shared-view func))]
        (if callee-maybe-macro
          (let
            [maybe-decl
              (try
                (macro-call-decl
                  ctx
                  (tc-global-shared-view func)
                  (tc-global-shared-view decls)
                  (tc-global-shared-view expr)))]
            (match maybe-decl
              [(Some
                macro-name
                definition-module
                declaration-id
                params
                ret
                body)
                (tc-macro-call-site-note!
                  ctx
                  func
                  macro-name
                  definition-module
                  declaration-id)
                (macro-expand-call
                  ctx
                  env
                  decls
                  macro-name
                  declaration-id
                  (macro-decl-name-display macro-name definition-module)
                  (macro-decl-module-display definition-module)
                  definition-module
                  params
                  ret
                  body
                  args
                  depth
                  expr)]
              [(No)
                (match (macro-expand-compat-call
                  ctx
                  env
                  (tc-global-shared-view decls)
                  depth
                  func
                  (tc-global-shared-view args)
                  expr)
                  [(Ok expanded) (Ok expanded)]
                  [(No)
                    (let
                      [nfunc
                        (try (macro-expand-node ctx env decls depth func-box))]
                      [nargs
                        (try (macro-expand-exprs ctx env decls depth args))]
                      (Ok (ast.ast-expr-call nfunc nargs)))]
                  [(Err diag) (Err diag)])]))
          (let
            [nfunc (try (macro-expand-node ctx env decls depth func-box))]
            [nargs (try (macro-expand-exprs ctx env decls depth args))]
            (Ok (ast.ast-expr-call nfunc nargs)))))]
    [(BracketClause items)
      (let
        [nitems (try (macro-expand-exprs ctx env decls depth items))]
        (Ok (ast.ast-expr-bracket-clause nitems)))]
    [(Binary op left-box right-box)
      (let
        [nleft (try (macro-expand-node ctx env decls depth left-box))]
        [nright (try (macro-expand-node ctx env decls depth right-box))]
        (Ok (ast.ast-expr-binary op nleft nright)))]
    [(Unary op inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-unary op ninner)))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [ncond (try (macro-expand-node ctx env decls depth cond-box))]
        [nthen (try (macro-expand-node ctx env decls depth then-branch-box))]
        [nelse (try (macro-expand-node ctx env decls depth else-branch-box))]
        (Ok (ast.ast-expr-if ncond nthen nelse)))]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (match (macro-expand-bindings
            ctx
            env
            (tc-global-shared-view decls)
            depth
            bindings)
            [(Ok nbindings body-env)
              (let
                [nbody
                  (try (macro-expand-node ctx body-env decls depth body-box))]
                (Ok (ast.ast-expr-let nbindings nbody)))]
            [(Err diag) (Err diag)])])]
    [(Begin exprs)
      (let
        [nexprs (try (macro-expand-exprs ctx env decls depth exprs))]
        (Ok (ast.ast-node-push (Begin nexprs))))]
    [(Unsafe exprs)
      ;; Expansion typechecks some sub-expressions (e.g. `match` scrutinees) via
      ;; `tc-expr`; descend with the unsafe marker set so those checks see the
      ;; enclosing `unsafe` context, matching the real typecheck pass. Without
      ;; this, an `unsafe`-only primitive under an `(unsafe ...)` reachable here
      ;; is wrongly rejected once the program defines a macro.
      (let
        [nexprs
          (try (macro-expand-exprs ctx (tc-enter-unsafe env) decls depth exprs))]
        (Ok (ast.ast-node-push (Unsafe nexprs))))]
    [(Tuple exprs)
      (let
        [nexprs (try (macro-expand-exprs ctx env decls depth exprs))]
        (Ok (ast.ast-node-push (Tuple nexprs))))]
    ;; The index is a literal integer, not an expression.
    [(TupleRef tuple-box index)
      (let
        [ntuple (try (macro-expand-node ctx env decls depth tuple-box))]
        (Ok (ast.ast-expr-tuple-ref ntuple index)))]
    [(Array exprs)
      (let
        [nexprs (try (macro-expand-exprs ctx env decls depth exprs))]
        (Ok (ast.ast-node-push (Array nexprs))))]
    [(DynArray exprs)
      (let
        [nexprs (try (macro-expand-exprs ctx env decls depth exprs))]
        (Ok (ast.ast-node-push (DynArray nexprs))))]
    [(FixedMakeArray ty-id len-box)
      (let
        [nlen (try (macro-expand-node ctx env decls depth len-box))]
        (Ok (ast.ast-expr-fixed-make-array-id ty-id nlen)))]
    [(MakeArray ty-id len-box)
      (let
        [nlen (try (macro-expand-node ctx env decls depth len-box))]
        (Ok (ast.ast-expr-make-array-id ty-id nlen)))]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (let
            [first-fire-index : i64
              (macro-match-arms-first-fire-index
                (tc-context-macro-state ctx)
                (tc-context-expr-bases ctx)
                arms)]
            [nscrut (try (macro-expand-node ctx env decls depth scrut-box))]
            (if (< first-fire-index 0)
              (Ok (ast.ast-expr-match nscrut arms))
              (let
                [scrut-ty-result : ResultTcType
                  (tc-expr ctx env (tc-context-expr-get ctx nscrut))]
                [_publish : unit (tc-context-publish-newer-pools! ctx)]
                (match scrut-ty-result
                  [(Ok scrut-ty)
                    (let
                      [narms
                        (try
                          (macro-expand-arms
                            ctx
                            env
                            decls
                            depth
                            scrut-ty
                            first-fire-index
                            arms))]
                      (Ok (ast.ast-expr-match nscrut narms)))]
                  [(Err message)
                    (Err
                      (box
                        (tc-expr-diag
                          (tc-context-expr-bases ctx)
                          (tc-context-expr-get ctx nscrut)
                          message)))]))))])]
    [(While cond-box body-box)
      (let
        [ncond (try (macro-expand-node ctx env decls depth cond-box))]
        ;; As in `tc-expr`: the body is a loop target, so a macro operand
        ;; such as `(when done (break))` checks its `break` / `continue`.
        [nbody
          (try
            (macro-expand-exprs
              ctx
              (tc-enter-loop-target env)
              decls
              depth
              body-box))]
        (Ok (ast.ast-node-push (While ncond nbody))))]
    [(ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source : i64 (ast.ast-for-owned-state-source (& payload))]
        [body : i64 (ast.ast-for-owned-state-body (& payload))]
        [nsource (try (macro-expand-node ctx env decls depth source))]
        (match (tc-expr-id ctx env nsource)
          [(Ok source-ty)
            (let
              [source-name-id : i64
                (tc-for-owned-name-id (tc-context-expr-bases ctx) source-name)]
              [index-name-id : i64
                (tc-for-owned-name-id (tc-context-expr-bases ctx) index-name)]
              [body-env : TcTypeEnv
                (if (or (< source-name-id 0) (< index-name-id 0))
                  env
                  (tc-bind-id
                    (tc-bind-id env source-name-id source-ty)
                    index-name-id
                    (I64)))]
              [nbody (try (macro-expand-node ctx body-env decls depth body))]
              (Ok
                (ast.ast-expr-for-owned-state
                  source-name
                  index-name
                  nsource
                  nbody)))]
          [(Err message)
            (Err
              (box
                (tc-expr-diag
                  (tc-context-expr-bases ctx)
                  (tc-context-expr-get ctx nsource)
                  message)))]))]
    [(ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name-id : i64
          (tc-for-owned-name-id (tc-context-expr-bases ctx) binding-name)]
        (match (tc-expr-id ctx env source-name)
          [(Ok source-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
              [(Array elem-id _)
                (let
                  [body-env : TcTypeEnv
                    (if (< binding-name-id 0)
                      env
                      (tc-bind-id
                        env
                        binding-name-id
                        (tc-context-type-get ctx elem-id)))]
                  [nexpected
                    (try
                      (if (>= expected-type 0)
                        (macro-expand-node ctx env decls depth expected-type)
                        (ResultMacroExpr.Ok -1)))]
                  [nbody
                    (try (macro-expand-node ctx body-env decls depth body))]
                  (Ok
                    (ast.ast-expr-for-owned-step
                      source-name
                      index-name
                      binding-name
                      nexpected
                      done-name
                      nbody)))]
              [_
                (Err
                  (box
                    (tc-expr-diag
                      (tc-context-expr-bases ctx)
                      (tc-context-expr-get ctx source-name)
                      "typecheck: scalar for owned step requires fixed-array state")))])]
          [(Err message)
            (Err
              (box
                (tc-expr-diag
                  (tc-context-expr-bases ctx)
                  (tc-context-expr-get ctx source-name)
                  message)))]))]
    [(Foreach fe-box)
      (match (ast.ast-foreach-box-shared-view fe-box)
        [(Foreach index index-ty start-box end-box body-box)
          (let
            [nstart (try (macro-expand-node ctx env decls depth start-box))]
            [nend (try (macro-expand-node ctx env decls depth end-box))]
            [nbody
              (try
                (macro-expand-node
                  ctx
                  (tc-bind-id
                    env
                    index
                    (tc-resolve-type ctx (tc-global-shared-view index-ty)))
                  decls
                  depth
                  body-box))]
            (Ok (ast.ast-expr-foreach-id index index-ty nstart nend nbody)))]
        [(Foreach2
            outer
            outer-ty
            a-box
            b-box
            inner
            inner-ty
            c-box
            d-box
            body-box)
          (let
            [na (try (macro-expand-node ctx env decls depth a-box))]
            [nb (try (macro-expand-node ctx env decls depth b-box))]
            [nc (try (macro-expand-node ctx env decls depth c-box))]
            [nd (try (macro-expand-node ctx env decls depth d-box))]
            [nbody
              (try
                (macro-expand-node
                  ctx
                  (tc-bind-id
                    (tc-bind-id
                      env
                      outer
                      (tc-resolve-type ctx (tc-global-shared-view outer-ty)))
                    inner
                    (tc-resolve-type ctx (tc-global-shared-view inner-ty)))
                  decls
                  depth
                  body-box))]
            (Ok
              (ast.ast-expr-foreach2-id
                outer
                outer-ty
                na
                nb
                inner
                inner-ty
                nc
                nd
                nbody)))])]
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [nbody
              (try
                (macro-expand-node
                  ctx
                  ;; A lambda body is not inside the enclosing loop.
                  (match (tc-global-shared-view maybe-ret)
                    [(Some ret)
                      (tc-bind-return-type
                        (tc-bind-params ctx (tc-clear-loop-target env) params)
                        (tc-resolve-type ctx ret))]
                    [(No)
                      (tc-bind-return-type
                        (tc-bind-params ctx (tc-clear-loop-target env) params)
                        (Never))])
                  decls
                  depth
                  body-box))]
            (Ok (ast.ast-expr-lambda params maybe-ret nbody)))])]
    [(Ann inner-box ty-id)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-ann-id ninner ty-id)))]
    [(Cast inner-box ty-id)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-cast-id ninner ty-id)))]
    [(Borrow mutable lifetime-id place-box)
      (let
        [nplace (try (macro-expand-node ctx env decls depth place-box))]
        (Ok (ast.ast-expr-borrow-id mutable lifetime-id nplace)))]
    [(StructGet inner-box field)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-struct-get-id ninner field)))]
    [(StructSet inner-box field value-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-expr-struct-set-id ninner field nvalue)))]
    [(WithRegion region body)
      (let
        [nbody
          (try
            (macro-expand-exprs
              ctx
              (tc-push-region env region)
              decls
              depth
              body))]
        (Ok (ast.ast-node-push (WithRegion region nbody))))]
    [(WithEscape scratch-box body)
      (let
        [nscratch (try (macro-expand-node ctx env decls depth scratch-box))]
        [nbody (try (macro-expand-exprs ctx env decls depth body))]
        (Ok (ast.ast-expr-with-escape nscratch nbody)))]
    [(WithScratch body)
      (let
        [nbody (try (macro-expand-exprs ctx env decls depth body))]
        (Ok (ast.ast-expr-with-scratch nbody)))]
    [(InArena arena-box body)
      (let
        [narena (try (macro-expand-node ctx env decls depth arena-box))]
        [nbody (try (macro-expand-exprs ctx env decls depth body))]
        (Ok (ast.ast-expr-in-arena narena nbody)))]
    [(ArrayRef array-box index-box)
      (let
        [narray (try (macro-expand-node ctx env decls depth array-box))]
        [nindex (try (macro-expand-node ctx env decls depth index-box))]
        (Ok (ast.ast-expr-array-ref narray nindex)))]
    [(ArraySet array-box index-box value-box)
      (let
        [narray (try (macro-expand-node ctx env decls depth array-box))]
        [nindex (try (macro-expand-node ctx env decls depth index-box))]
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-expr-array-set narray nindex nvalue)))]
    [(ArrayTake array-box live-box index-box)
      (let
        [narray (try (macro-expand-node ctx env decls depth array-box))]
        [nlive (try (macro-expand-node ctx env decls depth live-box))]
        [nindex (try (macro-expand-node ctx env decls depth index-box))]
        (Ok (ast.ast-expr-array-take narray nlive nindex)))]
    [(ArrayPush array-box value-box)
      (let
        [narray (try (macro-expand-node ctx env decls depth array-box))]
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-node-push (ArrayPush narray nvalue))))]
    [(StringRef string-box index-box)
      (let
        [nstring (try (macro-expand-node ctx env decls depth string-box))]
        [nindex (try (macro-expand-node ctx env decls depth index-box))]
        (Ok (ast.ast-node-push (StringRef nstring nindex))))]
    [(Replace place-box replacement-box)
      (let
        [nplace (try (macro-expand-node ctx env decls depth place-box))]
        [nreplacement
          (try (macro-expand-node ctx env decls depth replacement-box))]
        (Ok (ast.ast-expr-replace nplace nreplacement)))]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings body)
          (match (macro-expand-resource-bindings
            ctx
            env
            (tc-global-shared-view decls)
            depth
            bindings)
            [(Ok nbindings body-env)
              (let
                [nbody (try (macro-expand-exprs ctx body-env decls depth body))]
                (Ok
                  (ast.ast-node-push
                    (WithResource
                      (box (ast.AstWithResource.WithResource nbindings nbody))))))]
            [(Err diag) (Err diag)])])]
    [(Box inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-box ninner)))]
    [(BoxGet inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-box-get ninner)))]
    [(BoxTake inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-box-take ninner)))]
    [(BoxSet inner-box value-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-expr-box-set ninner nvalue)))]
    [(Comptime inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-comptime ninner)))]
    [(Return inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-return ninner)))]
    [(Try inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-node-push (Try ninner))))]
    [(Set name rhs-box)
      (let
        [nrhs (try (macro-expand-node ctx env decls depth rhs-box))]
        (Ok (ast.ast-expr-set-id name nrhs)))]
    [(StringData inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-string-data ninner)))]
    [(StringFromBytes ptr-box len-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        [nlen (try (macro-expand-node ctx env decls depth len-box))]
        (Ok (ast.ast-expr-string-from-bytes nptr nlen)))]
    [(ArrayData inner-box)
      (let
        [ninner (try (macro-expand-node ctx env decls depth inner-box))]
        (Ok (ast.ast-expr-array-data ninner)))]
    [(PtrNullCheck ptr-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        (Ok (ast.ast-expr-ptr-null-check nptr)))]
    [(PtrAddrOf place-box)
      (let
        [nplace (try (macro-expand-node ctx env decls depth place-box))]
        (Ok (ast.ast-expr-ptr-addr-of-id nplace)))]
    [(PtrRead ptr-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        (Ok (ast.ast-expr-ptr-read nptr)))]
    [(PtrWrite ptr-box value-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-expr-ptr-write nptr nvalue)))]
    [(PtrOffset ptr-box offset-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        [noffset (try (macro-expand-node ctx env decls depth offset-box))]
        (Ok (ast.ast-expr-ptr-offset nptr noffset)))]
    [(PtrCast ptr-box ty-id)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        (Ok (ast.ast-expr-ptr-cast-id nptr ty-id)))]
    [(PtrToInt ptr-box)
      (let
        [nptr (try (macro-expand-node ctx env decls depth ptr-box))]
        (Ok (ast.ast-expr-ptr-to-int nptr)))]
    [(IntToPtr value-box ty-id)
      (let
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-expr-int-to-ptr-id nvalue ty-id)))]
    [(BinaryData bytes) (Ok (ast.ast-node-push (BinaryData bytes)))]
    [(SpmdProgramIndex) (Ok (ast.ast-expr-spmd-program-index))]
    [(SpmdProgramCount) (Ok (ast.ast-expr-spmd-program-count))]
    [(CpuIdEax leaf-box subleaf-box)
      (let
        [nleaf (try (macro-expand-node ctx env decls depth leaf-box))]
        [nsubleaf (try (macro-expand-node ctx env decls depth subleaf-box))]
        (Ok (ast.ast-expr-cpuid-eax nleaf nsubleaf)))]
    [(CpuIdEbx leaf-box subleaf-box)
      (let
        [nleaf (try (macro-expand-node ctx env decls depth leaf-box))]
        [nsubleaf (try (macro-expand-node ctx env decls depth subleaf-box))]
        (Ok (ast.ast-expr-cpuid-ebx nleaf nsubleaf)))]
    [(CpuIdEcx leaf-box subleaf-box)
      (let
        [nleaf (try (macro-expand-node ctx env decls depth leaf-box))]
        [nsubleaf (try (macro-expand-node ctx env decls depth subleaf-box))]
        (Ok (ast.ast-expr-cpuid-ecx nleaf nsubleaf)))]
    [(CpuIdEdx leaf-box subleaf-box)
      (let
        [nleaf (try (macro-expand-node ctx env decls depth leaf-box))]
        [nsubleaf (try (macro-expand-node ctx env decls depth subleaf-box))]
        (Ok (ast.ast-expr-cpuid-edx nleaf nsubleaf)))]
    [(Xgetbv index-box)
      (let
        [nindex (try (macro-expand-node ctx env decls depth index-box))]
        (Ok (ast.ast-expr-xgetbv nindex)))]
    [(Syscall args)
      (let
        [nargs (try (macro-expand-exprs ctx env decls depth args))]
        (Ok (ast.ast-expr-syscall nargs)))]
    [(ForeachActive lane body-box)
      (let
        [nbody
          (try
            (macro-expand-node
              ctx
              (tc-bind-id env lane (I64))
              decls
              depth
              body-box))]
        (Ok (ast.ast-node-push (ForeachActive lane nbody))))]
    [(LaneValue value-box)
      (let
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        (Ok (ast.ast-node-push (LaneValue nvalue))))]
    ;; The range binder is in scope for the value; the range and initial value
    ;; are evaluated outside it.
    [(SpmdReduce reduce-box)
      (match (ast.ast-spmd-reduce-box-shared-view reduce-box)
        [(Reduce op index index-ty start-box end-box init-box value-box)
          (let
            [nstart (try (macro-expand-node ctx env decls depth start-box))]
            [nend (try (macro-expand-node ctx env decls depth end-box))]
            [ninit (try (macro-expand-node ctx env decls depth init-box))]
            [nvalue
              (try
                (macro-expand-node
                  ctx
                  (tc-bind-id
                    env
                    index
                    (tc-resolve-type ctx (tc-global-shared-view index-ty)))
                  decls
                  depth
                  value-box))]
            (Ok
              (ast.ast-node-push
                (SpmdReduce
                  (box (Reduce op index index-ty nstart nend ninit nvalue))))))])]
    ;; The range binder is in scope for the value and the body, the prefix
    ;; binder for the body; the range and the prefix's initial value are
    ;; evaluated outside both.
    [(SpmdScan scan-box)
      (match (ast.ast-spmd-scan-box-shared-view scan-box)
        [(Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [value-env : TcTypeEnv
              (tc-bind-id
                env
                index
                (tc-resolve-type ctx (tc-global-shared-view index-ty)))]
            [nstart (try (macro-expand-node ctx env decls depth start-box))]
            [nend (try (macro-expand-node ctx env decls depth end-box))]
            [ninit (try (macro-expand-node ctx env decls depth init-box))]
            [nvalue
              (try (macro-expand-node ctx value-env decls depth value-box))]
            [nbody
              (try
                (macro-expand-node
                  ctx
                  (tc-bind-id
                    value-env
                    prefix
                    (tc-resolve-type ctx (tc-global-shared-view prefix-ty)))
                  decls
                  depth
                  body-box))]
            (Ok
              (ast.ast-node-push
                (SpmdScan
                  (box
                    (Scan
                      op
                      index
                      index-ty
                      nstart
                      nend
                      prefix
                      prefix-ty
                      ninit
                      nvalue
                      nbody))))))])]
    ;; The range binder is in scope for the predicate and the body, the slot
    ;; binder for the body; the range and the slot's initial value are evaluated
    ;; outside both.
    [(SpmdCompact compact-box)
      (match (ast.ast-spmd-compact-box-shared-view compact-box)
        [(Compact
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)
          (let
            [keep-env : TcTypeEnv
              (tc-bind-id
                env
                index
                (tc-resolve-type ctx (tc-global-shared-view index-ty)))]
            [nstart (try (macro-expand-node ctx env decls depth start-box))]
            [nend (try (macro-expand-node ctx env decls depth end-box))]
            [ninit (try (macro-expand-node ctx env decls depth init-box))]
            [nkeep (try (macro-expand-node ctx keep-env decls depth keep-box))]
            [nbody
              (try
                (macro-expand-node
                  ctx
                  (tc-bind-id
                    keep-env
                    slot
                    (tc-resolve-type ctx (tc-global-shared-view slot-ty)))
                  decls
                  depth
                  body-box))]
            (Ok
              (ast.ast-node-push
                (SpmdCompact
                  (box
                    (Compact
                      index
                      index-ty
                      nstart
                      nend
                      slot
                      slot-ty
                      ninit
                      nkeep
                      nbody))))))])]
    [(SpmdBroadcast value-box lane-box)
      (let
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        [nlane (try (macro-expand-node ctx env decls depth lane-box))]
        (Ok (ast.ast-node-push (SpmdBroadcast nvalue nlane))))]
    [(SpmdShuffle value-box lane-box)
      (let
        [nvalue (try (macro-expand-node ctx env decls depth value-box))]
        [nlane (try (macro-expand-node ctx env decls depth lane-box))]
        (Ok (ast.ast-node-push (SpmdShuffle nvalue nlane))))]
    ;; Leaves: no child expression to expand.
    [(Literal _) (Ok (ast.ast-node-push expr))]
    [(Var _) (Ok (ast.ast-node-push expr))]
    [(TypeLiteral _) (Ok (ast.ast-node-push expr))]
    [(Init _) (Ok (ast.ast-node-push expr))]
    [(PtrNull _) (Ok (ast.ast-node-push expr))]
    [(Break) (Ok (ast.ast-node-push expr))]
    [(Continue) (Ok (ast.ast-node-push expr))]
    [(ProgramArgc) (Ok (ast.ast-node-push expr))]
    [(ProgramArgv) (Ok (ast.ast-node-push expr))]
    [(ProgramEnvp) (Ok (ast.ast-node-push expr))]
    ;; Quote forms hold syntax as data; a call inside one is not a call.
    [(Quote _) (Ok (ast.ast-node-push expr))]
    [(Quasiquote _) (Ok (ast.ast-node-push expr))]
    [(Unquote _) (Ok (ast.ast-node-push expr))]
    [(UnquoteSplicing _) (Ok (ast.ast-node-push expr))]))

(define (macro-expand-module-call-position
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [call-id : i64]
  [import-position : bool]) : ResultMacroDecl
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools pools (& call-expr))
      [(Call func-box _)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [maybe-decl
            (try
              (macro-call-decl ctx func decls (tc-global-shared-view call-expr)))]
          (match maybe-decl
            [(Some _ _ _ _ ret _)
              (cond
                [(and
                    import-position
                    (tc-macro-result-module? (tc-global-shared-view ret)))
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Module macro expansion is not implemented yet")))]
                [(and
                    import-position
                    (tc-macro-result-decls? (tc-global-shared-view ret)))
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Decls macro cannot be used in import position")))]
                [import-position
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: expression macro cannot be used as module import")))]
                [(tc-macro-result-decls? (tc-global-shared-view ret))
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Decls macro expansion is not implemented yet")))]
                [(tc-macro-result-module? ret)
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Module macro can only be used in import position")))]
                [else
                  (Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: expression macro cannot be used at module scope")))])]
            [(No)
              (Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "typecheck: module-scope macro call must resolve to defmacro")))]))]
      [_
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [decl : ast.AstDecl]) : ResultMacroDecl
  (let
    [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
    (match (tc-global-shared-view decl)
      [(Def decl-meta name maybe-ty expr-box)
        (let
          [nexpr : i64
            (try (macro-expand-node ctx global-env decls 0 expr-box))]
          (Ok (ast.ast-decl-def-id name maybe-ty nexpr)))]
      [(DefFn decl-meta name params ret body-box metadata)
        (let
          [params-env : TcTypeEnv (tc-bind-params ctx global-env params)]
          [resolved-ret : ast.AstType
            (tc-resolve-type ctx (tc-global-shared-view ret))]
          [body-env : TcTypeEnv (tc-bind-return-type params-env resolved-ret)]
          [nbody : i64 (try (macro-expand-node ctx body-env decls 0 body-box))]
          (Ok
            (ast.ast-decl-def-fn-metadata-id name params ret nbody (& metadata))))]
      [(Test _ _ _ _) (Ok decl)]
      [(Import decl-meta (Spec kind _ _ _ _))
        (match kind
          [(Macro call-id _)
            (macro-expand-module-call-position ctx decls call-id true)]
          [(MacroDecls call-id _)
            (macro-expand-module-call-position ctx decls call-id false)]
          [_ (Ok decl)])]
      [(Unsafe inner-box)
        (let
          [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
          [ninner : ast.AstDecl
            (try (macro-expand-decl ctx top-env decls inner))]
          (Ok (ast.ast-decl-unsafe ninner)))]
      [_ (Ok decl)])))

(define (macro-single-decl-expansion
  [state : TcMacroState]
  [decl : ast.AstDecl]
  [path : String]) : ResultMacroDeclExpansion
  (Ok
    (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new)))
    (macro-paths-for-decls
      state
      (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new)))
      path)))

(define (tc-macro-module-env-cache-storage-ensure! [state : TcMacroState]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (if (=
        (array-length (deref data).macro-cache-module-ids)
        (deref data).macro-cache-capacity)
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (set!
              (deref data).macro-cache-module-ids
              (__tl_make-array i64 (deref data).macro-cache-capacity))
            (set!
              (deref data).macro-cache-values
              (__tl_make-array TcTypeEnv (deref data).macro-cache-capacity))
            (set!
              (deref data).macro-cache-pending-names
              (__tl_make-array i64 (deref data).macro-cache-capacity))
            (set!
              (deref data).macro-cache-pending-generations
              (__tl_make-array i64 (deref data).macro-cache-capacity))))))))

(define (tc-macro-module-env-cache-index
  [state : TcMacroState]
  [module-id : i64]
  [index : i64]) : i64
  (let
    [data : (Ptr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-view state)]
    (unsafe
      (if (>= index (deref data).macro-cache-len)
        -1
        (if (= (array-ref (deref data).macro-cache-module-ids index) module-id)
          index
          (tc-macro-module-env-cache-index state module-id (+ index 1)))))))

;; Replace entry `index` by the last one; the cache is a small unordered list.
(define (tc-macro-module-env-cache-remove-at!
  [state : TcMacroState]
  [index : i64]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    [last : i64
      (unsafe
        (- (deref data).macro-cache-len 1))]
    (unsafe
      (set!
        (array-ref (deref data).macro-cache-module-ids index)
        (array-ref (deref data).macro-cache-module-ids last))
      (set!
        (array-ref (deref data).macro-cache-values index)
        (array-ref (deref data).macro-cache-values last))
      (set!
        (array-ref (deref data).macro-cache-pending-names index)
        (array-ref (deref data).macro-cache-pending-names last))
      (set!
        (array-ref (deref data).macro-cache-pending-generations index)
        (array-ref (deref data).macro-cache-pending-generations last))
      (set! (deref data).macro-cache-len last))))

(define (tc-macro-module-env-cache-insert!
  [state : TcMacroState]
  [module-id : i64]
  [env : TcTypeEnv]
  [pending-name : i64]) : unit
  (let
    [_ensure : unit (tc-macro-module-env-cache-storage-ensure! state)]
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (when
        (< (deref data).macro-cache-len (deref data).macro-cache-capacity)
        (set!
          (array-ref
            (deref data).macro-cache-module-ids
            (deref data).macro-cache-len)
          module-id)
        (set!
          (array-ref
            (deref data).macro-cache-values
            (deref data).macro-cache-len)
          env)
        (set!
          (array-ref
            (deref data).macro-cache-pending-names
            (deref data).macro-cache-len)
          pending-name)
        (set!
          (array-ref
            (deref data).macro-cache-pending-generations
            (deref data).macro-cache-len)
          tc-top-env-resolution-generation)
        (set! (deref data).macro-cache-len (+ (deref data).macro-cache-len 1))))))

(define (tc-macro-module-local-env-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [store-handle : i64 top-env.store]
    [head : i64 top-env.head]
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (unless
        (and
          (= (deref data).macro-cache-store store-handle)
          (= (deref data).macro-cache-head head))
        (set! (deref data).macro-cache-store store-handle)
        (set! (deref data).macro-cache-head head)
        (set! (deref data).macro-cache-len 0))
      (let
        [index : i64 (tc-macro-module-env-cache-index state module-id 0)]
        [pending-name : i64
          (if (< index 0)
            -1
            (array-ref (deref data).macro-cache-pending-names index))]
        ;; The pending name can only start resolving after the type-resolution
        ;; generation moves, so re-resolve it once per generation.
        (if (and
          (>= index 0)
          (or
            (< pending-name 0)
            (=
              (array-ref (deref data).macro-cache-pending-generations index)
              tc-top-env-resolution-generation)
            (if (tc-module-view-pending-name-unresolved?
              ctx
              (tc-global-shared-view module)
              module-id
              pending-name)
              (begin
                (set!
                  (array-ref (deref data).macro-cache-pending-generations index)
                  tc-top-env-resolution-generation)
                true)
              false)))
          (Ok (array-ref (deref data).macro-cache-values index))
          (begin
            ;; A view whose pending alias now resolves is rebuilt (#8614).
            (if (>= index 0)
              (tc-macro-module-env-cache-remove-at! state index)
              unit)
            (set! tc-module-view-pending-name -1)
            ;; The persistent environment store allocates appended nodes in
            ;; the top environment's owner arena. Do not switch the ambient
            ;; macro-generation arena here: doing so breaks the generation's
            ;; allocator bookkeeping.
            (let
              [env (try (tc-module-local-env-id ctx top-env module module-id))]
              (tc-macro-module-env-cache-insert!
                state
                module-id
                env
                tc-module-view-pending-name)
              (Ok env))))))))

(define (macro-env-for-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (Ok top-env)
    (tc-macro-module-local-env-id ctx top-env module module-id)))

(define (macro-module-import-marker-decls
  [target-module : String]
  [target-module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]) : ast.AstDeclList
  (let
    [binding-alias : ast.AstMaybeImportAlias
      (match alias
        [(No) (Some cbi.compiler-builtin-id-fix-empty)]
        [_ alias])]
    (ast.ast-decl-cons
      (&
        (Import
          (ast.ast-decl-meta-runtime-shared-view)
          (Spec
            (Module)
            target-module
            (Some target-module-id)
            binding-alias
            (box span))))
      (& (ast.ast-decl-list-new)))))

(define (macro-module-import-marker-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(Import decl-meta (Spec kind _ _ _ _))
      (match kind
        [(Module) true]
        [_ false])]
    [_ false]))

(define (macro-module-import-marker-only? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Cons decl rest)
      (if (macro-module-import-marker-decl? decl)
        (match (ast.ast-decl-list-step rest)
          [(Nil) true]
          [_ false])
        false)]
    [(Nil) false]))

(define (macro-extend-top-env-with-module-marker
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [_module : String]
  [module-id : i64]) : ResultTcEnv
  ;; The marker publishes an import alias (or the unaliased module surface).
  (tc-top-env-resolution-inputs-changed!)
  (match (ast.ast-decl-list-step decls)
    [(Cons decl _)
      (match decl
        [(Import decl-meta (Spec _ _ (Some target-module) (Some alias) _))
          (if (= alias cbi.compiler-builtin-id-fix-empty)
            (if (macro-segmented-program-active? (tc-context-job-state ctx))
              (macro-segmented-bind-import-alias-module
                ctx
                top-env
                target-module
                cbi.compiler-builtin-id-fix-empty
                module-id
                true)
              (tc-bind-import-alias-module
                ctx
                all-decls
                top-env
                target-module
                cbi.compiler-builtin-id-fix-empty
                module-id
                true))
            (begin
              (tc-lazy-import-stub-record-for-job!
                (tc-context-job-state ctx)
                module-id
                (csym.compiler-symbols-import-alias-key-id module-id alias)
                target-module
                false)
              (Ok top-env)))]
        [_ (Ok top-env)])]
    [(Nil) (Ok top-env)]))

(define (macro-existing-module-import-target
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]) : TcMaybeNameId
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools pools (& call-expr))
      [(Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            (tc-global-shared-view func)
            (tc-global-shared-view orig-decls)
            (tc-global-shared-view module)
            module-id
            context
            (tc-global-shared-view call-expr))
            [(Ok maybe-decl call-module call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      _)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-module? ret)
                        (match (macro-expand-exprs
                          call-ctx
                          global-env
                          (tc-global-shared-view orig-decls)
                          0
                          args)
                          [(Ok expanded-args)
                            (match (macro-module-identity
                              call-ctx
                              (tc-global-shared-view orig-decls)
                              call-module
                              call-module-id
                              (macro-decl-name-display
                                macro-name
                                definition-module)
                              (macro-decl-module-display definition-module)
                              params
                              expanded-args
                              (tc-ctfe-env call-ctx)
                              call-expr)
                              [(Ok identity _)
                                (macro-find-generated-identity-module
                                  orig-decls
                                  identity)]
                              [(Err _) (No)])]
                          [(Err _) (No)])
                        (No)))]
                  [(No) (No)]))]
            [(Err _) (No)]))]
      [_ (No)])))

(define (macro-collapse-existing-module-import-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [site-state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [previous-active : TcMacroCallSiteActiveDecl
      (tc-macro-call-site-state-active-decl site-state)]
    [_set-active : unit
      (tc-macro-call-site-state-set-active-decl!
        site-state
        (tc-global-shared-view decl-path)
        (ast.ast-decl-generated-meta decl))]
    [_definition-path : unit
      (macro-definition-path-note-decl!
        ctx
        module-id
        (tc-global-shared-view decl)
        (tc-global-shared-view decl-path))]
    [result : ResultMacroDeclExpansion
      (match (tc-global-shared-view decl)
        [(Import decl-meta (Spec kind _ _ alias span))
          (match kind
            [(Macro call-id context)
              (match (macro-existing-module-import-target
                ctx
                top-env
                orig-decls
                module
                module-id
                call-id
                context)
                [(Some target-module-id)
                  (let
                    [target-module : String
                      (tc-env-key-name-text target-module-id)]
                    [expanded : ast.AstDeclList
                      (macro-module-import-marker-decls
                        target-module
                        target-module-id
                        alias
                        (__tl-box-place span))]
                    (Ok
                      (tc-global-shared-view expanded)
                      (macro-paths-for-decls
                        (tc-context-macro-state ctx)
                        expanded
                        decl-path)))]
                [(No)
                  (macro-single-decl-expansion
                    (tc-context-macro-state ctx)
                    decl
                    decl-path)])]
            [_
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)])]
        [_
          (macro-single-decl-expansion
            (tc-context-macro-state ctx)
            decl
            decl-path)])]
    (tc-macro-call-site-state-restore-active-decl! site-state previous-active)
    result))

(define (macro-collapse-existing-module-imports
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : ast.AstDeclList]
  [decl-path : String]) : ResultMacroDeclExpansion
  ;; Collapse each declaration in order and append its result to the output,
  ;; so a module of n declarations costs O(n) instead of re-copying the
  ;; collapsed rest once per declaration. The first failure wins, as before.
  (let
    [out-decls : ast.AstDeclList
      (ast.ast-decl-list-with-capacity (ast.ast-decl-list-len (& decls)))]
    [out-paths : ast.AstDeclPathList
      (ast.ast-decl-path-list-with-capacity (ast.ast-decl-list-len (& decls)))]
    [cursor : ast.AstDeclList decls]
    [failure : ResultMacroDeclExpansion
      (Ok (ast.ast-decl-list-new) (ast.ast-decl-path-list-new))]
    [failed? : bool false]
    [more? : bool true]
    (while more?
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! more? false)]
        [(Cons decl rest)
          (match (macro-collapse-existing-module-import-decl
            ctx
            top-env
            (tc-global-shared-view orig-decls)
            (tc-global-shared-view module)
            module-id
            decl
            (tc-global-shared-view decl-path))
            [(Ok head-decls head-paths)
              (macro-decl-list-append-from (&mut out-decls) (& head-decls))
              (macro-decl-path-list-append-from (&mut out-paths) (& head-paths))
              (set! cursor rest)]
            [(Err diag)
              (set! failure (Err diag))
              (set! failed? true)
              (set! more? false)])]))
    (if failed?
      failure
      (Ok out-decls out-paths))))

(define (macro-collapse-existing-module-imports-or-original
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : ast.AstDeclList]
  [decl-path : String]) : ast.AstDeclList
  (match (macro-collapse-existing-module-imports
    ctx
    top-env
    orig-decls
    module
    module-id
    (tc-global-shared-view decls)
    decl-path)
    [(Ok collapsed _) collapsed]
    [(Err _) decls]))

(define (macro-call-not-macro-message
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [name-id : i64]) : String
  (let
    [name : String (ci.intern-str name-id)]
    [default-message : String
      (str_cat.str-cat
        "typecheck: module-scope macro call does not name a macro: "
        (tc-global-shared-view name))]
    (match (tc-source-dotted-alias-target-id
      (tc-context-macro-state ctx)
      decls
      module-id
      name-id)
      [(Some target-module-id)
        (let
          [macro-name : String
            (parser.parse-ast-dotted-import-default-alias
              (tc-env-key-name-text target-module-id))]
          (str_cat.str-cat
            "typecheck: imported macro `"
            (tc-global-shared-view macro-name)
            "` requires provider qualification; use `"
            name
            "."
            macro-name
            "`"))]
      [(No) default-message])))

(define (macro-call-not-macro-diag
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [call-expr : ast.AstExpr]) : cdiag.CompilerDiagnostic
  (ctfe_support.ctfe-diagnostic-at-expr
    (tc-global-shared-view call-expr)
    (match (ast.ast-expr-unspan-with-segment-bases
      (tc-context-expr-bases ctx)
      (& call-expr))
      [(Call head-id _)
        (match (ast.ast-expr-unspan-with-segment-bases
          (tc-context-expr-bases ctx)
          (& (tc-context-expr-get ctx head-id)))
          [(Var name-id)
            (macro-call-not-macro-message ctx decls module-id name-id)]
          [_ "typecheck: module-scope macro call has a non-symbol head"])]
      [_ "typecheck: module-scope macro placeholder is not a call"])))

(define (macro-module-incompatible-output-diag
  [call-expr : ast.AstExpr]
  [identity : String]) : cdiag.CompilerDiagnostic
  (ctfe_support.ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output for generated identity "
      identity
      " has incompatible payload")))

(define (macro-materialized-record-result
  [state : TcMacroState]
  [identity : String]
  [target-module-id : i64]
  [summary : ast.AstDeclList]
  [catalog : ast.AstDeclList]
  [generator : String]
  [import-path : String]
  [memoize? : bool]
  [result : ResultMacroDeclExpansion]) : ResultMacroDeclExpansion
  (match (& result)
    [(Ok _ _)
      (begin
        (if memoize?
          (begin
            ;; This full materialization is the behavior-preserving
            ;; validation lane for #4830: every catalog declaration remains
            ;; in the ordinary parent walk exactly once. Record the complete
            ;; module list separately from the mutable materialized summary.
            (macro-generated-module-memo-put!
              state
              identity
              target-module-id
              summary
              catalog
              generator
              import-path)
            (cfg
              compile-profile
              (compiler-tc-macro-profile-metric-add!
                state
                tc-profile-generated-module-catalog-builds
                1)))
          unit)
        (cfg
          compile-profile
          (compiler-tc-macro-profile-metric-add!
            state
            tc-profile-generated-module-materializations
            1)))]
    [(Err _) unit])
  result)

(define (macro-expand-module-materialized
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module-id : i64]
  [target-module : String]
  [target-module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [origin-path-id : i64]
  [identity : String]
  [memoize? : bool]
  [body-rest : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroDeclExpansion
  (let
    ;; A generated module always emits its FULL body. There is no surface
    ;; filter (closure filter + env/fs allow-list + whole-body drop);
    ;; the reachability gate (run after typecheck) keeps unused parts out of
    ;; codegen while every declaration is still fully typechecked.
    [generated-body-raw : ast.AstDeclList
      (macro-wrap-generated-decls
        body-rest
        (tc-global-shared-view macro-name)
        (tc-global-shared-view identity)
        (tc-global-shared-view decl-path)
        origin-path-id
        span)]
    [generated-body : ast.AstDeclList
      (macro-collapse-existing-module-imports-or-original
        ctx
        top-env
        (tc-global-shared-view orig-decls)
        (tc-global-shared-view target-module)
        target-module-id
        generated-body-raw
        (tc-global-shared-view decl-path))]
    [materialized : ast.AstDeclList
      (ast.ast-decl-list-prepend-builder
        (ast.ast-decl-module-id target-module-id)
        (tc-global-shared-view generated-body))]
    (macro-materialized-record-result
      (tc-context-macro-state ctx)
      (tc-global-shared-view identity)
      target-module-id
      (tc-global-shared-view materialized)
      (tc-global-shared-view generated-body)
      macro-name
      (tc-global-shared-view decl-path)
      memoize?
      (match (macro-find-module-body-decls-in-context
        ctx
        orig-decls
        (tc-global-shared-view target-module))
        [(Some existing-body)
          (if (macro-decls-contain-generated-key?
            (tc-global-shared-view existing-body)
            (tc-global-shared-view identity))
            ;: The module for this identity is already materialized and recorded in
            ;: the content-addressed memo. Compatible repeats are deduped without
            ;: re-expansion via the memo shortcut (plan P1). A syntax-param macro
            ;: (an `Expr`/clause parameter) can still reach here having produced a
            ;: body that differs from the recorded one even though the canonical
            ;: identity matches -- it switches on the argument's syntactic shape,
            ;: not its value, so `(gen "i64")` and `(gen (type-key (type i64)))`
            ;: collide on one identity with different payloads. Detect that
            ;: same-identity collision instead of silently reusing the recorded
            ;: body; a compatible re-materialization still binds via the replay
            ;: marker/alias import.
            (match (macro-generated-target-replay
              (tc-global-shared-view existing-body)
              (macro-decls-filter-generated-key
                (tc-global-shared-view generated-body)
                (tc-global-shared-view identity)))
              [(ReplayIncompatible)
                (Err
                  (box
                    (macro-module-incompatible-output-diag call-expr identity)))]
              [_
                (let
                  [expanded : ast.AstDeclList
                    (macro-module-replay-marker-decls
                      target-module
                      target-module-id
                      module-id
                      alias
                      span
                      generated-body
                      existing-body)]
                  (Ok
                    (tc-global-shared-view expanded)
                    (macro-paths-for-decls
                      (tc-context-macro-state ctx)
                      expanded
                      decl-path)))])
            (let
              [generated-key-body : ast.AstDeclList
                (macro-decls-filter-generated-key
                  (tc-global-shared-view generated-body)
                  (tc-global-shared-view identity))]
              (match (macro-generated-target-replay
                (tc-global-shared-view existing-body)
                generated-key-body)
                [(or (ReplayCompatible) (ReplayAppendMissing))
                  (let
                    [expanded : ast.AstDeclList
                      (macro-module-replay-marker-decls
                        target-module
                        target-module-id
                        module-id
                        alias
                        span
                        generated-body
                        existing-body)]
                    (Ok
                      (tc-global-shared-view expanded)
                      (macro-paths-for-decls
                        (tc-context-macro-state ctx)
                        expanded
                        decl-path)))]
                [(ReplayIncompatible)
                  (Err
                    (box
                      (macro-module-incompatible-output-diag call-expr identity)))]
                [(NoReplay)
                  (let
                    [expanded : ast.AstDeclList
                      (macro-decl-list-append
                        materialized
                        (ast.ast-decl-list-prepend-builder
                          (ast.ast-decl-module-id module-id)
                          (macro-module-import-marker-decls
                            target-module
                            target-module-id
                            alias
                            span)))]
                    (Ok
                      (tc-global-shared-view expanded)
                      (macro-paths-for-decls
                        (tc-context-macro-state ctx)
                        expanded
                        decl-path)))])))]
        [(No)
          (let
            [expanded : ast.AstDeclList
              (macro-decl-list-append
                materialized
                (ast.ast-decl-list-prepend-builder
                  (ast.ast-decl-module-id module-id)
                  (macro-module-import-marker-decls
                    target-module
                    target-module-id
                    alias
                    span)))]
            (Ok
              (tc-global-shared-view expanded)
              (macro-paths-for-decls
                (tc-context-macro-state ctx)
                expanded
                decl-path)))]))))

(define (macro-expand-module-generated-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [origin-path-id : i64]
  [identity : String]
  [definition-module-id : i64]
  [macro-env : ctfe_support.CtfeEnv]
  [rewrite-imports? : bool]
  [memoize? : bool]
  [generated : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroDeclExpansion
  (let
    [module-count : i64
      (macro-decls-module-count (tc-global-shared-view generated))]
    (if (= module-count 0)
      (Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Module macro output must include a module declaration")))
      (if (> module-count 1)
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: Module macro output must include exactly one module declaration")))
        (match (ast.ast-decl-list-step generated)
          [(Cons first body-rest-box)
            (match first
              [(ModuleBody target-module-id body-box)
                (match (ast.ast-decl-list-step body-rest-box)
                  [(Nil)
                    (let
                      [target-module : String
                        (tc-env-key-name-text target-module-id)]
                      [body-rest : ast.AstDeclList
                        (macro-flatten-module-body-decls-in-module
                          (ast.ast-decl-list-box-shared-view body-box)
                          target-module-id)]
                      [contextual-body : ast.AstDeclList
                        (macro-generated-context-decls
                          body-rest
                          definition-module-id)]
                      [final-body : ast.AstDeclList
                        (if rewrite-imports?
                          (let
                            [rewrite-decls : ast.AstDeclList
                              (ast.ast-decl-list-prepend-builder
                                (ast.ast-decl-module-id target-module-id)
                                (tc-global-shared-view contextual-body))]
                            [lookup-decls : ast.AstDeclList
                              (macro-decl-list-append
                                (tc-global-shared-view orig-decls)
                                rewrite-decls)]
                            (macro-rewrite-generated-import-decls
                              (tc-context-with-module-id
                                ctx
                                (tc-global-shared-view target-module)
                                target-module-id)
                              lookup-decls
                              (tc-global-shared-view target-module)
                              target-module-id
                              definition-module-id
                              macro-env
                              contextual-body))
                          contextual-body)]
                      (macro-expand-module-materialized
                        ctx
                        top-env
                        orig-decls
                        module-id
                        target-module
                        target-module-id
                        alias
                        span
                        decl-path
                        macro-name
                        origin-path-id
                        identity
                        memoize?
                        final-body
                        call-expr))]
                  [_
                    (Err
                      (box
                        (ctfe_support.ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: Module macro output must include exactly one module declaration")))])]
              [(Module target-module-id)
                (let
                  [target-module : String
                    (tc-env-key-name-text target-module-id)]
                  [body-rest : ast.AstDeclList
                    (macro-flatten-module-body-decls-in-module
                      body-rest-box
                      target-module-id)]
                  [contextual-body : ast.AstDeclList
                    (macro-generated-context-decls
                      body-rest
                      definition-module-id)]
                  [final-body : ast.AstDeclList
                    (if rewrite-imports?
                      (let
                        [rewrite-decls : ast.AstDeclList
                          (ast.ast-decl-list-prepend-builder
                            (ast.ast-decl-module-id target-module-id)
                            (tc-global-shared-view contextual-body))]
                        [lookup-decls : ast.AstDeclList
                          (macro-decl-list-append
                            (tc-global-shared-view orig-decls)
                            rewrite-decls)]
                        (macro-rewrite-generated-import-decls
                          (tc-context-with-module-id
                            ctx
                            (tc-global-shared-view target-module)
                            target-module-id)
                          lookup-decls
                          (tc-global-shared-view target-module)
                          target-module-id
                          definition-module-id
                          macro-env
                          contextual-body))
                      contextual-body)]
                  (macro-expand-module-materialized
                    ctx
                    top-env
                    orig-decls
                    module-id
                    target-module
                    target-module-id
                    alias
                    span
                    decl-path
                    macro-name
                    origin-path-id
                    identity
                    memoize?
                    final-body
                    call-expr))]
              [_
                (Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro output must start with a module declaration")))])]
          [(Nil)
            (Err
              (box
                (ctfe_support.ctfe-diagnostic-at-expr
                  call-expr
                  "typecheck: Module macro output must include a module declaration")))])))))

(define (macro-expand-decls-splice
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools pools (& call-expr))
      [(Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            (tc-global-shared-view func)
            (tc-global-shared-view orig-decls)
            (tc-global-shared-view module)
            module-id
            context
            (tc-global-shared-view call-expr))
            [(Ok maybe-decl call-module call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id
                    ctx
                    (tc-global-shared-view module)
                    module-id)]
                (match maybe-decl
                  [(Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-decls? (tc-global-shared-view ret))
                        (let
                          [expanded-args
                            (try
                              (macro-expand-exprs
                                call-ctx
                                global-env
                                (tc-global-shared-view orig-decls)
                                0
                                args))]
                          (match (macro-module-identity
                            call-ctx
                            (tc-global-shared-view orig-decls)
                            call-module
                            call-module-id
                            (macro-decl-name-display
                              macro-name
                              definition-module)
                            (macro-decl-module-display definition-module)
                            (tc-global-shared-view params)
                            (tc-global-shared-view expanded-args)
                            (tc-ctfe-env call-ctx)
                            (tc-global-shared-view call-expr))
                            [(Ok identity _)
                              (macro-decl-expansion-with-frame
                                call-ctx
                                (tc-global-shared-view decl-path)
                                (tc-global-shared-view call-expr)
                                (macro-decl-name-display
                                  macro-name
                                  definition-module)
                                (match (macro-eval-transformer-expanded-with-env
                                  call-ctx
                                  (tc-global-shared-view orig-decls)
                                  (macro-decl-module-display definition-module)
                                  definition-module
                                  global-env
                                  macro-name
                                  declaration-id
                                  (macro-decl-name-display
                                    macro-name
                                    definition-module)
                                  (tc-global-shared-view params)
                                  ret
                                  body
                                  expanded-args
                                  (tc-global-shared-view call-expr))
                                  [(Ok value macro-env)
                                    (let
                                      [parse-dispatch : sym_i64_env.SymI64Env
                                        (parser.compiler-parse-dispatch-env-from-cfg
                                          cfgs)]
                                      [sexpr-owner : MacroSexprOwner
                                        (macro-sexpr-owner
                                          (tc-context-expr-bases call-ctx)
                                          (tc-context-structural-session
                                            call-ctx))]
                                      (match (macro-decls-from-ctfe-value
                                        (& sexpr-owner)
                                        (macro-hygiene-ctfe-output
                                          (tc-context-macro-state call-ctx)
                                          (ctfe_support.ctfe-env-syntax-pool-context
                                            (& macro-env))
                                          value
                                          (MacroHygieneContext
                                            macro-name
                                            definition-module
                                            declaration-id
                                            call-ctx.shared)
                                          params
                                          1)
                                        (tc-global-shared-view call-expr)
                                        parse-dispatch)
                                        [(Ok generated)
                                          (let
                                            [generated : ast.AstDeclList
                                              (if (tc-macro-param-list-needs-call-context?
                                                params)
                                                (macro-rewrite-generated-import-decls
                                                  call-ctx
                                                  orig-decls
                                                  module
                                                  (tc-context-module-id
                                                    call-ctx)
                                                  definition-module
                                                  macro-env
                                                  generated)
                                                generated)]
                                            [contextual-generated : ast.AstDeclList
                                              (macro-generated-context-decls
                                                generated
                                                definition-module)]
                                            [flattened-generated : ast.AstDeclList
                                              (macro-flatten-module-body-decls-in-module
                                                contextual-generated
                                                module-id)]
                                            [wrapped : ast.AstDeclList
                                              (macro-wrap-generated-decls
                                                flattened-generated
                                                (macro-decl-name-display
                                                  macro-name
                                                  definition-module)
                                                (macro-decls-generated-key
                                                  (tc-global-shared-view
                                                    identity))
                                                (tc-global-shared-view
                                                  decl-path)
                                                (macro-definition-path-id
                                                  call-ctx
                                                  (ci.intern
                                                    (macro-decl-name-display
                                                      macro-name
                                                      definition-module)))
                                                (macro-expr-span-or-zero
                                                  (tc-context-expr-bases ctx)
                                                  (tc-global-shared-view
                                                    call-expr)))]
                                            (macro-decls-splice-with-memo
                                              (tc-context-expr-bases call-ctx)
                                              (tc-context-macro-state call-ctx)
                                              identity
                                              wrapped
                                              decl-path
                                              call-expr))]
                                        [(Err diag) (Err diag)]))]
                                  [(Err diag) (Err diag)]))]
                            [(Err diag) (Err diag)]))
                        (if (tc-macro-result-module? ret)
                          (Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: Module macro can only be used in import position")))
                          (Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: expression macro cannot be used at module scope"))))))]
                  [(No)
                    (Err
                      (box
                        (macro-call-not-macro-diag
                          ctx
                          orig-decls
                          module-id
                          call-expr)))]))]
            [(Err diag) (Err diag)]))]
      [_
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-module-import
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools pools (& call-expr))
      [(Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            (tc-global-shared-view func)
            (tc-global-shared-view orig-decls)
            (tc-global-shared-view module)
            module-id
            context
            (tc-global-shared-view call-expr))
            [(Ok maybe-decl call-module _)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-module? (tc-global-shared-view ret))
                        ;; Always expand + materialize the module. There is no
                        ;; "skip the import when the alias is textually
                        ;; unreferenced" fast path: a declared
                        ;; instantiation must be typechecked whether or not anything
                        ;; references it (typecheck-completeness invariant).
                        (let
                          [expanded-args
                            (try
                              (macro-expand-exprs
                                call-ctx
                                global-env
                                (tc-global-shared-view orig-decls)
                                0
                                args))]
                          (match (macro-module-identity
                            call-ctx
                            (tc-global-shared-view orig-decls)
                            (macro-decl-module-display definition-module)
                            definition-module
                            (macro-decl-name-display
                              macro-name
                              definition-module)
                            (macro-decl-module-display definition-module)
                            (tc-global-shared-view params)
                            (tc-global-shared-view expanded-args)
                            (tc-ctfe-env call-ctx)
                            (tc-global-shared-view call-expr))
                            [(Ok identity _)
                              (let
                                [shortcut-safe? : bool
                                  (macro-generated-identity-shortcut-safe-params?
                                    call-ctx
                                    (macro-decl-module-display
                                      definition-module)
                                    definition-module
                                    params
                                    expanded-args)]
                                [shortcut-catalog : MacroGeneratedModuleCatalogEntry
                                  (if shortcut-safe?
                                    (macro-generated-module-memo-get-catalog
                                      (tc-context-macro-state call-ctx)
                                      (tc-global-shared-view identity))
                                    (Empty))]
                                (match shortcut-catalog
                                  [(Catalog target-id catalog _ _ _ _)
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-metric-add!
                                          (tc-context-macro-state ctx)
                                          tc-profile-generated-module-memo-hits
                                          1))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-metric-add!
                                          (tc-context-macro-state ctx)
                                          tc-profile-generated-module-catalog-hits
                                          1))
                                      (let
                                        [target-module : String
                                          (tc-env-key-name-text target-id)]
                                        [marker : ast.AstDeclList
                                          (macro-module-import-marker-decls
                                            (tc-global-shared-view
                                              target-module)
                                            target-id
                                            alias
                                            span)]
                                        [expanded : ast.AstDeclList
                                          (match (macro-find-module-body-decls-in-context
                                            ctx
                                            orig-decls
                                            target-module)
                                            [(Some _) marker]
                                            [(No)
                                              (macro-decl-list-append
                                                (ast.ast-decl-list-prepend-builder
                                                  (ast.ast-decl-module-id
                                                    target-id)
                                                  catalog)
                                                (ast.ast-decl-list-prepend-builder
                                                  (ast.ast-decl-module-id
                                                    module-id)
                                                  marker))])]
                                        (Ok
                                          (tc-global-shared-view expanded)
                                          (macro-paths-for-decls
                                            (tc-context-macro-state call-ctx)
                                            expanded
                                            decl-path))))]
                                  [(Empty)
                                    (macro-decl-expansion-with-frame
                                      call-ctx
                                      (tc-global-shared-view decl-path)
                                      (tc-global-shared-view call-expr)
                                      (macro-decl-name-display
                                        macro-name
                                        definition-module)
                                      (match (macro-eval-transformer-expanded-with-env
                                        call-ctx
                                        (tc-global-shared-view orig-decls)
                                        (macro-decl-module-display
                                          definition-module)
                                        definition-module
                                        global-env
                                        macro-name
                                        declaration-id
                                        (macro-decl-name-display
                                          macro-name
                                          definition-module)
                                        (tc-global-shared-view params)
                                        ret
                                        body
                                        expanded-args
                                        (tc-global-shared-view call-expr))
                                        [(Ok value macro-env)
                                          (let
                                            [parse-dispatch : sym_i64_env.SymI64Env
                                              (parser.compiler-parse-dispatch-env-from-cfg
                                                cfgs)]
                                            [sexpr-owner : MacroSexprOwner
                                              (macro-sexpr-owner
                                                (tc-context-expr-bases call-ctx)
                                                (tc-context-structural-session
                                                  call-ctx))]
                                            (match (macro-module-decls-from-ctfe-value
                                              (& sexpr-owner)
                                              (macro-hygiene-ctfe-output
                                                (tc-context-macro-state
                                                  call-ctx)
                                                (ctfe_support.ctfe-env-syntax-pool-context
                                                  (& macro-env))
                                                value
                                                (MacroHygieneContext
                                                  macro-name
                                                  definition-module
                                                  declaration-id
                                                  call-ctx.shared)
                                                params
                                                1)
                                              (tc-global-shared-view call-expr)
                                              parse-dispatch)
                                              [(Ok generated)
                                                (macro-expand-module-generated-decls
                                                  ctx
                                                  top-env
                                                  orig-decls
                                                  module-id
                                                  alias
                                                  span
                                                  decl-path
                                                  (macro-decl-name-display
                                                    macro-name
                                                    definition-module)
                                                  (macro-definition-path-id
                                                    call-ctx
                                                    (ci.intern
                                                      (macro-decl-name-display
                                                        macro-name
                                                        definition-module)))
                                                  identity
                                                  definition-module
                                                  macro-env
                                                  (tc-macro-param-list-needs-call-context?
                                                    params)
                                                  true
                                                  generated
                                                  call-expr)]
                                              [(Err diag) (Err diag)]))]
                                        [(Err diag) (Err diag)]))]))]
                            [(Err diag) (Err diag)]))
                        (if (tc-macro-result-decls? ret)
                          (Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: Decls macro cannot be used in import position")))
                          (Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: expression macro cannot be used as module import"))))))]
                  [(No)
                    (Err
                      (box
                        (macro-call-not-macro-diag
                          ctx
                          orig-decls
                          module-id
                          call-expr)))]))]
            [(Err diag) (Err diag)]))]
      [_
        (Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: import macro placeholder must contain a call")))])))

(define (macro-expand-decl-with-path
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [site-state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [previous-active : TcMacroCallSiteActiveDecl
      (tc-macro-call-site-state-active-decl site-state)]
    [_set-active : unit
      (tc-macro-call-site-state-set-active-decl!
        site-state
        (tc-global-shared-view decl-path)
        (ast.ast-decl-generated-meta decl))]
    [result : ResultMacroDeclExpansion
      (match (tc-global-shared-view decl)
        [(Import decl-meta (Spec kind _ _ alias span))
          (match kind
            [(Macro call-id context)
              (macro-expand-program-structural-change-note!
                (tc-context-macro-state ctx)
                2)
              (macro-expand-module-import
                ctx
                top-env
                orig-decls
                module
                module-id
                call-id
                context
                alias
                (ast.ast-source-span-box-shared-view span)
                cfgs
                decl-path)]
            [(MacroDecls call-id context)
              (macro-expand-program-structural-change-note!
                (tc-context-macro-state ctx)
                2)
              (macro-expand-decls-splice
                ctx
                top-env
                orig-decls
                module
                module-id
                call-id
                context
                cfgs
                decl-path)]
            [_
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)])]
        [_
          (let
            [decl-ctx : TcContext
              (tc-context-with-module-id ctx module module-id)]
            [template : ast.AstDecl
              (ast.ast-decl-with-meta
                (ast.ast-decl-meta-runtime-shared-view)
                (tc-global-shared-view decl))]
            [uses-macro : bool
              (macro-decl-uses-macro?
                decl-ctx
                (tc-context-expr-bases decl-ctx)
                (tc-global-shared-view orig-decls)
                (tc-global-shared-view template))]
            (if (not uses-macro)
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)
              (begin
                (if (macro-decl-expansion-can-change-program?
                  (tc-global-shared-view decl))
                  (macro-expand-program-structural-change-note!
                    (tc-context-macro-state ctx)
                    1)
                  unit)
                (match (macro-expand-decl
                  decl-ctx
                  local-env
                  orig-decls
                  template)
                  [(Ok expanded)
                    (macro-single-decl-expansion
                      (tc-context-macro-state ctx)
                      (ast.ast-decl-with-meta (ast.ast-decl-meta decl) expanded)
                      decl-path)]
                  [(Err diag)
                    (let
                      [diagnostic : cdiag.CompilerDiagnostic
                        (cdiag.compiler-diagnostic-box-shared-view diag)]
                      (Err
                        (box
                          (cdiag.compiler-diagnostic-with-fallback-path
                            diagnostic
                            decl-path))))]))))])]
    (tc-macro-call-site-state-restore-active-decl! site-state previous-active)
    result))

;; R3-P1 copy-out. Rebuild the declaration paths in the arena that is current on
;; entry; the path strings themselves can be generation-resident.
(define (macro-decl-generation-copy-paths [paths : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [count : i64 (ast.ast-decl-path-list-len (& paths))]
    [out : ast.AstDeclPathList (ast.ast-decl-path-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (let
        [path : String (ast.ast-decl-path-list-get (& paths) index "")]
        [owned-path : String (string.copy (& path))]
        (ast.ast-decl-path-list-push-with-owner-and-provenance-id
          (&mut out)
          owned-path
          (ast.ast-decl-path-list-owner-id
            (& paths)
            index
            cbi.compiler-builtin-id-fix-empty)
          (ast.ast-decl-path-list-provenance-id
            (& paths)
            index
            cbi.compiler-builtin-id-fix-empty))
        (set! index (+ index 1))))
    out))

;; Copy the only values allowed to cross the macro scratch boundary into the
;; checked pool's stable base owner. Original declarations still point into the
;; compact source pool, while every changed declaration was already deep-copied
;; there by `macro-decl-generation-copy-out`. The whole-program walk only owns
;; the final top-level spine, program shell, and path strings, so persist those
;; directly instead of recursively visiting every already-stable declaration.
;;
;; When the structural-change proof says the walk rebuilt only temporary list
;; spines, return the original stable program and paths directly. This is the
;; same proof used by lower's retain-macro-source fast path, applied early
;; enough that specialization never observes a scratch-backed result.
(define (macro-expand-result-stabilize
  [state : TcMacroState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [raw : ResultMacroExpand]) : ResultMacroExpand
  (match raw
    [(Ok expanded expanded-paths)
      (if (not (macro-expand-program-structurally-changed? state))
        (Ok program paths)
        (let
          [base-arena : arena.Arena
            (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
          (in-arena
            base-arena
            (match expanded
              [(Program decls-box)
                (let
                  [decls : ast.AstDeclList
                    (ast.ast-decl-list-box-shared-view decls-box)]
                  [count : i64 (ast.ast-decl-list-len (& decls))]
                  [copied-decls : ast.AstDeclList
                    (ast.ast-decl-list-with-capacity count)]
                  [index : i64 0]
                  (while (< index count)
                    (ast.ast-decl-list-push-from
                      (&mut copied-decls)
                      (& decls.slots)
                      (+ decls.offset index))
                    (set! index (+ index 1)))
                  (parser.compiler-parse-decl-origin-register-list-aliases!
                    (& copied-decls)
                    0
                    decls)
                  (Ok
                    (ast.ast-program copied-decls)
                    (macro-decl-generation-copy-paths expanded-paths)))]))))]
    [(Err diag)
      (let
        [base-arena : arena.Arena
          (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
        (in-arena
          base-arena
          (Err
            (box
              (cdiag.compiler-diagnostic-copy
                (cdiag.compiler-diagnostic-box-shared-view diag))))))]))

;; Move one expansion result out of its generation and into the committed pool.
;; Everything the survivor still owns in the generation is rebuilt in the pool's
;; base arena; every node id below the shared bases is left alone. Leaves the
;; pool's stable base root current for the caller.
;;
;; PERSIST IN PLACE, not copy-append: the expression rows this expansion created
;; are rewritten where they already are, so the pool does not grow and the
;; survivor keeps its ids. It is the expansion's own transient scope that
;; created every id at or above `shared-expr-base`, and the walk has not
;; committed any of them yet, so rewriting one with an equal-valued,
;; base-arena-owned copy is unobservable. The declaration shells and the path
;; list are still rebuilt -- those live in the generation's slot arrays, not in
;; the pool, so there is nothing to rewrite in place.
(define (macro-decl-generation-copy-out
  [pools : ast.AstNodePoolContext]
  [raw : ResultMacroDeclExpansion]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map-address : u64]
  [type-map-address : u64]) : ResultMacroDeclExpansion
  (match raw
    [(Ok expanded expanded-paths)
      (match (ast.ast-program-copy-append-above-with-maps
        pools
        pools
        (& (ast.ast-program expanded))
        shared-expr-base
        shared-type-base
        expr-map-address
        type-map-address
        true)
        [(AstProgramCompaction copied _)
          (let
            ;; The program copy restores the arena it was called with, which can
            ;; be a segment the copy itself filled. Resume from the head the
            ;; copy synced into the pool before allocating the paths.
            [_resume : unit
              (unsafe
                (arena.tl_arena_set
                  (ast.ast-node-pool-context-base-arena pools)))]
            [paths : ast.AstDeclPathList
              (macro-decl-generation-copy-paths expanded-paths)]
            (match copied
              [(Program decls-box)
                (Ok (ast.ast-decl-list-box-shared-view decls-box) paths)]))])]
    [(Err diag)
      (let
        [_resume : unit
          (unsafe
            (arena.tl_arena_set (ast.ast-node-pool-context-base-arena pools)))]
        [owned : cdiag.CompilerDiagnostic
          (cdiag.compiler-diagnostic-copy
            (cdiag.compiler-diagnostic-box-shared-view diag))]
        [boxed : (Box cdiag.CompilerDiagnostic) (box owned)]
        (Err boxed))]))

;; R3-P1: run one firing declaration's expansion inside its own arena generation
;; and copy the surviving declaration back into the committed pool.
;;
;; Only the ambient arena changes. The node pools stay installed and shared, so
;; the type pool's hash-consing table keeps seeing every declaration -- and
;; because `ast-type-node-pool-state-push-raw` persists a type node's payload
;; into the pool's base arena BEFORE writing the row, a type node pushed while
;; the generation is current is already committed. The copy-out therefore shares
;; every type id and pushes no new type node at all; only expression rows, whose
;; 32-byte row copy does not persist boxed children, have to be re-pushed.
;;
;; The shared expression base is the pool length taken before the expansion:
;; ids below it are pre-existing committed nodes that must not be copied (that
;; is what keeps the id map per-declaration sized instead of whole-pool sized),
;; and every node the expansion creates is at or above it. The in-place hygiene
;; rewrite in `macro-hygiene-expr` only touches ids at or above the
;; `TcMacroHygieneProducedStateData` floor, which is itself taken during the
;; expansion, so it can never mutate a shared node into the generation.
;;
;; The pool's base arena IS the enclosing arena here. Arena handles are stable
;; roots, so a type push can grow its physical chain without changing the
;; enclosing handle restored after the generation.
(define (macro-expand-decl-with-path-generational
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]) : ResultMacroDeclExpansion
  (macro-expand-decl-with-path-in-generation
    ctx
    top-env
    local-env
    orig-decls
    module
    module-id
    decl
    cfgs
    decl-path
    false))

;: R3-P2b: the same mechanism on the splice ring. `splice?` selects which of the
;: two rings owns this expansion's generation; everything else -- the shared
;: bases, the persist-in-place copy-out, the arena-head discipline -- is
;: identical.
(define (macro-expand-decl-with-path-splice-generational
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]) : ResultMacroDeclExpansion
  (macro-expand-decl-with-path-in-generation
    ctx
    top-env
    local-env
    orig-decls
    module
    module-id
    decl
    cfgs
    decl-path
    true))

(define (macro-expand-decl-with-path-in-generation
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [cfgs : sym_i64_env.SymI64Env]
  [decl-path : String]
  [splice? : bool]) : ResultMacroDeclExpansion
  (if (not
    (and
      (tc-macro-walk-field
        (tc-context-macro-state ctx)
        macro-expand-scratch-enabled)
      (ast.ast-node-pool-has-active-context?)))
    (macro-expand-decl-with-path
      ctx
      top-env
      local-env
      orig-decls
      module
      module-id
      decl
      cfgs
      decl-path)
    (let
      [macro-state : TcMacroState (tc-context-macro-state ctx)]
      [enclosing : i64 (arena.tl_arena_current)]
      [entry-expr-len : i64 (ast.ast-node-pool-len)]
      [_profile-entry-type-len : i64 (ast.ty-node-pool-len)]
      [_profile-live-before-enter : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-captures-before : i64
        (cfg compile-profile compiler-tc-walk-operand-captures 0)]
      [generation : i64
        (if splice?
          (macro-splice-generation-enter! macro-state)
          (macro-decl-generation-enter! macro-state))]
      [_profile-live-after-enter : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      ;; R3-P2b: whatever this expansion records in a splice memo is noted and
      ;; re-persisted below. The window is exactly the expansion call -- a memo
      ;; put from anywhere else already lands in a long-lived arena and must not
      ;; be re-persisted with these maps.
      [_escape-reset : unit (macro-decl-generation-escape-reset! macro-state)]
      [_enter : unit
        (unsafe
          (arena.tl_arena_set generation))]
      [_profile-generation-mark : i64
        (cfg compile-profile (arena.tl_region_mark) 0)]
      [_profile-raw-start-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_escape-open : unit
        (tc-macro-walk-set! macro-state macro-decl-generation-active true)]
      ;; R3-P2c: publish which generation is live, so anything that installs a
      ;; pool context from inside this expansion is repaired at the destroy.
      [_witness-on : unit
        (ast.ast-node-pool-context-transient-witness! generation)]
      [raw : ResultMacroDeclExpansion
        (macro-expand-decl-with-path
          ctx
          top-env
          local-env
          orig-decls
          module
          module-id
          decl
          cfgs
          decl-path)]
      [_profile-fired : bool
        (cfg
          compile-profile
          (> compiler-tc-walk-operand-captures _profile-captures-before)
          false)]
      [_profile-raw-end-live : i64 (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-generation-raw-bytes : i64
        (cfg
          compile-profile
          (if _profile-fired
            (compiler-tc-profile-arena-bytes-since
              generation
              _profile-generation-mark)
            0)
          0)]
      [_escape-close : unit
        (tc-macro-walk-set! macro-state macro-decl-generation-active false)]
      [_witness-off : unit (ast.ast-node-pool-context-transient-witness! 0)]
      ;; Clamped: the walk never truncates the pool below the length it entered
      ;; with, but a base above the live length would make the id map read out
      ;; of range, and a shorter pool has nothing above the base to copy anyway.
      [shared-expr-base : i64
        (if (< (ast.ast-node-pool-len) entry-expr-len)
          (ast.ast-node-pool-len)
          entry-expr-len)]
      ;; Built while the generation is still current: the maps are dead the
      ;; moment the copy-out returns, and putting them here saves the private
      ;; map arena's reserve/release pair on every firing declaration.
      [expr-map : (__tl_dyn-array i32)
        (ast.ast-compaction-id-map-create
          (- (ast.ast-node-pool-len) shared-expr-base))]
      [type-map : (__tl_dyn-array i32)
        (ast.ast-compaction-id-map-create
          (cfg
            compile-profile
            (- (ast.ty-node-pool-len) _profile-entry-type-len)
            0))]
      [expr-map-address : u64 (ast.ast-i32-array-address expr-map)]
      [type-map-address : u64 (ast.ast-i32-array-address type-map)]
      [_profile-generation-used-end : i64
        (cfg
          compile-profile
          (if _profile-fired
            (compiler-tc-profile-arena-bytes-since
              generation
              _profile-generation-mark)
            0)
          0)]
      ;; The expansion can install a different pool context -- captured CTFE
      ;; syntax pools rebase the active pools -- so the context to append into
      ;; must be re-read HERE. Snapshot the current scalar state into fresh
      ;; base-arena-owned cells: a captured result may describe stable pool data
      ;; through cell descriptors allocated in this declaration generation.
      ;; Reusing those descriptors would leave the installed context dangling
      ;; when the generation retires.
      [pools : ast.AstNodePoolContext
        (ast.ast-node-pool-context-capture-active)]
      [_capture-expanded : unit
        (ast.ast-node-pool-context-capture-active!
          (ast.ast-node-pool-context-shared-view (& pools)))]
      [_install-stable : unit
        (ast.ast-node-pool-context-install!
          (ast.ast-node-pool-context-shared-view (& pools)))]
      [_leave : unit
        (unsafe
          (arena.tl_arena_set enclosing))]
      [_profile-copy-start-total : i64
        (cfg compile-profile (profile.alloc-total) 0)]
      [_profile-copy-start-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-census-start : unit
        (cfg
          compile-profile
          (if (and (not splice?) _profile-fired)
            (ast.ast-compaction-profile-start! _profile-entry-type-len type-map)
            unit)
          unit)]
      ;; Every existing type id is shared, so the copy-out and the escape pass
      ;; push no type node at all. Read once so both passes see the same base.
      [shared-type-base : i64 (ast.ast-node-pool-context-type-len pools)]
      [escaped : ResultMacroDeclExpansion
        (macro-decl-generation-copy-out
          pools
          raw
          shared-expr-base
          shared-type-base
          expr-map-address
          type-map-address)]
      [_escapes : unit
        (macro-decl-generation-escapes-persist!
          macro-state
          pools
          shared-expr-base
          shared-type-base
          expr-map-address
          type-map-address
          splice?)]
      [_profile-copy-end-total : i64
        (cfg compile-profile (profile.alloc-total) 0)]
      [_profile-copy-end-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-attribution : unit
        (cfg
          compile-profile
          (if (and (not splice?) _profile-fired)
            (let
              [committed-live : i64
                (-
                  (- _profile-raw-end-live _profile-raw-start-live)
                  _profile-generation-raw-bytes)]
              [released : i64
                (- _profile-live-before-enter _profile-live-after-enter)]
              (ast.ast-compaction-profile-finish!)
              (compiler-tc-walk-decl-fire-attribution-note!
                (- _profile-copy-end-total _profile-copy-start-total)
                (- _profile-copy-end-live _profile-copy-start-live)
                _profile-generation-used-end
                (if (> released 0)
                  released
                  0)
                committed-live
                _profile-copy-end-live
                (ast.ast-compaction-profile-source-shared-expr-ref-count)
                (ast.ast-compaction-profile-source-shared-type-ref-count)
                (ast.ast-compaction-profile-survivor-expr-node-count)
                (ast.ast-compaction-profile-survivor-type-node-count)))
            unit)
          unit)]
      (begin
        (cfg compile-profile (counters.bump! tc-profile-decl-generations))
        (unsafe
          (arena.tl_arena_set enclosing))
        (ast.ast-node-pool-context-install! pools)
        escaped))))

(define (macro-module-generated-key? [key : String]) : bool
  (and
    (> (string.string-length key) 0)
    (not (tc-string-prefix? key "generated:"))))

(define (macro-decl-generated-identity [decl : ast.AstDecl]) : csym.CompilerMaybeString
  (match (ast.ast-decl-generated-meta decl)
    [(Some _ _ _ key)
      (if (macro-module-generated-key? (tc-global-shared-view key))
        (CompilerSomeString key)
        CompilerNoString)]
    [(No) CompilerNoString]))

(define (macro-module-generated-identity-in
  [decls : ast.AstDeclList]
  [target-module-id : i64]
  [module-id : i64]) : csym.CompilerMaybeString
  (match (ast.ast-decl-list-step decls)
    [(Nil) CompilerNoString]
    [(Cons decl rest-box)
      (match (tc-global-shared-view decl)
        [(Module next-module)
          (macro-module-generated-identity-in
            rest-box
            target-module-id
            next-module)]
        [_
          (if (= module-id target-module-id)
            (match (macro-decl-generated-identity decl)
              [(CompilerSomeString identity) (CompilerSomeString identity)]
              [CompilerNoString
                (macro-module-generated-identity-in
                  rest-box
                  target-module-id
                  module-id)])
            (macro-module-generated-identity-in
              rest-box
              target-module-id
              module-id))])]))

(define (macro-module-generated-identity
  [decls : ast.AstDeclList]
  [target-module-id : i64]) : csym.CompilerMaybeString
  (macro-module-generated-identity-in
    decls
    target-module-id
    cbi.compiler-builtin-id-fix-empty))

(define (macro-generated-module-marker-in
  [decls : ast.AstDeclList]
  [target-module-id : i64]
  [importer-module-id : i64]
  [module-id : i64]) : ast.AstDeclList
  (match (ast.ast-decl-list-step decls)
    [(Nil) (ast.ast-decl-list-new)]
    [(Cons decl rest)
      (match (tc-global-shared-view decl)
        [(Module next-module)
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            next-module)]
        [(Import decl-meta (Spec kind _ (Some imported-module) _ _))
          (match kind
            [(Module)
              (if (and
                (= module-id importer-module-id)
                (= imported-module target-module-id))
                (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new)))
                (macro-generated-module-marker-in
                  rest
                  target-module-id
                  importer-module-id
                  module-id))]
            [_
              (macro-generated-module-marker-in
                rest
                target-module-id
                importer-module-id
                module-id)])]
        [_
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            module-id)])]))

;; A memoized module expansion has exactly the two pieces needed by the
;; incremental top-env path: its canonical module summary and the import marker
;; emitted in the caller's module. Decls macros use `generated:` keys and never
;; satisfy macro-module-generated-key?, so they stay on the full-rebuild path.
(define (macro-generated-module-extension
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [importer-module-id : i64]) : MacroMaybeGeneratedModuleExtension
  (match (ast.ast-decl-list-step decls)
    [(Nil) No]
    [(Cons first _)
      (match first
        [(Module target-module-id)
          (match (macro-module-generated-identity
            (tc-global-shared-view decls)
            target-module-id)
            [(CompilerSomeString identity)
              (let
                [summary : ast.AstDeclList
                  (macro-generated-module-memo-get-summary state identity)]
                [marker : ast.AstDeclList
                  (macro-generated-module-marker-in
                    decls
                    target-module-id
                    importer-module-id
                    cbi.compiler-builtin-id-fix-empty)]
                (match (ast.ast-decl-list-step summary)
                  [(Nil) No]
                  [_
                    (match (ast.ast-decl-list-step marker)
                      [(Nil) No]
                      [_ (Some summary marker)])]))]
            [CompilerNoString No])]
        [_ No])]))

;; Macro-expansion skip analysis. Once any module defines
;; a macro, `has-defmacro` forces the full macro-expand walk over EVERY decl in
;; the program (all imported modules), which redundantly re-typechecks match
;; scrutinees / let bindings and rebuilds the entire AST. The vast majority of
;; decls call no macro at all, so this work is pure waste. These predicates
;; detect whether a decl actually contains a macro
;; (or `when`/`unless` compat) call using the SAME resolution as the expander
;; (`macro-call-decl`), so a decl with none can be shared unchanged. They are
;; conservative: any unrecognized expression variant returns `true` (expand), so
;; a future AST node that could host a macro call is never silently skipped.
;; The callee name of a call after hygiene-stripping (but keeping any module
;; qualifier), mirroring `macro-call-decl`'s name resolution. Returns nothing for
;; non-variable callees (which `macro-call-decl` also treats as non-macro).
;; Allocation-free for plain unqualified names -- the hot path for the pre-filter.
(define (macro-call-callee-name
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [func : ast.AstExpr]) : TcMaybeString
  (match func
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _))
      (macro-call-callee-name
        expr-bases
        session
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(Var name)
      (let
        [name-text : String (tc-env-key-display session name)]
        (Some
          (if (tc-hygiene-global-name? name-text)
            (match (tc-hygiene-global-decode name-text)
              [(Legacy lookup-name) lookup-name]
              [(Context _ lookup-name) lookup-name])
            name-text)))]
    [_ (No)]))

(define (macro-call-callee-last-dot [name : (& name str)]) : i64
  (let
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length name)]
    (while (< i n)
      (if (or
        (string.char-eq (string.string-ref name i) '.')
        (string.char-eq (string.string-ref name i) '/'))
        (set! last-dot i)
        unit)
      (set! i (+ i 1)))
    last-dot))

(define (macro-call-callee-base-name [name : String]) : String
  (let
    [lookup : String
      (if (tc-hygiene-global-name? name)
        (tc-hygiene-global-call-name name)
        name)]
    [source : String lookup]
    [last-dot : i64 (macro-call-callee-last-dot source)]
    [n : i64 (string.string-length source)]
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (macro-call-name-maybe-macro? [name : String]) : bool
  (let
    [base : String (macro-call-callee-base-name name)]
    (or (string.eq base "when") (string.eq base "unless"))))

(define (macro-call-callee-base-name-id
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [func : ast.AstExpr]) : TcMaybeNameId
  (match func
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _))
      (macro-call-callee-base-name-id
        expr-bases
        session
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(Var name-id)
      (cond
        [(csym.compiler-composite-triple-key-id? name-id)
          (Some (csym.compiler-composite-triple-right-id name-id))]
        [(csym.compiler-composite-pair-key-id? name-id)
          (Some (csym.compiler-composite-pair-right-id name-id))]
        [else
          (let
            [source-id : i64
              (macro-hygiene-global-source-name-id-or session name-id name-id)]
            [base-id : i64
              (if (and
                (>= source-id 0)
                (< source-id (ci.intern-capacity))
                (ci.intern-qualified? source-id))
                (ci.intern-qualified-base-id source-id)
                source-id)]
            (if (< base-id 0)
              No
              (Some
                (if (and
                  (< base-id (ci.intern-capacity))
                  (ci.intern-dotted? base-id))
                  (ci.intern-dotted-final-id base-id)
                  base-id))))])]
    [_ No]))

(define (macro-call-callee-maybe-macro?
  [expr-bases : i64]
  [state : TcMacroState]
  [func : ast.AstExpr]) : bool
  (match (macro-call-callee-base-name-id
    expr-bases
    (tc-macro-state-structural-session state)
    (tc-global-shared-view func))
    [(Some base-id)
      (let
        [names : tc_i64_i64_map.Map
          (tc-macro-walk-field state macro-expand-macro-name-set)]
        (or
          (tc_i64_i64_map.contains? (& names) base-id)
          (= base-id cbi.compiler-builtin-id-fix-when)
          (= base-id cbi.compiler-builtin-id-fix-unless)))]
    [No
      (match (macro-call-callee-name
        expr-bases
        (tc-macro-state-structural-session state)
        func)
        [(Some name) (macro-call-name-maybe-macro? name)]
        [(No) false])]))

(define (macro-call-is-expandable?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [func : ast.AstExpr]
  [call-expr : ast.AstExpr]) : bool
  (match (macro-call-callee-name
    (tc-context-expr-bases ctx)
    (tc-context-structural-session ctx)
    (tc-global-shared-view func))
    [(Some name)
      ;; Only callees whose base name matches a declared macro need precise
      ;; alias/module resolution. This keeps value-heavy dotted imports such as
      ;; `string.length` on the cheap path while still resolving qualified macro
      ;; calls through `macro-call-decl`.
      (if (macro-call-callee-maybe-macro?
        (tc-context-expr-bases ctx)
        (tc-context-macro-state ctx)
        (tc-global-shared-view func))
        (match (macro-call-decl ctx func decls call-expr)
          [(Ok maybe)
            (match maybe
              [(Some _ _ _ _ _ _) true]
              [(No) (or (string.eq name "when") (string.eq name "unless"))])]
          [(Err _) true])
        false)]
    [(No) false]))

(define (macro-node-uses-macro?
  [ctx : TcContext]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [id : i64]) : bool
  ;; This conservative inspection runs before expansion and never installs.
  ;; Its caller snapshots one owner for the complete declaration walk.
  (macro-expr-uses-macro?
    ctx
    expr-bases
    decls
    (ast.ast-expr-segment-bases-get expr-bases id)))

(define (macro-exprs-use-macro?
  [ctx : TcContext]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [exprs : ast.AstExprList]) : bool
  (macro-exprs-use-macro-at? ctx expr-bases decls (& exprs) 0))

(define (macro-exprs-use-macro-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (macro-node-uses-macro?
        ctx
        expr-bases
        (tc-global-shared-view decls)
        (ast.ast-expr-list-get exprs index 0))
      (macro-exprs-use-macro-at? ctx expr-bases decls exprs (+ index 1)))))

(define (macro-expr-uses-macro?
  [ctx : TcContext]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [expr : ast.AstExpr]) : bool
  (match (tc-global-shared-view expr)
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (or
          (macro-call-is-expandable?
            ctx
            (tc-global-shared-view decls)
            (tc-global-shared-view func)
            expr)
          (macro-expr-uses-macro?
            ctx
            expr-bases
            (tc-global-shared-view decls)
            func)
          (macro-exprs-use-macro? ctx expr-bases decls args)))]
    ;; The index is a literal integer, not an expression.
    [(TupleRef a _) (macro-node-uses-macro? ctx expr-bases decls a)]
    ;; These forms are conservatively assumed to use a macro.
    [(or (Break) (Continue) (SpmdReduce _) (SpmdScan _) (SpmdCompact _)
         (SpmdBroadcast _ _) (SpmdShuffle _ _) (WithRegion _ _) (WithResource _)
         (Quote _) (Quasiquote _) (Unquote _) (UnquoteSplicing _)
         (ForOwnedState _) (ForOwnedStep _))
      true]
    [_
      (macro-exprs-use-macro?
        ctx
        expr-bases
        decls
        (ast.ast-expr-child-ids expr))]))

(define (macro-decl-uses-macro?
  [ctx : TcContext]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(or (Def _ _ _ expr-box) (DefFn _ _ _ _ expr-box _))
      (macro-node-uses-macro? ctx expr-bases decls expr-box)]
    [(Test _ _ _ _) true]
    [(Import decl-meta (Spec kind _ _ _ _))
      (match kind
        [(or (Macro _ _) (MacroDecls _ _)) true]
        [_ false])]
    [(Unsafe inner-box)
      (macro-decl-uses-macro?
        ctx
        expr-bases
        decls
        (ast.ast-decl-box-shared-view inner-box))]
    [_ false]))

;; `macro-decl-uses-macro?` is also a conservative inspection gate: tests take
;; that path even though production macro expansion shares them verbatim.  Keep
;; the structural-change proof narrower than the inspection decision so an
;; unchanged Test (including one wrapped in Unsafe) cannot force a whole-program
;; detach.
(define (macro-decl-expansion-can-change-program? [decl : ast.AstDecl]) : bool
  (match decl
    [(or (Def _ _ _ _) (DefFn _ _ _ _ _ _)) true]
    [(Import _ (Spec kind _ _ _ _))
      (match kind
        [(or (Macro _ _) (MacroDecls _ _)) true]
        [_ false])]
    [(Unsafe inner-box)
      (macro-decl-expansion-can-change-program?
        (ast.ast-decl-box-shared-view inner-box))]
    [_ false]))

;; Cheap, ctx-free, allocation-free over-approximation of "could the expander
;; fire a macro/compat call anywhere inside this expression". It is used as a
;; decl-level pre-filter in `macro-expand-decls`: a decl whose body cannot fire
;; is pushed to the output unchanged (shared, never copied through the expander),
;; skipping the per-decl `tc-context-with-module` allocation and the precise
;; `macro-decl-uses-macro?` walk (which resolves candidate calls via
;; `macro-call-decl`).
;;
;; SAFE BY CONSTRUCTION (must guarantee: if the expander could rewrite a child
;; expression, `macro-expr-might-fire? = true`, i.e. we never share what the
;; expander would expand). This is achieved by following child expressions that
;; can syntactically contain calls, with explicit false leaves for non-call
;; forms.
;;   - At `AstExpr.Call` it uses `macro-call-callee-maybe-macro?` -- the registry
;;     gate the expander itself checks before attempting expansion -- which is a
;;     superset of `macro-call-is-expandable?` (it skips the `macro-call-decl`
;;     resolution and treats any registry-name callee as a possible fire). So at
;;     every call mine flags at least whatever the precise walk flags.
;;   - Scoped/container forms (for example WithRegion, WithResource, and SPMD)
;;     recurse into their child expressions here as well, so ordinary
;;     scoped/resource/vector code without macro calls does not force the full
;;     macro setup path.
;; A bare `AstExpr.Var`/`AstExpr.Set` target is never a call -> false (matching
;; the gate). `AstExpr.PtrAddrOf` follows its place operand because addressable
;; places can now contain macro-expanded field/element forms. This walk covers
;; every expression position from which a macro can fire. Whether a transformer
;; asks for an operand's type changes how that call is evaluated, not how the
;; call is represented, so expr-type macros use the same syntactic call gate.
(define (macro-expr-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : bool
  (macro-expr-list-might-fire-at? state expr-bases (& exprs) 0))

(define (macro-expr-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0)))
      (macro-expr-list-might-fire-at? state expr-bases exprs (+ index 1)))))

(define (macro-let-binding-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]) : bool
  (macro-let-binding-list-might-fire-at? state expr-bases (& bindings) 0))

(define (macro-let-binding-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (macro-expr-might-fire? state expr-bases init)
            (macro-let-binding-list-might-fire-at?
              state
              expr-bases
              bindings
              (+ index 1))))])))

(define (macro-match-arms-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : bool
  (not (= (macro-match-arms-first-fire-index state expr-bases arms) -1)))

(define (macro-match-arms-first-fire-index
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]) : i64
  (macro-match-arms-first-fire-index-at state expr-bases (& arms) 0))

(define (macro-match-arms-first-fire-index-at
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : i64
  (if (>= index arms.len)
    -1
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (if (macro-expr-might-fire? state expr-bases body)
            index
            (macro-match-arms-first-fire-index-at
              state
              expr-bases
              arms
              (+ index 1))))])))

(define (macro-resource-binding-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]) : bool
  (macro-resource-binding-list-might-fire-at? state expr-bases (& bindings) 0))

(define (macro-resource-binding-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding _ init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (macro-expr-might-fire? state expr-bases init)
            (macro-expr-might-fire? state expr-bases cleanup)
            (macro-resource-binding-list-might-fire-at?
              state
              expr-bases
              bindings
              (+ index 1))))])))

(define (macro-expr-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (macro-expr-might-fire-uncounted? state expr-bases expr))

(define (macro-expr-might-fire-uncounted?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(or (Spanned inner-box _) (Unary _ inner-box) (Ann inner-box _)
         (Cast inner-box _) (Box inner-box) (BoxGet inner-box)
         (BoxTake inner-box) (Comptime inner-box) (Try inner-box)
         (Return inner-box) (PtrNullCheck inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(or (MacroExpansion inner-box _ _) (ForeachActive _ inner-box)
         (LaneValue inner-box))
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(or (Literal _) (Var _) (BinaryData _) (SpmdProgramIndex)
         (SpmdProgramCount) (TypeLiteral _) (Init _) (PtrNull _) (ProgramArgc)
         (ProgramArgv) (ProgramEnvp))
      false]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (or
          (macro-call-callee-maybe-macro?
            expr-bases
            state
            (tc-global-shared-view func))
          (macro-expr-might-fire? state expr-bases func)
          (macro-expr-list-might-fire? state expr-bases args)))]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items) (WithRegion _ items) (WithScratch items)
         (Syscall items))
      (macro-expr-list-might-fire? state expr-bases items)]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (or
          (macro-expr-might-fire? state expr-bases left)
          (macro-expr-might-fire? state expr-bases right)))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (or
          (macro-expr-might-fire? state expr-bases cond)
          (macro-expr-might-fire? state expr-bases then-branch)
          (macro-expr-might-fire? state expr-bases else-branch)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-let-binding-list-might-fire? state expr-bases bindings)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (macro-expr-might-fire? state expr-bases body))])]
    ;; The index is a literal integer, not an expression.
    [(TupleRef tuple-box _)
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases tuple-box))]
    [(or (FixedMakeArray _ len-box) (MakeArray _ len-box))
      (let
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (macro-expr-might-fire? state expr-bases len))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases index)))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases index)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [live : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases live-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases live)
          (macro-expr-might-fire? state expr-bases index)))]
    [(Replace place-box replacement-box)
      (or
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases place-box))
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases replacement-box)))]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases value)))]
    [(StringRef str-box index-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases str)
          (macro-expr-might-fire? state expr-bases index)))]
    [(While cond-box body-box)
      (or
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases cond-box))
        (macro-expr-list-might-fire? state expr-bases body-box))]
    [(ForOwnedState payload)
      (let
        [source : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-state-source (& payload)))]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-state-body (& payload)))]
        (or
          (macro-expr-might-fire? state expr-bases source)
          (macro-expr-might-fire? state expr-bases body)))]
    [(ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-step-body (& payload)))]
        (or
          (if (>= expected-type 0)
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases expected-type))
            false)
          (macro-expr-might-fire? state expr-bases body)))]
    [(or (Set _ value-box) (IntToPtr value-box _))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (macro-expr-might-fire? state expr-bases value))]
    [(or (Borrow _ _ place-box) (PtrAddrOf place-box))
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (macro-expr-might-fire? state expr-bases place))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (or
              (macro-expr-might-fire? state expr-bases scrutinee)
              (macro-match-arms-might-fire? state expr-bases arms)))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases body)))]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box body-box)
          (or
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases a-box))
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases b-box))
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases c-box))
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases d-box))
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases init)
              (macro-expr-might-fire? state expr-bases value)))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases init)
              (macro-expr-might-fire? state expr-bases value)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact _ _ start-box end-box _ _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases init)
              (macro-expr-might-fire? state expr-bases keep)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(or (SpmdBroadcast value-box lane-box) (SpmdShuffle value-box lane-box))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (or
          (macro-expr-might-fire? state expr-bases value)
          (macro-expr-might-fire? state expr-bases lane)))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (macro-expr-might-fire? state expr-bases receiver))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases receiver)
          (macro-expr-might-fire? state expr-bases value)))]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        (or
          (macro-expr-might-fire? state expr-bases scratch)
          (macro-expr-list-might-fire? state expr-bases body)))]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        (or
          (macro-expr-might-fire? state expr-bases arena)
          (macro-expr-list-might-fire? state expr-bases body)))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (or
            (macro-resource-binding-list-might-fire? state expr-bases bindings)
            (macro-expr-list-might-fire? state expr-bases body))])]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases inner)
          (macro-expr-might-fire? state expr-bases value)))]
    [(or (PtrRead ptr-box) (PtrCast ptr-box _) (PtrToInt ptr-box))
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (macro-expr-might-fire? state expr-bases ptr))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases value)))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases offset)))]
    [(StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (macro-expr-might-fire? state expr-bases str))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases len)))]
    [(ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (macro-expr-might-fire? state expr-bases array))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (macro-expr-might-fire? state expr-bases leaf)
          (macro-expr-might-fire? state expr-bases subleaf)))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (macro-expr-might-fire? state expr-bases index))]
    [_ true]))

;; Decl-level companion to `macro-expr-might-fire?`. Returns true only for the
;; value-bearing decl kinds whose entire macro-expandable surface is a single
;; body expression that provably contains no fireable call -- such a decl can be
;; pushed to the macro-expand output unchanged (shared). Every other decl kind
;; returns false so it falls through to the precise `macro-expand-decl-with-path`
;; path (which shares or expands import placeholders, splices, defmacro, unsafe,
;; comptime templates, etc. correctly).
(define (macro-decl-cannot-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (if (ast.ast-decl-comptime-only? decl)
    false
    (match decl
      [(or (Def _ _ _ expr-box) (DefFn _ _ _ _ expr-box _))
        (not
          (macro-expr-might-fire?
            state
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases expr-box)))]
      [(Test _ _ _ _) false]
      [_ false])))

;; Profile-instrumented wrapper for the per-decl share gate; non-profile
;; builds see a plain call.
(define (macro-decl-cannot-fire-gate?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (let
    [result : bool (macro-decl-cannot-fire? state expr-bases decl)]
    result))

;; Whether the program contains any `(type T)` literal (AstExpr.TypeLiteral). ALL
;; CTFE reflection/layout queries (ctfe-reflect-resolve-type for a `(type T)`,
;; and every reflection/layout builtin -- size-of/struct-field-*/enum-variant-*/
;; ...) take a type-literal argument, and type literals are comptime-only (they
;; can't appear in runtime code). So a program with no type literal never queries
;; the CTFE metadata, and `tc-ctfe-env` can hand back an empty env instead of
;; building the whole-program reflection + layout tables (tens of MB, O(types^2)).
;; Macro `expr-type` calls also need metadata, but macro expansion tracks those
;; from defmacro bodies instead of making this whole-program scan normalize every
;; call head.
;; Conservative: any unrecognized expression returns `true` (build), so a future
;; node that could host a type literal is never silently skipped.
(define (ctfe-node-has-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [id : i64]) : bool
  (ctfe-expr-has-type-literal?
    expr-bases
    state
    (ast.ast-expr-segment-bases-get expr-bases id)))

(define (ctfe-node-is-module-value-query?
  [expr-bases : i64]
  [state : TcMacroState]
  [id : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    expr-bases
    (& (ast.ast-expr-segment-bases-get expr-bases id)))
    [(Var raw-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-macro-state-structural-session state)
            raw-id
            raw-id)]
        (ctfe_support.ctfe-builtin-module-value-id?
          (ctfe_support.ctfe-comptime-helper-call-name-id source-id)))]
    [_ false]))

;; Function arguments are eager. Use this at the declaration-list boundary so
;; an earlier type literal cannot stop the combined metadata/query prescan
;; before it reaches a later macro body.
(define (ctfe-reflection-prescan-or [left : bool] [right : bool]) : bool
  (or left right))

(define (ctfe-exprs-have-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [exprs : ast.AstExprList]) : bool
  (ctfe-exprs-have-type-literal-at? expr-bases state (& exprs) 0))

(define (ctfe-exprs-have-type-literal-at?
  [expr-bases : i64]
  [state : TcMacroState]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (ctfe-reflection-prescan-or
      (ctfe-node-has-type-literal?
        expr-bases
        state
        (ast.ast-expr-list-get exprs index 0))
      (ctfe-exprs-have-type-literal-at? expr-bases state exprs (+ index 1)))))

(define (ctfe-arms-have-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [arms : ast.AstMatchArmList]) : bool
  (ctfe-arms-have-type-literal-at? expr-bases state (& arms) 0))

(define (ctfe-arms-have-type-literal-at?
  [expr-bases : i64]
  [state : TcMacroState]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (ctfe-reflection-prescan-or
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(Arm _ body-box)
          (ctfe-node-has-type-literal? expr-bases state body-box)])
      (ctfe-arms-have-type-literal-at? expr-bases state arms (+ index 1)))))

(define (ctfe-bindings-have-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [bindings : ast.AstLetBindingList]) : bool
  (ctfe-bindings-have-type-literal-at? expr-bases state (& bindings) 0))

(define (ctfe-bindings-have-type-literal-at?
  [expr-bases : i64]
  [state : TcMacroState]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (ctfe-reflection-prescan-or
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(Binding _ _ init-box)
          (ctfe-node-has-type-literal? expr-bases state init-box)])
      (ctfe-bindings-have-type-literal-at?
        expr-bases
        state
        bindings
        (+ index 1)))))

(define (ctfe-expr-has-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(TypeLiteral _) true]
    [(or (Literal _) (Var _) (Init _) (PtrNull _) (ProgramArgc) (ProgramArgv)
         (ProgramEnvp) (BinaryData _) (SpmdProgramIndex) (SpmdProgramCount))
      false]
    [(or (PtrAddrOf place) (Spanned place _) (MacroExpansion place _ _)
         (Unary _ place) (FixedMakeArray _ place) (MakeArray _ place)
         (Set _ place) (Ann place _) (Cast place _) (Borrow _ _ place)
         (StructGet place _) (Box place) (BoxGet place) (BoxTake place)
         (Comptime place) (Quote place) (Quasiquote place) (Unquote place)
         (UnquoteSplicing place) (Try place) (Return place) (PtrNullCheck place)
         (PtrRead place) (PtrCast place _) (PtrToInt place) (IntToPtr place _)
         (StringData place) (ArrayData place) (Xgetbv place)
         (ForeachActive _ place) (LaneValue place))
      (ctfe-node-has-type-literal? expr-bases state place)]
    [(Call func-box args)
      (if (ctfe-node-is-module-value-query? expr-bases state func-box)
        (ctfe_support.ctfe-module-value-reflection-enable-for-state!
          (tc-macro-ctfe-state state)
          true)
        unit)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? expr-bases state func-box)
        (ctfe-exprs-have-type-literal? expr-bases state args))]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items) (WithRegion _ items) (WithScratch items)
         (Syscall items))
      (ctfe-exprs-have-type-literal? expr-bases state items)]
    [(or (Binary _ l r) (TupleRef l r) (ArrayRef l r) (Replace l r)
         (ArrayPush l r) (StringRef l r) (StructSet l _ r) (BoxSet l r)
         (PtrWrite l r) (PtrOffset l r) (StringFromBytes l r) (CpuIdEax l r)
         (CpuIdEbx l r) (CpuIdEcx l r) (CpuIdEdx l r))
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? expr-bases state l)
        (ctfe-node-has-type-literal? expr-bases state r))]
    [(or (If c t e) (ArraySet c t e) (ArrayTake c t e))
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? expr-bases state c)
        (ctfe-reflection-prescan-or
          (ctfe-node-has-type-literal? expr-bases state t)
          (ctfe-node-has-type-literal? expr-bases state e)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body)
          (ctfe-reflection-prescan-or
            (ctfe-bindings-have-type-literal? expr-bases state bindings)
            (ctfe-node-has-type-literal? expr-bases state body))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda _ _ body) (ctfe-node-has-type-literal? expr-bases state body)])]
    [(or (While c b) (WithEscape c b) (InArena c b))
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? expr-bases state c)
        (ctfe-exprs-have-type-literal? expr-bases state b))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrut arms)
          (ctfe-reflection-prescan-or
            (ctfe-node-has-type-literal? expr-bases state scrut)
            (ctfe-arms-have-type-literal? expr-bases state arms))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ _ s e b)
          (ctfe-reflection-prescan-or
            (ctfe-node-has-type-literal? expr-bases state s)
            (ctfe-reflection-prescan-or
              (ctfe-node-has-type-literal? expr-bases state e)
              (ctfe-node-has-type-literal? expr-bases state b)))]
        [(Foreach2 _ _ a b _ _ c d body)
          (ctfe-reflection-prescan-or
            (ctfe-node-has-type-literal? expr-bases state a)
            (ctfe-reflection-prescan-or
              (ctfe-node-has-type-literal? expr-bases state b)
              (ctfe-reflection-prescan-or
                (ctfe-node-has-type-literal? expr-bases state c)
                (ctfe-reflection-prescan-or
                  (ctfe-node-has-type-literal? expr-bases state d)
                  (ctfe-node-has-type-literal? expr-bases state body)))))])]
    [_ true]))

(define (ctfe-decl-has-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(or (Def _ _ _ expr-box) (DefFn _ _ _ _ expr-box _) (Test _ expr-box _ _)
         (DefMacro _ _ _ _ expr-box))
      (ctfe-node-has-type-literal? expr-bases state expr-box)]
    [(Unsafe inner-box)
      (ctfe-decl-has-type-literal?
        expr-bases
        state
        (ast.ast-decl-box-shared-view inner-box))]
    [(ModuleBody _ body-box)
      (ctfe-program-has-type-literal?
        expr-bases
        state
        (ast.ast-decl-list-box-shared-view body-box))]
    [_ false]))

(define (ctfe-program-has-type-literal?
  [expr-bases : i64]
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (ctfe-reflection-prescan-or
        (ctfe-decl-has-type-literal? expr-bases state decl)
        (ctfe-program-has-type-literal? expr-bases state rest))]))

;; Reflection metadata only needs a refresh when a splice introduces a nominal
;; declaration. Keep ordinary expression/function splices on the shared CTFE
;; environment so the cache still avoids whole-program metadata walks.
(define (macro-decl-reflection-relevant? [decl : ast.AstDecl]) : bool
  (match decl
    [(or (DefEnum _ _ _ _) (DefEnumLifetimes _ _ _ _ _) (DefStruct _ _ _ _ _)
         (DefStructLifetimes _ _ _ _ _ _))
      true]
    [(Unsafe inner-box)
      (macro-decl-reflection-relevant? (ast.ast-decl-box-shared-view inner-box))]
    [(ModuleBody _ body-box)
      (macro-decls-reflection-relevant?
        (ast.ast-decl-list-box-shared-view body-box))]
    [_ false]))

(define (macro-decls-reflection-relevant? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (macro-decl-reflection-relevant? decl)
        (macro-decls-reflection-relevant? rest))]))

;; Whether a splice can change what a type name resolves to: it adds a nominal
;; type, an import alias, or a module row. Functions, globals and macros never
;; do, since type names resolve through the type namespace only.
(define (macro-decl-type-resolution-relevant? [decl : ast.AstDecl]) : bool
  (or
    (macro-decl-reflection-relevant? (tc-global-shared-view decl))
    (match decl
      [(or (Module _) (ModuleBody _ _) (Import _ _)) true]
      [(Unsafe inner-box)
        (macro-decl-type-resolution-relevant?
          (ast.ast-decl-box-shared-view inner-box))]
      [_ false])))

(define (macro-decls-type-resolution-relevant? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (macro-decl-type-resolution-relevant? decl)
        (macro-decls-type-resolution-relevant? rest))]))

;; A forced splice installs the current live symbols/registries in a new
;; context. Generated modules append to those tables; arbitrary splices and
;; materialized files rebuild them. Every top-env plan is additive: it revisits
;; only cached signatures that remain unresolved, binds the splice delta, and
;; publishes one explicit cache layer. Generated modules add their isolated
;; summary and marker through the same contract. `module` is the active
;; namespace at the splice site.
(define (tc-top-env-binding-context [ctx : TcContext] [name-id : i64]) : TcContext
  (if (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)
    (let
      [module-id : i64 (tc-qualified-name-module-id name-id)]
      (if (>= module-id 0)
        (tc-context-with-module-id
          ctx
          (tc-env-key-name-text module-id)
          module-id)
        ctx))
    (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))

;; A splice updates symbols before it updates the type env. Final
;; nominal/scalar bindings cannot change; only signatures that still contain
;; Var/VarArgs nodes are candidates. Every cache records that candidate set at
;; construction, and this walk compacts it in place as names become resolvable.
;; The fixed-width scan is proportional to unresolved signatures, never the
;; retained top-env spine or source tail. A layer already re-resolved at the
;; current resolution generation is skipped: most splices add only functions,
;; and signatures waiting for a later generated import would otherwise be
;; re-resolved at every splice before it.
(define (tc-top-env-reresolve-cache-node!
  [ctx : TcContext]
  [cache-ptr : (Ptr TcTypeEnvCache)]) : i64
  (let
    [cache : TcTypeEnvCache
      (unsafe
        (ptr-read cache-ptr))]
    [ids : tc_i64_i64_map.Map cache.ids]
    [values : (__tl_dyn-array ast.AstType) cache.values]
    [sidecar : (__tl_dyn-array i64) cache.unsafe-flags]
    [capacity : i64 (array-length values)]
    [count : i64 (array-ref sidecar capacity)]
    [stamp-slot : i64 (- (array-length sidecar) 1)]
    ;; Captured first: a resolution that itself changes an input leaves the
    ;; layer stale for the next pass.
    [generation : i64 tc-top-env-resolution-generation]
    [read-index : i64 0]
    [write-index : i64 0]
    (when (= (array-ref sidecar stamp-slot) generation) (return count))
    (while (< read-index count)
      (let
        [name-id : i64 (array-ref sidecar (+ capacity 1 read-index))]
        [value-slot : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (and (>= value-slot 0) (< value-slot (array-length values)))
          (let
            [before : ast.AstType
              (tc-global-array-element-shared-view values value-slot)]
            (if (tc-type-needs-resolution-for-context?
              ctx
              (tc-global-shared-view before))
              (let
                [binding-ctx : TcContext
                  (tc-top-env-binding-context ctx name-id)]
                [after : ast.AstType
                  (tc-resolve-type binding-ctx (tc-global-shared-view before))]
                (begin
                  (cfg
                    compile-profile
                    (compiler-tc-macro-profile-metric-add!
                      (tc-context-macro-state ctx)
                      tc-profile-splice-env-reresolve-candidates
                      1))
                  (if (ast.ast-type-eq? before (tc-global-shared-view after))
                    unit
                    (begin
                      (set! (array-ref values value-slot) after)
                      (cfg
                        compile-profile
                        (compiler-tc-macro-profile-metric-add!
                          (tc-context-macro-state ctx)
                          tc-profile-splice-env-reresolve-updates
                          1))))
                  (when
                    (tc-type-needs-resolution-for-context? ctx after)
                    (set!
                      (array-ref sidecar (+ capacity 1 write-index))
                      name-id)
                    (set! write-index (+ write-index 1)))))
              unit))
          (io.panic
            (str_cat.str-cat
              "typecheck: top-env resolution slot out of bounds: "
              (string.int->string value-slot)
              " / "
              (string.int->string (array-length values)))))
        (set! read-index (+ read-index 1))))
    (set! (array-ref sidecar capacity) write-index)
    (set! (array-ref sidecar stamp-slot) generation)
    write-index))

(define (tc-top-env-reresolve-caches! [ctx : TcContext] [env : TcTypeEnv]) : unit
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [done : bool false]
    (begin
      (cfg
        compile-profile
        (compiler-tc-macro-profile-metric-add!
          (tc-context-macro-state ctx)
          tc-profile-splice-env-reresolve-calls
          1))
      ;; A batch of consecutive module markers can leave a small raw prefix.
      ;; Skip it to the first explicit layer, then follow only partial `below`
      ;; links, exactly like the lookup chain being invalidated.
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(>= head 0)
            (set!
              head
              (tc-type-env-binding-parent-at
                (tc-type-env-binding-ptr store-handle head)))]
          [else
            (let
              [cache-ptr : (Ptr TcTypeEnvCache)
                (unsafe
                  (int->ptr
                    (cast (tc-type-env-cache-index head) : u64)
                    : (Ptr TcTypeEnvCache)))]
              [cache : TcTypeEnvCache
                (unsafe
                  (ptr-read (ptr-cast cache-ptr : (Ptr TcTypeEnvCache))))]
              (tc-top-env-reresolve-cache-node! ctx cache-ptr)
              (if cache.partial
                (set! head cache.below)
                (set! done true)))])))))

(define (tc-extend-top-env-for-splice
  [ctx : TcContext]
  [base-env : TcTypeEnv]
  [splice : ast.AstDeclList]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (tc-top-env-reresolve-caches! ctx base-env)
  (let
    [splice-env : TcTypeEnv
      (try
        (tc-build-top-env-list-explicit-in-module
          ctx
          splice
          base-env
          module
          module-id))]
    (Ok (tc-env-with-cache-layer-over-explicit splice-env))))

(define (macro-splice-top-env
  [ctx : TcContext]
  [_program : ast.AstProgram]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [plan : MacroSpliceEnvPlan]) : ResultTcEnv
  (match plan
    [(Extend base-env splice)
      (if (macro-decls-type-resolution-relevant? (tc-global-shared-view splice))
        (tc-top-env-resolution-inputs-changed!)
        unit)
      (tc-extend-top-env-for-splice ctx base-env splice module module-id)]
    [(ExtendGeneratedModule base-env summary marker)
      (let
        [module-env : TcTypeEnv
          (try (env-extend-with-module ctx base-env summary))]
        [marker-env : TcTypeEnv
          (try
            (macro-extend-top-env-with-module-marker
              ctx
              module-env
              decls
              marker
              module
              module-id))]
        ;; The marker records a named lazy-import surface before old
        ;; unresolved signatures are revisited. The combined summary
        ;; + marker prefix is then cached once.
        (tc-top-env-reresolve-caches! ctx marker-env)
        (Ok (tc-env-with-cache-layer-over-explicit marker-env)))]))

(define (macro-expand-rebuild-context-for-splice
  [cur-ctx : TcContext]
  [next-decls : ast.AstDeclList]
  [next-paths : ast.AstDeclPathList]
  [module : String]
  [module-id : i64]
  [env-plan : MacroSpliceEnvPlan]) : ResultMacroSpliceRebuild
  (let
    [state : TcMacroState (tc-context-macro-state cur-ctx)]
    [pools : ast.AstNodePoolContext (tc-context-pools cur-ctx)]
    [reuse-segmented? : bool
      (and
        (tc-macro-walk-field state macro-live-symbols-ready)
        (not (tc-macro-walk-field state macro-live-symbols-fallback))
        (tc-macro-walk-field state macro-live-registries-ready)
        (not (tc-macro-walk-field state macro-live-registries-fallback)))]
    [next-program : ast.AstProgram
      (if reuse-segmented?
        (tc-context-program cur-ctx)
        (macro-expand-scratch-program state (tc-global-shared-view next-decls)))]
    ;; Existing symbol handles and their cached owner names remain stable
    ;; across an append-only splice. The one-entry type lookup also caches a
    ;; missing result, so additions invalidate that entry alone. Cloneability
    ;; is reset at expansion entry and populated only after expansion; a
    ;; per-splice reset cannot change its state.
    (tc-resolve-type-name-cache-reset-for-state!
      (tc-job-state-nominal-cache (tc-context-job-state cur-ctx)))
    ;; Program-position and import-derived alias indexes can contain negative
    ;; answers and refer to the replaced flat program view. Keep their shared
    ;; invalidation until they gain an insert API of their own. A reused
    ;; segmented context keeps its flat program, and with it the module decl
    ;; index.
    (if reuse-segmented?
      (macro-import-derived-cache-reset-for-state! state)
      (macro-alias-derived-cache-reset-for-state! state))
    (tc-job-state-reset-derived-caches! (tc-context-job-state cur-ctx))
    ;; Do not reset ctfe-module-macro-export here: the export set is stable
    ;; across the splice (additive-inert) and is owned by macro-live-prescan-
    ;; ensure!, which repopulates it when the prescan is recomputed. Clearing it
    ;; here would leave module-hook / module-export-macro? with an empty map for
    ;; the spliced tail's expansion.
    (match (macro-live-symbols-build-or-reuse!
      state
      (tc-global-shared-view next-program)
      (tc-global-shared-view next-paths))
      [(Ok next-symbols)
        (let
          [next-registries : csym.CompilerRegistries
            (macro-live-registries-shared-view state)]
          [next-ctx : TcContext
            (tc-context-new-with-source-names-and-body-state
              (tc-global-shared-view next-program)
              next-symbols
              next-registries
              ""
              cbi.compiler-builtin-id-fix-empty
              pools
              (tc-context-source-names cur-ctx)
              (tc-context-body-state cur-ctx)
              (tc-context-semantic-observer cur-ctx))]
          [_definition-paths : unit
            (macro-definition-paths-index! next-ctx next-decls next-paths)]
          (tc-macro-walk-set! state macro-expand-active-module "")
          (macro-expand-set-macro-names!
            state
            (tc-macro-walk-field state macro-live-prescan-visible-names))
          (match (tc-stdlib-comptime-surface-ok-for-macro next-ctx)
            [(Ok)
              (match (macro-splice-top-env
                next-ctx
                next-program
                next-decls
                (tc-global-shared-view module)
                module-id
                env-plan)
                [(Ok top-env)
                  (tc-hygiene-reset-active-top-env! state top-env)
                  (tc-context-capture-active-pools! next-ctx)
                  (macro-expand-ctfe-env-build-once! next-ctx)
                  ;; The replacement context, top env, CTFE env, hygiene
                  ;; top env, and active pools are now complete. No value
                  ;; returned to the continuing walk refers to the
                  ;; replaced symbol/registry generation.
                  (macro-live-symbols-reclaim-retired! state)
                  (Ok
                    (tc-context-with-module-id next-ctx module module-id)
                    top-env)]
                [(Err message) (Err (box (tc-diag-at-start message)))])]
            [(Err message) (Err (box (tc-diag-at-start message)))]))]
      [(Err message)
        (Err (box (csym.compiler-symbols-last-error-diagnostic message)))])))

(define (macro-decl-generated-normal-import? [decl : ast.AstDecl]) : bool
  (match (macro-generated-normal-import decl)
    [(Some _ _ _ _ _ _) true]
    [(No) false]))

;; The single demand-driven expansion walk. Every macro placeholder is expanded
;; and its splice forced inline: the walk rebuilds the whole-program
;; symbols/env over the spliced view (macro-expand-rebuild-context-for-splice)
;; and then continues over the spliced body itself, so nested placeholders and
;; module placeholders resolve in this same pass. Generated *file* imports (a
;; generated module body importing a source file, or a generated module import
;; of a not-yet-loaded module) are loaded inline through the threaded loader
;; context (stdlib-roots + cfgs) -- there is no deferred
;; fallback pass and no follow-up worklist.
(define (macro-expand-decls
  [load-state : cload.CompilerLoadSessionState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [module : String]
  [module-id : i64]
  [can-share : bool]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [initial-materialize-seen : sym_i64_env.SymI64Env]
  [initial-out-rev : ast.AstDeclList]
  [initial-out-paths-rev : ast.AstDeclPathList]) : ResultMacroDeclsWithPaths
  (let
    ;; Generated file imports need the loader's duplicate-path/module set.
    ;; Seed it once, then extend it with each macro splice and loader result;
    ;; rebuilding it from the whole expanded program per import retained tens
    ;; of megabytes of obsolete persistent-env bindings.
    [cur-materialize-seen : sym_i64_env.SymI64Env initial-materialize-seen]
    ;; A new walk resolves over a new program: no earlier stamp may hold.
    [_resolution-inputs : unit (tc-top-env-resolution-inputs-changed!)]
    [walk-state : TcJobState (tc-context-job-state ctx)]
    [macro-state : TcMacroState (tc-job-state-macro-state walk-state)]
    [cur-module : String module]
    [cur-module-id : i64 module-id]
    [cur-orig-decls : ast.AstDeclList orig-decls]
    [cur-ctx : TcContext ctx]
    [cur-top-env : TcTypeEnv top-env]
    [cur-can-share : bool can-share]
    [out-rev : ast.AstDeclList initial-out-rev]
    [out-paths-rev : ast.AstDeclPathList initial-out-paths-rev]
    [result : ResultMacroDeclsWithPaths
      (Err (box (tc-diag-at-start "macro: internal decl expansion walk")))]
    [done : bool false]
    (macro-segmented-program-begin!
      walk-state
      (tc-global-shared-view out-rev)
      (tc-global-shared-view out-paths-rev)
      decls
      paths)
    (while (not done)
      (begin
        (cfg compile-profile (compiler-tc-walk-decl-sample-flush!))
        (match (if (macro-segmented-program-empty? walk-state)
          (ast.AstDeclListStep.Nil)
          (ast.AstDeclListStep.Cons
            (macro-segmented-program-current-decl walk-state)
            (ast.ast-decl-list-new)))
          [(Nil)
            (let
              [final-decls : ast.AstDeclList
                (macro-decl-list-reverse (tc-global-shared-view out-rev))]
              [final-paths : ast.AstDeclPathList
                (macro-decl-path-list-reverse
                  (tc-global-shared-view out-paths-rev))]
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-metric-add!
                    macro-state
                    tc-profile-segment-final-flattens
                    1))
                (set! result (Ok final-decls final-paths))
                (set! done true)))]
          [(Cons decl _rest)
            (let
              [decl-path : String
                (macro-segmented-program-current-path walk-state)]
              [decl-owner-id : i64
                (macro-segmented-program-current-owner-id walk-state)]
              [decl-provenance-id : i64
                (macro-segmented-program-current-provenance-id walk-state)]
              [_set-decl-owner : unit
                (tc-macro-walk-set!
                  macro-state
                  macro-active-decl-owner-id
                  decl-owner-id)]
              [_set-decl-provenance : unit
                (tc-macro-walk-set!
                  macro-state
                  macro-active-decl-provenance-id
                  decl-provenance-id)]
              (match (tc-global-shared-view decl)
                [(Module next-module)
                  (begin
                    (cfg compile-profile (compiler-tc-walk-decl-sample-note! 1))
                    (set!
                      out-rev
                      (macro-segmented-program-prepend-current
                        walk-state
                        out-rev))
                    (set!
                      out-paths-rev
                      (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
                        decl-path
                        decl-owner-id
                        decl-provenance-id
                        out-paths-rev))
                    (macro-segmented-program-advance! walk-state)
                    (macro-segmented-program-prefix-set!
                      walk-state
                      out-rev
                      out-paths-rev)
                    (set! cur-module (tc-env-key-name-text next-module))
                    (set! cur-module-id next-module))]
                [_
                  (cond
                    [(macro-decl-import-placeholder?
                        (tc-global-shared-view decl))
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-walk-decl-sample-note! 3))
                        ;; R3-P2b: an import placeholder's expansion is
                        ;; the single largest allocator in the splice
                        ;; family. Run it in its
                        ;; own generation, on the SPLICE ring -- see
                        ;; macro-splice-generation-enter! for why the ring,
                        ;; and not R3-P1's batch ring, is the sound one.
                        (match (macro-expand-decl-with-path-splice-generational
                          cur-ctx
                          cur-top-env
                          cur-top-env
                          (tc-global-shared-view cur-orig-decls)
                          (tc-global-shared-view cur-module)
                          cur-module-id
                          (tc-global-shared-view decl)
                          cfgs
                          decl-path)
                          [(Ok expanded expanded-paths)
                            ;; A deduplicated splice (see
                            ;; macro-decls-splice-with-memo) expands to nothing:
                            ;; drop the placeholder and keep walking -- there is
                            ;; no new name, so no context rebuild is needed.
                            (match (ast.ast-decl-list-step expanded)
                              [(Nil)
                                (macro-segmented-program-advance! walk-state)]
                              [_
                                (if (and
                                  (macro-decl-module-import-placeholder? decl)
                                  (macro-module-import-marker-only?
                                    (tc-global-shared-view expanded)))
                                  (let
                                    [_update-materialize-seen : unit
                                      (set!
                                        cur-materialize-seen
                                        (macro-materialize-seen-from
                                          (& expanded)
                                          (& expanded-paths)
                                          cur-materialize-seen
                                          cur-module-id))]
                                    [_segment-splice : unit
                                      (macro-segmented-program-splice-current!
                                        walk-state
                                        (tc-global-shared-view expanded)
                                        (tc-global-shared-view expanded-paths))]
                                    [_commit-marker-prefix : unit
                                      (let
                                        [remaining : i64
                                          (ast.ast-decl-list-len (& expanded))]
                                        (set!
                                          out-rev
                                          (macro-decl-list-reverse-into
                                            (tc-global-shared-view expanded)
                                            out-rev))
                                        (set!
                                          out-paths-rev
                                          (macro-decl-path-list-reverse-into
                                            expanded-paths
                                            out-paths-rev))
                                        (while (> remaining 0)
                                          (macro-segmented-program-advance!
                                            walk-state)
                                          (set! remaining (- remaining 1)))
                                        (macro-segmented-program-prefix-set!
                                          walk-state
                                          out-rev
                                          out-paths-rev))]
                                    ;; Consecutive markers can share one raw
                                    ;; delta prefix. Lookups still see every
                                    ;; imported binding, but the explicit cache
                                    ;; and unresolved-signature pass are paid
                                    ;; once when the marker batch ends.
                                    [defer-cache? : bool
                                      (macro-segmented-program-current-starts-module-import-placeholder?
                                        walk-state)]
                                    (match (let
                                      [extend-result : ResultTcEnv
                                        (macro-extend-top-env-with-module-marker
                                          cur-ctx
                                          cur-top-env
                                          (tc-global-shared-view cur-orig-decls)
                                          expanded
                                          (tc-global-shared-view cur-module)
                                          cur-module-id)]
                                      extend-result)
                                      [(Ok next-top-env)
                                        (tc-nominal-owner-cache-reset-for-job!
                                          (tc-context-job-state cur-ctx))
                                        ;; The marker changes only the
                                        ;; segmented view, not cur-ctx's
                                        ;; flat program.
                                        (macro-import-derived-cache-reset-for-state!
                                          macro-state)
                                        (tc-job-state-reset-derived-caches!
                                          (tc-context-job-state cur-ctx))
                                        (if defer-cache?
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-decl-sample-note!
                                                4))
                                            (set! cur-top-env next-top-env))
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-decl-sample-note!
                                                5))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-reresolve-start!))
                                            (tc-top-env-reresolve-caches!
                                              cur-ctx
                                              next-top-env)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-reresolve-finish!))
                                            (set!
                                              cur-top-env
                                              (tc-env-with-cache-layer-over-explicit
                                                next-top-env))))
                                        unit]
                                      [(Err message)
                                        (set!
                                          result
                                          (Err (box (tc-diag-at-start message))))
                                        (set! done true)])
                                    unit)
                                  ;; Force the splice inline: append the generated
                                  ;; symbols/registries and rebuild the context over
                                  ;; the spliced whole-program view. The top env takes
                                  ;; only the declaration delta, then the walk continues
                                  ;; over the spliced body itself (nested placeholders
                                  ;; and generated file imports included).
                                  (let
                                    [_update-materialize-seen : unit
                                      (set!
                                        cur-materialize-seen
                                        (macro-materialize-seen-from
                                          (& expanded)
                                          (& expanded-paths)
                                          cur-materialize-seen
                                          cur-module-id))]
                                    [_segment-splice : unit
                                      (macro-segmented-program-splice-current!
                                        walk-state
                                        (tc-global-shared-view expanded)
                                        (tc-global-shared-view expanded-paths))]
                                    [generated-ext : MacroMaybeGeneratedModuleExtension
                                      (macro-generated-module-extension
                                        macro-state
                                        (tc-global-shared-view expanded)
                                        cur-module-id)]
                                    [symbols-inserted : bool
                                      (and
                                        (csym.compiler-symbols-insert-aliases-self-contained?
                                          (tc-global-shared-view expanded)
                                          (tc-global-shared-view expanded))
                                        (macro-live-symbols-insert-decls!
                                          (tc-context-macro-state cur-ctx)
                                          (tc-global-shared-view expanded)
                                          cur-module-id))]
                                    [registries-inserted : bool
                                      (and
                                        symbols-inserted
                                        (macro-live-registries-append-decls!
                                          (tc-context-macro-state cur-ctx)
                                          (tc-global-shared-view expanded)
                                          (tc-global-shared-view expanded-paths)
                                          cur-module-id))]
                                    [incremental? : bool
                                      (and symbols-inserted registries-inserted)]
                                    [_invalidate-fallback : unit
                                      (unless
                                        incremental?
                                        (macro-live-symbols-invalidate!
                                          (tc-context-macro-state cur-ctx))
                                        (macro-live-registries-invalidate!
                                          (tc-context-macro-state cur-ctx)))]
                                    [flat-view : MacroSegmentedProgramFlatView
                                      (if incremental?
                                        (MacroSegmentedProgramFlatView
                                          (tc-global-shared-view expanded)
                                          (tc-global-shared-view expanded-paths))
                                        (macro-segmented-program-flatten-fallback
                                          walk-state
                                          1))]
                                    [next-decls : ast.AstDeclList
                                      flat-view.decls]
                                    [next-paths : ast.AstDeclPathList
                                      flat-view.paths]
                                    [_prescan-delta : unit
                                      (if incremental?
                                        (macro-live-prescan-append-decls!
                                          macro-state
                                          (tc-global-shared-view expanded)
                                          cur-module-id)
                                        unit)]
                                    ;; Any reflection-relevant delta gets the
                                    ;; append-safety classification after the
                                    ;; post-splice registries exist. Fresh
                                    ;; ordinary Decls and generated Modules can
                                    ;; therefore share the same O(delta) path.
                                    [extend-ctfe-metadata? : bool
                                      (macro-decls-reflection-relevant?
                                        (tc-global-shared-view expanded))]
                                    [ctfe-build-generation-before : i64
                                      (tc-macro-walk-field
                                        macro-state
                                        macro-expand-ctfe-env-build-generation)]
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-tc-walk-decl-sample-note! 6))
                                      (cfg
                                        compile-profile
                                        (if incremental?
                                          unit
                                          (compiler-tc-macro-profile-metric-add!
                                            macro-state
                                            tc-profile-splice-registry-invalidated
                                            1))
                                        unit)
                                      ;; Generated Module catalogs are usually
                                      ;; inert additions, but a full catalog can
                                      ;; legitimately introduce a defmacro. Its
                                      ;; name must be visible to the remaining
                                      ;; declarations in this same expansion
                                      ;; walk (for example `api.one` immediately
                                      ;; after `(import (catalog) as api)`).
                                      ;; Refresh the otherwise additive-inert
                                      ;; prescan before rebuilding the splice
                                      ;; context so the macro-name gate and CTFE
                                      ;; export map include that generated macro.
                                      (when
                                        (macro-program-has-defmacro?
                                          (tc-global-shared-view expanded))
                                        (unless
                                          incremental?
                                          (macro-live-prescan-reset!
                                            macro-state)
                                          (macro-live-prescan-ensure!
                                            macro-state
                                            (tc-global-shared-view next-decls))
                                          (macro-expand-set-expr-type-macro-names!
                                            macro-state
                                            (tc-macro-walk-field
                                              macro-state
                                              macro-live-prescan-expr-type-names)))
                                        (tc-macro-walk-set!
                                          macro-state
                                          ctfe-needs-metadata
                                          (or
                                            (tc-macro-walk-field
                                              macro-state
                                              ctfe-needs-metadata)
                                            (tc-macro-walk-field
                                              macro-state
                                              macro-live-prescan-has-defmacro)))
                                        unit)
                                      (match (macro-expand-rebuild-context-for-splice
                                        cur-ctx
                                        (tc-global-shared-view next-decls)
                                        next-paths
                                        (tc-global-shared-view cur-module)
                                        cur-module-id
                                        (match (tc-global-shared-view
                                          generated-ext)
                                          [(No)
                                            (Extend
                                              cur-top-env
                                              (tc-global-shared-view expanded))]
                                          [(Some summary marker)
                                            (ExtendGeneratedModule
                                              cur-top-env
                                              summary
                                              marker)]))
                                        [(Ok next-ctx next-top-env)
                                          ;; Extend the reused CTFE metadata
                                          ;; with the spliced module's nominal
                                          ;; declarations now that next-ctx
                                          ;; carries the post-splice registries
                                          ;; the layout build resolves through.
                                          ;; On any inapplicability fall back to
                                          ;; the established clear, which makes
                                          ;; the next consumer rebuild the full
                                          ;; metadata over the spliced program.
                                          (if extend-ctfe-metadata?
                                            (match (compiler-typecheck-ctfe-env-extend-for-splice!
                                              next-ctx
                                              expanded
                                              expanded-paths
                                              (tc-global-shared-view cur-module)
                                              cur-module-id
                                              (match generated-ext
                                                [(Some _ _) true]
                                                [(No) false])
                                              (csym.compiler-registries-shared-view
                                                (tc-context-registries next-ctx))
                                              ctfe-build-generation-before)
                                              [(or (SemanticRejected)
                                                   (CacheUnavailable))
                                                (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                                  next-ctx
                                                  1)]
                                              [_ unit])
                                            unit)
                                          (set! cur-ctx next-ctx)
                                          (if incremental?
                                            unit
                                            (set! cur-orig-decls next-decls))
                                          (set! cur-top-env next-top-env)
                                          unit]
                                        [(Err diag)
                                          (set! result (Err diag))
                                          (set! done true)])
                                      unit)))])]
                          [(Err diag)
                            (set! result (Err diag))
                            (set! done true)]))]
                    [(macro-decl-generated-normal-import?
                        (tc-global-shared-view decl))
                      ;; A generated module body imports a source file (or a
                      ;; not-yet-loaded module). Load it inline with the
                      ;; threaded loader context, refresh the hoisted prescan
                      ;; (the loaded file may define macros the rest of this
                      ;; walk must see and fire), rebuild the live symbols over
                      ;; the loaded view, extend the current top environment
                      ;; with the newly loaded declarations, and continue the
                      ;; walk over the loaded content -- what the retired fixed-
                      ;; point loop's materialization + re-pass did, inline in
                      ;; this pass. Source-file materialization that loads new
                      ;; declarations remains a full symbol/registry rebuild
                      ;; because it can add arbitrary index-bearing
                      ;; declarations; the environment itself is additive and
                      ;; can use the same refresh path as a macro splice instead
                      ;; of retaining another whole-program env.
                      (begin
                        (macro-expand-program-structural-change-note!
                          macro-state
                          4)
                        (cfg
                          compile-profile
                          (compiler-tc-walk-decl-sample-note! 7))
                        (let
                          ;; Keep the pools context's captured state current
                          ;; around the loader: it parses new content into the
                          ;; active pools, and a later install of a stale capture
                          ;; would roll the pool length back and let subsequent
                          ;; allocations overwrite the loaded (and previously
                          ;; spliced) nodes.
                          [_capture-before-load : unit
                            (tc-context-capture-active-pools! cur-ctx)]
                          (match (macro-materialize-generated-import-with-provenance
                            (tc-global-shared-view load-state)
                            decl
                            decl-path
                            decl-owner-id
                            decl-provenance-id
                            (tc-global-shared-view cur-module)
                            cur-module-id
                            cur-materialize-seen
                            (tc-global-shared-view stdlib-roots)
                            cfgs
                            (tc-context-pools cur-ctx))
                            [(Ok
                                materialized-decls
                                materialized-paths
                                next-materialize-seen)
                              (let
                                [_install-after-load : unit
                                  (tc-context-install-pools! cur-ctx)]
                                [_segment-splice : unit
                                  (macro-segmented-program-splice-current!
                                    walk-state
                                    (tc-global-shared-view materialized-decls)
                                    (tc-global-shared-view materialized-paths))]
                                ;; An import of an already-loaded module loads
                                ;; nothing: it materializes only its alias
                                ;; markers, which take the same incremental
                                ;; symbol/registry append as a macro splice.
                                ;; Any other source-file materialization is the
                                ;; explicit conservative fallback: arbitrary
                                ;; aliases and index-bearing declarations
                                ;; require fresh whole-program symbols and
                                ;; registries.
                                [symbols-inserted : bool
                                  (and
                                    (macro-decls-imports-only?
                                      (tc-global-shared-view materialized-decls))
                                    (csym.compiler-symbols-insert-aliases-self-contained?
                                      (tc-global-shared-view materialized-decls)
                                      (tc-global-shared-view materialized-decls))
                                    (macro-live-symbols-insert-decls!
                                      (tc-context-macro-state cur-ctx)
                                      (tc-global-shared-view materialized-decls)
                                      cur-module-id))]
                                [incremental? : bool
                                  (and
                                    symbols-inserted
                                    (macro-live-registries-append-decls!
                                      (tc-context-macro-state cur-ctx)
                                      (tc-global-shared-view materialized-decls)
                                      (tc-global-shared-view materialized-paths)
                                      cur-module-id))]
                                [flat-view : MacroSegmentedProgramFlatView
                                  (if incremental?
                                    (MacroSegmentedProgramFlatView
                                      (tc-global-shared-view materialized-decls)
                                      (tc-global-shared-view materialized-paths))
                                    (macro-segmented-program-flatten-fallback
                                      walk-state
                                      2))]
                                [next-decls : ast.AstDeclList flat-view.decls]
                                [next-paths : ast.AstDeclPathList
                                  flat-view.paths]
                                [extend-ctfe-metadata? : bool
                                  (macro-decls-reflection-relevant?
                                    (tc-global-shared-view materialized-decls))]
                                [ctfe-build-generation-before : i64
                                  (tc-macro-walk-field
                                    macro-state
                                    macro-expand-ctfe-env-build-generation)]
                                (begin
                                  (set!
                                    cur-materialize-seen
                                    next-materialize-seen)
                                  (cfg
                                    compile-profile
                                    (if incremental?
                                      (counters.bump!
                                        tc-profile-segment-incremental-imports)
                                      unit)
                                    unit)
                                  (if incremental?
                                    (macro-live-prescan-append-decls!
                                      macro-state
                                      (tc-global-shared-view materialized-decls)
                                      cur-module-id)
                                    (begin
                                      ;; The loaded file may add defmacros or
                                      ;; expr-type macros: recompute the hoisted
                                      ;; prescan over the new whole-program view
                                      ;; before the context rebuild consumes its
                                      ;; visible-name set.
                                      (macro-live-symbols-invalidate!
                                        (tc-context-macro-state cur-ctx))
                                      ;; Source-file materialization can insert
                                      ;; any index-bearing declaration or alias
                                      ;; surface, so retain the full registry
                                      ;; rebuild even when it contains no
                                      ;; nominal declaration.
                                      (macro-live-registries-invalidate!
                                        (tc-context-macro-state cur-ctx))
                                      (macro-live-prescan-ensure!
                                        macro-state
                                        (tc-global-shared-view next-decls))
                                      (macro-expand-set-expr-type-macro-names!
                                        macro-state
                                        (tc-macro-walk-field
                                          macro-state
                                          macro-live-prescan-expr-type-names))
                                      (tc-macro-walk-set!
                                        macro-state
                                        ctfe-needs-metadata
                                        (or
                                          (tc-macro-walk-field
                                            macro-state
                                            ctfe-needs-metadata)
                                          (tc-macro-walk-field
                                            macro-state
                                            macro-live-prescan-has-defmacro)))))
                                  (match (macro-expand-rebuild-context-for-splice
                                    cur-ctx
                                    (tc-global-shared-view next-decls)
                                    next-paths
                                    (tc-global-shared-view cur-module)
                                    cur-module-id
                                    (Extend
                                      cur-top-env
                                      (tc-global-shared-view materialized-decls)))
                                    [(Ok next-ctx next-top-env)
                                      (if extend-ctfe-metadata?
                                        (match (compiler-typecheck-ctfe-env-extend-for-splice!
                                          next-ctx
                                          materialized-decls
                                          materialized-paths
                                          (tc-global-shared-view cur-module)
                                          cur-module-id
                                          false
                                          (csym.compiler-registries-shared-view
                                            (tc-context-registries next-ctx))
                                          ctfe-build-generation-before)
                                          [(or (SemanticRejected)
                                               (CacheUnavailable))
                                            (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                              next-ctx
                                              2)]
                                          [_ unit])
                                        unit)
                                      (set! cur-ctx next-ctx)
                                      (if incremental?
                                        unit
                                        (set! cur-orig-decls next-decls))
                                      (set! cur-top-env next-top-env)
                                      unit]
                                    [(Err diag)
                                      (set! result (Err diag))
                                      (set! done true)])))]
                            [(Err diag)
                              (set! result (Err diag))
                              (set! done true)])))]
                    [(and
                        cur-can-share
                        (macro-decl-cannot-fire-gate?
                          macro-state
                          (tc-context-expr-bases cur-ctx)
                          (tc-global-shared-view decl)))
                      ;; Predict-skip: a macro-free value decl can never fire a
                      ;; macro, so share it unchanged (like the AstDecl.Module
                      ;; arm) instead of copying it through the expander. This
                      ;; avoids the per-decl `tc-context-with-module` allocation
                      ;; and the single-element relist that
                      ;; `macro-expand-decl-with-path` would otherwise retain in
                      ;; the installed pools. A non-module value decl never
                      ;; changes the active module, so `cur-module` is unchanged.
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-walk-decl-sample-note! 1))
                        (set!
                          out-rev
                          (macro-segmented-program-prepend-current
                            walk-state
                            out-rev))
                        (set!
                          out-paths-rev
                          (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
                            decl-path
                            decl-owner-id
                            decl-provenance-id
                            out-paths-rev))
                        (macro-segmented-program-advance! walk-state)
                        (macro-segmented-program-prefix-set!
                          walk-state
                          out-rev
                          out-paths-rev))]
                    [else
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-walk-decl-sample-note! 2))
                        ;; R3-P1: this is the only arm that runs a macro over
                        ;; a declaration body, and its superseded intermediate
                        ;; forms are the macro arena's dominant owner. Expand
                        ;; it in its own generation and commit the survivor.
                        (match (match (macro-env-for-module
                          cur-ctx
                          cur-top-env
                          (tc-global-shared-view cur-module)
                          cur-module-id)
                          [(Ok local-env)
                            (macro-expand-decl-with-path-generational
                              cur-ctx
                              cur-top-env
                              local-env
                              (tc-global-shared-view cur-orig-decls)
                              (tc-global-shared-view cur-module)
                              cur-module-id
                              decl
                              cfgs
                              decl-path)]
                          [(Err message)
                            (ResultMacroDeclExpansion.Err
                              (box
                                (tc-decl-diag
                                  (tc-context-expr-bases cur-ctx)
                                  decl
                                  message)))])
                          [(Ok expanded expanded-paths)
                            (macro-segmented-program-register-current-origin!
                              walk-state
                              (& expanded))
                            (set!
                              out-rev
                              (macro-decl-list-reverse-into
                                (tc-global-shared-view expanded)
                                out-rev))
                            (set!
                              out-paths-rev
                              (macro-decl-path-list-reverse-into
                                expanded-paths
                                out-paths-rev))
                            (set!
                              cur-module-id
                              (macro-decls-final-module-id
                                expanded
                                cur-module-id))
                            (set!
                              cur-module
                              (macro-decl-module-display cur-module-id))
                            (macro-segmented-program-advance! walk-state)
                            (macro-segmented-program-prefix-set!
                              walk-state
                              out-rev
                              out-paths-rev)]
                          [(Err diag)
                            (set! result (Err diag))
                            (set! done true)]))])]))])))
    (macro-segmented-program-end! walk-state)
    result))

(define (macro-expr-needs-compat-expansion?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [when-id : i64]
  [unless-id : i64]) : bool
  ;; One walk matching both ids; per-Var comparison is the exact id form of
  ;; the two string-keyed walks it replaces (see tc-env-key-source-id-or-neg).
  (tc-expr-uses-free-source-id? session expr-bases expr when-id unless-id Nil))

(define (macro-decl-needs-expansion?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [when-id : i64]
  [unless-id : i64]) : bool
  (match decl
    [(Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases expr-box)]
        (macro-expr-needs-compat-expansion?
          session
          expr-bases
          expr
          when-id
          unless-id))]
    [(DefFn decl-meta _ _ _ body-box _)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (macro-expr-needs-compat-expansion?
          session
          expr-bases
          body
          when-id
          unless-id))]
    [(DefMacro decl-meta _ _ _ _) true]
    [(Test _ _ _ _) false]
    [(Import decl-meta (Spec kind _ _ _ _))
      (match kind
        [(or (Macro _ _) (MacroDecls _ _)) true]
        [_ false])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (macro-decl-needs-expansion? session expr-bases inner when-id unless-id))]
    [_ false]))

(define (macro-decl-has-defmacro? [decl : ast.AstDecl]) : bool
  (match decl
    [(DefMacro decl-meta _ _ _ _) true]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (macro-decl-has-defmacro? inner))]
    [_ false]))

;; Whether a program needs the macro expansion pass. The when/unless intern
;; ids are found once per scan and threaded through the per-declaration
;; prescan.
(define (macro-program-needs-expansion?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [decls : ast.AstDeclList]) : bool
  (macro-program-needs-expansion-with-ids?
    session
    expr-bases
    decls
    (ci.intern "when")
    (ci.intern "unless")))

(define (macro-program-needs-expansion-with-ids?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [when-id : i64]
  [unless-id : i64]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (or
          (macro-decl-needs-expansion?
            session
            expr-bases
            decl
            when-id
            unless-id)
          (macro-program-needs-expansion-with-ids?
            session
            expr-bases
            rest
            when-id
            unless-id)))]))

;; Whether every declaration is an import, as the materialization of an import
;; of an already-loaded module is.
(define (macro-decls-imports-only? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) true]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (and
          (match decl
            [(Import _ _) true]
            [_ false])
          (macro-decls-imports-only? rest)))]))

(define (macro-program-has-defmacro? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (or (macro-decl-has-defmacro? decl) (macro-program-has-defmacro? rest)))]))

(define (macro-decl-might-fire-expression-macro?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(or (Def _ _ _ expr-box) (DefFn _ _ _ _ expr-box _))
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases expr-box))]
    [(Unsafe inner-box)
      (macro-decl-might-fire-expression-macro?
        state
        expr-bases
        (ast.ast-decl-box-shared-view inner-box))]
    [_ false]))

(define (macro-program-might-fire-expression-macro?
  [state : TcMacroState]
  [expr-bases : i64]
  [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (macro-decl-might-fire-expression-macro? state expr-bases decl)
        (macro-program-might-fire-expression-macro? state expr-bases rest))]))

(define (macro-import-kind-summary-backed? [kind : ast.AstImportKind]) : bool
  (match kind
    [(Module) true]
    [_ false]))

(define (macro-import-target-has-summary-macro?
  [kind : ast.AstImportKind]
  [target : ast.AstMaybeModuleName]) : bool
  (if (macro-import-kind-summary-backed? kind)
    (match target
      [(Some target-module) (macro-surface-module-has-macro? target-module)]
      [(No) false])
    false))

(define (macro-decl-has-summary-macro-import? [decl : ast.AstDecl]) : bool
  (match decl
    [(Import decl-meta (Spec kind _ target _ _))
      (macro-import-target-has-summary-macro? kind target)]
    [(Unsafe inner-box)
      (macro-decl-has-summary-macro-import?
        (ast.ast-decl-box-shared-view inner-box))]
    [_ false]))

(define (macro-program-has-summary-macro-import? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (macro-decl-has-summary-macro-import? decl)
        (macro-program-has-summary-macro-import? rest))]))

(defstruct MacroSurfacePrefixModule
  (name String)
  (name-id i64))

(defenum MacroSurfacePrefixPlan
  (Cold)
  (Hydrated
    ast.AstDeclList
    ast.AstDeclPathList
    String
    i64
    sym_i64_env.SymI64Env
    ast.AstDeclList
    ast.AstDeclPathList
    i64))

(define (macro-surface-prefix-module [decls : ast.AstDeclList]) : MacroSurfacePrefixModule
  (let
    [cur : ast.AstDeclList decls]
    [module : String ""]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cur)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (match decl
            [(Module next-module)
              (set! module (tc-env-key-name-text next-module))
              (set! module-id next-module)]
            [_ unit])
          (set! cur rest)]))
    (MacroSurfacePrefixModule module module-id)))

(cfg
  compile-profile
  (define (macro-profile-surface-prefix-hit) : unit
    (cfg
      compile-profile-summary
      unit
      (io.print-error
        "compile-profile-detail|prelude.macro_walk_decl_visits|0\n"))))

;; Package imports are flattened at their source import sites, between
;; entry-owned module/alias markers. Provenance is the stable discriminator:
;; scan through the last declaration copied from an admitted dependency and
;; include every harmless marker before it in the authenticated prefix.
(define (tc-dependency-surface-prefix-candidate
  [load-state : cload.CompilerLoadSessionState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [cache-scope : String]
  [surface-count : i64]) : TcPrefixCandidate
  (let
    [decl-count : i64 (ast.ast-decl-list-len (& decls))]
    [path-count : i64 (ast.ast-decl-path-list-len (& paths))]
    [index : i64 0]
    [remaining : i64 surface-count]
    [module : String ""]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    (if (<= surface-count 0)
      No
      (begin
        (while (and (> remaining 0) (< index decl-count) (< index path-count))
          (let
            [decl : ast.AstDecl
              (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
            [provenance-id : i64
              (ast.ast-decl-path-list-provenance-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty)]
            (if (cload.compiler-load-session-state-dependency-surface-provenance?
              (tc-global-shared-view load-state)
              provenance-id)
              (set! remaining (- remaining 1))
              unit)
            (match decl
              [(Module next-module)
                (set! module (tc-env-key-name-text next-module))
                (set! module-id next-module)]
              [_ unit])
            (set! index (+ index 1))))
        (if (= remaining 0)
          (Some (tc-prefix-key-start cache-scope) index module module-id)
          No)))))

(define (macro-surface-prefix-plan
  [load-state : cload.CompilerLoadSessionState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]) : MacroSurfacePrefixPlan
  (if (surface_facts.surface-typecheck-facts-active?)
    (let
      [facts : surface_facts.SurfaceTypecheckFacts
        (surface_facts.surface-typecheck-facts-current)]
      [count : i64
        (if (surface_facts.surface-typecheck-facts-composite-active?)
          (match (tc-dependency-surface-prefix-candidate
            (tc-global-shared-view load-state)
            (tc-global-shared-view decls)
            (tc-global-shared-view paths)
            (tc-prefix-default-cache-scope)
            (cload.compiler-load-session-state-dependency-surface-provenance-count
              (tc-global-shared-view load-state)))
            [(Some _ candidate-count _ _)
              (if (surface_facts.surface-typecheck-facts-rebase-composite-macro-prefix!
                candidate-count)
                candidate-count
                0)]
            [(No) 0])
          facts.macro-prefix-decl-count)]
      [decl-count : i64 (ast.ast-decl-list-len (& decls))]
      [path-count : i64 (ast.ast-decl-path-list-len (& paths))]
      (if (and (> count 0) (< count decl-count) (<= count path-count))
        (let
          [prefix-decls : ast.AstDeclList
            (tc-decl-list-take (tc-global-shared-view decls) count)]
          [prefix-paths : ast.AstDeclPathList
            (tc-decl-path-list-take (tc-global-shared-view paths) count)]
          [module : MacroSurfacePrefixModule
            (macro-surface-prefix-module (tc-global-shared-view prefix-decls))]
          (begin
            (if (surface_facts.surface-typecheck-facts-composite-active?)
              (cload.compiler-load-session-state-dependency-surface-note-macro-skip!
                load-state
                count)
              unit)
            (cfg compile-profile (macro-profile-surface-prefix-hit))
            (Hydrated
              (tc-decl-list-drop (tc-global-shared-view decls) count)
              (tc-decl-path-list-drop (tc-global-shared-view paths) count)
              module.name
              module.name-id
              (macro-materialize-seen-from
                (& decls)
                (& paths)
                (sym_i64_env.sym-i64-empty)
                cbi.compiler-builtin-id-fix-empty)
              (macro-decl-list-reverse prefix-decls)
              (macro-decl-path-list-reverse prefix-paths)
              count)))
        (begin
          (if (surface_facts.surface-typecheck-facts-composite-active?)
            (surface_facts.surface-typecheck-facts-clear!)
            unit)
          (Cold))))
    (Cold)))

(define (macro-expand-decls-with-surface-prefix
  [load-state : cload.CompilerLoadSessionState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroDeclsWithPaths
  (match (macro-surface-prefix-plan
    (tc-global-shared-view load-state)
    (tc-global-shared-view decls)
    (tc-global-shared-view paths))
    [(Cold)
      (macro-expand-decls
        load-state
        ctx
        top-env
        (tc-global-shared-view decls)
        (tc-global-shared-view decls)
        (tc-global-shared-view paths)
        ""
        cbi.compiler-builtin-id-fix-empty
        true
        stdlib-roots
        cfgs
        (macro-materialize-seen-from
          (& decls)
          (& paths)
          (sym_i64_env.sym-i64-empty)
          cbi.compiler-builtin-id-fix-empty)
        (ast.ast-decl-list-new)
        (ast.ast-decl-path-list-new))]
    [(Hydrated
        suffix-decls
        suffix-paths
        module
        module-id
        materialize-seen
        prefix-rev
        prefix-paths-rev
        _)
      (macro-expand-decls
        load-state
        ctx
        top-env
        decls
        suffix-decls
        suffix-paths
        module
        module-id
        true
        stdlib-roots
        cfgs
        materialize-seen
        prefix-rev
        prefix-paths-rev)]))

;; Expand all macro calls in a parsed program before typechecking. Programs that
;; need no macro or guard-compatibility expansion are returned unchanged without
;; rebuilding the AST, so the expansion phase adds no allocation for the common
;; case.
(define (macro-expand-program-pass-in-scratch-with-paths-and-pools
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (tc-install-pools! pools)
  (match (tc-global-shared-view program)
    [(Program decls-box)
      (let
        [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [_prescan : unit
          (macro-live-prescan-ensure! macro-state (tc-global-shared-view decls))]
        [has-defmacro : bool
          (tc-macro-walk-field macro-state macro-live-prescan-has-defmacro)]
        [expr-type-macro-names : TcNameIdList
          (tc-macro-walk-field macro-state macro-live-prescan-expr-type-names)]
        [has-expr-type-macros : bool
          (match expr-type-macro-names
            [(Nil) false]
            [_ true])]
        [program-needs-expansion : bool
          (tc-macro-walk-field macro-state macro-live-prescan-needs-expansion)]
        [has-summary-macro-import : bool
          (tc-macro-walk-field macro-state macro-live-prescan-summary-import)]
        [prescan-macro-names : TcNameIdList
          (if has-summary-macro-import
            (tc-macro-walk-field macro-state macro-live-prescan-visible-names)
            (Nil))]
        [has-visible-macro-call : bool
          (if has-summary-macro-import
            (begin
              (macro-expand-set-macro-names! macro-state prescan-macro-names)
              (macro-program-might-fire-expression-macro?
                macro-state
                (ast.ast-node-pool-context-expr-segment-bases pools)
                (tc-global-shared-view decls)))
            false)]
        (begin
          ;; The CTFE-env cache is reset once per program at the macro-expand
          ;; entry and rebuilt at most once per run by
          ;; macro-expand-ctfe-env-build-once! below, then reused (rebased onto
          ;; the active pools) across every in-pass splice rebuild.
          (cfg compile-profile (compiler-tc-macro-profile-reset))
          (cfg compile-profile (compiler-tc-env-profile-reset))
          ;; Same per-compile reset for the clone-able type set cache.
          (tc-clone-able-cache-reset-for-job! job-state)
          ;; Type-name misses are keyed only by lookup text; in-pass splice
          ;; rebuilds swap in a different expanded program, so a miss recorded
          ;; against an earlier view must not hide generated module-local
          ;; types introduced since.
          (tc-nominal-owner-cache-reset-for-job! job-state)
          ;; Same per-compile reset for the qualified-alias resolution cache:
          ;; the (module, qualifier) -> target mapping is derived from this
          ;; program's declarations.
          (macro-alias-derived-cache-reset-for-state! macro-state)
          (tc-job-state-reset-derived-caches! job-state)
          ;; The ctfe-module-macro-export map is not reset per pass: it is owned
          ;; by macro-live-prescan-ensure!, which populates it once (with the
          ;; cached visible-name prescan) and repopulates it on the non-inert
          ;; splice fallback. Clearing it here left every pass after the first
          ;; with an empty export set, breaking module-hook.
          (macro-expand-set-expr-type-macro-names!
            macro-state
            expr-type-macro-names)
          ;; Scan once for type literals and module-value queries. The latter
          ;; enables only the compact signature index; it must not force the
          ;; much larger layout/nominal-reflection metadata build.
          (ctfe_support.ctfe-module-value-reflection-enable-for-state!
            (tc-macro-ctfe-state macro-state)
            false)
          (let
            [has-type-literal : bool
              (ctfe-program-has-type-literal?
                (ast.ast-node-pool-context-expr-segment-bases (& pools))
                macro-state
                (tc-global-shared-view decls))]
            ;; Source macro bodies and ordinary comptime expressions are
            ;; visited by the combined scan above. Surface-summary macro
            ;; bodies are outside this AST, so conservatively enable the
            ;; compact index only for that imported-summary case.
            (if has-summary-macro-import
              (ctfe_support.ctfe-module-value-reflection-enable-for-state!
                (tc-macro-ctfe-state macro-state)
                true)
              unit)
            ;; Only build the (tens-of-MB, O(types^2))
            ;; reflection/layout metadata if the program actually contains
            ;; a `(type T)` literal or macros need reflection.
            (tc-macro-walk-set!
              macro-state
              ctfe-needs-metadata
              (or
                has-defmacro
                has-visible-macro-call
                has-type-literal
                has-expr-type-macros)))
          (if (or has-defmacro has-visible-macro-call program-needs-expansion)
            (let
              [prefix-reserve : i64 1024]
              [active-decls : ast.AstDeclList
                (macro-decl-list-with-prefix-reserve decls prefix-reserve)]
              [active-paths : ast.AstDeclPathList
                (macro-decl-path-list-with-prefix-reserve paths prefix-reserve)]
              [active-program : ast.AstProgram
                (ast.ast-program (tc-global-shared-view active-decls))]
              (begin
                (cfg compile-profile (compiler-tc-profile-start))
                (match (macro-live-symbols-build-or-reuse!
                  macro-state
                  (tc-global-shared-view active-program)
                  (tc-global-shared-view active-paths))
                  [(Ok symbols)
                    (let
                      [registries : csym.CompilerRegistries
                        (macro-live-registries-shared-view macro-state)]
                      (tc-macro-walk-set!
                        macro-state
                        macro-expand-active-module
                        "")
                      (macro-expand-set-macro-names!
                        macro-state
                        (tc-macro-walk-field
                          macro-state
                          macro-live-prescan-visible-names))
                      (let
                        [ctx : TcContext
                          (tc-context-new-with-source-names-and-job-state
                            (tc-global-shared-view active-program)
                            symbols
                            registries
                            ""
                            cbi.compiler-builtin-id-fix-empty
                            pools
                            source-names
                            job-state)]
                        [_definition-paths : unit
                          (macro-definition-paths-index!
                            ctx
                            active-decls
                            active-paths)]
                        (match (tc-stdlib-comptime-surface-ok-for-macro ctx)
                          [(Ok)
                            (match (tc-build-top-env ctx active-program)
                              [(Ok top-env)
                                (begin
                                  (tc-hygiene-reset-active-top-env!
                                    macro-state
                                    top-env)
                                  (tc-context-capture-active-pools! ctx)
                                  (cfg
                                    compile-profile
                                    (compiler-tc-profile-finish "macro_setup"))
                                  (cfg
                                    compile-profile
                                    (compiler-tc-profile-start))
                                  (macro-expand-ctfe-env-build-once! ctx)
                                  (cfg
                                    compile-profile
                                    (compiler-tc-profile-finish
                                      "macro_materialize"))
                                  (cfg
                                    compile-profile
                                    (compiler-tc-profile-start))
                                  (match (macro-expand-decls-with-surface-prefix
                                    load-state
                                    ctx
                                    top-env
                                    active-decls
                                    active-paths
                                    stdlib-roots
                                    cfgs)
                                    [(Ok ndecls npaths)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (cfg
                                          compile-profile
                                          (compiler-tc-profile-finish
                                            "macro_walk"))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-env-profile-emit-macro-cache-entries))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-macro-profile-emit))
                                        (Ok (ast.ast-program ndecls) npaths))]
                                    [(Err diag)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (cfg
                                          compile-profile
                                          (compiler-tc-profile-finish
                                            "macro_walk"))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-env-profile-emit-macro-cache-entries))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-macro-profile-emit))
                                        (Err diag))]))]
                              [(Err message)
                                (Err (box (tc-diag-at-start message)))])]
                          [(Err message) (Err (box (tc-diag-at-start message)))])))]
                  [(Err message)
                    (Err
                      (box
                        (csym.compiler-symbols-last-error-diagnostic message)))])))
            (Ok program paths))))]))

;; Macro setup, prescans, top environments, splice contexts, and rebuilt list
;; spines have no reader after this pass. Make the existing macro scratch owner
;; the ambient arena for the complete pass; generated AST rows already copy out
;; through their generation boundary, and the public result is stabilized by
;; `macro-expand-result-stabilize` before this owner is destroyed.
(define (macro-expand-program-pass-with-paths-and-pools
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    [_scratch-begin : unit (macro-expand-scratch-begin! macro-state)]
    [scratch : i64 (macro-expand-scratch-arena-get macro-state)]
    (in-arena
      (arena.Arena scratch)
      (macro-expand-program-pass-in-scratch-with-paths-and-pools
        load-state
        program
        paths
        pools
        source-names
        job-state
        stdlib-roots
        cfgs))))

(defenum MacroMaybeGeneratedNormalImport
  (No)
  (Some
    ast.AstImportKind
    String
    ast.AstMaybeModuleName
    ast.AstMaybeImportAlias
    ast.AstSourceSpan
    ast.AstDecl))

(defenum ResultMacroMaterializeImport
  (Ok ast.AstDeclList ast.AstDeclPathList sym_i64_env.SymI64Env)
  (Err (Box cdiag.CompilerDiagnostic)))

(define (macro-generated-normal-import [decl : ast.AstDecl]) : MacroMaybeGeneratedNormalImport
  (match (ast.ast-decl-generated-meta decl)
    [(Some _ _ _ _)
      (let
        [template : ast.AstDecl (ast.ast-decl-unwrapped (& decl))]
        (match (tc-global-shared-view template)
          [(Import decl-meta (Spec kind import-path expected alias span))
            (if (macro-import-placeholder-kind? kind)
              (No)
              (Some
                kind
                import-path
                expected
                alias
                (__tl-box-place span)
                template))]
          [_ (No)]))]
    [(No) (No)]))

(define (macro-materialize-seen-from
  [decls : (& decls ast.AstDeclList)]
  [paths : (& paths ast.AstDeclPathList)]
  [seen : sym_i64_env.SymI64Env]
  [module-id : i64]) : sym_i64_env.SymI64Env
  (let
    [count : i64 (ast.ast-decl-list-len decls)]
    [path-count : i64 (ast.ast-decl-path-list-len paths)]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : sym_i64_env.SymI64Env seen]
    (while (< index count)
      (let
        [decl-path : String
          (if (< index path-count)
            (ast.ast-decl-path-list-get paths index "")
            "")]
        [decl-owner-id : i64
          (if (< index path-count)
            (ast.ast-decl-path-list-owner-id
              paths
              index
              cbi.compiler-builtin-id-fix-empty)
            cbi.compiler-builtin-id-fix-empty)]
        (if (and
          (> (string.string-length decl-path) 0)
          (not (= decl-owner-id cbi.compiler-builtin-id-fix-empty)))
          (set!
            out
            (sym_i64_env.sym-i64-bind-id
              out
              (cload.compiler-load-seen-path-key-id decl-owner-id cur-module-id)
              1))
          unit)
        (match (ast.ast-decl-list-ref-borrowed decls index)
          [(Module _)
            (match (array-ref decls.slots (+ decls.offset index))
              [(Module name)
                (if (= name cbi.compiler-builtin-id-fix-empty)
                  unit
                  (set! out (sym_i64_env.sym-i64-bind-id out name 1)))
                (set! cur-module-id name)]
              [_ unit])]
          [_ unit])
        (set! index (+ index 1))))
    out))

(define (macro-materialize-import-diagnostic
  [path : String]
  [span : ast.AstSourceSpan]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-canonical-diagnostic
    (cdiag.compiler-diagnostic-from-ast-span path span message)))

;; The macro walk also handles complete in-memory programs and generated
;; modules. Their module markers are authoritative members of this job's seen
;; set, but have no parsed-file surface. Do not turn such a provided module
;; back into a filesystem request. File-backed modules still use the loader's
;; source-path/summary authority check, even when their module name is seen.
(define (macro-materialize-provided-module?
  [load-state : (& load-state cload.CompilerLoadSessionState)]
  [expected : ast.AstMaybeModuleName]
  [seen : sym_i64_env.SymI64Env]) : bool
  (match expected
    [(Some module-id)
      (and
        (cload.compiler-load-seen-module-contains? seen "" module-id)
        (match (cload.compiler-load-session-state-surface-summary-find-module
          load-state
          module-id)
          [(CompilerLoadNoSurfaceSummary) true]
          [(CompilerLoadSomeSurfaceSummary _) false]))]
    [(No) false]))

;; Classification is shared with ordinary source imports. A known in-memory
;; module already has its identity, so filesystem prefix probing must not
;; reinterpret a dotted module name as a selected item from another module.
(define (macro-resolve-generated-import
  [load-state : cload.CompilerLoadSessionState]
  [decl-path : String]
  [import-root : String]
  [kind : ast.AstImportKind]
  [import-path : String]
  [expected : ast.AstMaybeModuleName]
  [alias : ast.AstMaybeImportAlias]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.Vec]) : cload.ResultCompilerLoadResolvedImport
  (if (macro-materialize-provided-module? load-state expected seen)
    (let
      [resolved
        (try
          (cload.compiler-load-resolve-import-spec-with-roots
            decl-path
            import-root
            kind
            (tc-global-shared-view import-path)
            expected
            stdlib-roots))]
      (Ok
        (cload.CompilerLoadResolvedImport
          resolved
          kind
          import-path
          expected
          alias)))
    (cload.compiler-load-resolve-import-spec-with-roots-classified
      decl-path
      import-root
      kind
      import-path
      expected
      alias
      stdlib-roots)))

(define (macro-materialize-generated-import-with-provenance
  [load-state : cload.CompilerLoadSessionState]
  [decl : ast.AstDecl]
  [decl-path : String]
  [decl-owner-id : i64]
  [decl-provenance-id : i64]
  [module : String]
  [module-id : i64]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : ast.AstNodePoolContext]) : ResultMacroMaterializeImport
  (match (macro-generated-normal-import (tc-global-shared-view decl))
    [(No)
      (Ok
        (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new)))
        (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
          decl-path
          decl-owner-id
          decl-provenance-id
          (ast.ast-decl-path-list-new))
        seen)]
    [(Some kind import-path expected alias span _)
      (let
        [import-root : String (cload.compiler-load-dirname decl-path)]
        (match (macro-resolve-generated-import
          (tc-global-shared-view load-state)
          (tc-global-shared-view decl-path)
          (tc-global-shared-view import-root)
          kind
          import-path
          expected
          alias
          seen
          (tc-global-shared-view stdlib-roots))
          [(Ok import)
            (let
              [resolved : String import.resolved]
              [kind : ast.AstImportKind import.kind]
              [import-path : String import.module-name]
              [expected : ast.AstMaybeModuleName import.expected-module]
              [alias : ast.AstMaybeImportAlias import.alias]
              [resolved-path-id : i64
                (cload.compiler-load-resolved-path-id-for-generated-import-with-state
                  (tc-global-shared-view load-state)
                  (tc-global-shared-view resolved)
                  expected)]
              (match (if (macro-materialize-provided-module?
                load-state
                expected
                seen)
                (cload.ResultCompilerLoadWithPaths.Ok
                  (ast.ast-decl-list-new)
                  (ast.ast-decl-path-list-new)
                  (ast.ast-decl-module-list-new)
                  seen)
                (cload.compiler-load-file-with-paths-and-roots-expect-cfg-root-import-with-state-and-pools
                  (tc-global-shared-view load-state)
                  (tc-global-shared-view resolved)
                  resolved-path-id
                  seen
                  stdlib-roots
                  kind
                  import-path
                  expected
                  import-root
                  cfgs
                  pools
                  (tc-global-shared-view module)
                  module-id))
                [(Ok imported-decls imported-paths _ next-seen)
                  (let
                    [after-import-expected : ast.AstMaybeModuleName
                      (cload.compiler-load-after-import-expected-module
                        (tc-global-shared-view load-state)
                        resolved-path-id
                        kind
                        expected
                        alias
                        (tc-global-shared-view imported-decls))]
                    [after-import-alias : ast.AstMaybeImportAlias
                      (cload.compiler-load-after-import-alias
                        load-state
                        resolved-path-id
                        kind
                        expected
                        alias
                        (tc-global-shared-view imported-decls))]
                    [source-import : ast.AstDeclList
                      (ast.ast-decl-cons (& decl) (& (ast.ast-decl-list-new)))]
                    [tail-decls : ast.AstDeclList
                      (cload.compiler-load-decls-after-import
                        kind
                        resolved
                        after-import-expected
                        after-import-alias
                        span
                        module
                        module-id
                        source-import
                        (tc-global-shared-view imported-decls)
                        (ast.ast-decl-list-new))]
                    [tail-paths : ast.AstDeclPathList
                      (cload.compiler-load-paths-after-import
                        decl-path
                        decl-provenance-id
                        decl-owner-id
                        after-import-alias
                        (tc-global-shared-view imported-decls)
                        (ast.ast-decl-path-list-new))]
                    [materialized-decls : ast.AstDeclList
                      (macro-decl-list-append imported-decls tail-decls)]
                    [materialized-paths : ast.AstDeclPathList
                      (macro-decl-path-list-append imported-paths tail-paths)]
                    (Ok materialized-decls materialized-paths next-seen))]
                [(Err diag)
                  ;; Keep the dependency's primary error and attach the actual
                  ;; generated import site, including for a nonexistent file.
                  (Err
                    (box
                      (cdiag.compiler-diagnostic-with-secondary-if-new
                        (cdiag.compiler-diagnostic-box-shared-view diag)
                        (&
                          (cdiag.CompilerDiagnosticSpan
                            decl-path
                            (ast.ast-source-span-start-line span)
                            (ast.ast-source-span-start-col span)
                            (ast.ast-source-span-end-line span)
                            (ast.ast-source-span-end-col span)))
                        (&
                          (CompilerDiagnosticSomeString
                            "generated import requested here")))))]))]
          [(Err message)
            (Err
              (box (macro-materialize-import-diagnostic decl-path span message)))]))]))

;; Validate once after the fixed-point walk, when every generated import has
;; become a canonical alias marker and each declaration has its physical path.
;; Source and generated declarations therefore obey the same loader policy.
(define (macro-check-expanded-imports [result : ResultMacroExpand]) : ResultMacroExpand
  (match result
    [(Ok program paths)
      (match (tc-global-shared-view program)
        [(Program boxed-decls)
          (let
            [decls : ast.AstDeclList
              (ast.ast-decl-list-box-shared-view boxed-decls)]
            [_
              (try
                (cload.compiler-load-check-dotted-import-aliases-with-paths
                  ""
                  (ast.ast-place-shared-view decls)
                  (ast.ast-place-shared-view paths)))]
            (let
              [_
                (try
                  (cload.compiler-load-check-expanded-unqualified-imports
                    ""
                    decls
                    (ast.ast-place-shared-view paths)))]
              (Ok program paths)))])]
    [(Err diag) (Err diag)]))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [intern-state-input : ci.InternCompatState]) : ResultMacroExpand
  (let
    [intern-state : ci.InternCompatState intern-state-input]
    (begin
      (cfg compile-profile (compiler-tc-macro-lifetime-start! job-state pools))
      (tc-macro-state-bind-source-names!
        (tc-job-state-macro-state job-state)
        source-names)
      (tc-macro-walk-set!
        (tc-job-state-macro-state job-state)
        macro-dependency-catalog-handle
        (cload.compiler-load-session-state-dependency-catalog-handle
          (tc-global-shared-view load-state)))
      ;; The cache key is a source-name provenance index and the cached value
      ;; belongs to this exact catalog snapshot. Reset at the phase boundary so
      ;; job reuse cannot observe a prior source table or catalog generation.
      (macro-dependency-catalog-slot-cache-reset!
        (tc-job-state-macro-state job-state))
      ;; Snapshot this load session's exact intern-owned module trust set before
      ;; macro dispatch. Another job may reset or replace its own provenance
      ;; carrier without changing this walk's routing decisions.
      (tc-macro-walk-set!
        (tc-job-state-macro-state job-state)
        macro-expand-stdlib-tlci-module-ids
        (cload.compiler-load-session-state-embedded-module-ids-shared-view
          (tc-global-shared-view load-state)))
      (tc-dependency-tlci-route-counters-reset!
        (tc-job-state-macro-state job-state))
      ;; Legacy macro expansion still reads compatibility globals; bridge the
      ;; compile-owned pool and interner state at the phase boundary.
      (ast.ast-node-pool-context-install! pools)
      (ci.intern-compat-state-install! intern-state)
      (macro-expand-program-structural-change-reset!
        (tc-job-state-macro-state job-state))
      ;; The route is a property of the compiler's embedded image plus the exact
      ;; source provenance observed by this load session. Embedded source marks
      ;; the session directly; byte-identical disk source may mark individual
      ;; modules through the content-equivalence cache. Extra non-stdlib roots
      ;; (for example `src` during a self-compile) do not disable the route, while
      ;; modified/untrusted stdlib source never receives embedded provenance.
      ;; Production routing uses this same policy on every host. The
      ;; stress-only cfg controls durable telemetry, not route selection.
      (tc-macro-walk-set!
        (tc-job-state-macro-state job-state)
        macro-expand-stdlib-tlci-route-active
        (cfg
          embedded-stdlib-tlci
          (or
            (cload.compiler-load-session-state-embedded-stdlib-source-used?
              (tc-global-shared-view load-state))
            (cload.compiler-load-session-state-embedded-provenance-noted?
              (tc-global-shared-view load-state)))
          false))
      (cfg
        embedded-stdlib-tlci
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
      (cfg
        compile-profile
        (compiler-tc-macro-profile-reset-program-counters job-state))
      (cfg
        (all embedded-stdlib-tlci tlci-native-route-stress)
        (compiler-tc-tlci-native-stress-pass-start!
          pools
          (tc-macro-walk-field
            (tc-job-state-macro-state job-state)
            macro-expand-stdlib-tlci-route-active)))
      (tc-stdlib-comptime-macro-surface-ok-reset!
        (tc-job-state-macro-state job-state))
      (tc-macro-identity-reset-for-state! (tc-job-state-macro-state job-state))
      (macro-generated-module-memo-reset! (tc-job-state-macro-state job-state))
      (macro-generated-decls-memo-reset! (tc-job-state-macro-state job-state))
      ;; Reset the CTFE base-env cache once per program (plan P2). The pass
      ;; rebuilds it via macro-expand-ctfe-env-build-once!; it is then reused by
      ;; every in-pass splice rebuild and by the downstream typecheck/lower
      ;; comptime, never rebuilt per splice. This is the "build the CTFE-env
      ;; once, after expansion" boundary.
      (compiler-typecheck-ctfe-env-cache-clear!
        (tc-job-state-macro-state job-state))
      ;; Reset the live symbols/registries cache once per program (plan P2): the
      ;; pass rebuilds them and in-pass splice rebuilds reuse or refresh them.
      (macro-live-symbols-reset! (tc-job-state-macro-state job-state))
      ;; Reset the hoisted whole-program prescans: computed at
      ;; pass setup and refreshed only when a generated file import loads new
      ;; declarations mid-walk.
      (macro-live-prescan-reset! (tc-job-state-macro-state job-state))
      (let
        [macro-result : ResultMacroExpand
          (macro-expand-program-pass-with-paths-and-pools
            load-state
            (tc-global-shared-view program)
            (tc-global-shared-view paths)
            pools
            source-names
            job-state
            stdlib-roots
            cfgs)]
        ;; Publish all legacy macro mutations before the copy-out observes pool
        ;; lengths or either public result.
        [_capture-macro-pools : unit
          (ast.ast-node-pool-context-capture-active! pools)]
        [_capture-macro-interns : unit
          (ci.intern-compat-state-capture-from-globals! (&mut intern-state))]
        [stable-macro-result : ResultMacroExpand
          (macro-expand-result-stabilize
            (tc-job-state-macro-state job-state)
            program
            paths
            pools
            macro-result)]
        [checked-macro-result : ResultMacroExpand
          (macro-check-expanded-imports stable-macro-result)]
        ;; The canonical alias rule interns composite namespace keys. Publish
        ;; those mutations to this job's owner before normalization uses it.
        [_capture-import-validation-interns : unit
          (ci.intern-compat-state-capture-from-globals! (&mut intern-state))]
        (match checked-macro-result
          [(Ok expanded expanded-paths)
            (begin
              (cfg
                embedded-stdlib-tlci
                (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
              (cfg
                (all embedded-stdlib-tlci tlci-native-route-stress)
                (compiler-tc-tlci-native-stress-pass-finish! pools 0))
              (let
                [_profile-retention-sample : unit
                  (cfg
                    compile-profile
                    (compiler-tc-macro-retention-sample!
                      (tc-job-state-macro-state job-state))
                    unit)]
                [_profile-lifetime-pre-detach : unit
                  (cfg
                    compile-profile
                    (compiler-tc-macro-lifetime-emit!
                      job-state
                      pools
                      "macro.pre-detach")
                    unit)]
                [_profile-owners : unit
                  (macro-expand-allocation-profile-snapshot!
                    (tc-job-state-macro-state job-state)
                    0)]
                [_release-scratch : unit
                  (begin
                    (macro-expand-scratch-release!
                      (tc-job-state-macro-state job-state))
                    (tc-job-state-reset-derived-caches! job-state))]
                [_profile-lower-handoff : unit
                  (cfg
                    compile-profile
                    (compiler-tc-macro-lifetime-emit!
                      job-state
                      pools
                      "macro.lower-handoff")
                    unit)]
                (if (spec.compiler-specialize-needed-with-pools
                  (tc-global-shared-view expanded)
                  pools)
                  (begin
                    (macro-expand-program-structural-change-note!
                      (tc-job-state-macro-state job-state)
                      8)
                    (let
                      [owner : spec.SpecOwnerContext
                        (spec.spec-owner-context-new pools intern-state)]
                      [normalized-result : spec.ResultGenProgramWithPaths
                        (spec.gen-normalize-program-with-paths-and-pools-and-intern-state
                          expanded
                          (tc-global-shared-view expanded-paths)
                          (tc-decl-path-list-last expanded-paths "")
                          owner)]
                      ;; Explicit normalization mutates owner cells directly;
                      ;; publish them before matching either result.
                      (ast.ast-node-pool-context-install! pools)
                      (ci.intern-compat-state-install! intern-state)
                      (match normalized-result
                        [(Ok normalized normalized-paths)
                          (Ok normalized normalized-paths)]
                        [(Err diag) (Err diag)])))
                  (Ok expanded expanded-paths))))]
          [(Err diag)
            (begin
              (cfg
                embedded-stdlib-tlci
                (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
              (cfg
                (all embedded-stdlib-tlci tlci-native-route-stress)
                (compiler-tc-tlci-native-stress-pass-finish! pools 1))
              ;; A failed walk has no continuing context consumer. A
              ;; replacement registry that failed during top-env/CTFE setup
              ;; may still have its predecessor in the retired slot; reclaim
              ;; that predecessor before publishing the failure boundary.
              (macro-live-symbols-reclaim-retired!
                (tc-job-state-macro-state job-state))
              (cfg
                compile-profile
                (begin
                  (compiler-tc-macro-retention-sample!
                    (tc-job-state-macro-state job-state))
                  (compiler-tc-macro-lifetime-emit!
                    job-state
                    pools
                    "macro.pre-detach")))
              (macro-expand-allocation-profile-snapshot!
                (tc-job-state-macro-state job-state)
                0)
              (macro-expand-scratch-release!
                (tc-job-state-macro-state job-state))
              (tc-job-state-reset-derived-caches! job-state)
              (cfg
                compile-profile
                (compiler-tc-macro-lifetime-emit!
                  job-state
                  pools
                  "macro.lower-handoff"))
              (Err diag))])))))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
    load-state
    program
    paths
    pools
    source-names
    job-state
    stdlib-roots
    cfgs
    (ci.intern-compat-state-capture-active)))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [intern-state : ci.InternCompatState]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
    load-state
    program
    paths
    pools
    (ci.intern-source-name-session-handle-from-state intern-state)
    job-state
    stdlib-roots
    cfgs
    intern-state))

;; Serial/test compatibility adapter. Production macro-expansion jobs call the
;; explicit load-state, job-state, and intern-state entry above.
(define (macro-expand-program [program : ast.AstProgram]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state
    (cload.compiler-load-serial-test-session-state)
    program
    (ast.ast-decl-path-list-new)
    (ast.ast-node-pool-context-capture-active)
    (ci.intern-source-name-session-capture-active-handle)
    (tc-serial-job-state)
    (svec.new)
    (parser.compiler-cfg-empty)))

(define (tc-struct-name-cleanup-owning? [ctx : TcContext] [struct-name : i64]) : bool
  (match (tc-struct-decl-id ctx struct-name)
    [(Ok decl)
      (match decl
        [(TcStructDecl _ cleanup _) (ast.ast-struct-cleanup? cleanup)])]
    [(Err _) false]))

(define (tc-enum-name-cleanup-owning? [ctx : TcContext] [enum-name : i64]) : bool
  (match (tc-enum-decl-id ctx enum-name)
    [(Ok decl)
      (match decl
        [(TcEnumDecl cleanup _) (ast.ast-enum-cleanup? cleanup)])]
    [(Err _) false]))

(define (tc-cleanup-owning-struct-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Struct struct-name) (StructArgs struct-name _))
      (tc-struct-name-cleanup-owning? ctx struct-name)]
    [_ false]))

(define (tc-cleanup-owning-enum-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Enum enum-name) (EnumArgs enum-name _))
      (tc-enum-name-cleanup-owning? ctx enum-name)]
    [_ false]))

(define (tc-cleanup-owning-aggregate-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (or
    (tc-cleanup-owning-struct-type? ctx (tc-global-shared-view ty))
    (tc-cleanup-owning-enum-type? ctx ty)))

;; A value of this type carries a cleanup obligation: it is a cleanup-owning
;; struct or enum, or holds one through a box, an array or a tuple.
(define (tc-type-reaches-cleanup? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Struct name) (StructArgs name _))
      (tc-struct-name-cleanup-owning? ctx name)]
    [(or (Enum name) (EnumArgs name _)) (tc-enum-name-cleanup-owning? ctx name)]
    [(or (Box elem) (Array elem _) (DynArray elem))
      (tc-type-reaches-cleanup? ctx (tc-context-type-get ctx elem))]
    [(Tuple elems)
      (tc-type-list-reaches-cleanup?
        ctx
        (ast.ast-type-list-box-shared-view elems))]
    [_ false]))

(define (tc-type-list-reaches-cleanup?
  [ctx : TcContext]
  [types : ast.AstTypeList]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index (ast.ast-type-list-len (& types))))
      (if (tc-type-reaches-cleanup?
        ctx
        (tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback))))
        (set! found true)
        unit)
      (set! index (+ index 1)))
    found))

(define (tc-struct-field-cleanup-outside-message
  [struct-name : String]
  [field-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " has cleanup metadata but struct is not cleanup-owning"))

(define (tc-struct-field-cleanup-owning-without-owned-message
  [struct-name : String]
  [field-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-struct-field-owned-non-cleanup-message
  [struct-name : String]
  [field-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-struct-field-cleanup-fn-mismatch-message
  [struct-name : String]
  [field-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-cleanup-source-slash-alias-helper-name
  [ctx : TcContext]
  [cleanup-name : i64]) : i64
  (match (tc-context-program ctx)
    [(Program decls-box)
      (match (macro-import-alias-target-cached-id-in-context
        ctx
        (ast.ast-decl-list-box-shared-view decls-box)
        (tc-context-module-id ctx)
        (ci.intern-qualified-module-id cleanup-name))
        [(Some target-module-id)
          (csym.compiler-symbol-module-key-id-by-id
            target-module-id
            (ci.intern-qualified-base-id cleanup-name))]
        [(No) cleanup-name])]))

(define (tc-cleanup-field-helper-name
  [ctx : TcContext]
  [owner-name-id : i64]
  [cleanup-name : i64]) : i64
  (let
    [cleanup-str : String (ci.intern-str cleanup-name)]
    [structural-session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    (if (tc-source-slash-qualified-id?
      structural-session
      cleanup-str
      cleanup-name)
      (tc-cleanup-source-slash-alias-helper-name ctx cleanup-name)
      (if (tc-name-qualified-id? structural-session cleanup-name)
        cleanup-name
        (csym.compiler-symbol-module-key-id-by-id
          (let
            [owner-module-id : i64 (tc-qualified-name-module-id owner-name-id)]
            (if (>= owner-module-id 0)
              owner-module-id
              cbi.compiler-builtin-id-fix-empty))
          cleanup-name)))))

(define (tc-check-struct-field-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [field-name : String]
  [cleanup-name : ci.InternSyntaxId]
  [field-ty : ast.AstType]) : ResultTcUnit
  (let
    [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx struct-name-id cleanup-name-id)]
    [cleanup-ty (try (tc-lookup-visible-id ctx env lookup-name))]
    [cleanup-display : String
      (ci.intern-syntax-name-text-or cleanup-name-id "<structural-name>")]
    [_
      (try
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions field-ty) (Unit))
          (tc-struct-field-cleanup-fn-mismatch-message
            (tc-global-shared-view struct-name)
            (tc-global-shared-view field-name)
            (tc-global-shared-view cleanup-display))))]
    (tc-check-cleanup-hook-safe
      env
      lookup-name
      (str_cat.str-cat "struct " struct-name " field " field-name)
      cleanup-display)))

;; A cleanup hook runs implicitly wherever its owner's scope ends, in safe code
;; too, so no call site can supply the `unsafe` context an unsafe declaration
;; requires (SPEC 4.3.1). The hook must discharge its own unsafety (#8267).
(define (tc-check-cleanup-hook-safe
  [env : TcTypeEnv]
  [lookup-name : i64]
  [owner : String]
  [cleanup-display : String]) : ResultTcUnit
  (match (tc-lookup-unsafe-key-id
    env
    (tc-env-name-key-id (tc-type-env-structural-session env) lookup-name))
    [(Ok _ unsafe)
      (if unsafe
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (UnsafeCallableEffect))
            "typecheck: "
            owner
            " cleanup function "
            cleanup-display
            " is an unsafe declaration; a cleanup hook runs implicitly, so it must discharge its own unsafety"))
        Ok)]
    [(Err _) Ok]))

(define (tc-check-cleanup-struct-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [struct-cleanup : ast.AstStructCleanup]
  [field : ast.AstFieldDef]) : ResultTcUnit
  (match field
    [(Def field-name ty field-cleanup)
      (let
        [field-name-str : String
          (ci.intern-str (ci.intern-syntax-id-value field-name))]
        [resolved-ty : ast.AstType
          (tc-type-strip-region (tc-resolve-type ctx ty))]
        [field-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type?
            ctx
            (tc-global-shared-view resolved-ty))]
        (if (not (ast.ast-struct-cleanup? struct-cleanup))
          (if (ast.ast-field-cleanup? field-cleanup)
            (Err
              (tc-struct-field-cleanup-outside-message
                struct-name
                field-name-str))
            (if field-cleanup-owning
              (Err
                (tc-struct-field-cleanup-owning-without-owned-message
                  struct-name
                  field-name-str
                  resolved-ty))
              Ok))
          (match field-cleanup
            [(Owned)
              (if field-cleanup-owning
                Ok
                (Err
                  (tc-struct-field-owned-non-cleanup-message
                    struct-name
                    field-name-str
                    resolved-ty)))]
            [(Fn cleanup-name)
              (if field-cleanup-owning
                (Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                (tc-check-struct-field-cleanup-fn
                  ctx
                  env
                  struct-name
                  struct-name-id
                  field-name-str
                  cleanup-name
                  resolved-ty))]
            [(No)
              (if field-cleanup-owning
                (Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                Ok)])))]))

(define (tc-check-cleanup-struct-fields
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : ast.AstStructCleanup]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (tc-check-cleanup-struct-fields-at
    ctx
    env
    struct-name
    struct-name-id
    cleanup
    (& fields)
    0))

(define (tc-check-cleanup-struct-fields-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : ast.AstStructCleanup]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index fields.len)
    Ok
    (let
      [_
        (try
          (tc-check-cleanup-struct-field
            ctx
            env
            (tc-global-shared-view struct-name)
            struct-name-id
            cleanup
            (ast.ast-field-def-list-get
              fields
              index
              (ast.ast-field-def-fallback))))]
      (tc-check-cleanup-struct-fields-at
        ctx
        env
        struct-name
        struct-name-id
        cleanup
        fields
        (+ index 1)))))

(define (tc-check-cleanup-struct-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [repr : ast.AstStructRepr]
  [cleanup : ast.AstStructCleanup]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (let
    [struct-name : String (tc-nominal-name-id-display name-id)]
    (if (and (ast.ast-struct-repr-c? repr) (ast.ast-struct-cleanup? cleanup))
      (Err (tc-struct-cleanup-repr-c-message struct-name))
      (tc-check-cleanup-struct-fields
        ctx
        env
        struct-name
        name-id
        cleanup
        fields))))

(define (tc-enum-payload-cleanup-outside-message
  [enum-name : String]
  [variant-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " has payload cleanup metadata but enum is not cleanup-owning"))

(define (tc-enum-payload-cleanup-owning-without-owned-message
  [enum-name : String]
  [variant-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-enum-payload-owned-non-cleanup-message
  [enum-name : String]
  [variant-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-enum-payload-cleanup-fn-mismatch-message
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-check-enum-payload-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [cleanup-name : ci.InternSyntaxId]
  [payload-ty : ast.AstType]) : ResultTcUnit
  (let
    [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx enum-name-id cleanup-name-id)]
    [cleanup-ty (try (tc-lookup-visible-id ctx env lookup-name))]
    [cleanup-display : String
      (ci.intern-syntax-name-text-or cleanup-name-id "<structural-name>")]
    [_
      (try
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions payload-ty) (Unit))
          (tc-enum-payload-cleanup-fn-mismatch-message
            (tc-global-shared-view enum-name)
            (tc-global-shared-view variant-name)
            (tc-global-shared-view cleanup-display))))]
    (tc-check-cleanup-hook-safe
      env
      lookup-name
      (str_cat.str-cat "enum " enum-name " variant " variant-name)
      cleanup-display)))

(define (tc-check-cleanup-enum-payloads
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : ast.AstEnumCleanup]
  [payloads : ast.AstTypeList]
  [payload-cleanups : ast.AstVariantPayloadCleanupList]) : ResultTcUnit
  (tc-check-cleanup-enum-payloads-at
    ctx
    env
    enum-name
    enum-name-id
    variant-name
    enum-cleanup
    (& payloads)
    (& payload-cleanups)
    0))

(define (tc-check-cleanup-enum-payloads-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : ast.AstEnumCleanup]
  [payloads : (& payloads ast.AstTypeList)]
  [payload-cleanups : (& payload-cleanups ast.AstVariantPayloadCleanupList)]
  [cleanup-index : i64]) : ResultTcUnit
  (if (>= cleanup-index (ast.ast-type-list-len payloads))
    (if (>=
      cleanup-index
      (ast.ast-variant-payload-cleanup-list-len payload-cleanups))
      Ok
      (Err
        (tc-kind-message
          (ResourceOwnership)
          "typecheck: malformed enum payload cleanup metadata")))
    (if (>=
      cleanup-index
      (ast.ast-variant-payload-cleanup-list-len payload-cleanups))
      (Err
        (tc-kind-message
          (ResourceOwnership)
          "typecheck: malformed enum payload cleanup metadata"))
      (let
        [payload-cleanup : ast.AstVariantPayloadCleanup
          (ast.ast-variant-payload-cleanup-list-get
            payload-cleanups
            cleanup-index
            (ast.ast-variant-payload-cleanup-fallback))]
        [payload-ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get
              payloads
              cleanup-index
              (ast.ast-type-id-fallback)))]
        [resolved-ty : ast.AstType
          (tc-type-strip-region (tc-resolve-type ctx payload-ty))]
        [payload-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type?
            ctx
            (tc-global-shared-view resolved-ty))]
        [step : ResultTcUnit
          (if (not (ast.ast-enum-cleanup? enum-cleanup))
            (if (ast.ast-variant-payload-cleanup? payload-cleanup)
              (Err
                (tc-enum-payload-cleanup-outside-message
                  (tc-global-shared-view enum-name)
                  (tc-global-shared-view variant-name)))
              (if payload-cleanup-owning
                (Err
                  (tc-enum-payload-cleanup-owning-without-owned-message
                    (tc-global-shared-view enum-name)
                    (tc-global-shared-view variant-name)
                    resolved-ty))
                Ok))
            (match payload-cleanup
              [(Owned)
                (if payload-cleanup-owning
                  Ok
                  (Err
                    (tc-enum-payload-owned-non-cleanup-message
                      (tc-global-shared-view enum-name)
                      (tc-global-shared-view variant-name)
                      resolved-ty)))]
              [(Fn cleanup-name)
                (if payload-cleanup-owning
                  (Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      (tc-global-shared-view enum-name)
                      (tc-global-shared-view variant-name)
                      resolved-ty))
                  (tc-check-enum-payload-cleanup-fn
                    ctx
                    env
                    (tc-global-shared-view enum-name)
                    enum-name-id
                    (tc-global-shared-view variant-name)
                    cleanup-name
                    resolved-ty))]
              [(No)
                (if payload-cleanup-owning
                  (Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      (tc-global-shared-view enum-name)
                      (tc-global-shared-view variant-name)
                      resolved-ty))
                  Ok)]))]
        [_ (try step)]
        (tc-check-cleanup-enum-payloads-at
          ctx
          env
          enum-name
          enum-name-id
          variant-name
          enum-cleanup
          payloads
          payload-cleanups
          (+ cleanup-index 1))))))

(define (tc-check-cleanup-enum-variant
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variant : ast.AstVariantDef]) : ResultTcUnit
  (match variant
    [(Def variant-name payloads payload-cleanups)
      (tc-check-cleanup-enum-payloads
        ctx
        env
        enum-name
        enum-name-id
        (ci.intern-str variant-name)
        cleanup
        payloads
        payload-cleanups)]))

(define (tc-check-cleanup-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (tc-check-cleanup-enum-variants-at
    ctx
    env
    enum-name
    enum-name-id
    cleanup
    (& variants)
    0))

(define (tc-check-cleanup-enum-variants-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    Ok
    (let
      [_
        (try
          (tc-check-cleanup-enum-variant
            ctx
            env
            (tc-global-shared-view enum-name)
            enum-name-id
            cleanup
            (ast.ast-variant-def-list-get
              variants
              index
              (ast.ast-variant-def-fallback))))]
      (tc-check-cleanup-enum-variants-at
        ctx
        env
        enum-name
        enum-name-id
        cleanup
        variants
        (+ index 1)))))

(define (tc-check-cleanup-enum-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [_lifetimes : ast.AstLifetimeList]
  [cleanup : ast.AstEnumCleanup]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (let
    [enum-name : String (tc-nominal-name-id-display name-id)]
    ;; The declared cleanup name denotes the function synthesized by lowering.
    ;; Validate payload cleanup requirements without looking for a user body.
    (tc-check-cleanup-enum-variants ctx env enum-name name-id cleanup variants)))

(define (tc-check-fn-params-from-types-at
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstParamList)]) : unit
  (unless
    (>= index (ast.ast-param-list-len params))
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ mutable?)
        (ast.ast-param-list-push
          out
          (ast.AstParam.Param
            name
            (tc-context-type-get
              ctx
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
            mutable?))])
    (tc-check-fn-params-from-types-at ctx params types (+ index 1) out)))

(define (tc-check-fn-params-from-types
  [ctx : TcContext]
  [params : ast.AstParamList]
  [types : ast.AstTypeList]) : ast.AstParamList
  (let
    [out : ast.AstParamList
      (ast.ast-param-list-with-capacity (ast.ast-param-list-len (& params)))]
    (tc-check-fn-params-from-types-at ctx (& params) (& types) 0 (&mut out))
    out))

(define (tc-check-fn-registered-params
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]) : ast.AstParamList
  (match (tc-lookup-persistent-id global-env name)
    [(Ok (Func types _))
      (let
        [registered : ast.AstTypeList (ast.ast-type-list-box-shared-view types)]
        (if (=
          (ast.ast-type-list-len (& registered))
          (ast.ast-param-list-len (& params)))
          (tc-check-fn-params-from-types ctx params registered)
          params))]
    [_ params]))

;: Check one function declaration's body against its registered signature.
(define (tc-check-fn-decl-body
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
    [registered-params : ast.AstParamList
      (tc-check-fn-registered-params ctx global-env name params)]
    [resolved-ret : ast.AstType
      (tc-resolve-type ctx (tc-global-shared-view ret))]
    [_semantic-function-enter : unit
      (when
        (and
          (> tc-semantic-observed-jobs 0)
          (!= (tc-context-semantic-observer ctx).address 0))
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ctx)
          ctx
          global-env
          (FunctionEnter
            name
            body-box
            (tc-global-shared-view registered-params)
            (Some (tc-global-shared-view resolved-ret))))
        (tc-scoped-state-set-semantic-observer!
          (tc-job-state-type-env-scoped-state (tc-context-job-state ctx))
          (tc-context-semantic-observer ctx)))]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-bind-return-type
        (tc-type-env-scoped-carrier-bind-params
          ctx
          (tc-type-env-scoped-carrier-from-env global-env)
          registered-params)
        (tc-global-shared-view resolved-ret))]
    [env : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
    ;; The scoped carrier keeps parameters out of the persistent spine. Final
    ;; result matching runs after the carrier is restored, so retain an ordinary
    ;; environment for lifetime-outlives queries at that boundary.
    [comparison-env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx global-env registered-params)
        (tc-global-shared-view resolved-ret))]
    [scoped-save : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter! carrier)]
    [body-state : TcBodyState (tc-context-body-state ctx)]
    [semantic-observer : TcSemanticObserver
      (if (= tc-semantic-observed-jobs 0)
        (TcSemanticObserver 0)
        (tc-context-semantic-observer ctx))]
    [typed-result : ResultTcType
      (begin
        (tc-body-early-exit-function-start! body-state)
        (tc-body-type-facts-start-recording! body-state)
        (tc-expr-with-expected-or-actual-id
          ctx
          env
          body-box
          (tc-global-shared-view resolved-ret)))]
    [_semantic-function-leave : unit
      (when
        (!= semantic-observer.address 0)
        (tc-semantic-observer-send!
          semantic-observer
          ctx
          env
          (FunctionLeave (tc-global-shared-view typed-result)))
        (tc-scoped-state-set-semantic-observer!
          (tc-job-state-type-env-scoped-state (tc-context-job-state ctx))
          (TcSemanticObserver 0))
        (tc-context-set-semantic-observer! ctx (TcSemanticObserver 0)))]
    [_scoped-restored : unit (tc-type-env-scoped-runtime-restore! scoped-save)]
    [result : ResultTcUnit
      (match typed-result
        [(Ok inferred)
          (let
            [matched-got : TcInferredTypeMatch
              (tc-match-inferred-type-for-expected
                ctx
                comparison-env
                inferred
                (tc-global-shared-view resolved-ret))]
            [got : ast.AstType
              (match (tc-global-shared-view matched-got)
                [(or (Compatible actual) (Mismatch actual)) actual])]
            [expect-result : ResultTcUnit
              (match matched-got
                [(Compatible _) Ok]
                [(Mismatch actual)
                  (Err
                    (tc-type-mismatch-message-in-context
                      ctx
                      comparison-env
                      actual
                      (tc-global-shared-view resolved-ret)
                      "typecheck: return type mismatch"))])]
            (tc-body-type-facts-start-consuming! body-state)
            (match expect-result
              [(Ok)
                (match (tc-ensure-region-value-can-flow-into
                  env
                  (tc-global-shared-view resolved-ret)
                  (tc-global-shared-view got)
                  "return value")
                  [(Ok)
                    (match (tc-move-check-body-id
                      ctx
                      (tc-context-expr-bases ctx)
                      env
                      registered-params
                      body-box
                      resolved-ret)
                      [(Ok)
                        (let
                          [result : ResultTcUnit
                            (tc-borrow-check-body-id-with-ret
                              ctx
                              (tc-context-expr-bases ctx)
                              env
                              registered-params
                              ret
                              body-box)]
                          (match (& result)
                            [(Ok)
                              (tc-body-early-exit-function-finish!
                                body-state
                                body-box)]
                            [(Err _) unit])
                          (tc-body-type-facts-clear! body-state)
                          result)]
                      [(Err message)
                        (tc-body-type-facts-clear! body-state)
                        (Err message)])]
                  [(Err message)
                    (tc-body-type-facts-clear! body-state)
                    (Err
                      (let
                        [moved : String
                          (tc-move-out-of-reference-error
                            ctx
                            (tc-context-expr-bases ctx)
                            env
                            (tc-body-tail-expr
                              (tc-context-expr-bases ctx)
                              (tc-global-shared-view body))
                            (tc-global-shared-view got)
                            "return an owned clone, or return a reference tied to a parameter's lifetime")]
                        (if (> (string.string-length moved) 0)
                          moved
                          (tc-rich-escape-at-expr
                            (tc-context-expr-bases ctx)
                            body
                            message
                            "function return type rejects this escaping value"))))])]
              [(Err message)
                (tc-body-type-facts-clear! body-state)
                (Err message)]))]
        [(Err message)
          (tc-body-type-facts-clear! body-state)
          (Err message)])]
    (when
      (!= semantic-observer.address 0)
      (tc-context-set-semantic-observer! ctx semantic-observer))
    result))

;; Reusable scratch arena for per-function-body typechecks. Mirrors
;; lower-scratch-arena: created lazily, shared by every check in one job (the
;; body walk is never re-entrant into another function-decl check), reclaimed
;; by mark/rewind per check.
(define (tc-fn-scratch-arena-get [state : TcScratchArenaState]) : i64
  (let
    [data : (MutPtr TcScratchArenaStateData) (tc-scratch-arena-state-ptr state)]
    [return-arena : i64 (arena.tl_arena_current)]
    (unsafe
      (if (= (deref data).fn-arena 0)
        (let
          [scratch : i64 (arena.tl_arena_make_small)]
          (set! (deref data).fn-arena scratch)
          (set! (deref data).fn-return-arena return-arena)
          scratch)
        (begin
          (set! (deref data).fn-return-arena return-arena)
          (deref data).fn-arena)))))

(define (tc-fn-scratch-arena-release! [state : TcScratchArenaState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcScratchArenaStateData)
        (tc-scratch-arena-state-ptr state)]
      [scratch : i64 (deref data).fn-arena]
      (unless
        (= scratch 0)
        (if (= (arena.tl_arena_current) scratch)
          (arena.tl_arena_set (deref data).fn-return-arena)
          unit)
        (arena.tl_arena_destroy scratch)
        (set! (deref data).fn-arena 0)
        (set! (deref data).fn-return-arena 0)))))

;; A view of ENV for one function body: the parent's head, capabilities and
;; chain index, but a store of its own, created in the current arena (the
;; function scratch), whose binding and cache segments grow there too. Nothing
;; the body binds lands in the parent's owner arena.
(define (tc-type-env-fork-function-store [env : TcTypeEnv]) : TcTypeEnv
  (let
    [store : i64
      (tc-type-env-store-handle-new-with-topenv-state-address
        (__tl-project-field (tc-type-env-topenv-membership-state env) address)
        (__tl-project-field (tc-type-env-structural-session env) address)
        (__tl-project-field
          (tc-type-env-type-resolution-cache-state env)
          address))]
    (tc-chain-state-set! store (tc-chain-state-address env.store))
    (TcTypeEnv store env.head env.abi-pad)))

;; Function bodies dominate typecheck allocation and the check returns only
;; unit -- everything it allocates
;; is garbage once the body is checked, but the program-lifetime arena never
;; frees it. Run each body check through with-escape so the checker sees the
;; scratch extent and clones the error diagnostic out before rewinding (do NOT
;; re-run the check to regenerate the message -- the body check is not
;; idempotent and a second run can surface a different diagnostic). Stable-root
;; arena handles make a post-growth head recapture redundant; rewind retires
;; overflow segments itself. The interner owns new spellings at insertion, so
;; its entries survive this rewind. Node pools already grow in the persistent
;; base arena.
(define (tc-check-fn-decl-scoped
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [scratch-state : TcScratchArenaState
      (tc-job-state-scratch-arenas (tc-context-job-state ctx))]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (tc-fn-scratch-arena-get scratch-state)]
    (unsafe
      (arena.tl_arena_set scratch))
    (let
      [mark : i64 (arena.tl_region_mark)]
      [raw : ResultTcUnit
        (tc-check-fn-decl-body
          ctx
          (tc-type-env-fork-function-store global-env)
          name
          params
          ret
          body-box)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (unsafe
        (arena.tl_arena_set enclosing))
      (let
        [escaped : ResultTcUnit
          (match raw
            [(Ok) Ok]
            [(Err message)
              (Err
                (stdlib.string.copy (tc-unbound-finalize-located-error message)))])]
        [new-enclosing : i64 (arena.tl_arena_current)]
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark)
          (arena.tl_arena_set new-enclosing))
        ;; The function store and its nodes were just rewound: retire
        ;; every memo keyed by a store handle or node address, and the
        ;; unbound-name snapshot, which names a function-local env and
        ;; was consumed above.
        (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
        (tc-unbound-suggestion-snapshot-reset!)
        ;; Single-entry name caches may hold strings allocated in the
        ;; scratch that was just rewound; invalidate them before
        ;; anything can compare against freed memory.
        (tc-nominal-owner-cache-reset-for-job! (tc-context-job-state ctx))
        escaped))))

;; Reusable scratch arena for per-declaration checks that are not function
;; bodies (Def values, macros, externs, dispatches, enum/struct declarations).
;; Same mark/rewind/clone-out shape as the function-body scratch above, but a
;; SEPARATE job-owned arena so a function-body scope nested inside a
;; declaration scope (a comptime/unsafe template containing a DefFn) never
;; invalidates a live declaration mark.
(define (tc-decl-scratch-arena-get [state : TcScratchArenaState]) : i64
  (let
    [data : (MutPtr TcScratchArenaStateData) (tc-scratch-arena-state-ptr state)]
    [return-arena : i64 (arena.tl_arena_current)]
    (unsafe
      (if (= (deref data).decl-arena 0)
        (let
          [scratch : i64 (arena.tl_arena_make_small)]
          (set! (deref data).decl-arena scratch)
          (set! (deref data).decl-return-arena return-arena)
          scratch)
        (begin
          (set! (deref data).decl-return-arena return-arena)
          (deref data).decl-arena)))))

(define (tc-decl-scratch-arena-release! [state : TcScratchArenaState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcScratchArenaStateData)
        (tc-scratch-arena-state-ptr state)]
      [scratch : i64 (deref data).decl-arena]
      (unless
        (= scratch 0)
        (if (= (arena.tl_arena_current) scratch)
          (arena.tl_arena_set (deref data).decl-return-arena)
          unit)
        (arena.tl_arena_destroy scratch)
        (set! (deref data).decl-arena 0)
        (set! (deref data).decl-return-arena 0)
        (set! (deref data).decl-depth 0)))))

(define (tc-decl-scratch-depth [state : TcScratchArenaState]) : i64
  (unsafe
    (deref (tc-scratch-arena-state-view state)).decl-depth))

(define (tc-decl-scratch-depth-set! [state : TcScratchArenaState] [depth : i64]) : unit
  (unsafe
    (set! (deref (tc-scratch-arena-state-ptr state)).decl-depth depth)))

(define (tc-scratch-arena-state-release! [state : TcScratchArenaState]) : unit
  (tc-fn-scratch-arena-release! state)
  (tc-decl-scratch-arena-release! state))

;; Non-function declaration checks pin their transient env layers, CTFE eval
;; trees, and partial caches in the persistent arena for the rest of the
;; compile even though the check returns only unit. Run each such check in the
;; shared declaration scratch arena through with-escape, cloning the error
;; diagnostic out before rewind (the same shape as tc-check-fn-decl-scoped).
;; State that must persist is unaffected: env bindings are built by the
;; module-env walk outside this scope, the interner owns new spellings at
;; insertion, node pools grow in the persistent base arena, and
;; cross-declaration caches live in dedicated persistent arenas. The one
;; cross-declaration cache that cannot be rewound safely, the macro helper env,
;; is rebuilt per declaration instead (reset at the end of this scope).
(define (tc-check-decl-scoped
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (let
    [scratch-state : TcScratchArenaState
      (tc-job-state-scratch-arenas (tc-context-job-state ctx))]
    (if (> (tc-decl-scratch-depth scratch-state) 0)
      ;; Compile-time metadata and Unsafe recursively dispatch their template.
      ;; Keep nested checks in the outer declaration scope: an inner rewind
      ;; would also free an error cloned into that same scratch arena, while the
      ;; outer scope already provides the required reclamation boundary.
      (tc-check-nonfn-decl-with-global-env ctx top-env global-env decl)
      (let
        [enclosing : i64 (arena.tl_arena_current)]
        [scratch : i64 (tc-decl-scratch-arena-get scratch-state)]
        (tc-decl-scratch-depth-set! scratch-state 1)
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [mark : i64 (arena.tl_region_mark)]
          [raw : ResultTcUnit
            (tc-check-nonfn-decl-with-global-env ctx top-env global-env decl)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (unsafe
            (arena.tl_arena_set enclosing))
          (let
            [escaped : ResultTcUnit
              (match raw
                [(Ok) Ok]
                [(Err message)
                  (Err
                    (stdlib.string.copy
                      (tc-unbound-finalize-located-error message)))])]
            [new-enclosing : i64 (arena.tl_arena_current)]
            (unsafe
              (arena.tl_arena_set scratch-head)
              (arena.tl_region_reset mark)
              (arena.tl_arena_set new-enclosing))
            (tc-decl-scratch-depth-set!
              scratch-state
              (- (tc-decl-scratch-depth scratch-state) 1))
            ;; Single-entry name caches may hold strings allocated in the
            ;; scratch that was just rewound; invalidate them before
            ;; anything can compare against freed memory.
            (tc-nominal-owner-cache-reset-for-job! (tc-context-job-state ctx))
            ;; The macro helper env cache persists across declarations, but
            ;; its spine is extended with per-check partial cache layers
            ;; while a DefMacro body is checked; those layers (and any
            ;; rewind-sensitive content reached through them) must not
            ;; outlive this declaration, so rebuild the cache per
            ;; declaration inside the scratch scope.
            (tc-macro-helper-env-cache-reset! (tc-context-macro-state ctx))
            escaped))))))

(define (tc-check-decl-with-global-env-inner
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  ;; Type-name and owner caches are keyed by text/handle only. Helper passes
  ;; may typecheck with short-lived symbol tables before the final declaration
  ;; walk, so keep cache entries scoped to one checked declaration.
  (tc-nominal-owner-cache-reset-for-job! (tc-context-job-state ctx))
  (match (tc-global-shared-view decl)
    [(DefFn decl-meta name params ret body-box _)
      (let
        [signature
          (try
            (tc-elide-function-signature (tc-context-type-bases ctx) params ret))]
        (tc-check-fn-decl-scoped
          ctx
          global-env
          name
          signature.params
          signature.ret
          body-box))]
    [_ (tc-check-decl-scoped ctx top-env global-env decl)]))

(define (tc-check-nonfn-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (match decl
    [(Def decl-meta _ maybe-ty expr-box)
      (match maybe-ty
        [(Some want)
          (let
            [resolved-want : ast.AstType (tc-resolve-type ctx want)]
            [inferred
              (try
                (tc-expr-with-expected-or-actual-id
                  ctx
                  global-env
                  expr-box
                  (tc-global-shared-view resolved-want)))]
            [matched-got : TcInferredTypeMatch
              (tc-match-inferred-type-for-expected
                ctx
                global-env
                inferred
                (tc-global-shared-view resolved-want))]
            [got : ast.AstType
              (match (tc-global-shared-view matched-got)
                [(or (Compatible actual) (Mismatch actual)) actual])]
            [expect-result : ResultTcUnit
              (match matched-got
                [(Compatible _) Ok]
                [(Mismatch actual)
                  (Err
                    (tc-type-mismatch-message-in-context
                      ctx
                      global-env
                      actual
                      (tc-global-shared-view resolved-want)
                      "typecheck: value definition type mismatch"))])]
            [_ (try expect-result)]
            (let
              [_
                (try
                  (tc-ensure-region-value-can-flow-into
                    global-env
                    (tc-global-shared-view resolved-want)
                    got
                    "top-level value"))]
              (tc-move-check-global-initializer-id
                ctx
                global-env
                expr-box
                resolved-want)))]
        [(No)
          (let
            [inferred (try (tc-expr-id ctx global-env expr-box))]
            (tc-move-check-global-initializer-id
              ctx
              global-env
              expr-box
              inferred))])]
    [(DefFn decl-meta name params ret body-box _)
      ;; Unreachable via the dispatcher above; kept so a direct call can never
      ;; silently skip a function body check.
      (let
        [signature
          (try
            (tc-elide-function-signature (tc-context-type-bases ctx) params ret))]
        (tc-check-fn-decl-scoped
          ctx
          global-env
          name
          signature.params
          signature.ret
          body-box))]
    [(DefMacro decl-meta name params ret body-box)
      (let
        [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
        (tc-check-defmacro name ctx top-env params ret body))]
    [(Extern decl-meta _ kind metadata ty)
      (tc-check-extern-decl
        ctx
        kind
        (ast.ast-extern-metadata-box-shared-view metadata)
        ty)]
    [(DefDispatch decl-meta name variants)
      (let
        [_ (try (tc-dispatch-decl-type ctx name variants))]
        Ok)]
    [(DefEnum decl-meta name cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        (ast.ast-lifetime-list-new)
        cleanup
        variants)]
    [(DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        lifetimes
        cleanup
        variants)]
    [(or (DefStruct _ name repr cleanup fields)
         (DefStructLifetimes _ name _ repr cleanup fields))
      (tc-check-cleanup-struct-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        repr
        cleanup
        fields)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (tc-check-decl-with-global-env ctx top-env global-env inner))]
    [_ Ok]))

(define (tc-check-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (tc-unbound-suggestion-snapshot-reset!)
  (if (ast.ast-decl-comptime-only? decl)
    (let
      [template : ast.AstDecl
        (ast.ast-decl-with-meta
          (ast.ast-decl-meta-runtime-shared-view)
          (tc-global-shared-view decl))]
      (match (ast.ast-decl-generated-meta decl)
        [(Some _ _ _ _)
          (tc-check-decl-with-global-env-inner ctx top-env global-env template)]
        [(No)
          (let
            [_
              (try
                (tc-check-comptime-decl-purity
                  ctx
                  top-env
                  (tc-global-shared-view template)))]
            (tc-check-decl-with-global-env-inner
              ctx
              top-env
              global-env
              template))]))
    (tc-check-decl-with-global-env-inner ctx top-env global-env decl)))

(define (tc-check-decl-scoped-name-id [ctx : TcContext] [name : i64]) : i64
  (if (and
    (> (string.string-length (tc-context-module ctx)) 0)
    (not (tc-name-qualified-id? (tc-context-structural-session ctx) name)))
    (tc-module-name-id-by-id (tc-context-module-id ctx) name)
    name))

(define (tc-check-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (tc-check-decls-with-paths-in-module
    ctx
    top-env
    decls
    (ast.ast-decl-path-list-new)
    summary
    ""
    cbi.compiler-builtin-id-fix-empty
    (tc-empty-module-local-env-cache)))

(define (tc-decl-path-list-last [paths : ast.AstDeclPathList] [last : String]) : String
  (match (ast.ast-decl-path-list-step paths)
    [(Nil) last]
    [(Cons path rest)
      (let
        [rest : ast.AstDeclPathList rest]
        (tc-decl-path-list-last rest path))]))

(define (tc-prefix-decl-key-inner [decl : ast.AstDecl]) : String
  (match decl
    [(Module name) (str_cat.str-cat "module:" (tc-env-key-name-text name))]
    [(ModuleBody name _)
      (str_cat.str-cat "module-body:" (tc-env-key-name-text name))]
    [(Def decl-meta name _ _)
      (str_cat.str-cat "def:" (tc-env-key-name-text name))]
    [(DefFn decl-meta name _ _ _ _)
      (str_cat.str-cat "fn:" (tc-env-key-name-text name))]
    [(DefMacro decl-meta name _ _ _)
      (str_cat.str-cat "macro:" (tc-env-key-name-text name))]
    [(Extern decl-meta name _ _ _)
      (str_cat.str-cat "extern:" (tc-env-key-name-text name))]
    [(DefEnum decl-meta name _ _)
      (str_cat.str-cat "enum:" (tc-env-key-name-text name))]
    [(DefEnumLifetimes decl-meta name _ _ _)
      (str_cat.str-cat "enum-lifetimes:" (tc-env-key-name-text name))]
    [(DefStruct decl-meta name _ _ _)
      (str_cat.str-cat "struct:" (tc-env-key-name-text name))]
    [(DefStructLifetimes decl-meta name _ _ _ _)
      (str_cat.str-cat "struct-lifetimes:" (tc-env-key-name-text name))]
    [(Import decl-meta _) "import"]
    [(IncludeStr name _)
      (str_cat.str-cat "include-str:" (tc-env-key-name-text name))]
    [(IncludeStrComptime name _)
      (str_cat.str-cat "include-str-comptime:" (tc-env-key-name-text name))]
    [(IncludeStrLzss name _)
      (str_cat.str-cat "include-str-lzss:" (tc-env-key-name-text name))]
    [(IncludeBin name _)
      (str_cat.str-cat "include-bin:" (tc-env-key-name-text name))]
    [(DefDispatch decl-meta name _)
      (str_cat.str-cat "dispatch:" (tc-env-key-name-text name))]
    [(Test name _ _ _) (str_cat.str-cat "test:" (tc-env-key-name-text name))]
    [(Unsafe inner)
      (str_cat.str-cat
        "unsafe:"
        (tc-prefix-decl-key-inner (ast.ast-decl-box-shared-view inner)))]))

(define (tc-prefix-decl-key [decl : ast.AstDecl]) : String
  (if (ast.ast-decl-comptime-only? decl)
    (str_cat.str-cat "comptime:" (tc-prefix-decl-key-inner decl))
    (tc-prefix-decl-key-inner decl)))

(define (tc-prefix-key-add
  [key : String]
  [decl-path : String]
  [decl : ast.AstDecl]) : String
  (str_cat.str-cat
    key
    (string.int->string (string.string-length decl-path))
    ":"
    decl-path
    ":"
    (tc-prefix-decl-key decl)
    ";"))

(define (tc-prefix-key-add-entry-module-marker [key : String] [module : String]) : String
  (str_cat.str-cat
    key
    "entry-module:"
    (string.int->string (string.string-length module))
    ":"
    module
    ";"))

(define (tc-prefix-key-start [scope : String]) : String
  (str_cat.str-cat
    "tc-prefix-v3;"
    (string.int->string (string.string-length scope))
    ":"
    scope
    ";"))

(define (tc-prefix-default-cache-scope) : String
  "direct")

(define (tc-prefix-cache-stdlib-path? [path : String] [stdlib-roots : svec.Vec]) : bool
  (if (cload.compiler-load-stdlib-import? path)
    true
    (let
      [normalized : String (cload.compiler-load-normalize-path path)]
      (if (cload.compiler-load-stdlib-import? normalized)
        true
        (cload.compiler-load-path-under-roots-from?
          normalized
          (tc-global-shared-view stdlib-roots)
          0
          (svec.len (& stdlib-roots)))))))

(define (tc-prefix-cache-module-marker? [decl : ast.AstDecl]) : bool
  (match decl
    [(Module name) (> (string.string-length (tc-env-key-name-text name)) 0)]
    [_ false]))

(define (tc-prefix-cache-decl-safe?
  [decl-path : String]
  [decl : ast.AstDecl]
  [stdlib-roots : svec.Vec]
  [same-path-module-safe : bool]) : bool
  (if (tc-prefix-cache-stdlib-path? decl-path stdlib-roots)
    true
    (or same-path-module-safe (tc-prefix-cache-module-marker? decl))))

(define (tc-prefix-candidate-from
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [entry-path : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [active-path : String]
  [active-path-module-safe : bool]
  [key : String]) : TcPrefixCandidate
  (match (ast.ast-decl-list-step decls)
    [(Nil) (No)]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) ""])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(Nil) (ast.ast-decl-path-list-new)])]
        [same-path : bool (string.eq active-path decl-path)]
        [same-path-module-safe : bool
          (if same-path
            active-path-module-safe
            false)]
        [decl-module-safe : bool
          (or
            same-path-module-safe
            (tc-prefix-cache-module-marker? (tc-global-shared-view decl)))]
        (cond
          [(and
              (string.eq decl-path entry-path)
              (= count 0)
              (tc-prefix-cache-module-marker? (tc-global-shared-view decl)))
            (let
              [next-module : String
                (match (tc-global-shared-view decl)
                  [(Module next-module) (tc-env-key-name-text next-module)]
                  [_ module])]
              [next-module-id : i64
                (match decl
                  [(Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                (tc-global-shared-view next-module)
                next-module-id
                decl-path
                true
                (tc-prefix-key-add-entry-module-marker key next-module)))]
          [(string.eq decl-path entry-path)
            (if (> count 0)
              (Some key count module module-id)
              (No))]
          [(tc-prefix-cache-decl-safe?
              (tc-global-shared-view decl-path)
              (tc-global-shared-view decl)
              (tc-global-shared-view stdlib-roots)
              same-path-module-safe)
            (let
              [next-module : String
                (match (tc-global-shared-view decl)
                  [(Module next-module) (tc-env-key-name-text next-module)]
                  [_ module])]
              [next-module-id : i64
                (match (tc-global-shared-view decl)
                  [(Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                next-module-id
                (tc-global-shared-view decl-path)
                decl-module-safe
                (tc-prefix-key-add key decl-path decl)))]
          [(> count 0) (Some key count module module-id)]
          [else (No)]))]))

(define (tc-prefix-candidate
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : TcPrefixCandidate
  (let
    [entry-path : String
      (tc-decl-path-list-last (tc-global-shared-view paths) "")]
    [effective-roots : svec.Vec
      (cload.compiler-load-roots-with-env stdlib-roots)]
    (if (string.eq entry-path "")
      (No)
      (tc-prefix-candidate-from
        decls
        paths
        effective-roots
        entry-path
        0
        ""
        cbi.compiler-builtin-id-fix-empty
        ""
        false
        (tc-prefix-key-start cache-scope)))))

(define (tc-decl-list-take [decls : ast.AstDeclList] [count : i64]) : ast.AstDeclList
  (if (<= count 0)
    (ast.ast-decl-list-new)
    (let
      [len : i64 (ast.ast-decl-list-len (& decls))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (ast.AstDeclList decls.slots decls.offset take-count false))))

(define (tc-decl-path-list-take [paths : ast.AstDeclPathList] [count : i64]) : ast.AstDeclPathList
  (if (<= count 0)
    (ast.ast-decl-path-list-new)
    (let
      [len : i64 (ast.ast-decl-path-list-len (& paths))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (ast.AstDeclPathList
        paths.slots
        paths.owner-ids
        paths.offset
        take-count
        false))))

(define (tc-decl-list-drop [decls : ast.AstDeclList] [count : i64]) : ast.AstDeclList
  (if (<= count 0)
    decls
    (let
      [len : i64 (ast.ast-decl-list-len (& decls))]
      (if (>= count len)
        (ast.ast-decl-list-new)
        (ast.AstDeclList decls.slots (+ decls.offset count) (- len count) false)))))

(define (tc-decl-path-list-drop [paths : ast.AstDeclPathList] [count : i64]) : ast.AstDeclPathList
  (if (<= count 0)
    paths
    (let
      [len : i64 (ast.ast-decl-path-list-len (& paths))]
      (if (>= count len)
        (ast.ast-decl-path-list-new)
        (ast.AstDeclPathList
          paths.slots
          paths.owner-ids
          (+ paths.offset count)
          (- len count)
          false)))))

(define (tc-check-decls-with-paths-cold
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (cfg
      compile-profile
      (compiler-tc-decl-profile-reset (tc-context-job-state ctx)))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      decls
      paths
      summary
      ""
      cbi.compiler-builtin-id-fix-empty
      (tc-empty-module-local-env-cache))))

(define (tc-check-decls-with-prefix-hit
  [prefix-cache : TcPrefixSnapshotCacheState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-hit-for-state! prefix-cache)
    (cfg
      compile-profile
      (compiler-tc-decl-profile-reset (tc-context-job-state ctx)))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      summary
      module
      module-id
      (tc-empty-module-local-env-cache))))

(define (tc-check-decls-with-prefix-miss
  [prefix-cache : TcPrefixSnapshotCacheState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-miss-for-state! prefix-cache)
    (cfg
      compile-profile
      (compiler-tc-decl-profile-reset (tc-context-job-state ctx)))
    (match (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-take (tc-global-shared-view decls) count)
      (tc-decl-path-list-take (tc-global-shared-view paths) count)
      (CompilerTypecheckSummary 0 0 0)
      ""
      cbi.compiler-builtin-id-fix-empty
      (tc-empty-module-local-env-cache))
      [(Ok prefix-summary)
        (begin
          (tc-prefix-snapshot-cache-store-persistent-for-state
            prefix-cache
            key
            count
            (tc-global-shared-view module)
            module-id
            prefix-summary)
          (cfg
            compile-profile
            (compiler-tc-decl-profile-reset (tc-context-job-state ctx)))
          (tc-check-decls-with-paths-in-module
            ctx
            top-env
            (tc-decl-list-drop decls count)
            (tc-decl-path-list-drop paths count)
            prefix-summary
            module
            module-id
            (tc-empty-module-local-env-cache)))]
      ;; Prefix snapshots only store successful summaries. If an imported
      ;; prefix is invalid, rerun the complete walk so diagnostic recovery can
      ;; continue through later imports and the entry source.
      [(Err _)
        (tc-check-decls-with-paths-cold
          ctx
          top-env
          decls
          paths
          (CompilerTypecheckSummary 0 0 0))])))

(cfg
  compile-profile
  (define (tc-profile-surface-prefix-hit) : unit
    (cfg
      compile-profile-summary
      unit
      (io.print-error
        "compile-profile-detail|prelude.typecheck_decl_checks|0\n"))))

(define (tc-check-decls-with-surface-prefix-hit
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [count : i64]
  [module : String]
  [module-id : i64]
  [facts : surface_facts.SurfaceTypecheckFacts]) : ResultCompilerTypecheck
  (begin
    (tc-clone-root-collection-apply-surface-facts! ctx)
    (cfg compile-profile (tc-profile-surface-prefix-hit))
    (cfg
      compile-profile
      (compiler-tc-decl-profile-reset (tc-context-job-state ctx)))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      (CompilerTypecheckSummary
        facts.summary-values
        facts.summary-functions
        facts.summary-externs)
      module
      module-id
      (tc-empty-module-local-env-cache))))

(define (tc-summary-decl-prefix [decls : ast.AstDeclList] [count : i64]) : CompilerTypecheckSummary
  (let
    [cursor : ast.AstDeclList decls]
    [index : i64 0]
    [summary : CompilerTypecheckSummary (CompilerTypecheckSummary 0 0 0)]
    [done : bool false]
    (while (and (not done) (< index count))
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (set! summary (tc-summary-add-decl summary decl))
          (set! cursor rest)
          (set! index (+ index 1))]))
    summary))

(define (tc-check-decls-with-paths
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [prefix-cache-active : bool]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerTypecheck
  ;; A cached prefix contains only its summary, not semantic observations from
  ;; the declarations it skipped. Retained let facts and clone-root collection
  ;; therefore take the ordinary declaration walk even when an interactive
  ;; prefix cache is on.
  (cond
    [(or
        (not
          (or
            (= tc-semantic-observed-jobs 0)
            (= (tc-context-semantic-observer ctx).address 0)))
        (tc-checked-let-binding-facts-enabled?
          (tc-job-state-checked-let-binding-facts (tc-context-job-state ctx))))
      (tc-check-decls-with-paths-cold ctx top-env decls paths summary)]
    [(surface_facts.surface-typecheck-facts-active?)
      (match (if (surface_facts.surface-typecheck-facts-composite-active?)
        (tc-dependency-surface-prefix-candidate
          (tc-global-shared-view load-state)
          (tc-global-shared-view decls)
          (tc-global-shared-view paths)
          cache-scope
          (cload.compiler-load-session-state-dependency-surface-provenance-count
            (tc-global-shared-view load-state)))
        (tc-prefix-candidate
          (tc-global-shared-view decls)
          (tc-global-shared-view paths)
          stdlib-roots
          cache-scope))
        [(Some _ count module module-id)
          (let
            [rebased : bool
              (if (surface_facts.surface-typecheck-facts-composite-active?)
                (match (tc-summary-decl-prefix
                  (tc-global-shared-view decls)
                  count)
                  [(CompilerTypecheckSummary values functions externs)
                    (surface_facts.surface-typecheck-facts-rebase-composite-typecheck-prefix!
                      count
                      values
                      functions
                      externs)])
                true)]
            [facts : surface_facts.SurfaceTypecheckFacts
              (surface_facts.surface-typecheck-facts-current)]
            (if (and rebased (= count facts.prefix-decl-count))
              (begin
                (if (surface_facts.surface-typecheck-facts-composite-active?)
                  (cload.compiler-load-session-state-dependency-surface-note-typecheck-skip!
                    load-state
                    count)
                  unit)
                (tc-check-decls-with-surface-prefix-hit
                  ctx
                  top-env
                  decls
                  paths
                  count
                  module
                  module-id
                  facts))
              (begin
                (surface_facts.surface-typecheck-facts-clear!)
                (tc-check-decls-with-paths-cold ctx top-env decls paths summary))))]
        [(No)
          (surface_facts.surface-typecheck-facts-clear!)
          (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])]
    [(and
        prefix-cache-active
        (not
          (tc-clone-root-collection-active-for-job? (tc-context-job-state ctx))))
      (match (tc-prefix-candidate
        (tc-global-shared-view decls)
        (tc-global-shared-view paths)
        stdlib-roots
        cache-scope)
        [(Some key count module module-id)
          (match (tc-prefix-snapshot-cache-lookup-for-state
            prefix-cache
            (tc-global-shared-view key))
            [(Hit cached-count cached-module cached-module-id cached-summary)
              (tc-check-decls-with-prefix-hit
                prefix-cache
                ctx
                top-env
                decls
                paths
                cached-count
                cached-module
                cached-module-id
                cached-summary)]
            [(Miss)
              (tc-check-decls-with-prefix-miss
                prefix-cache
                ctx
                top-env
                decls
                paths
                key
                count
                module
                module-id)])]
        [(No) (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])]
    [else (tc-check-decls-with-paths-cold ctx top-env decls paths summary)]))

(define (tc-typecheck-diag-with-maybe-origin-and-path
  [expr-bases : i64]
  [origin : parser.CompilerParseMaybeDeclSpan]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (let
    [diag : cdiag.CompilerDiagnostic
      (tc-decl-diag-with-maybe-origin expr-bases origin decl message)]
    (cdiag.compiler-diagnostic-with-fallback-path diag path)))

(define (tc-typecheck-diag-with-path
  [expr-bases : i64]
  [decls : (& decls ast.AstDeclList)]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    expr-bases
    (parser.compiler-parse-decl-origin-span decls 0)
    decl
    path
    message))

(define (tc-typecheck-diag-with-rest-path
  [expr-bases : i64]
  [rest : (& rest ast.AstDeclList)]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    expr-bases
    (parser.compiler-parse-decl-origin-span-key-slot
      (parser.compiler-parse-decl-list-storage-key rest)
      (- rest.offset 1))
    decl
    path
    message))

;; A generated hashmap family repeats its value clone in several public
;; operations. Every site remains a semantic error for an unsupported V, but
;; one macro request should report the identical capability failure only once.
(define (tc-generated-hashmap-clone-diagnostic?
  [module : (& module str)]
  [message : (& message str)]) : bool
  (and
    (tc-diag-string-prefix? module "stdlib.hashmap.generated.")
    (tc-message-text-prefix? message "typecheck: clone unsupported type ")))

;; Direct declaration typechecking stays below the self-build memory budget and
;; avoids the per-declaration scratch arena overhead.
(defstruct TcPoisonNameList
  ;; Poisoned declarations are rare error-path state. Keep each returned value
  ;; as an independent snapshot so declaration scratch arenas cannot invalidate
  ;; or mutate a sibling snapshot.
  (slots (__tl_dyn-array i64))
  (len i64))

(defenum TcMaybePoisonName
  (No)
  (Some i64))

;; Keep construction and append as ordinary declaration boundaries.
(cfg
  compile-profile
  (define (tc-poison-name-list-new) : TcPoisonNameList
    (TcPoisonNameList (__tl_make-array i64 0) 0)))

(cfg
  compile-profile
  (define (tc-poison-name-list-push [names : TcPoisonNameList] [name : i64]) : TcPoisonNameList
    (let
      [len : i64 names.len]
      [slots : (__tl_dyn-array i64) names.slots]
      [next : (__tl_dyn-array i64) (__tl_make-array i64 (+ len 1))]
      [index : i64 0]
      (while (< index len)
        (set! (array-ref next index) (array-ref slots index))
        (set! index (+ index 1)))
      (set! (array-ref next len) name)
      (TcPoisonNameList next (+ len 1)))))

(define (tc-decl-poison-name [module-id : i64] [decl : ast.AstDecl]) : TcMaybePoisonName
  (match decl
    [(or (Def _ name _ _) (DefFn _ name _ _ _ _) (Extern _ name _ _ _)
         (DefDispatch _ name _) (DefStruct _ name _ _ _)
         (DefStructLifetimes _ name _ _ _ _))
      (Some (tc-module-name-id-by-id module-id name))]
    [(Unsafe inner)
      (tc-decl-poison-name module-id (ast.ast-decl-box-shared-view inner))]
    [_ No]))

(define (tc-poison-name-list-bind
  [env : TcTypeEnv]
  [names : (& names TcPoisonNameList)]) : TcTypeEnv
  (if (= names.len 0)
    env
    (let
      [index : i64 0]
      [out : TcTypeEnv env]
      ;; Slots are appended oldest to newest, matching the former recursive
      ;; bind order and its duplicate-name shadowing behavior.
      (while (< index names.len)
        (set!
          out
          (tc-bind-id out (array-ref names.slots index) (tc-poison-type)))
        (set! index (+ index 1)))
      out)))

(define (tc-poison-decl-env
  [env : TcTypeEnv]
  [module-id : i64]
  [decl : ast.AstDecl]) : TcTypeEnv
  (match (tc-decl-poison-name module-id decl)
    [(No) env]
    [(Some name) (tc-bind-id env name (tc-poison-type))]))

(define (tc-poison-name-list-add-decl
  [names : TcPoisonNameList]
  [module-id : i64]
  [decl : ast.AstDecl]) : TcPoisonNameList
  (match (tc-decl-poison-name module-id decl)
    [(No) names]
    [(Some name)
      (cfg
        compile-profile
        (tc-poison-name-list-push names name)
        (let
          [len : i64 names.len]
          [slots : (__tl_dyn-array i64) names.slots]
          [next : (__tl_dyn-array i64) (__tl_make-array i64 (+ len 1))]
          [index : i64 0]
          (while (< index len)
            (set! (array-ref next index) (array-ref slots index))
            (set! index (+ index 1)))
          (set! (array-ref next len) name)
          (TcPoisonNameList next (+ len 1))))]))

;; Generated clone-root helper declarations are already proven by the clone
;; pipeline and deliberately bypass the ordinary declaration checker. Tooling
;; uses the same predicate to avoid demanding checked body facts that cannot
;; exist for this lane.
(define (tc-decl-unchecked-clone? [path : String] [decl : ast.AstDecl]) : bool
  (and
    (string.eq path "")
    (match decl
      [(DefFn _ name _ _ _ _)
        (let
          [name-text : String (tc-env-key-name-text name)]
          (and
            (>= (string.string-length name-text) 6)
            (string.eq (string.substring name-text 0 6) "clone$")))]
      [_ false])))

(define (tc-check-decls-with-paths-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]) : ResultCompilerTypecheck
  (match (tc-module-local-env-cached-id
    ctx
    top-env
    (tc-global-shared-view module)
    module-id
    cache)
    [(Ok local-env next-cache)
      (tc-check-decls-with-paths-in-module-env
        ctx
        top-env
        decls
        paths
        summary
        module
        module-id
        next-cache
        local-env
        (tc-hygiene-global-env local-env))]
    [(Err message)
      (Err
        (box (cdiag.compiler-diagnostic-list-single (tc-diag-at-start message))))]))

(define (tc-check-decls-with-paths-in-module-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]
  [local-env : TcTypeEnv]
  [global-env : TcTypeEnv]) : ResultCompilerTypecheck
  ;; This walks every expanded top-level declaration during self-compile.
  ;; Keep it iterative so a large program does not consume one native stack frame
  ;; per declaration on Windows selfhost binaries.
  (let
    [dotted-modules : sym_i64_env.SymI64Env
      (match (tc-context-program ctx)
        [(Program decls-box)
          (__tl-project-field
            (csym.compiler-symbols-module-sets
              (ast.ast-decl-list-box-shared-view decls-box))
            dotted-modules)])]
    [cur-decls : ast.AstDeclList decls]
    [cur-paths : ast.AstDeclPathList paths]
    [cur-summary : CompilerTypecheckSummary summary]
    [cur-module-id : i64 module-id]
    [cur-module : String (string.copy module)]
    [cur-cache : TcModuleLocalEnvCache cache]
    [cur-local-env : TcTypeEnv local-env]
    [cur-global-env : TcTypeEnv global-env]
    [poison-names : TcPoisonNameList
      (cfg
        compile-profile
        (tc-poison-name-list-new)
        (TcPoisonNameList (__tl_make-array i64 0) 0))]
    [diagnostics : cdiag.CompilerDiagnosticList
      (cdiag.compiler-diagnostic-list-empty)]
    ;; Generated modules are walked contiguously. Retain the latest clone
    ;; failure's stable list index so duplicate clone sites are collapsed only
    ;; within the same generated family, never across two macro requests.
    [last-hashmap-clone-module-id : i64 -1]
    [last-hashmap-clone-diagnostic-index : i64 -1]
    [type-module-cache-valid : bool false]
    [type-module-cache-path-owner-id : i64 -1]
    [type-module-cache-id : i64 -1]
    [result : ResultCompilerTypecheck
      (Err
        (box
          (cdiag.compiler-diagnostic-list-single
            (tc-diag-at-start "typecheck: internal decls walk"))))]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cur-decls)
        [(Nil)
          (begin
            (cfg
              compile-profile
              (compiler-tc-dependency-tlci-route-profile-finish
                (tc-context-macro-state ctx)))
            (cfg
              compile-profile
              (compiler-tc-decl-profile-finish (tc-context-job-state ctx)))
            (set!
              result
              (if (= (cdiag.compiler-diagnostic-list-count diagnostics) 0)
                (Ok cur-summary)
                (Err (box diagnostics))))
            (set! done true))]
        [(Cons decl rest)
          (let
            [rest : ast.AstDeclList rest]
            [decl-path : String
              (match (ast.ast-decl-path-list-step cur-paths)
                [(Cons path _) path]
                [(Nil) ""])]
            [rest-paths : ast.AstDeclPathList
              (match (ast.ast-decl-path-list-step cur-paths)
                [(Cons _ path-rest)
                  (let
                    [path-rest : ast.AstDeclPathList path-rest]
                    path-rest)]
                [(Nil) (ast.ast-decl-path-list-new)])]
            [_select-clone-root-decl : unit
              (tc-clone-root-collection-select-decl!
                ctx
                (tc-global-shared-view decl)
                cur-module-id)]
            [_select-checked-let-declaration : unit
              (tc-checked-let-binding-facts-set-current-declaration!
                (tc-job-state-checked-let-binding-facts
                  (tc-context-job-state ctx))
                (- rest.offset 1))]
            (match (tc-global-shared-view decl)
              [(Module next-module)
                (tc-context-capture-active-pools! ctx)
                (match (tc-module-local-env-cached-id
                  ctx
                  top-env
                  (tc-env-key-name-text next-module)
                  next-module
                  (tc-global-shared-view cur-cache))
                  [(Ok next-local-env next-cache)
                    (match (tc-module-local-env-cached-id
                      ctx
                      top-env
                      (tc-env-key-name-text next-module)
                      next-module
                      (tc-global-shared-view cur-cache))
                      [(Ok next-local-env-copy _)
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (set! cur-module (tc-env-key-name-text next-module))
                        (set! cur-module-id next-module)
                        (set! cur-cache next-cache)
                        (set!
                          cur-global-env
                          (tc-poison-name-list-bind
                            (tc-hygiene-global-env next-local-env)
                            poison-names))
                        (set!
                          cur-local-env
                          (tc-poison-name-list-bind
                            next-local-env-copy
                            poison-names))]
                      [(Err message)
                        (cdiag.compiler-diagnostic-list-push!
                          (&mut diagnostics)
                          (tc-typecheck-diag-with-rest-path
                            (tc-context-expr-bases ctx)
                            (& rest)
                            decl
                            decl-path
                            message))
                        (set! result (Err (box diagnostics)))
                        (set! done true)])]
                  [(Err message)
                    (cdiag.compiler-diagnostic-list-push!
                      (&mut diagnostics)
                      (tc-typecheck-diag-with-rest-path
                        (tc-context-expr-bases ctx)
                        (& rest)
                        decl
                        decl-path
                        message))
                    (set! result (Err (box diagnostics)))
                    (set! done true)])]
              [_
                (if (tc-decl-unchecked-clone?
                  (tc-global-shared-view decl-path)
                  (tc-global-shared-view decl))
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-summary (tc-summary-add-decl cur-summary decl)))
                  (let
                    [decl-base-ctx : TcContext
                      (tc-context-with-module-id
                        ctx
                        (tc-global-shared-view cur-module)
                        cur-module-id)]
                    [path-owner-id : i64
                      (ast.ast-decl-path-list-owner-id
                        (& cur-paths)
                        0
                        cbi.compiler-builtin-id-fix-empty)]
                    [type-module-id : i64
                      (if (and
                        (csym.compiler-symbol-root-module-id? cur-module-id)
                        (not (ast.ast-decl-comptime-only? decl))
                        (not
                          (macro-decl-generated? (tc-global-shared-view decl))))
                        (if (and
                          type-module-cache-valid
                          (= path-owner-id type-module-cache-path-owner-id))
                          type-module-cache-id
                          (let
                            [resolved-type-module-id : i64
                              (tc-context-type-module-id-for-path-owner
                                dotted-modules
                                decl-path
                                path-owner-id)]
                            (set! type-module-cache-valid true)
                            (set! type-module-cache-path-owner-id path-owner-id)
                            (set! type-module-cache-id resolved-type-module-id)
                            resolved-type-module-id))
                        -1)]
                    [decl-ctx : TcContext
                      (if (>= type-module-id 0)
                        (tc-context-with-type-module-id
                          decl-base-ctx
                          type-module-id)
                        decl-base-ctx)]
                    [unused-unsafe : TcUnusedUnsafeState
                      (tc-job-state-unused-unsafe
                        (tc-context-job-state decl-ctx))]
                    [prev-path : String
                      (tc-unused-unsafe-set-current-path!
                        unused-unsafe
                        (tc-global-shared-view decl-path))]
                    (tc-context-capture-active-pools! decl-ctx)
                    (tc-poison-observation-reset!)
                    (when
                      (!= (tc-context-semantic-observer decl-ctx).address 0)
                      (tc-body-type-facts-start-recording!
                        (tc-context-body-state decl-ctx))
                      (tc-semantic-observer-send!
                        (tc-context-semantic-observer decl-ctx)
                        decl-ctx
                        cur-local-env
                        (Declaration
                          (parser.compiler-parse-decl-list-storage-key
                            (& cur-decls))
                          cur-decls.offset
                          (tc-global-shared-view decl-path)
                          (tc-global-shared-view decl))))
                    (match (tc-check-decl-with-global-env
                      decl-ctx
                      cur-local-env
                      cur-global-env
                      (tc-global-shared-view decl))
                      [(Ok)
                        (tc-unused-unsafe-restore-current-path!
                          unused-unsafe
                          prev-path)
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (if tc-poison-observed
                          (begin
                            (set!
                              cur-local-env
                              (tc-poison-decl-env
                                cur-local-env
                                cur-module-id
                                (tc-global-shared-view decl)))
                            (set!
                              cur-global-env
                              (tc-poison-decl-env
                                cur-global-env
                                cur-module-id
                                (tc-global-shared-view decl)))
                            (set!
                              poison-names
                              (tc-poison-name-list-add-decl
                                poison-names
                                cur-module-id
                                decl)))
                          (begin
                            (cfg
                              compile-profile
                              (compiler-tc-decl-profile-record
                                (tc-context-macro-state ctx)
                                (tc-global-shared-view decl)))
                            (set!
                              cur-summary
                              (tc-summary-add-decl cur-summary decl))))]
                      [(Err message)
                        (tc-unused-unsafe-restore-current-path!
                          unused-unsafe
                          prev-path)
                        (if tc-poison-observed
                          unit
                          (let
                            [decl-diag : cdiag.CompilerDiagnostic
                              (tc-typecheck-diag-with-rest-path
                                (tc-context-expr-bases ctx)
                                (& rest)
                                (tc-global-shared-view decl)
                                decl-path
                                message)]
                            [diag-message : String
                              (cdiag.compiler-diagnostic-message (& decl-diag))]
                            [hashmap-clone : bool
                              (tc-generated-hashmap-clone-diagnostic?
                                cur-module
                                diag-message)]
                            [duplicate-hashmap-clone : bool
                              (and
                                hashmap-clone
                                (= cur-module-id last-hashmap-clone-module-id)
                                (>= last-hashmap-clone-diagnostic-index 0)
                                (string.eq
                                  (cdiag.compiler-diagnostic-message-ref
                                    (cdiag.compiler-diagnostic-list-ref
                                      (& diagnostics)
                                      last-hashmap-clone-diagnostic-index))
                                  (& diag-message)))]
                            (unless
                              duplicate-hashmap-clone
                              (when
                                hashmap-clone
                                (set!
                                  last-hashmap-clone-module-id
                                  cur-module-id)
                                (set!
                                  last-hashmap-clone-diagnostic-index
                                  (cdiag.compiler-diagnostic-list-count
                                    diagnostics)))
                              (cdiag.compiler-diagnostic-list-push!
                                (&mut diagnostics)
                                decl-diag))))
                        (set!
                          cur-local-env
                          (tc-poison-decl-env
                            cur-local-env
                            cur-module-id
                            (tc-global-shared-view decl)))
                        (set!
                          cur-global-env
                          (tc-poison-decl-env
                            cur-global-env
                            cur-module-id
                            (tc-global-shared-view decl)))
                        (set!
                          poison-names
                          (tc-poison-name-list-add-decl
                            poison-names
                            cur-module-id
                            decl))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)])))]))]))
    result))

(define (tc-typecheck-specialized-program-checked-inner
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [body-state : TcBodyState]
  [semantic-observer : TcSemanticObserver]) : ResultCompilerTypecheckChecked
  (tc-prefix-snapshot-cache-prepare-for-job!
    prefix-cache
    (tc-prefix-snapshot-cache-provenance-from-job load-state pools source-names))
  (tc-nominal-owner-cache-reset-for-job! body-state.job-state)
  (tc-install-pools! pools)
  (match (csym.build-compiler-symbols-diagnostic-with-paths
    (tc-global-shared-view program)
    (tc-global-shared-view paths))
    [(Ok symbols)
      (match (csym.build-compiler-registries-diagnostic-with-symbols-and-paths
        (tc-global-shared-view program)
        (csym.compiler-symbols-shared-view (& symbols))
        (tc-global-shared-view paths))
        [(Ok registries)
          (let
            [ctx : TcContext
              (tc-context-new-with-source-names-and-body-state
                (tc-global-shared-view program)
                symbols
                registries
                ""
                cbi.compiler-builtin-id-fix-empty
                pools
                source-names
                body-state
                semantic-observer)]
            (match (tc-stdlib-comptime-surface-ok ctx)
              [(Ok)
                (match (tc-program-source-types-policy-ok
                  ctx
                  (tc-global-shared-view program)
                  (tc-global-shared-view paths))
                  [(Ok)
                    (match (tc-build-top-env
                      ctx
                      (tc-global-shared-view program))
                      [(Ok top-env)
                        (match program
                          [(Program decls-box)
                            (let
                              [decls : ast.AstDeclList
                                (ast.ast-decl-list-box-shared-view decls-box)]
                              (tc-hygiene-reset-active-top-env!
                                (tc-context-macro-state ctx)
                                top-env)
                              (tc-context-capture-active-pools! ctx)
                              (tc-clone-able-cache-populate! ctx)
                              (tc-macro-helper-env-cache-reset!
                                (tc-context-macro-state ctx))
                              (match (tc-check-decls-with-paths
                                (tc-global-shared-view load-state)
                                (tc-global-shared-view prefix-cache)
                                (tc-prefix-snapshot-cache-active-for-state?
                                  prefix-cache
                                  load-state)
                                ctx
                                top-env
                                decls
                                (tc-global-shared-view paths)
                                (CompilerTypecheckSummary 0 0 0)
                                stdlib-roots
                                cache-scope)
                                [(Ok summary)
                                  (tc-context-capture-active-pools! ctx)
                                  (Ok summary ctx top-env paths)]
                                [(Err diag)
                                  (tc-context-capture-active-pools! ctx)
                                  (Partial diag ctx top-env paths)]))])]
                      [(Err message)
                        (Err
                          (box
                            (cdiag.compiler-diagnostic-list-single
                              (tc-diag-at-start message))))])]
                  [(Err diag)
                    (Err (cdiag.compiler-diagnostic-list-box-single diag))])]
              [(Err message)
                (Err
                  (box
                    (cdiag.compiler-diagnostic-list-single
                      (tc-diag-at-start message))))]))]
        [(Err diag) (Err (cdiag.compiler-diagnostic-list-box-single diag))])]
    [(Err diag) (Err (cdiag.compiler-diagnostic-list-box-single diag))]))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names-and-prefix-cache-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state-input : ci.InternCompatState]) : ResultCompilerTypecheckChecked
  (let
    [intern-state : ci.InternCompatState intern-state-input]
    ;; Publish owner-generated IDs before the legacy body/typecheck state runs.
    [_install-pools : unit (ast.ast-node-pool-context-install! pools)]
    [_install-intern-state : unit
      (ci.intern-compat-state-install! intern-state)]
    [_bind-source-names : unit
      (tc-macro-state-bind-source-names!
        (tc-job-state-macro-state job-state)
        source-names)]
    [job-source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names (tc-job-state-macro-state job-state))]
    [body-state : TcBodyState
      (tc-body-state-new-with-job-state-and-source-names
        job-state
        job-source-names)]
    [semantic-observer : TcSemanticObserver
      (tc-job-state-semantic-observer job-state)]
    [_start-body-state : unit
      (tc-body-early-exit-facts-start! body-state pools)]
    [checked : ResultCompilerTypecheckChecked
      (tc-typecheck-checked-result-with-pool-check
        job-state
        (tc-typecheck-specialized-program-checked-inner
          load-state
          prefix-cache
          program
          paths
          stdlib-roots
          cache-scope
          pools
          job-source-names
          body-state
          semantic-observer))]
    (ast.ast-node-pool-context-capture-active! pools)
    (ci.intern-compat-state-capture-from-globals! (&mut intern-state))
    (match checked
      [(Ok summary ctx top-env checked-paths)
        (when
          (!= semantic-observer.address 0)
          (tc-context-set-semantic-observer! ctx (TcSemanticObserver 0))
          (tc-scoped-state-set-semantic-observer!
            (tc-job-state-type-env-scoped-state job-state)
            (TcSemanticObserver 0)))
        (tc-body-early-exit-facts-finish! body-state)
        (Ok summary ctx top-env checked-paths)]
      [(Partial diag ctx top-env checked-paths)
        (when
          (!= semantic-observer.address 0)
          (tc-context-set-semantic-observer! ctx (TcSemanticObserver 0))
          (tc-scoped-state-set-semantic-observer!
            (tc-job-state-type-env-scoped-state job-state)
            (TcSemanticObserver 0)))
        ;; Recovery has completed its one declaration walk. Publish the
        ;; facts proven by that walk just like a successful check; poisoned
        ;; or unresolved expressions have no fact for index consumers.
        (tc-body-early-exit-facts-finish! body-state)
        (Partial diag ctx top-env checked-paths)]
      [(Err diag)
        (when
          (!= semantic-observer.address 0)
          (tc-scoped-state-set-semantic-observer!
            (tc-job-state-type-env-scoped-state job-state)
            (TcSemanticObserver 0)))
        (tc-body-early-exit-facts-abort! body-state)
        (Err diag)])))

(define (compiler-typecheck-clear-macro-expanded-source-caches-for-job!
  [job-state : TcJobState]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    ;; Checked lowering can retire the load/source pools before its macro pass.
    ;; Surface summaries are about to be destroyed, but lazy macro bodies may
    ;; still need their definition-site import aliases. Distill those aliases
    ;; into the id-only stub table while the summary strings are alive.
    (tc-lazy-import-surface-stubs-record-for-job! job-state)
    (tc-unbound-suggestion-snapshot-reset!)
    (tc-clone-able-cache-reset-for-job! job-state)
    (tc-macro-helper-env-cache-reset! macro-state)
    (tc-macro-module-env-cache-clear! macro-state)
    (tc-spmd-inline-helper-stack-reset-for-job! job-state)
    (tc-agg-caches-reset-for-job! job-state)
    (tc-nominal-owner-cache-reset-for-job! job-state)
    (tc-stdlib-comptime-macro-surface-ok-reset! macro-state)
    (tc-unqualified-import-ambiguity-reset!)
    (macro-alias-derived-cache-reset-for-state! macro-state)
    (cload.compiler-load-surface-summaries-reset!)
    (ctfe_support.ctfe-build-seen-reset!)
    (tc-macro-walk-set! macro-state macro-expand-active-module "")
    (macro-expand-set-macro-names! macro-state (Nil))
    (macro-expand-set-expr-type-macro-names! macro-state (Nil))
    (compiler-typecheck-ctfe-env-cache-clear! macro-state)
    (macro-live-symbols-reset! macro-state)
    (macro-live-prescan-reset! macro-state)
    (tc-hygiene-clear-active-top-env! macro-state)
    (tc-lazy-import-summary-macro-force-reset-for-state! macro-state)
    (ctfe_support.ctfe-module-macro-export-reset-for-state!
      (tc-macro-ctfe-state macro-state))
    (ctfe_support.ctfe-module-value-reflection-enable-for-state!
      (tc-macro-ctfe-state macro-state)
      false)
    (ctfe_support.ctfe-module-value-reset-for-state!
      (tc-macro-ctfe-state macro-state))
    (tc-macro-walk-set! macro-state ctfe-needs-metadata true)
    (macro-generated-module-memo-reset! macro-state)
    (macro-generated-decls-memo-reset! macro-state)))

(define (compiler-typecheck-reset-file-state-for-job-with-lazy-import-policy!
  [job-state : TcJobState]
  [preserve-lazy-imports : bool]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    (begin
      (tc-checked-let-binding-facts-finish!
        (tc-job-state-checked-let-binding-facts job-state))
      (surface_facts.surface-typecheck-facts-clear!)
      (cfg
        (any
          compiler-surface-producer
          compiler-build-identity
          embedded-stdlib-tlci)
        (surface_facts.surface-typecheck-facts-recording-abort!)
        unit)
      (tc-unbound-suggestion-snapshot-reset!)
      (tc-job-state-release-scratch-arenas! job-state)
      (tc-job-state-release-type-env-scoped-state! job-state)
      (ctfe_support.ctfe-builtin-reset!)
      (tc-clone-able-cache-reset-for-job! job-state)
      (tc-macro-helper-env-cache-reset! macro-state)
      (tc-macro-module-env-cache-clear! macro-state)
      (tc-spmd-inline-helper-stack-reset-for-job! job-state)
      (tc-agg-caches-reset-for-job! job-state)
      (tc-nominal-owner-cache-reset-for-job! job-state)
      (tc-stdlib-comptime-macro-surface-ok-reset! macro-state)
      (tc-unqualified-import-ambiguity-reset!)
      (macro-alias-derived-cache-reset-for-state! macro-state)
      (if preserve-lazy-imports
        unit
        (tc-lazy-import-stubs-reset-for-job! job-state))
      (cload.compiler-load-surface-summaries-reset!)
      (ctfe_support.ctfe-build-seen-reset!)
      (tc-hygiene-clear-active-top-env! macro-state)
      (tc-macro-walk-set! macro-state macro-expand-active-module "")
      (macro-expand-set-macro-names! macro-state (Nil))
      (macro-expand-set-expr-type-macro-names! macro-state (Nil))
      (compiler-typecheck-ctfe-env-cache-clear! macro-state)
      (macro-live-symbols-reset! macro-state)
      (macro-live-prescan-reset! macro-state)
      (tc-lazy-import-summary-macro-force-reset-for-state! macro-state)
      (ctfe_support.ctfe-module-macro-export-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (ctfe_support.ctfe-module-value-reflection-enable-for-state!
        (tc-macro-ctfe-state macro-state)
        false)
      (ctfe_support.ctfe-module-value-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (tc-macro-walk-set! macro-state ctfe-needs-metadata true))))

(define (compiler-typecheck-reset-file-state-for-job! [job-state : TcJobState]) : unit
  (compiler-typecheck-reset-file-state-for-job-with-lazy-import-policy!
    job-state
    false))

;; Package lowering and later surface/codegen phases share the same explicit
;; source-name owner. Keep their compact definition-site alias handoff while
;; dropping all other typecheck caches; a changed table or generation still
;; invalidates these ids lazily.
(define (compiler-typecheck-reset-file-state-preserving-lazy-imports-for-job!
  [job-state : TcJobState]) : unit
  (compiler-typecheck-reset-file-state-for-job-with-lazy-import-policy!
    job-state
    true))

(define (compiler-typecheck-reset-file-state!) : unit
  (compiler-typecheck-reset-file-state-for-job! (tc-serial-job-state)))

(define (compiler-typecheck-reset-intern-owned-state!) : unit
  (set! tc-signature-lifetime-marker-id-generation -1)
  (tc-source-dotted-alias-key-cache-reset!)
  (tc-source-dotted-full-path-key-cache-reset!)
  (tc-source-qualified-variant-key-cache-reset!))