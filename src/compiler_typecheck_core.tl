  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (match decl
    [(AstDecl.ModuleBody _ body-box)
      (macro-generated-surface-decls-refs
        (box-get body-box)
        aliases
        refs
        alias-qualified?)]
    [(AstDecl.Module _) refs]
    [(AstDecl.Def _ maybe-ty body)
      (macro-generated-surface-expr-refs
        (ast-node-get body)
        aliases
        (macro-generated-surface-maybe-type-refs
          maybe-ty
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefFn _ params ret body _)
      (macro-generated-surface-expr-refs
        (ast-node-get body)
        aliases
        (macro-generated-surface-type-refs
          ret
          aliases
          (macro-generated-surface-param-list-refs
            params
            aliases
            refs
            alias-qualified?)
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefMacro _ params ret body)
      (macro-generated-surface-expr-refs
        (ast-node-get body)
        aliases
        (macro-generated-surface-type-refs
          ret
          aliases
          (macro-generated-surface-macro-param-list-refs
            params
            aliases
            refs
            alias-qualified?)
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.Extern _ _ meta ty)
      (macro-generated-surface-type-refs
        ty
        aliases
        (macro-generated-surface-extern-metadata-refs
          meta
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefEnum _ cleanup variants)
      (macro-generated-surface-variant-def-list-refs
        variants
        aliases
        (macro-generated-surface-enum-cleanup-refs
          cleanup
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefEnumLifetimes _ _ cleanup variants)
      (macro-generated-surface-variant-def-list-refs
        variants
        aliases
        (macro-generated-surface-enum-cleanup-refs
          cleanup
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefStruct _ _ cleanup fields)
      (macro-generated-surface-field-def-list-refs
        fields
        aliases
        (macro-generated-surface-struct-cleanup-refs
          cleanup
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.DefStructLifetimes _ _ _ cleanup fields)
      (macro-generated-surface-field-def-list-refs
        fields
        aliases
        (macro-generated-surface-struct-cleanup-refs
          cleanup
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro call-id _)
          (macro-generated-surface-expr-refs
            (ast-node-get call-id)
            aliases
            refs
            alias-qualified?)]
        [(AstImportKind.MacroDecls call-id _)
          (macro-generated-surface-expr-refs
            (ast-node-get call-id)
            aliases
            refs
            alias-qualified?)]
        [_ refs])]
    [(AstDecl.IncludeStr _ _) refs]
    [(AstDecl.IncludeBin _ _) refs]
    [(AstDecl.DefDispatch _ _) refs]
    [(AstDecl.Test _ body _)
      (macro-generated-surface-expr-refs
        (ast-node-get body)
        aliases
        refs
        alias-qualified?)]
    [(AstDecl.Unsafe inner-box)
      (macro-generated-surface-decl-refs
        (box-get inner-box)
        aliases
        refs
        alias-qualified?)]
    [(AstDecl.ComptimeDecl meta template-box)
      (macro-generated-surface-meta-refs
        meta
        aliases
        (macro-generated-surface-decl-refs
          (box-get template-box)
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]))

(define (macro-generated-surface-decls-refs
  [decls : AstDeclList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) refs]
    [(AstDeclListStep.Cons decl rest)
      (macro-generated-surface-decls-refs
        rest
        aliases
        (macro-generated-surface-decl-refs decl aliases refs alias-qualified?)
        alias-qualified?)]))

(define (macro-generated-surface-variant-list-needed?
  [variants : AstVariantDefList]
  [needed : MacroGeneratedSurfaceNameSet]) : bool
  (macro-generated-surface-variant-list-needed-at? (& variants) needed 0))

(define (macro-generated-surface-variant-list-needed-at?
  [variants : (& variants AstVariantDefList)]
  [needed : MacroGeneratedSurfaceNameSet]
  [index : i64]) : bool
  (if (>= index (struct-get variants len))
    false
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name _ _)
        (or
          (macro-generated-surface-name-set-contains? needed (intern-str name))
          (macro-generated-surface-variant-list-needed-at?
            variants
            needed
            (+ index 1)))])))

(define (macro-generated-surface-decl-variant-needed?
  [decl : AstDecl]
  [needed : MacroGeneratedSurfaceNameSet]) : bool
  (match decl
    [(AstDecl.DefEnum _ _ variants)
      (macro-generated-surface-variant-list-needed? variants needed)]
    [(AstDecl.DefEnumLifetimes _ _ _ variants)
      (macro-generated-surface-variant-list-needed? variants needed)]
    [(AstDecl.Unsafe inner-box)
      (macro-generated-surface-decl-variant-needed? (box-get inner-box) needed)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-generated-surface-decl-variant-needed?
        (box-get template-box)
        needed)]
    [_ false]))

(define (macro-generated-surface-decl-needed?
  [decl : AstDecl]
  [needed : MacroGeneratedSurfaceNameSet]) : bool
  (or
    (macro-decl-import? decl)
    (match decl
      [(AstDecl.Module _) true]
      [(AstDecl.ModuleBody _ _) true]
      [(AstDecl.IncludeStr _ _) true]
      [(AstDecl.IncludeBin _ _) true]
      [_ false])
    (match (gen-decl-visible-name decl)
      [(SpecMaybeString.Some name)
        (macro-generated-surface-name-set-contains? needed name)]
      [(SpecMaybeString.None) false])
    (macro-generated-surface-decl-variant-needed? decl needed)))

(define (macro-generated-surface-closure-pass
  [decls : AstDeclList]
  [needed : MacroGeneratedSurfaceNameSet]) : MacroGeneratedSurfaceNameSet
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) needed]
    [(AstDeclListStep.Cons decl rest)
      (let
        [next-needed : MacroGeneratedSurfaceNameSet
          (if (macro-generated-surface-decl-needed? decl needed)
            (macro-generated-surface-decl-refs
              decl
              (macro-generated-surface-name-set-empty)
              needed
              false)
            needed)]
        (macro-generated-surface-closure-pass rest next-needed))]))

(define (macro-generated-surface-closure
  [decls : AstDeclList]
  [needed : MacroGeneratedSurfaceNameSet]) : MacroGeneratedSurfaceNameSet
  (let
    [cur : MacroGeneratedSurfaceNameSet needed]
    [done : bool false]
    (begin
      (while (not done)
        (let
          [before : i64 (macro-generated-surface-name-set-len cur)]
          [next : MacroGeneratedSurfaceNameSet
            (macro-generated-surface-closure-pass decls cur)]
          (begin
            (set! cur next)
            (set! done (= before (macro-generated-surface-name-set-len cur))))))
      cur)))

(define (macro-generated-surface-filter-decls
  [decls : AstDeclList]
  [needed : MacroGeneratedSurfaceNameSet]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (macro-generated-surface-decl-needed? decl needed)
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-generated-surface-filter
  [orig-decls : AstDeclList]
  [target-module : String]
  [alias : AstMaybeImportAlias]
  [generated-body : AstDeclList]) : AstDeclList
  (match alias
    [(AstMaybeImportAlias.Some alias-name)
      (if (string.eq alias-name "")
        generated-body
        (let
          [aliases : MacroGeneratedSurfaceNameSet
            (macro-generated-surface-aliases orig-decls target-module alias)]
          [direct : MacroGeneratedSurfaceNameSet
            (macro-generated-surface-decls-refs
              orig-decls
              aliases
              (macro-generated-surface-name-set-empty)
              true)]
          [needed : MacroGeneratedSurfaceNameSet
            (macro-generated-surface-closure generated-body direct)]
          (macro-generated-surface-filter-decls generated-body needed)))]
    [(AstMaybeImportAlias.No) generated-body]))

(define (macro-generated-surface-hashmap?
  [macro-name : String]
  [identity : String]) : bool
  (or
    (tc-string-prefix? identity "stdlib.hashmap:hashmap(")
    (tc-name-base-eq? macro-name "hashmap")))

(define (macro-generated-surface-vector?
  [module : String]
  [macro-name : String]
  [identity : String]) : bool
  ;: Vector imports are common; start with the hot env/fs fanout that motivated
  ;: #4130 so the closure pass cost stays bounded.
  (and
    (or (string.eq module "stdlib.env") (string.eq module "stdlib.fs"))
    (or
      (tc-string-prefix? identity "stdlib.vector:vector(")
      (tc-name-base-eq? macro-name "vector"))))

(define (macro-generated-surface-filtered?
  [module : String]
  [macro-name : String]
  [identity : String]) : bool
  (or
    (macro-generated-surface-hashmap? macro-name identity)
    (macro-generated-surface-vector? module macro-name identity)))

(cfg
  test
  (test
    macro-generated-surface-filter-recognizes-collection-identities
    (begin
      (test.assert-true
        (macro-generated-surface-filtered?
          "stdlib.hashmap_user"
          "hashmap"
          "stdlib.hashmap:hashmap(String i64)")
        "generated hashmap imports should use surface filtering")
      (test.assert-true
        (macro-generated-surface-filtered?
          "stdlib.env"
          "vector"
          "stdlib.vector:vector(String)")
        "hot generated vector imports should use surface filtering")
      (test.assert-false
        (macro-generated-surface-filtered?
          "stdlib.args"
          "vector"
          "stdlib.vector:vector(String)")
        "non-hot generated vector imports should keep their full surface")
      (test.assert-false
        (macro-generated-surface-filtered?
          "stdlib.other_user"
          "other"
          "stdlib.other:other(String)")
        "unlisted generated imports should keep their full surface"))))

(define (macro-call-not-macro-diag [call-expr : AstExpr]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    "typecheck: module-scope macro call does not name a macro"))

(define (macro-module-existing-collision-diag
  [call-expr : AstExpr]
  [target-module : String]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output collides with existing module "
      target-module
      " for generated identity "
      identity)))

(define (macro-module-incompatible-output-diag
  [call-expr : AstExpr]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output for generated identity "
      identity
      " has incompatible payload")))

(define (macro-expand-module-materialized
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [target-module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [body-rest : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    [surface-body : AstDeclList
      (if (macro-generated-surface-filtered? module macro-name identity)
        (macro-generated-surface-filter
          orig-decls
          target-module
          alias
          body-rest)
        body-rest)]
    [generated-body-raw : AstDeclList
      (macro-wrap-generated-decls surface-body macro-name identity)]
    [generated-body : AstDeclList
      (macro-collapse-existing-module-imports-or-original
        ctx
        top-env
        orig-decls
        target-module
        generated-body-raw
        decl-path)]
    [materialized : AstDeclList
      (ast-decl-list-prepend-builder
        (ast-decl-module target-module)
        generated-body)]
    (match (macro-find-module-body-decls orig-decls target-module)
      [(MacroMaybeDeclList.Some existing-body)
        (if (macro-decls-contain-generated-key? existing-body identity)
          (let
            [same-identity-body : AstDeclList
              (macro-decls-filter-generated-key existing-body identity)]
            ;: Exports/imports in generated module bodies are unkeyed scaffolding,
            ;: so replay compatibility compares only declarations owned by this
            ;: generated identity. Other identities may share the same module.
            [generated-key-body : AstDeclList
              (macro-decls-filter-generated-key generated-body identity)]
            [same-body? : bool
              (if (macro-decl-list-structural-eq?
                same-identity-body
                generated-key-body)
                true
                (macro-generated-key-body-replay-compatible?
                  ctx
                  top-env
                  orig-decls
                  target-module
                  decl-path
                  identity
                  (macro-decls-filter-generated-key-context
                    existing-body
                    identity)
                  (macro-decls-filter-generated-key-context
                    generated-body
                    identity)))]
            (if same-body?
              (match (macro-check-generated-import-collisions
                orig-decls
                generated-body
                module
                alias
                identity)
                [CompilerNoString
                  (let
                    [expanded : AstDeclList
                      (macro-module-replay-marker-decls
                        target-module
                        module
                        alias
                        span
                        generated-body
                        existing-body)]
                    (ResultMacroDeclExpansion.Ok
                      expanded
                      (macro-paths-for-decls expanded decl-path)))]
                [(CompilerSomeString message)
                  (ResultMacroDeclExpansion.Err
                    (box (macro-generated-import-diag span message)))])
              (ResultMacroDeclExpansion.Err
                (box (macro-module-incompatible-output-diag call-expr identity)))))
          (let
            [generated-key-body : AstDeclList
              (macro-decls-filter-generated-key generated-body identity)]
            (match (macro-generated-target-replay
              existing-body
              generated-key-body)
              [(MacroGeneratedTargetReplay.ReplayCompatible)
                (match (macro-check-generated-import-collisions
                  orig-decls
                  generated-body
                  module
                  alias
                  identity)
                  [CompilerNoString
                    (let
                      [expanded : AstDeclList
                        (macro-module-replay-marker-decls
                          target-module
                          module
                          alias
                          span
                          generated-body
                          existing-body)]
                      (ResultMacroDeclExpansion.Ok
                        expanded
                        (macro-paths-for-decls expanded decl-path)))]
                  [(CompilerSomeString message)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-generated-import-diag span message)))])]
              [(MacroGeneratedTargetReplay.ReplayIncompatible)
                (ResultMacroDeclExpansion.Err
                  (box
                    (macro-module-incompatible-output-diag call-expr identity)))]
              [(MacroGeneratedTargetReplay.NoReplay)
                (match (macro-check-generated-import-collisions
                  orig-decls
                  generated-body
                  module
                  alias
                  identity)
                  [CompilerNoString
                    (let
                      [expanded : AstDeclList
                        (macro-decl-list-append
                          materialized
                          (ast-decl-list-prepend-builder
                            (ast-decl-module module)
                            (macro-module-import-marker-decls
                              target-module
                              alias
                              span)))]
                      (ResultMacroDeclExpansion.Ok
                        expanded
                        (macro-paths-for-decls expanded decl-path)))]
                  [(CompilerSomeString message)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-generated-import-diag span message)))])])))]
      [(MacroMaybeDeclList.No)
        (match (macro-check-generated-import-collisions
          orig-decls
          generated-body
          module
          alias
          identity)
          [CompilerNoString
            (let
              [expanded : AstDeclList
                (macro-decl-list-append
                  materialized
                  (ast-decl-list-prepend-builder
                    (ast-decl-module module)
                    (macro-module-import-marker-decls target-module alias span)))]
              (ResultMacroDeclExpansion.Ok
                expanded
                (macro-paths-for-decls expanded decl-path)))]
          [(CompilerSomeString message)
            (ResultMacroDeclExpansion.Err
              (box (macro-generated-import-diag span message)))])])))

(define (macro-expand-module-generated-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [definition-module : String]
  [macro-env : CtfeEnv]
  [rewrite-imports? : bool]
  [generated : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    [module-count : i64 (macro-decls-module-count generated)]
    (if (= module-count 0)
      (ResultMacroDeclExpansion.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Module macro output must include a module declaration")))
      (if (> module-count 1)
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: Module macro output must include exactly one module declaration")))
        (match (ast-decl-list-step generated)
          [(AstDeclListStep.Cons first body-rest-box)
            (match first
              [(AstDecl.ModuleBody target-module-id body-box)
                (match (ast-decl-list-step body-rest-box)
                  [(AstDeclListStep.Nil)
                    (let
                      [target-module : String (intern-str target-module-id)]
                      [body-rest : AstDeclList
                        (macro-flatten-module-body-decls-in-module
                          (box-get body-box)
                          target-module)]
                      [contextual-body : AstDeclList
                        (macro-generated-context-decls
                          body-rest
                          definition-module)]
                      [final-body : AstDeclList
                        (if rewrite-imports?
                          (let
                            [rewrite-decls : AstDeclList
                              (ast-decl-list-prepend-builder
                                (ast-decl-module target-module)
                                contextual-body)]
                            [lookup-decls : AstDeclList
                              (macro-decl-list-append orig-decls rewrite-decls)]
                            (macro-rewrite-generated-import-decls
                              (tc-context-with-module ctx target-module)
                              lookup-decls
                              target-module
                              definition-module
                              macro-env
                              contextual-body))
                          contextual-body)]
                      (macro-expand-module-materialized
                        ctx
                        top-env
                        orig-decls
                        module
                        target-module
                        alias
                        span
                        decl-path
                        macro-name
                        identity
                        final-body
                        call-expr))]
                  [_
                    (ResultMacroDeclExpansion.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: Module macro output must include exactly one module declaration")))])]
              [(AstDecl.Module target-module-id)
                (let
                  [target-module : String (intern-str target-module-id)]
                  [body-rest : AstDeclList
                    (macro-flatten-module-body-decls-in-module
                      body-rest-box
                      target-module)]
                  [contextual-body : AstDeclList
                    (macro-generated-context-decls body-rest definition-module)]
                  [final-body : AstDeclList
                    (if rewrite-imports?
                      (let
                        [rewrite-decls : AstDeclList
                          (ast-decl-list-prepend-builder
                            (ast-decl-module target-module)
                            contextual-body)]
                        [lookup-decls : AstDeclList
                          (macro-decl-list-append orig-decls rewrite-decls)]
                        (macro-rewrite-generated-import-decls
                          (tc-context-with-module ctx target-module)
                          lookup-decls
                          target-module
                          definition-module
                          macro-env
                          contextual-body))
                      contextual-body)]
                  (macro-expand-module-materialized
                    ctx
                    top-env
                    orig-decls
                    module
                    target-module
                    alias
                    span
                    decl-path
                    macro-name
                    identity
                    final-body
                    call-expr))]
              [_
                (ResultMacroDeclExpansion.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro output must start with a module declaration")))])]
          [(AstDeclListStep.Nil)
            (ResultMacroDeclExpansion.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  "typecheck: Module macro output must include a module declaration")))])))))

(define (macro-expand-decls-splice
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module)
              (let
                [call-ctx : TcContext (tc-context-with-module ctx module)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (if (tc-macro-result-decls? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            macro-name
                            definition-module
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (if (macro-vector-family-decls-macro?
                                macro-name
                                definition-module)
                                (let
                                  [fast-result : ResultMacroParsedDecls
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-start))
                                      (macro-vector-family-fast-decls
                                        call-ctx
                                        orig-decls
                                        call-module
                                        expanded-args
                                        call-expr))]
                                  (begin
                                    (cfg
                                      compile-profile
                                      (compiler-tc-macro-profile-finish
                                        macro-name
                                        expanded-args))
                                    (match fast-result
                                      [(ResultMacroParsedDecls.Ok generated)
                                        (let
                                          [contextual-generated : AstDeclList
                                            (macro-generated-context-decls
                                              generated
                                              definition-module)]
                                          [flattened-generated : AstDeclList
                                            (macro-flatten-module-body-decls-in-module
                                              contextual-generated
                                              module)]
                                          [wrapped : AstDeclList
                                            (macro-wrap-generated-decls-decls
                                              flattened-generated
                                              macro-name
                                              (macro-decls-generated-key
                                                identity))]
                                          (ResultMacroDeclExpansion.Ok
                                            wrapped
                                            (macro-paths-for-decls
                                              wrapped
                                              decl-path)))]
                                      [(ResultMacroParsedDecls.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)])))
                                (match (macro-eval-transformer-expanded-with-env
                                  call-ctx
                                  orig-decls
                                  definition-module
                                  global-env
                                  macro-name
                                  params
                                  body
                                  expanded-args
                                  call-expr)
                                  [(ResultMacroValueEnv.Ok value macro-env)
                                    (let
                                      [parse-dispatch : sym_i64_env.SymI64Env
                                        (macro-parse-dispatch-for-macro
                                          macro-name
                                          definition-module)]
                                      (match (macro-decls-from-ctfe-value
                                        value
                                        call-expr
                                        parse-dispatch)
                                        [(ResultMacroParsedDecls.Ok generated)
                                          (let
                                            [generated : AstDeclList
                                              (if (tc-macro-param-list-needs-call-context?
                                                params)
                                                (macro-rewrite-generated-import-decls
                                                  call-ctx
                                                  orig-decls
                                                  module
                                                  definition-module
                                                  macro-env
                                                  generated)
                                                generated)]
                                            [contextual-generated : AstDeclList
                                              (macro-generated-context-decls
                                                generated
                                                definition-module)]
                                            [flattened-generated : AstDeclList
                                              (macro-flatten-module-body-decls-in-module
                                                contextual-generated
                                                module)]
                                            [wrapped : AstDeclList
                                              (macro-wrap-generated-decls-decls
                                                flattened-generated
                                                macro-name
                                                (macro-decls-generated-key
                                                  identity))]
                                            (ResultMacroDeclExpansion.Ok
                                              wrapped
                                              (macro-paths-for-decls
                                                wrapped
                                                decl-path)))]
                                        [(ResultMacroParsedDecls.Err diag)
                                          (ResultMacroDeclExpansion.Err diag)]))]
                                  [(ResultMacroValueEnv.Err diag)
                                    (ResultMacroDeclExpansion.Err diag)]))]
                            [(ResultGenKey.Err diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-module? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Module macro can only be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used at module scope")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-module-import
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module)
              (let
                [call-ctx : TcContext (tc-context-with-module ctx module)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (if (tc-macro-result-module? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            definition-module
                            macro-name
                            definition-module
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (let
                                [shortcut-target : CompilerMaybeString
                                  (if (macro-generated-identity-shortcut-safe-params?
                                    call-ctx
                                    definition-module
                                    params)
                                    (macro-generated-identity-shortcut-target
                                      orig-decls
                                      identity)
                                    CompilerNoString)]
                                (match shortcut-target
                                  [(CompilerSomeString target-module)
                                    (let
                                      [expanded : AstDeclList
                                        (macro-module-import-marker-decls
                                          target-module
                                          alias
                                          span)]
                                      (ResultMacroDeclExpansion.Ok
                                        expanded
                                        (macro-paths-for-decls
                                          expanded
                                          decl-path)))]
                                  [(CompilerNoString)
                                    (match (macro-eval-transformer-expanded-with-env
                                      call-ctx
                                      orig-decls
                                      definition-module
                                      global-env
                                      macro-name
                                      params
                                      body
                                      expanded-args
                                      call-expr)
                                      [(ResultMacroValueEnv.Ok value macro-env)
                                        (let
                                          [parse-dispatch : sym_i64_env.SymI64Env
                                            (macro-parse-dispatch-for-macro
                                              macro-name
                                              definition-module)]
                                          (match (macro-module-decls-from-ctfe-value
                                            value
                                            call-expr
                                            parse-dispatch)
                                            [(ResultMacroParsedDecls.Ok
                                                generated)
                                              (macro-expand-module-generated-decls
                                                ctx
                                                top-env
                                                orig-decls
                                                module
                                                alias
                                                span
                                                decl-path
                                                macro-name
                                                identity
                                                definition-module
                                                macro-env
                                                (tc-macro-param-list-needs-call-context?
                                                  params)
                                                generated
                                                call-expr)]
                                            [(ResultMacroParsedDecls.Err diag)
                                              (ResultMacroDeclExpansion.Err
                                                diag)]))]
                                      [(ResultMacroValueEnv.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)])]))]
                            [(ResultGenKey.Err diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-decls? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Decls macro cannot be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used as module import")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: import macro placeholder must contain a call")))])))

(define (macro-expand-decl-with-path
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [decl : AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match template
          [(AstDecl.Import (AstImportSpec.Spec kind _ _ alias span))
            (if (macro-import-placeholder-kind? kind)
              (match kind
                [(AstImportKind.Macro call-id context)
                  (macro-expand-module-import
                    ctx
                    top-env
                    orig-decls
                    module
                    call-id
                    context
                    alias
                    span
                    decl-path)]
                [(AstImportKind.MacroDecls call-id context)
                  (macro-expand-decls-splice
                    ctx
                    top-env
                    orig-decls
                    module
                    call-id
                    context
                    decl-path)]
                [_ (macro-single-decl-expansion decl decl-path)])
              (macro-single-decl-expansion decl decl-path))]
          [_
            (let
              [decl-ctx : TcContext (tc-context-with-module ctx module)]
              (if (not (macro-decl-uses-macro? decl-ctx orig-decls template))
                (macro-single-decl-expansion decl decl-path)
                (match (macro-env-for-module ctx top-env module)
                  [(ResultTcEnv.Ok local-env)
                    (match (macro-expand-decl
                      decl-ctx
                      local-env
                      orig-decls
                      template)
                      [(ResultMacroDecl.Ok expanded)
                        (macro-single-decl-expansion
                          (ast-decl-comptime-decl-with-meta meta expanded)
                          decl-path)]
                      [(ResultMacroDecl.Err diag)
                        (ResultMacroDeclExpansion.Err diag)])]
                  [(ResultTcEnv.Err message)
                    (ResultMacroDeclExpansion.Err
                      (box (tc-decl-diag template message)))])))]))]
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ alias span))
      (match kind
        [(AstImportKind.Macro call-id context)
          (macro-expand-module-import
            ctx
            top-env
            orig-decls
            module
            call-id
            context
            alias
            span
            decl-path)]
        [(AstImportKind.MacroDecls call-id context)
          (macro-expand-decls-splice
            ctx
            top-env
            orig-decls
            module
            call-id
            context
            decl-path)]
        [_ (macro-single-decl-expansion decl decl-path)])]
    [_
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (if (not (macro-decl-uses-macro? decl-ctx orig-decls decl))
          (macro-single-decl-expansion decl decl-path)
          (match (macro-env-for-module ctx top-env module)
            [(ResultTcEnv.Ok local-env)
              (match (macro-expand-decl decl-ctx local-env orig-decls decl)
                [(ResultMacroDecl.Ok expanded)
                  (macro-single-decl-expansion expanded decl-path)]
                [(ResultMacroDecl.Err diag) (ResultMacroDeclExpansion.Err diag)])]
            [(ResultTcEnv.Err message)
              (ResultMacroDeclExpansion.Err (box (tc-decl-diag decl message)))])))]))

(define (macro-module-generated-key? [key : String]) : bool
  (and
    (> (string.string-length key) 0)
    (not (tc-string-prefix? key "generated:"))))

(define (macro-decl-generated-identity [decl : AstDecl]) : CompilerMaybeString
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (match meta
        [(AstGeneratedDeclMeta.Some _ _ _ key)
          (if (macro-module-generated-key? key)
            (CompilerSomeString key)
            (macro-decl-generated-identity (box-get template-box)))]
        [(AstGeneratedDeclMeta.No)
          (macro-decl-generated-identity (box-get template-box))])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-generated-identity (box-get inner-box))]
    [_ CompilerNoString]))

(define (macro-module-generated-identity-in
  [decls : AstDeclList]
  [target-module : String]
  [module : String]) : CompilerMaybeString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) CompilerNoString]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [(AstDecl.Module next-module)
          (macro-module-generated-identity-in
            rest-box
            target-module
            (intern-str next-module))]
        [_
          (if (string.eq module target-module)
            (match (macro-decl-generated-identity decl)
              [(CompilerSomeString identity) (CompilerSomeString identity)]
              [CompilerNoString
                (macro-module-generated-identity-in
                  rest-box
                  target-module
                  module)])
            (macro-module-generated-identity-in rest-box target-module module))])]))

(define (macro-module-generated-identity
  [decls : AstDeclList]
  [target-module : String]) : CompilerMaybeString
  (macro-module-generated-identity-in decls target-module ""))

(define (macro-import-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstMaybeImportAlias.Some alias-name) (string.eq alias-name "")]
    [(AstMaybeImportAlias.No) false]))

(define (macro-module-import-request-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstMaybeImportAlias.Some alias-name) (string.eq alias-name "")]
    [(AstMaybeImportAlias.No) true]))

(define (macro-generated-import-diag [span : AstSourceSpan] [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic (compiler-diagnostic-from-ast-span "" span message)))

(define (macro-check-generated-import-collisions-in
  [all-decls : AstDeclList]
  [generated-body : AstDeclList]
  [import-module : String]
  [identity : String]) : CompilerMaybeString
  (match (ast-decl-list-step generated-body)
    [(AstDeclListStep.Nil) CompilerNoString]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [_
          (macro-check-generated-import-collisions-in
            all-decls
            rest-box
            import-module
            identity)])]))

(define (macro-check-generated-import-collisions
  [_all-decls : AstDeclList]
  [_generated-body : AstDeclList]
  [_import-module : String]
  [_alias : AstMaybeImportAlias]
  [_identity : String]) : CompilerMaybeString
  CompilerNoString)

;; Macro-expansion skip analysis (#2350-regression fix). Once any module defines
;; a macro, `has-defmacro` forces the full macro-expand walk over EVERY decl in
;; the program (all imported modules), which redundantly re-typechecks match
;; scrutinees / let bindings and rebuilds the entire AST -- ~1.7GB and >1s on a
;; self-compile. The vast majority of decls call no macro at all, so this work is
;; pure waste. These predicates detect whether a decl actually contains a macro
;; (or `when`/`unless` compat) call using the SAME resolution as the expander
;; (`macro-call-decl`), so a decl with none can be shared unchanged. They are
;; conservative: any unrecognized expression variant returns `true` (expand), so
;; a future AST node that could host a macro call is never silently skipped.
;; The callee name of a call after hygiene-stripping (but keeping any module
;; qualifier), mirroring `macro-call-decl`'s name resolution. Returns nothing for
;; non-variable callees (which `macro-call-decl` also treats as non-macro).
;; Allocation-free for plain unqualified names -- the hot path for the pre-filter.
(define (macro-call-callee-name [func : AstExpr]) : TcMaybeString
  (match func
    [(AstExpr.Spanned inner-box _)
      (macro-call-callee-name (ast-node-get inner-box))]
    [(AstExpr.Var name)
      (TcMaybeString.Some
        (if (tc-hygiene-global-name? (intern-str name))
          (match (tc-hygiene-global-decode (intern-str name))
            [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
            [(TcHygieneGlobalName.Context _ lookup-name) lookup-name])
          (intern-str name)))]
    [_ (TcMaybeString.No)]))

(define (macro-call-callee-last-dot [name : String]) : i64
  (let
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (begin
          (if (or
            (string.char-eq (string.string-ref name i) '.')
            (string.char-eq (string.string-ref name i) '/'))
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      last-dot)))

(define (macro-call-callee-base-name [name : String]) : String
  (let
    [lookup : String
      (if (tc-hygiene-global-name? name)
        (tc-hygiene-global-call-name name)
        name)]
    [source : String lookup]
    [last-dot : i64 (macro-call-callee-last-dot source)]
    [n : i64 (string.string-length source)]
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (macro-call-name-maybe-macro? [name : String]) : bool
  (let
    [base : String (macro-call-callee-base-name name)]
    (or
      (tc-string-list-contains macro-expand-macro-names base)
      (string.eq base "when")
      (string.eq base "unless"))))

(define (macro-call-callee-maybe-macro? [func : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcMaybeString.Some name) (macro-call-name-maybe-macro? name)]
    [(TcMaybeString.No) false]))

(define (macro-call-is-expandable?
  [ctx : TcContext]
  [decls : AstDeclList]
  [func : AstExpr]
  [call-expr : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcMaybeString.Some name)
      ;; Only callees whose base name matches a declared macro need precise
      ;; alias/module resolution. This keeps value-heavy dotted imports such as
      ;; `string.length` on the cheap path while still resolving qualified macro
      ;; calls through `macro-call-decl`.
      (if (macro-call-name-maybe-macro? name)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe)
            (match maybe
              [(MacroMaybeDecl.Some _ _ _ _ _) true]
              [(MacroMaybeDecl.No)
                (or (string.eq name "when") (string.eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) true])
        false)]
    [(TcMaybeString.No) false]))

(define (macro-node-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [id : i64]) : bool
  (macro-expr-uses-macro? ctx decls (ast-node-get id)))

(define (macro-exprs-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : AstExprList]) : bool
  (macro-exprs-use-macro-at? ctx decls (& exprs) 0))

(define (macro-exprs-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (macro-node-uses-macro? ctx decls (ast-expr-list-get exprs index 0))
      (macro-exprs-use-macro-at? ctx decls exprs (+ index 1)))))

(define (macro-arms-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : AstMatchArmList]) : bool
  (macro-arms-use-macro-at? ctx decls (& arms) 0))

(define (macro-arms-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (or
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm _ body-box)
          (macro-node-uses-macro? ctx decls body-box)])
      (macro-arms-use-macro-at? ctx decls arms (+ index 1)))))

(define (macro-bindings-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : AstLetBindingList]) : bool
  (macro-bindings-use-macro-at? ctx decls (& bindings) 0))

(define (macro-bindings-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (macro-node-uses-macro? ctx decls init-box)])
      (macro-bindings-use-macro-at? ctx decls bindings (+ index 1)))))

(define (macro-expr-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _) (macro-node-uses-macro? ctx decls inner-box)]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-is-expandable? ctx decls func expr)
          (macro-expr-uses-macro? ctx decls func)
          (macro-exprs-use-macro? ctx decls args)))]
    [(AstExpr.BracketClause items) (macro-exprs-use-macro? ctx decls items)]
    [(AstExpr.Binary _ l r)
      (or
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls r))]
    [(AstExpr.Unary _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.If c t e)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls t)
        (macro-node-uses-macro? ctx decls e))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (or
            (macro-bindings-use-macro? ctx decls bindings)
            (macro-node-uses-macro? ctx decls body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (macro-node-uses-macro? ctx decls body)])]
    [(AstExpr.Tuple exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.TupleRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Array exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.MakeArray _ len) (macro-node-uses-macro? ctx decls len)]
    [(AstExpr.ArrayRef a i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i))]
    [(AstExpr.ArraySet a i v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.ArrayPush a v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.StringRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.While c b)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Begin exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.Unsafe exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.Set _ rhs) (macro-node-uses-macro? ctx decls rhs)]
    [(AstExpr.Ann i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Cast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Borrow _ _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (or
            (macro-node-uses-macro? ctx decls scrut)
            (macro-arms-use-macro? ctx decls arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ s e b)
          (or
            (macro-node-uses-macro? ctx decls s)
            (macro-node-uses-macro? ctx decls e)
            (macro-node-uses-macro? ctx decls b))])]
    [(AstExpr.StructGet i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StructSet i _ v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.WithEscape i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExpr.WithScratch exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.InArena i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExpr.Box i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxGet i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxTake i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxSet i v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.Comptime i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Try i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Return i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrNullCheck i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrRead i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrWrite a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.PtrOffset a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.PtrCast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrToInt i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.IntToPtr i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StringData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StringFromBytes a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.ArrayData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEbx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEcx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEdx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Xgetbv i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Syscall exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [_ true]))

(define (macro-decl-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def _ _ expr-box) (macro-node-uses-macro? ctx decls expr-box)]
    [(AstDecl.DefFn _ _ _ body-box _)
      (macro-node-uses-macro? ctx decls body-box)]
    [(AstDecl.Test _ _ _) true]
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [(AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-uses-macro? ctx decls (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-uses-macro? ctx decls (box-get template-box))]
    [_ false]))

;; Cheap, ctx-free, allocation-free over-approximation of "could the expander
;; fire a macro/compat call anywhere inside this expression". It is used as a
;; decl-level pre-filter in `macro-expand-decls`: a decl whose body cannot fire
;; is pushed to the output unchanged (shared, never copied through the expander),
;; skipping the per-decl `tc-context-with-module` allocation and the precise
;; `macro-decl-uses-macro?` walk (which resolves candidate calls via
;; `macro-call-decl`).
;;
;; SAFE BY CONSTRUCTION (must guarantee: if the expander could rewrite a child
;; expression, `macro-expr-might-fire? = true`, i.e. we never share what the
;; expander would expand). This is achieved by following child expressions that
;; can syntactically contain calls, with explicit false leaves for non-call
;; forms.
;;   - At `AstExpr.Call` it uses `macro-call-callee-maybe-macro?` -- the registry
;;     gate the expander itself checks before attempting expansion -- which is a
;;     superset of `macro-call-is-expandable?` (it skips the `macro-call-decl`
;;     resolution and treats any registry-name callee as a possible fire). So at
;;     every call mine flags at least whatever the precise walk flags.
;;   - Scoped/container forms (for example WithRegion, WithResource, and SPMD)
;;     recurse into their child expressions here as well, so ordinary
;;     scoped/resource/vector code without macro calls does not force the full
;;     macro setup path.
;; A bare `AstExpr.Var`/`AstExpr.Set` target/`AstExpr.PtrAddrOf` is never a call ->
;; false (matching the gate). This walk covers expr/compat macros only; the call
;; site additionally gates on `has-expr-type-macros` being false (type macros
;; expand from type positions the gate does not see).
(define (macro-expr-list-might-fire? [exprs : AstExprList]) : bool
  (macro-expr-list-might-fire-at? (& exprs) 0))

(define (macro-expr-list-might-fire-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (macro-expr-might-fire? (ast-node-get (ast-expr-list-get exprs index 0)))
      (macro-expr-list-might-fire-at? exprs (+ index 1)))))

(define (macro-let-binding-list-might-fire? [bindings : AstLetBindingList]) : bool
  (macro-let-binding-list-might-fire-at? (& bindings) 0))

(define (macro-let-binding-list-might-fire-at?
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (or
            (macro-expr-might-fire? init)
            (macro-let-binding-list-might-fire-at? bindings (+ index 1))))])))

(define (macro-match-arms-might-fire? [arms : AstMatchArmList]) : bool
  (macro-match-arms-might-fire-at? (& arms) 0))

(define (macro-match-arms-might-fire-at?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (or
            (macro-expr-might-fire? body)
            (macro-match-arms-might-fire-at? arms (+ index 1))))])))

(define (macro-resource-binding-list-might-fire?
  [bindings : AstResourceBindingList]) : bool
  (macro-resource-binding-list-might-fire-at? (& bindings) 0))

(define (macro-resource-binding-list-might-fire-at?
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len bindings))
    false
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (or
            (macro-expr-might-fire? init)
            (macro-expr-might-fire? cleanup)
            (macro-resource-binding-list-might-fire-at? bindings (+ index 1))))])))

(define (macro-expr-might-fire? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-callee-maybe-macro? func)
          (macro-expr-might-fire? func)
          (macro-expr-list-might-fire? args)))]
    [(AstExpr.BracketClause items) (macro-expr-list-might-fire? items)]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or (macro-expr-might-fire? left) (macro-expr-might-fire? right)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (macro-expr-might-fire? cond)
          (macro-expr-might-fire? then-branch)
          (macro-expr-might-fire? else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-let-binding-list-might-fire? bindings)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (macro-expr-might-fire? body))])]
    [(AstExpr.Tuple exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? tuple) (macro-expr-might-fire? index)))]
    [(AstExpr.Array exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (macro-expr-might-fire? len))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? index)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (macro-expr-might-fire? array)
          (macro-expr-might-fire? index)
          (macro-expr-might-fire? value)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? value)))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? str) (macro-expr-might-fire? index)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or (macro-expr-might-fire? cond) (macro-expr-might-fire? body)))]
    [(AstExpr.Begin exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.Unsafe exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (macro-expr-might-fire? place))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (macro-expr-might-fire? scrutinee)
              (macro-match-arms-might-fire? arms)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (macro-expr-might-fire? receiver))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? receiver) (macro-expr-might-fire? value)))]
    [(AstExpr.WithRegion _ body) (macro-expr-list-might-fire? body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or (macro-expr-might-fire? scratch) (macro-expr-list-might-fire? body)))]
    [(AstExpr.WithScratch body) (macro-expr-list-might-fire? body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or (macro-expr-might-fire? arena) (macro-expr-list-might-fire? body)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (macro-resource-binding-list-might-fire? bindings)
            (macro-expr-list-might-fire? body))])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? inner) (macro-expr-might-fire? value)))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? value)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? offset)))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (macro-expr-might-fire? str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? len)))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (macro-expr-might-fire? array))]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (macro-expr-might-fire? index))]
    [(AstExpr.Syscall args) (macro-expr-list-might-fire? args)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf _) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [_ true]))

;; Decl-level companion to `macro-expr-might-fire?`. Returns true only for the
;; value-bearing decl kinds whose entire macro-expandable surface is a single
;; body expression that provably contains no fireable call -- such a decl can be
;; pushed to the macro-expand output unchanged (shared). Every other decl kind
;; returns false so it falls through to the precise `macro-expand-decl-with-path`
;; path (which shares or expands import placeholders, splices, defmacro, unsafe,
;; comptime templates, etc. correctly). Consulted only when the program has no
;; expr-type macros.
(define (macro-decl-cannot-fire? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def _ _ expr-box)
      (not (macro-expr-might-fire? (ast-node-get expr-box)))]
    [(AstDecl.DefFn _ _ _ body-box _)
      (not (macro-expr-might-fire? (ast-node-get body-box)))]
    [(AstDecl.Test _ _ _) false]
    [_ false]))

;; After an inert Decls splice, the next arbitrary macro expansion needs a
;; rebuilt top env so generated symbols are visible. Core prelude macros are
;; deterministic syntax rewrites handled by `macro-core-fast-expand`; they do
;; not inspect the top env beyond the expressions already being expanded. Let
;; the same macro pass continue through declarations whose remaining macro work
;; is limited to those fast-path rewrites (or legacy bare when/unless guards),
;; while still stopping before user CTFE/Decls/Module macros.
(define (macro-call-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [func : AstExpr]
  [call-expr : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcMaybeString.Some name)
      (if (macro-call-name-maybe-macro? name)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe-decl)
            (match maybe-decl
              [(MacroMaybeDecl.Some macro-name definition-module _ ret _)
                (and
                  (not (tc-macro-result-decls? ret))
                  (not (tc-macro-result-module? ret))
                  (or
                    (macro-array-fast-path? macro-name definition-module)
                    (and
                      (macro-core-prelude-module? definition-module)
                      (macro-core-fast-path-base-known?
                        (macro-core-fast-path-base macro-name)))
                    (macro-str-cat-fast-path? macro-name definition-module)))]
              [(MacroMaybeDecl.No)
                (or (string.eq name "when") (string.eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) false])
        true)]
    [(TcMaybeString.No) true]))

(define (macro-expr-list-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : AstExprList]) : bool
  (macro-expr-list-safe-after-inert-splice-at? ctx decls (& exprs) 0))

(define (macro-expr-list-safe-after-inert-splice-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    true
    (and
      (macro-expr-safe-after-inert-splice?
        ctx
        decls
        (ast-node-get (ast-expr-list-get exprs index 0)))
      (macro-expr-list-safe-after-inert-splice-at? ctx decls exprs (+ index 1)))))

(define (macro-let-bindings-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : AstLetBindingList]) : bool
  (macro-let-bindings-safe-after-inert-splice-at? ctx decls (& bindings) 0))

(define (macro-let-bindings-safe-after-inert-splice-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    true
    (and
      (match (ast-let-binding-list-get
        bindings
        index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get init-box))])
      (macro-let-bindings-safe-after-inert-splice-at?
        ctx
        decls
        bindings
        (+ index 1)))))

(define (macro-match-arms-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : AstMatchArmList]) : bool
  (macro-match-arms-safe-after-inert-splice-at? ctx decls (& arms) 0))

(define (macro-match-arms-safe-after-inert-splice-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    true
    (and
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm _ body-box)
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get body-box))])
      (macro-match-arms-safe-after-inert-splice-at? ctx decls arms (+ index 1)))))

(define (macro-expr-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [expr : AstExpr]) : bool
  (if (not (macro-expr-might-fire? expr))
    true
    (match expr
      [(AstExpr.Spanned inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.Literal _) true]
      [(AstExpr.Var _) true]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (and
            (macro-call-safe-after-inert-splice? ctx decls func expr)
            (macro-expr-safe-after-inert-splice? ctx decls func)
            (macro-expr-list-safe-after-inert-splice? ctx decls args)))]
      [(AstExpr.BracketClause items)
        (macro-expr-list-safe-after-inert-splice? ctx decls items)]
      [(AstExpr.Binary _ left-box right-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get left-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get right-box)))]
      [(AstExpr.Unary _ inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.If cond-box then-box else-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get cond-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get then-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get else-box)))]
      [(AstExpr.Let let-box)
        (match (box-get let-box)
          [(AstLet.Let bindings body-box)
            (and
              (macro-let-bindings-safe-after-inert-splice? ctx decls bindings)
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get body-box)))])]
      [(AstExpr.Lambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda.Lambda _ _ body-box)
            (macro-expr-safe-after-inert-splice?
              ctx
              decls
              (ast-node-get body-box))])]
      [(AstExpr.Tuple exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExpr.TupleRef tuple-box index-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get tuple-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExpr.Array exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExpr.MakeArray _ len-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get len-box))]
      [(AstExpr.ArrayRef array-box index-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExpr.ArraySet array-box index-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExpr.ArrayPush array-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExpr.StringRef str-box index-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get str-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExpr.While cond-box body-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get cond-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get body-box)))]
      [(AstExpr.Begin exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExpr.Unsafe exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExpr.Set _ value-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get value-box))]
      [(AstExpr.Ann inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.Cast inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.Borrow _ _ place-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get place-box))]
      [(AstExpr.Match match-box)
        (match (box-get match-box)
          [(AstMatch.Match scrutinee-box arms)
            (and
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get scrutinee-box))
              (macro-match-arms-safe-after-inert-splice? ctx decls arms))])]
      [(AstExpr.Foreach fe-box)
        (match (box-get fe-box)
          [(AstForeach.Foreach _ _ start-box end-box body-box)
            (and
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get start-box))
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get end-box))
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get body-box)))])]
      [(AstExpr.StructGet receiver-box _)
        (macro-expr-safe-after-inert-splice?
          ctx
          decls
          (ast-node-get receiver-box))]
      [(AstExpr.StructSet receiver-box _ value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get receiver-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExpr.WithEscape scratch-box body)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get scratch-box))
          (macro-expr-list-safe-after-inert-splice? ctx decls body))]
      [(AstExpr.WithScratch body)
        (macro-expr-list-safe-after-inert-splice? ctx decls body)]
      [(AstExpr.InArena arena-box body)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get arena-box))
          (macro-expr-list-safe-after-inert-splice? ctx decls body))]
      [(AstExpr.Box inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.BoxGet inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.BoxTake inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.BoxSet inner-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get inner-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExpr.Comptime inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.Try inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.Return inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.PtrNullCheck inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExpr.PtrRead ptr-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExpr.PtrWrite ptr-box value-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExpr.PtrOffset ptr-box offset-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get offset-box)))]
      [(AstExpr.PtrCast ptr-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExpr.PtrToInt ptr-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExpr.IntToPtr value-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get value-box))]
      [(AstExpr.StringData str-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get str-box))]
      [(AstExpr.StringFromBytes ptr-box len-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get len-box)))]
      [(AstExpr.ArrayData array-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get array-box))]
      [(AstExpr.BinaryData _) true]
      [(AstExpr.SpmdProgramIndex) true]
      [(AstExpr.SpmdProgramCount) true]
      [(AstExpr.CpuIdEax leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExpr.CpuIdEbx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExpr.CpuIdEcx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExpr.CpuIdEdx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExpr.Xgetbv index-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get index-box))]
      [(AstExpr.Syscall args)
        (macro-expr-list-safe-after-inert-splice? ctx decls args)]
      [(AstExpr.TypeLiteral _) true]
      [(AstExpr.Init _) true]
      [(AstExpr.PtrNull _) true]
      [(AstExpr.PtrAddrOf _) true]
      [(AstExpr.ProgramArgc) true]
      [(AstExpr.ProgramArgv) true]
      [(AstExpr.ProgramEnvp) true]
      [_ false])))

(define (macro-decl-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [decl : AstDecl]
  [can-share : bool]) : bool
  (cond
    [(macro-expanded-decl-inert? decl can-share) true]
    [(not can-share) false]
    [else
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (match decl
          [(AstDecl.Def _ _ expr-box)
            (macro-expr-safe-after-inert-splice?
              decl-ctx
              decls
              (ast-node-get expr-box))]
          [(AstDecl.DefFn _ _ _ body-box _)
            (macro-expr-safe-after-inert-splice?
              decl-ctx
              decls
              (ast-node-get body-box))]
          [(AstDecl.Test _ _ _) true]
          [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
            (not (macro-import-placeholder-kind? kind))]
          [(AstDecl.Unsafe inner-box)
            (macro-decl-safe-after-inert-splice?
              ctx
              decls
              module
              (box-get inner-box)
              can-share)]
          [(AstDecl.ComptimeDecl _ template-box)
            (macro-decl-safe-after-inert-splice?
              ctx
              decls
              module
              (box-get template-box)
              can-share)]
          [_ false]))]))

;; Whether the program contains any `(type T)` literal (AstExpr.TypeLiteral). ALL
;; CTFE reflection/layout queries (ctfe-reflect-resolve-type for a `(type T)`,
;; and every reflection/layout builtin -- size-of/struct-field-*/enum-variant-*/
;; ...) take a type-literal argument, and type literals are comptime-only (they
;; can't appear in runtime code). So a program with no type literal never queries
;; the CTFE metadata, and `tc-ctfe-env` can hand back an empty env instead of
;; building the whole-program reflection + layout tables (tens of MB, O(types^2)).
;; Macro `expr-type` calls also need metadata, but macro expansion tracks those
;; from defmacro bodies instead of making this whole-program scan normalize every
;; call head.
;; Conservative: any unrecognized expression returns `true` (build), so a future
;; node that could host a type literal is never silently skipped.
(define (ctfe-node-has-type-literal? [id : i64]) : bool
  (ctfe-expr-has-type-literal? (ast-node-get id)))

(define (ctfe-exprs-have-type-literal? [exprs : AstExprList]) : bool
  (ctfe-exprs-have-type-literal-at? (& exprs) 0))

(define (ctfe-exprs-have-type-literal-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (ctfe-node-has-type-literal? (ast-expr-list-get exprs index 0))
      (ctfe-exprs-have-type-literal-at? exprs (+ index 1)))))

(define (ctfe-arms-have-type-literal? [arms : AstMatchArmList]) : bool
  (ctfe-arms-have-type-literal-at? (& arms) 0))

(define (ctfe-arms-have-type-literal-at?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (or
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm _ body-box) (ctfe-node-has-type-literal? body-box)])
      (ctfe-arms-have-type-literal-at? arms (+ index 1)))))

(define (ctfe-bindings-have-type-literal? [bindings : AstLetBindingList]) : bool
  (ctfe-bindings-have-type-literal-at? (& bindings) 0))

(define (ctfe-bindings-have-type-literal-at?
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (ctfe-node-has-type-literal? init-box)])
      (ctfe-bindings-have-type-literal-at? bindings (+ index 1)))))

(define (ctfe-expr-has-type-literal? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.TypeLiteral _) true]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf _) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.Spanned inner-box _) (ctfe-node-has-type-literal? inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (ctfe-node-has-type-literal? func-box)
        (ctfe-exprs-have-type-literal? args))]
    [(AstExpr.BracketClause items) (ctfe-exprs-have-type-literal? items)]
    [(AstExpr.Binary _ l r)
      (or (ctfe-node-has-type-literal? l) (ctfe-node-has-type-literal? r))]
    [(AstExpr.Unary _ i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.If c t e)
      (or
        (ctfe-node-has-type-literal? c)
        (ctfe-node-has-type-literal? t)
        (ctfe-node-has-type-literal? e))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (or
            (ctfe-bindings-have-type-literal? bindings)
            (ctfe-node-has-type-literal? body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (ctfe-node-has-type-literal? body)])]
    [(AstExpr.Tuple exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.TupleRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Array exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.MakeArray _ len) (ctfe-node-has-type-literal? len)]
    [(AstExpr.ArrayRef a i)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? i))]
    [(AstExpr.ArraySet a i v)
      (or
        (ctfe-node-has-type-literal? a)
        (ctfe-node-has-type-literal? i)
        (ctfe-node-has-type-literal? v))]
    [(AstExpr.ArrayPush a v)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? v))]
    [(AstExpr.StringRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.While c b)
      (or (ctfe-node-has-type-literal? c) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Begin exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.Unsafe exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.Set _ rhs) (ctfe-node-has-type-literal? rhs)]
    [(AstExpr.Ann i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Cast i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Borrow _ _ i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (or
            (ctfe-node-has-type-literal? scrut)
            (ctfe-arms-have-type-literal? arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ s e b)
          (or
            (ctfe-node-has-type-literal? s)
            (ctfe-node-has-type-literal? e)
            (ctfe-node-has-type-literal? b))])]
    [(AstExpr.StructGet i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StructSet i _ v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExpr.WithRegion _ exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.WithEscape i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExpr.WithScratch exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.InArena i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExpr.Box i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxGet i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxTake i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxSet i v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExpr.Comptime i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Quote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Quasiquote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Unquote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.UnquoteSplicing i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Try i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Return i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrNullCheck i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrRead i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrWrite a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.PtrOffset a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.PtrCast i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrToInt i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.IntToPtr i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StringData i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StringFromBytes a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.ArrayData i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEbx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEcx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEdx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Xgetbv i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Syscall exprs) (ctfe-exprs-have-type-literal? exprs)]
    [_ true]))

(define (ctfe-decl-has-type-literal? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def _ _ expr-box) (ctfe-node-has-type-literal? expr-box)]
    [(AstDecl.DefFn _ _ _ body-box _) (ctfe-node-has-type-literal? body-box)]
    [(AstDecl.Test _ expr-box _) (ctfe-node-has-type-literal? expr-box)]
    [(AstDecl.DefMacro _ _ _ body-box) (ctfe-node-has-type-literal? body-box)]
    [(AstDecl.Unsafe inner-box)
      (ctfe-decl-has-type-literal? (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (ctfe-decl-has-type-literal? (box-get template-box))]
    [(AstDecl.ModuleBody _ body-box)
      (ctfe-program-has-type-literal? (box-get body-box))]
    [_ false]))

(define (ctfe-program-has-type-literal? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (ctfe-decl-has-type-literal? decl)
        (ctfe-program-has-type-literal? rest))]))

(define (macro-expanded-decl-inert? [decl : AstDecl] [can-share : bool]) : bool
  (match decl
    [(AstDecl.Module _) true]
    [(AstDecl.ModuleBody _ body-box)
      (macro-expanded-decls-inert? (box-get body-box) can-share)]
    [(AstDecl.Def _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDecl.DefFn _ _ _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDecl.Test _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDecl.Extern _ _ _ _) true]
    [(AstDecl.DefEnum _ _ _) true]
    [(AstDecl.DefEnumLifetimes _ _ _ _) true]
    [(AstDecl.DefStruct _ _ _ _) true]
    [(AstDecl.DefStructLifetimes _ _ _ _ _) true]
    [(AstDecl.IncludeStr _ _) true]
    [(AstDecl.IncludeBin _ _) true]
    [(AstDecl.DefDispatch _ _) true]
    [(AstDecl.Unsafe inner-box)
      (macro-expanded-decl-inert? (box-get inner-box) can-share)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-expanded-decl-inert? (box-get template-box) can-share)]
    [_ false]))

(define (macro-expanded-decls-inert? [decls : AstDeclList] [can-share : bool]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) true]
    [(AstDeclListStep.Cons decl rest)
      (and
        (macro-expanded-decl-inert? decl can-share)
        (macro-expanded-decls-inert? rest can-share))]))

(define (macro-decl-vector-family-placeholder-call?
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]) : bool
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box _)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl _)
              (match maybe-decl
                [(MacroMaybeDecl.Some macro-name definition-module _ ret _)
                  (and
                    (tc-macro-result-decls? ret)
                    (macro-vector-family-decls-macro?
                      macro-name
                      definition-module))]
                [(MacroMaybeDecl.No) false])]
            [(ResultMacroCallDeclModule.Err _) false]))]
      [_ false])))

(define (macro-decl-vector-family-placeholder?
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.MacroDecls call-id context)
          (macro-decl-vector-family-placeholder-call?
            ctx
            orig-decls
            module
            call-id
            context)]
        [_ false])]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-vector-family-placeholder?
        ctx
        orig-decls
        module
        (box-get template-box))]
    [_ false]))

(define (macro-expand-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [can-share : bool]) : ResultMacroDeclsWithPaths
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-module : String module]
    [cur-index : i64 0]
    [cur-orig-decls : AstDeclList orig-decls]
    [cur-ctx : TcContext ctx]
    [cur-top-env : TcTypeEnv top-env]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [out-paths-rev : AstDeclPathList (ast-decl-path-list-new)]
    ;; After an inert generated splice, continue across inert declarations,
    ;; vector-family splices, and core fast-path macros. Arbitrary macro work
    ;; needs a rebuilt top env so generated symbols are visible.
    [batched-inert-splice? : bool false]
    [result : ResultMacroDeclsWithPaths
      (ResultMacroDeclsWithPaths.Err
        (box (tc-diag-at-start "macro: internal decl expansion walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (begin
              (set!
                result
                (ResultMacroDeclsWithPaths.Ok
                  (macro-decl-list-reverse out-rev)
                  (macro-decl-path-list-reverse out-paths-rev)
                  MacroFollowupWorkList.Nil))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [rest-paths : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList path-rest]
                      path-rest)]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                    (set!
                      out-paths-rev
                      (ast-decl-path-list-prepend-builder
                        decl-path
                        out-paths-rev))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-index (+ cur-index 1))
                    (set! cur-module (intern-str next-module)))]
                [_
                  (cond
                    [(and
                        (macro-decl-import-placeholder? decl)
                        batched-inert-splice?
                        (not
                          (macro-decl-vector-family-placeholder?
                            cur-ctx
                            cur-orig-decls
                            cur-module
                            decl)))
                      (begin
                        (set!
                          result
                          (ResultMacroDeclsWithPaths.Ok
                            (macro-decl-list-prefix-rev-current-suffix
                              out-rev
                              (macro-decl-list-current-suffix decl rest))
                            (macro-decl-path-list-prefix-rev-current-suffix
                              out-paths-rev
                              (macro-decl-path-list-current-suffix
                                decl-path
                                rest-paths))
                            (macro-followup-work-at
                              cur-index
                              (+ cur-index 1)
                              decl-path
                              decl-path
                              cur-module
                              MacroFollowupCause.ImportPlaceholder)))
                        (set! done true))]
                    [(macro-decl-import-placeholder? decl)
                      (match (macro-expand-decl-with-path
                        cur-ctx
                        cur-top-env
                        cur-orig-decls
                        cur-module
                        decl
                        decl-path)
                        [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                          (let
                            [next-module : String
                              (macro-decls-final-module expanded cur-module)]
                            (if (macro-expanded-decls-inert? expanded can-share)
                              (if (macro-decl-vector-family-placeholder?
                                cur-ctx
                                cur-orig-decls
                                cur-module
                                decl)
                                (match (tc-build-top-env-list-in-module
                                  cur-ctx
                                  expanded
                                  cur-top-env
                                  cur-module)
                                  [(ResultTcEnv.Ok next-bind-env)
                                    (let
                                      [next-top-env : TcTypeEnv
                                        (tc-env-with-cache next-bind-env)]
                                      (begin
                                        (tc-hygiene-reset-active-top-env!
                                          next-top-env)
                                        (set! cur-top-env next-top-env)
                                        (set!
                                          out-rev
                                          (macro-decl-list-reverse-into
                                            expanded
                                            out-rev))
                                        (set!
                                          out-paths-rev
                                          (macro-decl-path-list-reverse-into
                                            expanded-paths
                                            out-paths-rev))
                                        (set! cur-module next-module)
                                        (set! cur-decls rest)
                                        (set! cur-paths rest-paths)
                                        (set!
                                          cur-index
                                          (+
                                            cur-index
                                            (ast-decl-list-count expanded)))
                                        (set! batched-inert-splice? true)))]
                                  [(ResultTcEnv.Err message)
                                    (begin
                                      (set!
                                        result
                                        (ResultMacroDeclsWithPaths.Err
                                          (box (tc-diag-at-start message))))
                                      (set! done true))])
                                (let
                                  [next-decls : AstDeclList
                                    (macro-decl-list-append
                                      (macro-decl-list-reverse out-rev)
                                      (macro-decl-list-append expanded rest))]
                                  [next-ctx : TcContext
                                    (tc-context-with-program
                                      cur-ctx
                                      (ast-program next-decls))]
                                  [_reset-alias-caches : unit
                                    (macro-alias-derived-cache-reset!)]
                                  (match (tc-build-top-env-list-in-module
                                    next-ctx
                                    expanded
                                    cur-top-env
                                    cur-module)
                                    [(ResultTcEnv.Ok next-bind-env)
                                      (match (tc-build-top-env-aliases-list
                                        next-ctx
                                        next-decls
                                        expanded
                                        (tc-env-with-cache next-bind-env)
                                        cur-module)
                                        [(ResultTcEnv.Ok next-top-env)
                                          (begin
                                            (tc-hygiene-reset-active-top-env!
                                              next-top-env)
                                            (set! cur-ctx next-ctx)
                                            (set! cur-orig-decls next-decls)
                                            (set! cur-top-env next-top-env)
                                            (set!
                                              out-rev
                                              (macro-decl-list-reverse-into
                                                expanded
                                                out-rev))
                                            (set!
                                              out-paths-rev
                                              (macro-decl-path-list-reverse-into
                                                expanded-paths
                                                out-paths-rev))
                                            (set! cur-module next-module)
                                            (set! cur-decls rest)
                                            (set! cur-paths rest-paths)
                                            (set!
                                              cur-index
                                              (+
                                                cur-index
                                                (ast-decl-list-count expanded)))
                                            (set! batched-inert-splice? true))]
                                        [(ResultTcEnv.Err message)
                                          (begin
                                            (set!
                                              result
                                              (ResultMacroDeclsWithPaths.Err
                                                (box (tc-diag-at-start message))))
                                            (set! done true))])]
                                    [(ResultTcEnv.Err message)
                                      (begin
                                        (set!
                                          result
                                          (ResultMacroDeclsWithPaths.Err
                                            (box (tc-diag-at-start message))))
                                        (set! done true))])))
                              (begin
                                (set!
                                  result
                                  (ResultMacroDeclsWithPaths.Ok
                                    (macro-decl-list-append
                                      (macro-decl-list-reverse out-rev)
                                      (macro-decl-list-append expanded rest))
                                    (macro-decl-path-list-append
                                      (macro-decl-path-list-reverse
                                        out-paths-rev)
                                      (macro-decl-path-list-append
                                        expanded-paths
                                        rest-paths))
                                    (macro-followup-work-for-decls
                                      cur-index
                                      (macro-decl-list-append expanded rest)
                                      (macro-decl-path-list-append
                                        expanded-paths
                                        rest-paths)
                                      cur-module
                                      MacroFollowupCause.ExpandedDecl)))
                                (set! done true))))]
                        [(ResultMacroDeclExpansion.Err diag)
                          (begin
                            (set! result (ResultMacroDeclsWithPaths.Err diag))
                            (set! done true))])]
                    [(and
                        batched-inert-splice?
                        (not
                          (macro-decl-safe-after-inert-splice?
                            cur-ctx
                            cur-orig-decls
                            cur-module
                            decl
                            can-share)))
                      (begin
                        (set!
                          result
                          (ResultMacroDeclsWithPaths.Ok
                            (macro-decl-list-prefix-rev-current-suffix
                              out-rev
                              (macro-decl-list-current-suffix decl rest))
                            (macro-decl-path-list-prefix-rev-current-suffix
                              out-paths-rev
                              (macro-decl-path-list-current-suffix
                                decl-path
                                rest-paths))
                            (macro-followup-work-at
                              cur-index
                              (+ cur-index 1)
                              decl-path
                              decl-path
                              cur-module
                              MacroFollowupCause.BlockedAfterInertSplice)))
                        (set! done true))]
                    [(and can-share (macro-decl-cannot-fire? decl))
                      ;; Predict-skip: a macro-free value decl can never fire a
                      ;; macro, so share it unchanged (like the AstDecl.Module
                      ;; arm) instead of copying it through the expander. This
                      ;; avoids the per-decl `tc-context-with-module` allocation
                      ;; and the single-element relist that
                      ;; `macro-expand-decl-with-path` would otherwise retain in
                      ;; the installed pools. A non-module value decl never
                      ;; changes the active module, so `cur-module` is unchanged.
                      (begin
                        (set!
                          out-rev
                          (ast-decl-list-prepend-builder decl out-rev))
                        (set!
                          out-paths-rev
                          (ast-decl-path-list-prepend-builder
                            decl-path
                            out-paths-rev))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (set! cur-index (+ cur-index 1)))]
                    [else
                      (match (macro-expand-decl-with-path
                        cur-ctx
                        cur-top-env
                        cur-orig-decls
                        cur-module
                        decl
                        decl-path)
                        [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                          (begin
                            (set!
                              out-rev
                              (macro-decl-list-reverse-into expanded out-rev))
                            (set!
                              out-paths-rev
                              (macro-decl-path-list-reverse-into
                                expanded-paths
                                out-paths-rev))
                            (set!
                              cur-module
                              (macro-decls-final-module expanded cur-module))
                            (set! cur-decls rest)
                            (set! cur-paths rest-paths)
                            (set!
                              cur-index
                              (+ cur-index (ast-decl-list-count expanded))))]
                        [(ResultMacroDeclExpansion.Err diag)
                          (begin
                            (set! result (ResultMacroDeclsWithPaths.Err diag))
                            (set! done true))])])]))]))
      result)))

(define (macro-expr-needs-compat-expansion? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "when" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "unless" TcStringList.Nil)))

(define (macro-decl-needs-expansion? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (macro-expr-needs-compat-expansion? expr))]
    [(AstDecl.DefFn _ _ _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (macro-expr-needs-compat-expansion? body))]
    [(AstDecl.DefMacro _ _ _ _) true]
    [(AstDecl.Test _ _ _) false]
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [(AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-needs-expansion? inner))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-needs-expansion? template))]
    [_ false]))

(define (macro-decl-has-defmacro? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefMacro _ _ _ _) true]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-has-defmacro? inner))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-has-defmacro? template))]
    [_ false]))

;; Whether a program needs the macro expansion pass.
(define (macro-program-needs-expansion? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (or
          (macro-decl-needs-expansion? decl)
          (macro-program-needs-expansion? rest)))]))

(define (macro-program-has-defmacro? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (or (macro-decl-has-defmacro? decl) (macro-program-has-defmacro? rest)))]))

(define (macro-decl-might-fire-expression-macro? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def _ _ expr-box)
      (macro-expr-might-fire? (ast-node-get expr-box))]
    [(AstDecl.DefFn _ _ _ body-box _)
      (macro-expr-might-fire? (ast-node-get body-box))]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-might-fire-expression-macro? (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-might-fire-expression-macro? (box-get template-box))]
    [_ false]))

(define (macro-program-might-fire-expression-macro? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-might-fire-expression-macro? decl)
        (macro-program-might-fire-expression-macro? rest))]))

(define (macro-import-kind-summary-backed? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportKind.Path) true]
    [(AstImportKind.Module) true]
    [_ false]))

(define (macro-import-target-has-summary-macro?
  [kind : AstImportKind]
  [target : AstMaybeModuleName]) : bool
  (if (macro-import-kind-summary-backed? kind)
    (match target
      [(AstMaybeModuleName.Some target-module)
        (macro-surface-module-has-macro? target-module)]
      [(AstMaybeModuleName.No) false])
    false))

(define (macro-decl-has-summary-macro-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ target _ _))
      (macro-import-target-has-summary-macro? kind target)]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-has-summary-macro-import? (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-has-summary-macro-import? (box-get template-box))]
    [_ false]))

(define (macro-program-has-summary-macro-import? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-has-summary-macro-import? decl)
        (macro-program-has-summary-macro-import? rest))]))

(define (macro-decl-has-module-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [(AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-has-module-placeholder? (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-has-module-placeholder? (box-get template-box))]
    [_ false]))

(define (macro-program-has-module-placeholder? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-has-module-placeholder? decl)
        (macro-program-has-module-placeholder? rest))]))

(define (macro-module-placeholder-followup-work-list-in
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [index : i64]) : MacroFollowupWorkList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) MacroFollowupWorkList.Nil]
    [(AstDeclListStep.Cons decl rest-box)
      (let
        [rest : AstDeclList rest-box]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) ""])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [next-module : String
          (match decl
            [(AstDecl.Module name) (intern-str name)]
            [_ module])]
        [tail : MacroFollowupWorkList
          (macro-module-placeholder-followup-work-list-in
            rest
            rest-paths
            next-module
            (+ index 1))]
        (if (macro-decl-has-module-placeholder? decl)
          (macro-followup-work-cons
            (MacroFollowupWork
              index
              (+ index 1)
              decl-path
              decl-path
              module
              MacroFollowupCause.ModulePlaceholder)
            tail)
          tail))]))

(define (macro-module-placeholder-followup-work-list
  [decls : AstDeclList]
  [paths : AstDeclPathList]) : MacroFollowupWorkList
  (macro-module-placeholder-followup-work-list-in decls paths "" 0))

(define (macro-decl-module-placeholder-count [decl : AstDecl]) : i64
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) 1]
        [(AstImportKind.MacroDecls _ _) 1]
        [_ 0])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-module-placeholder-count (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-module-placeholder-count (box-get template-box))]
    [_ 0]))

(define (macro-program-module-placeholder-count [decls : AstDeclList]) : i64
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) 0]
    [(AstDeclListStep.Cons decl rest)
      (+
        (macro-decl-module-placeholder-count decl)
        (macro-program-module-placeholder-count rest))]))

(define (macro-decl-materialized-import-needs-followup? [decl : AstDecl]) : bool
  (or
    (macro-decl-needs-expansion? decl)
    (macro-decl-has-summary-macro-import? decl)
    (macro-decl-has-module-placeholder? decl)
    (macro-decl-might-fire-expression-macro? decl)))

(define (macro-decls-materialized-import-need-followup? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-materialized-import-needs-followup? decl)
        (macro-decls-materialized-import-need-followup? rest))]))

(define (macro-generated-import-followup-work-for-decls
  [start-index : i64]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]) : MacroFollowupWorkList
  (if (macro-decls-materialized-import-need-followup? decls)
    (macro-followup-work-for-decls
      start-index
      decls
      paths
      module
      MacroFollowupCause.GeneratedImport)
    MacroFollowupWorkList.Nil))

(cfg
  test
  (define (macro-materialized-import-test-inert-decls) : AstDeclList
    (ast-decl-cons
      (ast-decl-def-fn
        "generated_inert_value"
        (ast-param-list-new)
        (AstType.I64)
        (ast-node-push (AstExpr.Literal (ast-lit-int 1))))
      (ast-decl-list-new))))

(cfg
  test
  (define (macro-materialized-import-test-placeholder-decls) : AstDeclList
    (let
      [span : AstSourceSpan (AstSourceSpan 1 1 1 1)]
      [placeholder : AstDecl
        (AstDecl.Import
          (AstImportSpec.Spec
            (AstImportKind.MacroDecls 0 AstMaybeModuleName.No)
            "generated_next.tl"
            AstMaybeModuleName.No
            AstMaybeImportAlias.No
            span))]
      (ast-decl-cons placeholder (ast-decl-list-new)))))

(cfg
  test
  (test
    macro-generated-import-inert-followup-suppressed
    (let
      [decls : AstDeclList (macro-materialized-import-test-inert-decls)]
      [paths : AstDeclPathList
        (macro-paths-for-decls decls "generated_inert.tl")]
      [work : MacroFollowupWorkList
        (macro-generated-import-followup-work-for-decls 3 decls paths "owner")]
      (test.assert-true
        (macro-followup-work-list-empty? work)
        "inert generated imports should not request a macro follow-up pass"))))

(cfg
  test
  (test
    macro-generated-import-placeholder-followup-kept
    (let
      [decls : AstDeclList (macro-materialized-import-test-placeholder-decls)]
      [paths : AstDeclPathList
        (macro-paths-for-decls decls "generated_placeholder.tl")]
      [work : MacroFollowupWorkList
        (macro-generated-import-followup-work-for-decls 3 decls paths "owner")]
      (test.assert-false
        (macro-followup-work-list-empty? work)
        "generated imports with macro placeholders still request follow-up"))))

(cfg
  test
  (test
    macro-generated-surface-loop-control-leaves
    (let
      [aliases : MacroGeneratedSurfaceNameSet
        (macro-generated-surface-name-set-empty)]
      [break-refs : MacroGeneratedSurfaceNameSet
        (macro-generated-surface-expr-refs
          (AstExpr.Break)
          aliases
          (macro-generated-surface-name-set-empty)
          false)]
      [continue-refs : MacroGeneratedSurfaceNameSet
        (macro-generated-surface-expr-refs
          (AstExpr.Continue)
          aliases
          (macro-generated-surface-name-set-empty)
          false)]
      (test.assert-true
        (and
          (= (macro-generated-surface-name-set-len break-refs) 0)
          (= (macro-generated-surface-name-set-len continue-refs) 0))
        "loop control expressions should not collect generated surface refs"))))

;; Expand all macro calls in a parsed program before typechecking. Programs that
;; need no macro or guard-compatibility expansion are returned unchanged without
;; rebuilding the AST, so the expansion phase adds no allocation for the common
;; case.
(define (macro-expand-program-pass-with-paths-and-pools-with-followup
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpandPass
  (begin
    (ast-node-pool-context-install! pools)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          [has-defmacro : bool (macro-program-has-defmacro? decls)]
          [expr-type-macro-names : TcStringList
            (if has-defmacro
              (macro-collect-expr-type-macro-names decls)
              TcStringList.Nil)]
          [has-expr-type-macros : bool
            (match expr-type-macro-names
              [(TcStringList.Nil) false]
              [_ true])]
          [program-needs-expansion : bool
            (macro-program-needs-expansion? decls)]
          [has-summary-macro-import : bool
            (and
              (not has-defmacro)
              (not program-needs-expansion)
              (macro-program-has-summary-macro-import? decls))]
          [prescan-macro-names : TcStringList
            (if has-summary-macro-import
              (macro-collect-visible-macro-names decls)
              TcStringList.Nil)]
          [has-visible-macro-call : bool
            (if has-summary-macro-import
              (begin
                (set! macro-expand-macro-names prescan-macro-names)
                (macro-program-might-fire-expression-macro? decls))
              false)]
          (begin
            ;; Reset the per-compile CTFE-env cache so a later comptime evaluation
            ;; (or the next program in a multi-program process) never reuses a stale
            ;; or another program's metadata. The cache is repopulated eagerly below.
            (set! macro-expand-ctfe-env-ready false)
            (cfg compile-profile (compiler-tc-macro-profile-reset))
            ;; Same per-compile reset for the clone-able type set cache.
            (tc-clone-able-cache-reset!)
            ;; Type-name misses are keyed only by lookup text. Each macro
            ;; fixed-point pass rebuilds symbols from a different expanded
            ;; program, so a miss from an earlier pass must not hide generated
            ;; module-local types introduced by that pass.
            (tc-nominal-owner-cache-reset!)
            ;; Same per-compile reset for the qualified-alias resolution cache:
            ;; the (module, qualifier) -> target mapping is derived from this
            ;; program's declarations.
            (macro-alias-derived-cache-reset!)
            (ctfe-module-macro-export-reset!)
            (set! macro-expand-expr-type-macro-names expr-type-macro-names)
            ;; Only build the (tens-of-MB, O(types^2)) reflection/layout metadata if
            ;; the program actually contains a `(type T)` literal -- the sole entry
            ;; point for every CTFE reflection/layout query.
            (set!
              ctfe-needs-metadata
              (or
                has-defmacro
                has-visible-macro-call
                (ctfe-program-has-type-literal? decls)
                has-expr-type-macros))
            (if (or has-defmacro has-visible-macro-call program-needs-expansion)
              (begin
                (cfg compile-profile (compiler-tc-profile-start))
                (match (build-compiler-symbols-with-paths program paths)
                  [(ResultCompilerSymbols.Ok symbols)
                    (match (build-compiler-registries-with-symbols
                      program
                      symbols)
                      [(ResultCompilerRegistries.Ok registries)
                        (begin
                          (set! macro-expand-active-module "")
                          (set!
                            macro-expand-macro-names
                            (macro-collect-visible-macro-names decls))
                          (let
                            [ctx : TcContext
                              (TcContext program symbols registries "" pools)]
                            (match (tc-stdlib-comptime-surface-ok-for-macro ctx)
                              [(ResultTcUnit.Ok)
                                (match (tc-build-top-env ctx program)
                                  [(ResultTcEnv.Ok top-env)
                                    (begin
                                      (tc-hygiene-reset-active-top-env! top-env)
                                      (tc-context-capture-active-pools! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-finish
                                          "macro_setup"))
                                      (set!
                                        macro-expand-ctfe-env-value
                                        (tc-ctfe-env ctx))
                                      (set! macro-expand-ctfe-env-ready true)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-start))
                                      (match (macro-expand-decls
                                        ctx
                                        top-env
                                        decls
                                        decls
                                        paths
                                        ""
                                        (not has-expr-type-macros))
                                        [(ResultMacroDeclsWithPaths.Ok
                                            ndecls
                                            npaths
                                            followup-work)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpandPass.Ok
                                              (ast-program ndecls)
                                              npaths
                                              followup-work))]
                                        [(ResultMacroDeclsWithPaths.Err diag)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpandPass.Err diag))]))]
                                  [(ResultTcEnv.Err message)
                                    (ResultMacroExpandPass.Err
                                      (box (tc-diag-at-start message)))])]
                              [(ResultTcUnit.Err message)
                                (ResultMacroExpandPass.Err
                                  (box (tc-diag-at-start message)))])))]
                      [(ResultCompilerRegistries.Err message)
                        (ResultMacroExpandPass.Err
                          (box (tc-diag-at-start message)))])]
                  [(ResultCompilerSymbols.Err message)
                    (ResultMacroExpandPass.Err (box (tc-diag-at-start message)))]))
              (ResultMacroExpandPass.Ok program paths MacroFollowupWorkList.Nil))))])))

(define (macro-expand-program-pass-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpand
  (match (macro-expand-program-pass-with-paths-and-pools-with-followup
    program
    paths
    pools)
    [(ResultMacroExpandPass.Ok expanded expanded-paths _)
      (ResultMacroExpand.Ok expanded expanded-paths)]
    [(ResultMacroExpandPass.Err diag) (ResultMacroExpand.Err diag)]))

(define (macro-expand-program-pass-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-pass-with-paths-and-pools
    program
    paths
    (ast-node-pool-context-capture-active)))

(define (macro-expand-fixed-point-limit) : i64
  16)

;; Generated modules can introduce their own import placeholders for the next
;; pass. Keep a fixed guard, but scale it with loaded placeholder volume so
;; legitimate nested module families converge under `test` cfg stdlib imports.
(define (macro-expand-fixed-point-limit-for-program [program : AstProgram]) : i64
  (match program
    [(AstProgram.Program decls-box)
      (+
        (macro-expand-fixed-point-limit)
        (*
          (macro-expand-fixed-point-limit)
          (macro-program-module-placeholder-count (box-get decls-box))))]))

(defenum MacroMaybeGeneratedNormalImport
  (No)
  (Some
    AstImportKind
    String
    AstMaybeModuleName
    AstMaybeImportAlias
    AstSourceSpan
    AstDecl))

(defenum ResultMacroMaterializeImport
  (Ok AstDeclList AstDeclPathList sym_i64_env.SymI64Env MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(define (macro-generated-normal-import [decl : AstDecl]) : MacroMaybeGeneratedNormalImport
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match meta
          [(AstGeneratedDeclMeta.Some _ _ _ _)
            (match template
              [(AstDecl.Import
                  (AstImportSpec.Spec kind import-path expected alias span))
                (if (macro-import-placeholder-kind? kind)
                  (MacroMaybeGeneratedNormalImport.No)
                  (MacroMaybeGeneratedNormalImport.Some
                    kind
                    import-path
                    expected
                    alias
                    span
                    template))]
              [_ (MacroMaybeGeneratedNormalImport.No)])]
          [(AstGeneratedDeclMeta.No) (macro-generated-normal-import template)]))]
    [(AstDecl.Unsafe inner-box)
      (macro-generated-normal-import (box-get inner-box))]
    [_ (MacroMaybeGeneratedNormalImport.No)]))

(define (macro-materialize-seen-from
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [seen : sym_i64_env.SymI64Env]
  [module : String]) : sym_i64_env.SymI64Env
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) seen]
    [(AstDeclListStep.Cons decl rest-box)
      (let
        [rest : AstDeclList rest-box]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) ""])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [next-module : String
          (match decl
            [(AstDecl.Module name) (intern-str name)]
            [_ module])]
        [seen-path : sym_i64_env.SymI64Env
          (if (> (string.string-length decl-path) 0)
            (sym_i64_env.sym-i64-bind
              seen
              (compiler-load-seen-path-key-in-module decl-path module)
              1)
            seen)]
        [seen-decl : sym_i64_env.SymI64Env
          (match decl
            [(AstDecl.Module name)
              (let
                [module-name : String (intern-str name)]
                (if (> (string.string-length module-name) 0)
                  (sym_i64_env.sym-i64-bind seen-path module-name 1)
                  seen-path))]
            [_ seen-path])]
        (macro-materialize-seen-from rest rest-paths seen-decl next-module))]))

(define (macro-materialize-import-diagnostic
  [path : String]
  [span : AstSourceSpan]
  [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic
    (compiler-diagnostic-from-ast-span path span message)))

(define (macro-materialize-generated-import
  [decl : AstDecl]
  [decl-path : String]
  [module : String]
  [decl-index : i64]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.StringVector]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.No)
      (ResultMacroMaterializeImport.Ok
        (ast-decl-cons decl (ast-decl-list-new))
        (ast-decl-path-cons decl-path (ast-decl-path-list-new))
        seen
        MacroFollowupWorkList.Nil)]
    [(MacroMaybeGeneratedNormalImport.Some
        kind
        import-path
        expected
        alias
        span
        _)
      (let
        [import-root : String (compiler-load-dirname decl-path)]
        (match (compiler-load-resolve-import-spec-with-roots
          decl-path
          import-root
          kind
          import-path
          stdlib-roots)
          [(ResultPkgResolve.Ok resolved)
            (match (compiler-load-file-with-paths-and-roots-expect-cfg-root-import-with-pools
              resolved
              seen
              stdlib-roots
              kind
              import-path
              expected
              import-root
              cfgs
              pools
              module)
              [(ResultCompilerLoadWithPaths.Ok
                  imported-decls
                  imported-paths
                  _
                  next-seen)
                (let
                  [after-import-expected : AstMaybeModuleName
                    (compiler-load-after-import-expected-module
                      kind
                      expected
                      alias
                      imported-decls)]
                  [after-import-alias : AstMaybeImportAlias
                    (compiler-load-after-import-alias
                      kind
                      expected
                      alias
                      imported-decls)]
                  [tail-decls : AstDeclList
                    (compiler-load-decls-after-import
                      kind
                      resolved
                      after-import-expected
                      after-import-alias
                      module
                      imported-decls
                      (ast-decl-list-new))]
                  [tail-paths : AstDeclPathList
                    (compiler-load-paths-after-import
                      decl-path
                      after-import-alias
                      imported-decls
                      (ast-decl-path-list-new))]
                  [materialized-decls : AstDeclList
                    (macro-decl-list-append imported-decls tail-decls)]
                  [materialized-paths : AstDeclPathList
                    (macro-decl-path-list-append imported-paths tail-paths)]
                  [followup-work : MacroFollowupWorkList
                    (macro-generated-import-followup-work-for-decls
                      decl-index
                      materialized-decls
                      materialized-paths
                      module)]
                  (ResultMacroMaterializeImport.Ok
                    materialized-decls
                    materialized-paths
                    next-seen
                    followup-work))]
              [(ResultCompilerLoadWithPaths.Err diag)
                (ResultMacroMaterializeImport.Err diag)])]
          [(ResultPkgResolve.Err message)
            (ResultMacroMaterializeImport.Err
              (box (macro-materialize-import-diagnostic decl-path span message)))]))]))

(define (macro-materialize-generated-imports-in
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (let
    [seen : sym_i64_env.SymI64Env
      (macro-materialize-seen-from decls paths (sym_i64_env.sym-i64-empty) "")]
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-module : String ""]
    [cur-index : i64 0]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [out-paths-rev : AstDeclPathList (ast-decl-path-list-new)]
    [followup-needed? : bool false]
    [followup-start-index : i64 0]
    [followup-start-module : String ""]
    [result : ResultMacroMaterializeImport
      (ResultMacroMaterializeImport.Err
        (box
          (tc-diag-at-start "macro: internal generated import materialization")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (let
              [final-decls : AstDeclList (macro-decl-list-reverse out-rev)]
              [final-paths : AstDeclPathList
                (macro-decl-path-list-reverse out-paths-rev)]
              [followup-work : MacroFollowupWorkList
                (if followup-needed?
                  (macro-followup-work-for-decls
                    followup-start-index
                    (tc-decl-list-drop final-decls followup-start-index)
                    (tc-decl-path-list-drop final-paths followup-start-index)
                    followup-start-module
                    MacroFollowupCause.GeneratedImport)
                  MacroFollowupWorkList.Nil)]
              (begin
                (set!
                  result
                  (ResultMacroMaterializeImport.Ok
                    final-decls
                    final-paths
                    seen
                    followup-work))
                (set! done true)))]
          [(AstDeclListStep.Cons decl rest-box)
            (let
              [rest : AstDeclList rest-box]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [rest-paths : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList path-rest]
                      path-rest)]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                    (set!
                      out-paths-rev
                      (ast-decl-path-list-prepend-builder
                        decl-path
                        out-paths-rev))
                    (set! cur-module (intern-str next-module))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-index (+ cur-index 1)))]
                [_
                  (match (macro-materialize-generated-import
                    decl
                    decl-path
                    cur-module
                    cur-index
                    seen
                    stdlib-roots
                    cfgs
                    pools)
                    [(ResultMacroMaterializeImport.Ok
                        materialized-decls
                        materialized-paths
                        next-seen
                        materialized-work)
                      (begin
                        (set!
                          out-rev
                          (macro-decl-list-reverse-into
                            materialized-decls
                            out-rev))
                        (set!
                          out-paths-rev
                          (macro-decl-path-list-reverse-into
                            materialized-paths
                            out-paths-rev))
                        (set! seen next-seen)
                        (if (and
                          (not followup-needed?)
                          (not
                            (macro-followup-work-list-empty? materialized-work)))
                          (begin
                            (set! followup-needed? true)
                            (set! followup-start-index cur-index)
                            (set!
                              followup-start-module
                              (string.copy (& cur-module))))
                          unit)
                        (set!
                          cur-module
                          (macro-decls-final-module
                            materialized-decls
                            cur-module))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (set!
                          cur-index
                          (+ cur-index (ast-decl-list-count materialized-decls))))]
                    [(ResultMacroMaterializeImport.Err diag)
                      (begin
                        (set! result (ResultMacroMaterializeImport.Err diag))
                        (set! done true))])]))]))
      result)))

(define (macro-materialize-generated-imports
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (match program
    [(AstProgram.Program decls-box)
      (macro-materialize-generated-imports-in
        (box-get decls-box)
        paths
        stdlib-roots
        cfgs
        pools)]))

(define (macro-expand-local-followup-worklist
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [work : MacroFollowupWorkList]
  [offset : i64]
  [can-share : bool]) : ResultMacroDeclsWithPaths
  (match work
    [(MacroFollowupWorkList.Nil)
      (ResultMacroDeclsWithPaths.Ok decls paths MacroFollowupWorkList.Nil)]
    [(MacroFollowupWorkList.Cons item rest-box)
      (if (not (macro-local-followup-cause-supported? (struct-get item cause)))
        (ResultMacroDeclsWithPaths.Ok
          decls
          paths
          (macro-followup-work-list-shift work offset))
        (let
          [start-index : i64 (+ (struct-get item start-index) offset)]
          [end-index : i64 (+ (struct-get item end-index) offset)]
          [count : i64 (- end-index start-index)]
          [module : String (struct-get item module)]
          [range-decls : AstDeclList
            (tc-decl-list-take (tc-decl-list-drop decls start-index) count)]
          [range-paths : AstDeclPathList
            (tc-decl-path-list-take
              (tc-decl-path-list-drop paths start-index)
              count)]
          [path-import-blocked? : bool
            (and
              (macro-followup-cause-expanded-decl? (struct-get item cause))
              (macro-decls-contain-path-import? range-decls))]
          (if (or (<= count 0) path-import-blocked?)
            (ResultMacroDeclsWithPaths.Ok
              decls
              paths
              (macro-followup-work-list-shift work offset))
            (match (macro-expand-decls
              ctx
              top-env
              orig-decls
              range-decls
              range-paths
              module
              can-share)
              [(ResultMacroDeclsWithPaths.Ok
                  expanded-decls
                  expanded-paths
                  nested-work)
                (let
                  [next-decls : AstDeclList
                    (macro-decl-list-replace-range
                      decls
                      start-index
                      end-index
                      expanded-decls)]
                  [next-paths : AstDeclPathList
                    (macro-decl-path-list-replace-range
                      paths
                      start-index
                      end-index
                      expanded-paths)]
                  [next-ctx : TcContext
                    (tc-context-with-program ctx (ast-program next-decls))]
                  [_reset-alias-caches : unit
                    (macro-alias-derived-cache-reset!)]
                  [delta : i64 (- (ast-decl-list-count expanded-decls) count)]
                  (if (macro-followup-work-list-empty? nested-work)
                    (match (tc-build-top-env-list-in-module
                      next-ctx
                      expanded-decls
                      top-env
                      module)
                      [(ResultTcEnv.Ok next-bind-env)
                        (match (tc-build-top-env-aliases-list
                          next-ctx
                          next-decls
                          expanded-decls
                          (tc-env-with-cache next-bind-env)
                          module)
                          [(ResultTcEnv.Ok next-top-env)
                            (begin
                              (tc-hygiene-reset-active-top-env! next-top-env)
                              (macro-expand-local-followup-worklist
                                next-ctx
                                next-top-env
                                next-decls
                                next-decls
                                next-paths
                                (box-get rest-box)
                                (+ offset delta)
                                can-share))]
                          [(ResultTcEnv.Err message)
                            (ResultMacroDeclsWithPaths.Err
                              (box (tc-diag-at-start message)))])]
                      [(ResultTcEnv.Err message)
                        (ResultMacroDeclsWithPaths.Err
                          (box (tc-diag-at-start message)))])
                    (ResultMacroDeclsWithPaths.Ok
                      next-decls
                      next-paths
                      (macro-followup-work-list-shift nested-work start-index))))]
              [(ResultMacroDeclsWithPaths.Err diag)
                (ResultMacroDeclsWithPaths.Err diag)]))))]))

(define (macro-followup-work-range-has-module-placeholder?
  [decls : AstDeclList]
  [work : MacroFollowupWork]) : bool
  (let
    [start-index : i64 (struct-get work start-index)]
    [end-index : i64 (struct-get work end-index)]
    [count : i64 (- end-index start-index)]
    (if (<= count 0)
      false
      (macro-program-has-module-placeholder?
        (tc-decl-list-take (tc-decl-list-drop decls start-index) count)))))

(define (macro-followup-work-list-has-module-placeholder?
  [decls : AstDeclList]
  [work : MacroFollowupWorkList]) : bool
  (match work
    [(MacroFollowupWorkList.Nil) false]
    [(MacroFollowupWorkList.Cons item rest)
      (or
        (macro-followup-work-range-has-module-placeholder? decls item)
        (macro-followup-work-list-has-module-placeholder? decls (box-get rest)))]))

(define (macro-program-followup-work-has-module-placeholder?
  [program : AstProgram]
  [work : MacroFollowupWorkList]) : bool
  (match program
    [(AstProgram.Program decls-box)
      (macro-followup-work-list-has-module-placeholder?
        (box-get decls-box)
        work)]))

(define (macro-expand-local-followup-with-setup
  [program : AstProgram]
  [paths : AstDeclPathList]
  [work : MacroFollowupWorkList]
  [pools : AstNodePoolContext]) : ResultMacroLocalFollowup
  (if (macro-followup-work-list-empty? work)
    (ResultMacroLocalFollowup.Ok program paths MacroFollowupWorkList.Nil)
    (if (not (macro-local-followup-work-supported? work))
      (ResultMacroLocalFollowup.Ok program paths work)
      (begin
        (ast-node-pool-context-install! pools)
        (match program
          [(AstProgram.Program decls-box)
            (let
              [decls : AstDeclList (box-get decls-box)]
              [has-defmacro : bool (macro-program-has-defmacro? decls)]
              [expr-type-macro-names : TcStringList
                (if has-defmacro
                  (macro-collect-expr-type-macro-names decls)
                  TcStringList.Nil)]
              [has-expr-type-macros : bool
                (match expr-type-macro-names
                  [(TcStringList.Nil) false]
                  [_ true])]
              [program-needs-expansion : bool
                (macro-program-needs-expansion? decls)]
              [has-summary-macro-import : bool
                (and
                  (not has-defmacro)
                  (not program-needs-expansion)
                  (macro-program-has-summary-macro-import? decls))]
              [prescan-macro-names : TcStringList
                (if has-summary-macro-import
                  (macro-collect-visible-macro-names decls)
                  TcStringList.Nil)]
              [has-visible-macro-call : bool
                (if has-summary-macro-import
                  (begin
                    (set! macro-expand-macro-names prescan-macro-names)
                    (macro-program-might-fire-expression-macro? decls))
                  false)]
              (begin
                (set! macro-expand-ctfe-env-ready false)
                (tc-clone-able-cache-reset!)
                (tc-nominal-owner-cache-reset!)
                (macro-alias-derived-cache-reset!)
                (ctfe-module-macro-export-reset!)
                (set! macro-expand-expr-type-macro-names expr-type-macro-names)
                (set!
                  ctfe-needs-metadata
                  (or
                    has-defmacro
                    has-visible-macro-call
                    (ctfe-program-has-type-literal? decls)
                    has-expr-type-macros))
                (if (or
                  has-defmacro
                  has-visible-macro-call
                  program-needs-expansion)
                  (match (build-compiler-symbols-with-paths program paths)
                    [(ResultCompilerSymbols.Ok symbols)
                      (match (build-compiler-registries-with-symbols
                        program
                        symbols)
                        [(ResultCompilerRegistries.Ok registries)
                          (begin
                            (set! macro-expand-active-module "")
                            (set!
                              macro-expand-macro-names
                              (macro-collect-visible-macro-names decls))
                            (let
                              [ctx : TcContext
                                (TcContext program symbols registries "" pools)]
                              (match (tc-stdlib-comptime-surface-ok-for-macro
                                ctx)
                                [(ResultTcUnit.Ok)
                                  (match (tc-build-top-env ctx program)
                                    [(ResultTcEnv.Ok top-env)
                                      (begin
                                        (tc-hygiene-reset-active-top-env!
                                          top-env)
                                        (tc-context-capture-active-pools! ctx)
                                        (set!
                                          macro-expand-ctfe-env-value
                                          (tc-ctfe-env ctx))
                                        (set! macro-expand-ctfe-env-ready true)
                                        (match (macro-expand-local-followup-worklist
                                          ctx
                                          top-env
                                          decls
                                          decls
                                          paths
                                          work
                                          0
                                          (not has-expr-type-macros))
                                          [(ResultMacroDeclsWithPaths.Ok
                                              ndecls
                                              npaths
                                              remaining-work)
                                            (begin
                                              (tc-context-capture-active-pools!
                                                ctx)
                                              (ResultMacroLocalFollowup.Ok
                                                (ast-program ndecls)
                                                npaths
                                                remaining-work))]
                                          [(ResultMacroDeclsWithPaths.Err diag)
                                            (begin
                                              (tc-context-capture-active-pools!
                                                ctx)
                                              (ResultMacroLocalFollowup.Err
                                                diag))]))]
                                    [(ResultTcEnv.Err message)
                                      (ResultMacroLocalFollowup.Err
                                        (box (tc-diag-at-start message)))])]
                                [(ResultTcUnit.Err message)
                                  (ResultMacroLocalFollowup.Err
                                    (box (tc-diag-at-start message)))])))]
                        [(ResultCompilerRegistries.Err message)
                          (ResultMacroLocalFollowup.Err
                            (box (tc-diag-at-start message)))])]
                    [(ResultCompilerSymbols.Err message)
                      (ResultMacroLocalFollowup.Err
                        (box (tc-diag-at-start message)))])
                  (ResultMacroLocalFollowup.Ok program paths work))))])))))

(define (macro-expand-finish-materialized
  [materialized : AstProgram]
  [materialized-paths : AstDeclPathList]
  [pass-followup-work : MacroFollowupWorkList]
  [materialized-followup-work : MacroFollowupWorkList]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.StringVector]
  [cfgs : SymI64Env]
  [fuel : i64]) : ResultMacroExpand
  (let
    [normalized-result : ResultGenProgramWithPaths
      (if (compiler-specialize-needed? materialized)
        (gen-normalize-program-with-paths-and-pools
          materialized
          materialized-paths
          (tc-decl-path-list-last materialized-paths "")
          pools)
        (ResultGenProgramWithPaths.Ok materialized materialized-paths))]
    (match normalized-result
      [(ResultGenProgramWithPaths.Ok normalized normalized-paths)
        (match normalized
          [(AstProgram.Program decls-box)
            (let
              [decls : AstDeclList (box-get decls-box)]
              [module-placeholder-work : MacroFollowupWorkList
                (macro-module-placeholder-followup-work-list
                  decls
                  normalized-paths)]
              [has-pass-followup : bool
                (not (macro-followup-work-list-empty? pass-followup-work))]
              [has-materialized-followup : bool
                (not
                  (macro-followup-work-list-empty? materialized-followup-work))]
              [has-module-placeholder-followup : bool
                (not (macro-followup-work-list-empty? module-placeholder-work))]
              [can-process-local-pass-followup : bool
                (and
                  has-pass-followup
                  (macro-local-followup-work-supported? pass-followup-work))]
              [can-process-local-module-placeholder : bool false]
              (cond
                [can-process-local-pass-followup
                  (match (macro-expand-local-followup-with-setup
                    normalized
                    normalized-paths
                    pass-followup-work
                    pools)
                    [(ResultMacroLocalFollowup.Ok
                        local-normalized
                        local-normalized-paths
                        remaining-work)
                      (if (macro-followup-work-list-empty? remaining-work)
                        (macro-expand-finish-materialized
                          local-normalized
                          local-normalized-paths
                          MacroFollowupWorkList.Nil
                          materialized-followup-work
                          pools
                          stdlib-roots
                          cfgs
                          fuel)
                        (macro-expand-program-with-paths-loop-and-pools
                          local-normalized
                          local-normalized-paths
                          pools
                          stdlib-roots
                          cfgs
                          (- fuel 1)))]
                    [(ResultMacroLocalFollowup.Err diag)
                      (ResultMacroExpand.Err diag)])]
                [can-process-local-module-placeholder
                  (match (macro-expand-local-followup-with-setup
                    normalized
                    normalized-paths
                    module-placeholder-work
                    pools)
                    [(ResultMacroLocalFollowup.Ok
                        local-normalized
                        local-normalized-paths
                        remaining-work)
                      (if (macro-followup-work-list-empty? remaining-work)
                        (macro-expand-program-with-paths-loop-and-pools
                          local-normalized
                          local-normalized-paths
                          pools
                          stdlib-roots
                          cfgs
                          (- fuel 1))
                        (macro-expand-finish-materialized
                          local-normalized
                          local-normalized-paths
                          remaining-work
                          MacroFollowupWorkList.Nil
                          pools
                          stdlib-roots
                          cfgs
                          fuel))]
                    [(ResultMacroLocalFollowup.Err diag)
                      (ResultMacroExpand.Err diag)])]
                [(or
                    has-pass-followup
                    has-materialized-followup
                    has-module-placeholder-followup)
                  (begin
                    (if has-pass-followup
                      (cfg
                        compile-profile
                        (compiler-tc-macro-profile-note-followup-needs-followup))
                      unit)
                    (if has-materialized-followup
                      (cfg
                        compile-profile
                        (compiler-tc-macro-profile-note-followup-generated-imports))
                      unit)
                    (if has-module-placeholder-followup
                      (cfg
                        compile-profile
                        (compiler-tc-macro-profile-note-followup-module-placeholders))
                      unit)
                    (macro-expand-program-with-paths-loop-and-pools
                      normalized
                      normalized-paths
                      pools
                      stdlib-roots
                      cfgs
                      (- fuel 1)))]
                [else (ResultMacroExpand.Ok normalized normalized-paths)]))])]
      [(ResultGenProgramWithPaths.Err diag) (ResultMacroExpand.Err diag)])))

(define (macro-expand-finish-materialized-with-local
  [materialized : AstProgram]
  [materialized-paths : AstDeclPathList]
  [pass-followup-work : MacroFollowupWorkList]
  [materialized-followup-work : MacroFollowupWorkList]
  [drop-pass-followup? : bool]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.StringVector]
  [cfgs : SymI64Env]
  [fuel : i64]) : ResultMacroExpand
  (let
    [has-materialized-followup : bool
      (not (macro-followup-work-list-empty? materialized-followup-work))]
    [can-process-local-materialized : bool
      (and
        has-materialized-followup
        (macro-local-followup-work-supported? materialized-followup-work))]
    (if can-process-local-materialized
      (match (macro-expand-local-followup-with-setup
        materialized
        materialized-paths
        materialized-followup-work
        pools)
        [(ResultMacroLocalFollowup.Ok
            local-materialized
            local-materialized-paths
            remaining-work)
          (if drop-pass-followup?
            (macro-expand-finish-materialized
              local-materialized
              local-materialized-paths
              MacroFollowupWorkList.Nil
              remaining-work
              pools
              stdlib-roots
              cfgs
              fuel)
            (begin
              (cfg
                compile-profile
                (compiler-tc-macro-profile-note-followup-needs-followup))
              (if (not (macro-followup-work-list-empty? remaining-work))
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-note-followup-generated-imports))
                unit)
              (macro-expand-program-with-paths-loop-and-pools
                local-materialized
                local-materialized-paths
                pools
                stdlib-roots
                cfgs
                (- fuel 1))))]
        [(ResultMacroLocalFollowup.Err diag) (ResultMacroExpand.Err diag)])
      (macro-expand-finish-materialized
        materialized
        materialized-paths
        pass-followup-work
        materialized-followup-work
        pools
        stdlib-roots
        cfgs
        fuel))))

(define (macro-expand-program-with-paths-loop-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.StringVector]
  [cfgs : sym_i64_env.SymI64Env]
  [fuel : i64]) : ResultMacroExpand
  (if (< fuel 0)
    (ResultMacroExpand.Err
      (box
        (tc-diag-at-start
          "typecheck: module macro expansion exceeded fixed-point limit")))
    (begin
      (cfg compile-profile (compiler-tc-macro-profile-note-fixed-point-pass))
      (match (macro-expand-program-pass-with-paths-and-pools-with-followup
        program
        paths
        pools)
        [(ResultMacroExpandPass.Ok expanded expanded-paths pass-followup-work)
          (match (macro-materialize-generated-imports
            expanded
            expanded-paths
            stdlib-roots
            cfgs
            pools)
            [(ResultMacroMaterializeImport.Ok
                materialized-decls
                materialized-paths
                _
                materialized-followup-work)
              (let
                [materialized : AstProgram (ast-program materialized-decls)]
                [has-pass-followup : bool
                  (not (macro-followup-work-list-empty? pass-followup-work))]
                [can-process-local-pass : bool
                  (and
                    has-pass-followup
                    (macro-local-followup-work-supported? pass-followup-work))]
                (if can-process-local-pass
                  (match (macro-expand-local-followup-with-setup
                    expanded
                    expanded-paths
                    pass-followup-work
                    pools)
                    [(ResultMacroLocalFollowup.Ok
                        pre-materialized
                        pre-materialized-paths
                        remaining-pass-followup-work)
                      (match (macro-materialize-generated-imports
                        pre-materialized
                        pre-materialized-paths
                        stdlib-roots
                        cfgs
                        pools)
                        [(ResultMacroMaterializeImport.Ok
                            local-materialized-decls
                            local-materialized-paths
                            _
                            local-materialized-followup-work)
                          (macro-expand-finish-materialized-with-local
                            (ast-program local-materialized-decls)
                            local-materialized-paths
                            remaining-pass-followup-work
                            local-materialized-followup-work
                            (not
                              (macro-program-followup-work-has-module-placeholder?
                                pre-materialized
                                remaining-pass-followup-work))
                            pools
                            stdlib-roots
                            cfgs
                            fuel)]
                        [(ResultMacroMaterializeImport.Err diag)
                          (ResultMacroExpand.Err diag)])]
                    [(ResultMacroLocalFollowup.Err diag)
                      (ResultMacroExpand.Err diag)])
                  (macro-expand-finish-materialized-with-local
                    materialized
                    materialized-paths
                    pass-followup-work
                    materialized-followup-work
                    (not
                      (macro-program-followup-work-has-module-placeholder?
                        expanded
                        pass-followup-work))
                    pools
                    stdlib-roots
                    cfgs
                    fuel)))]
            [(ResultMacroMaterializeImport.Err diag)
              (ResultMacroExpand.Err diag)])]
        [(ResultMacroExpandPass.Err diag) (ResultMacroExpand.Err diag)]))))

(define (macro-expand-program-with-paths-loop
  [program : AstProgram]
  [paths : AstDeclPathList]
  [fuel : i64]) : ResultMacroExpand
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-reset-loop-counters))
    (macro-expand-program-with-paths-loop-and-pools
      program
      paths
      (ast-node-pool-context-capture-active)
      (svec.new)
      (compiler-cfg-empty)
      fuel)))

(define (macro-expand-program-with-paths-and-pools-roots-cfg
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.StringVector]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-reset-loop-counters))
    (tc-stdlib-comptime-macro-surface-ok-reset!)
    (macro-expand-program-with-paths-loop-and-pools
      program
      paths
      pools
      stdlib-roots
      cfgs
      (macro-expand-fixed-point-limit-for-program program))))

(define (macro-expand-program-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg
    program
    paths
    pools
    (svec.new)
    (compiler-cfg-empty)))

(define (macro-expand-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools
    program
    paths
    (ast-node-pool-context-capture-active)))

(define (macro-expand-program [program : AstProgram]) : ResultMacroExpand
  (macro-expand-program-with-paths program (ast-decl-path-list-new)))

(define (tc-cleanup-owning-struct-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct struct-name)
      (match (tc-struct-decl ctx (intern-str struct-name))
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [(AstType.StructArgs struct-name _)
      (match (tc-struct-decl ctx (intern-str struct-name))
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-enum-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Enum enum-name)
      (match (tc-enum-decl ctx (intern-str enum-name))
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [(AstType.EnumArgs enum-name _)
      (match (tc-enum-decl ctx (intern-str enum-name))
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-aggregate-type? [ctx : TcContext] [ty : AstType]) : bool
  (or
    (tc-cleanup-owning-struct-type? ctx ty)
    (tc-cleanup-owning-enum-type? ctx ty)))

(define (tc-struct-field-cleanup-outside-message
  [struct-name : String]
  [field-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " has cleanup metadata but struct is not cleanup-owning"))

(define (tc-struct-field-cleanup-owning-without-owned-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-struct-field-owned-non-cleanup-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-struct-field-cleanup-fn-mismatch-message
  [struct-name : String]
  [field-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-cleanup-source-slash-alias-helper-name
  [ctx : TcContext]
  [cleanup-str : String]
  [cleanup-name : i64]) : i64
  (let
    [qualifier : String (tc-qualified-name-module cleanup-str)]
    [base : String (tc-qualified-name-base cleanup-str)]
    (match (tc-context-program ctx)
      [(AstProgram.Program decls-box)
        (match (macro-import-alias-target-cached
          (box-get decls-box)
          (intern (tc-context-module ctx))
          qualifier)
          [(TcMaybeString.Some target-module)
            (intern (compiler-symbol-module-key target-module base))]
          [(TcMaybeString.No) cleanup-name])])))

(define (tc-cleanup-field-helper-name
  [ctx : TcContext]
  [owner-name : String]
  [cleanup-name : i64]) : i64
  (let
    [cleanup-str : String (intern-str cleanup-name)]
    (if (tc-source-slash-qualified-id? cleanup-str cleanup-name)
      (tc-cleanup-source-slash-alias-helper-name ctx cleanup-str cleanup-name)
      (intern
        (if (tc-name-qualified? cleanup-str)
          cleanup-str
          (compiler-symbol-module-key
            (tc-qualified-name-module owner-name)
            cleanup-str))))))

(define (tc-check-struct-field-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [field-name : String]
  [cleanup-name : i64]
  [field-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx struct-name cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions field-ty) (AstType.Unit))
          (tc-struct-field-cleanup-fn-mismatch-message
            struct-name
            field-name
            (intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-cleanup : AstStructCleanup]
  [field : AstFieldDef]) : ResultTcUnit
  (match field
    [(AstFieldDef.Def field-name ty field-cleanup)
      (let
        [field-name-str : String (intern-str field-name)]
        [resolved-ty : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        [field-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        (if (not (ast-struct-cleanup? struct-cleanup))
          (if (ast-field-cleanup? field-cleanup)
            (ResultTcUnit.Err
              (tc-struct-field-cleanup-outside-message
                struct-name
                field-name-str))
            (if field-cleanup-owning
              (ResultTcUnit.Err
                (tc-struct-field-cleanup-owning-without-owned-message
                  struct-name
                  field-name-str
                  resolved-ty))
              ResultTcUnit.Ok))
          (match field-cleanup
            [(AstFieldCleanup.Owned)
              (if field-cleanup-owning
                ResultTcUnit.Ok
                (ResultTcUnit.Err
                  (tc-struct-field-owned-non-cleanup-message
                    struct-name
                    field-name-str
                    resolved-ty)))]
            [(AstFieldCleanup.Fn cleanup-name)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                (tc-check-struct-field-cleanup-fn
                  ctx
                  env
                  struct-name
                  field-name-str
                  cleanup-name
                  resolved-ty))]
            [(AstFieldCleanup.No)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                ResultTcUnit.Ok)])))]))

(define (tc-check-cleanup-struct-fields
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-check-cleanup-struct-fields-at ctx env struct-name cleanup (& fields) 0))

(define (tc-check-cleanup-struct-fields-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [cleanup : AstStructCleanup]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (tc-check-cleanup-struct-field
      ctx
      env
      struct-name
      cleanup
      (ast-field-def-list-get fields index (ast-field-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-struct-fields-at
          ctx
          env
          struct-name
          cleanup
          fields
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [repr : AstStructRepr]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (let
    [struct-name : String name]
    (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
      (ResultTcUnit.Err (tc-struct-cleanup-repr-c-message struct-name))
      (tc-check-cleanup-struct-fields ctx env struct-name cleanup fields))))

(define (tc-enum-cleanup-fn-mismatch-message
  [enum-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-enum-payload-cleanup-outside-message
  [enum-name : String]
  [variant-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " has payload cleanup metadata but enum is not cleanup-owning"))

(define (tc-enum-payload-cleanup-owning-without-owned-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-enum-payload-owned-non-cleanup-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-enum-payload-cleanup-fn-mismatch-message
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-check-enum-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : ResultTcUnit
  (match cleanup
    [(AstEnumCleanup.No) ResultTcUnit.Ok]
    [(AstEnumCleanup.Fn cleanup-name)
      (match (tc-lookup-visible-id ctx env cleanup-name)
        [(ResultTcType.Ok cleanup-ty)
          (tc-expect
            cleanup-ty
            (tc-fn1 (tc-type-without-regions enum-ty) (AstType.Unit))
            (tc-enum-cleanup-fn-mismatch-message
              enum-name
              (intern-str cleanup-name)))]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)])]))

(define (tc-check-enum-payload-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : i64]
  [payload-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx enum-name cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions payload-ty) (AstType.Unit))
          (tc-enum-payload-cleanup-fn-mismatch-message
            enum-name
            variant-name
            (intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-payloads
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [enum-cleanup : AstEnumCleanup]
  [payloads : AstTypeList]
  [payload-cleanups : AstVariantPayloadCleanupList]) : ResultTcUnit
  (tc-check-cleanup-enum-payloads-at
    ctx
    env
    enum-name
    variant-name
    enum-cleanup
    (& payloads)
    (& payload-cleanups)
    0))

(define (tc-check-cleanup-enum-payloads-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [enum-cleanup : AstEnumCleanup]
  [payloads : (& payloads AstTypeList)]
  [payload-cleanups : (& payload-cleanups AstVariantPayloadCleanupList)]
  [cleanup-index : i64]) : ResultTcUnit
  (if (>= cleanup-index (ast-type-list-len payloads))
    (if (>=
      cleanup-index
      (ast-variant-payload-cleanup-list-len payload-cleanups))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata"))
    (if (>=
      cleanup-index
      (ast-variant-payload-cleanup-list-len payload-cleanups))
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata")
      (let
        [payload-cleanup : AstVariantPayloadCleanup
          (ast-variant-payload-cleanup-list-get
            payload-cleanups
            cleanup-index
            (ast-variant-payload-cleanup-fallback))]
        [payload-ty : AstType
          (ty-node-get
            (ast-type-list-get payloads cleanup-index (ast-type-id-fallback)))]
        [resolved-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx payload-ty))]
        [payload-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        [step : ResultTcUnit
          (if (not (ast-enum-cleanup? enum-cleanup))
            (if (ast-variant-payload-cleanup? payload-cleanup)
              (ResultTcUnit.Err
                (tc-enum-payload-cleanup-outside-message enum-name variant-name))
              (if payload-cleanup-owning
                (ResultTcUnit.Err
                  (tc-enum-payload-cleanup-owning-without-owned-message
                    enum-name
                    variant-name
                    resolved-ty))
                ResultTcUnit.Ok))
            (match payload-cleanup
              [(AstVariantPayloadCleanup.Owned)
                (if payload-cleanup-owning
                  ResultTcUnit.Ok
                  (ResultTcUnit.Err
                    (tc-enum-payload-owned-non-cleanup-message
                      enum-name
                      variant-name
                      resolved-ty)))]
              [(AstVariantPayloadCleanup.Fn cleanup-name)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  (tc-check-enum-payload-cleanup-fn
                    ctx
                    env
                    enum-name
                    variant-name
                    cleanup-name
                    resolved-ty))]
              [(AstVariantPayloadCleanup.No)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  ResultTcUnit.Ok)]))]
        (match step
          [(ResultTcUnit.Ok)
            (tc-check-cleanup-enum-payloads-at
              ctx
              env
              enum-name
              variant-name
              enum-cleanup
              payloads
              payload-cleanups
              (+ cleanup-index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))))

(define (tc-check-cleanup-enum-variant
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [variant : AstVariantDef]) : ResultTcUnit
  (match variant
    [(AstVariantDef.Def variant-name payloads payload-cleanups)
      (tc-check-cleanup-enum-payloads
        ctx
        env
        enum-name
        (intern-str variant-name)
        cleanup
        payloads
        payload-cleanups)]))

(define (tc-check-cleanup-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-check-cleanup-enum-variants-at ctx env enum-name cleanup (& variants) 0))

(define (tc-check-cleanup-enum-variants-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (tc-check-cleanup-enum-variant
      ctx
      env
      enum-name
      cleanup
      (ast-variant-def-list-get variants index (ast-variant-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-enum-variants-at
          ctx
          env
          enum-name
          cleanup
          variants
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [lifetimes : AstLifetimeList]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (let
    [enum-name : String name]
    [enum-ty : AstType
      (if (ast-lifetime-list-empty? (& lifetimes))
        (AstType.Enum (intern enum-name))
        (ast-ty-enum-args (intern enum-name) lifetimes))]
    (match (tc-check-enum-cleanup-fn ctx env enum-name cleanup enum-ty)
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-enum-variants ctx env enum-name cleanup variants)]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

;: Check one function declaration's body against its signature.
(define (tc-check-fn-decl-body
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [body : AstExpr (ast-node-get body-box)]
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx global-env params)
        (tc-resolve-type ctx ret))]
    (begin
      (tc-body-type-facts-start-recording!)
      (match (tc-expr-with-expected-or-actual-id
        ctx
        env
        body-box
        (tc-resolve-type ctx ret))
        [(ResultTcType.Ok got)
          (begin
            (tc-body-type-facts-start-consuming!)
            (match (tc-expect
              got
              (tc-resolve-type ctx ret)
              "typecheck: return type mismatch")
              [(ResultTcUnit.Ok)
                (match (tc-ensure-region-value-can-flow-into
                  env
                  (tc-resolve-type ctx ret)
                  got
                  "return value")
                  [(ResultTcUnit.Ok)
                    (match (tc-move-check-body-id ctx env params body-box)
                      [(ResultTcUnit.Ok)
                        (let
                          [result : ResultTcUnit
                            (tc-borrow-check-body-id ctx env params body-box)]
                          (begin
                            (tc-body-type-facts-clear!)
                            result))]
                      [(ResultTcUnit.Err message)
                        (begin
                          (tc-body-type-facts-clear!)
                          (ResultTcUnit.Err message))])]
                  [(ResultTcUnit.Err message)
                    (begin
                      (tc-body-type-facts-clear!)
                      (ResultTcUnit.Err
                        (tc-rich-escape-at-expr
                          body
                          message
                          "function return type rejects this escaping value")))])]
              [(ResultTcUnit.Err message)
                (begin
                  (tc-body-type-facts-clear!)
                  (ResultTcUnit.Err message))]))]
        [(ResultTcType.Err message)
          (begin
            (tc-body-type-facts-clear!)
            (ResultTcUnit.Err message))]))))

;; Reusable scratch arena for per-function-body typechecks. Mirrors
;; lower-scratch-arena: created lazily, shared by every check (the body walk
;; is never re-entrant into another function-decl check), reclaimed by
;; mark/rewind per check.
(define tc-fn-scratch-arena : i64
  0)

(define (tc-fn-scratch-arena-get) : i64
  (if (= tc-fn-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! tc-fn-scratch-arena scratch)
        scratch))
    tc-fn-scratch-arena))

(define (tc-fn-scratch-arena-release!) : unit
  (if (= tc-fn-scratch-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-fn-scratch-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-fn-scratch-arena))
      (set! tc-fn-scratch-arena 0))))

;; Function bodies dominate typecheck allocation (~96% of the phase's live
;; delta; #2596) and the check returns only unit -- everything it allocates
;; is garbage once the body is checked, but the program-lifetime arena never
;; frees it. Run each body check in the shared scratch arena and rewind it
;; afterwards, cloning the error diagnostic out first (the mark/rewind/
;; clone-out shape of lower-function-escaping; do NOT re-run the check to
;; regenerate the message -- the body check is not idempotent and a second
;; run can surface a different diagnostic). New intern entries made while
;; the scratch is active must outlive it, so persistent intern storage is
;; forced on for the scope (the intern pool copies new strings into its
;; global-init base arena; see compiler_intern). Synthetic marker names use
;; tc-marker-name-id, which routes them to file-state storage instead.
;; Node pools already grow in the persistent base arena (#2357).
(define (tc-check-fn-decl-scoped
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [prev-persist : bool (intern-persistent-storage-on?)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (tc-fn-scratch-arena-get)]
    (begin
      (intern-persistent-storage-enable!)
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [raw : ResultTcUnit
          (tc-check-fn-decl-body ctx global-env params ret body-box)]
        [scratch-head : i64 (arena.tl_arena_current)]
        (begin
          (unsafe
            (arena.tl_arena_set enclosing))
          (let
            [escaped : ResultTcUnit
              (match raw
                [(ResultTcUnit.Ok) ResultTcUnit.Ok]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err (clone message))])]
            [new-enclosing : i64 (arena.tl_arena_current)]
            (begin
              (unsafe
                (arena.tl_arena_set scratch-head)
                (arena.tl_region_reset mark)
                (arena.tl_arena_set new-enclosing))
              (if prev-persist
                unit
                (intern-persistent-storage-disable!))
              ;; Single-entry name caches may hold strings allocated in the
              ;; scratch that was just rewound; invalidate them before
              ;; anything can compare against freed memory.
              (tc-nominal-owner-cache-reset!)
              escaped)))))))

(define (tc-check-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (begin
    ;; Type-name and owner caches are keyed by text/handle only. Helper passes
    ;; may typecheck with short-lived symbol tables before the final declaration
    ;; walk, so keep cache entries scoped to one checked declaration.
    (tc-nominal-owner-cache-reset!)
    (match decl
      [(AstDecl.Def _ maybe-ty expr-box)
        (match maybe-ty
          [(AstMaybeType.Some want)
            (match (tc-expr-with-expected-or-actual-id
              ctx
              global-env
              expr-box
              (tc-resolve-type ctx want))
              [(ResultTcType.Ok got)
                (match (tc-expect
                  got
                  (tc-resolve-type ctx want)
                  "typecheck: value definition type mismatch")
                  [(ResultTcUnit.Ok)
                    (tc-ensure-region-value-can-flow-into
                      global-env
                      (tc-resolve-type ctx want)
                      got
                      "top-level value")]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
          [(AstMaybeType.No)
            (match (tc-expr-id ctx global-env expr-box)
              [(ResultTcType.Ok _) ResultTcUnit.Ok]
              [(ResultTcType.Err message) (ResultTcUnit.Err message)])])]
      [(AstDecl.DefFn _ params ret body-box _)
        (tc-check-fn-decl-scoped ctx global-env params ret body-box)]
      [(AstDecl.DefMacro name params ret body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (tc-check-defmacro name ctx top-env params ret body))]
      [(AstDecl.Extern _ kind metadata ty)
        (tc-check-extern-decl ctx kind metadata ty)]
      [(AstDecl.DefDispatch name variants)
        (match (tc-dispatch-decl-type ctx (intern-str name) variants)
          [(ResultTcType.Ok _) ResultTcUnit.Ok]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
      [(AstDecl.DefEnum name cleanup variants)
        (tc-check-cleanup-enum-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          (ast-lifetime-list-new)
          cleanup
          variants)]
      [(AstDecl.DefEnumLifetimes name lifetimes cleanup variants)
        (tc-check-cleanup-enum-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          lifetimes
          cleanup
          variants)]
      [(AstDecl.DefStruct name repr cleanup fields)
        (tc-check-cleanup-struct-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          repr
          cleanup
          fields)]
      [(AstDecl.DefStructLifetimes name _ repr cleanup fields)
        (tc-check-cleanup-struct-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          repr
          cleanup
          fields)]
      [(AstDecl.ComptimeDecl meta template-box)
        (let
          [template : AstDecl (box-get template-box)]
          (match meta
            [(AstGeneratedDeclMeta.Some _ _ _ _)
              (tc-check-decl-with-global-env ctx top-env global-env template)]
            [(AstGeneratedDeclMeta.No)
              (match (tc-check-comptime-decl-purity ctx top-env template)
                [(ResultTcUnit.Ok)
                  (tc-check-decl-with-global-env
                    ctx
                    top-env
                    global-env
                    template)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]))]
      [(AstDecl.Unsafe inner-box)
        (let
          [inner : AstDecl (box-get inner-box)]
          (tc-check-decl-with-global-env ctx top-env global-env inner))]
      [_ ResultTcUnit.Ok])))

(define (tc-check-decl [ctx : TcContext] [top-env : TcTypeEnv] [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl-with-global-env
    ctx
    top-env
    (tc-hygiene-global-env top-env)
    decl))

(define (tc-check-decl-scoped-name [ctx : TcContext] [name : i64]) : String
  (let
    [text : String (intern-str name)]
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? text)))
      (compiler-symbol-module-key module text)
      text)))

(define (tc-check-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (tc-check-decls-in-module ctx top-env decls summary ""))

(define (tc-check-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]
  [module : String]) : ResultCompilerTypecheck
  (let
    [cursor : AstDeclList decls]
    [current-summary : CompilerTypecheckSummary summary]
    [current-module : String module]
    [done : bool false]
    [result : ResultCompilerTypecheck
      (ResultCompilerTypecheck.Ok current-summary)]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil)
            (begin
              (set! result (ResultCompilerTypecheck.Ok current-summary))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [next : AstDeclList rest]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! current-module (intern-str next-module))
                    (set! cursor next))]
                [_
                  (match (tc-module-local-env ctx top-env current-module)
                    [(ResultTcEnv.Ok local-env)
                      (let
                        [decl-ctx : TcContext
                          (tc-context-with-module ctx current-module)]
                        (match (tc-check-decl decl-ctx local-env decl)
                          [(ResultTcUnit.Ok)
                            (begin
                              (set!
                                current-summary
                                (tc-summary-add-decl current-summary decl))
                              (set! cursor next))]
                          [(ResultTcUnit.Err message)
                            (begin
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box (tc-decl-diag decl message))))
                              (set! done true))]))]
                    [(ResultTcEnv.Err message)
                      (begin
                        (set!
                          result
                          (ResultCompilerTypecheck.Err
                            (box (tc-decl-diag decl message))))
                        (set! done true))])]))]))
      result)))

(define (tc-decl-path-list-last [paths : AstDeclPathList] [last : String]) : String
  (match (ast-decl-path-list-step paths)
    [(AstDeclPathListStep.Nil) last]
    [(AstDeclPathListStep.Cons path rest)
      (let
        [rest : AstDeclPathList rest]
        (tc-decl-path-list-last rest path))]))

(define (tc-prefix-decl-key [decl : AstDecl]) : String
  (match decl
    [(AstDecl.Module name) (str_cat.str-cat "module:" (intern-str name))]
    [(AstDecl.ModuleBody name _)
      (str_cat.str-cat "module-body:" (intern-str name))]
    [(AstDecl.Def name _ _) (str_cat.str-cat "def:" (intern-str name))]
    [(AstDecl.DefFn name _ _ _ _) (str_cat.str-cat "fn:" (intern-str name))]
    [(AstDecl.DefMacro name _ _ _) (str_cat.str-cat "macro:" (intern-str name))]
    [(AstDecl.Extern name _ _ _) (str_cat.str-cat "extern:" (intern-str name))]
    [(AstDecl.DefEnum name _ _) (str_cat.str-cat "enum:" (intern-str name))]
    [(AstDecl.DefEnumLifetimes name _ _ _)
      (str_cat.str-cat "enum-lifetimes:" (intern-str name))]
    [(AstDecl.DefStruct name _ _ _)
      (str_cat.str-cat "struct:" (intern-str name))]
    [(AstDecl.DefStructLifetimes name _ _ _ _)
      (str_cat.str-cat "struct-lifetimes:" (intern-str name))]
    [(AstDecl.Import _) "import"]
    [(AstDecl.IncludeStr name _) (str_cat.str-cat "include-str:" name)]
    [(AstDecl.IncludeBin name _) (str_cat.str-cat "include-bin:" name)]
    [(AstDecl.DefDispatch name _)
      (str_cat.str-cat "dispatch:" (intern-str name))]
    [(AstDecl.Test name _ _) (str_cat.str-cat "test:" (intern-str name))]
    [(AstDecl.Unsafe inner)
      (str_cat.str-cat "unsafe:" (tc-prefix-decl-key (box-get inner)))]
    [(AstDecl.ComptimeDecl _ inner)
      (str_cat.str-cat "comptime:" (tc-prefix-decl-key (box-get inner)))]))

(define (tc-prefix-key-add [key : String] [decl-path : String] [decl : AstDecl]) : String
  (str_cat.str-cat
    key
    (string.int->string (string.string-length decl-path))
    ":"
    decl-path
    ":"
    (tc-prefix-decl-key decl)
    ";"))

(define (tc-prefix-key-start [scope : String]) : String
  (str_cat.str-cat
    "tc-prefix-v3;"
    (string.int->string (string.string-length scope))
    ":"
    scope
    ";"))

(define (tc-prefix-default-cache-scope) : String
  "direct")

(define (tc-prefix-cache-stdlib-path?
  [path : String]
  [stdlib-roots : svec.StringVector]) : bool
  (if (compiler-load-stdlib-import? path)
    true
    (let
      [normalized : String (compiler-load-normalize-path path)]
      (if (compiler-load-stdlib-import? normalized)
        true
        (compiler-load-path-under-roots-from?
          normalized
          stdlib-roots
          0
          (svec.len (& stdlib-roots)))))))

(define (tc-prefix-cache-module-marker? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Module name) (> (string.string-length (intern-str name)) 0)]
    [_ false]))

(define (tc-prefix-cache-decl-safe?
  [decl-path : String]
  [decl : AstDecl]
  [stdlib-roots : svec.StringVector]
  [same-path-module-safe : bool]) : bool
  (if (tc-prefix-cache-stdlib-path? decl-path stdlib-roots)
    true
    (or same-path-module-safe (tc-prefix-cache-module-marker? decl))))

(define (tc-prefix-candidate-from
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [entry-path : String]
  [count : i64]
  [module : String]
  [active-path : String]
  [active-path-module-safe : bool]
  [key : String]) : TcPrefixCandidate
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (TcPrefixCandidate.No)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) ""])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [same-path : bool (string.eq active-path decl-path)]
        [same-path-module-safe : bool
          (if same-path
            active-path-module-safe
            false)]
        [decl-module-safe : bool
          (or same-path-module-safe (tc-prefix-cache-module-marker? decl))]
        (cond
          [(string.eq decl-path entry-path)
            (if (> count 0)
              (TcPrefixCandidate.Some key count module)
              (TcPrefixCandidate.No))]
          [(tc-prefix-cache-decl-safe?
              decl-path
              decl
              stdlib-roots
              same-path-module-safe)
            (let
              [next-module : String
                (match decl
                  [(AstDecl.Module next-module) (intern-str next-module)]
                  [_ module])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                decl-path
                decl-module-safe
                (tc-prefix-key-add key decl-path decl)))]
          [(> count 0) (TcPrefixCandidate.Some key count module)]
          [else (TcPrefixCandidate.No)]))]))

(define (tc-prefix-candidate
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]) : TcPrefixCandidate
  (let
    [entry-path : String (tc-decl-path-list-last paths "")]
    [effective-roots : svec.StringVector
      (compiler-load-roots-with-env stdlib-roots)]
    (if (string.eq entry-path "")
      (TcPrefixCandidate.No)
      (tc-prefix-candidate-from
        decls
        paths
        effective-roots
        entry-path
        0
        ""
        ""
        false
        (tc-prefix-key-start cache-scope)))))

(define (tc-decl-list-take [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    (ast-decl-list-new)
    (let
      [len : i64 (ast-decl-list-len (& decls))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (AstDeclList
        (struct-get decls slots)
        (struct-get decls offset)
        take-count
        false))))

(define (tc-decl-path-list-take [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    (ast-decl-path-list-new)
    (let
      [len : i64 (ast-decl-path-list-len (& paths))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (AstDeclPathList
        (struct-get paths slots)
        (struct-get paths offset)
        take-count
        false))))

(define (tc-decl-list-drop [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    decls
    (let
      [len : i64 (ast-decl-list-len (& decls))]
      (if (>= count len)
        (ast-decl-list-new)
        (AstDeclList
          (struct-get decls slots)
          (+ (struct-get decls offset) count)
          (- len count)
          false)))))

(define (tc-decl-path-list-drop [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    paths
    (let
      [len : i64 (ast-decl-path-list-len (& paths))]
      (if (>= count len)
        (ast-decl-path-list-new)
        (AstDeclPathList
          (struct-get paths slots)
          (+ (struct-get paths offset) count)
          (- len count)
          false)))))

(define (tc-check-decls-with-paths-cold
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      decls
      paths
      summary
      ""
      (TcModuleLocalEnvCache.Nil))))

(define (tc-check-decls-with-prefix-hit
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [count : i64]
  [module : String]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-hit!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      summary
      module
      (TcModuleLocalEnvCache.Nil))))

(define (tc-check-decls-with-prefix-miss
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [key : String]
  [count : i64]
  [module : String]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-miss!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (match (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-take decls count)
      (tc-decl-path-list-take paths count)
      (CompilerTypecheckSummary 0 0 0)
      ""
      (TcModuleLocalEnvCache.Nil))
      [(ResultCompilerTypecheck.Ok prefix-summary)
        (begin
          (tc-prefix-snapshot-cache-store-persistent
            key
            count
            module
            prefix-summary)
          (cfg compile-profile (compiler-tc-decl-profile-reset))
          (tc-check-decls-with-paths-in-module
            ctx
            top-env
            (tc-decl-list-drop decls count)
            (tc-decl-path-list-drop paths count)
            prefix-summary
            module
            (TcModuleLocalEnvCache.Nil)))]
      [(ResultCompilerTypecheck.Err diag) (ResultCompilerTypecheck.Err diag)])))

(define (tc-check-decls-with-paths
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]) : ResultCompilerTypecheck
  (if (tc-prefix-snapshot-cache-active?)
    (match (tc-prefix-candidate decls paths stdlib-roots cache-scope)
      [(TcPrefixCandidate.Some key count module)
        (match (tc-prefix-snapshot-cache-lookup key)
          [(TcPrefixSnapshotLookup.Hit
              cached-count
              cached-module
              cached-summary)
            (tc-check-decls-with-prefix-hit
              ctx
              top-env
              decls
              paths
              cached-count
              cached-module
              cached-summary)]
          [(TcPrefixSnapshotLookup.Miss)
            (tc-check-decls-with-prefix-miss
              ctx
              top-env
              decls
              paths
              key
              count
              module)])]
      [(TcPrefixCandidate.No)
        (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])
    (tc-check-decls-with-paths-cold ctx top-env decls paths summary)))

(define (tc-generated-clone-name? [name : String]) : bool
  (if (>= (string.string-length name) 6)
    (string.eq (string.substring name 0 6) "clone$")
    false))

(define (tc-generated-clone-decl-with-path? [decl : AstDecl] [path : String]) : bool
  (if (string.eq path "")
    (match decl
      [(AstDecl.DefFn name _ _ _ _)
        (tc-generated-clone-name? (intern-str name))]
      [_ false])
    false))

(define (tc-typecheck-diag-with-path
  [decl : AstDecl]
  [path : String]
  [message : String]) : CompilerDiagnostic
  (let
    [diag : CompilerDiagnostic (tc-decl-diag decl message)]
    (if (string.eq path "")
      diag
      (compiler-diagnostic-with-path diag path))))

;; Direct declaration typechecking stays below the self-build memory budget and
;; avoids the per-declaration scratch arena overhead.
(define (tc-check-decl-escaping
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl ctx top-env decl))

(define (tc-check-one-decl-with-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decl : AstDecl]
  [module : String]) : ResultTcUnit
  (match (tc-module-local-env ctx top-env module)
    [(ResultTcEnv.Ok local-env)
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (tc-check-decl-escaping decl-ctx local-env decl))]
    [(ResultTcEnv.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-decls-with-paths-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [cache : TcModuleLocalEnvCache]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-start-section))
    (match (tc-module-local-env-cached ctx top-env module cache)
      [(ResultTcModuleLocalEnv.Ok local-env next-cache)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (tc-check-decls-with-paths-in-module-env
            ctx
            top-env
            decls
            paths
            summary
            module
            next-cache
            local-env
            (tc-hygiene-global-env local-env)))]
      [(ResultTcModuleLocalEnv.Err message)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (ResultCompilerTypecheck.Err (box (tc-diag-at-start message))))])))

(define (tc-check-decls-with-paths-in-module-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [cache : TcModuleLocalEnvCache]
  [local-env : TcTypeEnv]
  [global-env : TcTypeEnv]) : ResultCompilerTypecheck
  ;; #2599: this walks every expanded top-level declaration during self-compile.
  ;; Keep it iterative so a large program does not consume one native stack frame
  ;; per declaration on Windows selfhost binaries.
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-summary : CompilerTypecheckSummary summary]
    [cur-module : String module]
    [cur-cache : TcModuleLocalEnvCache cache]
    [cur-local-env : TcTypeEnv local-env]
    [cur-global-env : TcTypeEnv global-env]
    [result : ResultCompilerTypecheck
      (ResultCompilerTypecheck.Err
        (box (tc-diag-at-start "typecheck: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (begin
              (cfg compile-profile (compiler-tc-decl-profile-finish))
              (set! result (ResultCompilerTypecheck.Ok cur-summary))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [rest-paths : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList path-rest]
                      path-rest)]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-tc-decl-profile-start-section))
                    (tc-context-capture-active-pools! ctx)
                    (match (tc-module-local-env-cached
                      ctx
                      top-env
                      (intern-str next-module)
                      cur-cache)
                      [(ResultTcModuleLocalEnv.Ok next-local-env next-cache)
                        (match (tc-module-local-env-cached
                          ctx
                          top-env
                          (intern-str next-module)
                          cur-cache)
                          [(ResultTcModuleLocalEnv.Ok next-local-env-copy _)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set! cur-module (intern-str next-module))
                              (set! cur-cache next-cache)
                              (set!
                                cur-global-env
                                (tc-hygiene-global-env next-local-env))
                              (set! cur-local-env next-local-env-copy))]
                          [(ResultTcModuleLocalEnv.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box
                                    (tc-typecheck-diag-with-path
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))])]
                      [(ResultTcModuleLocalEnv.Err message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-decl-profile-add-local-env))
                          (set!
                            result
                            (ResultCompilerTypecheck.Err
                              (box
                                (tc-typecheck-diag-with-path
                                  decl
                                  decl-path
                                  message))))
                          (set! done true))]))]
                [_
                  (if (tc-generated-clone-decl-with-path? decl decl-path)
                    (begin
                      (set! cur-decls rest)
                      (set! cur-paths rest-paths)
                      (set! cur-summary (tc-summary-add-decl cur-summary decl)))
                    (let
                      [decl-ctx : TcContext
                        (tc-context-with-module ctx cur-module)]
                      [prev-path : String
                        (tc-unused-unsafe-set-current-path! decl-path)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-decl-profile-start-section))
                        (tc-context-capture-active-pools! decl-ctx)
                        (match (tc-check-decl-with-global-env
                          decl-ctx
                          cur-local-env
                          cur-global-env
                          decl)
                          [(ResultTcUnit.Ok)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-record decl))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set!
                                cur-summary
                                (tc-summary-add-decl cur-summary decl)))]
                          [(ResultTcUnit.Err message)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box
                                    (tc-typecheck-diag-with-path
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))]))))]))]))
      result)))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (begin
    (tc-nominal-owner-cache-reset!)
    (ast-node-pool-context-install! pools)
    (match (build-compiler-symbols-with-paths program paths)
      [(ResultCompilerSymbols.Ok symbols)
        (match (build-compiler-registries-with-symbols program symbols)
          [(ResultCompilerRegistries.Ok registries)
            (let
              [ctx : TcContext (TcContext program symbols registries "" pools)]
              (match (tc-stdlib-comptime-surface-ok ctx)
                [(ResultTcUnit.Ok)
                  (match (tc-program-source-types-policy-ok ctx program)
                    [(ResultTcUnit.Ok)
                      (match (tc-build-top-env ctx program)
                        [(ResultTcEnv.Ok top-env)
                          (match program
                            [(AstProgram.Program decls-box)
                              (let
                                [decls : AstDeclList (box-get decls-box)]
                                (begin
                                  (tc-hygiene-reset-active-top-env! top-env)
                                  (tc-context-capture-active-pools! ctx)
                                  (tc-clone-able-cache-populate! ctx)
                                  (tc-macro-helper-env-cache-reset!)
                                  (match (tc-check-decls-with-paths
                                    ctx
                                    top-env
                                    decls
                                    paths
                                    (CompilerTypecheckSummary 0 0 0)
                                    stdlib-roots
                                    cache-scope)
                                    [(ResultCompilerTypecheck.Ok summary)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (ResultCompilerTypecheckChecked.Ok
                                          summary
                                          ctx
                                          top-env))]
                                    [(ResultCompilerTypecheck.Err diag)
                                      (ResultCompilerTypecheckChecked.Err diag)])))])]
                        [(ResultTcEnv.Err message)
                          (ResultCompilerTypecheckChecked.Err
                            (box (tc-diag-at-start message)))])]
                    [(ResultTcUnit.Err message)
                      (ResultCompilerTypecheckChecked.Err
                        (box (tc-diag-at-start message)))])]
                [(ResultTcUnit.Err message)
                  (ResultCompilerTypecheckChecked.Err
                    (box (tc-diag-at-start message)))]))]
          [(ResultCompilerRegistries.Err message)
            (ResultCompilerTypecheckChecked.Err
              (box (tc-diag-at-start message)))])]
      [(ResultCompilerSymbols.Err message)
        (ResultCompilerTypecheckChecked.Err (box (tc-diag-at-start message)))])))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner
      program
      paths
      stdlib-roots
      cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
      program
      paths
      stdlib-roots
      cache-scope
      pools)))

(define (typecheck-compiler-specialized-program-with-paths-checked
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    (svec.new)
    (tc-prefix-default-cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    stdlib-roots
    cache-scope)
    [(ResultCompilerTypecheckChecked.Ok summary _ _)
      (ResultCompilerTypecheck.Ok summary)]
    [(ResultCompilerTypecheckChecked.Err diag)
      (ResultCompilerTypecheck.Err diag)]))

(define (typecheck-compiler-specialized-program-with-paths-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.StringVector]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    pools)
    [(ResultCompilerTypecheckChecked.Ok summary _ _)
      (ResultCompilerTypecheck.Ok summary)]
    [(ResultCompilerTypecheckChecked.Err diag)
      (ResultCompilerTypecheck.Err diag)]))

(define (typecheck-compiler-specialized-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheck
  (typecheck-compiler-specialized-program-with-paths-cache
    program
    paths
    (svec.new)
    (tc-prefix-default-cache-scope)))

(define (compiler-typecheck-reset-file-state!) : unit
  (begin
    (tc-fn-scratch-arena-release!)
    (tc-clone-able-cache-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-spmd-inline-helper-stack-reset!)
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (tc-stdlib-comptime-macro-surface-ok-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    (macro-alias-cache-reset!)
    (compiler-load-surface-summaries-reset!)
    (ctfe-build-seen-reset!)
    (set! tc-hygiene-active-top-env-ready false)
    (set! tc-hygiene-active-top-env (tc-empty-type-env))
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))
    (set! macro-expand-active-module "")
    (set! macro-expand-macro-names (TcStringList.Nil))
    (set! macro-expand-expr-type-macro-names (TcStringList.Nil))
    (set! macro-expand-ctfe-env-ready false)
    (set! macro-expand-ctfe-env-value (ctfe-env-empty))
    (set! tc-lazy-import-summary-macro-force-record-count 0)
    (ctfe-module-macro-export-reset!)
    (set! ctfe-needs-metadata true)))

(define (compiler-typecheck-reset-intern-owned-state!) : unit
  (begin
    (tc-marker-name-id-arena-reset!)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))