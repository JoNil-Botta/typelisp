;; TcTypeEnv.Cache fields: ids map, values, unsafe flags, raw C fnptr flags,
;; default-shadow flags, scan-through, partial, rest, below. The flag arrays
;; parallel `values`:
;; the raw C fnptr flag records whether the head-most binding is a raw C
;; function pointer value, and bit 0 of the packed default-shadow sidecar is set
;; when the head-most binding sits above the first default-boundary marker
;; (replaces the former whole-env shadows map).
;; The default-shadow array is a packed ordinary-marker sidecar: bit 0 records
;; the default-boundary fact, while bits 1-3 record whether the head-most
;; ordinary binding is paired with a cleanup, ordinary-arena, or atomic-arena
;; owner marker.  This preserves the persistent env's snapshot semantics while
;; letting owner queries use the existing relevance index instead of mirroring
;; every bind into the scoped runtime.
;; `scan-through` is true for threshold-compaction caches created in the
;; middle of function-body spines: marker-position scans (active region,
;; return type, unsafe context, cleanup owners, lifetimes, lambda capture
;; checks) must keep scanning the spine below such a cache, because the
;; markers they look for can be buried more than a compaction window up
;; (with-arena escape checking was once silently disabled past 32 local
;; binds). Explicit top-env/module caches keep scan-through false so those
;; scans still terminate without walking the global env spine. Full explicit
;; caches are authoritative on miss; explicit layered caches are partial for
;; lookup fall-through but still stop marker scans. Partial local caches cover
;; only the compaction prefix; their `rest` keeps the full spine for marker
;; scans, while `below` skips the covered prefix for lookup miss fall-through.
(defenum TcTypeEnv
  (Nil)
  (Bind i64 AstType (Box TcTypeEnv))
  (Cache
    tc_i64_i64_map.Map
    (Array AstType)
    (Array i64)
    (Array i64)
    (Array i64)
    bool
    bool
    (Box TcTypeEnv)
    (Box TcTypeEnv)))

(defenum TcTypeEnvSpineStep
  (Done)
  (Cache TcTypeEnv)
  (Bind i64 AstType TcTypeEnv))

(defenum TcTypeEnvMarkerStep
  (Done)
  (Cache TcTypeEnv)
  (Bind i64 AstType TcTypeEnv))

(defenum TcTypeEnvLookupStep
  (Missing)
  (Miss TcTypeEnv)
  (Found AstType))

(defenum TcTypeEnvUnsafeLookupStep
  (Missing)
  (Miss TcTypeEnv)
  (Found AstType bool))

(defenum TcTypeEnvScopedMarkerKind
  (None)
  (UnsafeDecl)
  (CAbiFnptr)
  (DefaultBoundary)
  (Region)
  (UnsafeContext)
  (CleanupOwner)
  (OrdinaryArenaOwner)
  (AtomicArenaOwner)
  (Other))

(defstruct TcTypeEnvScopedSlot
  (name-id i64)
  (ty AstType)
  (flags i64)
  (marker-kind-tag i64)
  (scope-depth i64)
  (generation i64))

(defstruct TcTypeEnvScopedMark
  (slot-count i64)
  (mark-count i64)
  (scope-depth i64)
  (cache-generation i64))

(defstruct TcTypeEnvScopedStack
  (slots (Array TcTypeEnvScopedSlot))
  (slot-count i64)
  ;; Latest slot per out-of-range name. Dense intern ids use the shared
  ;; epoch-keyed arrays below; this map preserves the unbounded fallback.
  (lookup-cache tc_i64_i64_map.Map)
  (lookup-epoch i64)
  (marks (Array TcTypeEnvScopedMark))
  (mark-count i64)
  (scope-depth i64)
  (cache-generation i64))

(defstruct TcTypeEnvScopedMarkerCursor
  (stack TcTypeEnvScopedStack)
  (index i64))

(defstruct TcTypeEnvScopedSidecar
  ;; Immutable module/top-level snapshot. Only slots at materialize-start and
  ;; above are newer than this tail; earlier slots mirror it for marker scans.
  (persistent TcTypeEnv)
  (stack TcTypeEnvScopedStack)
  (materialize-start i64))

(defstruct TcTypeEnvScopedSidecarMark
  (persistent TcTypeEnv)
  (stack-mark TcTypeEnvScopedMark)
  (materialize-start i64))

(defstruct TcTypeEnvScopedCarrier
  ;; `env` is the last immutable snapshot. A dirty carrier owns newer bindings
  ;; in sidecar.stack and materializes them only at a legacy TcTypeEnv boundary.
  (env TcTypeEnv)
  (sidecar TcTypeEnvScopedSidecar)
  (dirty bool))

(defstruct TcTypeEnvScopedCarrierMark
  (env TcTypeEnv)
  (sidecar-mark TcTypeEnvScopedSidecarMark)
  (dirty bool))

(defstruct TcTypeEnvScopedCarrierSave
  (carrier TcTypeEnvScopedCarrier)
  (mark TcTypeEnvScopedCarrierMark))

(defenum TcTypeEnvScopedRuntimeSave
  (Inactive)
  (Scope TcTypeEnvScopedCarrierMark)
  (Replaced TcTypeEnvScopedCarrier))

(defenum TcTypeEnvScopedLookup
  (Missing)
  (Found AstType bool bool TcTypeEnvScopedMarkerKind i64 i64))

(defenum TcTypeEnvScopedMarkerLookup
  (Missing)
  (Found i64 AstType i64 i64))

(defenum TcTypeEnvScopedMarkerStep
  (Done)
  (Bind i64 AstType TcTypeEnvScopedMarkerCursor))

