    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.BoxGet inner-box)
