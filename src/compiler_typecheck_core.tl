(define (macro-scratch-decl-path-list-prefix-rev-current-suffix
  [prefix-rev : AstDeclPathList]
  [suffix : AstDeclPathList]) : AstDeclPathList
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : AstDeclPathList
            (macro-decl-path-list-prefix-rev-current-suffix prefix-rev suffix)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-decl-path-list-prefix-rev-current-suffix prefix-rev suffix)))

(defstruct MacroSpliceDeclView
  (view AstDeclList)
  (tail AstDeclList))

(defstruct MacroSplicePathView
  (view AstDeclPathList)
  (tail AstDeclPathList))

;; Whole-program view and walk tail for a forced splice, built in ONE backing
;; array per list with the shape [reversed prefix | spliced decls | remaining
;; decls]. The previous construction (append of the spliced decls onto the
;; tail, then reverse + append for the prefix, which always missed the prepend
;; headroom fast path) materialized three full-program arrays per list per
;; splice and dominated the macro scratch arena (~5MB per splice on a
;; self-compile). The tail shares the view's backing array, so each segment is
;; copied exactly once.
(define (macro-splice-decl-view-build
  [prefix-rev : AstDeclList]
  [middle : AstDeclList]
  [suffix : AstDeclList]) : MacroSpliceDeclView
  (let
    [prefix-count : i64 (ast-decl-list-len (& prefix-rev))]
    [middle-count : i64 (ast-decl-list-len (& middle))]
    [suffix-count : i64 (ast-decl-list-len (& suffix))]
    [total : i64 (+ prefix-count (+ middle-count suffix-count))]
    [slots : (Array AstDecl)
      (array.make-array
        AstDecl
        (if (< total 1)
          1
          total))]
    [index : i64 0]
    (begin
      (while (< index prefix-count)
        (begin
          (array-set!
            slots
            (- (- prefix-count 1) index)
            (ast-decl-list-ref prefix-rev index))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index middle-count)
        (begin
          (array-set!
            slots
            (+ prefix-count index)
            (ast-decl-list-ref middle index))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index suffix-count)
        (begin
          (array-set!
            slots
            (+ prefix-count (+ middle-count index))
            (ast-decl-list-ref suffix index))
          (set! index (+ index 1))))
      (MacroSpliceDeclView
        (AstDeclList slots 0 total true)
        (AstDeclList slots prefix-count (+ middle-count suffix-count) true)))))

(define (macro-splice-path-view-build
  [prefix-rev : AstDeclPathList]
  [middle : AstDeclPathList]
  [suffix : AstDeclPathList]) : MacroSplicePathView
  (let
    [prefix-count : i64 (ast-decl-path-list-len (& prefix-rev))]
    [middle-count : i64 (ast-decl-path-list-len (& middle))]
    [suffix-count : i64 (ast-decl-path-list-len (& suffix))]
    [total : i64 (+ prefix-count (+ middle-count suffix-count))]
    [cap : i64
      (if (< total 1)
        1
        total)]
    [slots : (Array String) (array.make-array String cap)]
    [owner-ids : (Array i64) (array.make-array i64 cap)]
    [index : i64 0]
    (begin
      (while (< index prefix-count)
        (begin
          (array-set!
            slots
            (- (- prefix-count 1) index)
            (ast-decl-path-list-get (& prefix-rev) index ""))
          (array-set!
            owner-ids
            (- (- prefix-count 1) index)
            (ast-decl-path-list-owner-id
              (& prefix-rev)
              index
              cbi.compiler-builtin-id-fix-empty))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index middle-count)
        (begin
          (array-set!
            slots
            (+ prefix-count index)
            (ast-decl-path-list-get (& middle) index ""))
          (array-set!
            owner-ids
            (+ prefix-count index)
            (ast-decl-path-list-owner-id
              (& middle)
              index
              cbi.compiler-builtin-id-fix-empty))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index suffix-count)
        (begin
          (array-set!
            slots
            (+ prefix-count (+ middle-count index))
            (ast-decl-path-list-get (& suffix) index ""))
          (array-set!
            owner-ids
            (+ prefix-count (+ middle-count index))
            (ast-decl-path-list-owner-id
              (& suffix)
              index
              cbi.compiler-builtin-id-fix-empty))
          (set! index (+ index 1))))
      (MacroSplicePathView
        (AstDeclPathList slots owner-ids 0 total true)
        (AstDeclPathList
          slots
          owner-ids
          prefix-count
          (+ middle-count suffix-count)
          true)))))

(define (macro-scratch-splice-decl-view-build
  [prefix-rev : AstDeclList]
  [middle : AstDeclList]
  [suffix : AstDeclList]) : MacroSpliceDeclView
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : MacroSpliceDeclView
            (macro-splice-decl-view-build prefix-rev middle suffix)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-splice-decl-view-build prefix-rev middle suffix)))

(define (macro-scratch-splice-path-view-build
  [prefix-rev : AstDeclPathList]
  [middle : AstDeclPathList]
  [suffix : AstDeclPathList]) : MacroSplicePathView
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : MacroSplicePathView
            (macro-splice-path-view-build prefix-rev middle suffix)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-splice-path-view-build prefix-rev middle suffix)))

(define (macro-scratch-decl-list-filter-path
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [wanted-path : String]) : AstDeclList
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : AstDeclList
            (macro-decl-list-filter-path decls paths wanted-path)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-decl-list-filter-path decls paths wanted-path)))

(define macro-active-decl-owner-id : i64
  -1)

(define (macro-paths-for-decls [decls : AstDeclList] [path : String]) : AstDeclPathList
  (let
    [out : AstDeclPathList
      (ast-decl-path-list-with-capacity (ast-decl-list-len (& decls)))]
    [index : i64 0]
    [count : i64 (ast-decl-list-len (& decls))]
    (begin
      (while (< index count)
        (begin
          (ast-decl-path-list-push-with-owner-id
            (&mut out)
            path
            (if (>= macro-active-decl-owner-id 0)
              macro-active-decl-owner-id
              cbi.compiler-builtin-id-fix-empty))
          (set! index (+ index 1))))
      out)))

(define (macro-decls-final-module-id [decls : AstDeclList] [module-id : i64]) : i64
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) module-id]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (macro-decls-final-module-id rest next-module)]
          [(AstDecl.ModuleBody next-module body-box)
            (macro-decls-final-module-id (box-get body-box) next-module)]
          [_ (macro-decls-final-module-id rest module-id)]))]))

(define (macro-decls-module-count [decls : AstDeclList]) : i64
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) 0]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest-count : i64 (macro-decls-module-count rest)]
        (match decl
          [(AstDecl.Module _) (+ rest-count 1)]
          [(AstDecl.ModuleBody _ body-box)
            (+ rest-count (+ 1 (macro-decls-module-count (box-get body-box))))]
          [_ rest-count]))]))

(define (macro-identity-key-join [head : String] [tail : String]) : String
  (if (> (string.string-length tail) 0)
    (str_cat.str-cat head ";" tail)
    head))

(define (macro-identity-key-string-expr
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (match (compiler-ctfe-eval expr env fuel)
    [(ResultCtfe.Ok value next-fuel)
      (match value
        [(CompilerCtfeValue.String text _)
          (ResultGenKey.Ok (spec-string-key text) next-fuel)]
        [(CompilerCtfeValue.Name text _)
          (ResultGenKey.Ok (spec-string-key text) next-fuel)]
        [(CompilerCtfeValue.I64 n)
          (ResultGenKey.Ok
            (str_cat.str-cat "i64:" (string.int->string n))
            next-fuel)]
        [_
          (ResultGenKey.Err
            (box
              (ctfe-diagnostic-at-expr
                expr
                "typecheck: Module macro identity key expression must evaluate to String or i64")))])]
    [(ResultCtfe.Err diag) (ResultGenKey.Err diag)]))

(define (macro-identity-key-string-exprs
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (macro-identity-key-string-exprs-at (& exprs) 0 env fuel))

(define (macro-identity-key-string-exprs-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (if (>= index (struct-get exprs len))
    (ResultGenKey.Ok "" fuel)
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-string-expr head-expr env fuel)
        [(ResultGenKey.Ok head-key head-fuel)
          (match (macro-identity-key-string-exprs-at
            exprs
            (+ index 1)
            env
            head-fuel)
            [(ResultGenKey.Ok tail tail-fuel)
              (ResultGenKey.Ok
                (macro-identity-key-join head-key tail)
                tail-fuel)]
            [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
        [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))

(define (macro-identity-key-sexpr [sexpr : reader.SpannedSexpr]) : String
  (match sexpr
    [(reader.SpannedSexpr.Int _ text _)
      (str_cat.str-cat "int:" (spec-string-key text))]
    [(reader.SpannedSexpr.Sym name _)
      (str_cat.str-cat
        "sym:"
        (spec-string-key (macro-output-symbol-text-id name "identity-key")))]
    [(reader.SpannedSexpr.Nil _) "nil"]
    [(reader.SpannedSexpr.Cons head tail _)
      (str_cat.str-cat
        "cons:"
        (spec-string-key (macro-identity-key-sexpr (reader.sp-node-get head)))
        ":"
        (spec-string-key (macro-identity-key-sexpr (reader.sp-node-get tail))))]
    [(reader.SpannedSexpr.Str string-id _)
      (str_cat.str-cat "str:" (spec-string-key (intern-str string-id)))]
    [(reader.SpannedSexpr.Char c _)
      (str_cat.str-cat "char:" (string.int->string (cast c : i64)))]
    [(reader.SpannedSexpr.Float text _)
      (str_cat.str-cat "float:" (spec-string-key text))]
    [(reader.SpannedSexpr.BracketList items _)
      (str_cat.str-cat
        "bracket:"
        (spec-string-key (macro-identity-key-sexpr (reader.sp-node-get items))))]))

(define (macro-identity-key-syntax-expr
  [expr : AstExpr]
  [origin : AstExpr]
  [fuel : i64]) : ResultGenKey
  (match (macro-expr-to-spanned-sexpr expr origin)
    [(ResultMacroSexpr.Ok sexpr)
      (ResultGenKey.Ok
        (str_cat.str-cat "syntax:" (macro-identity-key-sexpr sexpr))
        fuel)]
    [(ResultMacroSexpr.Err diag) (ResultGenKey.Err diag)]))

(define (macro-identity-syntax-param-type?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]) : bool
  (let
    [resolved : AstType
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        ty)]
    (or
      (tc-type-eq resolved (AstType.Expr))
      (tc-type-eq resolved (AstType.ExprList))
      (tc-macro-expr-clause-type? resolved)
      (tc-macro-expr-clause-list-type? resolved)
      (tc-macro-expr-binding-clause-type? resolved)
      (tc-macro-expr-binding-clause-list-type? resolved))))

(define (macro-identity-key-param-expr
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (if (macro-identity-syntax-param-type?
    ctx
    fallback-module
    fallback-module-id
    ty)
    (match (macro-identity-key-string-expr expr env fuel)
      [(ResultGenKey.Ok key next-fuel) (ResultGenKey.Ok key next-fuel)]
      [(ResultGenKey.Err _)
        (macro-identity-key-syntax-expr expr call-expr fuel)])
    (macro-identity-key-string-expr expr env fuel)))

(define (macro-identity-key-param-exprs
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (macro-identity-key-param-exprs-at
    ctx
    fallback-module
    fallback-module-id
    ty
    (& exprs)
    0
    env
    fuel
    call-expr))

(define (macro-identity-key-param-exprs-at
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (if (>= index (struct-get exprs len))
    (ResultGenKey.Ok "" fuel)
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-param-expr
        ctx
        fallback-module
        fallback-module-id
        ty
        head-expr
        env
        fuel
        call-expr)
        [(ResultGenKey.Ok head-key head-fuel)
          (match (macro-identity-key-param-exprs-at
            ctx
            fallback-module
            fallback-module-id
            ty
            exprs
            (+ index 1)
            env
            head-fuel
            call-expr)
            [(ResultGenKey.Ok tail tail-fuel)
              (ResultGenKey.Ok
                (macro-identity-key-join head-key tail)
                tail-fuel)]
            [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
        [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))

(define (macro-identity-key-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (macro-identity-key-params-at
    ctx
    decls
    fallback-module
    fallback-module-id
    macro-name
    (& params)
    (& args)
    0
    env
    fuel
    call-expr))

(define (macro-identity-key-fixed-param
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [param-name : i64]
  [ty : AstType]
  [type-kinds : AstMacroTypeKindList]
  [head-expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback
        ctx
        decls
        fallback-module
        fallback-module-id
        head-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (match (macro-validate-type-kind-constraint
            ctx
            macro-name
            param-name
            resolved-ty
            type-kinds
            head-expr)
            [(ResultMacroCheck.Ok)
              (ResultGenKey.Ok
                (str_cat.str-cat "type_" (ctfe-type-key resolved-ty))
                fuel)]
            [(ResultMacroCheck.Err diag) (ResultGenKey.Err diag)])]
        [(ResultMacroTypeArg.Err diag) (ResultGenKey.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        fallback-module-id
        head-expr)
        [(ResultMacroModuleArg.Ok module _)
          (ResultGenKey.Ok
            (str_cat.str-cat "module_" (spec-string-key module))
            fuel)]
        [(ResultMacroModuleArg.Err diag) (ResultGenKey.Err diag)])]
    [else
      (macro-identity-key-param-expr
        ctx
        fallback-module
        fallback-module-id
        ty
        head-expr
        env
        fuel
        call-expr)]))

(define (macro-identity-key-params-at
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (cond
    [(>= index (ast-macro-param-list-len params))
      (if (>= index (struct-get args len))
        (ResultGenKey.Ok "" fuel)
        (ResultGenKey.Err
          (box
            (ctfe-diagnostic-at-expr
              (ast-node-get (ast-expr-list-get args index 0))
              "macro call has too many arguments"))))]
    [else
      (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
        [(AstMacroParam.Param param-name ty variadic type-kinds)
          (if variadic
            (cond
              [(tc-macro-type-param-kind? ty)
                (ResultGenKey.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: type macro operand cannot be variadic")))]
              [(tc-macro-module-param-kind? ty)
                (ResultGenKey.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro operand cannot be variadic")))]
              [(macro-identity-syntax-param-type?
                  ctx
                  fallback-module
                  fallback-module-id
                  ty)
                (macro-identity-key-param-exprs-at
                  ctx
                  fallback-module
                  fallback-module-id
                  ty
                  args
                  index
                  env
                  fuel
                  call-expr)]
              [else (macro-identity-key-string-exprs-at args index env fuel)])
            (if (>= index (struct-get args len))
              (ResultGenKey.Err
                (box
                  (ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [head-expr : AstExpr
                  (ast-node-get (ast-expr-list-get args index 0))]
                (match (macro-identity-key-fixed-param
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  macro-name
                  param-name
                  ty
                  type-kinds
                  head-expr
                  env
                  fuel
                  call-expr)
                  [(ResultGenKey.Ok head-key head-fuel)
                    (match (macro-identity-key-params-at
                      ctx
                      decls
                      fallback-module
                      fallback-module-id
                      macro-name
                      params
                      args
                      (+ index 1)
                      env
                      head-fuel
                      call-expr)
                      [(ResultGenKey.Ok tail tail-fuel)
                        (ResultGenKey.Ok
                          (macro-identity-key-join head-key tail)
                          tail-fuel)]
                      [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
                  [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))])]))

(define (macro-module-identity
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [call-expr : AstExpr]) : ResultGenKey
  (match (macro-identity-key-params
    ctx
    decls
    fallback-module
    fallback-module-id
    macro-name
    params
    args
    env
    (ctfe-fuel-limit)
    call-expr)
    [(ResultGenKey.Ok arg-key fuel)
      (ResultGenKey.Ok
        (str_cat.str-cat definition-module ":" macro-name "(" arg-key ")")
        fuel)]
    [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))

(define (macro-decls-generated-key [identity : String]) : String
  (string.append "decls:" identity))

(define (macro-generated-meta
  [generator : String]
  [item : String]
  [key : String]) : AstGeneratedDeclMeta
  (AstGeneratedDeclMeta.Some generator item (ast-expr-list-new) key))

(define (macro-import-placeholder-kind? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportKind.Macro _ _) true]
    [(AstImportKind.MacroDecls _ _) true]
    [_ false]))

(define (macro-decl-import-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
      (macro-import-placeholder-kind? kind)]
    [_ false]))

(define (macro-decl-module-import-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [_ false])]
    [_ false]))

(define (macro-wrap-generated-decl
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match decl
    [(AstDecl.Module _) decl]
    [(AstDecl.Import decl-meta _)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator "import" key)
        decl)]
    [_
      (match (gen-decl-visible-name decl)
        [(SpecMaybeString.Some item)
          (ast-decl-comptime-decl-with-meta
            (macro-generated-meta generator item key)
            decl)]
        [(SpecMaybeString.None) decl])]))

(define (macro-wrap-generated-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-wrap-generated-decl decl generator key))
              (set! cursor rest))]))
      out)))

(define (macro-wrap-generated-decl-decls
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match (gen-decl-visible-name decl)
    [(SpecMaybeString.Some item)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator item key)
        decl)]
    [(SpecMaybeString.None) decl]))

(define (macro-wrap-generated-decls-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-wrap-generated-decl-decls decl generator key))
              (set! cursor rest))]))
      out)))

(define (macro-generated-context-import-kind
  [kind : AstImportKind]
  [definition-module : i64]) : AstImportKind
  (match kind
    [(AstImportKind.Macro call-id context)
      (match context
        [(AstMaybeModuleName.No)
          (AstImportKind.Macro
            call-id
            (AstMaybeModuleName.Some definition-module))]
        [_ kind])]
    [(AstImportKind.MacroDecls call-id context)
      (match context
        [(AstMaybeModuleName.No)
          (AstImportKind.MacroDecls
            call-id
            (AstMaybeModuleName.Some definition-module))]
        [_ kind])]
    [_ kind]))

(define (macro-generated-context-decl
  [decl : AstDecl]
  [definition-module : i64]) : AstDecl
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind path target alias span))
      (AstDecl.Import
        decl-meta
        (AstImportSpec.Spec
          (macro-generated-context-import-kind kind definition-module)
          path
          target
          alias
          span))]
    [(AstDecl.Unsafe inner-box)
      (ast-decl-unsafe
        (macro-generated-context-decl (box-get inner-box) definition-module))]
    [(AstDecl.ModuleBody name body-box)
      (ast-decl-module-body-id
        name
        (macro-generated-context-decls (box-get body-box) definition-module))]
    [_ decl]))

(define (macro-generated-context-decls
  [decls : AstDeclList]
  [definition-module : i64]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-generated-context-decl decl definition-module))
              (set! cursor rest))]))
      out)))

(define (macro-decl-generated-key? [decl : AstDecl] [key : String]) : bool
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some _ _ _ meta-key) (string.eq meta-key key)]
    [(AstGeneratedDeclMeta.No) false]))

(define (macro-decl-generated-import-placeholder?
  [decl : AstDecl]
  [key : String]) : bool
  (and
    (macro-decl-generated-key? decl key)
    (macro-decl-import-placeholder? decl)))

(define (macro-decl-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import decl-meta _) true]
    [(AstDecl.Unsafe inner-box) (macro-decl-import? (box-get inner-box))]
    [_ false]))

(define (macro-decls-contain-generated-key?
  [decls : AstDeclList]
  [key : String]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-generated-key? decl key)
        (macro-decls-contain-generated-key? rest key))]))

(define (macro-decls-filter-generated-key [decls : AstDeclList] [key : String]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (and
                (macro-decl-generated-key? decl key)
                (not (macro-decl-import? decl)))
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-decl-list-contains-structural?
  [decls : AstDeclList]
  [want : AstDecl]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (gen-decl-eq? decl want)
        (macro-decl-list-contains-structural? rest want))]))

(define (macro-decls-missing-generated-imports
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList generated-body]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (and
                (macro-decl-import? decl)
                (not (macro-decl-list-contains-structural? existing-body decl)))
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-decls-missing-generated-visible
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList generated-body]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match (macro-generated-visible-name decl)
                [(SpecMaybeString.Some name)
                  (match (macro-find-generated-visible-decl existing-body name)
                    [(MacroMaybeAstDecl.Some _) unit]
                    [(MacroMaybeAstDecl.No)
                      (set!
                        out-rev
                        (ast-decl-list-prepend-builder decl out-rev))])]
                [(SpecMaybeString.None) unit])
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-decls-missing-generated-body
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (macro-decl-list-append
    (macro-decls-missing-generated-imports generated-body existing-body)
    (macro-decls-missing-generated-visible generated-body existing-body)))

(define (macro-module-replay-marker-decls
  [target-module : String]
  [target-module-id : i64]
  [owner-module-id : i64]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (let
    [marker-decls : AstDeclList
      (macro-module-import-marker-decls
        target-module
        target-module-id
        alias
        span)]
    [missing-body : AstDeclList
      (macro-decls-missing-generated-body generated-body existing-body)]
    (match (ast-decl-list-step missing-body)
      [(AstDeclListStep.Nil) marker-decls]
      [_
        (macro-decl-list-append
          (ast-decl-list-prepend-builder
            (ast-decl-module-id target-module-id)
            missing-body)
          (ast-decl-list-prepend-builder
            (ast-decl-module-id owner-module-id)
            marker-decls))])))

(define (macro-find-generated-identity-module-in
  [decls : AstDeclList]
  [identity : String]
  [module-id : i64]) : TcMaybeNameId
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (TcMaybeNameId.No)]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [(AstDecl.Module next-module)
          (macro-find-generated-identity-module-in
            rest-box
            identity
            next-module)]
        [_
          (if (and
            (not (= module-id cbi.compiler-builtin-id-fix-empty))
            (macro-decl-generated-key? decl identity))
            (TcMaybeNameId.Some module-id)
            (macro-find-generated-identity-module-in
              rest-box
              identity
              module-id))])]))

(define (macro-find-generated-identity-module
  [decls : AstDeclList]
  [identity : String]) : TcMaybeNameId
  (macro-find-generated-identity-module-in
    decls
    identity
    cbi.compiler-builtin-id-fix-empty))

(defenum MacroMaybeAstDecl
  (No)
  (Some AstDecl))

(defenum MacroGeneratedTargetReplayScan
  (NoRelevant)
  (AllMatched)
  (MissingOnly)
  (Incompatible))

(defenum MacroGeneratedTargetReplay
  (NoReplay)
  (ReplayCompatible)
  (ReplayAppendMissing)
  (ReplayIncompatible))

;; Content-addressed module memo (plan P1). Program-global, spanning every file
;; and module: a generated module is expanded + materialized exactly once per
;; (generator-id, canonical-type-args) — the `identity` string produced by
;; macro-module-identity, whose type-args are already canonicalized via type-key.
;; The key maps to the single canonical target module name; every later import of
;; the same identity (in any file, in any pass) resolves to that module and emits
;; only an alias/marker import. The memo persists across the whole expansion run
;; (it is only reset at the per-program macro-expand entry and self-clears when the
;; intern generation changes), which is what makes the identity shortcut
;; authoritative. This replaces the replay-compare/fingerprint
;; machinery: a memoized module is never re-expanded, so there is nothing to
;; compare.
(define macro-generated-module-memo-capacity : i64
  4096)
(define macro-generated-module-memo-keys : (Array i64)
  (array.make-array i64 4096))

(defenum MacroGeneratedCatalogClosure
  (Full))

;; First-class immutable catalog owner. `catalog` is the complete wrapped body
;; without its module header; `summary` is the currently materialized surface.
;; The explicit closure field is the handoff point for #4831's later subset.
(defenum MacroGeneratedModuleCatalogEntry
  (Empty)
  (Catalog
    i64
    AstDeclList
    String
    String
    AstDeclList
    MacroGeneratedCatalogClosure))

(define macro-generated-module-memo-catalog-entries : (Array
    MacroGeneratedModuleCatalogEntry)
  (array.make-array MacroGeneratedModuleCatalogEntry 4096))
(define macro-generated-module-memo-count : i64
  0)
(define macro-generated-module-memo-generation : i64
  -1)
(define macro-generated-module-memo-ready : bool
  false)

(define (macro-generated-module-memo-reset!) : unit
  (set! macro-generated-module-memo-ready false))

(define (macro-generated-module-memo-ensure!) : unit
  (if (if macro-generated-module-memo-ready
    (= macro-generated-module-memo-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-generated-module-memo-capacity)
          (begin
            (array-set! macro-generated-module-memo-keys i 0)
            (array-set!
              macro-generated-module-memo-catalog-entries
              i
              (MacroGeneratedModuleCatalogEntry.Empty))
            (set! i (+ i 1))))
        (set! macro-generated-module-memo-count 0)
        (set! macro-generated-module-memo-generation (intern-generation))
        (set! macro-generated-module-memo-ready true)))))

(define (macro-generated-module-memo-bucket [identity-id : i64]) : i64
  (bit-and
    (* identity-id 2654435761)
    (- macro-generated-module-memo-capacity 1)))

(define (macro-generated-identity-id [identity : String]) : i64
  (tc-generated-module-name-id identity))

;; Store the first canonical catalog for an identity. Re-storing an equal
;; identity preserves its immutable catalog, provenance, validation, and closure
;; state while refreshing only the current materialized summary. The shortcut
;; normally makes the insertion path run once per identity for the whole program.
(define (macro-generated-module-memo-put!
  [identity : String]
  [target-id : i64]
  [summary : AstDeclList]
  [catalog : AstDeclList]
  [generator : String]
  [import-path : String]) : unit
  (let
    [identity-id : i64 (macro-generated-identity-id identity)]
    (begin
      (macro-generated-module-memo-ensure!)
      (if (>=
        (* macro-generated-module-memo-count 2)
        macro-generated-module-memo-capacity)
        unit
        (let
          [cursor : i64 (macro-generated-module-memo-bucket identity-id)]
          [key : i64 (+ identity-id 1)]
          [steps : i64 0]
          [done : bool false]
          (begin
            (while (if done
              false
              (< steps macro-generated-module-memo-capacity))
              (let
                [slot : i64 (array-ref macro-generated-module-memo-keys cursor)]
                (if (= slot 0)
                  (begin
                    (array-set! macro-generated-module-memo-keys cursor key)
                    (array-set!
                      macro-generated-module-memo-catalog-entries
                      cursor
                      (MacroGeneratedModuleCatalogEntry.Catalog
                        target-id
                        catalog
                        generator
                        import-path
                        summary
                        (MacroGeneratedCatalogClosure.Full)))
                    (set!
                      macro-generated-module-memo-count
                      (+ macro-generated-module-memo-count 1))
                    (set! done true))
                  (if (= slot key)
                    (begin
                      ;; A same-identity catalog is immutable. Syntax-sensitive
                      ;; calls bypass the shortcut and retain the existing
                      ;; incompatible-output diagnostic instead of replacing it.
                      (match (array-ref
                        macro-generated-module-memo-catalog-entries
                        cursor)
                        [(MacroGeneratedModuleCatalogEntry.Catalog
                            entry-target
                            entry-catalog
                            entry-generator
                            entry-path
                            _
                            closure)
                          (array-set!
                            macro-generated-module-memo-catalog-entries
                            cursor
                            (MacroGeneratedModuleCatalogEntry.Catalog
                              entry-target
                              entry-catalog
                              entry-generator
                              entry-path
                              summary
                              closure))]
                        [(MacroGeneratedModuleCatalogEntry.Empty) unit])
                      (set! done true))
                    (begin
                      (set!
                        cursor
                        (bit-and
                          (+ cursor 1)
                          (- macro-generated-module-memo-capacity 1)))
                      (set! steps (+ steps 1)))))))
            unit))))))

;; Retrieve the export-summary (materialized module decl list) recorded for an
;; identity, or the empty list when the identity is not (yet) memoized. Used by
;; env-extend-with-module to fold an already-materialized module into the live
;; top-env without a whole-program rebuild (plan P2).
(define (macro-generated-module-memo-get-summary [identity : String]) : AstDeclList
  (let
    [identity-id : i64 (macro-generated-identity-id identity)]
    (begin
      (macro-generated-module-memo-ensure!)
      (let
        [cursor : i64 (macro-generated-module-memo-bucket identity-id)]
        [key : i64 (+ identity-id 1)]
        [steps : i64 0]
        [out : AstDeclList (ast-decl-list-new)]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps macro-generated-module-memo-capacity))
            (let
              [slot : i64 (array-ref macro-generated-module-memo-keys cursor)]
              (if (= slot 0)
                (set! done true)
                (if (= slot key)
                  (begin
                    (match (array-ref
                      macro-generated-module-memo-catalog-entries
                      cursor)
                      [(MacroGeneratedModuleCatalogEntry.Catalog
                          _
                          _
                          _
                          _
                          summary
                          _)
                        (set! out summary)]
                      [(MacroGeneratedModuleCatalogEntry.Empty) unit])
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and
                        (+ cursor 1)
                        (- macro-generated-module-memo-capacity 1)))
                    (set! steps (+ steps 1)))))))
          out)))))

;; Retrieve the immutable full catalog for a canonical identity. It is separate
;; from the materialized summary so later demand selection can reuse parsed
;; declarations without re-running CTFE or reconstructing them from a program.
(define (macro-generated-module-memo-get-catalog [identity : String]) : MacroGeneratedModuleCatalogEntry
  (let
    [identity-id : i64 (macro-generated-identity-id identity)]
    (begin
      (macro-generated-module-memo-ensure!)
      (let
        [cursor : i64 (macro-generated-module-memo-bucket identity-id)]
        [key : i64 (+ identity-id 1)]
        [steps : i64 0]
        [out : MacroGeneratedModuleCatalogEntry
          (MacroGeneratedModuleCatalogEntry.Empty)]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps macro-generated-module-memo-capacity))
            (let
              [slot : i64 (array-ref macro-generated-module-memo-keys cursor)]
              (if (= slot 0)
                (set! done true)
                (if (= slot key)
                  (begin
                    (set!
                      out
                      (array-ref
                        macro-generated-module-memo-catalog-entries
                        cursor))
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and
                        (+ cursor 1)
                        (- macro-generated-module-memo-capacity 1)))
                    (set! steps (+ steps 1)))))))
          out)))))

(defenum MacroMaybeSpliceDecls
  (No)
  (Some AstDeclList))

;; Decls-macro splice memo. A Decls-position macro call splices its generated
;; declarations inline, and the demand-driven walk rebuilds the whole-program
;; symbols right after every splice -- so a second call with the same generated
;; identity would put two copies of every generated item in front of the
;; symbols builder before gen-normalize's registry dedup ever runs (the retired
;; fixed-point loop normalized between passes, so its symbols never saw the
;; transient duplicate). Memoize the first expansion per identity: a repeat
;; splice with a structurally identical payload contributes nothing (and skips
;; the context rebuild entirely); an incompatible payload errors exactly like
;; gen-register-generated-decl. Same lifecycle as the module memo: reset per
;; program, self-clears on intern-generation change.
(define macro-generated-decls-memo-capacity : i64
  1024)
(define macro-generated-decls-memo-keys : (Array i64)
  (array.make-array i64 1024))
(define macro-generated-decls-memo-decls : (Array AstDeclList)
  (array.make-array AstDeclList 1024))
(define macro-generated-decls-memo-count : i64
  0)
(define macro-generated-decls-memo-generation : i64
  -1)
(define macro-generated-decls-memo-ready : bool
  false)

(define (macro-generated-decls-memo-reset!) : unit
  (set! macro-generated-decls-memo-ready false))

(define (macro-generated-decls-memo-ensure!) : unit
  (if (if macro-generated-decls-memo-ready
    (= macro-generated-decls-memo-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-generated-decls-memo-capacity)
          (begin
            (array-set! macro-generated-decls-memo-keys i 0)
            (array-set! macro-generated-decls-memo-decls i (ast-decl-list-new))
            (set! i (+ i 1))))
        (set! macro-generated-decls-memo-count 0)
        (set! macro-generated-decls-memo-generation (intern-generation))
        (set! macro-generated-decls-memo-ready true)))))

(define (macro-generated-decls-memo-bucket [identity-id : i64]) : i64
  (bit-and (* identity-id 2654435761) (- macro-generated-decls-memo-capacity 1)))

(define (macro-generated-decls-memo-get [identity : String]) : MacroMaybeSpliceDecls
  (let
    [identity-id : i64 (macro-generated-identity-id identity)]
    (begin
      (macro-generated-decls-memo-ensure!)
      (let
        [cursor : i64 (macro-generated-decls-memo-bucket identity-id)]
        [key : i64 (+ identity-id 1)]
        [steps : i64 0]
        [out : MacroMaybeSpliceDecls (MacroMaybeSpliceDecls.No)]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps macro-generated-decls-memo-capacity))
            (let
              [slot : i64 (array-ref macro-generated-decls-memo-keys cursor)]
              (if (= slot 0)
                (set! done true)
                (if (= slot key)
                  (begin
                    (set!
                      out
                      (MacroMaybeSpliceDecls.Some
                        (array-ref macro-generated-decls-memo-decls cursor)))
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and
                        (+ cursor 1)
                        (- macro-generated-decls-memo-capacity 1)))
                    (set! steps (+ steps 1)))))))
          out)))))

(define (macro-generated-decls-memo-put!
  [identity : String]
  [decls : AstDeclList]) : unit
  (let
    [identity-id : i64 (macro-generated-identity-id identity)]
    (begin
      (macro-generated-decls-memo-ensure!)
      (if (>=
        (* macro-generated-decls-memo-count 2)
        macro-generated-decls-memo-capacity)
        unit
        (let
          [cursor : i64 (macro-generated-decls-memo-bucket identity-id)]
          [key : i64 (+ identity-id 1)]
          [steps : i64 0]
          [done : bool false]
          (begin
            (while (if done
              false
              (< steps macro-generated-decls-memo-capacity))
              (let
                [slot : i64 (array-ref macro-generated-decls-memo-keys cursor)]
                (if (= slot 0)
                  (begin
                    (array-set! macro-generated-decls-memo-keys cursor key)
                    (array-set! macro-generated-decls-memo-decls cursor decls)
                    (set!
                      macro-generated-decls-memo-count
                      (+ macro-generated-decls-memo-count 1))
                    (set! done true))
                  (if (= slot key)
                    (begin
                      (array-set! macro-generated-decls-memo-decls cursor decls)
                      (set! done true))
                    (begin
                      (set!
                        cursor
                        (bit-and
                          (+ cursor 1)
                          (- macro-generated-decls-memo-capacity 1)))
                      (set! steps (+ steps 1)))))))
            unit))))))

;; Structural equality between two Decls-macro splices, mirroring the
;; per-declaration gen-decl-eq? comparison gen-register-generated-decl applies
;; in gen-normalize: unwrap the generated-meta wrappers and compare templates.
(define (macro-generated-decls-splice-template [decl : AstDecl]) : AstDecl
  decl)

(define (macro-generated-decls-splice-equal?
  [a : AstDeclList]
  [b : AstDeclList]) : bool
  (if (not (= (ast-decl-list-len (& a)) (ast-decl-list-len (& b))))
    false
    (let
      [cursor-a : AstDeclList a]
      [cursor-b : AstDeclList b]
      [equal : bool true]
      [done : bool false]
      (begin
        (while (not done)
          (match (ast-decl-list-step cursor-a)
            [(AstDeclListStep.Nil) (set! done true)]
            [(AstDeclListStep.Cons decl-a rest-a)
              (match (ast-decl-list-step cursor-b)
                [(AstDeclListStep.Nil)
                  (begin
                    (set! equal false)
                    (set! done true))]
                [(AstDeclListStep.Cons decl-b rest-b)
                  (if (gen-decl-eq?
                    (macro-generated-decls-splice-template decl-a)
                    (macro-generated-decls-splice-template decl-b))
                    (begin
                      (set! cursor-a rest-a)
                      (set! cursor-b rest-b))
                    (begin
                      (set! equal false)
                      (set! done true)))])]))
        equal))))

(define (macro-generated-decls-splice-first-item [decls : AstDeclList]) : String
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) ""]
    [(AstDeclListStep.Cons decl _)
      (match (gen-decl-visible-name
        (macro-generated-decls-splice-template decl))
        [(SpecMaybeString.Some item) item]
        [(SpecMaybeString.None) ""])]))

;; Resolve a Decls-macro splice against the memo: first expansion is recorded
;; and spliced; a structurally identical repeat contributes an empty splice; an
;; incompatible repeat errors with the same diagnostic gen-normalize's registry
;; would produce.
(define (macro-decls-splice-with-memo
  [identity : String]
  [wrapped : AstDeclList]
  [decl-path : String]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (match (macro-generated-decls-memo-get identity)
    [(MacroMaybeSpliceDecls.No)
      (begin
        (macro-generated-decls-memo-put! identity wrapped)
        (ResultMacroDeclExpansion.Ok
          wrapped
          (macro-paths-for-decls wrapped decl-path)))]
    [(MacroMaybeSpliceDecls.Some existing)
      (if (macro-generated-decls-splice-equal? existing wrapped)
        (ResultMacroDeclExpansion.Ok
          (ast-decl-list-new)
          (ast-decl-path-list-new))
        (ResultMacroDeclExpansion.Err
          (let
            [diag : CompilerDiagnostic
              (gen-incompatible-diag
                (macro-generated-decls-splice-first-item wrapped)
                (macro-decls-generated-key identity))]
            [located : CompilerDiagnostic
              (tc-expr-diag call-expr (compiler-diagnostic-message diag))]
            (box
              (compiler-diagnostic-with-primary-span
                diag
                (compiler-diagnostic-primary-span located))))))]))

(define (macro-decl-generated? [decl : AstDecl]) : bool
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some _ _ _ _) true]
    [(AstGeneratedDeclMeta.No) false]))

(define (macro-generated-visible-name [decl : AstDecl]) : SpecMaybeString
  (if (and (macro-decl-generated? decl) (not (macro-decl-import? decl)))
    (gen-decl-visible-name decl)
    (SpecMaybeString.None)))

(define (macro-find-generated-visible-decl
  [decls : AstDeclList]
  [name : String]) : MacroMaybeAstDecl
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (MacroMaybeAstDecl.No)]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-generated-visible-name decl)
        [(SpecMaybeString.Some candidate)
          (if (string.eq candidate name)
            (MacroMaybeAstDecl.Some decl)
            (macro-find-generated-visible-decl rest-box name))]
        [(SpecMaybeString.None)
          (macro-find-generated-visible-decl rest-box name)])]))

(define (macro-generated-target-replay-scan-step
  [state : MacroGeneratedTargetReplayScan]
  [matched? : bool]
  [same? : bool]) : MacroGeneratedTargetReplayScan
  (if matched?
    (if same?
      (match state
        [(MacroGeneratedTargetReplayScan.NoRelevant)
          (MacroGeneratedTargetReplayScan.AllMatched)]
        [(MacroGeneratedTargetReplayScan.AllMatched)
          (MacroGeneratedTargetReplayScan.AllMatched)]
        [(MacroGeneratedTargetReplayScan.MissingOnly)
          (MacroGeneratedTargetReplayScan.Incompatible)]
        [(MacroGeneratedTargetReplayScan.Incompatible)
          (MacroGeneratedTargetReplayScan.Incompatible)])
      (MacroGeneratedTargetReplayScan.Incompatible))
    (match state
      [(MacroGeneratedTargetReplayScan.NoRelevant)
        (MacroGeneratedTargetReplayScan.MissingOnly)]
      [(MacroGeneratedTargetReplayScan.AllMatched)
        (MacroGeneratedTargetReplayScan.MissingOnly)]
      [(MacroGeneratedTargetReplayScan.MissingOnly)
        (MacroGeneratedTargetReplayScan.MissingOnly)]
      [(MacroGeneratedTargetReplayScan.Incompatible)
        (MacroGeneratedTargetReplayScan.Incompatible)])))

(define (macro-generated-target-replay-scan-in
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]
  [state : MacroGeneratedTargetReplayScan]) : MacroGeneratedTargetReplayScan
  (match (ast-decl-list-step generated-body)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-generated-visible-name decl)
        [(SpecMaybeString.Some name)
          (match (macro-find-generated-visible-decl existing-body name)
            [(MacroMaybeAstDecl.Some existing-decl)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step
                  state
                  true
                  (gen-decl-eq? existing-decl decl)))]
            [(MacroMaybeAstDecl.No)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step state false false))])]
        [(SpecMaybeString.None)
          (macro-generated-target-replay-scan-in existing-body rest-box state)])]))

(define (macro-generated-target-replay
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : MacroGeneratedTargetReplay
  (match (macro-generated-target-replay-scan-in
    existing-body
    generated-body
    (MacroGeneratedTargetReplayScan.NoRelevant))
    [(MacroGeneratedTargetReplayScan.AllMatched)
      (MacroGeneratedTargetReplay.ReplayCompatible)]
    [(MacroGeneratedTargetReplayScan.MissingOnly)
      (MacroGeneratedTargetReplay.ReplayAppendMissing)]
    [(MacroGeneratedTargetReplayScan.Incompatible)
      (MacroGeneratedTargetReplay.ReplayIncompatible)]
    [_ (MacroGeneratedTargetReplay.NoReplay)]))

(define (macro-module-exists? [decls : AstDeclList] [target-module : String]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module module-name)
          (if (string.eq (intern-str module-name) target-module)
            true
            (macro-module-exists? rest target-module))]
        [_ (macro-module-exists? rest target-module)])]))

(define (macro-collect-module-body-decls
  [decls : AstDeclList]
  [target-module : String]
  [current-module : String]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [module : String current-module]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module module-name)
                  (set! module (intern-str module-name))]
                [_
                  (if (string.eq module target-module)
                    (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                    unit)])
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-find-module-body-decls
  [decls : AstDeclList]
  [target-module : String]) : MacroMaybeDeclList
  (if (macro-module-exists? decls target-module)
    (MacroMaybeDeclList.Some
      (macro-collect-module-body-decls decls target-module ""))
    (MacroMaybeDeclList.No)))

(define (macro-generated-identity-shortcut-safe-params?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]
  [args : AstExprList]) : bool
  (macro-generated-identity-shortcut-safe-params-at?
    ctx
    definition-module
    definition-module-id
    (& params)
    (& args)
    0))

(define (macro-generated-identity-shortcut-safe-params-at?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]) : bool
  (if (>= index (ast-macro-param-list-len params))
    true
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty variadic _)
        (and
          (if (macro-identity-syntax-param-type?
            ctx
            definition-module
            definition-module-id
            ty)
            ;; A syntax parameter can choose output by syntax even when its
            ;; value-derived identity key collides, so it normally disables
            ;; the authoritative memo shortcut. An empty trailing variadic
            ;; syntax parameter has no operand syntax to distinguish and is
            ;; therefore safe; this preserves the identity of legacy calls
            ;; when a generator adds an optional syntax capability tail.
            (and variadic (>= index (struct-get args len)))
            true)
          (macro-generated-identity-shortcut-safe-params-at?
            ctx
            definition-module
            definition-module-id
            params
            args
            (+ index 1)))])))

(define (macro-spanned-symbol-id [name-id : i64] [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.SpannedSexpr.Sym name-id span))

(define (macro-expr-list-with-head-symbol-id
  [name-id : i64]
  [exprs : AstExprList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-expr-list-to-spanned-sexpr exprs span origin)
    [(ResultMacroSexpr.Ok tail)
      (ResultMacroSexpr.Ok
        (reader.spanned-sexpr-cons
          (macro-spanned-symbol-id name-id span)
          tail
          span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

;; Serialize a child expression node (referenced by node-pool id) back to a
;; spanned sexpr. Used by the declaration-emitting macro output serializer to
;; rebuild non-trivial function bodies (arithmetic, struct/array access, let,
;; while, set!, ...) that the quasiquote evaluator stores as typed AST nodes.
(define (macro-child-to-spanned-sexpr
  [id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span (ast-node-get id) span origin))

(define (macro-form1-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-cons
    (macro-spanned-symbol-id name-id span)
    (reader.spanned-sexpr-cons a (reader.SpannedSexpr.Nil span) span)
    span))

(define (macro-form0-id [name-id : i64] [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-cons
    (macro-spanned-symbol-id name-id span)
    (reader.SpannedSexpr.Nil span)
    span))

(define (macro-form2-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [b : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-cons
    (macro-spanned-symbol-id name-id span)
    (reader.spanned-sexpr-cons
      a
      (reader.spanned-sexpr-cons b (reader.SpannedSexpr.Nil span) span)
      span)
    span))

(define (macro-form3-id
  [name-id : i64]
  [a : reader.SpannedSexpr]
  [b : reader.SpannedSexpr]
  [c : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-cons
    (macro-spanned-symbol-id name-id span)
    (reader.spanned-sexpr-cons
      a
      (reader.spanned-sexpr-cons
        b
        (reader.spanned-sexpr-cons c (reader.SpannedSexpr.Nil span) span)
        span)
      span)
    span))

(define (macro-binop-symbol-id [op : AstBinOp]) : i64
  (match op
    [(AstBinOp.Add) (cbi.compiler-builtin-ctfe-ref 137)]
    [(AstBinOp.Sub) (cbi.compiler-builtin-ctfe-ref 138)]
    [(AstBinOp.Mul) (cbi.compiler-builtin-ctfe-ref 139)]
    [(AstBinOp.Div) (cbi.compiler-builtin-ctfe-ref 140)]
    [(AstBinOp.Mod) (cbi.compiler-builtin-ctfe-ref 141)]
    [(AstBinOp.Eq) (cbi.compiler-builtin-ctfe-ref 142)]
    [(AstBinOp.Ne) (cbi.compiler-builtin-ctfe-ref 143)]
    [(AstBinOp.Lt) (cbi.compiler-builtin-ctfe-ref 144)]
    [(AstBinOp.Le) (cbi.compiler-builtin-ctfe-ref 145)]
    [(AstBinOp.Gt) (cbi.compiler-builtin-ctfe-ref 146)]
    [(AstBinOp.Ge) (cbi.compiler-builtin-ctfe-ref 147)]
    [(AstBinOp.And) (cbi.compiler-builtin-ctfe-ref 148)]
    [(AstBinOp.Or) (cbi.compiler-builtin-ctfe-ref 149)]
    [(AstBinOp.BitAnd) (cbi.compiler-builtin-ctfe-ref 150)]
    [(AstBinOp.BitOr) (cbi.compiler-builtin-ctfe-ref 151)]
    [(AstBinOp.BitXor) (cbi.compiler-builtin-ctfe-ref 152)]
    [(AstBinOp.Shl) (cbi.compiler-builtin-ctfe-ref 153)]
    [(AstBinOp.Shr) (cbi.compiler-builtin-ctfe-ref 154)]))

(define (macro-unop-symbol-id [op : AstUnOp]) : i64
  (match op
    [(AstUnOp.Neg) (cbi.compiler-builtin-ctfe-ref 138)]
    [(AstUnOp.Not) (cbi.compiler-builtin-ctfe-ref 155)]
    [(AstUnOp.BitNot) (cbi.compiler-builtin-ctfe-ref 156)]))

(define (macro-lifetime-list-to-spanned-sexpr
  [items : AstLifetimeList]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (macro-lifetime-list-to-spanned-sexpr-at (& items) span 0))

(define (macro-lifetime-list-to-spanned-sexpr-at
  [items : (& items AstLifetimeList)]
  [span : token.SourceSpan]
  [index : i64]) : reader.SpannedSexpr
  (if (>= index (ast-lifetime-list-len items))
    (reader.SpannedSexpr.Nil span)
    (reader.spanned-sexpr-cons
      (macro-spanned-symbol-id
        (ast-lifetime-list-get items index (ast-lifetime-fallback))
        span)
      (macro-lifetime-list-to-spanned-sexpr-at items span (+ index 1))
      span)))

(define (macro-internal-resolved-struct-type-marker) : String
  "__typelisp internal resolved struct type")

(define (macro-internal-resolved-enum-type-marker) : String
  "__typelisp internal resolved enum type")

(define (macro-resolved-nominal-type-sexpr
  [marker-id : i64]
  [name-id : i64]
  [lifetimes : AstLifetimeList]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (reader.spanned-sexpr-cons
    (macro-spanned-symbol-id marker-id span)
    (reader.spanned-sexpr-cons
      (macro-spanned-symbol-id name-id span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)
    span))

(define (macro-type-list-to-spanned-sexpr
  [items : AstTypeList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-type-list-to-spanned-sexpr-at (& items) span origin 0))

(define (macro-type-list-to-spanned-sexpr-at
  [items : (& items AstTypeList)]
  [span : token.SourceSpan]
  [origin : AstExpr]
  [index : i64]) : ResultMacroSexpr
  (if (>= index (ast-type-list-len items))
    (ResultMacroSexpr.Ok (reader.SpannedSexpr.Nil span))
    (match (macro-type-to-spanned-sexpr
      (ty-node-get (ast-type-list-get items index (ast-type-id-fallback)))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-type-list-to-spanned-sexpr-at
          items
          span
          origin
          (+ index 1))
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (reader.spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-type-unary-sexpr-id
  [name-id : i64]
  [inner-id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-type-to-spanned-sexpr (ty-node-get inner-id) span origin)
    [(ResultMacroSexpr.Ok sinner)
      (ResultMacroSexpr.Ok (macro-form1-id name-id sinner span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-type-named-args-sexpr
  [name-id : i64]
  [lifetimes : AstLifetimeList]
  [span : token.SourceSpan]) : ResultMacroSexpr
  (ResultMacroSexpr.Ok
    (reader.spanned-sexpr-cons
      (macro-spanned-symbol-id name-id span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)))

(define (macro-output-origin-arg-name [expr : AstExpr]) : String
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id)
      (if (and (>= name-id 0) (< name-id (intern-capacity)))
        (intern-str name-id)
        (string.append "<var:" (string.append (string.int->string name-id) ">")))]
    [(AstExpr.TypeLiteral ty)
      (match ty
        [(AstType.Var name-id)
          (if (and (>= name-id 0) (< name-id (intern-capacity)))
            (intern-str name-id)
            (string.append
              "<type-var:"
              (string.append (string.int->string name-id) ">")))]
        [_ (tc-type-render ty)])]
    [_ "<expression>"]))

(define (macro-output-origin-name [origin : AstExpr]) : String
  (match (ast-expr-unspan origin)
    [(AstExpr.Call func-box args)
      (let
        [func-name : String
          (match (ast-expr-unspan (ast-node-get func-box))
            [(AstExpr.Var name-id)
              (if (and (>= name-id 0) (< name-id (intern-capacity)))
                (intern-str name-id)
                "<invalid-call-name>")]
            [_ "<indirect-call>"])]
        [arg-name : String
          (if (> (ast-expr-list-len (& args)) 0)
            (macro-output-origin-arg-name
              (ast-node-get (ast-expr-list-get (& args) 0 0)))
            "<no-args>")]
        (string.append
          func-name
          (string.append "(" (string.append arg-name ")"))))]
    [(AstExpr.Var name-id)
      (if (and (>= name-id 0) (< name-id (intern-capacity)))
        (intern-str name-id)
        "<invalid-var>")]
    [_ "<non-call-expression>"]))

;; Serialize an AstType back to a spanned sexpr so type positions embedded in
;; expression nodes (array.make-array, cast, ann, typed let bindings) round-trip.
(define (macro-type-to-spanned-sexpr
  [ty : AstType]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match ty
    [(AstType.I64)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 159) span))]
    [(AstType.I32)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 160) span))]
    [(AstType.I16)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 161) span))]
    [(AstType.I8)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 162) span))]
    [(AstType.U64)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 163) span))]
    [(AstType.U32)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 164) span))]
    [(AstType.U16)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 165) span))]
    [(AstType.U8)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 166) span))]
    [(AstType.F64)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 167) span))]
    [(AstType.F32)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 168) span))]
    [(AstType.Bool)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 169) span))]
    [(AstType.Char)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 170) span))]
    [(AstType.String)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 158) span))]
    [(AstType.Str)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 171) span))]
    [(AstType.Bytes)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 172) span))]
    [(AstType.Unit)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 173) span))]
    [(AstType.Never)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 174) span))]
    [(AstType.Expr)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id cbi.compiler-builtin-id-fix-Expr span))]
    [(AstType.ExprList)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id cbi.compiler-builtin-id-fix-ExprList span))]
    [(AstType.DynArray elem)
      (macro-type-unary-sexpr-id
        (cbi.compiler-builtin-ctfe-ref 109)
        elem
        span
        origin)]
    [(AstType.Array elem count)
      (match (macro-type-to-spanned-sexpr (ty-node-get elem) span origin)
        [(ResultMacroSexpr.Ok selem)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 109)
              selem
              (reader.SpannedSexpr.Int count (string.int->string count) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Box inner)
      (macro-type-unary-sexpr-id
        cbi.compiler-builtin-id-fix-Box
        inner
        span
        origin)]
    [(AstType.Ptr inner)
      (macro-type-unary-sexpr-id
        (cbi.compiler-builtin-ctfe-ref 177)
        inner
        span
        origin)]
    [(AstType.MutPtr inner)
      (macro-type-unary-sexpr-id
        (cbi.compiler-builtin-ctfe-ref 178)
        inner
        span
        origin)]
    [(AstType.Tuple items)
      (match (macro-type-list-to-spanned-sexpr (box-get items) span origin)
        [(ResultMacroSexpr.Ok stail)
          (ResultMacroSexpr.Ok
            (reader.spanned-sexpr-cons
              (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 175) span)
              stail
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Func args ret)
      (match (macro-type-list-to-spanned-sexpr (box-get args) span origin)
        [(ResultMacroSexpr.Ok sargs)
          (match (macro-type-to-spanned-sexpr (ty-node-get ret) span origin)
            [(ResultMacroSexpr.Ok sret)
              (ResultMacroSexpr.Ok
                (reader.spanned-sexpr-cons
                  (macro-spanned-symbol-id
                    (cbi.compiler-builtin-ctfe-ref 176)
                    span)
                  (macro-spanned-sexpr-append
                    sargs
                    (reader.spanned-sexpr-cons
                      sret
                      (reader.SpannedSexpr.Nil span)
                      span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Struct name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe-ref 106)
          name
          (ast-lifetime-list-new)
          span))]
    [(AstType.Enum name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe-ref 107)
          name
          (ast-lifetime-list-new)
          span))]
    [(AstType.Var name)
      (if (< name 0)
        (io.panic
          (string.append
            "macro output received invalid type-var id in origin "
            (macro-output-origin-name origin)))
        (ResultMacroSexpr.Ok
          (macro-spanned-symbol-id
            (macro-output-source-identity-id-at name "type-var")
            span)))]
    [(AstType.StructArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe-ref 106)
          name
          (box-get lifetimes)
          span))]
    [(AstType.EnumArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (cbi.compiler-builtin-ctfe-ref 107)
          name
          (box-get lifetimes)
          span))]
    [(AstType.VarArgs name lifetimes)
      (macro-type-named-args-sexpr
        (macro-output-source-identity-id-at name "type-var-args")
        (box-get lifetimes)
        span)]
    [(AstType.Ref region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= region cbi.compiler-builtin-id-fix-empty)
              (macro-form1-id (cbi.compiler-builtin-ctfe-ref 110) sinner span)
              (macro-form2-id
                (cbi.compiler-builtin-ctfe-ref 110)
                (macro-spanned-symbol-id region span)
                sinner
                span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.MutRef region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= region cbi.compiler-builtin-id-fix-empty)
              (macro-form1-id (cbi.compiler-builtin-ctfe-ref 111) sinner span)
              (macro-form2-id
                (cbi.compiler-builtin-ctfe-ref 111)
                (macro-spanned-symbol-id region span)
                sinner
                span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Region region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 112)
              (macro-spanned-symbol-id region span)
              sinner
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Consume inner)
      (macro-type-unary-sexpr-id
        (cbi.compiler-builtin-ctfe-ref 179)
        inner
        span
        origin)]))

(define (macro-child-form1-id
  [name-id : i64]
  [id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr id span origin)
    [(ResultMacroSexpr.Ok sexpr)
      (ResultMacroSexpr.Ok (macro-form1-id name-id sexpr span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-child-form2-id
  [name-id : i64]
  [left-id : i64]
  [right-id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr left-id span origin)
    [(ResultMacroSexpr.Ok sleft)
      (match (macro-child-to-spanned-sexpr right-id span origin)
        [(ResultMacroSexpr.Ok sright)
          (ResultMacroSexpr.Ok (macro-form2-id name-id sleft sright span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-child-type-form3-id
  [name-id : i64]
  [expr-id : i64]
  [ty : AstType]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr expr-id span origin)
    [(ResultMacroSexpr.Ok sexpr)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok
            (macro-form3-id
              name-id
              sexpr
              (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 120) span)
              sty
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-spanned-sexpr-append
  [left : reader.SpannedSexpr]
  [right : reader.SpannedSexpr]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (match left
    [(reader.SpannedSexpr.Cons head tail _)
      (reader.spanned-sexpr-cons
        (reader.sp-node-get head)
        (macro-spanned-sexpr-append (reader.sp-node-get tail) right span)
        span)]
    [_ right]))

(define (macro-literal-to-spanned-sexpr
  [lit : AstLiteral]
  [span : token.SourceSpan]) : reader.SpannedSexpr
  (match lit
    [(AstLiteral.Int n text) (reader.SpannedSexpr.Int n text span)]
    [(AstLiteral.Float text) (reader.SpannedSexpr.Float text span)]
    [(AstLiteral.Bool value)
      (macro-spanned-symbol-id
        (if value
          (cbi.compiler-builtin-ctfe-ref 208)
          (cbi.compiler-builtin-ctfe-ref 209))
        span)]
    [(AstLiteral.Char c) (reader.SpannedSexpr.Char c span)]
    [(AstLiteral.String string-id) (reader.SpannedSexpr.Str string-id span)]
    [(AstLiteral.Unit)
      (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 173) span)]))

(define (macro-pattern-list-to-spanned-sexpr
  [patterns : AstPatternList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-pattern-list-to-spanned-sexpr-at (& patterns) 0 span origin))

(define (macro-pattern-list-to-spanned-sexpr-at
  [patterns : (& patterns AstPatternList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get patterns len))
    (ResultMacroSexpr.Ok (reader.SpannedSexpr.Nil span))
    (match (macro-pattern-to-spanned-sexpr
      (ast-pattern-list-get patterns index (ast-pattern-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-pattern-list-to-spanned-sexpr-at
          patterns
          (+ index 1)
          span
          origin)
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (reader.spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-pattern-to-spanned-sexpr
  [pattern : AstPattern]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match pattern
    [(AstPattern.Binding name)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id
          (macro-output-source-identity-id-at name "pattern-binding")
          span))]
    [(AstPattern.Wildcard)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 180) span))]
    [(AstPattern.Literal lit)
      (ResultMacroSexpr.Ok (macro-literal-to-spanned-sexpr lit span))]
    [(AstPattern.Variant name args-box)
      (match (macro-pattern-list-to-spanned-sexpr
        (box-get args-box)
        span
        origin)
        [(ResultMacroSexpr.Ok args)
          (ResultMacroSexpr.Ok
            (reader.spanned-sexpr-cons
              (macro-spanned-symbol-id
                (macro-output-source-identity-id-at name "pattern-variant")
                span)
              args
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstPattern.Tuple _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output tuple patterns cannot be parsed as source declarations")))]
    [(AstPattern.Var _ _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output typed patterns cannot be parsed as source declarations")))]))

(define (macro-match-arm-bracket
  [arm : AstMatchArm]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match arm
    [(AstMatchArm.Arm pattern body-id)
      (match (macro-pattern-to-spanned-sexpr pattern span origin)
        [(ResultMacroSexpr.Ok spattern)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok
                (reader.spanned-sexpr-bracket-list
                  (reader.spanned-sexpr-cons
                    spattern
                    (reader.spanned-sexpr-cons
                      sbody
                      (reader.SpannedSexpr.Nil span)
                      span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-match-arm-list-to-spanned-sexpr
  [arms : AstMatchArmList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-match-arm-list-to-spanned-sexpr-at (& arms) 0 span origin))

(define (macro-match-arm-list-to-spanned-sexpr-at
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get arms len))
    (ResultMacroSexpr.Ok (reader.SpannedSexpr.Nil span))
    (match (macro-match-arm-bracket
      (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-match-arm-list-to-spanned-sexpr-at
          arms
          (+ index 1)
          span
          origin)
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (reader.spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-let-binding-bracket
  [binding : AstLetBinding]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match binding
    [(AstLetBinding.Binding name maybe-ty value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (match maybe-ty
            [(AstMaybeType.No)
              (ResultMacroSexpr.Ok
                (reader.spanned-sexpr-bracket-list
                  (reader.spanned-sexpr-cons
                    (macro-spanned-symbol-id
                      (macro-output-source-identity-id-at name "let-binding")
                      span)
                    (reader.spanned-sexpr-cons
                      svalue
                      (reader.SpannedSexpr.Nil span)
                      span)
                    span)
                  span))]
            [(AstMaybeType.Some ty)
              (match (macro-type-to-spanned-sexpr ty span origin)
                [(ResultMacroSexpr.Ok sty)
                  (ResultMacroSexpr.Ok
                    (reader.spanned-sexpr-bracket-list
                      (reader.spanned-sexpr-cons
                        (macro-spanned-symbol-id
                          (macro-output-source-identity-id-at
                            name
                            "typed-let-binding")
                          span)
                        (reader.spanned-sexpr-cons
                          (macro-spanned-symbol-id
                            (cbi.compiler-builtin-ctfe-ref 120)
                            span)
                          (reader.spanned-sexpr-cons
                            sty
                            (reader.spanned-sexpr-cons
                              svalue
                              (reader.SpannedSexpr.Nil span)
                              span)
                            span)
                          span)
                        span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-let-tail
  [bindings : AstLetBindingList]
  [body : reader.SpannedSexpr]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-let-tail-at (& bindings) body span origin 0))

(define (macro-let-tail-at
  [bindings : (& bindings AstLetBindingList)]
  [body : reader.SpannedSexpr]
  [span : token.SourceSpan]
  [origin : AstExpr]
  [index : i64]) : ResultMacroSexpr
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultMacroSexpr.Ok
      (reader.spanned-sexpr-cons body (reader.SpannedSexpr.Nil span) span))
    (match (macro-let-binding-bracket
      (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok sbracket)
        (match (macro-let-tail-at bindings body span origin (+ index 1))
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok
              (reader.spanned-sexpr-cons sbracket stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-expr-list-to-spanned-sexpr
  [exprs : AstExprList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-list-to-spanned-sexpr-at (& exprs) 0 span origin))

(define (macro-expr-list-to-spanned-sexpr-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get exprs len))
    (ResultMacroSexpr.Ok (reader.SpannedSexpr.Nil span))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-expr-to-spanned-sexpr-with-span head-expr span origin)
        [(ResultMacroSexpr.Ok shead)
          (match (macro-expr-list-to-spanned-sexpr-at
            exprs
            (+ index 1)
            span
            origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (reader.spanned-sexpr-cons shead stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))))

(define (macro-call-head-to-spanned-sexpr
  [expr : AstExpr]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match expr
    [(AstExpr.Spanned inner-box ast-span)
      (macro-call-head-to-spanned-sexpr
        (ast-node-get inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(AstExpr.Var name-id)
      (let
        [source-id : i64 (macro-output-syntax-id-at name-id "call-head")]
        [tag : i64
          (compiler-parse-dispatch-tag-id
            (compiler-parse-dispatch-env)
            source-id)]
        (ResultMacroSexpr.Ok
          (macro-spanned-symbol-id
            (if (= tag (compiler-parse-tag-unknown))
              (macro-output-source-identity-id-at name-id "call-head")
              source-id)
            span)))]
    [_ (macro-expr-to-spanned-sexpr-with-span expr span origin)]))

(define (macro-expr-to-spanned-sexpr-with-span
  [expr : AstExpr]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match expr
    [(AstExpr.Spanned inner-box ast-span)
      (macro-expr-to-spanned-sexpr-with-span
        (ast-node-get inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int n text)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Int n text span))]
        [(AstLiteral.Float text)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Float text span))]
        [(AstLiteral.Bool value)
          (ResultMacroSexpr.Ok
            (macro-spanned-symbol-id
              (if value
                (cbi.compiler-builtin-ctfe-ref 208)
                (cbi.compiler-builtin-ctfe-ref 209))
              span))]
        [(AstLiteral.Char c)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Char c span))]
        [(AstLiteral.String string-id)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Str string-id span))]
        [(AstLiteral.Unit)
          (ResultMacroSexpr.Ok
            (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 173) span))])]
    [(AstExpr.Var name)
      (ResultMacroSexpr.Ok
        (macro-spanned-symbol-id
          (macro-output-source-identity-id-at name "expr-var")
          span))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (macro-call-head-to-spanned-sexpr func span origin)
          [(ResultMacroSexpr.Ok head)
            (match (macro-expr-list-to-spanned-sexpr args span origin)
              [(ResultMacroSexpr.Ok tail)
                (ResultMacroSexpr.Ok (reader.spanned-sexpr-cons head tail span))]
              [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))]
    [(AstExpr.BracketClause items)
      (match (macro-expr-list-to-spanned-sexpr items span origin)
        [(ResultMacroSexpr.Ok list)
          (ResultMacroSexpr.Ok (reader.spanned-sexpr-bracket-list list span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.If cond-box then-box else-box)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 121)
        (ast-expr-cons
          cond-box
          (ast-expr-cons then-box (ast-expr-cons else-box (ast-expr-list-new))))
        span
        origin)]
    [(AstExpr.Begin exprs)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 122)
        exprs
        span
        origin)]
    [(AstExpr.Unsafe exprs)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 123)
        exprs
        span
        origin)]
    [(AstExpr.Tuple exprs)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 124)
        exprs
        span
        origin)]
    [(AstExpr.Array exprs)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 125)
        exprs
        span
        origin)]
    [(AstExpr.DynArray exprs)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 114)
        exprs
        span
        origin)]
    [(AstExpr.Quote inner-box)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 126)
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Quasiquote inner-box)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 127)
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Unquote inner-box)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 128)
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.UnquoteSplicing inner-box)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 129)
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Binary op left-id right-id)
      (match (macro-child-to-spanned-sexpr left-id span origin)
        [(ResultMacroSexpr.Ok sleft)
          (match (macro-child-to-spanned-sexpr right-id span origin)
            [(ResultMacroSexpr.Ok sright)
              (ResultMacroSexpr.Ok
                (macro-form2-id (macro-binop-symbol-id op) sleft sright span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Unary op inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (macro-unop-symbol-id op) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-id)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (match (macro-let-tail bindings sbody span origin)
                [(ResultMacroSexpr.Ok stail)
                  (ResultMacroSexpr.Ok
                    (reader.spanned-sexpr-cons
                      (macro-spanned-symbol-id
                        (cbi.compiler-builtin-ctfe-ref 181)
                        span)
                      stail
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.While cond-id body-id)
      (match (macro-child-to-spanned-sexpr cond-id span origin)
        [(ResultMacroSexpr.Ok scond)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 113)
                  scond
                  sbody
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-id arms)
          (match (macro-child-to-spanned-sexpr scrutinee-id span origin)
            [(ResultMacroSexpr.Ok sscrutinee)
              (match (macro-match-arm-list-to-spanned-sexpr arms span origin)
                [(ResultMacroSexpr.Ok sarms)
                  (ResultMacroSexpr.Ok
                    (reader.spanned-sexpr-cons
                      (macro-spanned-symbol-id
                        (cbi.compiler-builtin-ctfe-ref 182)
                        span)
                      (reader.spanned-sexpr-cons sscrutinee sarms span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.Set name value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 157)
              (macro-spanned-symbol-id
                (macro-output-source-identity-id-at name "expr-set")
                span)
              svalue
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.MakeArray ty len-id)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (match (macro-child-to-spanned-sexpr len-id span origin)
            [(ResultMacroSexpr.Ok slen)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 114)
                  sty
                  slen
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArrayRef array-id index-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 115)
                  sarray
                  sindex
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArraySet array-id index-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (match (macro-child-to-spanned-sexpr value-id span origin)
                [(ResultMacroSexpr.Ok svalue)
                  (ResultMacroSexpr.Ok
                    (macro-form3-id
                      (cbi.compiler-builtin-ctfe-ref 184)
                      sarray
                      sindex
                      svalue
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArrayTake array-id live-id index-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr live-id span origin)
            [(ResultMacroSexpr.Ok slive)
              (match (macro-child-to-spanned-sexpr index-id span origin)
                [(ResultMacroSexpr.Ok sindex)
                  (ResultMacroSexpr.Ok
                    (macro-form3-id
                      (cbi.compiler-builtin-ctfe-ref 185)
                      sarray
                      slive
                      sindex
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArrayPush array-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 116)
                  sarray
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StringRef string-id index-id)
      (match (macro-child-to-spanned-sexpr string-id span origin)
        [(ResultMacroSexpr.Ok sstring)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 117)
                  sstring
                  sindex
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StructGet receiver-id field)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 183)
              sreceiver
              (macro-spanned-symbol-id field span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StructSet receiver-id field value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 157)
                  (macro-form2-id
                    (cbi.compiler-builtin-ctfe-ref 183)
                    sreceiver
                    (macro-spanned-symbol-id field span)
                    span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Cast inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3-id
                  (cbi.compiler-builtin-ctfe-ref 186)
                  sinner
                  (macro-spanned-symbol-id
                    (cbi.compiler-builtin-ctfe-ref 120)
                    span)
                  sty
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Ann inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3-id
                  (cbi.compiler-builtin-ctfe-ref 187)
                  sinner
                  (macro-spanned-symbol-id
                    (cbi.compiler-builtin-ctfe-ref 120)
                    span)
                  sty
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Borrow mutable lifetime place-id)
      (match (macro-child-to-spanned-sexpr place-id span origin)
        [(ResultMacroSexpr.Ok splace)
          (let
            [head-id : i64
              (if mutable
                (cbi.compiler-builtin-ctfe-ref 111)
                (cbi.compiler-builtin-ctfe-ref 110))]
            (match lifetime
              [(AstBorrowLifetime.Inferred)
                (ResultMacroSexpr.Ok (macro-form1-id head-id splace span))]
              [(AstBorrowLifetime.Named name)
                (ResultMacroSexpr.Ok
                  (macro-form2-id
                    head-id
                    (macro-spanned-symbol-id name span)
                    splace
                    span))]))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Return inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 130) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Try inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 131) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Box inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 132) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxGet inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 133) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxTake inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 134) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxSet receiver-id value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 157)
                  (macro-form1-id
                    (cbi.compiler-builtin-ctfe-ref 133)
                    sreceiver
                    span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.TupleRef tuple-id index)
      (match (macro-child-to-spanned-sexpr tuple-id span origin)
        [(ResultMacroSexpr.Ok stuple)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 188)
              stuple
              (reader.SpannedSexpr.Int index (string.int->string index) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.No)
          (ResultMacroSexpr.Ok
            (reader.spanned-sexpr-cons
              (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 118) span)
              (reader.SpannedSexpr.Nil span)
              span))]
        [(AstMaybeType.Some ty)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form2-id
                  (cbi.compiler-builtin-ctfe-ref 118)
                  (macro-spanned-symbol-id
                    (cbi.compiler-builtin-ctfe-ref 120)
                    span)
                  sty
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.TypeLiteral ty)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok
            (macro-form1-id (cbi.compiler-builtin-ctfe-ref 135) sty span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.PtrNull ty)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok
            (macro-form2-id
              (cbi.compiler-builtin-ctfe-ref 119)
              (macro-spanned-symbol-id (cbi.compiler-builtin-ctfe-ref 120) span)
              sty
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.PtrNullCheck ptr-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 189)
        ptr-id
        span
        origin)]
    [(AstExpr.PtrAddrOf place-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 190)
        place-id
        span
        origin)]
    [(AstExpr.PtrRead ptr-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 191)
        ptr-id
        span
        origin)]
    [(AstExpr.PtrWrite ptr-id value-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 192)
        ptr-id
        value-id
        span
        origin)]
    [(AstExpr.PtrOffset ptr-id offset-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 193)
        ptr-id
        offset-id
        span
        origin)]
    [(AstExpr.PtrCast ptr-id ty)
      (macro-child-type-form3-id
        (cbi.compiler-builtin-ctfe-ref 194)
        ptr-id
        ty
        span
        origin)]
    [(AstExpr.PtrToInt ptr-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 195)
        ptr-id
        span
        origin)]
    [(AstExpr.IntToPtr value-id ty)
      (macro-child-type-form3-id
        (cbi.compiler-builtin-ctfe-ref 196)
        value-id
        ty
        span
        origin)]
    [(AstExpr.StringData value-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 197)
        value-id
        span
        origin)]
    [(AstExpr.StringFromBytes ptr-id len-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 198)
        ptr-id
        len-id
        span
        origin)]
    [(AstExpr.ArrayData value-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 199)
        value-id
        span
        origin)]
    [(AstExpr.BinaryData bytes)
      (ResultMacroSexpr.Ok
        (macro-form1-id
          (cbi.compiler-builtin-ctfe-ref 213)
          (reader.SpannedSexpr.Str
            (ci.intern-generated-canonical-name bytes)
            span)
          span))]
    [(AstExpr.ProgramArgc)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 200) span))]
    [(AstExpr.ProgramArgv)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 201) span))]
    [(AstExpr.ProgramEnvp)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 202) span))]
    [(AstExpr.CpuIdEax leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 203)
        leaf-id
        subleaf-id
        span
        origin)]
    [(AstExpr.CpuIdEbx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 204)
        leaf-id
        subleaf-id
        span
        origin)]
    [(AstExpr.CpuIdEcx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 205)
        leaf-id
        subleaf-id
        span
        origin)]
    [(AstExpr.CpuIdEdx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 206)
        leaf-id
        subleaf-id
        span
        origin)]
    [(AstExpr.Xgetbv index-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 207)
        index-id
        span
        origin)]
    [(AstExpr.Syscall args)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 136)
        args
        span
        origin)]
    [_
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output contains syntax that cannot be parsed as a declaration")))]))

(define (macro-expr-to-spanned-sexpr [expr : AstExpr] [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span expr (macro-zero-source-span) origin))

(define (macro-stdlib-private-dynamic-buffer-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (or
      (string.eq definition-module "stdlib.vector")
      (string.eq definition-module "stdlib/vector"))
    (or
      (string.eq macro-name "vector")
      (string.eq macro-name "stdlib.vector/vector")
      (string.eq macro-name "stdlib/vector/vector")
      (string.eq macro-name "vector-family")
      (string.eq macro-name "stdlib.vector/vector-family")
      (string.eq macro-name "stdlib/vector/vector-family"))))

(define (macro-parse-dispatch-for-macro
  [macro-name : String]
  [definition-module : String]) : sym_i64_env.SymI64Env
  (if (macro-stdlib-private-dynamic-buffer-macro? macro-name definition-module)
    (compiler-parse-dispatch-private-types (compiler-parse-dispatch-env))
    (compiler-parse-dispatch-env)))

(define (macro-parse-decl-sexpr
  [dispatch : sym_i64_env.SymI64Env]
  [form : reader.SpannedSexpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (parse-ast-decl-maybe dispatch form)
    [(ResultAstMaybeDecl.SomeDecl decl)
      (ResultMacroParsedDecls.Ok (ast-decl-cons decl (ast-decl-list-new)))]
    [(ResultAstMaybeDecl.Decls decls) (ResultMacroParsedDecls.Ok decls)]
    [(ResultAstMaybeDecl.NoDecl)
      (ResultMacroParsedDecls.Ok (ast-decl-list-new))]
    [(ResultAstMaybeDecl.Err message)
      (ResultMacroParsedDecls.Err
        (box (macro-output-syntax-diag origin message)))]))

(define (macro-parse-decls-from-one-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (let
    [mark : i64 (reader.sp-node-pool-len)]
    (match (macro-expr-to-spanned-sexpr expr origin)
      [(ResultMacroSexpr.Ok form)
        (match (macro-parse-decl-sexpr dispatch form origin)
          [(ResultMacroParsedDecls.Ok decls)
            (begin
              (reader.sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Ok decls))]
          [(ResultMacroParsedDecls.Err diag)
            (begin
              (reader.sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Err diag))])]
      [(ResultMacroSexpr.Err diag)
        (begin
          (reader.sp-node-pool-truncate! mark)
          (ResultMacroParsedDecls.Err diag))])))

(define (macro-parse-decls-from-exprs
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : AstExprList]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (macro-parse-decls-from-exprs-at dispatch (& exprs) 0 origin))

(define (macro-parse-decls-from-exprs-at
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (if (>= index (struct-get exprs len))
    (ResultMacroParsedDecls.Ok (ast-decl-list-new))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-parse-decls-from-expr dispatch head-expr origin)
        [(ResultMacroParsedDecls.Ok head-decls)
          (match (macro-parse-decls-from-exprs-at
            dispatch
            exprs
            (+ index 1)
            origin)
            [(ResultMacroParsedDecls.Ok rest-decls)
              (ResultMacroParsedDecls.Ok
                (macro-decl-list-append head-decls rest-decls))]
            [(ResultMacroParsedDecls.Err diag)
              (ResultMacroParsedDecls.Err diag)])]
        [(ResultMacroParsedDecls.Err diag) (ResultMacroParsedDecls.Err diag)]))))

(define (macro-parse-decls-from-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (ast-expr-unspan expr)
    [(AstExpr.Begin exprs) (macro-parse-decls-from-exprs dispatch exprs origin)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (ast-expr-unspan func)
          [(AstExpr.Var name)
            (if (=
              (compiler-parse-dispatch-tag-id
                dispatch
                (macro-output-syntax-id-at name "parse-call-head"))
              (compiler-parse-tag-expr-begin))
              (macro-parse-decls-from-exprs dispatch args origin)
              (macro-parse-decls-from-one-expr dispatch expr origin))]
          [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))]
    [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))

(define (macro-module-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Module macro transformer did not produce Expr")))]))

(define (macro-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Decls macro transformer did not produce Expr")))]))

(define (macro-hygiene-ctfe-output
  [value : CompilerCtfeValue]
  [hygiene : MacroHygieneContext]
  [params : AstMacroParamList]
  [depth : i64]) : CompilerCtfeValue
  (match value
    [(CompilerCtfeValue.Expr node produced)
      (let
        [expr : AstExpr (ast-node-get node)]
        [param-env : MacroHygieneEnv
          (macro-hygiene-output-macro-param-env
            (& params)
            0
            MacroHygieneEnv.Nil)]
        [output-env : MacroHygieneEnv
          (macro-hygiene-output-decl-env expr param-env)]
        (CompilerCtfeValue.Expr
          (macro-hygiene-expr expr output-env hygiene depth)
          produced))]
    [_ value]))

(define (macro-collect-decl-name
  [decl : AstDecl]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl
    [(AstDecl.DefMacro decl-meta name _ _ _)
      (begin
        (ctfe-module-macro-export-add-id! module-id name)
        (tc-name-id-list-add acc name))]
    [(AstDecl.Unsafe inner-box)
      (macro-collect-decl-name (box-get inner-box) module-id acc)]
    [_ acc]))

(define (macro-collect-macro-names [decls : AstDeclList] [acc : TcNameIdList]) : TcNameIdList
  (let
    [cur : AstDeclList decls]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [out : TcNameIdList acc]
    (begin
      (while (not (ast-decl-list-empty? (& cur)))
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) unit]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module) (set! cur-module-id next-module)]
                [_ (set! out (macro-collect-decl-name decl cur-module-id out))])
              (set! cur rest))]))
      out)))

(define (macro-collect-surface-decl-name
  [decl : CompilerLoadSurfaceDecl]
  [acc : TcNameIdList]) : TcNameIdList
  (match (struct-get decl kind)
    [(CompilerLoadSurfaceMacro)
      (let
        [module-id : i64 (struct-get decl module)]
        [name-id : i64 (struct-get decl name)]
        (begin
          (ctfe-module-macro-export-add-id! module-id name-id)
          (tc-name-id-list-add acc name-id)))]
    [_ acc]))

(define (macro-collect-surface-decl-names
  [decls : CompilerLoadSurfaceDeclList]
  [acc : TcNameIdList]) : TcNameIdList
  (match decls
    [(CompilerLoadSurfaceDeclNil) acc]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (macro-collect-surface-decl-names
        (box-get rest)
        (macro-collect-surface-decl-name decl acc))]))

(define (macro-collect-surface-summary-macro-names
  [summaries : CompilerLoadSurfaceSummaryList]
  [acc : TcNameIdList]) : TcNameIdList
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) acc]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (macro-collect-surface-summary-macro-names
        (box-get rest)
        (macro-collect-surface-decl-names (struct-get summary decls) acc))]))

(define (macro-collect-visible-macro-names [decls : AstDeclList]) : TcNameIdList
  (macro-collect-surface-summary-macro-names
    (compiler-load-surface-summaries)
    (macro-collect-macro-names decls (TcNameIdList.Nil))))

(define (macro-name-set-add-all
  [names : TcNameIdList]
  [set : (&mut set tc_i64_i64_map.Map)]) : unit
  (match names
    [(TcNameIdList.Nil) unit]
    [(TcNameIdList.Cons name-id rest)
      (begin
        (tc_i64_i64_map.insert-ref! set name-id 1)
        (macro-name-set-add-all (box-get rest) set))]))

(define (macro-name-set-from-list [names : TcNameIdList]) : tc_i64_i64_map.Map
  (let
    [set : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 128)]
    (begin
      (macro-name-set-add-all names (&mut set))
      set)))

(define (macro-expand-set-macro-names! [names : TcNameIdList]) : unit
  (set! macro-expand-macro-name-set (macro-name-set-from-list names)))

(define (macro-surface-decl-macro-in-module?
  [decl : CompilerLoadSurfaceDecl]
  [target-module : String]
  [base : String]) : bool
  (and
    (string.eq (intern-str (struct-get decl module)) target-module)
    (string.eq (intern-str (struct-get decl name)) base)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false])))

(define (macro-surface-decls-macro-in-module?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]
  [base : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (macro-surface-decl-macro-in-module? decl target-module base)
        (macro-surface-decls-macro-in-module? (box-get rest) target-module base))]))

(define (macro-surface-summaries-macro-in-module?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]
  [base : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-macro-in-module?
          (struct-get summary decls)
          target-module
          base)
        (macro-surface-summaries-macro-in-module?
          (box-get rest)
          target-module
          base))]))

(define (macro-surface-macro-in-module?
  [target-module : String]
  [base : String]) : bool
  (macro-surface-summaries-macro-in-module?
    (compiler-load-surface-summaries)
    target-module
    base))

(define (macro-surface-decls-module-has-macro?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (and
          (string.eq (intern-str (struct-get decl module)) target-module)
          (match (struct-get decl kind)
            [(CompilerLoadSurfaceMacro) true]
            [_ false]))
        (macro-surface-decls-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-summaries-module-has-macro?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-module-has-macro?
          (struct-get summary decls)
          target-module)
        (macro-surface-summaries-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-module-has-macro? [target-module : String]) : bool
  (macro-surface-summaries-module-has-macro?
    (compiler-load-surface-summaries)
    target-module))

(defenum MacroSurfaceCallDeclCacheLookup
  (Miss)
  (Hit MacroMaybeDecl))

(define macro-surface-call-decl-cache-capacity : i64
  8192)
(define macro-surface-call-decl-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-base-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-values : (Array MacroMaybeDecl)
  (array.make-array MacroMaybeDecl 8192))
(define macro-surface-call-decl-cache-count : i64
  0)
(define macro-surface-call-decl-cache-generation : i64
  -1)
(define macro-surface-call-decl-cache-ready : bool
  false)

(define (macro-surface-call-decl-cache-reset!) : unit
  (set! macro-surface-call-decl-cache-ready false))

(define (macro-surface-call-decl-cache-ensure!) : unit
  (if (if macro-surface-call-decl-cache-ready
    (= macro-surface-call-decl-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-surface-call-decl-cache-capacity)
          (begin
            (array-set! macro-surface-call-decl-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-surface-call-decl-cache-count 0)
        (set! macro-surface-call-decl-cache-generation (intern-generation))
        (set! macro-surface-call-decl-cache-ready true)))))

(define (macro-surface-call-decl-cache-bucket [module-id : i64] [base-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* base-id 40503))
    (- macro-surface-call-decl-cache-capacity 1)))

(define (macro-surface-call-decl-cache-get [module-id : i64] [base-id : i64]) : MacroSurfaceCallDeclCacheLookup
  (let
    [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
    [module-key : i64 (+ module-id 1)]
    [base-key : i64 (+ base-id 1)]
    [steps : i64 0]
    [out : MacroSurfaceCallDeclCacheLookup
      (MacroSurfaceCallDeclCacheLookup.Miss)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-surface-call-decl-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-surface-call-decl-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-surface-call-decl-cache-base-keys cursor)
                base-key))
              (begin
                (set!
                  out
                  (MacroSurfaceCallDeclCacheLookup.Hit
                    (array-ref macro-surface-call-decl-cache-values cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-surface-call-decl-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-surface-call-decl-cache-put!
  [module-id : i64]
  [base-id : i64]
  [value : MacroMaybeDecl]) : unit
  (if (>=
    (* macro-surface-call-decl-cache-count 2)
    macro-surface-call-decl-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
      [module-key : i64 (+ module-id 1)]
      [base-key : i64 (+ base-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-surface-call-decl-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-surface-call-decl-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-surface-call-decl-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-surface-call-decl-cache-base-keys
                  cursor
                  base-key)
                (array-set! macro-surface-call-decl-cache-values cursor value)
                (set!
                  macro-surface-call-decl-cache-count
                  (+ macro-surface-call-decl-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-surface-call-decl-cache-base-keys cursor)
                  base-key))
                (begin
                  (array-set! macro-surface-call-decl-cache-values cursor value)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-surface-call-decl-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-surface-decl-call-decl-in-module
  [decl : CompilerLoadSurfaceDecl]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (if (and
    (= (struct-get decl module) target-module-id)
    (= (struct-get decl name) base-id)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false]))
    (match (struct-get decl signature)
      [(CompilerLoadSurfaceMacroSignature params ret body-box)
        (begin
          (tc-lazy-import-summary-macro-force-record!)
          (MacroMaybeDecl.Some
            (struct-get decl name)
            (struct-get decl module)
            -1
            params
            ret
            (ast-node-get body-box)))]
      [_ (MacroMaybeDecl.No)])
    (MacroMaybeDecl.No)))

(define (macro-surface-decls-call-decl-in-module
  [decls : CompilerLoadSurfaceDeclList]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (match decls
    [(CompilerLoadSurfaceDeclNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (match (macro-surface-decl-call-decl-in-module
        decl
        target-module-id
        base-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)]
        [(MacroMaybeDecl.No)
          (macro-surface-decls-call-decl-in-module
            (box-get rest)
            target-module-id
            base-id)])]))

(define (macro-surface-summaries-call-decl-in-module
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (match (macro-surface-decls-call-decl-in-module
        (struct-get summary decls)
        target-module-id
        base-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)]
        [(MacroMaybeDecl.No)
          (macro-surface-summaries-call-decl-in-module
            (box-get rest)
            target-module-id
            base-id)])]))

(define (macro-surface-call-decl-in-module
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (begin
    (macro-surface-call-decl-cache-ensure!)
    (match (macro-surface-call-decl-cache-get target-module-id base-id)
      [(MacroSurfaceCallDeclCacheLookup.Hit cached) cached]
      [(MacroSurfaceCallDeclCacheLookup.Miss)
        (let
          [result : MacroMaybeDecl
            (match (macro-surface-summaries-call-decl-in-module
              (compiler-load-surface-summaries)
              target-module-id
              base-id)
              [(MacroMaybeDecl.Some
                  macro-name
                  def-module
                  declaration-id
                  params
                  ret
                  body)
                (MacroMaybeDecl.Some
                  macro-name
                  def-module
                  declaration-id
                  params
                  ret
                  body)]
              [(MacroMaybeDecl.No) (MacroMaybeDecl.No)])]
          (begin
            (macro-surface-call-decl-cache-put! target-module-id base-id result)
            result))])))

(define (macro-expr-uses-expr-type? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime/expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib.comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib.comptime/expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib/comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib/comptime/expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "expr-string?" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime.expr-string?" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime/expr-string?" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime.expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime/expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib/comptime.expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name? expr "expr-string-value" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime.expr-string-value" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime/expr-string-value" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime.expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime/expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib/comptime.expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name? expr "string-slice" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime.string-slice" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime/string-slice" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime.string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib.comptime/string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr
      "stdlib/comptime.string-slice"
      TcStringList.Nil)))

(define (macro-collect-expr-type-decl-name
  [decl : AstDecl]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (match decl
    [(AstDecl.DefMacro decl-meta name _ _ body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        [name-str : String (tc-env-key-name-text name)]
        (if (macro-expr-uses-expr-type? body)
          (tc-string-list-add acc (compiler-symbol-module-key module name-str))
          acc))]
    [(AstDecl.Unsafe inner-box)
      (macro-collect-expr-type-decl-name (box-get inner-box) module acc)]
    [_ acc]))

(define (macro-collect-expr-type-macro-names-in
  [decls : AstDeclList]
  [module-id : i64]
  [acc : TcStringList]) : TcStringList
  (let
    [cur : AstDeclList decls]
    [cur-module-id : i64 module-id]
    [out : TcStringList acc]
    (begin
      (while (not (ast-decl-list-empty? (& cur)))
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) unit]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module) (set! cur-module-id next-module)]
                [_
                  (set!
                    out
                    (macro-collect-expr-type-decl-name
                      decl
                      (intern-str cur-module-id)
                      out))])
              (set! cur rest))]))
      out)))

(define (macro-collect-expr-type-macro-names [decls : AstDeclList]) : TcStringList
  (macro-collect-expr-type-macro-names-in
    decls
    cbi.compiler-builtin-id-fix-empty
    TcStringList.Nil))

(define (macro-hygiene-structural-base) : i64
  (ci.intern-macro-global-structural-base))

(define (macro-hygiene-global-id
  [module-id : i64]
  [source-name-id : i64]
  [legacy? : bool]) : i64
  (let
    [stride : i64 (intern-capacity)]
    [stride2 : i64 (* stride stride)]
    [stored-module-id : i64
      (if (compiler-symbol-root-module-id? module-id)
        0
        (+ module-id 1))]
    (begin
      (when
        (or
          (< source-name-id 0)
          (>= source-name-id stride)
          (< stored-module-id 0)
          (>= stored-module-id stride))
        (io.panic
          "typecheck: hygienic global identity exceeds structural range"))
      (+
        (macro-hygiene-structural-base)
        (+
          (if legacy?
            0
            stride2)
          (+ (* stored-module-id stride) source-name-id))))))

(define (macro-hygiene-global-id? [name-id : i64]) : bool
  (ci.intern-macro-global-structural-id? name-id))

(define (macro-hygiene-global-legacy-id? [name-id : i64]) : bool
  (<
    name-id
    (+ (macro-hygiene-structural-base) (* (intern-capacity) (intern-capacity)))))

(define (macro-hygiene-global-module-id [name-id : i64]) : i64
  (let
    [stored : i64
      (%
        (/ (- name-id (macro-hygiene-structural-base)) (intern-capacity))
        (intern-capacity))]
    (if (= stored 0)
      (compiler-symbol-root-module-id)
      (- stored 1))))

(define (macro-hygiene-local-base) : i64
  (let
    [stride : i64 (intern-capacity)]
    (+ (macro-hygiene-structural-base) (* 2 (* stride stride)))))

(define (macro-hygiene-local-id
  [hygiene : MacroHygieneContext]
  [depth : i64]
  [source-name-id : i64]) : i64
  (let
    [stride : i64 (intern-capacity)]
    [module-id : i64 (struct-get hygiene definition-module-id)]
    [declaration-id : i64 (struct-get hygiene declaration-id)]
    [stored-module-id : i64
      (if (compiler-symbol-root-module-id? module-id)
        0
        (+ module-id 1))]
    [macro-name-id : i64 (struct-get hygiene macro-name-id)]
    [macro-id : i64
      (if (>= declaration-id 0)
        (+ declaration-id 1)
        (+ (+ stride 1) (+ (* stored-module-id stride) macro-name-id)))]
    (begin
      (when
        (or
          (< stored-module-id 0)
          (>= stored-module-id stride)
          (< macro-name-id 0)
          (>= macro-name-id stride)
          (and (>= declaration-id 0) (>= declaration-id stride))
          (< depth 0)
          (>= depth 1024)
          (< source-name-id 0)
          (>= source-name-id stride))
        (io.panic "typecheck: hygienic macro identity exceeds structural range"))
      (+
        (macro-hygiene-local-base)
        (+ (* macro-id (* 1024 stride)) (+ (* depth stride) source-name-id))))))

(define (macro-hygiene-local-id? [name-id : i64]) : bool
  (let
    [stride : i64 (intern-capacity)]
    [stride2 : i64 (* stride stride)]
    [base : i64 (macro-hygiene-local-base)]
    (and
      (>= name-id base)
      (< name-id (+ base (* 1024 (* stride (+ stride2 (+ stride 1)))))))))

(define (macro-hygiene-structural-source-name-id [name-id : i64]) : i64
  (ci.intern-macro-global-source-name-id name-id))

(define (macro-hygiene-global-source-name-id-or
  [name-id : i64]
  [fallback : i64]) : i64
  (cond
    [(ci.intern-structural-local-id? name-id)
      (ci.intern-structural-local-source-name-id name-id)]
    [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
      (macro-hygiene-structural-source-name-id name-id)]
    [(and
        (>= name-id 0)
        (< name-id (intern-capacity))
        (ci.intern-qualified? name-id)
        (tc-hygiene-global-name? (intern-str name-id)))
      (ci.intern-qualified-base-id name-id)]
    [else fallback]))

(define (macro-hygiene-env-lookup [env : MacroHygieneEnv] [name-id : i64]) : MacroMaybeHygieneName
  (match env
    [(MacroHygieneEnv.Nil) (MacroMaybeHygieneName.No)]
    [(MacroHygieneEnv.Bind key-id value-id rest)
      (if (= key-id name-id)
        (MacroMaybeHygieneName.Some value-id)
        (macro-hygiene-env-lookup (box-get rest) name-id))]
    [(MacroHygieneEnv.PatternName key-id value-id rest)
      (if (= key-id name-id)
        (MacroMaybeHygieneName.Some value-id)
        (macro-hygiene-env-lookup (box-get rest) name-id))]))

(define (macro-hygiene-env-lookup-pattern-name
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroMaybeHygieneName
  (match env
    [(MacroHygieneEnv.Nil) (MacroMaybeHygieneName.No)]
    [(MacroHygieneEnv.Bind _ _ rest)
      (macro-hygiene-env-lookup-pattern-name (box-get rest) name-id)]
    [(MacroHygieneEnv.PatternName key-id value-id rest)
      (if (= key-id name-id)
        (MacroMaybeHygieneName.Some value-id)
        (macro-hygiene-env-lookup-pattern-name (box-get rest) name-id))]))

(define (macro-hygiene-output-bind-id [env : MacroHygieneEnv] [name-id : i64]) : MacroHygieneEnv
  (if (ci.intern-template-source-id? name-id)
    (MacroHygieneEnv.Bind
      name-id
      (ci.intern-template-source-name-id name-id)
      (box env))
    env))

(define (macro-hygiene-output-pattern-name-id
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroHygieneEnv
  (if (ci.intern-template-source-id? name-id)
    (MacroHygieneEnv.PatternName
      name-id
      (ci.intern-template-source-name-id name-id)
      (box env))
    env))

(define (macro-hygiene-output-macro-param-env
  [params : (& params AstMacroParamList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (ast-macro-param-list-len params))
    env
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param name-id _ _ _)
        (macro-hygiene-output-macro-param-env
          params
          (+ index 1)
          (MacroHygieneEnv.Bind
            (ci.intern-template-source-id name-id)
            name-id
            (box env)))])))

(define (macro-hygiene-output-param-env
  [expr : AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.BracketClause items)
      (if (> (struct-get (& items) len) 0)
        (match (ast-expr-unspan
          (ast-node-get (ast-expr-list-get (& items) 0 0)))
          [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
          [_ env])
        env)]
    [_ env]))

(define (macro-hygiene-output-param-list-env
  [items : (& items AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (struct-get items len))
    env
    (macro-hygiene-output-param-list-env
      items
      (+ index 1)
      (macro-hygiene-output-param-env
        (ast-node-get (ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-signature-env
  [expr : AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(AstExpr.Call func-box params)
      (let
        [func : AstExpr (ast-node-get func-box)]
        [with-name : MacroHygieneEnv
          (match (ast-expr-unspan func)
            [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
            [_ env])]
        (macro-hygiene-output-param-list-env (& params) 0 with-name))]
    [_ env]))

(define (macro-hygiene-output-declaration-name-env
  [expr : AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(AstExpr.Call func-box _)
      (match (ast-expr-unspan (ast-node-get func-box))
        [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-bind-var-expr
  [expr : AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [_ env]))

(define (macro-hygiene-output-bind-var-list-env
  [items : (& items AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (struct-get items len))
    env
    (macro-hygiene-output-bind-var-list-env
      items
      (+ index 1)
      (macro-hygiene-output-bind-var-expr
        (ast-node-get (ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-aggregate-member-env
  [expr : AstExpr]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id)
      (if pattern-name?
        (macro-hygiene-output-pattern-name-id env name-id)
        (macro-hygiene-output-bind-id env name-id))]
    [(AstExpr.Call func-box _)
      (match (ast-expr-unspan (ast-node-get func-box))
        [(AstExpr.Var name-id)
          (let
            [source-id : i64 (tc-hygiene-template-source-id-or name-id name-id)]
            (cond
              [(and
                  (ci.intern-colon-keyword-id? source-id)
                  (string.eq (intern-str source-id) ":lifetimes"))
                (match (ast-expr-unspan expr)
                  [(AstExpr.Call _ args)
                    (macro-hygiene-output-bind-var-list-env (& args) 0 env)]
                  [_ env])]
              [(ci.intern-colon-keyword-id? source-id) env]
              [pattern-name? (macro-hygiene-output-pattern-name-id env name-id)]
              [else (macro-hygiene-output-bind-id env name-id)]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-aggregate-member-list-env
  [items : (& items AstExprList)]
  [index : i64]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (struct-get items len))
    env
    (macro-hygiene-output-aggregate-member-list-env
      items
      (+ index 1)
      pattern-name?
      (macro-hygiene-output-aggregate-member-env
        (ast-node-get (ast-expr-list-get items index 0))
        pattern-name?
        env))))

(define (macro-hygiene-output-import-env
  [items : (& items AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (let
    [count : i64 (struct-get items len)]
    [with-target : MacroHygieneEnv
      (if (> count 0)
        (match (ast-expr-unspan (ast-node-get (ast-expr-list-get items 0 0)))
          [(AstExpr.Var target-id) (macro-hygiene-output-bind-id env target-id)]
          [_ env])
        env)]
    (if (>= count 3)
      (let
        [as-expr : AstExpr
          (ast-node-get (ast-expr-list-get items (- count 2) 0))]
        [alias-expr : AstExpr
          (ast-node-get (ast-expr-list-get items (- count 1) 0))]
        (match (ast-expr-unspan as-expr)
          [(AstExpr.Var as-id)
            (if (string.eq
              (intern-str (tc-hygiene-template-source-id-or as-id as-id))
              "as")
              (match (ast-expr-unspan alias-expr)
                [(AstExpr.Var alias-id)
                  (macro-hygiene-output-bind-id
                    (macro-hygiene-output-bind-id with-target as-id)
                    alias-id)]
                [_ with-target])
              with-target)]
          [_ with-target]))
      (if (= count 1)
        (match (ast-expr-unspan (ast-node-get (ast-expr-list-get items 0 0)))
          [(AstExpr.Var target-id)
            (let
              [source-id : i64
                (tc-hygiene-template-source-id-or target-id target-id)]
              [tail-id : i64 (intern-dotted-tail-id source-id)]
              (if (>= tail-id 0)
                (macro-hygiene-output-bind-id
                  with-target
                  (ci.intern-template-source-id tail-id))
                with-target))]
          [_ with-target])
        with-target))))

(define (macro-hygiene-output-decl-list-env
  [items : (& items AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (struct-get items len))
    env
    (macro-hygiene-output-decl-list-env
      items
      (+ index 1)
      (macro-hygiene-output-decl-env
        (ast-node-get (ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-decl-env [expr : AstExpr] [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan expr)
    [(AstExpr.Begin items) (macro-hygiene-output-decl-list-env (& items) 0 env)]
    [(AstExpr.Unsafe items)
      (macro-hygiene-output-decl-list-env (& items) 0 env)]
    [(AstExpr.Comptime inner-box)
      (macro-hygiene-output-decl-env (ast-node-get inner-box) env)]
    [(AstExpr.Call func-box args)
      (match (ast-expr-unspan (ast-node-get func-box))
        [(AstExpr.Var head-id)
          (let
            [source-head-id : i64
              (tc-hygiene-template-source-id-or head-id head-id)]
            [tag : i64
              (compiler-parse-dispatch-tag-id
                (compiler-parse-dispatch-env)
                source-head-id)]
            [count : i64 (struct-get (& args) len)]
            (cond
              [(= source-head-id (cbi.compiler-builtin-ctfe-ref 122))
                (macro-hygiene-output-decl-list-env (& args) 0 env)]
              [(= tag (compiler-parse-tag-decl-module))
                (macro-hygiene-output-decl-list-env (& args) 1 env)]
              [(= tag (compiler-parse-tag-decl-import))
                (macro-hygiene-output-import-env (& args) env)]
              [(= tag (compiler-parse-tag-decl-defenum))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    true
                    (macro-hygiene-output-declaration-name-env
                      (ast-node-get (ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(= tag (compiler-parse-tag-decl-defstruct))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    false
                    (macro-hygiene-output-declaration-name-env
                      (ast-node-get (ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(or
                  (= tag (compiler-parse-tag-decl-define))
                  (= tag (compiler-parse-tag-decl-extern))
                  (= tag (compiler-parse-tag-decl-defmacro))
                  (= tag (compiler-parse-tag-decl-defdispatch)))
                (if (> count 0)
                  (macro-hygiene-output-declaration-name-env
                    (ast-node-get (ast-expr-list-get (& args) 0 0))
                    env)
                  env)]
              [else env]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-binding-owner-module-id-or
  [hygiene : MacroHygieneContext]
  [module-id : i64]
  [source-name-id : i64]
  [fallback : i64]) : i64
  (let
    [lookup-module-id : i64
      (if (compiler-symbol-root-module-id? module-id)
        cbi.compiler-builtin-id-fix-empty
        module-id)]
    [value-handle : i64
      (compiler-symbols-lookup-value-in-module-id-or
        (struct-get hygiene symbols)
        lookup-module-id
        source-name-id
        (compiler-symbols-missing-handle))]
    [type-handle : i64
      (compiler-symbols-lookup-type-in-module-id-or
        (struct-get hygiene symbols)
        lookup-module-id
        source-name-id
        (compiler-symbols-missing-handle))]
    [macro-handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (struct-get hygiene symbols)
        lookup-module-id
        source-name-id
        (compiler-symbols-missing-handle))]
    [declaration-id : i64
      (cond
        [(compiler-symbols-handle-found? value-handle)
          (compiler-symbol-handle-index value-handle)]
        [(compiler-symbols-handle-found? type-handle)
          (compiler-symbol-handle-index type-handle)]
        [(compiler-symbols-handle-found? macro-handle)
          (compiler-symbol-handle-index macro-handle)]
        [else -1])]
    (if (< declaration-id 0)
      fallback
      (let
        [owner-module-id : i64
          (compiler-symbols-owner-module-id-at-index-or
            (struct-get hygiene symbols)
            declaration-id
            fallback)]
        ;; A prior expansion can add a flat unqualified alias after a root
        ;; macro declaration. It is output scope, not a definition-site capture.
        (if (and
          (compiler-symbol-root-module-id? module-id)
          (>= (struct-get hygiene declaration-id) 0)
          (> declaration-id (struct-get hygiene declaration-id))
          (intern-generated-id-active? owner-module-id))
          fallback
          owner-module-id)))))

(define (macro-hygiene-global-name-id
  [source-name-id : i64]
  [hygiene : MacroHygieneContext]) : i64
  (let
    [definition-module-id : i64 (struct-get hygiene definition-module-id)]
    [legacy? : bool (= source-name-id (struct-get hygiene macro-name-id))]
    [first-dot : i64 (tc-name-first-dot-id source-name-id)]
    (if (< first-dot 0)
      (let
        [binding-owner-module-id : i64
          (macro-hygiene-binding-owner-module-id-or
            hygiene
            definition-module-id
            source-name-id
            -2)]
        (if (or legacy? (>= binding-owner-module-id -1))
          (macro-hygiene-global-id
            (if legacy?
              definition-module-id
              binding-owner-module-id)
            source-name-id
            legacy?)
          source-name-id))
      (let
        [alias-id : i64 (intern-leading-dot-id source-name-id)]
        [tail-id : i64 (intern-dotted-tail-id source-name-id)]
        [full-module-id : i64 (intern-dotted-prefix-id source-name-id)]
        [final-id : i64 (intern-dotted-final-id source-name-id)]
        [lookup-module-id : i64
          (if (compiler-symbol-root-module-id? definition-module-id)
            cbi.compiler-builtin-id-fix-empty
            definition-module-id)]
        [full-binding-owner-module-id : i64
          (if (or (< full-module-id 0) (< final-id 0))
            -2
            (macro-hygiene-binding-owner-module-id-or
              hygiene
              full-module-id
              final-id
              -2))]
        (if (>= full-binding-owner-module-id -1)
          (macro-hygiene-global-id full-binding-owner-module-id final-id false)
          (if (or (< alias-id 0) (< tail-id 0))
            source-name-id
            (match (tc-lazy-import-stub-target-id lookup-module-id alias-id)
              [(TcMaybeNameId.Some target-module-id)
                (let
                  [binding-owner-module-id : i64
                    (if (< (tc-name-first-dot-id tail-id) 0)
                      (macro-hygiene-binding-owner-module-id-or
                        hygiene
                        target-module-id
                        tail-id
                        target-module-id)
                      target-module-id)]
                  (macro-hygiene-global-id
                    binding-owner-module-id
                    tail-id
                    false))]
              [(TcMaybeNameId.No) source-name-id])))))))

(define (macro-hygiene-rename-var-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (let
    [template-source-id : i64 (tc-hygiene-template-source-id-or name-id -1)]
    [result : i64
      (if (tc-hygiene-template-name-id? name-id)
        (let
          [name : String (intern-str template-source-id)]
          [base : String
            (if (ci.intern-template-source-id? name-id)
              name
              (tc-hygiene-template-base name))]
          [syntax-tag : i64
            (compiler-parse-dispatch-tag-id
              (compiler-parse-dispatch-env)
              template-source-id)]
          (match (macro-hygiene-env-lookup env name-id)
            [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
            [(MacroMaybeHygieneName.No)
              (if (or
                (not (= syntax-tag (compiler-parse-tag-unknown)))
                (= template-source-id cbi.compiler-builtin-id-fix-colon)
                (ci.intern-colon-keyword-id? template-source-id))
                template-source-id
                (let
                  [source-name-id : i64 template-source-id]
                  [leading-id : i64 (intern-leading-dot-id source-name-id)]
                  (if (and
                    (>= leading-id 0)
                    (match (macro-hygiene-env-lookup
                      env
                      (ci.intern-template-source-id leading-id))
                      [(MacroMaybeHygieneName.Some _) true]
                      [(MacroMaybeHygieneName.No) false]))
                    source-name-id
                    (begin
                      (when
                        (< source-name-id 0)
                        (io.panic
                          (string.append
                            "typecheck: missing macro template source id: "
                            base)))
                      (macro-hygiene-global-name-id source-name-id macro-name)))))]))
        name-id)]
    result))

(define (macro-hygiene-bind-name-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [name-id : i64]) : MacroHygieneName
  (let
    [source-name-id : i64 (tc-hygiene-template-source-id-or name-id -1)]
    (if (tc-hygiene-template-name-id? name-id)
      (let
        [renamed-id : i64
          (macro-hygiene-local-id macro-name depth source-name-id)]
        (begin
          (when
            (< source-name-id 0)
            (io.panic "typecheck: missing macro template binding source id"))
          (MacroHygieneName.Name
            renamed-id
            (MacroHygieneEnv.Bind name-id renamed-id (box env)))))
      (MacroHygieneName.Name name-id env))))

(define (macro-hygiene-expr-list
  [exprs : AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : AstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (begin
      (macro-hygiene-expr-list-into (& exprs) 0 env macro-name depth (&mut out))
      out)))

(define (macro-hygiene-expr-list-into
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out AstExprList)]) : unit
  (if (>= index (struct-get exprs len))
    unit
    (begin
      (ast-expr-list-push
        out
        (macro-hygiene-expr
          (ast-node-get (ast-expr-list-get exprs index 0))
          env
          macro-name
          depth))
      (macro-hygiene-expr-list-into exprs (+ index 1) env macro-name depth out))))

(define (macro-hygiene-module-call-args
  [exprs : AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : AstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    [index : i64 0]
    (begin
      (while (< index (struct-get (& exprs) len))
        (begin
          (ast-expr-list-push
            (&mut out)
            (if (= index 0)
              (ast-expr-list-get (& exprs) index 0)
              (macro-hygiene-expr
                (ast-node-get (ast-expr-list-get (& exprs) index 0))
                env
                macro-name
                depth)))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-output-call-env
  [func : AstExpr]
  [args : (& args AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast-expr-unspan func)
    [(AstExpr.Var head-id)
      (let
        [source-head-id : i64
          (tc-hygiene-template-source-id-or head-id head-id)]
        [tag : i64
          (compiler-parse-dispatch-tag-id
            (compiler-parse-dispatch-env)
            source-head-id)]
        [count : i64 (struct-get args len)]
        (cond
          [(= tag (compiler-parse-tag-decl-import))
            (macro-hygiene-output-import-env args env)]
          [(or
              (= tag (compiler-parse-tag-decl-defenum))
              (= tag (compiler-parse-tag-decl-defstruct)))
            (if (> count 0)
              (macro-hygiene-output-aggregate-member-list-env
                args
                1
                (= tag (compiler-parse-tag-decl-defenum))
                (macro-hygiene-output-signature-env
                  (ast-node-get (ast-expr-list-get args 0 0))
                  env))
              env)]
          [(or
              (= tag (compiler-parse-tag-decl-define))
              (= tag (compiler-parse-tag-decl-extern))
              (= tag (compiler-parse-tag-decl-defmacro))
              (= tag (compiler-parse-tag-decl-defdispatch)))
            (if (> count 0)
              (macro-hygiene-output-signature-env
                (ast-node-get (ast-expr-list-get args 0 0))
                env)
              env)]
          [else env]))]
    [_ env]))

(define (macro-hygiene-lifetime-list
  [lifetimes : AstLifetimeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : AstLifetimeList
  (let
    [count : i64 (ast-lifetime-list-len (& lifetimes))]
    [out : AstLifetimeList (ast-lifetime-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (ast-lifetime-list-push
            (&mut out)
            (macro-hygiene-rename-lifetime-id
              env
              macro-name
              (ast-lifetime-list-get
                (& lifetimes)
                index
                (ast-lifetime-fallback))))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-rename-lifetime-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (match (macro-hygiene-env-lookup env name-id)
    [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
    [(MacroMaybeHygieneName.No)
      (if (and (>= name-id 0) (< name-id (intern-capacity)))
        (match (macro-hygiene-env-lookup
          env
          (ci.intern-template-source-id name-id))
          [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
          [(MacroMaybeHygieneName.No)
            (macro-hygiene-rename-var-id env macro-name name-id)])
        (macro-hygiene-rename-var-id env macro-name name-id))]))

(define (macro-hygiene-type-list
  [types : AstTypeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : AstTypeList
  (let
    [count : i64 (ast-type-list-len (& types))]
    [out : AstTypeList (ast-type-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (ast-type-list-push
            (&mut out)
            (ty-node-push
              (macro-hygiene-type
                (ty-node-get
                  (ast-type-list-get (& types) index (ast-type-id-fallback)))
                env
                macro-name)))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-type
  [ty : AstType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : AstType
  (match ty
    [(AstType.Func args ret)
      (ast-ty-func
        (macro-hygiene-type-list (box-get args) env macro-name)
        (macro-hygiene-type (ty-node-get ret) env macro-name))]
    [(AstType.Tuple elems)
      (ast-ty-tuple (macro-hygiene-type-list (box-get elems) env macro-name))]
    [(AstType.Array elem count)
      (ast-ty-array
        (macro-hygiene-type (ty-node-get elem) env macro-name)
        count)]
    [(AstType.DynArray elem)
      (ast-ty-dyn-array (macro-hygiene-type (ty-node-get elem) env macro-name))]
    [(AstType.Box elem)
      (ast-ty-box (macro-hygiene-type (ty-node-get elem) env macro-name))]
    [(AstType.Ptr elem)
      (ast-ty-ptr (macro-hygiene-type (ty-node-get elem) env macro-name))]
    [(AstType.MutPtr elem)
      (ast-ty-mut-ptr (macro-hygiene-type (ty-node-get elem) env macro-name))]
    [(AstType.Ref region inner)
      (ast-ty-ref
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type (ty-node-get inner) env macro-name))]
    [(AstType.MutRef region inner)
      (ast-ty-mut-ref
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type (ty-node-get inner) env macro-name))]
    [(AstType.Region region inner)
      (ast-ty-region
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type (ty-node-get inner) env macro-name))]
    [(AstType.EnumArgs name lifetimes)
      (ast-ty-enum-args
        name
        (macro-hygiene-lifetime-list (box-get lifetimes) env macro-name))]
    [(AstType.StructArgs name lifetimes)
      (ast-ty-struct-args
        name
        (macro-hygiene-lifetime-list (box-get lifetimes) env macro-name))]
    [(AstType.VarArgs name lifetimes)
      (ast-ty-var-args
        name
        (macro-hygiene-lifetime-list (box-get lifetimes) env macro-name))]
    [(AstType.Consume inner)
      (ast-ty-consume (macro-hygiene-type (ty-node-get inner) env macro-name))]
    [_ ty]))

(define (macro-hygiene-maybe-type
  [maybe-ty : AstMaybeType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : AstMaybeType
  (match maybe-ty
    [(AstMaybeType.Some ty)
      (AstMaybeType.Some (macro-hygiene-type ty env macro-name))]
    [(AstMaybeType.No) AstMaybeType.No]))

(define (macro-hygiene-borrow-lifetime
  [lifetime : AstBorrowLifetime]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : AstBorrowLifetime
  (match lifetime
    [(AstBorrowLifetime.Named name)
      (AstBorrowLifetime.Named
        (macro-hygiene-rename-lifetime-id env macro-name name))]
    [(AstBorrowLifetime.Inferred) AstBorrowLifetime.Inferred]))

(define (macro-hygiene-param-list
  [params : AstParamList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (macro-hygiene-param-list-at (& params) 0 env macro-name depth))

(define (macro-hygiene-param-list-at
  [params : (& params AstParamList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (if (>= index (ast-param-list-len params))
    (MacroHygieneParams.Params (ast-param-list-new) env)
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty comptime? consume?)
        (let
          [nty : AstType (macro-hygiene-type ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (match (macro-hygiene-param-list-at
                params
                (+ index 1)
                next-env
                macro-name
                depth)
                [(MacroHygieneParams.Params nrest final-env)
                  (MacroHygieneParams.Params
                    (ast-param-cons
                      (ast-param-id-with-consume
                        renamed-id
                        nty
                        comptime?
                        consume?)
                      nrest)
                    final-env)])]))])))

(define (macro-hygiene-pattern-list
  [patterns : AstPatternList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePatternList
  (let
    [out : AstPatternList
      (ast-pattern-list-with-capacity (struct-get (& patterns) len))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-pattern-list-into
        (& patterns)
        0
        env
        macro-name
        depth
        (&mut out))]
    (MacroHygienePatternList.PatternList out final-env)))

(define (macro-hygiene-pattern-list-into
  [patterns : (& patterns AstPatternList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out AstPatternList)]) : MacroHygieneEnv
  (if (>= index (struct-get patterns len))
    env
    (match (macro-hygiene-pattern
      (ast-pattern-list-get patterns index (ast-pattern-fallback))
      env
      macro-name
      depth)
      [(MacroHygienePattern.Pattern npattern next-env)
        (begin
          (ast-pattern-list-push out npattern)
          (macro-hygiene-pattern-list-into
            patterns
            (+ index 1)
            next-env
            macro-name
            depth
            out))])))

(define (macro-hygiene-pattern
  [pattern : AstPattern]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePattern
  (match pattern
    [(AstPattern.Var name maybe-ty)
      (let
        [nmaybe-ty : AstMaybeType
          (macro-hygiene-maybe-type maybe-ty env macro-name)]
        (match (macro-hygiene-bind-name-id env macro-name depth name)
          [(MacroHygieneName.Name renamed-id next-env)
            (MacroHygienePattern.Pattern
              (AstPattern.Var renamed-id nmaybe-ty)
              next-env)]))]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast-pat-tuple npatterns) next-env)]))]
    [(AstPattern.Wildcard)
      (MacroHygienePattern.Pattern AstPattern.Wildcard env)]
    [(AstPattern.Binding name)
      (let
        [source-name-id : i64 (tc-hygiene-template-source-id-or name name)]
        (if (>= (tc-name-first-dot-id source-name-id) 0)
          (MacroHygienePattern.Pattern
            (ast-pat-binding-id
              (macro-hygiene-rename-var-id env macro-name name))
            env)
          (match (macro-hygiene-env-lookup-pattern-name env name)
            [(MacroMaybeHygieneName.Some pattern-name-id)
              (MacroHygienePattern.Pattern
                (ast-pat-binding-id pattern-name-id)
                env)]
            [(MacroMaybeHygieneName.No)
              (match (macro-hygiene-bind-name-id env macro-name depth name)
                [(MacroHygieneName.Name renamed-id next-env)
                  (MacroHygienePattern.Pattern
                    (ast-pat-binding-id renamed-id)
                    next-env)])])))]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (match (macro-hygiene-pattern-list args env macro-name depth)
          [(MacroHygienePatternList.PatternList nargs next-env)
            (MacroHygienePattern.Pattern
              (ast-pat-variant-id
                (macro-hygiene-rename-var-id env macro-name name)
                nargs)
              next-env)]))]
    [(AstPattern.Literal lit)
      (MacroHygienePattern.Pattern (AstPattern.Literal lit) env)]))

(define (macro-hygiene-let-bindings
  [bindings : AstLetBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneLetBindings
  (let
    [out : AstLetBindingList
      (ast-let-binding-list-with-capacity
        (ast-let-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-let-bindings-into
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneLetBindings.LetBindings out final-env)))

(define (macro-hygiene-let-bindings-into
  [bindings : (& bindings AstLetBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out AstLetBindingList)]) : MacroHygieneEnv
  (if (>= index (ast-let-binding-list-len bindings))
    env
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
          [nmaybe-ty : AstMaybeType
            (macro-hygiene-maybe-type maybe-ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (begin
                (ast-let-binding-list-push
                  out
                  (ast-let-binding-id renamed-id nmaybe-ty ninit))
                (macro-hygiene-let-bindings-into
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-resource-bindings
  [bindings : AstResourceBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneResourceBindings
  (let
    [out : AstResourceBindingList
      (ast-resource-binding-list-with-capacity
        (ast-resource-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-resource-bindings-into
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneResourceBindings.ResourceBindings out final-env)))

(define (macro-hygiene-resource-bindings-into
  [bindings : (& bindings AstResourceBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out AstResourceBindingList)]) : MacroHygieneEnv
  (if (>= index (ast-resource-binding-list-len bindings))
    env
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
          [ncleanup : i64 (macro-hygiene-expr cleanup env macro-name depth)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (begin
                (ast-resource-binding-list-push
                  out
                  (ast-resource-binding-id renamed-id ninit ncleanup))
                (macro-hygiene-resource-bindings-into
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-arm-list
  [arms : AstMatchArmList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : AstMatchArmList
  (let
    [out : AstMatchArmList
      (ast-match-arm-list-with-capacity (struct-get (& arms) len))]
    (begin
      (macro-hygiene-arm-list-into (& arms) 0 env macro-name depth (&mut out))
      out)))

(define (macro-hygiene-arm-list-into
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out AstMatchArmList)]) : unit
  (if (>= index (struct-get arms len))
    unit
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (macro-hygiene-pattern pattern env macro-name depth)
          [(MacroHygienePattern.Pattern npattern arm-env)
            (begin
              (ast-match-arm-list-push
                out
                (ast-match-arm
                  npattern
                  (macro-hygiene-expr
                    (ast-node-get body-box)
                    arm-env
                    macro-name
                    depth)))
              (macro-hygiene-arm-list-into
                arms
                (+ index 1)
                env
                macro-name
                depth
                out))])])))

(define (macro-hygiene-expr
  [expr : AstExpr]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-hygiene-expr inner env macro-name depth) span))]
    [(AstExpr.Var name)
      (ast-node-push
        (AstExpr.Var (macro-hygiene-rename-var-id env macro-name name)))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (ast-expr-binary
          op
          (macro-hygiene-expr left env macro-name depth)
          (macro-hygiene-expr right env macro-name depth)))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-unary op (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        [call-env : MacroHygieneEnv
          (macro-hygiene-output-call-env func (& args) env)]
        (ast-expr-call
          (macro-hygiene-expr func env macro-name depth)
          (match (ast-expr-unspan func)
            [(AstExpr.Var name-id)
              (if (=
                (tc-hygiene-template-source-id-or name-id name-id)
                cbi.compiler-builtin-id-fix-module)
                (macro-hygiene-module-call-args args env macro-name depth)
                (macro-hygiene-expr-list args call-env macro-name depth))]
            [_ (macro-hygiene-expr-list args call-env macro-name depth)])))]
    [(AstExpr.BracketClause items)
      (ast-expr-bracket-clause
        (macro-hygiene-expr-list items env macro-name depth))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (ast-expr-if
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr then-branch env macro-name depth)
          (macro-hygiene-expr else-branch env macro-name depth)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-let-bindings bindings env macro-name depth)
              [(MacroHygieneLetBindings.LetBindings nbindings body-env)
                (ast-expr-let
                  nbindings
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-param-list params env macro-name depth)
              [(MacroHygieneParams.Params nparams body-env)
                (ast-expr-lambda
                  nparams
                  (macro-hygiene-maybe-type maybe-ret body-env macro-name)
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.Tuple exprs)
      (ast-node-push
        (AstExpr.Tuple (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (ast-expr-tuple-ref
          (macro-hygiene-expr tuple-expr env macro-name depth)
          index))]
    [(AstExpr.Array exprs)
      (ast-node-push
        (AstExpr.Array (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.DynArray exprs)
      (ast-node-push
        (AstExpr.DynArray (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.MakeArray ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-make-array
          (macro-hygiene-type ty env macro-name)
          (macro-hygiene-expr len env macro-name depth)))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-array-ref
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-set
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [live : AstExpr (ast-node-get live-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-array-take
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr live env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-push
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.StringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-get text-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-string-ref
          (macro-hygiene-expr text env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (ast-expr-while
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr body env macro-name depth)))]
    [(AstExpr.Begin exprs)
      (ast-node-push
        (AstExpr.Begin (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.Unsafe exprs)
      (ast-node-push
        (AstExpr.Unsafe (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.Set name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        (ast-expr-set-id
          (macro-hygiene-rename-var-id env macro-name name)
          (macro-hygiene-expr rhs env macro-name depth)))]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-ann
          (macro-hygiene-expr inner env macro-name depth)
          (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-cast
          (macro-hygiene-expr inner env macro-name depth)
          (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.Borrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (ast-expr-borrow
          mutable
          (macro-hygiene-borrow-lifetime lifetime env macro-name)
          (macro-hygiene-expr place env macro-name depth)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (ast-expr-match
              (macro-hygiene-expr scrut env macro-name depth)
              (macro-hygiene-arm-list arms env macro-name depth)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id body-env)
                (ast-expr-foreach-id
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id body-env)
                (ast-expr-spmd-reduce-id
                  op
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr init env macro-name depth)
                  (macro-hygiene-expr value body-env macro-name depth))]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id value-env)
                (match (macro-hygiene-bind-name-id
                  value-env
                  macro-name
                  depth
                  prefix)
                  [(MacroHygieneName.Name nprefix-id body-env)
                    (ast-expr-spmd-scan-id
                      op
                      nindex-id
                      (macro-hygiene-type index-ty env macro-name)
                      (macro-hygiene-expr start env macro-name depth)
                      (macro-hygiene-expr end env macro-name depth)
                      nprefix-id
                      (macro-hygiene-type prefix-ty value-env macro-name)
                      (macro-hygiene-expr init env macro-name depth)
                      (macro-hygiene-expr value value-env macro-name depth)
                      (macro-hygiene-expr body body-env macro-name depth))])]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-broadcast
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-shuffle
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-struct-get-id
          (macro-hygiene-expr inner env macro-name depth)
          field))]
    [(AstExpr.StructSet inner-box field value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-struct-set-id
          (macro-hygiene-expr inner env macro-name depth)
          field
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.WithRegion name body)
      (match (macro-hygiene-bind-name-id env macro-name depth name)
        [(MacroHygieneName.Name nname-id body-env)
          (ast-node-push
            (AstExpr.WithRegion
              nname-id
              (macro-hygiene-expr-list body body-env macro-name depth)))])]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (ast-expr-with-escape
          (macro-hygiene-expr scratch env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExpr.WithScratch body)
      (ast-expr-with-scratch
        (macro-hygiene-expr-list body env macro-name depth))]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (ast-expr-in-arena
          (macro-hygiene-expr arena env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (macro-hygiene-resource-bindings bindings env macro-name depth)
            [(MacroHygieneResourceBindings.ResourceBindings nbindings body-env)
              (ast-node-push
                (AstExpr.WithResource
                  (box
                    (AstWithResource.WithResource
                      nbindings
                      (macro-hygiene-expr-list body body-env macro-name depth)))))])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-get (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-take (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-box-set
          (macro-hygiene-expr inner env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.TypeLiteral ty)
      (ast-node-push
        (AstExpr.TypeLiteral (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.Init maybe-ty)
      (ast-expr-init-maybe (macro-hygiene-maybe-type maybe-ty env macro-name))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-comptime (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-return (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-try (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.PtrNull ty)
      (ast-node-push (AstExpr.PtrNull (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.PtrNullCheck ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-null-check (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (ast-expr-ptr-addr-of-id
          (macro-hygiene-expr place env macro-name depth)))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-read (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-ptr-write
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (ast-expr-ptr-offset
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr offset env macro-name depth)))]
    [(AstExpr.PtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-cast
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-to-int (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.IntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-int-to-ptr
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-type ty env macro-name)))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-string-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-string-from-bytes
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr len env macro-name depth)))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-array-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BinaryData bytes) (ast-node-push (AstExpr.BinaryData bytes))]
    [(AstExpr.SpmdProgramIndex) (ast-expr-spmd-program-index)]
    [(AstExpr.SpmdProgramCount) (ast-expr-spmd-program-count)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-eax
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ebx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ecx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-edx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-xgetbv (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.Syscall args)
      (ast-expr-syscall (macro-hygiene-expr-list args env macro-name depth))]
    [(AstExpr.Quote _) (ast-node-push expr)]
    [(AstExpr.Quasiquote _) (ast-node-push expr)]
    [(AstExpr.Unquote _) (ast-node-push expr)]
    [(AstExpr.UnquoteSplicing _) (ast-node-push expr)]
    [_ (ast-node-push expr)]))

(define (macro-expand-depth-limit) : i64
  512)

(define (macro-decl-from-decl
  [decl : AstDecl]
  [module-id : i64]
  [declaration-id : i64]) : MacroMaybeDecl
  (match decl
    [(AstDecl.DefMacro decl-meta name params ret body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (MacroMaybeDecl.Some name module-id declaration-id params ret body))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-from-decl inner module-id declaration-id))]
    [_ (MacroMaybeDecl.No)]))

;; Resolve a macro decl from its symbol-table index in O(1). The symbols decls
;; array is populated (compiler-symbols-index-decl!) at the SAME index that
;; compiler-symbol-handle-index returns: build-compiler-symbol-list-in-module
;; writes the array slot and registers the handle with one shared `index`,
;; skipping the identical Import/IncludeStr/IncludeBin/Export/Module/Test set
;; that the old linear scan skipped. The array already stores the unwrapped decl
;; (compiler-symbol-indexed-decl peels AstDecl.Unsafe the same
;; way macro-decl-from-decl does), so direct module lookups return the identical
;; MacroMaybeDecl.Some the previous O(decls) macro-find-decl-by-index walk produced.
(define (macro-decl-owner-module-or
  [symbols : CompilerSymbols]
  [target : i64]
  [fallback-id : i64]) : i64
  (let
    [module-id : i64
      (compiler-symbols-owner-module-id-at-index-or
        symbols
        target
        (compiler-symbol-root-module-id))]
    (if (compiler-symbol-root-module-id? module-id)
      fallback-id
      module-id)))

;; Imported macro aliases can be looked up from the importing module. In that
;; path, use the indexed owner module so the transformer still runs as its
;; original definition module. The dense declaration ID is carried with it.
(define (macro-decl-at-index-with-owner-module
  [symbols : CompilerSymbols]
  [target : i64]
  [module-id : i64]) : MacroMaybeDecl
  (match (compiler-symbols-decl-at-index symbols target)
    [(ResultAstDecl.Ok decl)
      (macro-decl-from-decl
        decl
        (macro-decl-owner-module-or symbols target module-id)
        target)]
    [(ResultAstDecl.Err _) (MacroMaybeDecl.No)]))

;; The module accumulator and the current module compare as INTERN IDS: the
;; previous String-based walk converted every AstDecl.Module's interned name
;; back to a fresh String (`intern-str` allocates) and string-compared it, for
;; every declaration walked, on every qualified-alias resolution -- 11.6% of
;; the stage2 self-compile CPU profile. Import aliases still compare by
;; content, but only for imports declared in the current module.
(define (macro-import-alias-target-from-spec
  [spec : AstImportSpec]
  [alias-id : i64]) : TcMaybeNameId
  (match spec
    [(AstImportSpec.Spec _ _ expected maybe-alias _)
      (match maybe-alias
        [(AstMaybeImportAlias.Some import-alias)
          (if (= import-alias alias-id)
            (match expected
              [(AstMaybeModuleName.Some target) (TcMaybeNameId.Some target)]
              [(AstMaybeModuleName.No) (TcMaybeNameId.Some alias-id)])
            (TcMaybeNameId.No))]
        [(AstMaybeImportAlias.No) (TcMaybeNameId.No)])]))

(define (macro-import-alias-target-from-wrapped-decl
  [decl : AstDecl]
  [alias-id : i64]) : TcMaybeNameId
  (match (ast-decl-unwrapped decl)
    [(AstDecl.Import decl-meta spec)
      (macro-import-alias-target-from-spec spec alias-id)]
    [_ (TcMaybeNameId.No)]))

(define (macro-import-alias-target-ids
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : TcMaybeNameId
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [slot : i64 (tc-module-decl-index-slot current-module-id)]
    [decl-offset : i64 (struct-get decls offset)]
    [result : TcMaybeNameId (TcMaybeNameId.No)]
    (if (< slot 0)
      result
      (let
        [index : i64 (array-ref tc-module-import-index-starts slot)]
        [end : i64 (array-ref tc-module-import-index-ends slot)]
        [done : bool false]
        (begin
          (while (and (not done) (< index end))
            (let
              [position : i64
                (array-ref tc-module-import-index-positions index)]
              [target : TcMaybeNameId
                (macro-import-alias-target-from-wrapped-decl
                  (array-ref (struct-get decls slots) (+ decl-offset position))
                  alias-id)]
              (begin
                (match target
                  [(TcMaybeNameId.Some target-id)
                    (if (= target-id alias-id)
                      (match result
                        [(TcMaybeNameId.No)
                          (set! result (TcMaybeNameId.Some alias-id))]
                        [_ unit])
                      (begin
                        (set! result (TcMaybeNameId.Some target-id))
                        (set! done true)))]
                  [(TcMaybeNameId.No) unit])
                (set! index (+ index 1)))))
          result)))))

;; --- import-aware macro resolution caches -------------------------------------
;;
;; Qualified-alias lookup and unqualified flat-import lookup both derive from the
;; program's AstDecl.Module/AstDecl.Import declarations. Cache them at the same
;; per-program boundary so generated macro bodies do not repeatedly rescan the
;; whole declaration list.
(defenum MacroFlatImportTargetList
  (Nil)
  (Cons i64 (Box MacroFlatImportTargetList)))

(defenum MacroFlatImportTargetCacheLookup
  (Missing)
  (Hit MacroFlatImportTargetList))

;; Even with id compares, each resolution walks the ENTIRE declaration list
;; (most declarations are neither modules nor imports), and the same
;; (current-module, qualifier) pair resolves identically for the whole
;; program: the mapping is derived only from AstDecl.Module/AstDecl.Import
;; declarations, which macro expansion, comptime generation, and
;; specialization never insert or reorder mid-compile. Memoize per
;; generation (same idiom as the marker name-id memos), open-addressed and
;; keyed by the two intern ids. Module key slots store module-id+1 so the zeroed
;; table is empty; qualifier slots store qualifier-id+1, and values store the
;; resolved target's intern id, -1 for "no alias import", or -3 for an alias
;; definitively resolved to its own qualifier id. The distinct self sentinel
;; prevents every later query from rescanning that module while still allowing
;; a subsequently materialized lazy-import stub to replace it. Inserts stop at
;; half load -- only memoization, never correctness, degrades.
(define macro-alias-cache-capacity : i64
  16384)
(define macro-alias-cache-module-keys : (Array i64)
  (array.make-array i64 16384))
(define macro-alias-cache-qualifier-keys : (Array i64)
  (array.make-array i64 16384))
(define macro-alias-cache-values : (Array i64)
  (array.make-array i64 16384))
(define macro-alias-cache-count : i64
  0)
(define macro-alias-cache-generation : i64
  -1)
(define macro-alias-cache-ready : bool
  false)

;; Eager-index state (see macro-alias-cache-build!): built records that the
;; one-pass index ran for this generation; complete records that every aliased
;; import fit under the half-load insert cap, making a table miss a definitive
;; "no alias import" answer.
(define macro-alias-cache-built : bool
  false)
(define macro-alias-cache-complete : bool
  false)
(define macro-alias-cache-built-decl-count : i64
  -1)
(define macro-alias-cache-built-decl-offset : i64
  -1)
(define macro-alias-cache-built-decl-slots-addr : i64
  -1)
(define macro-alias-cache-built-end-module-id : i64
  -1)
(define macro-unqualified-import-cache-capacity : i64
  65536)
(define macro-unqualified-import-cache-module-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-name-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-values : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-count : i64
  0)
(define macro-unqualified-import-cache-generation : i64
  -1)
(define macro-unqualified-import-cache-ready : bool
  false)
(define macro-flat-import-target-cache-capacity : i64
  1024)
(define macro-flat-import-target-cache-module-keys : (Array i64)
  (array.make-array i64 1024))
(define macro-flat-import-target-cache-values : (Array
    MacroFlatImportTargetList)
  (array.make-array MacroFlatImportTargetList 1024))
(define macro-flat-import-target-cache-count : i64
  0)
(define macro-flat-import-target-cache-generation : i64
  -1)
(define macro-flat-import-target-cache-ready : bool
  false)

;; Eager-index state: built records the one-pass build ran this generation;
;; complete records every module fit under the half-load insert cap, making a
;; table miss a definitive "no flat imports" answer.
(define macro-flat-import-target-cache-built : bool
  false)
(define macro-flat-import-target-cache-complete : bool
  false)
(define macro-flat-import-target-cache-built-decl-count : i64
  -1)
(define macro-flat-import-target-cache-built-decl-offset : i64
  -1)

(define (macro-decl-list-slots-data-addr [decls : AstDeclList]) : i64
  (cast
    (unsafe
      (ptr->int (ptr-cast (array-data (struct-get decls slots)) : (Ptr u8))))
    : i64))

;; The mapping is program-derived, so the cache must not survive into the next
;; program of a multi-program process (smoke batteries, REPL, LSP, package
;; builds). macro-expand-program and the REPL typecheck entry reset it at the
;; same per-program boundary that resets the CTFE-env and clone-able caches;
;; the intern generation gate additionally covers intern-reset! boundaries.
(define (macro-alias-derived-cache-reset!) : unit
  (begin
    (tc-module-decl-index-reset!)
    (tc-program-enum-index-reset!)
    (set! macro-alias-cache-ready false)
    (set! macro-unqualified-import-cache-ready false)
    (set! macro-flat-import-target-cache-ready false)
    (macro-surface-call-decl-cache-reset!)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)
    (tc-imported-module-identity-cache-reset!)))

(define (macro-alias-cache-reset!) : unit
  (macro-alias-derived-cache-reset!))

(define (macro-unqualified-import-cache-ensure!) : unit
  (if (if macro-unqualified-import-cache-ready
    (= macro-unqualified-import-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-unqualified-import-cache-capacity)
          (begin
            (array-set! macro-unqualified-import-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-unqualified-import-cache-count 0)
        (set! macro-unqualified-import-cache-generation (intern-generation))
        (set! macro-unqualified-import-cache-ready true)))))

(define (macro-unqualified-import-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- macro-unqualified-import-cache-capacity 1)))

;; Returns the cached target module id, -1 for "no imported macro", or -2 when
;; absent.
(define (macro-unqualified-import-cache-get [module-id : i64] [name-id : i64]) : i64
  (let
    [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-unqualified-import-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-unqualified-import-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-unqualified-import-cache-name-keys cursor)
                name-key))
              (begin
                (set!
                  out
                  (array-ref macro-unqualified-import-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-unqualified-import-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-unqualified-import-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (if (>=
    (* macro-unqualified-import-cache-count 2)
    macro-unqualified-import-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-unqualified-import-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-unqualified-import-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-unqualified-import-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-unqualified-import-cache-name-keys
                  cursor
                  name-key)
                (array-set! macro-unqualified-import-cache-values cursor value)
                (set!
                  macro-unqualified-import-cache-count
                  (+ macro-unqualified-import-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-unqualified-import-cache-name-keys cursor)
                  name-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-unqualified-import-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-cache-ensure!) : unit
  (if (if macro-flat-import-target-cache-ready
    (= macro-flat-import-target-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-flat-import-target-cache-capacity)
          (begin
            (array-set! macro-flat-import-target-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-flat-import-target-cache-count 0)
        (set! macro-flat-import-target-cache-generation (intern-generation))
        (set! macro-flat-import-target-cache-built false)
        (set! macro-flat-import-target-cache-complete false)
        (set! macro-flat-import-target-cache-ready true)))))

(define (macro-flat-import-target-cache-bucket [module-id : i64]) : i64
  (bit-and
    (* module-id 2654435761)
    (- macro-flat-import-target-cache-capacity 1)))

(define (macro-flat-import-target-cache-get [module-id : i64]) : MacroFlatImportTargetCacheLookup
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [out : MacroFlatImportTargetCacheLookup
      (MacroFlatImportTargetCacheLookup.Missing)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-flat-import-target-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-flat-import-target-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot module-key)
              (begin
                (set!
                  out
                  (MacroFlatImportTargetCacheLookup.Hit
                    (array-ref macro-flat-import-target-cache-values cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-flat-import-target-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-flat-import-target-cache-put!
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (if (>=
    (* macro-flat-import-target-cache-count 2)
    macro-flat-import-target-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
      [module-key : i64 (+ module-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-flat-import-target-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-flat-import-target-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-flat-import-target-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-flat-import-target-cache-values
                  cursor
                  targets)
                (set!
                  macro-flat-import-target-cache-count
                  (+ macro-flat-import-target-cache-count 1))
                (set! done true))
              (if (= slot module-key)
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-flat-import-target-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-list-contains?
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : bool
  (match targets
    [(MacroFlatImportTargetList.Nil) false]
    [(MacroFlatImportTargetList.Cons target rest)
      (if (= target target-id)
        true
        (macro-flat-import-target-list-contains? (box-get rest) target-id))]))

(define (macro-flat-import-target-list-add
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : MacroFlatImportTargetList
  (if (macro-flat-import-target-list-contains? targets target-id)
    targets
    (MacroFlatImportTargetList.Cons target-id (box targets))))

(define (macro-flat-import-target-list-reverse-into
  [targets : MacroFlatImportTargetList]
  [out : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (match targets
    [(MacroFlatImportTargetList.Nil) out]
    [(MacroFlatImportTargetList.Cons target rest)
      (macro-flat-import-target-list-reverse-into
        (box-get rest)
        (MacroFlatImportTargetList.Cons target (box out)))]))

(define (macro-flat-import-target-list-reverse
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (macro-flat-import-target-list-reverse-into
    targets
    (MacroFlatImportTargetList.Nil)))

(define (macro-flat-import-targets-from-list
  [decls : AstDeclList]
  [current-module-id : i64]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (let
    [index : i64 0]
    [count : i64 (ast-decl-list-len (& decls))]
    [decl-offset : i64 (struct-get decls offset)]
    [cur-module-id : i64 module-id]
    [cur-targets : MacroFlatImportTargetList targets]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref (struct-get decls slots) (+ decl-offset index))]
          (begin
            (match (ast-decl-unwrapped decl)
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [(AstDecl.Import
                  decl-meta
                  (AstImportSpec.Spec _ _ expected maybe-alias _))
                (match maybe-alias
                  [(AstMaybeImportAlias.Some alias)
                    (if (and
                      (= cur-module-id current-module-id)
                      (= alias cbi.compiler-builtin-id-fix-empty))
                      (match expected
                        [(AstMaybeModuleName.Some target-module)
                          (if (= target-module current-module-id)
                            unit
                            (set!
                              cur-targets
                              (macro-flat-import-target-list-add
                                cur-targets
                                target-module)))]
                        [(AstMaybeModuleName.No) unit])
                      unit)]
                  [(AstMaybeImportAlias.No) unit])]
              [_ unit])
            (set! index (+ index 1)))))
      (macro-flat-import-target-list-reverse cur-targets))))

;; Overwrite the stored list for a module id already present in the table
;; (macro-flat-import-target-cache-put! keeps existing entries untouched).
(define (macro-flat-import-target-cache-overwrite!
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-flat-import-target-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-flat-import-target-cache-module-keys cursor)]
          (if (= slot module-key)
            (begin
              (array-set! macro-flat-import-target-cache-values cursor targets)
              (set! done true))
            (if (= slot 0)
              (set! done true)
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-flat-import-target-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      unit)))

;; One-pass eager build of every module's flat-import target list. Each
;; per-module cache miss used to rescan the ENTIRE declaration list (with a
;; ~100B AstDecl unwrap copy per declaration), and the cache resets at every
;; in-pass splice rebuild, so a self-compile re-paid those whole-program scans
;; per module per epoch. Lists are accumulated newest-first in program order
;; and reversed on store, matching macro-flat-import-targets-from-list's
;; add-then-reverse order exactly. If the table's half-load insert cap is hit,
;; complete stays false and misses fall back to the exact scan, so only
;; memoization -- never correctness -- degrades.
(define (macro-flat-import-target-cache-build! [decls : AstDeclList]) : unit
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [decl-offset : i64 (struct-get decls offset)]
    [decl-slots : (Array AstDecl) (struct-get decls slots)]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [truncated : bool false]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (match (ast-decl-unwrapped (array-ref decl-slots (+ decl-offset i)))
            [(AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(AstDecl.Import
                decl-meta
                (AstImportSpec.Spec _ _ expected maybe-alias _))
              (match maybe-alias
                [(AstMaybeImportAlias.Some alias)
                  (if (= alias cbi.compiler-builtin-id-fix-empty)
                    (match expected
                      [(AstMaybeModuleName.Some target-module)
                        (if (= target-module cur-module-id)
                          unit
                          (match (macro-flat-import-target-cache-get
                            cur-module-id)
                            [(MacroFlatImportTargetCacheLookup.Hit existing)
                              (macro-flat-import-target-cache-overwrite!
                                cur-module-id
                                (macro-flat-import-target-list-add
                                  existing
                                  target-module))]
                            [(MacroFlatImportTargetCacheLookup.Missing)
                              (if (>=
                                (* macro-flat-import-target-cache-count 2)
                                macro-flat-import-target-cache-capacity)
                                (set! truncated true)
                                (macro-flat-import-target-cache-put!
                                  cur-module-id
                                  (macro-flat-import-target-list-add
                                    (MacroFlatImportTargetList.Nil)
                                    target-module)))]))]
                      [(AstMaybeModuleName.No) unit])
                    unit)]
                [(AstMaybeImportAlias.No) unit])]
            [_ unit])
          (set! i (+ i 1))))
      ;; Reverse each accumulated list into program order.
      (set! i 0)
      (while (< i macro-flat-import-target-cache-capacity)
        (begin
          (if (= (array-ref macro-flat-import-target-cache-module-keys i) 0)
            unit
            (array-set!
              macro-flat-import-target-cache-values
              i
              (macro-flat-import-target-list-reverse
                (array-ref macro-flat-import-target-cache-values i))))
          (set! i (+ i 1))))
      (set! macro-flat-import-target-cache-built true)
      (set!
        macro-flat-import-target-cache-built-decl-count
        (ast-decl-list-len (& decls)))
      (set!
        macro-flat-import-target-cache-built-decl-offset
        (struct-get decls offset))
      (set! macro-flat-import-target-cache-complete (not truncated)))))

(define (macro-flat-import-targets
  [decls : AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (begin
    (macro-flat-import-target-cache-ensure!)
    (if macro-flat-import-target-cache-built
      unit
      (macro-flat-import-target-cache-build! decls))
    (match (macro-flat-import-target-cache-get current-module-id)
      [(MacroFlatImportTargetCacheLookup.Hit targets) targets]
      [(MacroFlatImportTargetCacheLookup.Missing)
        (if (and
          macro-flat-import-target-cache-complete
          (=
            macro-flat-import-target-cache-built-decl-count
            (ast-decl-list-len (& decls)))
          (=
            macro-flat-import-target-cache-built-decl-offset
            (struct-get decls offset)))
          (MacroFlatImportTargetList.Nil)
          (let
            [targets : MacroFlatImportTargetList
              (macro-flat-import-targets-from-list
                decls
                current-module-id
                cbi.compiler-builtin-id-fix-empty
                (MacroFlatImportTargetList.Nil))]
            (begin
              (macro-flat-import-target-cache-put! current-module-id targets)
              targets)))])))

(define (macro-alias-cache-ensure!) : unit
  (if (if macro-alias-cache-ready
    (= macro-alias-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-alias-cache-capacity)
          (begin
            (array-set! macro-alias-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-alias-cache-count 0)
        (set! macro-alias-cache-generation (intern-generation))
        (set! macro-alias-cache-built false)
        (set! macro-alias-cache-complete false)
        (set! macro-alias-cache-ready true)))))

(define (macro-alias-cache-bucket [module-id : i64] [qualifier-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) qualifier-id)
    (- macro-alias-cache-capacity 1)))

;; Returns the cached value for `(module-id, qualifier-id)`, or -2 when absent.
(define (macro-alias-cache-get [module-id : i64] [qualifier-id : i64]) : i64
  (let
    [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
    [module-key : i64 (+ module-id 1)]
    [qualifier-key : i64 (+ qualifier-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-alias-cache-capacity))
        (let
          [slot : i64 (array-ref macro-alias-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-alias-cache-qualifier-keys cursor)
                qualifier-key))
              (begin
                (set! out (array-ref macro-alias-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-alias-cache-put!
  [module-id : i64]
  [qualifier-id : i64]
  [value : i64]) : unit
  (if (>= (* macro-alias-cache-count 2) macro-alias-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
      [module-key : i64 (+ module-id 1)]
      [qualifier-key : i64 (+ qualifier-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-alias-cache-capacity))
          (let
            [slot : i64 (array-ref macro-alias-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set! macro-alias-cache-module-keys cursor module-key)
                (array-set!
                  macro-alias-cache-qualifier-keys
                  cursor
                  qualifier-key)
                (array-set! macro-alias-cache-values cursor value)
                (set! macro-alias-cache-count (+ macro-alias-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-alias-cache-qualifier-keys cursor)
                  qualifier-key))
                (begin
                  (let
                    [existing : i64 (array-ref macro-alias-cache-values cursor)]
                    (if (and
                      (or (= value -3) (>= value 0))
                      (or (< existing 0) (= existing qualifier-id))
                      (not (= value existing)))
                      (array-set! macro-alias-cache-values cursor value)
                      unit))
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-alias-cache-index-range!
  [decls : AstDeclList]
  [start : i64]
  [count : i64]
  [start-module-id : i64]) : i64
  (let
    [decl-offset : i64 (struct-get decls offset)]
    [decl-slots : (Array AstDecl) (struct-get decls slots)]
    [cur-module-id : i64 start-module-id]
    [i : i64 start]
    (begin
      (while (< i count)
        (begin
          (match (ast-decl-unwrapped (array-ref decl-slots (+ decl-offset i)))
            [(AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(AstDecl.Import
                decl-meta
                (AstImportSpec.Spec _ _ expected maybe-alias _))
              (match maybe-alias
                [(AstMaybeImportAlias.Some alias)
                  (let
                    [target-id : i64
                      (match expected
                        [(AstMaybeModuleName.Some target) target]
                        [(AstMaybeModuleName.No) alias])]
                    (if (>=
                      (* macro-alias-cache-count 2)
                      macro-alias-cache-capacity)
                      (set! macro-alias-cache-complete false)
                      (macro-alias-cache-put! cur-module-id alias target-id)))]
                [(AstMaybeImportAlias.No) unit])]
            [_ unit])
          (set! i (+ i 1))))
      cur-module-id)))

;; One-pass eager index over the program's aliased imports: record every
;; (module, alias) -> target mapping in program order (first import wins,
;; matching macro-import-alias-target-ids' first-match scan). Each per-pair
;; cache miss used to rescan the ENTIRE declaration list -- and the cache is
;; reset at every in-pass splice rebuild, so a self-compile re-paid those
;; whole-program scans (with a ~100B AstDecl unwrap copy per declaration)
;; hundreds of times. One pass makes every later query O(1); if the table's
;; half-load insert cap is ever hit, complete stays false and misses fall back
;; to the exact scan, so only memoization -- never correctness -- degrades.
(define (macro-alias-cache-build! [decls : AstDeclList]) : unit
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    (begin
      (set! macro-alias-cache-complete true)
      (set!
        macro-alias-cache-built-end-module-id
        (macro-alias-cache-index-range!
          decls
          0
          count
          cbi.compiler-builtin-id-fix-empty))
      (set! macro-alias-cache-built true)
      (set! macro-alias-cache-built-decl-count count)
      (set! macro-alias-cache-built-decl-offset (struct-get decls offset))
      (set!
        macro-alias-cache-built-decl-slots-addr
        (macro-decl-list-slots-data-addr decls)))))

;; Macro expansion appends generated declarations to the active program view.
;; Keep the eager index synchronized once per larger view. When the backing
;; array is stable, consume only the new tail. Growth may reallocate the list;
;; in that case rebuild the index once over the replacement view rather than
;; making every later miss rescan it. Smaller/offset views remain transient and
;; retain the exact fallback below.
(define (macro-alias-cache-adopt-larger-view! [decls : AstDeclList]) : unit
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    (if (and
      (= macro-alias-cache-built-decl-offset (struct-get decls offset))
      (> count macro-alias-cache-built-decl-count))
      (if (=
        macro-alias-cache-built-decl-slots-addr
        (macro-decl-list-slots-data-addr decls))
        (begin
          (set!
            macro-alias-cache-built-end-module-id
            (macro-alias-cache-index-range!
              decls
              macro-alias-cache-built-decl-count
              count
              macro-alias-cache-built-end-module-id))
          (set! macro-alias-cache-built-decl-count count))
        (begin
          (set! macro-alias-cache-ready false)
          (macro-alias-cache-ensure!)
          (macro-alias-cache-build! decls)))
      unit)))

(define (macro-import-alias-target-cached-id
  [decls : AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeNameId
  (begin
    (macro-alias-cache-ensure!)
    (if macro-alias-cache-built
      unit
      (macro-alias-cache-build! decls))
    (macro-alias-cache-adopt-larger-view! decls)
    (let
      [cached : i64 (macro-alias-cache-get current-module-id qualifier-id)]
      (cond
        [(= cached -3)
          (match (tc-lazy-import-stub-target-indexed
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No) (TcMaybeNameId.Some qualifier-id)])]
        [(= cached -2)
          (match (tc-lazy-import-stub-target-indexed
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No)
              (match (macro-import-alias-target-ids
                decls
                current-module-id
                qualifier-id
                cbi.compiler-builtin-id-fix-empty)
                [(TcMaybeNameId.Some target-id)
                  (begin
                    (macro-alias-cache-put!
                      current-module-id
                      qualifier-id
                      (if (= target-id qualifier-id)
                        -3
                        target-id))
                    (TcMaybeNameId.Some target-id))]
                [(TcMaybeNameId.No)
                  (begin
                    (macro-alias-cache-put! current-module-id qualifier-id -1)
                    (TcMaybeNameId.No))])])]
        [(< cached 0) (TcMaybeNameId.No)]
        [(= cached qualifier-id)
          (match (tc-lazy-import-stub-target-indexed
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No)
              (match (macro-import-alias-target-ids
                decls
                current-module-id
                qualifier-id
                cbi.compiler-builtin-id-fix-empty)
                [(TcMaybeNameId.Some target-id)
                  (begin
                    (macro-alias-cache-put!
                      current-module-id
                      qualifier-id
                      (if (= target-id qualifier-id)
                        -3
                        target-id))
                    (TcMaybeNameId.Some target-id))]
                [(TcMaybeNameId.No)
                  (begin
                    (macro-alias-cache-put! current-module-id qualifier-id -3)
                    (TcMaybeNameId.Some cached))])])]
        [else (TcMaybeNameId.Some cached)]))))

(define (macro-resolve-qualified-module-id
  [decls : AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : i64
  (match (macro-import-alias-target-cached-id
    decls
    current-module-id
    qualifier-id)
    [(TcMaybeNameId.Some target-id) target-id]
    [(TcMaybeNameId.No) qualifier-id]))

(define (macro-missing-macro-message [name : String]) : String
  (string.append "typecheck: missing macro " name))

(define (macro-source-module-id [module-id : i64]) : i64
  (if (compiler-symbol-root-module-id? module-id)
    cbi.compiler-builtin-id-fix-empty
    module-id))

(define (macro-decl-module-display [module-id : i64]) : String
  (if (compiler-symbol-root-module-id? module-id)
    ""
    (intern-str module-id)))

(define (macro-decl-name-display [name-id : i64] [module-id : i64]) : String
  (compiler-symbol-module-key
    (macro-decl-module-display module-id)
    (intern-str name-id)))

(define (macro-qualified-call-decl-in-module
  [ctx : TcContext]
  [target-module-id : i64]
  [base-id : i64]
  [name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [macro-handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        base-id
        (compiler-symbols-missing-handle))]
    ;; A macro that exists in the target module resolves directly from the
    ;; symbol table.
    (if (compiler-symbols-handle-found? macro-handle)
      (match (macro-decl-at-index-with-owner-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index macro-handle)
        target-module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (ResultMacroCallDecl.Err
            (box
              (ctfe-diagnostic-at-expr
                call-expr
                (macro-missing-macro-message name))))])
      (match (macro-surface-call-decl-in-module target-module-id base-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (if (compiler-symbols-handle-found?
            (compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              target-module-id
              base-id
              (compiler-symbols-missing-handle)))
            (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))
            (ResultMacroCallDecl.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  (macro-missing-macro-message name)))))]))))

(define (macro-qualified-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [hygiene-source-id : i64
      (macro-hygiene-global-source-name-id-or source-name-id source-name-id)]
    [source-id : i64 hygiene-source-id]
    [lookup-qualifier-id : i64 (tc-qualified-name-module-id lookup-name-id)]
    [source-qualifier-id : i64 (tc-qualified-name-module-id source-id)]
    [qualifier-id : i64
      (if (>= lookup-qualifier-id 0)
        lookup-qualifier-id
        (if (>= source-qualifier-id 0)
          source-qualifier-id
          definition-module-id))]
    [base-id : i64 (tc-qualified-name-base-id lookup-name-id)]
    (if (and (>= qualifier-id 0) (>= base-id 0))
      (let
        [target-module-id : i64
          (macro-resolve-qualified-module-id
            decls
            (tc-context-module-id ctx)
            qualifier-id)]
        (macro-qualified-call-decl-in-module
          ctx
          target-module-id
          base-id
          name
          call-expr))
      (ResultMacroCallDecl.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            (string.append "typecheck: qualified macro has no source id: " name)))))))

;; The implicit core macro prelude module (stdlib/core_macros.tl). A bare name
;; that is not bound as a macro in the current module falls back to this module's
;; available macros, so `and`/`or`/`when`/`unless`/`cond` resolve without an
;; explicit import. Local macros and explicit imports therefore take
;; precedence over the prelude. Returns MacroMaybeDecl.No (an ordinary call, not an
;; error) when the name is not a prelude macro, leaving plain calls unaffected.
(define (macro-prelude-resolve-module
  [symbols : CompilerSymbols]
  [module-id : i64]
  [lookup-id : i64]) : ResultMacroCallDecl
  ;; The implicit core_macros prelude resolves its macros straight from the
  ;; module's symbol table. core_macros declares exactly the prelude macros, so
  ;; this resolves the same set (`and`, `or`, `when`, `unless`, `cond`).
  (let
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        symbols
        module-id
        lookup-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        symbols
        (compiler-symbol-handle-index handle)
        module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (ResultMacroCallDecl.Ok (MacroMaybeDecl.No)))))

(define (macro-prelude-resolve [symbols : CompilerSymbols] [lookup-id : i64]) : ResultMacroCallDecl
  (match (macro-prelude-resolve-module
    symbols
    cbi.compiler-builtin-id-core-macros-module
    lookup-id)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          ;; Compatibility fallback for sources loaded with the old module
          ;; identity before the core_macros spelling migration.
          (macro-prelude-resolve-module
            symbols
            cbi.compiler-builtin-id-core-macros-legacy-module
            lookup-id)]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-prelude-call-decl
  [ctx : TcContext]
  [_decls : AstDeclList]
  [lookup-name-id : i64]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-prelude-resolve (tc-context-symbols ctx) lookup-name-id))

(define (macro-refresh-stdlib-result-surface-if-needed!
  [ctx : TcContext]
  [target-module-id : i64]
  [target-module : String]
  [lookup-name : String]) : unit
  (if (and
    (string.eq target-module "stdlib.result")
    (string.eq lookup-name "result"))
    (match (compiler-load-surface-summary-find-module target-module-id)
      [(CompilerLoadSomeSurfaceSummary summary)
        (begin
          (compiler-load-surface-summary-refresh-with-pools
            (struct-get summary source-path)
            (struct-get summary source-path-id)
            (svec.new)
            (AstMaybeModuleName.Some target-module-id)
            "stdlib"
            (compiler-cfg-empty)
            (tc-context-pools ctx))
          ;; The surface parser pushes through the explicit context. The retry below
          ;; reads the retained body through ast-node-get, so publish that updated
          ;; context before materializing the macro declaration.
          (tc-context-install-pools! ctx)
          (macro-surface-call-decl-cache-reset!))]
      [(CompilerLoadNoSurfaceSummary) unit])
    unit))

(define (macro-unqualified-imported-target-call-decl
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [target-module : String (intern-str target-module-id)]
    [lookup-name : String (intern-str lookup-name-id)]
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        lookup-name-id
        (compiler-symbols-missing-handle))]
    ;; Resolve an imported macro that exists in the target module directly from
    ;; the symbol table.
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        target-module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module target-module-id lookup-name-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (begin
            (macro-refresh-stdlib-result-surface-if-needed!
              ctx
              target-module-id
              target-module
              lookup-name)
            (match (macro-surface-call-decl-in-module
              target-module-id
              lookup-name-id)
              [(MacroMaybeDecl.Some
                  retry-name
                  retry-module
                  retry-declaration-id
                  retry-params
                  retry-ret
                  retry-body)
                (ResultMacroCallDecl.Ok
                  (MacroMaybeDecl.Some
                    retry-name
                    retry-module
                    retry-declaration-id
                    retry-params
                    retry-ret
                    retry-body))]
              [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))]))))

(define (macro-unqualified-imported-call-target
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : i64
  ;; Any macro present in the target module is a resolution candidate.
  (if (compiler-symbols-handle-found?
    (compiler-symbols-lookup-macro-in-module-id-or
      (tc-context-symbols ctx)
      target-module-id
      lookup-name-id
      (compiler-symbols-missing-handle)))
    target-module-id
    (if (macro-surface-macro-in-module?
      (intern-str target-module-id)
      (intern-str lookup-name-id))
      target-module-id
      -1)))

(define (macro-unqualified-imported-call-target-from-imports
  [ctx : TcContext]
  [targets : MacroFlatImportTargetList]
  [lookup-name-id : i64]) : i64
  (match targets
    [(MacroFlatImportTargetList.Nil) -1]
    [(MacroFlatImportTargetList.Cons target-module-id rest-box)
      (let
        [target : i64
          (macro-unqualified-imported-call-target
            ctx
            target-module-id
            lookup-name-id)]
        (if (= target -1)
          (macro-unqualified-imported-call-target-from-imports
            ctx
            (box-get rest-box)
            lookup-name-id)
          target))]))

(define (macro-unqualified-imported-call-decl-from-target
  [ctx : TcContext]
  [target : i64]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (>= target 0)
    (macro-unqualified-imported-target-call-decl
      ctx
      target
      lookup-name-id
      call-expr)
    (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))))

(define (macro-unqualified-imported-call-decl-cached
  [ctx : TcContext]
  [decls : AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (begin
    (macro-unqualified-import-cache-ensure!)
    (let
      [cached : i64
        (macro-unqualified-import-cache-get module-id lookup-name-id)]
      [target : i64
        (if (= cached -2)
          (let
            [resolved : i64
              (macro-unqualified-imported-call-target-from-imports
                ctx
                (macro-flat-import-targets decls module-id)
                lookup-name-id)]
            (begin
              (macro-unqualified-import-cache-put!
                module-id
                lookup-name-id
                resolved)
              resolved))
          cached)]
      (macro-unqualified-imported-call-decl-from-target
        ctx
        target
        lookup-name-id
        call-expr))))

(define (macro-unqualified-imported-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-imported-call-decl-cached
    ctx
    decls
    module-id
    lookup-name-id
    call-expr))

(define (macro-alias-self-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  ;; `(import stdlib.vector)` binds alias `vector`; module-scope `(vector T)`
  ;; should resolve to macro `vector` in that aliased module.
  (match (tc-source-dotted-alias-target-id decls module-id lookup-name-id)
    [(TcMaybeNameId.Some target-module-id)
      (macro-unqualified-imported-target-call-decl
        ctx
        target-module-id
        lookup-name-id
        call-expr)]
    [(TcMaybeNameId.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-unqualified-call-decl-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [_ : String]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        module-id
        lookup-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module module-id lookup-name-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (match (macro-unqualified-imported-call-decl
            ctx
            decls
            module-id
            lookup-name-id
            call-expr)
            [(ResultMacroCallDecl.Ok imported-decl)
              (match imported-decl
                [(MacroMaybeDecl.No)
                  (macro-prelude-call-decl
                    (tc-context-with-module-id ctx module module-id)
                    decls
                    lookup-name-id
                    call-expr)]
                [_ (ResultMacroCallDecl.Ok imported-decl)])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)])]))))

(define (macro-call-decl-from-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [slash : i64 (tc-qualified-name-last-slash lookup-name)]
    (if (and (> slash 0) (< slash (- (string.string-length lookup-name) 1)))
      (macro-qualified-call-decl
        (tc-context-with-module-id ctx module module-id)
        decls
        lookup-name
        lookup-name-id
        source-name-id
        definition-module-id
        call-expr)
      (macro-unqualified-call-decl-in-module
        ctx
        decls
        module
        module-id
        lookup-name
        lookup-name-id
        call-expr))))

(define (macro-call-decl-from-source-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (tc-source-legacy-core-macro-compat? lookup-name)
    (macro-call-decl-from-name
      ctx
      decls
      module
      module-id
      lookup-name
      lookup-name-id
      lookup-name-id
      -1
      call-expr)
    (let
      [source-ctx : TcContext
        (tc-context-with-program
          (tc-context-with-module-id ctx module module-id)
          (ast-program decls))]
      (match (tc-source-type-name-lookup-from-id
        source-ctx
        lookup-name
        lookup-name-id)
        [(TcNameLookup.Ok resolved-name resolved-id)
          (macro-call-decl-from-name
            ctx
            decls
            module
            module-id
            resolved-name
            resolved-id
            lookup-name-id
            -1
            call-expr)]
        [(TcNameLookup.Err message)
          (ResultMacroCallDecl.Err
            (box (ctfe-diagnostic-at-expr call-expr message)))]))))

(define (macro-call-decl-from-hygiene-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [definition-module : String]
  [definition-module-id : i64]
  [lookup-name : String]
  [lookup-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (< lookup-id 0)
    (ResultMacroCallDecl.Err
      (box
        (ctfe-diagnostic-at-expr
          call-expr
          (string.append
            "typecheck: macro hygiene source id unavailable: "
            lookup-name))))
    (if (and
      (>= (tc-name-first-dot-id lookup-id) 0)
      (not (tc-name-qualified-id? lookup-id))
      (< (tc-qualified-name-last-slash lookup-name) 0))
      (macro-call-decl-from-source-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        call-expr)
      (macro-call-decl-from-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        lookup-id
        definition-module-id
        call-expr))))

;; If `func` names a visible macro, return that macro's decl. Bare local macros
;; are module-scope visible regardless of source order; qualified macro calls
;; must pass the export table. A bare name not bound locally falls back to the
;; implicit core macro prelude.
(define (macro-call-decl
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match func
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(AstExpr.Var name)
      (if (or
        (compiler-composite-pair-key-id? name)
        (compiler-composite-triple-key-id? name))
        (macro-call-decl-from-name
          ctx
          decls
          (tc-context-module ctx)
          (macro-source-module-id (tc-context-module-id ctx))
          (tc-nominal-name-id-display name)
          name
          name
          -1
          call-expr)
        (if (tc-hygiene-global-name-id? name)
          (if (macro-hygiene-global-id? name)
            (let
              [module-id : i64 (macro-hygiene-global-module-id name)]
              [lookup-name-id : i64
                (macro-hygiene-global-source-name-id-or name -1)]
              (macro-call-decl-from-hygiene-name
                ctx
                decls
                (macro-decl-module-display module-id)
                (macro-source-module-id module-id)
                (intern-str lookup-name-id)
                lookup-name-id
                call-expr))
            (match (tc-hygiene-global-decode (tc-env-key-name-text name))
              [(TcHygieneGlobalName.Legacy lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  (tc-context-module ctx)
                  (macro-source-module-id (intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or name -1)
                  call-expr)]
              [(TcHygieneGlobalName.Context module lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  module
                  (macro-source-module-id (intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or name -1)
                  call-expr)]))
          (macro-call-decl-from-source-name
            ctx
            decls
            (tc-context-module ctx)
            (macro-source-module-id (tc-context-module-id ctx))
            (tc-hygiene-name-text-id name)
            name
            call-expr)))]
    [_ (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-call-decl-with-self-alias
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match (macro-call-decl
    (tc-context-with-module-id ctx module module-id)
    func
    decls
    call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match (ast-expr-unspan func)
            [(AstExpr.Var name)
              (if (or
                (macro-hygiene-global-id? name)
                (tc-structural-local-name-id? name)
                (compiler-composite-pair-key-id? name)
                (compiler-composite-triple-key-id? name)
                (tc-name-qualified-id? name))
                (ResultMacroCallDecl.Ok maybe-decl)
                (let
                  [lookup-name : String (tc-env-key-name-text name)]
                  (if (or
                    (tc-hygiene-global-name? lookup-name)
                    (>= (tc-name-first-dot-id name) 0))
                    (ResultMacroCallDecl.Ok maybe-decl)
                    (macro-alias-self-call-decl
                      ctx
                      decls
                      module-id
                      name
                      call-expr))))]
            [_ (ResultMacroCallDecl.Ok maybe-decl)])]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-call-decl-with-context
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [context : AstMaybeModuleName]
  [call-expr : AstExpr]) : ResultMacroCallDeclModule
  (match (macro-call-decl-with-self-alias
    ctx
    func
    decls
    module
    module-id
    call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match context
            [(AstMaybeModuleName.Some context-module-id)
              (let
                [context-module : String (intern-str context-module-id)]
                (if (= context-module-id module-id)
                  (ResultMacroCallDeclModule.Ok maybe-decl module module-id)
                  (match (macro-call-decl-with-self-alias
                    ctx
                    func
                    decls
                    context-module
                    context-module-id
                    call-expr)
                    [(ResultMacroCallDecl.Ok context-decl)
                      (match context-decl
                        [(MacroMaybeDecl.No)
                          (ResultMacroCallDeclModule.Ok
                            maybe-decl
                            module
                            module-id)]
                        [_
                          (ResultMacroCallDeclModule.Ok
                            context-decl
                            context-module
                            context-module-id)])]
                    [(ResultMacroCallDecl.Err diag)
                      (ResultMacroCallDeclModule.Err diag)])))]
            [(AstMaybeModuleName.No)
              (ResultMacroCallDeclModule.Ok maybe-decl module module-id)])]
        [_ (ResultMacroCallDeclModule.Ok maybe-decl module module-id)])]
    [(ResultMacroCallDecl.Err primary-diag)
      (match context
        [(AstMaybeModuleName.Some context-module-id)
          (let
            [context-module : String (intern-str context-module-id)]
            (if (= context-module-id module-id)
              (ResultMacroCallDeclModule.Err primary-diag)
              (match (macro-call-decl-with-self-alias
                ctx
                func
                decls
                context-module
                context-module-id
                call-expr)
                [(ResultMacroCallDecl.Ok context-decl)
                  (match context-decl
                    [(MacroMaybeDecl.No)
                      (ResultMacroCallDeclModule.Err primary-diag)]
                    [_
                      (ResultMacroCallDeclModule.Ok
                        context-decl
                        context-module
                        context-module-id)])]
                [(ResultMacroCallDecl.Err _)
                  (ResultMacroCallDeclModule.Err primary-diag)])))]
        [(AstMaybeModuleName.No) (ResultMacroCallDeclModule.Err primary-diag)])]))

(define (macro-operand-mismatch-message [expected : AstType] [actual : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got "
    (tc-type-render actual)))

(define (macro-clause-shape-message) : String
  "typecheck: ExprClause macro operand expects bracket clause [expr expr]")

(define (macro-binding-clause-shape-message) : String
  "typecheck: ExprBindingClause macro operand expects bracket clause [name expr] or [name : Type expr]")

(define (macro-clause-operand-mismatch-message [expected : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got bracket clause"))

(define (macro-type-arg-module-qualify-id [ctx : TcContext] [name : i64]) : i64
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (macro-hygiene-global-id? name))
      (not (tc-structural-local-name-id? name))
      (not (compiler-composite-pair-key-id? name))
      (not (compiler-composite-triple-key-id? name))
      (not (tc-name-qualified-id? name))
      (not (tc-source-slash-qualified-id? (tc-env-key-name-text name) name)))
      (tc-module-name-id-by-id (tc-context-module-id ctx) name)
      name)))

(define (macro-type-arg-module-qualify-list
  [ctx : TcContext]
  [types : AstTypeList]) : AstTypeList
  (macro-type-arg-module-qualify-list-at ctx (& types) 0))

(define (macro-type-arg-module-qualify-list-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (macro-type-arg-module-qualify
        ctx
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (macro-type-arg-module-qualify-list-at ctx types (+ index 1)))))

(define (macro-type-arg-module-qualify [ctx : TcContext] [ty : AstType]) : AstType
  (match ty
    [(AstType.Func args ret)
      (ast-ty-func
        (macro-type-arg-module-qualify-list ctx (box-get args))
        (macro-type-arg-module-qualify ctx (ty-node-get ret)))]
    [(AstType.Tuple elems)
      (ast-ty-tuple (macro-type-arg-module-qualify-list ctx (box-get elems)))]
    [(AstType.Array elem len)
      (ast-ty-array (macro-type-arg-module-qualify ctx (ty-node-get elem)) len)]
    [(AstType.DynArray elem)
      (ast-ty-dyn-array (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Box elem)
      (ast-ty-box (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Ptr elem)
      (ast-ty-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.MutPtr elem)
      (ast-ty-mut-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Ref region inner)
      (ast-ty-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.MutRef region inner)
      (ast-ty-mut-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.Region region inner)
      (ast-ty-region
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.Var name)
      (AstType.Var (macro-type-arg-module-qualify-id ctx name))]
    [(AstType.VarArgs name lifetimes)
      (ast-ty-var-args
        (macro-type-arg-module-qualify-id ctx name)
        (box-get lifetimes))]
    [_ ty]))

(define (macro-type-arg-reflections-from-decls [decls : AstDeclList]) : CtfeReflectInfoList
  (begin
    (ctfe-build-seen-reset!)
    (ctfe-reflections-from-decls
      decls
      ""
      cbi.compiler-builtin-id-fix-empty
      (ctfe-reflect-info-list-with-capacity (ctfe-metadata-decl-capacity decls)))))

(define (macro-type-arg-reflect-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [infos : CtfeReflectInfoList (macro-type-arg-reflections-from-decls decls)]
    [reflected : AstType
      (ctfe-reflect-resolve-type-with-pools (tc-context-pools ctx) infos ty)]
    (if (tc-type-needs-resolution? reflected)
      (let
        [qualified-reflected : AstType
          (ctfe-reflect-resolve-type-with-pools
            (tc-context-pools ctx)
            infos
            (macro-type-arg-module-qualify ctx reflected))]
        (if (tc-type-needs-resolution? qualified-reflected)
          reflected
          qualified-reflected))
      reflected)))

(define (macro-type-arg-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (if (tc-type-needs-resolution? resolved)
      (let
        [reflected : AstType
          (macro-type-arg-reflect-resolve ctx decls resolved)]
        (if (tc-type-needs-resolution? reflected)
          (macro-type-arg-module-qualify ctx reflected)
          reflected))
      resolved)))

(define (macro-type-arg [ctx : TcContext] [decls : AstDeclList] [arg : AstExpr]) : ResultMacroTypeArg
  (begin
    (tc-context-capture-active-pools! ctx)
    (match (ctfe-expr-to-type
      arg
      arg
      (ctfe-env-empty-with-pools (tc-context-pools ctx))
      (ctfe-fuel-limit))
      [(ResultCtfeQuoteType.Ok ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (ResultMacroTypeArg.Ok (macro-type-arg-resolve ctx decls ty))]
          [(ResultTcUnit.Err message)
            (ResultMacroTypeArg.Err (box (ctfe-diagnostic-at-expr arg message)))])]
      [(ResultCtfeQuoteType.Err diag) (ResultMacroTypeArg.Err diag)])))

(define (macro-type-arg-with-fallback
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : AstExpr]) : ResultMacroTypeArg
  (match (macro-type-arg ctx decls arg)
    [(ResultMacroTypeArg.Ok resolved-ty) (ResultMacroTypeArg.Ok resolved-ty)]
    [(ResultMacroTypeArg.Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (ResultMacroTypeArg.Err primary-diag)
        (match (macro-type-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          decls
          arg)
          [(ResultMacroTypeArg.Ok resolved-ty)
            (ResultMacroTypeArg.Ok resolved-ty)]
          [(ResultMacroTypeArg.Err _) (ResultMacroTypeArg.Err primary-diag)]))]))

(define (macro-type-kind-list-render [kinds : AstMacroTypeKindList]) : String
  (match kinds
    [(AstMacroTypeKindList.Nil) ""]
    [(AstMacroTypeKindList.Cons head rest)
      (let
        [tail : AstMacroTypeKindList (box-get rest)]
        (str_cat.str-cat
          (intern-str head)
          (match tail
            [(AstMacroTypeKindList.Nil) ""]
            [_ (str_cat.str-cat ", " (macro-type-kind-list-render tail))])))]))

(define (macro-type-kind-list-contains-text?
  [kinds : AstMacroTypeKindList]
  [kind : String]) : bool
  (match kinds
    [(AstMacroTypeKindList.Nil) false]
    [(AstMacroTypeKindList.Cons head rest)
      (if (string.eq (intern-str head) kind)
        true
        (macro-type-kind-list-contains-text? (box-get rest) kind))]))

(define (macro-type-kind-constraint-message
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : AstType]
  [type-kinds : AstMacroTypeKindList]) : String
  (str_cat.str-cat
    "typecheck: macro "
    (tc-name-slashes-to-dots macro-name)
    " type operand "
    (intern-str param-name)
    " rejects "
    (tc-type-render resolved-ty)
    ": expected one of :kind "
    (macro-type-kind-list-render type-kinds)))

(define (macro-validate-type-kind-constraint
  [ctx : TcContext]
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : AstType]
  [type-kinds : AstMacroTypeKindList]
  [arg-expr : AstExpr]) : ResultMacroCheck
  (match type-kinds
    [(AstMacroTypeKindList.Nil) ResultMacroCheck.Ok]
    [_
      (let
        [actual-kind : String
          (ctfe-type-kind-with-reflections-and-pools
            (tc-context-pools ctx)
            (ctfe-reflect-info-list-empty)
            resolved-ty)]
        (if (macro-type-kind-list-contains-text? type-kinds actual-kind)
          ResultMacroCheck.Ok
          (ResultMacroCheck.Err
            (box
              (ctfe-diagnostic-at-expr
                arg-expr
                (macro-type-kind-constraint-message
                  macro-name
                  param-name
                  resolved-ty
                  type-kinds))))))]))

(define (macro-module-strategy-unknown-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown module strategy "
    name
    "; import the module or use a visible dotted module alias"))

(define (macro-module-strategy-arg [ctx : TcContext] [arg : AstExpr]) : ResultMacroModuleArg
  (match (ast-expr-unspan arg)
    [(AstExpr.Var name-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or name-id name-id)]
        [name : String (intern-str source-id)]
        (if (tc-source-slash-qualified-id? name source-id)
          (ResultMacroModuleArg.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (tc-source-slash-qualified-message name))))
          (match ctx
            [(TcContext program _ _ current-module current-module-id _ _)
              (match program
                [(AstProgram.Program decls-box)
                  (match (macro-import-alias-target-cached-id
                    (box-get decls-box)
                    current-module-id
                    name-id)
                    [(TcMaybeNameId.Some target-id)
                      (ResultMacroModuleArg.Ok (intern-str target-id) target-id)]
                    [(TcMaybeNameId.No)
                      (if (or
                        (string.eq name current-module)
                        (tc-imported-module-identity-id? ctx name-id))
                        (ResultMacroModuleArg.Ok name source-id)
                        (ResultMacroModuleArg.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              arg
                              (macro-module-strategy-unknown-message name)))))])])])))]
    [_
      (ResultMacroModuleArg.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: Module macro operand expects a module name")))]))

(define (macro-module-strategy-arg-with-fallback
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : AstExpr]) : ResultMacroModuleArg
  (match (macro-module-strategy-arg ctx arg)
    [(ResultMacroModuleArg.Ok module module-id)
      (ResultMacroModuleArg.Ok module module-id)]
    [(ResultMacroModuleArg.Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (ResultMacroModuleArg.Err primary-diag)
        (match (macro-module-strategy-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          arg)
          [(ResultMacroModuleArg.Ok module module-id)
            (ResultMacroModuleArg.Ok module module-id)]
          [(ResultMacroModuleArg.Err _) (ResultMacroModuleArg.Err primary-diag)]))]))

(define (macro-expr-clause-from-items [arg : AstExpr] [items : AstExprList]) : ResultMacroClause
  (if (= (struct-get (& items) len) 2)
    (ResultMacroClause.Ok
      (ast-expr-clause
        (ast-expr-list-get (& items) 0 0)
        (ast-expr-list-get (& items) 1 0)))
    (ResultMacroClause.Err
      (box (ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))))

(define (macro-expr-clause-from-arg [arg : AstExpr]) : ResultMacroClause
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause items) (macro-expr-clause-from-items arg items)]
    [_
      (ResultMacroClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprClause macro operand expects bracket syntax")))]))

(define (macro-expr-clause-list-from-args [args : AstExprList]) : ResultMacroClauseList
  (let
    [out : AstExprClauseList
      (ast-expr-clause-list-with-capacity (struct-get (& args) len))]
    (match (macro-expr-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroClauseList.Err diag)])))

(define (macro-expr-clause-list-from-args-into
  [args : (& args AstExprList)]
  [index : i64]
  [out : (&mut out AstExprClauseList)]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-expr-clause-from-arg head-expr)
        [(ResultMacroClause.Ok clause)
          (begin
            (ast-expr-clause-list-push out clause)
            (macro-expr-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expr-span-or-zero [arg : AstExpr]) : AstSourceSpan
  (match arg
    [(AstExpr.Spanned _ span) span]
    [_ (ast-source-span 0 0 0 0)]))

(define (macro-expr-colon? [expr-id : i64]) : bool
  (match (ast-expr-unspan (ast-node-get expr-id))
    [(AstExpr.Var name) (= name cbi.compiler-builtin-id-fix-colon)]
    [_ false]))

(define (macro-expr-binding-clause-shape-error [arg : AstExpr]) : ResultMacroBindingClause
  (ResultMacroBindingClause.Err
    (box (ctfe-diagnostic-at-expr arg (macro-binding-clause-shape-message)))))

(define (macro-expr-binding-clause-from-name
  [arg : AstExpr]
  [name : i64]
  [rest : AstExprList]) : ResultMacroBindingClause
  (let
    [len : i64 (struct-get (& rest) len)]
    (if (<= len 0)
      (macro-expr-binding-clause-shape-error arg)
      (let
        [first : i64 (ast-expr-list-get (& rest) 0 0)]
        (if (macro-expr-colon? first)
          (if (= len 3)
            (ResultMacroBindingClause.Ok
              (ast-expr-binding-clause-id
                name
                true
                (ast-expr-list-get (& rest) 1 0)
                (ast-expr-list-get (& rest) 2 0)
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg))
          (if (= len 1)
            (ResultMacroBindingClause.Ok
              (ast-expr-binding-clause-id
                name
                false
                (ast-node-push (AstExpr.Literal (AstLiteral.Unit)))
                first
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg)))))))

(define (macro-expr-binding-clause-from-items
  [arg : AstExpr]
  [items : AstExprList]) : ResultMacroBindingClause
  (if (ast-expr-list-empty? (& items))
    (macro-expr-binding-clause-shape-error arg)
    (let
      [name-expr : i64 (ast-expr-list-get (& items) 0 0)]
      (match (ast-expr-unspan (ast-node-get name-expr))
        [(AstExpr.Var name)
          (macro-expr-binding-clause-from-name
            arg
            name
            (ast-expr-list-tail-from-ref (& items) 1))]
        [_ (macro-expr-binding-clause-shape-error arg)]))))

(define (macro-expr-binding-clause-from-arg [arg : AstExpr]) : ResultMacroBindingClause
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause items)
      (macro-expr-binding-clause-from-items arg items)]
    [_
      (ResultMacroBindingClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprBindingClause macro operand expects bracket syntax")))]))

(define (macro-expr-binding-clause-list-from-args [args : AstExprList]) : ResultMacroBindingClauseList
  (let
    [out : AstExprBindingClauseList
      (ast-expr-binding-clause-list-with-capacity (struct-get (& args) len))]
    (match (macro-expr-binding-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroBindingClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroBindingClauseList.Err diag)])))

(define (macro-expr-binding-clause-list-from-args-into
  [args : (& args AstExprList)]
  [index : i64]
  [out : (&mut out AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-expr-binding-clause-from-arg head-expr)
        [(ResultMacroBindingClause.Ok clause)
          (begin
            (ast-expr-binding-clause-list-push out clause)
            (macro-expr-binding-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-signature-resolution-context-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]) : TcContext
  (if (> (string.string-length fallback-module) 0)
    (tc-context-with-module-id ctx fallback-module fallback-module-id)
    ctx))

(define (macro-normalize-signature-syntax-type [ty : AstType]) : AstType
  (match ty
    [(AstType.Var name)
      (match (tc-stdlib-comptime-syntax-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [_ ty]))

(define (macro-resolve-signature-type-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]) : AstType
  (macro-normalize-signature-syntax-type
    (tc-resolve-type
      (macro-signature-resolution-context-id
        ctx
        fallback-module
        fallback-module-id)
      (tc-macro-signature-type ty))))

(define (macro-check-ordinary-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-type-eq resolved-expected (AstType.Expr))
    ResultMacroCheck.Ok
    (match (tc-expr-with-expected-or-actual ctx env arg resolved-expected)
      [(ResultTcType.Ok actual)
        (if (tc-type-compatible? resolved-expected actual)
          ResultMacroCheck.Ok
          (ResultMacroCheck.Err
            (box
              (tc-expr-diag
                arg
                (macro-operand-mismatch-message resolved-expected actual)))))]
      [(ResultTcType.Err message)
        (ResultMacroCheck.Err
          (box
            (tc-expr-diag
              arg
              (string.append
                "typecheck: macro operand typecheck failed: "
                message))))])))

(define (macro-operand-bracket-clause? [arg : AstExpr]) : bool
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause _) true]
    [_ false]))

(define (macro-check-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? expected)
    (match (macro-type-arg
      ctx
      (match (tc-context-program ctx)
        [(AstProgram.Program decls-box) (box-get decls-box)])
      arg)
      [(ResultMacroTypeArg.Ok _) ResultMacroCheck.Ok]
      [(ResultMacroTypeArg.Err diag) (ResultMacroCheck.Err diag)])
    (let
      [resolved-expected : AstType
        (macro-resolve-signature-type-id
          ctx
          fallback-module
          fallback-module-id
          expected)]
      (cond
        [(tc-macro-expr-clause-type? resolved-expected)
          (match (macro-expr-clause-from-arg arg)
            [(ResultMacroClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(tc-macro-expr-binding-clause-type? resolved-expected)
          (match (macro-expr-binding-clause-from-arg arg)
            [(ResultMacroBindingClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(macro-operand-bracket-clause? arg)
          (ResultMacroCheck.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (macro-clause-operand-mismatch-message resolved-expected))))]
        [else (macro-check-ordinary-operand ctx env resolved-expected arg)]))))

(define (macro-check-variadic-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : AstType]
  [args : AstExprList]) : ResultMacroCheck
  (macro-check-variadic-operands-at
    ctx
    env
    fallback-module
    fallback-module-id
    expected
    (& args)
    0))

(define (macro-check-variadic-operands-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : AstType]
  [args : (& args AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-check-operand
        ctx
        env
        fallback-module
        fallback-module-id
        expected
        head)
        [(ResultMacroCheck.Ok)
          (macro-check-variadic-operands-at
            ctx
            env
            fallback-module
            fallback-module-id
            expected
            args
            (+ index 1))]
        [(ResultMacroCheck.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-param-expr-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]) : bool
  (tc-macro-expr-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-param-expr-binding-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : AstType]) : bool
  (tc-macro-expr-binding-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-captured-expr-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [capture-expr-types : bool]
  [arg : AstExpr]) : AstType
  (if (tc-type-eq resolved-expected (AstType.Expr))
    (if capture-expr-types
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok actual)
          (ctfe-captured-expr-type-with-pools
            (tc-context-pools ctx)
            (tc-resolve-type ctx actual))]
        [(ResultTcType.Err _) (ctfe-untyped-expr-type)])
      (ctfe-untyped-expr-type))
    resolved-expected))

;; Concrete variadic operands are checked before their transformer runs. That
;; check can advance the active caller pool beyond the definition pool held by
;; the CTFE environment. Preserve the newer pool on the bound syntax list so
;; CTFE constructors do not allocate over the checked operands.
(define (macro-captured-syntax-pools [env : CtfeEnv]) : CtfeMaybeSyntaxPools
  (let
    [definition-pools : AstNodePoolContext (ctfe-env-pools env)]
    [caller-pools : AstNodePoolContext (ast-node-pool-context-capture-active)]
    (if (>
      (ast-node-pool-context-expr-len caller-pools)
      (ast-node-pool-context-expr-len definition-pools))
      (CtfeMaybeSyntaxPools.Some caller-pools)
      (CtfeMaybeSyntaxPools.None))))

(define (macro-captured-expr-list-value [env : CtfeEnv] [args : AstExprList]) : CompilerCtfeValue
  (match (macro-captured-syntax-pools env)
    [(CtfeMaybeSyntaxPools.Some pools)
      (CompilerCtfeValue.CapturedExprList args pools)]
    [(CtfeMaybeSyntaxPools.None) (CompilerCtfeValue.ExprList args)]))

(define (macro-captured-expr-clause-list-value
  [env : CtfeEnv]
  [clauses : AstExprClauseList]) : CompilerCtfeValue
  (match (macro-captured-syntax-pools env)
    [(CtfeMaybeSyntaxPools.Some pools)
      (CompilerCtfeValue.CapturedExprClauseList clauses pools)]
    [(CtfeMaybeSyntaxPools.None) (CompilerCtfeValue.ExprClauseList clauses)]))

(define (macro-bind-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [name : i64]
  [ty : AstType]
  [args : AstExprList]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExpr.Var name)
            "typecheck: type macro operand cannot be variadic")))]
    [(tc-macro-module-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExpr.Var name)
            "typecheck: Module macro operand cannot be variadic")))]
    [(macro-param-expr-clause? ctx fallback-module fallback-module-id ty)
      (match (macro-expr-clause-list-from-args args)
        [(ResultMacroClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-id
              env
              name
              (macro-captured-expr-clause-list-value env clauses)))]
        [(ResultMacroClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause?
        ctx
        fallback-module
        fallback-module-id
        ty)
      (match (macro-expr-binding-clause-list-from-args args)
        [(ResultMacroBindingClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-id
              env
              name
              (CompilerCtfeValue.ExprBindingClauseList clauses)))]
        [(ResultMacroBindingClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (match (macro-check-variadic-operands
        ctx
        type-env
        fallback-module
        fallback-module-id
        ty
        args)
        [(ResultMacroCheck.Ok)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-id
              env
              name
              (macro-captured-expr-list-value env args)))]
        [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)])]))

;; A direct caller string literal is the one `Expr` shape that public macro
;; code can inspect without evaluating. Keep its literal node in the active
;; CTFE pool instead of passing a transient macro-expansion proxy variable.
;; Other expressions retain their original node and hygiene unchanged.
(define (macro-captured-expr-node
  [ctx : TcContext]
  [arg-id : i64]
  [arg-expr : AstExpr]) : i64
  (match arg-expr
    [(AstExpr.Spanned inner span)
      (match (ast-node-get inner)
        [(AstExpr.Literal (AstLiteral.String string-id))
          (ast-expr-spanned-with-pools
            (tc-context-pools ctx)
            (ast-node-pool-context-expr-push
              (tc-context-pools ctx)
              (AstExpr.Literal (AstLiteral.String string-id)))
            span)]
        [_ arg-id])]
    [(AstExpr.Literal (AstLiteral.String string-id))
      (ast-node-pool-context-expr-push
        (tc-context-pools ctx)
        (AstExpr.Literal (AstLiteral.String string-id)))]
    [_ arg-id]))

(define (macro-bind-fixed-param
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [name : i64]
  [ty : AstType]
  [type-kinds : AstMacroTypeKindList]
  [arg-id : i64]
  [arg-expr : AstExpr]
  [capture-expr-types : bool]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback
        ctx
        decls
        fallback-module
        fallback-module-id
        arg-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (match (macro-validate-type-kind-constraint
            ctx
            macro-name
            name
            resolved-ty
            type-kinds
            arg-expr)
            [(ResultMacroCheck.Ok)
              (ResultMacroEnv.Ok
                (ctfe-env-extend-id
                  env
                  name
                  (CompilerCtfeValue.Type resolved-ty)))]
            [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)])]
        [(ResultMacroTypeArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        fallback-module-id
        arg-expr)
        [(ResultMacroModuleArg.Ok module module-id)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-typed-id
              env
              name
              (CompilerCtfeValue.String module module-id)
              (AstType.String)))]
        [(ResultMacroModuleArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-clause? ctx fallback-module fallback-module-id ty)
      (match (macro-expr-clause-from-arg arg-expr)
        [(ResultMacroClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-id env name (CompilerCtfeValue.ExprClause clause)))]
        [(ResultMacroClause.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause?
        ctx
        fallback-module
        fallback-module-id
        ty)
      (match (macro-expr-binding-clause-from-arg arg-expr)
        [(ResultMacroBindingClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-id
              env
              name
              (CompilerCtfeValue.ExprBindingClause clause)))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (let
        [resolved-expected : AstType
          (macro-resolve-signature-type-id
            ctx
            fallback-module
            fallback-module-id
            ty)]
        (match (macro-check-operand
          ctx
          type-env
          fallback-module
          fallback-module-id
          ty
          arg-expr)
          [(ResultMacroCheck.Ok)
            (ResultMacroEnv.Ok
              (ctfe-env-extend-id
                env
                name
                (CompilerCtfeValue.Expr
                  (if (and
                    capture-expr-types
                    (tc-type-eq resolved-expected (AstType.Expr)))
                    (macro-captured-expr-node ctx arg-id arg-expr)
                    arg-id)
                  (macro-captured-expr-produced-type
                    ctx
                    type-env
                    resolved-expected
                    capture-expr-types
                    arg-expr))))]
          [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)]))]))

;; Bind the unevaluated operand forms to the macro parameters as `Expr` values.
;; A trailing variadic parameter collects the remaining operands as an ExprList.
(define (macro-bind-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : AstExpr]) : ResultMacroEnv
  (macro-bind-params-at
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name
    (& params)
    (& args)
    0
    env
    capture-expr-types
    call-expr))

(define (macro-bind-params-at
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : AstExpr]) : ResultMacroEnv
  (cond
    [(>= index (ast-macro-param-list-len params))
      (if (>= index (struct-get args len))
        (ResultMacroEnv.Ok env)
        (ResultMacroEnv.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
        [(AstMacroParam.Param pname pty variadic type-kinds)
          (if variadic
            (macro-bind-variadic-param
              ctx
              type-env
              fallback-module
              fallback-module-id
              pname
              pty
              (ast-expr-list-tail-from-ref args index)
              env)
            (if (>= index (struct-get args len))
              (ResultMacroEnv.Err
                (box
                  (ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast-expr-list-get args index 0)]
                [arg-expr : AstExpr (ast-node-get arg)]
                (match (macro-bind-fixed-param
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  pname
                  pty
                  type-kinds
                  arg
                  arg-expr
                  capture-expr-types
                  env)
                  [(ResultMacroEnv.Ok next-env)
                    (macro-bind-params-at
                      ctx
                      decls
                      fallback-module
                      fallback-module-id
                      type-env
                      macro-name
                      params
                      args
                      (+ index 1)
                      next-env
                      capture-expr-types
                      call-expr)]
                  [(ResultMacroEnv.Err diag) (ResultMacroEnv.Err diag)]))))])]))

;; Route embedded-stdlib macro calls through the TLCI catalog before the
;; semantic CTFE fallback. The current image contains native registration
;; shells, not lowered transformer bodies, so a catalog hit is deliberately
;; counted separately from the interpreted execution that follows. Explicit
;; stdlib roots never enter this branch because loader provenance is per
;; compilation session.
(define macro-expand-stdlib-tlci-route-active : bool
  false)
(cfg
  embedded-stdlib-tlci
  (define macro-expand-stdlib-tlci-catalog-cache : tc_string_i64_map.Map
    (tc_string_i64_map.new)))

(cfg
  embedded-stdlib-tlci
  (define (macro-expand-stdlib-tlci-catalog-lookup-cached [name : String]) : CompilerEmbeddedStdlibTlciLookup
    (match (tc_string_i64_map.get
      (& macro-expand-stdlib-tlci-catalog-cache)
      name)
      [(tc_string_i64_map.LookupFound outcome)
        (cond
          [(= outcome 1) CompilerEmbeddedStdlibTlciLookup.Cataloged]
          [(= outcome 0) CompilerEmbeddedStdlibTlciLookup.Missing]
          [else
            (CompilerEmbeddedStdlibTlciLookup.Unavailable
              "cached embedded stdlib tlci load failure")])]
      [(tc_string_i64_map.LookupMissing)
        (let
          [lookup : CompilerEmbeddedStdlibTlciLookup
            (compiler-embedded-stdlib-tlci-catalog-lookup name)]
          (begin
            (tc_string_i64_map.insert-ref!
              (&mut macro-expand-stdlib-tlci-catalog-cache)
              name
              (match lookup
                [(CompilerEmbeddedStdlibTlciLookup.Cataloged) 1]
                [(CompilerEmbeddedStdlibTlciLookup.Missing) 0]
                [(CompilerEmbeddedStdlibTlciLookup.Unavailable _) -1]))
            lookup))])))

(define (macro-note-stdlib-tlci-route
  [definition-module : String]
  ;; lint-allow: unused-variable -- used by embedded-stdlib-tlci builds.
  [macro-name : String]) : unit
  (if (or
    (ctfe-string-prefix? definition-module "stdlib.")
    (ctfe-string-prefix? macro-name "stdlib."))
    (if macro-expand-stdlib-tlci-route-active
      (begin
        (cfg
          embedded-stdlib-tlci
          (match (macro-expand-stdlib-tlci-catalog-lookup-cached
            (if (ctfe-string-prefix? macro-name "stdlib.")
              macro-name
              (str_cat.str-cat definition-module "/" macro-name)))
            [(CompilerEmbeddedStdlibTlciLookup.Cataloged)
              (cfg
                compile-profile
                (set!
                  compiler-tc-macro-stdlib-tlci-catalog-hits
                  (+ compiler-tc-macro-stdlib-tlci-catalog-hits 1)))]
            [(CompilerEmbeddedStdlibTlciLookup.Missing)
              (cfg
                compile-profile
                (set!
                  compiler-tc-macro-stdlib-tlci-catalog-misses
                  (+ compiler-tc-macro-stdlib-tlci-catalog-misses 1)))]
            [(CompilerEmbeddedStdlibTlciLookup.Unavailable _)
              (cfg
                compile-profile
                (set!
                  compiler-tc-macro-stdlib-tlci-load-failures
                  (+ compiler-tc-macro-stdlib-tlci-load-failures 1)))]))
        (cfg
          (not embedded-stdlib-tlci)
          (cfg
            compile-profile
            (set!
              compiler-tc-macro-stdlib-tlci-load-failures
              (+ compiler-tc-macro-stdlib-tlci-load-failures 1))))
        (cfg
          compile-profile
          (set!
            compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
            (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1))))
      (cfg
        compile-profile
        (set!
          compiler-tc-macro-stdlib-source-interpreted
          (+ compiler-tc-macro-stdlib-source-interpreted 1))))
    unit))

;; Run a macro transformer via CTFE. Module/declaration macro expansion also
;; needs the bound CTFE environment while normalizing generated import operands.
(define (macro-eval-transformer-expanded-with-env
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValueEnv
  (begin
    ;; Macro argument normalization may have already extended this context
    ;; while the global active pool still points at an older caller snapshot.
    ;; Do not overwrite the newer context in that case; otherwise retain the
    ;; usual capture of the active pool.
    (if (ast-node-pool-compat-context-active?)
      unit
      (let
        [owned-pools : AstNodePoolContext (tc-context-pools ctx)]
        [active-pools : AstNodePoolContext
          (ast-node-pool-context-capture-active)]
        (if (or
          (>
            (ast-node-pool-context-expr-len owned-pools)
            (ast-node-pool-context-expr-len active-pools))
          (>
            (ast-node-pool-context-type-len owned-pools)
            (ast-node-pool-context-type-len active-pools)))
          (tc-context-install-pools! ctx)
          (tc-context-capture-active-pools! ctx))))
    (match (macro-bind-params
      ctx
      decls
      fallback-module
      fallback-module-id
      type-env
      macro-name
      params
      expanded-args
      (tc-ctfe-env ctx)
      (tc-string-list-contains macro-expand-expr-type-macro-names macro-name)
      call-expr)
      [(ResultMacroEnv.Ok env)
        (begin
          (macro-note-stdlib-tlci-route fallback-module macro-name)
          (cfg compile-profile (compiler-tc-macro-profile-start))
          (match (ctfe-eval-node
            body
            (ctfe-env-extend-id
              env
              (ctfe-hygiene-enabled-id)
              (CompilerCtfeValue.Bool true))
            (ctfe-fuel-limit))
            [(ResultCtfe.Ok value _)
              (begin
                (tc-context-install-pools! ctx)
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Ok value env))]
            [(ResultCtfe.Err diag)
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Err diag))]))]
      [(ResultMacroEnv.Err diag) (ResultMacroValueEnv.Err diag)])))

;; Run a macro transformer via CTFE. Callers decide how to interpret the
;; returned syntax value for expression, module, or declaration positions.
(define (macro-eval-transformer-expanded
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValue
  (match (macro-eval-transformer-expanded-with-env
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name
    params
    body
    expanded-args
    call-expr)
    [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
    [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-eval-transformer
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroValue
  ;; Expand the operands first so a macro call passed as an argument (e.g. a
  ;; nested `str_cat.str-cat`) is reduced to a plain expression before it is typechecked
  ;; and bound; otherwise the operand typecheck sees the inner macro name as an
  ;; unbound value.
  (match (macro-expand-exprs ctx type-env decls depth args)
    [(ResultMacroExprList.Ok expanded-args)
      (macro-eval-transformer-expanded
        ctx
        decls
        fallback-module
        fallback-module-id
        type-env
        macro-name
        params
        body
        expanded-args
        call-expr)]
    [(ResultMacroExprList.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-generated-type-param-expr-list
  [env : CtfeEnv]
  [exprs : AstExprList]) : AstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (begin
      (macro-generated-type-param-expr-list-into env (& exprs) 0 (&mut out))
      out)))

(define (macro-generated-type-param-expr-list-into
  [env : CtfeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstExprList)]) : unit
  (if (>= index (struct-get exprs len))
    unit
    (begin
      (ast-expr-list-push
        out
        (macro-generated-type-param-expr
          env
          (ast-node-get (ast-expr-list-get exprs index 0))))
      (macro-generated-type-param-expr-list-into env exprs (+ index 1) out))))

(define (macro-generated-type-param-expr [env : CtfeEnv] [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-generated-type-param-expr env inner) span))]
    [(AstExpr.Var name)
      (let
        [lookup-id : i64
          (macro-output-source-identity-id-at name "generated-type-param")]
        (match (if (>= lookup-id 0)
          (ctfe-env-lookup-id env lookup-id)
          (CtfeMaybeValue.None))
          [(CtfeMaybeValue.Some value)
            (match value
              [(CompilerCtfeValue.Type ty)
                (ast-node-push (AstExpr.TypeLiteral ty))]
              [_ (ast-node-push expr)])]
          [(CtfeMaybeValue.None) (ast-node-push expr)]))]
    [(AstExpr.Call func-box args)
      (ast-expr-call func-box (macro-generated-type-param-expr-list env args))]
    [_ (ast-node-push expr)]))

(define (macro-generated-call-func-for-lookup [expr : AstExpr]) : AstExpr
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (AstExpr.Var
        (macro-output-source-identity-id-at name "generated-call-func"))]
    [_ expr]))

(define (macro-generated-import-type-arg
  [ty : AstType]
  [arg : i64]
  [env : CtfeEnv]) : i64
  (if (tc-macro-type-param-kind? ty)
    (macro-generated-type-param-expr env (ast-node-get arg))
    arg))

(define (macro-generated-import-type-args-for-param
  [param : AstMacroParam]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]) : AstExprList
  (match param
    [(AstMacroParam.Param _ ty variadic _)
      (if variadic
        (let
          [remaining : AstExprList (ast-expr-list-tail-from-ref args index)]
          (if (tc-macro-type-param-kind? ty)
            (macro-generated-type-param-expr-list env remaining)
            remaining))
        (ast-expr-cons
          (macro-generated-import-type-arg
            ty
            (ast-expr-list-get args index 0)
            env)
          (macro-generated-import-type-args-at params args (+ index 1) env)))]))

(define (macro-generated-import-type-args
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]) : AstExprList
  (macro-generated-import-type-args-at (& params) (& args) 0 env))

(define (macro-generated-import-type-args-at
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]) : AstExprList
  (if (>= index (ast-macro-param-list-len params))
    (ast-expr-list-tail-from-ref args index)
    (if (>= index (struct-get args len))
      (ast-expr-list-new)
      (macro-generated-import-type-args-for-param
        (ast-macro-param-list-get params index (ast-macro-param-fallback))
        params
        args
        index
        env))))

(define (macro-rewrite-generated-import-call-with-decl
  [ctx : TcContext]
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]
  [maybe-decl : MacroMaybeDecl]) : i64
  (match maybe-decl
    [(MacroMaybeDecl.Some _ _ _ params _ _)
      (let
        [rewritten : i64
          (ast-expr-call
            func-box
            (macro-generated-import-type-args params args env))]
        (begin
          (tc-context-capture-active-pools! ctx)
          rewritten))]
    [(MacroMaybeDecl.No) fallback]))

(define (macro-rewrite-generated-import-direct-call
  [ctx : TcContext]
  [decls : AstDeclList]
  [_ : String]
  [module-id : i64]
  [func : AstExpr]
  [call-expr : AstExpr]
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]) : i64
  (match (ast-expr-unspan func)
    [(AstExpr.Var name)
      (let
        [lookup-name : String
          (macro-output-source-name-id-at name "generated-import-call")]
        [source-id : i64
          (macro-output-syntax-id-at name "generated-import-call")]
        (if (or
          (tc-name-qualified-id? source-id)
          (tc-source-slash-qualified-id? lookup-name source-id)
          (>= (tc-name-first-dot-id source-id) 0))
          fallback
          (match (macro-import-alias-target-cached-id decls module-id source-id)
            [(TcMaybeNameId.Some target-id)
              (match (macro-unqualified-imported-target-call-decl
                ctx
                target-id
                source-id
                call-expr)
                [(ResultMacroCallDecl.Ok maybe-decl)
                  (match maybe-decl
                    [(MacroMaybeDecl.Some _ _ _ _ _ _)
                      (macro-rewrite-generated-import-call-with-decl
                        ctx
                        func-box
                        args
                        env
                        fallback
                        maybe-decl)]
                    [(MacroMaybeDecl.No)
                      (let
                        [rewritten : i64
                          (ast-expr-call
                            func-box
                            (macro-generated-type-param-expr-list env args))]
                        (begin
                          (tc-context-capture-active-pools! ctx)
                          rewritten))])]
                [(ResultMacroCallDecl.Err _) fallback])]
            [(TcMaybeNameId.No) fallback])))]
    [_ fallback]))

(define (macro-rewrite-generated-import-call-id
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : CtfeEnv]
  [call-id : i64]) : i64
  (let
    [call-expr : AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (tc-context-expr-get ctx func-box)]
          [lookup-func : AstExpr (macro-generated-call-func-for-lookup func)]
          (match (macro-call-decl-with-context
            ctx
            lookup-func
            orig-decls
            module
            module-id
            (AstMaybeModuleName.Some definition-module-id)
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl _ _)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ _ _ _)
                  (macro-rewrite-generated-import-call-with-decl
                    ctx
                    func-box
                    args
                    env
                    call-id
                    maybe-decl)]
                [(MacroMaybeDecl.No)
                  (macro-rewrite-generated-import-direct-call
                    ctx
                    orig-decls
                    module
                    module-id
                    lookup-func
                    call-expr
                    func-box
                    args
                    env
                    call-id)])]
            [(ResultMacroCallDeclModule.Err _)
              (macro-rewrite-generated-import-direct-call
                ctx
                orig-decls
                module
                module-id
                lookup-func
                call-expr
                func-box
                args
                env
                call-id)]))]
      [_ call-id])))

(define (macro-rewrite-generated-import-kind
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : CtfeEnv]
  [kind : AstImportKind]) : AstImportKind
  (match kind
    [(AstImportKind.Macro call-id context)
      (AstImportKind.Macro
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [(AstImportKind.MacroDecls call-id context)
      (AstImportKind.MacroDecls
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [_ kind]))

(define (macro-rewrite-generated-import-decl
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : CtfeEnv]
  [decl : AstDecl]) : AstDecl
  (match decl
    [(AstDecl.Import
        decl-meta
        (AstImportSpec.Spec kind path expected alias span))
      (AstDecl.Import
        decl-meta
        (AstImportSpec.Spec
          (macro-rewrite-generated-import-kind
            ctx
            orig-decls
            module
            module-id
            definition-module-id
            env
            kind)
          path
          expected
          alias
          span))]
    [(AstDecl.Unsafe inner-box)
      (ast-decl-unsafe
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          (box-get inner-box)))]
    [(AstDecl.ModuleBody name body-box)
      (ast-decl-module-body-id
        name
        (macro-rewrite-generated-import-decls-with-env
          ctx
          orig-decls
          (tc-env-key-name-text name)
          name
          definition-module-id
          env
          (box-get body-box)))]
    [_ decl]))

(define (macro-rewrite-generated-import-decls-with-env
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-rewrite-generated-import-decl
                  ctx
                  orig-decls
                  module
                  module-id
                  definition-module-id
                  env
                  decl))
              (set! cursor rest))]))
      out)))

(define (macro-rewrite-generated-import-decls
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (let
    [rewrite-env : CtfeEnv
      (ctfe-env-extend-id
        (ctfe-env-rebase-pools env (tc-context-pools ctx))
        (ctfe-hygiene-enabled-id)
        (CompilerCtfeValue.Bool true))]
    (macro-rewrite-generated-import-decls-with-env
      ctx
      orig-decls
      module
      module-id
      definition-module-id
      rewrite-env
      decls)))

;; Avoid recursive `core-and-from`/`core-or-from` CTFE for the hot prelude macros.
(define (macro-core-bool-lit [value : bool]) : i64
  (ast-node-push (AstExpr.Literal (AstLiteral.Bool value))))

(defstruct MacroCoreForProtocol
  (constructor i64)
  (next i64)
  (cleanup i64)
  (item-cleanup i64))

(defstruct MacroCoreForPlan
  (binding AstExprBindingClause)
  (source i64)
  (source-temp? bool)
  (source-temp i64)
  (iterator-temp i64)
  (protocol MacroCoreForProtocol))

(defenum MacroCoreForPlanList
  (Nil)
  (Cons MacroCoreForPlan (Box MacroCoreForPlanList)))

(defenum ResultMacroCoreForProtocol
  (Ok MacroCoreForProtocol)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCoreForPlanList
  (Ok MacroCoreForPlanList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCoreForType
  (Ok AstType)
  (Err (Box CompilerDiagnostic)))

(define (macro-core-for-diagnostic [expr : AstExpr] [message : String]) : (Box
    CompilerDiagnostic)
  (box (ctfe-diagnostic-at-expr expr message)))

(define (macro-core-for-var [name : i64]) : i64
  (ast-node-push (AstExpr.Var name)))

(define (macro-core-for-call1 [callee : i64] [arg : i64]) : i64
  (ast-expr-call
    (macro-core-for-var callee)
    (ast-expr-cons arg (ast-expr-list-new))))

(define (macro-core-for-source-name-id [ctx : TcContext] [name : String]) : i64
  (ctfe-string-syntax-name-id
    (tc-context-source-names ctx)
    name
    (tc-generated-name-id name)))

(define (macro-core-for-qualified-value-id
  [ctx : TcContext]
  [module-id : i64]
  [name : String]) : i64
  (macro-hygiene-global-id
    module-id
    (macro-core-for-source-name-id ctx name)
    false))

(define (macro-core-for-nominal-module-id [ty : AstType]) : i64
  (match (tc-type-strip-region ty)
    [(AstType.Struct name) (tc-qualified-name-module-id name)]
    [(AstType.StructArgs name _) (tc-qualified-name-module-id name)]
    [(AstType.Enum name) (tc-qualified-name-module-id name)]
    [(AstType.EnumArgs name _) (tc-qualified-name-module-id name)]
    [_ -1]))

(define (macro-core-for-function-return
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-expr : AstExpr]
  [source-ty : AstType]
  [function-id : i64]
  [function-name : String]) : ResultMacroCoreForType
  (match (tc-expr ctx env (AstExpr.Var function-id))
    [(ResultTcType.Ok function-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx function-ty))
        [(AstType.Func _ ret)
          (ResultMacroCoreForType.Ok (tc-resolve-type ctx (ty-node-get ret)))]
        [_
          (ResultMacroCoreForType.Err
            (macro-core-for-diagnostic
              source-expr
              (str_cat.str-cat
                "typecheck: for protocol function "
                function-name
                " for source "
                (tc-type-render source-ty)
                " is not callable")))])]
    [(ResultTcType.Err _)
      (ResultMacroCoreForType.Err
        (macro-core-for-diagnostic
          source-expr
          (str_cat.str-cat
            "typecheck: for source "
            (tc-type-render source-ty)
            " is missing protocol function "
            function-name)))]))

(define (macro-core-for-next-result-enum-id [ty : AstType]) : i64
  (match (tc-type-strip-region ty)
    [(AstType.Enum name) name]
    [(AstType.EnumArgs name _) name]
    [_ -1]))

(define (macro-core-for-cleanup-id [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name)
      (match (tc-struct-decl-id ctx name)
        [(ResultTcStructDecl.Ok (TcStructDecl _ cleanup _))
          (match cleanup
            [(AstStructCleanup.No) -1]
            [(AstStructCleanup.Fn cleanup-name)
              (tc-module-name-id-by-id
                (tc-qualified-name-module-id name)
                cleanup-name)])]
        [(ResultTcStructDecl.Err _) -1])]
    [(AstType.StructArgs name _)
      (match (tc-struct-decl-id ctx name)
        [(ResultTcStructDecl.Ok (TcStructDecl _ cleanup _))
          (match cleanup
            [(AstStructCleanup.No) -1]
            [(AstStructCleanup.Fn cleanup-name)
              (tc-module-name-id-by-id
                (tc-qualified-name-module-id name)
                cleanup-name)])]
        [(ResultTcStructDecl.Err _) -1])]
    [(AstType.Enum name)
      (match (tc-enum-decl-id ctx name)
        [(ResultTcEnumDecl.Ok (TcEnumDecl cleanup _))
          (match cleanup
            [(AstEnumCleanup.No) -1]
            [(AstEnumCleanup.Fn cleanup-name)
              (tc-module-name-id-by-id
                (tc-qualified-name-module-id name)
                cleanup-name)])]
        [(ResultTcEnumDecl.Err _) -1])]
    [(AstType.EnumArgs name _)
      (match (tc-enum-decl-id ctx name)
        [(ResultTcEnumDecl.Ok (TcEnumDecl cleanup _))
          (match cleanup
            [(AstEnumCleanup.No) -1]
            [(AstEnumCleanup.Fn cleanup-name)
              (tc-module-name-id-by-id
                (tc-qualified-name-module-id name)
                cleanup-name)])]
        [(ResultTcEnumDecl.Err _) -1])]
    [_ -1]))

(define (macro-core-for-variant-present?
  [ctx : TcContext]
  [enum-id : i64]
  [name : String]) : bool
  (compiler-symbols-handle-found?
    (tc-source-variant-handle-for-enum-id-or
      ctx
      enum-id
      (macro-core-for-source-name-id ctx name)
      (compiler-symbols-missing-handle))))

(define (macro-core-for-item-type
  [ctx : TcContext]
  [_env : TcTypeEnv]
  [source-expr : AstExpr]
  [next-ret : AstType]) : ResultMacroCoreForType
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx next-ret))]
    [enum-id : i64 (macro-core-for-next-result-enum-id resolved)]
    [lifetimes : AstLifetimeList
      (match resolved
        [(AstType.EnumArgs _ args) (box-get args)]
        [_ (ast-lifetime-list-new)])]
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-id
        (macro-core-for-source-name-id ctx "Item")
        (compiler-symbols-missing-handle))]
    (if (not (compiler-symbols-handle-found? handle))
      (ResultMacroCoreForType.Err
        (macro-core-for-diagnostic
          source-expr
          "typecheck: for protocol result is missing Item"))
      (match (compiler-registries-variant-fields-indexed
        (tc-context-symbols ctx)
        handle)
        [(ResultAstTypeList.Ok fields)
          (match (tc-variant-pattern-payload-types
            ctx
            enum-id
            (compiler-registry-handle-owner-index handle)
            lifetimes
            fields)
            [(ResultTcVariantPayloadTypes.Ok payloads)
              (if (= (ast-type-list-len (& payloads)) 1)
                (ResultMacroCoreForType.Ok
                  (ty-node-get
                    (ast-type-list-get (& payloads) 0 (ast-type-id-fallback))))
                (ResultMacroCoreForType.Err
                  (macro-core-for-diagnostic
                    source-expr
                    "typecheck: for protocol Item must carry exactly one item")))]
            [(ResultTcVariantPayloadTypes.Err message)
              (ResultMacroCoreForType.Err
                (macro-core-for-diagnostic source-expr message))])]
        [(ResultAstTypeList.Err message)
          (ResultMacroCoreForType.Err
            (macro-core-for-diagnostic source-expr message))]))))

(define (macro-core-for-protocol-after-next
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-expr : AstExpr]
  [source-ty : AstType]
  [constructor-id : i64]
  [constructor-ret : AstType]
  [next-id : i64]
  [next-name : String]
  [next-ret : AstType]) : ResultMacroCoreForProtocol
  (let
    [enum-id : i64 (macro-core-for-next-result-enum-id next-ret)]
    (cond
      [(< enum-id 0)
        (ResultMacroCoreForProtocol.Err
          (macro-core-for-diagnostic
            source-expr
            (str_cat.str-cat
              "typecheck: for protocol function "
              next-name
              " for source "
              (tc-type-render source-ty)
              " must return a Done/Item enum")))]
      [(not (macro-core-for-variant-present? ctx enum-id "Done"))
        (ResultMacroCoreForProtocol.Err
          (macro-core-for-diagnostic
            source-expr
            (str_cat.str-cat
              "typecheck: for protocol result "
              (tc-type-render next-ret)
              " is missing Done")))]
      [(not (macro-core-for-variant-present? ctx enum-id "Item"))
        (ResultMacroCoreForProtocol.Err
          (macro-core-for-diagnostic
            source-expr
            (str_cat.str-cat
              "typecheck: for protocol result "
              (tc-type-render next-ret)
              " is missing Item")))]
      [else
        (match (macro-core-for-item-type ctx env source-expr next-ret)
          [(ResultMacroCoreForType.Ok item-ty)
            (ResultMacroCoreForProtocol.Ok
              (MacroCoreForProtocol
                constructor-id
                next-id
                (macro-core-for-cleanup-id ctx constructor-ret)
                (macro-core-for-cleanup-id ctx item-ty)))]
          [(ResultMacroCoreForType.Err diag)
            (ResultMacroCoreForProtocol.Err diag)])])))

(define (macro-core-for-protocol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-expr : AstExpr]
  [source-ty : AstType]) : ResultMacroCoreForProtocol
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx source-ty))]
    [referent : AstType
      (match resolved
        [(AstType.Ref _ inner)
          (tc-type-strip-region (tc-resolve-type ctx (ty-node-get inner)))]
        [(AstType.MutRef _ inner)
          (tc-type-strip-region (tc-resolve-type ctx (ty-node-get inner)))]
        [_ resolved])]
    [constructor-name : String
      (match resolved
        [(AstType.Ref _ _) "iterator"]
        [(AstType.MutRef _ _) "iterator-mut"]
        [_ "into-iterator"])]
    [next-base : String
      (match resolved
        [(AstType.Ref _ _) "next"]
        [(AstType.MutRef _ _) "next-mut"]
        [_ "into-next"])]
    [module-id : i64 (macro-core-for-nominal-module-id referent)]
    (if (< module-id 0)
      (ResultMacroCoreForProtocol.Err
        (macro-core-for-diagnostic
          source-expr
          (str_cat.str-cat
            "typecheck: for source "
            (tc-type-render source-ty)
            " must be a nominal iterable or reference to one")))
      (let
        [module-name : String (macro-decl-module-display module-id)]
        [constructor-display : String
          (compiler-symbol-module-key module-name constructor-name)]
        [next-display : String
          (compiler-symbol-module-key module-name next-base)]
        [constructor-id : i64
          (macro-core-for-qualified-value-id ctx module-id constructor-name)]
        [next-id : i64
          (macro-core-for-qualified-value-id ctx module-id next-base)]
        (match (macro-core-for-function-return
          ctx
          env
          source-expr
          source-ty
          constructor-id
          constructor-display)
          [(ResultMacroCoreForType.Ok constructor-ret)
            (match (macro-core-for-function-return
              ctx
              env
              source-expr
              source-ty
              next-id
              next-display)
              [(ResultMacroCoreForType.Ok next-ret)
                (macro-core-for-protocol-after-next
                  ctx
                  env
                  source-expr
                  source-ty
                  constructor-id
                  constructor-ret
                  next-id
                  next-display
                  next-ret)]
              [(ResultMacroCoreForType.Err diag)
                (ResultMacroCoreForProtocol.Err diag)])]
          [(ResultMacroCoreForType.Err diag)
            (ResultMacroCoreForProtocol.Err diag)])))))

(define (macro-core-for-prefix-count
  [args : (& args AstExprList)]
  [index : i64]) : i64
  (if (>= index (struct-get args len))
    index
    (match (ast-expr-unspan (ast-node-get (ast-expr-list-get args index 0)))
      [(AstExpr.BracketClause _) (macro-core-for-prefix-count args (+ index 1))]
      [_ index])))

(define (macro-core-for-source-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcType
  (match (ast-expr-unspan expr)
    [(AstExpr.Borrow mutable lifetime place-box)
      (match (tc-normalize-dotted-local-field-node! env place-box)
        [(ResultTcUnit.Ok)
          (tc-borrow-expr-with-policy
            ctx
            env
            mutable
            lifetime
            (ast-node-get place-box)
            true)]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [_ (tc-expr ctx env expr)]))

(define (macro-core-for-temp-id
  [_hygiene : MacroHygieneContext]
  [_depth : i64]
  [prefix : String]
  [index : i64]) : i64
  (tc-generated-name-id (str_cat.str-cat prefix (string.int->string index))))

(define (macro-core-for-plan-list-empty? [plans : MacroCoreForPlanList]) : bool
  (match plans
    [(MacroCoreForPlanList.Nil) true]
    [_ false]))

(define (macro-core-for-plan-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [hygiene : MacroHygieneContext]
  [depth : i64]
  [args : (& args AstExprList)]
  [index : i64]
  [count : i64]) : ResultMacroCoreForPlanList
  (if (>= index count)
    (ResultMacroCoreForPlanList.Ok MacroCoreForPlanList.Nil)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-expr-binding-clause-from-arg arg)
        [(ResultMacroBindingClause.Ok binding)
          (match binding
            [(AstExprBindingClause _ _ _ init _)
              (match (macro-expand-expr ctx env decls depth (ast-node-get init))
                [(ResultMacroExpr.Ok expanded-source)
                  (let
                    [expanded-expr : AstExpr (ast-node-get expanded-source)]
                    (match (macro-core-for-source-type ctx env expanded-expr)
                      [(ResultTcType.Ok source-ty)
                        (match (macro-core-for-protocol
                          ctx
                          env
                          expanded-expr
                          source-ty)
                          [(ResultMacroCoreForProtocol.Ok protocol)
                            (match (macro-core-for-plan-list
                              ctx
                              env
                              decls
                              hygiene
                              depth
                              args
                              (+ index 1)
                              count)
                              [(ResultMacroCoreForPlanList.Ok rest)
                                (if (and
                                  (>= (struct-get protocol item-cleanup) 0)
                                  (not (macro-core-for-plan-list-empty? rest)))
                                  (ResultMacroCoreForPlanList.Err
                                    (macro-core-for-diagnostic
                                      expanded-expr
                                      "typecheck: cleanup-owning for item binding must be final in a zipped loop"))
                                  (ResultMacroCoreForPlanList.Ok
                                    (MacroCoreForPlanList.Cons
                                      (MacroCoreForPlan
                                        binding
                                        expanded-source
                                        (match (tc-type-strip-region
                                          (tc-resolve-type ctx source-ty))
                                          [(AstType.MutRef _ _) false]
                                          [_
                                            (not
                                              (tc-cleanup-owning-aggregate-type?
                                                ctx
                                                source-ty))])
                                        (macro-core-for-temp-id
                                          hygiene
                                          depth
                                          "__for_source_"
                                          index)
                                        (macro-core-for-temp-id
                                          hygiene
                                          depth
                                          "__for_iterator_"
                                          index)
                                        protocol)
                                      (box rest))))]
                              [(ResultMacroCoreForPlanList.Err diag)
                                (ResultMacroCoreForPlanList.Err diag)])]
                          [(ResultMacroCoreForProtocol.Err diag)
                            (ResultMacroCoreForPlanList.Err diag)])]
                      [(ResultTcType.Err message)
                        (ResultMacroCoreForPlanList.Err
                          (macro-core-for-diagnostic expanded-expr message))]))]
                [(ResultMacroExpr.Err diag)
                  (ResultMacroCoreForPlanList.Err diag)])])]
        [(ResultMacroBindingClause.Err diag)
          (ResultMacroCoreForPlanList.Err diag)]))))

(define (macro-core-for-source-bindings-into
  [plans : MacroCoreForPlanList]
  [out : (&mut out AstLetBindingList)]) : unit
  (match plans
    [(MacroCoreForPlanList.Nil) unit]
    [(MacroCoreForPlanList.Cons plan rest)
      (begin
        (if (struct-get plan source-temp?)
          (ast-let-binding-list-push
            out
            (ast-let-binding-id
              (struct-get plan source-temp)
              AstMaybeType.No
              (struct-get plan source)))
          unit)
        (macro-core-for-source-bindings-into (box-get rest) out))]))

(define (macro-core-for-iterator-scopes
  [plans : MacroCoreForPlanList]
  [inner : i64]) : i64
  (match plans
    [(MacroCoreForPlanList.Nil) inner]
    [(MacroCoreForPlanList.Cons plan rest)
      (let
        [protocol : MacroCoreForProtocol (struct-get plan protocol)]
        [next-scope : i64 (macro-core-for-iterator-scopes (box-get rest) inner)]
        [init : i64
          (macro-core-for-call1
            (struct-get protocol constructor)
            (if (struct-get plan source-temp?)
              (macro-core-for-var (struct-get plan source-temp))
              (struct-get plan source)))]
        [cleanup : i64 (struct-get protocol cleanup)]
        (if (>= cleanup 0)
          (let
            [bindings : AstResourceBindingList (ast-resource-binding-list-new)]
            [body : AstExprList (ast-expr-list-with-capacity 1)]
            (begin
              (ast-resource-binding-list-push
                (&mut bindings)
                (ast-resource-binding-id
                  (struct-get plan iterator-temp)
                  init
                  (macro-core-for-var cleanup)))
              (ast-expr-list-push (&mut body) next-scope)
              (ast-node-push
                (AstExpr.WithResource
                  (box (AstWithResource.WithResource bindings body))))))
          (let
            [bindings : AstLetBindingList (ast-let-binding-list-new)]
            (begin
              (ast-let-binding-list-push
                (&mut bindings)
                (ast-let-binding-id
                  (struct-get plan iterator-temp)
                  AstMaybeType.No
                  init))
              (ast-expr-let bindings next-scope)))))]))

(define (macro-core-for-binding-maybe-type
  [ctx : TcContext]
  [decls : AstDeclList]
  [binding : AstExprBindingClause]) : ResultMacroCoreForType
  (match binding
    [(AstExprBindingClause _ has-type ty _ _)
      (if has-type
        (macro-core-for-binding-type-arg ctx decls (ast-node-get ty))
        (ResultMacroCoreForType.Ok (AstType.Never)))]))

(define (macro-core-for-binding-type-arg
  [ctx : TcContext]
  [decls : AstDeclList]
  [arg : AstExpr]) : ResultMacroCoreForType
  (match (ast-expr-unspan arg)
    [(AstExpr.Borrow mutable lifetime target)
      (match (macro-core-for-binding-type-arg ctx decls (ast-node-get target))
        [(ResultMacroCoreForType.Ok inner)
          (let
            [region : i64
              (match lifetime
                [(AstBorrowLifetime.Inferred) cbi.compiler-builtin-id-fix-empty]
                [(AstBorrowLifetime.Named name) name])]
            (ResultMacroCoreForType.Ok
              (if mutable
                (ast-ty-mut-ref region inner)
                (ast-ty-ref region inner))))]
        [(ResultMacroCoreForType.Err diag) (ResultMacroCoreForType.Err diag)])]
    [_
      (match (macro-type-arg ctx decls arg)
        [(ResultMacroTypeArg.Ok resolved) (ResultMacroCoreForType.Ok resolved)]
        [(ResultMacroTypeArg.Err diag) (ResultMacroCoreForType.Err diag)])]))

(define (macro-core-for-item-pattern
  [ctx : TcContext]
  [decls : AstDeclList]
  [binding : AstExprBindingClause]) : ResultMacroCoreForType
  (macro-core-for-binding-maybe-type ctx decls binding))

(define (macro-core-for-one-match
  [ctx : TcContext]
  [decls : AstDeclList]
  [plan : MacroCoreForPlan]
  [done-name : i64]
  [inner : i64]) : ResultMacroExpr
  (let
    [binding : AstExprBindingClause (struct-get plan binding)]
    (match (macro-core-for-item-pattern ctx decls binding)
      [(ResultMacroCoreForType.Ok annotation)
        (match binding
          [(AstExprBindingClause name has-type _ _ _)
            (let
              [protocol : MacroCoreForProtocol (struct-get plan protocol)]
              [item-patterns : AstPatternList
                (ast-pattern-cons
                  (if has-type
                    (AstPattern.Var name (AstMaybeType.Some annotation))
                    (AstPattern.Binding name))
                  (ast-pattern-list-new))]
              [done-pattern : AstPattern
                (ast-pat-variant-id
                  (macro-core-for-source-name-id ctx "Done")
                  (ast-pattern-list-new))]
              [item-pattern : AstPattern
                (ast-pat-variant-id
                  (macro-core-for-source-name-id ctx "Item")
                  item-patterns)]
              [arms : AstMatchArmList (ast-match-arm-list-with-capacity 2)]
              [next-call : i64
                (macro-core-for-call1
                  (struct-get protocol next)
                  (ast-expr-borrow
                    true
                    AstBorrowLifetime.Inferred
                    (macro-core-for-var (struct-get plan iterator-temp))))]
              (begin
                (ast-match-arm-list-push
                  (&mut arms)
                  (ast-match-arm
                    done-pattern
                    (ast-expr-set-id done-name (macro-core-bool-lit true))))
                (ast-match-arm-list-push
                  (&mut arms)
                  (ast-match-arm item-pattern inner))
                (ResultMacroExpr.Ok (ast-expr-match next-call arms))))])]
      [(ResultMacroCoreForType.Err diag) (ResultMacroExpr.Err diag)])))

(define (macro-core-for-match-chain
  [ctx : TcContext]
  [decls : AstDeclList]
  [plans : MacroCoreForPlanList]
  [done-name : i64]
  [body : i64]) : ResultMacroExpr
  (match plans
    [(MacroCoreForPlanList.Nil) (ResultMacroExpr.Ok body)]
    [(MacroCoreForPlanList.Cons plan rest)
      (match (macro-core-for-match-chain
        ctx
        decls
        (box-get rest)
        done-name
        body)
        [(ResultMacroExpr.Ok inner)
          (macro-core-for-one-match ctx decls plan done-name inner)]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]))

(define (macro-core-for-build
  [ctx : TcContext]
  [decls : AstDeclList]
  [plans : MacroCoreForPlanList]
  [hygiene : MacroHygieneContext]
  [depth : i64]
  [body : AstExprList]) : ResultMacroExpr
  (let
    [done-name : i64 (macro-core-for-temp-id hygiene depth "__for_done_" 0)]
    [source-bindings : AstLetBindingList (ast-let-binding-list-new)]
    [body-expr : i64
      (ast-node-push (AstExpr.Begin (macro-compat-append-unit body)))]
    (begin
      (macro-core-for-source-bindings-into plans (&mut source-bindings))
      (let
        [loop-bindings : AstLetBindingList (ast-let-binding-list-new)]
        (begin
          (ast-let-binding-list-push
            (&mut loop-bindings)
            (ast-let-binding-id
              done-name
              (AstMaybeType.Some (AstType.Bool))
              (macro-core-bool-lit false)))
          (match (macro-core-for-match-chain
            ctx
            decls
            plans
            done-name
            body-expr)
            [(ResultMacroExpr.Ok loop-body)
              (let
                [loop-expr : i64
                  (ast-expr-while
                    (ast-expr-unary AstUnOp.Not (macro-core-for-var done-name))
                    loop-body)]
                [result-body : AstExprList (ast-expr-list-with-capacity 2)]
                (begin
                  (ast-expr-list-push (&mut result-body) loop-expr)
                  (ast-expr-list-push
                    (&mut result-body)
                    (macro-compat-unit-expr))
                  (let
                    [loop-scope : i64
                      (ast-expr-let
                        loop-bindings
                        (ast-node-push (AstExpr.Begin result-body)))]
                    (ResultMacroExpr.Ok
                      (ast-expr-let
                        source-bindings
                        (macro-core-for-iterator-scopes plans loop-scope))))))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))))))

(define (macro-core-and-chain [args : (& args AstExprList)] [index : i64]) : i64
  (if (>= index (struct-get args len))
    (macro-core-bool-lit true)
    (ast-expr-if
      (ast-expr-list-get args index 0)
      (macro-core-and-chain args (+ index 1))
      (macro-core-bool-lit false))))

(define (macro-core-or-chain [args : (& args AstExprList)] [index : i64]) : i64
  (if (>= index (struct-get args len))
    (macro-core-bool-lit false)
    (ast-expr-if
      (ast-expr-list-get args index 0)
      (macro-core-bool-lit true)
      (macro-core-or-chain args (+ index 1)))))

(define (macro-core-var-lit [name : String]) : i64
  (ast-node-push (AstExpr.Var (tc-generated-name-id name))))

(define (macro-core-cond-else? [expr-id : i64]) : bool
  (match (ast-expr-unspan (ast-node-get expr-id))
    [(AstExpr.Var name) (= name cbi.compiler-builtin-id-fix-else)]
    [_ false]))

(define (macro-core-cond-chain
  [clauses : (& clauses AstExprClauseList)]
  [index : i64]) : i64
  (let
    [n : i64 (struct-get clauses len)]
    (if (>= index n)
      (macro-core-var-lit "core-cond-missing-else")
      (match (ast-expr-clause-list-get clauses index (ast-expr-clause-fallback))
        [(AstExprClause test result)
          (if (macro-core-cond-else? test)
            (if (= (+ index 1) n)
              result
              (macro-core-var-lit "core-cond-else-must-be-final"))
            (if (= (+ index 1) n)
              (macro-core-var-lit "core-cond-missing-else")
              (ast-expr-if
                test
                result
                (macro-core-cond-chain clauses (+ index 1)))))]))))

(define (macro-core-boolean-macro?
  [macro-name : String]
  [definition-module : String]
  [base : String]) : bool
  (and
    (string.eq definition-module "stdlib.core_macros")
    (tc-name-spelling-base-eq? macro-name base)))

(define (macro-core-cond-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (string.eq definition-module "stdlib.core_macros")
    (tc-name-spelling-base-eq? macro-name "cond")))

(define (macro-core-for-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (string.eq definition-module "stdlib.core_macros")
    (tc-name-spelling-base-eq? macro-name "for")))

(define (macro-core-boolean-signature?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]) : bool
  (if (= (ast-macro-param-list-len (& params)) 1)
    (match (ast-macro-param-list-get (& params) 0 (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty variadic _)
        (and
          variadic
          (tc-type-eq
            (macro-resolve-signature-type-id
              ctx
              definition-module
              definition-module-id
              ty)
            (AstType.Bool)))])
    false))

(define (macro-core-for-signature?
  [ctx : TcContext]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]) : bool
  (if (= (ast-macro-param-list-len (& params)) 1)
    (match (ast-macro-param-list-get (& params) 0 (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty variadic _)
        (and
          variadic
          (tc-type-eq
            (macro-resolve-signature-type-id
              ctx
              definition-module
              definition-module-id
              ty)
            (AstType.Expr)))])
    false))

(define (macro-core-boolean-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]
  [_macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]
  [is-or : bool]) : ResultMacroExpr
  (match (macro-expand-exprs ctx type-env decls depth args)
    [(ResultMacroExprList.Ok expanded-args)
      (match (macro-bind-params
        ctx
        decls
        definition-module
        definition-module-id
        type-env
        _macro-name
        params
        expanded-args
        (ctfe-env-empty)
        false
        call-expr)
        [(ResultMacroEnv.Ok _)
          (begin
            (cfg compile-profile (compiler-tc-macro-profile-start))
            (let
              [expanded : i64
                (if is-or
                  (macro-core-or-chain (& expanded-args) 0)
                  (macro-core-and-chain (& expanded-args) 0))]
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish _macro-name expanded-args))
                (macro-expand-expr
                  ctx
                  type-env
                  decls
                  (+ depth 1)
                  (ast-node-get expanded)))))]
        [(ResultMacroEnv.Err diag) (ResultMacroExpr.Err diag)])]
    [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)]))

(define (macro-core-cond-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]
  [_macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroExpr
  (match (macro-bind-params
    ctx
    decls
    definition-module
    definition-module-id
    type-env
    _macro-name
    params
    args
    (ctfe-env-empty)
    false
    call-expr)
    [(ResultMacroEnv.Ok _)
      (match (macro-expr-clause-list-from-args args)
        [(ResultMacroClauseList.Ok clauses)
          (begin
            (cfg compile-profile (compiler-tc-macro-profile-start))
            (let
              [expanded : i64 (macro-core-cond-chain (& clauses) 0)]
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish _macro-name args))
                (macro-expand-expr
                  ctx
                  type-env
                  decls
                  (+ depth 1)
                  (ast-node-get expanded)))))]
        [(ResultMacroClauseList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ResultMacroEnv.Err diag) (ResultMacroExpr.Err diag)]))

(define (macro-core-for-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [_macro-name : String]
  [definition-module-id : i64]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroExpr
  (let
    [args-ref : (& args AstExprList) (& args)]
    [count : i64 (struct-get args-ref len)]
    [binding-count : i64 (macro-core-for-prefix-count args-ref 0)]
    (cond
      [(= binding-count 0)
        (ResultMacroExpr.Err
          (macro-core-for-diagnostic
            call-expr
            "typecheck: for expects at least one leading binding clause [name source] or [name : Type source]"))]
      [(>= binding-count count)
        (ResultMacroExpr.Err
          (macro-core-for-diagnostic
            call-expr
            "typecheck: for expects at least one body expression after its binding clauses"))]
      [else
        (let
          [hygiene : MacroHygieneContext
            (MacroHygieneContext
              macro-name-id
              definition-module-id
              declaration-id
              (tc-context-symbols ctx))]
          [body : AstExprList
            (ast-expr-list-tail-from-ref args-ref binding-count)]
          (match (macro-core-for-plan-list
            ctx
            type-env
            decls
            hygiene
            (+ depth 1)
            args-ref
            0
            binding-count)
            [(ResultMacroCoreForPlanList.Ok plans)
              (match (macro-expand-exprs ctx type-env decls depth body)
                [(ResultMacroExprList.Ok expanded-body)
                  (begin
                    (cfg compile-profile (compiler-tc-macro-profile-start))
                    (match (macro-core-for-build
                      ctx
                      decls
                      plans
                      hygiene
                      (+ depth 1)
                      expanded-body)
                      [(ResultMacroExpr.Ok expanded)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-macro-profile-finish _macro-name args))
                          (ResultMacroExpr.Ok expanded))]
                      [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroCoreForPlanList.Err diag) (ResultMacroExpr.Err diag)]))])))

;; Run an expression-position macro transformer via CTFE and re-expand its
;; produced form to a fixpoint.
(define (macro-expand-call
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [definition-module : String]
  [definition-module-id : i64]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroExpr
  (if (tc-macro-result-module? ret)
    (ResultMacroExpr.Err
      (box
        (ctfe-diagnostic-at-expr
          call-expr
          "typecheck: Module macro can only be used in import position")))
    (if (tc-macro-result-decls? ret)
      (ResultMacroExpr.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Decls macro can only be used at module scope")))
      (cond
        [(and
            (macro-core-boolean-macro? macro-name definition-module "and")
            (macro-core-boolean-signature?
              ctx
              definition-module
              definition-module-id
              params))
          (macro-core-boolean-fast-expand
            ctx
            type-env
            decls
            definition-module
            definition-module-id
            params
            macro-name
            args
            depth
            call-expr
            false)]
        [(and
            (macro-core-boolean-macro? macro-name definition-module "or")
            (macro-core-boolean-signature?
              ctx
              definition-module
              definition-module-id
              params))
          (macro-core-boolean-fast-expand
            ctx
            type-env
            decls
            definition-module
            definition-module-id
            params
            macro-name
            args
            depth
            call-expr
            true)]
        [(macro-core-cond-macro? macro-name definition-module)
          (macro-core-cond-fast-expand
            ctx
            type-env
            decls
            definition-module
            definition-module-id
            params
            macro-name
            args
            depth
            call-expr)]
        [(and
            (macro-core-for-macro? macro-name definition-module)
            (macro-core-for-signature?
              ctx
              definition-module
              definition-module-id
              params))
          (macro-core-for-fast-expand
            ctx
            type-env
            decls
            macro-name-id
            declaration-id
            macro-name
            definition-module-id
            args
            depth
            call-expr)]
        [else
          (match (macro-eval-transformer
            ctx
            type-env
            decls
            definition-module
            definition-module-id
            macro-name
            params
            body
            args
            depth
            call-expr)
            [(ResultMacroValue.Ok value)
              (match value
                [(CompilerCtfeValue.Expr expanded produced)
                  (if (tc-macro-produced-type-compatible? ctx ret produced)
                    (macro-expand-expr
                      ctx
                      type-env
                      decls
                      (+ depth 1)
                      (ast-node-get
                        (macro-hygiene-expr
                          (ast-node-get expanded)
                          MacroHygieneEnv.Nil
                          (MacroHygieneContext
                            macro-name-id
                            definition-module-id
                            declaration-id
                            (tc-context-symbols ctx))
                          (+ depth 1))))
                    (ResultMacroExpr.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: macro expansion produced type does not match declaration"))))]
                [(CompilerCtfeValue.CapturedExpr expanded produced pools)
                  (if (tc-macro-produced-type-compatible? ctx ret produced)
                    (begin
                      ;; CTFE built this syntax beside the checked caller
                      ;; operands. Install that pool before applying hygiene.
                      (tc-install-pools! pools)
                      (tc-context-capture-active-pools! ctx)
                      (macro-expand-expr
                        ctx
                        type-env
                        decls
                        (+ depth 1)
                        (ast-node-get
                          (macro-hygiene-expr
                            (ast-node-get expanded)
                            MacroHygieneEnv.Nil
                            (MacroHygieneContext
                              macro-name-id
                              definition-module-id
                              declaration-id
                              (tc-context-symbols ctx))
                            (+ depth 1)))))
                    (ResultMacroExpr.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: macro expansion produced type does not match declaration"))))]
                [_
                  (ResultMacroExpr.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "macro transformer did not produce an Expr")))])]
            [(ResultMacroValue.Err diag) (ResultMacroExpr.Err diag)])]))))

(define (macro-expand-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [exprs : AstExprList]) : ResultMacroExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (match (macro-expand-exprs-into ctx env decls depth (& exprs) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroExprList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroExprList.Err diag)])))

(define (macro-expand-exprs-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstExprList)]) : ResultMacroCheck
  (if (>= index (struct-get exprs len))
    (ResultMacroCheck.Ok)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-expand-expr ctx env decls depth head)
        [(ResultMacroExpr.Ok nhead)
          (begin
            (ast-expr-list-push out nhead)
            (macro-expand-exprs-into ctx env decls depth exprs (+ index 1) out))]
        [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expand-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultMacroArms
  (let
    [out : AstMatchArmList
      (ast-match-arm-list-with-capacity (struct-get (& arms) len))]
    (match (macro-expand-arms-into
      ctx
      env
      decls
      depth
      scrut-ty
      (& arms)
      0
      (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroArms.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroArms.Err diag)])))

(define (macro-expand-arms-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [out : (&mut out AstMatchArmList)]) : ResultMacroCheck
  (if (>= index (struct-get arms len))
    (ResultMacroCheck.Ok)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (macro-expand-expr ctx arm-env decls depth body)
                [(ResultMacroExpr.Ok nbody)
                  (begin
                    (ast-match-arm-list-push out (ast-match-arm pattern nbody))
                    (macro-expand-arms-into
                      ctx
                      env
                      decls
                      depth
                      scrut-ty
                      arms
                      (+ index 1)
                      out))]
                [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)])]
            [(ResultTcEnv.Err message)
              (ResultMacroCheck.Err (box (tc-expr-diag body message)))]))])))

(define (macro-expand-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : AstLetBindingList]) : ResultMacroLetBindings
  (let
    [out : AstLetBindingList
      (ast-let-binding-list-with-capacity
        (ast-let-binding-list-len (& bindings)))]
    (match (macro-expand-bindings-into
      ctx
      env
      decls
      depth
      (& bindings)
      0
      (&mut out))
      [(ResultMacroLetBindingsBuild.Ok final-env)
        (ResultMacroLetBindings.Ok out final-env)]
      [(ResultMacroLetBindingsBuild.Err diag) (ResultMacroLetBindings.Err diag)])))

(define (macro-expand-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]
  [out : (&mut out AstLetBindingList)]) : ResultMacroLetBindingsBuild
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultMacroLetBindingsBuild.Ok env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (macro-expand-expr ctx env decls depth init)
            [(ResultMacroExpr.Ok ninit)
              (match (tc-let-bindings
                ctx
                env
                (ast-let-binding-cons
                  (ast-let-binding-id name maybe-ty ninit)
                  (ast-let-binding-list-new)))
                [(ResultTcEnv.Ok next-env)
                  (begin
                    (ast-let-binding-list-push
                      out
                      (ast-let-binding-id name maybe-ty ninit))
                    (macro-expand-bindings-into
                      ctx
                      next-env
                      decls
                      depth
                      bindings
                      (+ index 1)
                      out))]
                [(ResultTcEnv.Err message)
                  (ResultMacroLetBindingsBuild.Err
                    (box (tc-expr-diag (ast-node-get ninit) message)))])]
            [(ResultMacroExpr.Err diag) (ResultMacroLetBindingsBuild.Err diag)]))])))

(define (macro-expand-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : AstResourceBindingList]) : ResultMacroResourceBindings
  (let
    [out : AstResourceBindingList
      (ast-resource-binding-list-with-capacity
        (ast-resource-binding-list-len (& bindings)))]
    (match (macro-expand-resource-bindings-into
      ctx
      env
      decls
      depth
      (& bindings)
      0
      (&mut out))
      [(ResultMacroResourceBindingsBuild.Ok final-env)
        (ResultMacroResourceBindings.Ok out final-env)]
      [(ResultMacroResourceBindingsBuild.Err diag)
        (ResultMacroResourceBindings.Err diag)])))

(define (macro-expand-resource-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]
  [out : (&mut out AstResourceBindingList)]) : ResultMacroResourceBindingsBuild
  (if (>= index (ast-resource-binding-list-len bindings))
    (ResultMacroResourceBindingsBuild.Ok env)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (macro-expand-expr ctx env decls depth init)
            [(ResultMacroExpr.Ok ninit)
              (match (macro-expand-expr ctx env decls depth cleanup)
                [(ResultMacroExpr.Ok ncleanup)
                  (let
                    [binding : AstResourceBinding
                      (ast-resource-binding-id name ninit ncleanup)]
                    [single : AstResourceBindingList
                      (ast-resource-binding-cons
                        binding
                        (ast-resource-binding-list-new))]
                    (match (tc-resource-bindings ctx env single)
                      [(ResultTcEnv.Ok next-env)
                        (begin
                          (ast-resource-binding-list-push out binding)
                          (macro-expand-resource-bindings-into
                            ctx
                            next-env
                            decls
                            depth
                            bindings
                            (+ index 1)
                            out))]
                      [(ResultTcEnv.Err message)
                        (ResultMacroResourceBindingsBuild.Err
                          (box (tc-expr-diag (ast-node-get ninit) message)))]))]
                [(ResultMacroExpr.Err diag)
                  (ResultMacroResourceBindingsBuild.Err diag)])]
            [(ResultMacroExpr.Err diag)
              (ResultMacroResourceBindingsBuild.Err diag)]))])))

(define (macro-compat-unit-expr) : i64
  (ast-node-push (AstExpr.Literal AstLiteral.Unit)))

(define (macro-compat-append-unit [exprs : AstExprList]) : AstExprList
  (let
    [out : AstExprList
      (ast-expr-list-with-capacity (+ (struct-get (& exprs) len) 1))]
    (begin
      (ast-expr-list-append-from (&mut out) (& exprs) 0)
      (ast-expr-list-push (&mut out) (macro-compat-unit-expr))
      out)))

(define (macro-compat-call-name [func : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan func)
    [(AstExpr.Var name)
      (if (or
        (macro-hygiene-global-id? name)
        (tc-structural-local-name-id? name)
        (compiler-composite-pair-key-id? name)
        (compiler-composite-triple-key-id? name))
        (TcMaybeString.No)
        (TcMaybeString.Some (tc-env-key-name-text name)))]
    [_ (TcMaybeString.No)]))

(define (macro-compat-guard-message [name : String]) : String
  (if (string.eq name "unless")
    "parse: unless expects a condition and at least one body expression"
    "parse: when expects a condition and at least one body expression"))

(define (macro-expand-compat-guard-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [cond : AstExpr]
  [body : AstExprList]
  [is-unless : bool]) : ResultMacroCompatCall
  (match (macro-expand-expr ctx env decls depth cond)
    [(ResultMacroExpr.Ok ncond)
      (match (macro-expand-exprs ctx env decls depth body)
        [(ResultMacroExprList.Ok nbody)
          (let
            [unit-expr : i64 (macro-compat-unit-expr)]
            [body-expr : i64
              (ast-node-push (AstExpr.Begin (macro-compat-append-unit nbody)))]
            (if is-unless
              (ResultMacroCompatCall.Ok (ast-expr-if ncond unit-expr body-expr))
              (ResultMacroCompatCall.Ok (ast-expr-if ncond body-expr unit-expr))))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-expand-compat-guard-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [name : String]
  [args : AstExprList]
  [is-unless : bool]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (< (struct-get (& args) len) 2)
    (ResultMacroCompatCall.Err
      (box
        (ctfe-diagnostic-at-expr call-expr (macro-compat-guard-message name))))
    (macro-expand-compat-guard-body
      ctx
      env
      decls
      depth
      (ast-node-get (ast-expr-list-get (& args) 0 0))
      (ast-expr-list-tail-from-ref (& args) 1)
      is-unless)))

(define (macro-expand-compat-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [func : AstExpr]
  [args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match (macro-compat-call-name func)
    [(TcMaybeString.Some name)
      (if (string.eq name "when")
        (macro-expand-compat-guard-call
          ctx
          env
          decls
          depth
          name
          args
          false
          call-expr)
        (if (string.eq name "unless")
          (macro-expand-compat-guard-call
            ctx
            env
            decls
            depth
            name
            args
            true
            call-expr)
          (ResultMacroCompatCall.No)))]
    [(TcMaybeString.No) (ResultMacroCompatCall.No)]))

(define (macro-expand-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [expr : AstExpr]) : ResultMacroExpr
  (if (or
    (not (macro-expr-might-fire? expr))
    (< (macro-expand-depth-limit) depth))
    (if (not (macro-expr-might-fire? expr))
      (ResultMacroExpr.Ok (ast-node-push expr))
      (ResultMacroExpr.Err
        (box
          (ctfe-diagnostic-at-expr expr "macro expansion exceeded depth limit"))))
    (match expr
      [(AstExpr.Spanned inner-box span)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-spanned ninner span))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [callee-maybe-macro : bool (macro-call-callee-maybe-macro? func)]
          (if callee-maybe-macro
            (match (macro-call-decl ctx func decls expr)
              [(ResultMacroCallDecl.Ok maybe-decl)
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (macro-expand-call
                      ctx
                      env
                      decls
                      macro-name
                      declaration-id
                      (macro-decl-name-display macro-name definition-module)
                      (macro-decl-module-display definition-module)
                      definition-module
                      params
                      ret
                      body
                      args
                      depth
                      expr)]
                  [(MacroMaybeDecl.No)
                    (match (macro-expand-compat-call
                      ctx
                      env
                      decls
                      depth
                      func
                      args
                      expr)
                      [(ResultMacroCompatCall.Ok expanded)
                        (ResultMacroExpr.Ok expanded)]
                      [(ResultMacroCompatCall.No)
                        (match (macro-expand-expr ctx env decls depth func)
                          [(ResultMacroExpr.Ok nfunc)
                            (match (macro-expand-exprs ctx env decls depth args)
                              [(ResultMacroExprList.Ok nargs)
                                (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                              [(ResultMacroExprList.Err diag)
                                (ResultMacroExpr.Err diag)])]
                          [(ResultMacroExpr.Err diag)
                            (ResultMacroExpr.Err diag)])]
                      [(ResultMacroCompatCall.Err diag)
                        (ResultMacroExpr.Err diag)])])]
              [(ResultMacroCallDecl.Err diag) (ResultMacroExpr.Err diag)])
            (match (macro-expand-expr ctx env decls depth func)
              [(ResultMacroExpr.Ok nfunc)
                (match (macro-expand-exprs ctx env decls depth args)
                  [(ResultMacroExprList.Ok nargs)
                    (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                  [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
              [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])))]
      [(AstExpr.BracketClause items)
        (match (macro-expand-exprs ctx env decls depth items)
          [(ResultMacroExprList.Ok nitems)
            (ResultMacroExpr.Ok (ast-expr-bracket-clause nitems))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Binary op left-box right-box)
        (let
          [left : AstExpr (ast-node-get left-box)]
          [right : AstExpr (ast-node-get right-box)]
          (match (macro-expand-expr ctx env decls depth left)
            [(ResultMacroExpr.Ok nleft)
              (match (macro-expand-expr ctx env decls depth right)
                [(ResultMacroExpr.Ok nright)
                  (ResultMacroExpr.Ok (ast-expr-binary op nleft nright))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Unary op inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-unary op ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.If cond-box then-branch-box else-branch-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [then-branch : AstExpr (ast-node-get then-branch-box)]
          [else-branch : AstExpr (ast-node-get else-branch-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth then-branch)
                [(ResultMacroExpr.Ok nthen)
                  (match (macro-expand-expr ctx env decls depth else-branch)
                    [(ResultMacroExpr.Ok nelse)
                      (ResultMacroExpr.Ok (ast-expr-if ncond nthen nelse))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Let let-box)
        (match (box-get let-box)
          [(AstLet.Let bindings body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-bindings ctx env decls depth bindings)
                [(ResultMacroLetBindings.Ok nbindings body-env)
                  (match (macro-expand-expr ctx body-env decls depth body)
                    [(ResultMacroExpr.Ok nbody)
                      (ResultMacroExpr.Ok (ast-expr-let nbindings nbody))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroLetBindings.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Begin exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Begin nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Unsafe exprs)
        ;; Expansion typechecks some sub-expressions (e.g. `match` scrutinees) via
        ;; `tc-expr`; descend with the unsafe marker set so those checks see the
        ;; enclosing `unsafe` context, matching the real typecheck pass. Without
        ;; this, an `unsafe`-only primitive under an `(unsafe ...)` reachable here
        ;; is wrongly rejected once the program defines a macro.
        (match (macro-expand-exprs ctx (tc-enter-unsafe env) decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Unsafe nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Tuple exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Tuple nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Array exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Array nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.DynArray exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.DynArray nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.MakeArray ty len-box)
        (let
          [len : AstExpr (ast-node-get len-box)]
          (match (macro-expand-expr ctx env decls depth len)
            [(ResultMacroExpr.Ok nlen)
              (ResultMacroExpr.Ok (ast-expr-make-array ty nlen))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Match match-box)
        (match (box-get match-box)
          [(AstMatch.Match scrut-box arms)
            (let
              [scrut : AstExpr (ast-node-get scrut-box)]
              (match (macro-expand-expr ctx env decls depth scrut)
                [(ResultMacroExpr.Ok nscrut)
                  (match (tc-expr ctx env (ast-node-get nscrut))
                    [(ResultTcType.Ok scrut-ty)
                      (match (macro-expand-arms
                        ctx
                        env
                        decls
                        depth
                        scrut-ty
                        arms)
                        [(ResultMacroArms.Ok narms)
                          (ResultMacroExpr.Ok (ast-expr-match nscrut narms))]
                        [(ResultMacroArms.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultTcType.Err message)
                      (ResultMacroExpr.Err
                        (box (tc-expr-diag (ast-node-get nscrut) message)))])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.While cond-box body-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [body : AstExpr (ast-node-get body-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-while ncond nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Foreach fe-box)
        (match (box-get fe-box)
          [(AstForeach.Foreach index index-ty start-box end-box body-box)
            (let
              [start : AstExpr (ast-node-get start-box)]
              [end : AstExpr (ast-node-get end-box)]
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr ctx env decls depth start)
                [(ResultMacroExpr.Ok nstart)
                  (match (macro-expand-expr ctx env decls depth end)
                    [(ResultMacroExpr.Ok nend)
                      (match (macro-expand-expr
                        ctx
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))
                        decls
                        depth
                        body)
                        [(ResultMacroExpr.Ok nbody)
                          (ResultMacroExpr.Ok
                            (ast-expr-foreach-id
                              index
                              index-ty
                              nstart
                              nend
                              nbody))]
                        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Lambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda.Lambda params maybe-ret body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr
                ctx
                (match maybe-ret
                  [(AstMaybeType.Some ret)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (tc-resolve-type ctx ret))]
                  [(AstMaybeType.No)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (AstType.Never))])
                decls
                depth
                body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-lambda params maybe-ret nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Ann inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-ann ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Cast inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-cast ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Borrow mutable lifetime place-box)
        (let
          [place : AstExpr (ast-node-get place-box)]
          (match (macro-expand-expr ctx env decls depth place)
            [(ResultMacroExpr.Ok nplace)
              (ResultMacroExpr.Ok (ast-expr-borrow mutable lifetime nplace))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StructGet inner-box field)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-struct-get-id ninner field))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StructSet inner-box field value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok
                    (ast-expr-struct-set-id ninner field nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.WithRegion region body)
        (match (macro-expand-exprs
          ctx
          (tc-push-region env region)
          decls
          depth
          body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok
              (ast-node-push (AstExpr.WithRegion region nbody)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.WithEscape scratch-box body)
        (let
          [scratch : AstExpr (ast-node-get scratch-box)]
          (match (macro-expand-expr ctx env decls depth scratch)
            [(ResultMacroExpr.Ok nscratch)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-with-escape nscratch nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.WithScratch body)
        (match (macro-expand-exprs ctx env decls depth body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok (ast-expr-with-scratch nbody))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.InArena arena-box body)
        (let
          [arena : AstExpr (ast-node-get arena-box)]
          (match (macro-expand-expr ctx env decls depth arena)
            [(ResultMacroExpr.Ok narena)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-in-arena narena nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArrayRef array-box index-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (ResultMacroExpr.Ok (ast-expr-array-ref narray nindex))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArraySet array-box index-box value-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (match (macro-expand-expr ctx env decls depth value)
                    [(ResultMacroExpr.Ok nvalue)
                      (ResultMacroExpr.Ok
                        (ast-expr-array-set narray nindex nvalue))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArrayTake array-box live-box index-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [live : AstExpr (ast-node-get live-box)]
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth live)
                [(ResultMacroExpr.Ok nlive)
                  (match (macro-expand-expr ctx env decls depth index)
                    [(ResultMacroExpr.Ok nindex)
                      (ResultMacroExpr.Ok
                        (ast-expr-array-take narray nlive nindex))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.WithResource wr-box)
        (match (box-get wr-box)
          [(AstWithResource.WithResource bindings body)
            (match (macro-expand-resource-bindings ctx env decls depth bindings)
              [(ResultMacroResourceBindings.Ok nbindings body-env)
                (match (macro-expand-exprs ctx body-env decls depth body)
                  [(ResultMacroExprList.Ok nbody)
                    (ResultMacroExpr.Ok
                      (ast-node-push
                        (AstExpr.WithResource
                          (box (AstWithResource.WithResource nbindings nbody)))))]
                  [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
              [(ResultMacroResourceBindings.Err diag)
                (ResultMacroExpr.Err diag)])])]
      [(AstExpr.Box inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxGet inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-get ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxTake inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-take ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxSet inner-box value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok (ast-expr-box-set ninner nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Comptime inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-comptime ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Return inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-return ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Set name rhs-box)
        (let
          [rhs : AstExpr (ast-node-get rhs-box)]
          (match (macro-expand-expr ctx env decls depth rhs)
            [(ResultMacroExpr.Ok nrhs)
              (ResultMacroExpr.Ok (ast-expr-set-id name nrhs))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StringData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-string-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StringFromBytes ptr-box len-box)
        (let
          [ptr : AstExpr (ast-node-get ptr-box)]
          [len : AstExpr (ast-node-get len-box)]
          (match (macro-expand-expr ctx env decls depth ptr)
            [(ResultMacroExpr.Ok nptr)
              (match (macro-expand-expr ctx env decls depth len)
                [(ResultMacroExpr.Ok nlen)
                  (ResultMacroExpr.Ok (ast-expr-string-from-bytes nptr nlen))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArrayData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-array-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.PtrAddrOf place-box)
        (let
          [place : AstExpr (ast-node-get place-box)]
          (match (macro-expand-expr ctx env decls depth place)
            [(ResultMacroExpr.Ok nplace)
              (ResultMacroExpr.Ok (ast-expr-ptr-addr-of-id nplace))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BinaryData bytes)
        (ResultMacroExpr.Ok (ast-node-push (AstExpr.BinaryData bytes)))]
      [(AstExpr.SpmdProgramIndex)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-index))]
      [(AstExpr.SpmdProgramCount)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-count))]
      [(AstExpr.CpuIdEax leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-eax nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEbx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ebx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEcx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ecx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEdx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-edx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Xgetbv index-box)
        (let
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth index)
            [(ResultMacroExpr.Ok nindex)
              (ResultMacroExpr.Ok (ast-expr-xgetbv nindex))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Syscall args)
        (match (macro-expand-exprs ctx env decls depth args)
          [(ResultMacroExprList.Ok nargs)
            (ResultMacroExpr.Ok (ast-expr-syscall nargs))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [_ (ResultMacroExpr.Ok (ast-node-push expr))])))

(define (macro-expand-module-call-position
  [ctx : TcContext]
  [decls : AstDeclList]
  [call-id : i64]
  [import-position : bool]) : ResultMacroDecl
  (let
    [call-expr : AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(AstExpr.Call func-box _)
        (let
          [func : AstExpr (tc-context-expr-get ctx func-box)]
          (match (macro-call-decl ctx func decls call-expr)
            [(ResultMacroCallDecl.Ok maybe-decl)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ _ ret _)
                  (cond
                    [(and import-position (tc-macro-result-module? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro expansion is not implemented yet")))]
                    [(and import-position (tc-macro-result-decls? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro cannot be used in import position")))]
                    [import-position
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used as module import")))]
                    [(tc-macro-result-decls? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro expansion is not implemented yet")))]
                    [(tc-macro-result-module? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro can only be used in import position")))]
                    [else
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used at module scope")))])]
                [(MacroMaybeDecl.No)
                  (ResultMacroDecl.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: module-scope macro call must resolve to defmacro")))])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_
        (ResultMacroDecl.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [decl : AstDecl]) : ResultMacroDecl
  (let
    [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
    (match decl
      [(AstDecl.Def decl-meta name maybe-ty expr-box)
        (let
          [expr : AstExpr (ast-node-get expr-box)]
          (match (macro-expand-expr ctx global-env decls 0 expr)
            [(ResultMacroExpr.Ok nexpr)
              (ResultMacroDecl.Ok (ast-decl-def-id name maybe-ty nexpr))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDecl.DefFn decl-meta name params ret body-box metadata)
        (let
          [body : AstExpr (ast-node-get body-box)]
          [params-env : TcTypeEnv (tc-bind-params ctx global-env params)]
          [resolved-ret : AstType (tc-resolve-type ctx ret)]
          [body-env : TcTypeEnv (tc-bind-return-type params-env resolved-ret)]
          (match (macro-expand-expr ctx body-env decls 0 body)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroDecl.Ok
                (ast-decl-def-fn-metadata-id name params ret nbody metadata))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDecl.Test _ _ _) (ResultMacroDecl.Ok decl)]
      [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
        (match kind
          [(AstImportKind.Macro call-id _)
            (macro-expand-module-call-position ctx decls call-id true)]
          [(AstImportKind.MacroDecls call-id _)
            (macro-expand-module-call-position ctx decls call-id false)]
          [_ (ResultMacroDecl.Ok decl)])]
      [(AstDecl.Unsafe inner-box)
        (let
          [inner : AstDecl (box-get inner-box)]
          (match (macro-expand-decl ctx top-env decls inner)
            [(ResultMacroDecl.Ok ninner)
              (ResultMacroDecl.Ok (ast-decl-unsafe ninner))]
            [(ResultMacroDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_ (ResultMacroDecl.Ok decl)])))

(define (macro-single-decl-expansion [decl : AstDecl] [path : String]) : ResultMacroDeclExpansion
  (ResultMacroDeclExpansion.Ok
    (ast-decl-cons decl (ast-decl-list-new))
    (macro-paths-for-decls (ast-decl-cons decl (ast-decl-list-new)) path)))

(define (macro-env-for-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (ResultTcEnv.Ok top-env)
    (tc-module-local-env-id ctx top-env module module-id)))

(define (macro-module-import-marker-decls
  [target-module : String]
  [target-module-id : i64]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]) : AstDeclList
  (let
    [binding-alias : AstMaybeImportAlias
      (match alias
        [(AstMaybeImportAlias.No)
          (AstMaybeImportAlias.Some cbi.compiler-builtin-id-fix-empty)]
        [_ alias])]
    (ast-decl-cons
      (AstDecl.Import
        ast-decl-meta-runtime
        (AstImportSpec.Spec
          (AstImportKind.Module)
          target-module
          (AstMaybeModuleName.Some target-module-id)
          binding-alias
          (box span)))
      (ast-decl-list-new))))

(define (macro-module-import-marker-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Module) true]
        [_ false])]
    [_ false]))

(define (macro-module-import-marker-only? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Cons decl rest)
      (if (macro-module-import-marker-decl? decl)
        (match (ast-decl-list-step rest)
          [(AstDeclListStep.Nil) true]
          [_ false])
        false)]
    [(AstDeclListStep.Nil) false]))

(define (macro-decl-list-filter-path
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [wanted-path : String]) : AstDeclList
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [path-rest : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ next) next]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              (begin
                (if (string.eq decl-path wanted-path)
                  (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                  unit)
                (set! cur-decls rest)
                (set! cur-paths path-rest)))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-extend-top-env-with-module-marker
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [all-decls : AstDeclList]
  [decls : AstDeclList]
  [_module : String]
  [module-id : i64]) : ResultTcEnv
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Cons decl _)
      (match decl
        [(AstDecl.Import
            decl-meta
            (AstImportSpec.Spec
              _
              _
              (AstMaybeModuleName.Some target-module)
              (AstMaybeImportAlias.Some alias)
              _))
          (if (= alias cbi.compiler-builtin-id-fix-empty)
            (tc-bind-import-alias-module
              ctx
              all-decls
              top-env
              target-module
              cbi.compiler-builtin-id-fix-empty
              module-id
              true)
            (begin
              (tc-lazy-import-stub-record!
                module-id
                (compiler-symbols-import-alias-key-id module-id alias)
                target-module
                false)
              (ResultTcEnv.Ok top-env)))]
        [_ (ResultTcEnv.Ok top-env)])]
    [(AstDeclListStep.Nil) (ResultTcEnv.Ok top-env)]))

(define (macro-existing-module-import-target
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : AstMaybeModuleName]) : TcMaybeNameId
  (let
    [call-expr : AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok
                maybe-decl
                call-module
                call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      _)
                    (if (tc-macro-result-module? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            call-module-id
                            (macro-decl-name-display
                              macro-name
                              definition-module)
                            (macro-decl-module-display definition-module)
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (macro-find-generated-identity-module
                                orig-decls
                                identity)]
                            [(ResultGenKey.Err _) (TcMaybeNameId.No)])]
                        [(ResultMacroExprList.Err _) (TcMaybeNameId.No)])
                      (TcMaybeNameId.No))]
                  [(MacroMaybeDecl.No) (TcMaybeNameId.No)]))]
            [(ResultMacroCallDeclModule.Err _) (TcMaybeNameId.No)]))]
      [_ (TcMaybeNameId.No)])))

(define (macro-collapse-existing-module-import-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ alias span))
      (match kind
        [(AstImportKind.Macro call-id context)
          (match (macro-existing-module-import-target
            ctx
            top-env
            orig-decls
            module
            module-id
            call-id
            context)
            [(TcMaybeNameId.Some target-module-id)
              (let
                [target-module : String (intern-str target-module-id)]
                [expanded : AstDeclList
                  (macro-module-import-marker-decls
                    target-module
                    target-module-id
                    alias
                    (box-get span))]
                (ResultMacroDeclExpansion.Ok
                  expanded
                  (macro-paths-for-decls expanded decl-path)))]
            [(TcMaybeNameId.No) (macro-single-decl-expansion decl decl-path)])]
        [_ (macro-single-decl-expansion decl decl-path)])]
    [_ (macro-single-decl-expansion decl decl-path)]))

(define (macro-collapse-existing-module-imports
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : AstDeclList]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultMacroDeclExpansion.Ok (ast-decl-list-new) (ast-decl-path-list-new))]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-collapse-existing-module-import-decl
        ctx
        top-env
        orig-decls
        module
        module-id
        decl
        decl-path)
        [(ResultMacroDeclExpansion.Ok head-decls head-paths)
          (match (macro-collapse-existing-module-imports
            ctx
            top-env
            orig-decls
            module
            module-id
            rest-box
            decl-path)
            [(ResultMacroDeclExpansion.Ok rest-decls rest-paths)
              (ResultMacroDeclExpansion.Ok
                (macro-decl-list-append head-decls rest-decls)
                (macro-decl-path-list-append head-paths rest-paths))]
            [(ResultMacroDeclExpansion.Err diag)
              (ResultMacroDeclExpansion.Err diag)])]
        [(ResultMacroDeclExpansion.Err diag)
          (ResultMacroDeclExpansion.Err diag)])]))

(define (macro-collapse-existing-module-imports-or-original
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : AstDeclList]
  [decl-path : String]) : AstDeclList
  (match (macro-collapse-existing-module-imports
    ctx
    top-env
    orig-decls
    module
    module-id
    decls
    decl-path)
    [(ResultMacroDeclExpansion.Ok collapsed _) collapsed]
    [(ResultMacroDeclExpansion.Err _) decls]))

(define (macro-call-not-macro-diag [call-expr : AstExpr]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    "typecheck: module-scope macro call does not name a macro"))

(define (macro-module-existing-collision-diag
  [call-expr : AstExpr]
  [target-module : String]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output collides with existing module "
      target-module
      " for generated identity "
      identity)))

(define (macro-module-incompatible-output-diag
  [call-expr : AstExpr]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output for generated identity "
      identity
      " has incompatible payload")))

(define (macro-materialized-record-result
  [identity : String]
  [target-module-id : i64]
  [summary : AstDeclList]
  [catalog : AstDeclList]
  [generator : String]
  [import-path : String]
  [memoize? : bool]
  [result : ResultMacroDeclExpansion]) : ResultMacroDeclExpansion
  (begin
    (match result
      [(ResultMacroDeclExpansion.Ok _ _)
        (begin
          (if memoize?
            (begin
              ;; This full materialization is the behavior-preserving
              ;; validation lane for #4830: every catalog declaration remains
              ;; in the ordinary parent walk exactly once. Record the complete
              ;; module list separately from the mutable materialized summary.
              (macro-generated-module-memo-put!
                identity
                target-module-id
                summary
                catalog
                generator
                import-path)
              (cfg
                compile-profile
                (compiler-tc-macro-profile-note-generated-module-catalog-build)))
            unit)
          (cfg
            compile-profile
            (compiler-tc-macro-profile-note-generated-module-materialization)))]
      [(ResultMacroDeclExpansion.Err _) unit])
    result))

(define (macro-expand-module-materialized
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [target-module : String]
  [target-module-id : i64]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [memoize? : bool]
  [body-rest : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    ;; A generated module always emits its FULL body. There is no surface
    ;; filter (closure filter + env/fs allow-list + whole-body drop);
    ;; the reachability gate (run after typecheck) keeps unused parts out of
    ;; codegen while every declaration is still fully typechecked.
    [generated-body-raw : AstDeclList
      (macro-wrap-generated-decls body-rest macro-name identity)]
    [generated-body : AstDeclList
      (macro-collapse-existing-module-imports-or-original
        ctx
        top-env
        orig-decls
        target-module
        target-module-id
        generated-body-raw
        decl-path)]
    [materialized : AstDeclList
      (ast-decl-list-prepend-builder
        (ast-decl-module-id target-module-id)
        generated-body)]
    (macro-materialized-record-result
      identity
      target-module-id
      materialized
      generated-body
      macro-name
      decl-path
      memoize?
      (match (macro-find-module-body-decls orig-decls target-module)
        [(MacroMaybeDeclList.Some existing-body)
          (if (macro-decls-contain-generated-key? existing-body identity)
            ;: The module for this identity is already materialized and recorded in
            ;: the content-addressed memo. Compatible repeats are deduped without
            ;: re-expansion via the memo shortcut (plan P1). A syntax-param macro
            ;: (an `Expr`/clause parameter) can still reach here having produced a
            ;: body that differs from the recorded one even though the canonical
            ;: identity matches -- it switches on the argument's syntactic shape,
            ;: not its value, so `(gen "i64")` and `(gen (type-key (type i64)))`
            ;: collide on one identity with different payloads. Detect that
            ;: same-identity collision instead of silently reusing the recorded
            ;: body; a compatible re-materialization still binds via the replay
            ;: marker/alias import.
            (match (macro-generated-target-replay
              existing-body
              (macro-decls-filter-generated-key generated-body identity))
              [(MacroGeneratedTargetReplay.ReplayIncompatible)
                (ResultMacroDeclExpansion.Err
                  (box
                    (macro-module-incompatible-output-diag call-expr identity)))]
              [_
                (match (macro-check-generated-import-collisions
                  orig-decls
                  generated-body
                  module
                  alias
                  identity)
                  [CompilerNoString
                    (let
                      [expanded : AstDeclList
                        (macro-module-replay-marker-decls
                          target-module
                          target-module-id
                          module-id
                          alias
                          span
                          generated-body
                          existing-body)]
                      (ResultMacroDeclExpansion.Ok
                        expanded
                        (macro-paths-for-decls expanded decl-path)))]
                  [(CompilerSomeString message)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-generated-import-diag span message)))])])
            (let
              [generated-key-body : AstDeclList
                (macro-decls-filter-generated-key generated-body identity)]
              (match (macro-generated-target-replay
                existing-body
                generated-key-body)
                [(MacroGeneratedTargetReplay.ReplayCompatible)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : AstDeclList
                          (macro-module-replay-marker-decls
                            target-module
                            target-module-id
                            module-id
                            alias
                            span
                            generated-body
                            existing-body)]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls expanded decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])]
                [(MacroGeneratedTargetReplay.ReplayAppendMissing)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : AstDeclList
                          (macro-module-replay-marker-decls
                            target-module
                            target-module-id
                            module-id
                            alias
                            span
                            generated-body
                            existing-body)]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls expanded decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])]
                [(MacroGeneratedTargetReplay.ReplayIncompatible)
                  (ResultMacroDeclExpansion.Err
                    (box
                      (macro-module-incompatible-output-diag call-expr identity)))]
                [(MacroGeneratedTargetReplay.NoReplay)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : AstDeclList
                          (macro-decl-list-append
                            materialized
                            (ast-decl-list-prepend-builder
                              (ast-decl-module-id module-id)
                              (macro-module-import-marker-decls
                                target-module
                                target-module-id
                                alias
                                span)))]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls expanded decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])])))]
        [(MacroMaybeDeclList.No)
          (match (macro-check-generated-import-collisions
            orig-decls
            generated-body
            module
            alias
            identity)
            [CompilerNoString
              (let
                [expanded : AstDeclList
                  (macro-decl-list-append
                    materialized
                    (ast-decl-list-prepend-builder
                      (ast-decl-module-id module-id)
                      (macro-module-import-marker-decls
                        target-module
                        target-module-id
                        alias
                        span)))]
                (ResultMacroDeclExpansion.Ok
                  expanded
                  (macro-paths-for-decls expanded decl-path)))]
            [(CompilerSomeString message)
              (ResultMacroDeclExpansion.Err
                (box (macro-generated-import-diag span message)))])]))))

(define (macro-expand-module-generated-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [definition-module-id : i64]
  [macro-env : CtfeEnv]
  [rewrite-imports? : bool]
  [memoize? : bool]
  [generated : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    [module-count : i64 (macro-decls-module-count generated)]
    (if (= module-count 0)
      (ResultMacroDeclExpansion.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Module macro output must include a module declaration")))
      (if (> module-count 1)
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: Module macro output must include exactly one module declaration")))
        (match (ast-decl-list-step generated)
          [(AstDeclListStep.Cons first body-rest-box)
            (match first
              [(AstDecl.ModuleBody target-module-id body-box)
                (match (ast-decl-list-step body-rest-box)
                  [(AstDeclListStep.Nil)
                    (let
                      [target-module : String (intern-str target-module-id)]
                      [body-rest : AstDeclList
                        (macro-flatten-module-body-decls-in-module
                          (box-get body-box)
                          target-module-id)]
                      [contextual-body : AstDeclList
                        (macro-generated-context-decls
                          body-rest
                          definition-module-id)]
                      [final-body : AstDeclList
                        (if rewrite-imports?
                          (let
                            [rewrite-decls : AstDeclList
                              (ast-decl-list-prepend-builder
                                (ast-decl-module-id target-module-id)
                                contextual-body)]
                            [lookup-decls : AstDeclList
                              (macro-decl-list-append orig-decls rewrite-decls)]
                            (macro-rewrite-generated-import-decls
                              (tc-context-with-module-id
                                ctx
                                target-module
                                target-module-id)
                              lookup-decls
                              target-module
                              target-module-id
                              definition-module-id
                              macro-env
                              contextual-body))
                          contextual-body)]
                      (macro-expand-module-materialized
                        ctx
                        top-env
                        orig-decls
                        module
                        module-id
                        target-module
                        target-module-id
                        alias
                        span
                        decl-path
                        macro-name
                        identity
                        memoize?
                        final-body
                        call-expr))]
                  [_
                    (ResultMacroDeclExpansion.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: Module macro output must include exactly one module declaration")))])]
              [(AstDecl.Module target-module-id)
                (let
                  [target-module : String (intern-str target-module-id)]
                  [body-rest : AstDeclList
                    (macro-flatten-module-body-decls-in-module
                      body-rest-box
                      target-module-id)]
                  [contextual-body : AstDeclList
                    (macro-generated-context-decls
                      body-rest
                      definition-module-id)]
                  [final-body : AstDeclList
                    (if rewrite-imports?
                      (let
                        [rewrite-decls : AstDeclList
                          (ast-decl-list-prepend-builder
                            (ast-decl-module-id target-module-id)
                            contextual-body)]
                        [lookup-decls : AstDeclList
                          (macro-decl-list-append orig-decls rewrite-decls)]
                        (macro-rewrite-generated-import-decls
                          (tc-context-with-module-id
                            ctx
                            target-module
                            target-module-id)
                          lookup-decls
                          target-module
                          target-module-id
                          definition-module-id
                          macro-env
                          contextual-body))
                      contextual-body)]
                  (macro-expand-module-materialized
                    ctx
                    top-env
                    orig-decls
                    module
                    module-id
                    target-module
                    target-module-id
                    alias
                    span
                    decl-path
                    macro-name
                    identity
                    memoize?
                    final-body
                    call-expr))]
              [_
                (ResultMacroDeclExpansion.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro output must start with a module declaration")))])]
          [(AstDeclListStep.Nil)
            (ResultMacroDeclExpansion.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  "typecheck: Module macro output must include a module declaration")))])))))

(define (macro-expand-decls-splice
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok
                maybe-decl
                call-module
                call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (if (tc-macro-result-decls? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            call-module-id
                            (macro-decl-name-display
                              macro-name
                              definition-module)
                            (macro-decl-module-display definition-module)
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (match (macro-eval-transformer-expanded-with-env
                                call-ctx
                                orig-decls
                                (macro-decl-module-display definition-module)
                                definition-module
                                global-env
                                (macro-decl-name-display
                                  macro-name
                                  definition-module)
                                params
                                body
                                expanded-args
                                call-expr)
                                [(ResultMacroValueEnv.Ok value macro-env)
                                  (let
                                    [parse-dispatch : sym_i64_env.SymI64Env
                                      (macro-parse-dispatch-for-macro
                                        (macro-decl-name-display
                                          macro-name
                                          definition-module)
                                        (macro-decl-module-display
                                          definition-module))]
                                    (match (macro-decls-from-ctfe-value
                                      (macro-hygiene-ctfe-output
                                        value
                                        (MacroHygieneContext
                                          macro-name
                                          definition-module
                                          declaration-id
                                          (tc-context-symbols call-ctx))
                                        params
                                        1)
                                      call-expr
                                      parse-dispatch)
                                      [(ResultMacroParsedDecls.Ok generated)
                                        (let
                                          [generated : AstDeclList
                                            (if (tc-macro-param-list-needs-call-context?
                                              params)
                                              (macro-rewrite-generated-import-decls
                                                call-ctx
                                                orig-decls
                                                module
                                                (tc-context-module-id call-ctx)
                                                definition-module
                                                macro-env
                                                generated)
                                              generated)]
                                          [contextual-generated : AstDeclList
                                            (macro-generated-context-decls
                                              generated
                                              definition-module)]
                                          [flattened-generated : AstDeclList
                                            (macro-flatten-module-body-decls-in-module
                                              contextual-generated
                                              module-id)]
                                          [wrapped : AstDeclList
                                            (macro-wrap-generated-decls-decls
                                              flattened-generated
                                              (macro-decl-name-display
                                                macro-name
                                                definition-module)
                                              (macro-decls-generated-key
                                                identity))]
                                          (macro-decls-splice-with-memo
                                            identity
                                            wrapped
                                            decl-path
                                            call-expr))]
                                      [(ResultMacroParsedDecls.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)]))]
                                [(ResultMacroValueEnv.Err diag)
                                  (ResultMacroDeclExpansion.Err diag)])]
                            [(ResultGenKey.Err diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-module? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Module macro can only be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used at module scope")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-module-import
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module _)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (if (tc-macro-result-module? ret)
                      ;; Always expand + materialize the module. There is no
                      ;; "skip the import when the alias is textually
                      ;; unreferenced" fast path: a declared
                      ;; instantiation must be typechecked whether or not anything
                      ;; references it (typecheck-completeness invariant).
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            (macro-decl-module-display definition-module)
                            definition-module
                            (macro-decl-name-display
                              macro-name
                              definition-module)
                            (macro-decl-module-display definition-module)
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (let
                                [shortcut-safe? : bool
                                  (macro-generated-identity-shortcut-safe-params?
                                    call-ctx
                                    (macro-decl-module-display
                                      definition-module)
                                    definition-module
                                    params
                                    expanded-args)]
                                [shortcut-catalog : MacroGeneratedModuleCatalogEntry
                                  (if shortcut-safe?
                                    (macro-generated-module-memo-get-catalog
                                      identity)
                                    (MacroGeneratedModuleCatalogEntry.Empty))]
                                (match shortcut-catalog
                                  [(MacroGeneratedModuleCatalogEntry.Catalog
                                      target-id
                                      catalog
                                      _
                                      _
                                      _
                                      _)
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-note-generated-module-memo-hit))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-note-generated-module-catalog-hit))
                                      (let
                                        [target-module : String
                                          (intern-str target-id)]
                                        [marker : AstDeclList
                                          (macro-module-import-marker-decls
                                            target-module
                                            target-id
                                            alias
                                            span)]
                                        [expanded : AstDeclList
                                          (match (macro-find-module-body-decls
                                            orig-decls
                                            target-module)
                                            [(MacroMaybeDeclList.Some _) marker]
                                            [(MacroMaybeDeclList.No)
                                              (macro-decl-list-append
                                                (ast-decl-list-prepend-builder
                                                  (ast-decl-module-id target-id)
                                                  catalog)
                                                (ast-decl-list-prepend-builder
                                                  (ast-decl-module-id module-id)
                                                  marker))])]
                                        (ResultMacroDeclExpansion.Ok
                                          expanded
                                          (macro-paths-for-decls
                                            expanded
                                            decl-path))))]
                                  [(MacroGeneratedModuleCatalogEntry.Empty)
                                    (match (macro-eval-transformer-expanded-with-env
                                      call-ctx
                                      orig-decls
                                      (macro-decl-module-display
                                        definition-module)
                                      definition-module
                                      global-env
                                      (macro-decl-name-display
                                        macro-name
                                        definition-module)
                                      params
                                      body
                                      expanded-args
                                      call-expr)
                                      [(ResultMacroValueEnv.Ok value macro-env)
                                        (let
                                          [parse-dispatch : sym_i64_env.SymI64Env
                                            (macro-parse-dispatch-for-macro
                                              (macro-decl-name-display
                                                macro-name
                                                definition-module)
                                              (macro-decl-module-display
                                                definition-module))]
                                          (match (macro-module-decls-from-ctfe-value
                                            (macro-hygiene-ctfe-output
                                              value
                                              (MacroHygieneContext
                                                macro-name
                                                definition-module
                                                declaration-id
                                                (tc-context-symbols call-ctx))
                                              params
                                              1)
                                            call-expr
                                            parse-dispatch)
                                            [(ResultMacroParsedDecls.Ok
                                                generated)
                                              (macro-expand-module-generated-decls
                                                ctx
                                                top-env
                                                orig-decls
                                                module
                                                module-id
                                                alias
                                                span
                                                decl-path
                                                (macro-decl-name-display
                                                  macro-name
                                                  definition-module)
                                                identity
                                                definition-module
                                                macro-env
                                                (tc-macro-param-list-needs-call-context?
                                                  params)
                                                true
                                                generated
                                                call-expr)]
                                            [(ResultMacroParsedDecls.Err diag)
                                              (ResultMacroDeclExpansion.Err
                                                diag)]))]
                                      [(ResultMacroValueEnv.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)])]))]
                            [(ResultGenKey.Err diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-decls? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Decls macro cannot be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used as module import")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: import macro placeholder must contain a call")))])))

(define (macro-expand-decl-with-path
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ alias span))
      (match kind
        [(AstImportKind.Macro call-id context)
          (macro-expand-module-import
            ctx
            top-env
            orig-decls
            module
            module-id
            call-id
            context
            alias
            (box-get span)
            decl-path)]
        [(AstImportKind.MacroDecls call-id context)
          (macro-expand-decls-splice
            ctx
            top-env
            orig-decls
            module
            module-id
            call-id
            context
            decl-path)]
        [_ (macro-single-decl-expansion decl decl-path)])]
    [_
      (let
        [decl-ctx : TcContext (tc-context-with-module-id ctx module module-id)]
        [template : AstDecl (ast-decl-with-meta ast-decl-meta-runtime decl)]
        [uses-macro : bool
          (macro-decl-uses-macro? decl-ctx orig-decls template)]
        (if (not uses-macro)
          (macro-single-decl-expansion decl decl-path)
          (match (macro-env-for-module ctx top-env module module-id)
            [(ResultTcEnv.Ok local-env)
              (match (macro-expand-decl decl-ctx local-env orig-decls template)
                [(ResultMacroDecl.Ok expanded)
                  (macro-single-decl-expansion
                    (ast-decl-with-meta (ast-decl-meta decl) expanded)
                    decl-path)]
                [(ResultMacroDecl.Err diag) (ResultMacroDeclExpansion.Err diag)])]
            [(ResultTcEnv.Err message)
              (ResultMacroDeclExpansion.Err (box (tc-decl-diag decl message)))])))]))

(define (macro-module-generated-key? [key : String]) : bool
  (and
    (> (string.string-length key) 0)
    (not (tc-string-prefix? key "generated:"))))

(define (macro-decl-generated-identity [decl : AstDecl]) : CompilerMaybeString
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some _ _ _ key)
      (if (macro-module-generated-key? key)
        (CompilerSomeString key)
        CompilerNoString)]
    [(AstGeneratedDeclMeta.No) CompilerNoString]))

(define (macro-module-generated-identity-in
  [decls : AstDeclList]
  [target-module-id : i64]
  [module-id : i64]) : CompilerMaybeString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) CompilerNoString]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [(AstDecl.Module next-module)
          (macro-module-generated-identity-in
            rest-box
            target-module-id
            next-module)]
        [_
          (if (= module-id target-module-id)
            (match (macro-decl-generated-identity decl)
              [(CompilerSomeString identity) (CompilerSomeString identity)]
              [CompilerNoString
                (macro-module-generated-identity-in
                  rest-box
                  target-module-id
                  module-id)])
            (macro-module-generated-identity-in
              rest-box
              target-module-id
              module-id))])]))

(define (macro-module-generated-identity
  [decls : AstDeclList]
  [target-module-id : i64]) : CompilerMaybeString
  (macro-module-generated-identity-in
    decls
    target-module-id
    cbi.compiler-builtin-id-fix-empty))

(define (macro-generated-module-marker-in
  [decls : AstDeclList]
  [target-module-id : i64]
  [importer-module-id : i64]
  [module-id : i64]) : AstDeclList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (ast-decl-list-new)]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module next-module)
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            next-module)]
        [(AstDecl.Import
            decl-meta
            (AstImportSpec.Spec
              kind
              _
              (AstMaybeModuleName.Some imported-module)
              _
              _))
          (match kind
            [(AstImportKind.Module)
              (if (and
                (= module-id importer-module-id)
                (= imported-module target-module-id))
                (ast-decl-cons decl (ast-decl-list-new))
                (macro-generated-module-marker-in
                  rest
                  target-module-id
                  importer-module-id
                  module-id))]
            [_
              (macro-generated-module-marker-in
                rest
                target-module-id
                importer-module-id
                module-id)])]
        [_
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            module-id)])]))

;; A memoized module expansion has exactly the two pieces needed by the
;; incremental top-env path: its canonical module summary and the import marker
;; emitted in the caller's module. Decls macros use `generated:` keys and never
;; satisfy macro-module-generated-key?, so they stay on the full-rebuild path.
(define (macro-generated-module-extension
  [decls : AstDeclList]
  [importer-module-id : i64]) : MacroMaybeGeneratedModuleExtension
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) MacroMaybeGeneratedModuleExtension.No]
    [(AstDeclListStep.Cons first _)
      (match first
        [(AstDecl.Module target-module-id)
          (match (macro-module-generated-identity decls target-module-id)
            [(CompilerSomeString identity)
              (let
                [summary : AstDeclList
                  (macro-generated-module-memo-get-summary identity)]
                [marker : AstDeclList
                  (macro-generated-module-marker-in
                    decls
                    target-module-id
                    importer-module-id
                    cbi.compiler-builtin-id-fix-empty)]
                (match (ast-decl-list-step summary)
                  [(AstDeclListStep.Nil) MacroMaybeGeneratedModuleExtension.No]
                  [_
                    (match (ast-decl-list-step marker)
                      [(AstDeclListStep.Nil)
                        MacroMaybeGeneratedModuleExtension.No]
                      [_
                        (MacroMaybeGeneratedModuleExtension.Some summary marker)])]))]
            [CompilerNoString MacroMaybeGeneratedModuleExtension.No])]
        [_ MacroMaybeGeneratedModuleExtension.No])]))

(define (macro-import-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstMaybeImportAlias.Some alias-name)
      (= alias-name cbi.compiler-builtin-id-fix-empty)]
    [(AstMaybeImportAlias.No) false]))

(define (macro-module-import-request-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstMaybeImportAlias.Some alias-name)
      (= alias-name cbi.compiler-builtin-id-fix-empty)]
    [(AstMaybeImportAlias.No) true]))

(define (macro-generated-import-diag [span : AstSourceSpan] [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic (compiler-diagnostic-from-ast-span "" span message)))

(define (macro-check-generated-import-collisions-in
  [all-decls : AstDeclList]
  [generated-body : AstDeclList]
  [import-module : String]
  [identity : String]) : CompilerMaybeString
  (match (ast-decl-list-step generated-body)
    [(AstDeclListStep.Nil) CompilerNoString]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [_
          (macro-check-generated-import-collisions-in
            all-decls
            rest-box
            import-module
            identity)])]))

(define (macro-check-generated-import-collisions
  [_all-decls : AstDeclList]
  [_generated-body : AstDeclList]
  [_import-module : String]
  [_alias : AstMaybeImportAlias]
  [_identity : String]) : CompilerMaybeString
  CompilerNoString)

;; Macro-expansion skip analysis. Once any module defines
;; a macro, `has-defmacro` forces the full macro-expand walk over EVERY decl in
;; the program (all imported modules), which redundantly re-typechecks match
;; scrutinees / let bindings and rebuilds the entire AST -- ~1.7GB and >1s on a
;; self-compile. The vast majority of decls call no macro at all, so this work is
;; pure waste. These predicates detect whether a decl actually contains a macro
;; (or `when`/`unless` compat) call using the SAME resolution as the expander
;; (`macro-call-decl`), so a decl with none can be shared unchanged. They are
;; conservative: any unrecognized expression variant returns `true` (expand), so
;; a future AST node that could host a macro call is never silently skipped.
;; The callee name of a call after hygiene-stripping (but keeping any module
;; qualifier), mirroring `macro-call-decl`'s name resolution. Returns nothing for
;; non-variable callees (which `macro-call-decl` also treats as non-macro).
;; Allocation-free for plain unqualified names -- the hot path for the pre-filter.
(define (macro-call-callee-name [func : AstExpr]) : TcMaybeString
  (match func
    [(AstExpr.Spanned inner-box _)
      (macro-call-callee-name (ast-node-get inner-box))]
    [(AstExpr.Var name)
      (let
        [name-text : String (tc-env-key-display name)]
        (TcMaybeString.Some
          (if (tc-hygiene-global-name? name-text)
            (match (tc-hygiene-global-decode name-text)
              [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
              [(TcHygieneGlobalName.Context _ lookup-name) lookup-name])
            name-text)))]
    [_ (TcMaybeString.No)]))

(define (macro-call-callee-last-dot [name : String]) : i64
  (let
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (begin
          (if (or
            (string.char-eq (string.string-ref name i) '.')
            (string.char-eq (string.string-ref name i) '/'))
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      last-dot)))

(define (macro-call-callee-base-name [name : String]) : String
  (let
    [lookup : String
      (if (tc-hygiene-global-name? name)
        (tc-hygiene-global-call-name name)
        name)]
    [source : String lookup]
    [last-dot : i64 (macro-call-callee-last-dot source)]
    [n : i64 (string.string-length source)]
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (macro-call-name-maybe-macro? [name : String]) : bool
  (let
    [base : String (macro-call-callee-base-name name)]
    (or (string.eq base "when") (string.eq base "unless"))))

(define (macro-call-callee-base-name-id [func : AstExpr]) : TcMaybeNameId
  (match func
    [(AstExpr.Spanned inner-box _)
      (macro-call-callee-base-name-id (ast-node-get inner-box))]
    [(AstExpr.Var name-id)
      (cond
        [(compiler-composite-triple-key-id? name-id)
          (TcMaybeNameId.Some (compiler-composite-triple-right-id name-id))]
        [(compiler-composite-pair-key-id? name-id)
          (TcMaybeNameId.Some (compiler-composite-pair-right-id name-id))]
        [else
          (let
            [source-id : i64
              (macro-hygiene-global-source-name-id-or name-id name-id)]
            [base-id : i64
              (if (and
                (>= source-id 0)
                (< source-id (intern-capacity))
                (ci.intern-qualified? source-id))
                (ci.intern-qualified-base-id source-id)
                source-id)]
            (if (< base-id 0)
              TcMaybeNameId.No
              (TcMaybeNameId.Some
                (if (and
                  (< base-id (intern-capacity))
                  (ci.intern-dotted? base-id))
                  (ci.intern-dotted-final-id base-id)
                  base-id))))])]
    [_ TcMaybeNameId.No]))

(define (macro-call-callee-maybe-macro? [func : AstExpr]) : bool
  (match (macro-call-callee-base-name-id func)
    [(TcMaybeNameId.Some base-id)
      (or
        (tc_i64_i64_map.contains? (& macro-expand-macro-name-set) base-id)
        (= base-id cbi.compiler-builtin-id-fix-when)
        (= base-id cbi.compiler-builtin-id-fix-unless))]
    [TcMaybeNameId.No
      (match (macro-call-callee-name func)
        [(TcMaybeString.Some name) (macro-call-name-maybe-macro? name)]
        [(TcMaybeString.No) false])]))

(define (macro-call-is-expandable?
  [ctx : TcContext]
  [decls : AstDeclList]
  [func : AstExpr]
  [call-expr : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcMaybeString.Some name)
      ;; Only callees whose base name matches a declared macro need precise
      ;; alias/module resolution. This keeps value-heavy dotted imports such as
      ;; `string.length` on the cheap path while still resolving qualified macro
      ;; calls through `macro-call-decl`.
      (if (macro-call-callee-maybe-macro? func)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe)
            (match maybe
              [(MacroMaybeDecl.Some _ _ _ _ _ _) true]
              [(MacroMaybeDecl.No)
                (or (string.eq name "when") (string.eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) true])
        false)]
    [(TcMaybeString.No) false]))

(define (macro-node-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [id : i64]) : bool
  (macro-expr-uses-macro? ctx decls (ast-node-get id)))

(define (macro-exprs-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : AstExprList]) : bool
  (macro-exprs-use-macro-at? ctx decls (& exprs) 0))

(define (macro-exprs-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (macro-node-uses-macro? ctx decls (ast-expr-list-get exprs index 0))
      (macro-exprs-use-macro-at? ctx decls exprs (+ index 1)))))

(define (macro-arms-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : AstMatchArmList]) : bool
  (macro-arms-use-macro-at? ctx decls (& arms) 0))

(define (macro-arms-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (or
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm _ body-box)
          (macro-node-uses-macro? ctx decls body-box)])
      (macro-arms-use-macro-at? ctx decls arms (+ index 1)))))

(define (macro-bindings-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : AstLetBindingList]) : bool
  (macro-bindings-use-macro-at? ctx decls (& bindings) 0))

(define (macro-bindings-use-macro-at?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (macro-node-uses-macro? ctx decls init-box)])
      (macro-bindings-use-macro-at? ctx decls bindings (+ index 1)))))

(define (macro-expr-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _) (macro-node-uses-macro? ctx decls inner-box)]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-is-expandable? ctx decls func expr)
          (macro-expr-uses-macro? ctx decls func)
          (macro-exprs-use-macro? ctx decls args)))]
    [(AstExpr.BracketClause items) (macro-exprs-use-macro? ctx decls items)]
    [(AstExpr.Binary _ l r)
      (or
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls r))]
    [(AstExpr.Unary _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.If c t e)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls t)
        (macro-node-uses-macro? ctx decls e))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (or
            (macro-bindings-use-macro? ctx decls bindings)
            (macro-node-uses-macro? ctx decls body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (macro-node-uses-macro? ctx decls body)])]
    [(AstExpr.Tuple exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.TupleRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Array exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.DynArray exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.MakeArray _ len) (macro-node-uses-macro? ctx decls len)]
    [(AstExpr.ArrayRef a i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i))]
    [(AstExpr.ArraySet a i v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.ArrayTake a l i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls i))]
    [(AstExpr.ArrayPush a v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.StringRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.While c b)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Begin exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.Unsafe exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.Set _ rhs) (macro-node-uses-macro? ctx decls rhs)]
    [(AstExpr.Ann i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Cast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Borrow _ _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (or
            (macro-node-uses-macro? ctx decls scrut)
            (macro-arms-use-macro? ctx decls arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ s e b)
          (or
            (macro-node-uses-macro? ctx decls s)
            (macro-node-uses-macro? ctx decls e)
            (macro-node-uses-macro? ctx decls b))])]
    [(AstExpr.StructGet i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StructSet i _ v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.WithEscape i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExpr.WithScratch exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.InArena i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExpr.Box i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxGet i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxTake i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BoxSet i v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExpr.Comptime i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Try i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Return i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrNullCheck i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrRead i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrWrite a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.PtrOffset a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.PtrCast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.PtrToInt i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.IntToPtr i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StringData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.StringFromBytes a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.ArrayData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEbx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEcx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.CpuIdEdx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExpr.Xgetbv i) (macro-node-uses-macro? ctx decls i)]
    [(AstExpr.Syscall exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf place) (macro-node-uses-macro? ctx decls place)]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [_ true]))

(define (macro-decl-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (macro-node-uses-macro? ctx decls expr-box)]
    [(AstDecl.DefFn decl-meta _ _ _ body-box _)
      (macro-node-uses-macro? ctx decls body-box)]
    [(AstDecl.Test _ _ _) true]
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [(AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-uses-macro? ctx decls (box-get inner-box))]
    [_ false]))

;; Cheap, ctx-free, allocation-free over-approximation of "could the expander
;; fire a macro/compat call anywhere inside this expression". It is used as a
;; decl-level pre-filter in `macro-expand-decls`: a decl whose body cannot fire
;; is pushed to the output unchanged (shared, never copied through the expander),
;; skipping the per-decl `tc-context-with-module` allocation and the precise
;; `macro-decl-uses-macro?` walk (which resolves candidate calls via
;; `macro-call-decl`).
;;
;; SAFE BY CONSTRUCTION (must guarantee: if the expander could rewrite a child
;; expression, `macro-expr-might-fire? = true`, i.e. we never share what the
;; expander would expand). This is achieved by following child expressions that
;; can syntactically contain calls, with explicit false leaves for non-call
;; forms.
;;   - At `AstExpr.Call` it uses `macro-call-callee-maybe-macro?` -- the registry
;;     gate the expander itself checks before attempting expansion -- which is a
;;     superset of `macro-call-is-expandable?` (it skips the `macro-call-decl`
;;     resolution and treats any registry-name callee as a possible fire). So at
;;     every call mine flags at least whatever the precise walk flags.
;;   - Scoped/container forms (for example WithRegion, WithResource, and SPMD)
;;     recurse into their child expressions here as well, so ordinary
;;     scoped/resource/vector code without macro calls does not force the full
;;     macro setup path.
;; A bare `AstExpr.Var`/`AstExpr.Set` target is never a call -> false (matching
;; the gate). `AstExpr.PtrAddrOf` follows its place operand because addressable
;; places can now contain macro-expanded field/element forms. This walk covers
;; every expression position from which a macro can fire. Whether a transformer
;; asks for an operand's type changes how that call is evaluated, not how the
;; call is represented, so expr-type macros use the same syntactic call gate.
(define (macro-expr-list-might-fire? [exprs : AstExprList]) : bool
  (macro-expr-list-might-fire-at? (& exprs) 0))

(define (macro-expr-list-might-fire-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (macro-expr-might-fire? (ast-node-get (ast-expr-list-get exprs index 0)))
      (macro-expr-list-might-fire-at? exprs (+ index 1)))))

(define (macro-let-binding-list-might-fire? [bindings : AstLetBindingList]) : bool
  (macro-let-binding-list-might-fire-at? (& bindings) 0))

(define (macro-let-binding-list-might-fire-at?
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (or
            (macro-expr-might-fire? init)
            (macro-let-binding-list-might-fire-at? bindings (+ index 1))))])))

(define (macro-match-arms-might-fire? [arms : AstMatchArmList]) : bool
  (macro-match-arms-might-fire-at? (& arms) 0))

(define (macro-match-arms-might-fire-at?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (or
            (macro-expr-might-fire? body)
            (macro-match-arms-might-fire-at? arms (+ index 1))))])))

(define (macro-resource-binding-list-might-fire?
  [bindings : AstResourceBindingList]) : bool
  (macro-resource-binding-list-might-fire-at? (& bindings) 0))

(define (macro-resource-binding-list-might-fire-at?
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len bindings))
    false
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (or
            (macro-expr-might-fire? init)
            (macro-expr-might-fire? cleanup)
            (macro-resource-binding-list-might-fire-at? bindings (+ index 1))))])))

(define (macro-expr-might-fire? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-callee-maybe-macro? func)
          (macro-expr-might-fire? func)
          (macro-expr-list-might-fire? args)))]
    [(AstExpr.BracketClause items) (macro-expr-list-might-fire? items)]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or (macro-expr-might-fire? left) (macro-expr-might-fire? right)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (macro-expr-might-fire? cond)
          (macro-expr-might-fire? then-branch)
          (macro-expr-might-fire? else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-let-binding-list-might-fire? bindings)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (macro-expr-might-fire? body))])]
    [(AstExpr.Tuple exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? tuple) (macro-expr-might-fire? index)))]
    [(AstExpr.Array exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.DynArray exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (macro-expr-might-fire? len))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? index)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (macro-expr-might-fire? array)
          (macro-expr-might-fire? index)
          (macro-expr-might-fire? value)))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [live : AstExpr (ast-node-get live-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (macro-expr-might-fire? array)
          (macro-expr-might-fire? live)
          (macro-expr-might-fire? index)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? value)))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? str) (macro-expr-might-fire? index)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or (macro-expr-might-fire? cond) (macro-expr-might-fire? body)))]
    [(AstExpr.Begin exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.Unsafe exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (macro-expr-might-fire? place))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (macro-expr-might-fire? scrutinee)
              (macro-match-arms-might-fire? arms)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)
              (macro-expr-might-fire? body)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (macro-expr-might-fire? receiver))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? receiver) (macro-expr-might-fire? value)))]
    [(AstExpr.WithRegion _ body) (macro-expr-list-might-fire? body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or (macro-expr-might-fire? scratch) (macro-expr-list-might-fire? body)))]
    [(AstExpr.WithScratch body) (macro-expr-list-might-fire? body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or (macro-expr-might-fire? arena) (macro-expr-list-might-fire? body)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (macro-resource-binding-list-might-fire? bindings)
            (macro-expr-list-might-fire? body))])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? inner) (macro-expr-might-fire? value)))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? value)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? offset)))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (macro-expr-might-fire? str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? len)))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (macro-expr-might-fire? array))]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (macro-expr-might-fire? index))]
    [(AstExpr.Syscall args) (macro-expr-list-might-fire? args)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (macro-expr-might-fire? place))]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [_ true]))

;; Decl-level companion to `macro-expr-might-fire?`. Returns true only for the
;; value-bearing decl kinds whose entire macro-expandable surface is a single
;; body expression that provably contains no fireable call -- such a decl can be
;; pushed to the macro-expand output unchanged (shared). Every other decl kind
;; returns false so it falls through to the precise `macro-expand-decl-with-path`
;; path (which shares or expands import placeholders, splices, defmacro, unsafe,
;; comptime templates, etc. correctly).
(define (macro-decl-cannot-fire? [decl : AstDecl]) : bool
  (if (ast-decl-comptime-only? decl)
    false
    (match decl
      [(AstDecl.Def decl-meta _ _ expr-box)
        (not (macro-expr-might-fire? (ast-node-get expr-box)))]
      [(AstDecl.DefFn decl-meta _ _ _ body-box _)
        (not (macro-expr-might-fire? (ast-node-get body-box)))]
      [(AstDecl.Test _ _ _) false]
      [_ false])))

;; Whether the program contains any `(type T)` literal (AstExpr.TypeLiteral). ALL
;; CTFE reflection/layout queries (ctfe-reflect-resolve-type for a `(type T)`,
;; and every reflection/layout builtin -- size-of/struct-field-*/enum-variant-*/
;; ...) take a type-literal argument, and type literals are comptime-only (they
;; can't appear in runtime code). So a program with no type literal never queries
;; the CTFE metadata, and `tc-ctfe-env` can hand back an empty env instead of
;; building the whole-program reflection + layout tables (tens of MB, O(types^2)).
;; Macro `expr-type` calls also need metadata, but macro expansion tracks those
;; from defmacro bodies instead of making this whole-program scan normalize every
;; call head.
;; Conservative: any unrecognized expression returns `true` (build), so a future
;; node that could host a type literal is never silently skipped.
(define (ctfe-node-has-type-literal? [id : i64]) : bool
  (ctfe-expr-has-type-literal? (ast-node-get id)))

(define (ctfe-exprs-have-type-literal? [exprs : AstExprList]) : bool
  (ctfe-exprs-have-type-literal-at? (& exprs) 0))

(define (ctfe-exprs-have-type-literal-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (ctfe-node-has-type-literal? (ast-expr-list-get exprs index 0))
      (ctfe-exprs-have-type-literal-at? exprs (+ index 1)))))

(define (ctfe-arms-have-type-literal? [arms : AstMatchArmList]) : bool
  (ctfe-arms-have-type-literal-at? (& arms) 0))

(define (ctfe-arms-have-type-literal-at?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (or
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm _ body-box) (ctfe-node-has-type-literal? body-box)])
      (ctfe-arms-have-type-literal-at? arms (+ index 1)))))

(define (ctfe-bindings-have-type-literal? [bindings : AstLetBindingList]) : bool
  (ctfe-bindings-have-type-literal-at? (& bindings) 0))

(define (ctfe-bindings-have-type-literal-at?
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (ctfe-node-has-type-literal? init-box)])
      (ctfe-bindings-have-type-literal-at? bindings (+ index 1)))))

(define (ctfe-expr-has-type-literal? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.TypeLiteral _) true]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf place) (ctfe-node-has-type-literal? place)]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.Spanned inner-box _) (ctfe-node-has-type-literal? inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (ctfe-node-has-type-literal? func-box)
        (ctfe-exprs-have-type-literal? args))]
    [(AstExpr.BracketClause items) (ctfe-exprs-have-type-literal? items)]
    [(AstExpr.Binary _ l r)
      (or (ctfe-node-has-type-literal? l) (ctfe-node-has-type-literal? r))]
    [(AstExpr.Unary _ i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.If c t e)
      (or
        (ctfe-node-has-type-literal? c)
        (ctfe-node-has-type-literal? t)
        (ctfe-node-has-type-literal? e))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (or
            (ctfe-bindings-have-type-literal? bindings)
            (ctfe-node-has-type-literal? body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (ctfe-node-has-type-literal? body)])]
    [(AstExpr.Tuple exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.TupleRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Array exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.DynArray exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.MakeArray _ len) (ctfe-node-has-type-literal? len)]
    [(AstExpr.ArrayRef a i)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? i))]
    [(AstExpr.ArraySet a i v)
      (or
        (ctfe-node-has-type-literal? a)
        (ctfe-node-has-type-literal? i)
        (ctfe-node-has-type-literal? v))]
    [(AstExpr.ArrayTake a l i)
      (or
        (ctfe-node-has-type-literal? a)
        (ctfe-node-has-type-literal? l)
        (ctfe-node-has-type-literal? i))]
    [(AstExpr.ArrayPush a v)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? v))]
    [(AstExpr.StringRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.While c b)
      (or (ctfe-node-has-type-literal? c) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Begin exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.Unsafe exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.Set _ rhs) (ctfe-node-has-type-literal? rhs)]
    [(AstExpr.Ann i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Cast i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Borrow _ _ i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (or
            (ctfe-node-has-type-literal? scrut)
            (ctfe-arms-have-type-literal? arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ s e b)
          (or
            (ctfe-node-has-type-literal? s)
            (ctfe-node-has-type-literal? e)
            (ctfe-node-has-type-literal? b))])]
    [(AstExpr.StructGet i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StructSet i _ v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExpr.WithRegion _ exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.WithEscape i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExpr.WithScratch exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExpr.InArena i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExpr.Box i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxGet i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxTake i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BoxSet i v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExpr.Comptime i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Quote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Quasiquote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Unquote i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.UnquoteSplicing i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Try i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Return i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrNullCheck i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrRead i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrWrite a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.PtrOffset a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.PtrCast i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.PtrToInt i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.IntToPtr i _) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StringData i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.StringFromBytes a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.ArrayData i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.CpuIdEax a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEbx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEcx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.CpuIdEdx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExpr.Xgetbv i) (ctfe-node-has-type-literal? i)]
    [(AstExpr.Syscall exprs) (ctfe-exprs-have-type-literal? exprs)]
    [_ true]))

(define (ctfe-decl-has-type-literal? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (ctfe-node-has-type-literal? expr-box)]
    [(AstDecl.DefFn decl-meta _ _ _ body-box _)
      (ctfe-node-has-type-literal? body-box)]
    [(AstDecl.Test _ expr-box _) (ctfe-node-has-type-literal? expr-box)]
    [(AstDecl.DefMacro decl-meta _ _ _ body-box)
      (ctfe-node-has-type-literal? body-box)]
    [(AstDecl.Unsafe inner-box)
      (ctfe-decl-has-type-literal? (box-get inner-box))]
    [(AstDecl.ModuleBody _ body-box)
      (ctfe-program-has-type-literal? (box-get body-box))]
    [_ false]))

(define (ctfe-program-has-type-literal? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (ctfe-decl-has-type-literal? decl)
        (ctfe-program-has-type-literal? rest))]))

;; Reflection metadata only needs a refresh when a splice introduces a nominal
;; declaration. Keep ordinary expression/function splices on the shared CTFE
;; environment so the cache still avoids whole-program metadata walks.
(define (macro-decl-reflection-relevant? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefEnum decl-meta _ _ _) true]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ _ _) true]
    [(AstDecl.DefStruct decl-meta _ _ _ _) true]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-reflection-relevant? (box-get inner-box))]
    [(AstDecl.ModuleBody _ body-box)
      (macro-decls-reflection-relevant? (box-get body-box))]
    [_ false]))

(define (macro-decls-reflection-relevant? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-reflection-relevant? decl)
        (macro-decls-reflection-relevant? rest))]))

;; A forced splice always rebuilds live symbols/registries over the current
;; program view. Its top env follows the narrowest correct plan: generated
;; modules append an isolated namespace, arbitrary Decls refresh unresolved
;; cached signatures plus their source-local tail, and newly loaded files keep
;; the conservative whole-program rebuild because imports can alter unrelated
;; alias surfaces. `module` is the active namespace at the splice site.
(define (tc-top-env-binding-context [ctx : TcContext] [name-id : i64]) : TcContext
  (if (tc-name-qualified-id? name-id)
    (let
      [module-id : i64 (tc-qualified-name-module-id name-id)]
      (if (>= module-id 0)
        (tc-context-with-module-id ctx (intern-str module-id) module-id)
        ctx))
    (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))

;; A splice rebuilds symbols before it rebuilds the type env. Most cached
;; bindings are already final nominal/scalar types; only signatures that still
;; contain `Var`/`VarArgs` nodes can change when the new symbols appear. Walk
;; each cache's retained binding keys until every indexed value has been seen,
;; and re-resolve just those values in the binding's module context. The seen
;; array preserves the cache's head-most binding when a raw spine contains
;; shadowed duplicates.
(define (tc-top-env-reresolve-cache-layer!
  [ctx : TcContext]
  [ids : tc_i64_i64_map.Map]
  [values : (Array AstType)]
  [env : TcTypeEnv]) : unit
  (let
    [seen : (Array i64) (array.make-array i64 (array.length values))]
    [remaining : i64 (tc_i64_i64_map.len (& ids))]
    [cur : TcTypeEnv env]
    [done : bool false]
    (while (and (not done) (> remaining 0))
      (match cur
        [(TcTypeEnv.Nil) (set! done true)]
        [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _) (set! cur (box-get rest))]
        [(TcTypeEnv.Bind name-id _ rest)
          (begin
            (let
              [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
              (if (>= index 0)
                (if (< index (array.length values))
                  (if (= (array-ref seen index) 0)
                    (let
                      [ty : AstType (array-ref values index)]
                      (begin
                        (if (tc-type-needs-resolution? ty)
                          (array-set!
                            values
                            index
                            (tc-resolve-type
                              (tc-top-env-binding-context ctx name-id)
                              ty))
                          unit)
                        (array-set! seen index 1)
                        (set! remaining (- remaining 1))))
                    unit)
                  (io.panic
                    (string.append
                      "typecheck: top-env cache index out of bounds: "
                      (string.append
                        (string.int->string index)
                        (string.append
                          " / "
                          (string.int->string (array.length values)))))))
                unit))
            (set! cur (box-get rest)))]))))

(define (tc-top-env-reresolve-caches! [ctx : TcContext] [env : TcTypeEnv]) : unit
  (match env
    [(TcTypeEnv.Cache ids values _ _ _ _ partial rest below)
      (begin
        (tc-top-env-reresolve-cache-layer! ctx ids values (box-get rest))
        (if partial
          (tc-top-env-reresolve-caches! ctx (box-get below))
          unit))]
    [_ unit]))

(define (tc-refresh-top-env-for-splice
  [ctx : TcContext]
  [base-env : TcTypeEnv]
  [splice : AstDeclList]
  [refresh-decls : AstDeclList]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (begin
    (tc-top-env-reresolve-caches! ctx base-env)
    (match (tc-build-top-env-list-explicit-in-module
      ctx
      splice
      base-env
      module
      module-id)
      [(ResultTcEnv.Ok splice-env)
        (match (tc-build-top-env-list-explicit-in-module
          ctx
          refresh-decls
          splice-env
          module
          module-id)
          [(ResultTcEnv.Ok refreshed-env)
            (ResultTcEnv.Ok
              (tc-env-with-cache-layer-over-explicit refreshed-env))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
      [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))

(define (macro-splice-top-env
  [ctx : TcContext]
  [program : AstProgram]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]
  [plan : MacroSpliceEnvPlan]) : ResultTcEnv
  (match plan
    [(MacroSpliceEnvPlan.Rebuild) (tc-build-top-env ctx program)]
    [(MacroSpliceEnvPlan.Refresh base-env splice refresh-decls)
      (tc-refresh-top-env-for-splice
        ctx
        base-env
        splice
        refresh-decls
        module
        module-id)]
    [(MacroSpliceEnvPlan.Extend base-env summary marker refresh-decls)
      (match (env-extend-with-module ctx base-env summary)
        [(ResultTcEnv.Ok module-env)
          (match (macro-extend-top-env-with-module-marker
            ctx
            module-env
            decls
            marker
            module
            module-id)
            [(ResultTcEnv.Ok marker-env)
              (match (tc-build-top-env-list-explicit-in-module
                ctx
                refresh-decls
                marker-env
                module
                module-id)
                [(ResultTcEnv.Ok refreshed-env)
                  (ResultTcEnv.Ok
                    (tc-env-with-cache-layer-over-explicit refreshed-env))]
                [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
            [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]))

(define (macro-expand-rebuild-context-for-splice
  [cur-ctx : TcContext]
  [next-decls : AstDeclList]
  [next-paths : AstDeclPathList]
  [module : String]
  [module-id : i64]
  [env-plan : MacroSpliceEnvPlan]) : ResultMacroSpliceRebuild
  (let
    [pools : AstNodePoolContext (tc-context-pools cur-ctx)]
    [next-program : AstProgram (ast-program next-decls)]
    (begin
      (macro-live-symbols-invalidate!)
      (tc-clone-able-cache-reset!)
      (tc-nominal-owner-cache-reset!)
      (macro-alias-derived-cache-reset!)
      ;; Do not reset ctfe-module-macro-export here: the export set is stable
      ;; across the splice (additive-inert) and is owned by macro-live-prescan-
      ;; ensure!, which repopulates it when the prescan is recomputed. Clearing it
      ;; here would leave module-hook / module-export-macro? with an empty map for
      ;; the spliced tail's expansion.
      (match (macro-live-symbols-build-or-reuse! next-program next-paths)
        [(ResultCompilerSymbols.Ok next-symbols)
          (let
            [next-registries : CompilerRegistries macro-live-registries-value]
            [next-ctx : TcContext
              (TcContext
                next-program
                next-symbols
                next-registries
                ""
                cbi.compiler-builtin-id-fix-empty
                pools
                (tc-context-source-names cur-ctx))]
            (begin
              (set! macro-expand-active-module "")
              (macro-expand-set-macro-names! macro-live-prescan-visible-names)
              (match (tc-stdlib-comptime-surface-ok-for-macro next-ctx)
                [(ResultTcUnit.Ok)
                  (match (macro-splice-top-env
                    next-ctx
                    next-program
                    next-decls
                    module
                    module-id
                    env-plan)
                    [(ResultTcEnv.Ok top-env)
                      (begin
                        (tc-hygiene-reset-active-top-env! top-env)
                        (tc-context-capture-active-pools! next-ctx)
                        (macro-expand-ctfe-env-build-once! next-ctx)
                        (ResultMacroSpliceRebuild.Ok
                          (tc-context-with-module-id next-ctx module module-id)
                          top-env))]
                    [(ResultTcEnv.Err message)
                      (ResultMacroSpliceRebuild.Err
                        (box (tc-diag-at-start message)))])]
                [(ResultTcUnit.Err message)
                  (ResultMacroSpliceRebuild.Err
                    (box (tc-diag-at-start message)))])))]
        [(ResultCompilerSymbols.Err message)
          (ResultMacroSpliceRebuild.Err
            (box (compiler-symbols-last-error-diagnostic message)))]))))

(define (macro-decl-generated-normal-import? [decl : AstDecl]) : bool
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.Some _ _ _ _ _ _) true]
    [(MacroMaybeGeneratedNormalImport.No) false]))

(define (macro-decls-start-with-module-import-placeholder?
  [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Cons decl _) (macro-decl-module-import-placeholder? decl)]
    [(AstDeclListStep.Nil) false]))

;; The single demand-driven expansion walk. Every macro placeholder is expanded
;; and its splice forced inline: the walk rebuilds the whole-program
;; symbols/env over the spliced view (macro-expand-rebuild-context-for-splice)
;; and then continues over the spliced body itself, so nested placeholders and
;; module placeholders resolve in this same pass. Generated *file* imports (a
;; generated module body importing a source file, or a generated module import
;; of a not-yet-loaded module) are loaded inline through the threaded loader
;; context (stdlib-roots + cfgs) exactly as the retired fixed-point loop's
;; macro-materialize-generated-imports step did -- there is no deferred
;; fallback pass and no follow-up worklist.
(define (macro-expand-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [can-share : bool]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroDeclsWithPaths
  (let
    ;; Generated file imports need the loader's duplicate-path/module set.
    ;; Seed it once, then extend it with each macro splice and loader result;
    ;; rebuilding it from the whole expanded program per import retained tens
    ;; of megabytes of obsolete persistent-env bindings.
    [cur-materialize-seen : sym_i64_env.SymI64Env
      (macro-materialize-seen-from
        (& decls)
        (& paths)
        (sym_i64_env.sym-i64-empty)
        cbi.compiler-builtin-id-fix-empty)]
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-module : String module]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [cur-orig-decls : AstDeclList orig-decls]
    [cur-ctx : TcContext ctx]
    [cur-top-env : TcTypeEnv top-env]
    [cur-can-share : bool can-share]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [out-paths-rev : AstDeclPathList (ast-decl-path-list-new)]
    [result : ResultMacroDeclsWithPaths
      (ResultMacroDeclsWithPaths.Err
        (box (tc-diag-at-start "macro: internal decl expansion walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (begin
              (set!
                result
                (ResultMacroDeclsWithPaths.Ok
                  (macro-decl-list-reverse out-rev)
                  (macro-decl-path-list-reverse out-paths-rev)))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [decl-owner-id : i64
                (ast-decl-path-list-owner-id
                  (& cur-paths)
                  0
                  cbi.compiler-builtin-id-fix-empty)]
              [_set-decl-owner : unit
                (set! macro-active-decl-owner-id decl-owner-id)]
              [rest-paths : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList path-rest]
                      path-rest)]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                    (set!
                      out-paths-rev
                      (ast-decl-path-list-prepend-builder-with-owner-id
                        decl-path
                        decl-owner-id
                        out-paths-rev))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-module (intern-str next-module))
                    (set! cur-module-id next-module))]
                [_
                  (cond
                    [(macro-decl-import-placeholder? decl)
                      (match (macro-expand-decl-with-path
                        cur-ctx
                        cur-top-env
                        cur-orig-decls
                        cur-module
                        cur-module-id
                        decl
                        decl-path)
                        [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                          ;; A deduplicated splice (see
                          ;; macro-decls-splice-with-memo) expands to nothing:
                          ;; drop the placeholder and keep walking -- there is
                          ;; no new name, so no context rebuild is needed.
                          (match (ast-decl-list-step expanded)
                            [(AstDeclListStep.Nil)
                              (begin
                                (set! cur-decls rest)
                                (set! cur-paths rest-paths))]
                            [_
                              (if (and
                                (macro-decl-module-import-placeholder? decl)
                                (macro-module-import-marker-only? expanded))
                                (let
                                  [_update-materialize-seen : unit
                                    (set!
                                      cur-materialize-seen
                                      (macro-materialize-seen-from
                                        (& expanded)
                                        (& expanded-paths)
                                        cur-materialize-seen
                                        cur-module-id))]
                                  [marker-tail : AstDeclList
                                    (macro-scratch-decl-list-append
                                      expanded
                                      rest)]
                                  [next-decls : AstDeclList
                                    (macro-scratch-decl-list-append
                                      (macro-scratch-decl-list-reverse out-rev)
                                      marker-tail)]
                                  [next-decls-for-ctx : AstDeclList
                                    (AstDeclList
                                      (struct-get next-decls slots)
                                      (struct-get next-decls offset)
                                      (struct-get next-decls len)
                                      false)]
                                  [next-ctx : TcContext
                                    (tc-context-with-program
                                      cur-ctx
                                      (ast-program next-decls-for-ctx))]
                                  [refresh-decls : AstDeclList
                                    (macro-scratch-decl-list-filter-path
                                      rest
                                      rest-paths
                                      decl-path)]
                                  [defer-refresh? : bool
                                    (macro-decls-start-with-module-import-placeholder?
                                      rest)]
                                  (begin
                                    (match (macro-extend-top-env-with-module-marker
                                      cur-ctx
                                      cur-top-env
                                      next-decls
                                      expanded
                                      cur-module
                                      cur-module-id)
                                      [(ResultTcEnv.Ok next-top-env)
                                        (begin
                                          (tc-nominal-owner-cache-reset!)
                                          (macro-alias-derived-cache-reset!)
                                          (if defer-refresh?
                                            (begin
                                              (set!
                                                cur-top-env
                                                (tc-env-with-cache-layer-over-explicit
                                                  next-top-env))
                                              (set! cur-orig-decls next-decls)
                                              (set! cur-ctx next-ctx)
                                              (set!
                                                out-rev
                                                (macro-decl-list-reverse-into
                                                  expanded
                                                  out-rev))
                                              (set!
                                                out-paths-rev
                                                (macro-decl-path-list-reverse-into
                                                  expanded-paths
                                                  out-paths-rev))
                                              (set! cur-decls rest)
                                              (set! cur-paths rest-paths))
                                            (match (tc-build-top-env-list-explicit-in-module
                                              next-ctx
                                              refresh-decls
                                              next-top-env
                                              cur-module
                                              cur-module-id)
                                              [(ResultTcEnv.Ok
                                                  refreshed-top-env)
                                                (begin
                                                  (set!
                                                    cur-top-env
                                                    (tc-env-with-cache-layer-over-explicit
                                                      refreshed-top-env))
                                                  (set!
                                                    cur-orig-decls
                                                    next-decls)
                                                  (set! cur-ctx next-ctx)
                                                  (set!
                                                    out-rev
                                                    (macro-decl-list-reverse-into
                                                      expanded
                                                      out-rev))
                                                  (set!
                                                    out-paths-rev
                                                    (macro-decl-path-list-reverse-into
                                                      expanded-paths
                                                      out-paths-rev))
                                                  (set! cur-decls rest)
                                                  (set! cur-paths rest-paths))]
                                              [(ResultTcEnv.Err refresh-message)
                                                (begin
                                                  (set!
                                                    result
                                                    (ResultMacroDeclsWithPaths.Err
                                                      (box
                                                        (tc-diag-at-start
                                                          refresh-message))))
                                                  (set! done true))])))]
                                      [(ResultTcEnv.Err message)
                                        (begin
                                          (set!
                                            result
                                            (ResultMacroDeclsWithPaths.Err
                                              (box (tc-diag-at-start message))))
                                          (set! done true))])
                                    unit))
                                ;; Force the splice inline: rebuild the live
                                ;; symbols/env over the spliced whole-program view
                                ;; so the generated names resolve, and continue the
                                ;; walk over the spliced body itself (its nested
                                ;; placeholders and generated file imports included).
                                (let
                                  [_update-materialize-seen : unit
                                    (set!
                                      cur-materialize-seen
                                      (macro-materialize-seen-from
                                        (& expanded)
                                        (& expanded-paths)
                                        cur-materialize-seen
                                        cur-module-id))]
                                  ;; Build the whole-program view and the walk
                                  ;; tail in one shared backing array per list
                                  ;; instead of append + reverse + append
                                  ;; copies (~5MB of scratch per splice on a
                                  ;; self-compile).
                                  [splice-decl-view : MacroSpliceDeclView
                                    (macro-scratch-splice-decl-view-build
                                      out-rev
                                      expanded
                                      rest)]
                                  [splice-path-view : MacroSplicePathView
                                    (macro-scratch-splice-path-view-build
                                      out-paths-rev
                                      expanded-paths
                                      rest-paths)]
                                  [spliced-tail : AstDeclList
                                    (struct-get splice-decl-view tail)]
                                  [spliced-path-tail : AstDeclPathList
                                    (struct-get splice-path-view tail)]
                                  [next-decls : AstDeclList
                                    (struct-get splice-decl-view view)]
                                  [next-paths : AstDeclPathList
                                    (struct-get splice-path-view view)]
                                  [splice-index : i64
                                    (compiler-decl-list-index-count out-rev)]
                                  [generated-ext : MacroMaybeGeneratedModuleExtension
                                    (macro-generated-module-extension
                                      expanded
                                      cur-module-id)]
                                  ;; An isolated generated-module splice only
                                  ;; appends fresh namespaced declarations, so
                                  ;; the cached CTFE reflection/layout metadata
                                  ;; can be extended additively with just those
                                  ;; decls once the rebuilt context exists,
                                  ;; instead of clearing the cache and paying an
                                  ;; O(program) metadata rebuild per splice.
                                  ;; Arbitrary splices keep the conservative
                                  ;; clear below.
                                  [defer-ctfe-extension : bool
                                    (and
                                      (macro-decls-reflection-relevant?
                                        expanded)
                                      (match generated-ext
                                        [(MacroMaybeGeneratedModuleExtension.No)
                                          false]
                                        [(MacroMaybeGeneratedModuleExtension.Some
                                            _
                                            _)
                                          true]))]
                                  (begin
                                    (if (and
                                      (macro-decls-registry-incremental-safe?
                                        expanded)
                                      (not
                                        (macro-decls-have-unqualified-import-of-module?
                                          next-decls
                                          cur-module-id)))
                                      (if (macro-live-registries-insert-decls!
                                        expanded
                                        expanded-paths
                                        splice-index
                                        cur-module-id)
                                        unit
                                        (macro-live-registries-invalidate!))
                                      (macro-live-registries-invalidate!))
                                    (if (and
                                      (macro-decls-reflection-relevant?
                                        expanded)
                                      (not defer-ctfe-extension))
                                      (compiler-typecheck-ctfe-env-cache-clear!)
                                      unit)
                                    ;; Generated Module catalogs are usually
                                    ;; inert additions, but a full catalog can
                                    ;; legitimately introduce a defmacro. Its
                                    ;; name must be visible to the remaining
                                    ;; declarations in this same expansion
                                    ;; walk (for example `api.one` immediately
                                    ;; after `(import (catalog) as api)`).
                                    ;; Refresh the otherwise additive-inert
                                    ;; prescan before rebuilding the splice
                                    ;; context so the macro-name gate and CTFE
                                    ;; export map include that generated macro.
                                    (if (macro-program-has-defmacro? expanded)
                                      (begin
                                        (macro-live-prescan-reset!)
                                        (macro-live-prescan-ensure! next-decls)
                                        (set!
                                          macro-expand-expr-type-macro-names
                                          macro-live-prescan-expr-type-names)
                                        (set!
                                          ctfe-needs-metadata
                                          (or
                                            ctfe-needs-metadata
                                            macro-live-prescan-has-defmacro))
                                        unit)
                                      unit)
                                    (match (macro-expand-rebuild-context-for-splice
                                      cur-ctx
                                      next-decls
                                      next-paths
                                      cur-module
                                      cur-module-id
                                      (match generated-ext
                                        [(MacroMaybeGeneratedModuleExtension.No)
                                          (MacroSpliceEnvPlan.Refresh
                                            cur-top-env
                                            expanded
                                            (macro-scratch-decl-list-filter-path
                                              rest
                                              rest-paths
                                              decl-path))]
                                        [(MacroMaybeGeneratedModuleExtension.Some
                                            summary
                                            marker)
                                          (MacroSpliceEnvPlan.Extend
                                            cur-top-env
                                            summary
                                            marker
                                            (macro-scratch-decl-list-filter-path
                                              rest
                                              rest-paths
                                              decl-path))]))
                                      [(ResultMacroSpliceRebuild.Ok
                                          next-ctx
                                          next-top-env)
                                        (begin
                                          ;; Extend the reused CTFE metadata
                                          ;; with the spliced module's nominal
                                          ;; declarations now that next-ctx
                                          ;; carries the post-splice registries
                                          ;; the layout build resolves through.
                                          ;; On any inapplicability fall back to
                                          ;; the established clear, which makes
                                          ;; the next consumer rebuild the full
                                          ;; metadata over the spliced program.
                                          (if defer-ctfe-extension
                                            (if (compiler-typecheck-ctfe-env-extend-for-splice!
                                              next-ctx
                                              expanded
                                              cur-module
                                              cur-module-id)
                                              unit
                                              (compiler-typecheck-ctfe-env-cache-clear!))
                                            unit)
                                          (set! cur-ctx next-ctx)
                                          (set! cur-orig-decls next-decls)
                                          (set! cur-top-env next-top-env)
                                          (set! cur-decls spliced-tail)
                                          (set! cur-paths spliced-path-tail))]
                                      [(ResultMacroSpliceRebuild.Err diag)
                                        (begin
                                          (set!
                                            result
                                            (ResultMacroDeclsWithPaths.Err diag))
                                          (set! done true))])
                                    unit)))])]
                        [(ResultMacroDeclExpansion.Err diag)
                          (begin
                            (set! result (ResultMacroDeclsWithPaths.Err diag))
                            (set! done true))])]
                    [(macro-decl-generated-normal-import? decl)
                      ;; A generated module body imports a source file (or a
                      ;; not-yet-loaded module). Load it inline with the
                      ;; threaded loader context, refresh the hoisted prescan
                      ;; (the loaded file may define macros the rest of this
                      ;; walk must see and fire), rebuild the live symbols over
                      ;; the loaded view, extend the current top environment
                      ;; with the newly loaded declarations, and continue the
                      ;; walk over the loaded content -- what the retired fixed-
                      ;; point loop's materialization + re-pass did, inline in
                      ;; this pass. Source-file materialization remains a full
                      ;; symbol/registry rebuild because it can add arbitrary
                      ;; index-bearing declarations; the environment itself is
                      ;; additive and can use the same refresh path as a macro
                      ;; splice instead of retaining another whole-program env.
                      (let
                        ;; Keep the pools context's captured state current
                        ;; around the loader: it parses new content into the
                        ;; active pools, and a later install of a stale capture
                        ;; would roll the pool length back and let subsequent
                        ;; allocations overwrite the loaded (and previously
                        ;; spliced) nodes.
                        [_capture-before-load : unit
                          (tc-context-capture-active-pools! cur-ctx)]
                        (match (macro-materialize-generated-import
                          decl
                          decl-path
                          decl-owner-id
                          cur-module
                          cur-module-id
                          cur-materialize-seen
                          stdlib-roots
                          cfgs
                          (tc-context-pools cur-ctx))
                          [(ResultMacroMaterializeImport.Ok
                              materialized-decls
                              materialized-paths
                              next-materialize-seen)
                            (let
                              [_install-after-load : unit
                                (tc-context-install-pools! cur-ctx)]
                              [materialized-tail : AstDeclList
                                (macro-scratch-decl-list-prefix-rev-current-suffix
                                  (macro-scratch-decl-list-reverse
                                    materialized-decls)
                                  rest)]
                              [next-decls : AstDeclList
                                (macro-scratch-decl-list-append
                                  (macro-scratch-decl-list-reverse out-rev)
                                  materialized-tail)]
                              [next-paths : AstDeclPathList
                                (macro-scratch-decl-path-list-append
                                  (macro-scratch-decl-path-list-reverse
                                    out-paths-rev)
                                  (macro-scratch-decl-path-list-append
                                    materialized-paths
                                    rest-paths))]
                              (begin
                                (set!
                                  cur-materialize-seen
                                  next-materialize-seen)
                                ;; The loaded file may add defmacros or
                                ;; expr-type macros: recompute the hoisted
                                ;; prescan over the new whole-program view
                                ;; before the context rebuild consumes its
                                ;; visible-name set.
                                (macro-live-symbols-invalidate!)
                                ;; Source-file materialization can insert any
                                ;; index-bearing declaration or alias surface,
                                ;; so retain the full registry rebuild even
                                ;; when it contains no nominal declaration.
                                (macro-live-registries-invalidate!)
                                (if (macro-decls-reflection-relevant?
                                  materialized-decls)
                                  (compiler-typecheck-ctfe-env-cache-clear!)
                                  unit)
                                (macro-live-prescan-ensure! next-decls)
                                (set!
                                  macro-expand-expr-type-macro-names
                                  macro-live-prescan-expr-type-names)
                                (set!
                                  ctfe-needs-metadata
                                  (or
                                    ctfe-needs-metadata
                                    macro-live-prescan-has-defmacro))
                                unit
                                (match (macro-expand-rebuild-context-for-splice
                                  cur-ctx
                                  next-decls
                                  next-paths
                                  cur-module
                                  cur-module-id
                                  (MacroSpliceEnvPlan.Refresh
                                    cur-top-env
                                    materialized-decls
                                    (macro-scratch-decl-list-filter-path
                                      rest
                                      rest-paths
                                      decl-path)))
                                  [(ResultMacroSpliceRebuild.Ok
                                      next-ctx
                                      next-top-env)
                                    (begin
                                      (set! cur-ctx next-ctx)
                                      (set! cur-orig-decls next-decls)
                                      (set! cur-top-env next-top-env)
                                      (set! cur-decls materialized-tail)
                                      (set!
                                        cur-paths
                                        (macro-scratch-decl-path-list-append
                                          materialized-paths
                                          rest-paths)))]
                                  [(ResultMacroSpliceRebuild.Err diag)
                                    (begin
                                      (set!
                                        result
                                        (ResultMacroDeclsWithPaths.Err diag))
                                      (set! done true))])))]
                          [(ResultMacroMaterializeImport.Err diag)
                            (begin
                              (set! result (ResultMacroDeclsWithPaths.Err diag))
                              (set! done true))]))]
                    [(and cur-can-share (macro-decl-cannot-fire? decl))
                      ;; Predict-skip: a macro-free value decl can never fire a
                      ;; macro, so share it unchanged (like the AstDecl.Module
                      ;; arm) instead of copying it through the expander. This
                      ;; avoids the per-decl `tc-context-with-module` allocation
                      ;; and the single-element relist that
                      ;; `macro-expand-decl-with-path` would otherwise retain in
                      ;; the installed pools. A non-module value decl never
                      ;; changes the active module, so `cur-module` is unchanged.
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-macro-profile-note-walk-decl-shared))
                        (set!
                          out-rev
                          (ast-decl-list-prepend-builder decl out-rev))
                        (set!
                          out-paths-rev
                          (ast-decl-path-list-prepend-builder-with-owner-id
                            decl-path
                            decl-owner-id
                            out-paths-rev))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths))]
                    [else
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-macro-profile-note-walk-decl-expanded))
                        (match (macro-expand-decl-with-path
                          cur-ctx
                          cur-top-env
                          cur-orig-decls
                          cur-module
                          cur-module-id
                          decl
                          decl-path)
                          [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                            (begin
                              (set!
                                out-rev
                                (macro-decl-list-reverse-into expanded out-rev))
                              (set!
                                out-paths-rev
                                (macro-decl-path-list-reverse-into
                                  expanded-paths
                                  out-paths-rev))
                              (set!
                                cur-module-id
                                (macro-decls-final-module-id
                                  expanded
                                  cur-module-id))
                              (set!
                                cur-module
                                (macro-decl-module-display cur-module-id))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths))]
                          [(ResultMacroDeclExpansion.Err diag)
                            (begin
                              (set! result (ResultMacroDeclsWithPaths.Err diag))
                              (set! done true))]))])]))]))
      result)))

(define (macro-expr-needs-compat-expansion? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "when" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "unless" TcStringList.Nil)))

(define (macro-decl-needs-expansion? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (macro-expr-needs-compat-expansion? expr))]
    [(AstDecl.DefFn decl-meta _ _ _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (macro-expr-needs-compat-expansion? body))]
    [(AstDecl.DefMacro decl-meta _ _ _ _) true]
    [(AstDecl.Test _ _ _) false]
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Macro _ _) true]
        [(AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-needs-expansion? inner))]
    [_ false]))

(define (macro-decl-has-defmacro? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefMacro decl-meta _ _ _ _) true]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-has-defmacro? inner))]
    [_ false]))

;; Whether a program needs the macro expansion pass.
(define (macro-program-needs-expansion? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (or
          (macro-decl-needs-expansion? decl)
          (macro-program-needs-expansion? rest)))]))

(define (macro-program-has-defmacro? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (or (macro-decl-has-defmacro? decl) (macro-program-has-defmacro? rest)))]))

(define (macro-decl-might-fire-expression-macro? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (macro-expr-might-fire? (ast-node-get expr-box))]
    [(AstDecl.DefFn decl-meta _ _ _ body-box _)
      (macro-expr-might-fire? (ast-node-get body-box))]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-might-fire-expression-macro? (box-get inner-box))]
    [_ false]))

(define (macro-program-might-fire-expression-macro? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-might-fire-expression-macro? decl)
        (macro-program-might-fire-expression-macro? rest))]))

(define (macro-import-kind-summary-backed? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportKind.Path) true]
    [(AstImportKind.Module) true]
    [_ false]))

(define (macro-import-target-has-summary-macro?
  [kind : AstImportKind]
  [target : AstMaybeModuleName]) : bool
  (if (macro-import-kind-summary-backed? kind)
    (match target
      [(AstMaybeModuleName.Some target-module)
        (macro-surface-module-has-macro? (intern-str target-module))]
      [(AstMaybeModuleName.No) false])
    false))

(define (macro-decl-has-summary-macro-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind _ target _ _))
      (macro-import-target-has-summary-macro? kind target)]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-has-summary-macro-import? (box-get inner-box))]
    [_ false]))

(define (macro-program-has-summary-macro-import? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-has-summary-macro-import? decl)
        (macro-program-has-summary-macro-import? rest))]))

;; Expand all macro calls in a parsed program before typechecking. Programs that
;; need no macro or guard-compatibility expansion are returned unchanged without
;; rebuilding the AST, so the expansion phase adds no allocation for the common
;; case.
(define (macro-expand-program-pass-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (begin
    (tc-install-pools! pools)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          [_prescan : unit (macro-live-prescan-ensure! decls)]
          [has-defmacro : bool macro-live-prescan-has-defmacro]
          [expr-type-macro-names : TcStringList
            macro-live-prescan-expr-type-names]
          [has-expr-type-macros : bool
            (match expr-type-macro-names
              [(TcStringList.Nil) false]
              [_ true])]
          [program-needs-expansion : bool macro-live-prescan-needs-expansion]
          [has-summary-macro-import : bool macro-live-prescan-summary-import]
          [prescan-macro-names : TcNameIdList
            (if has-summary-macro-import
              macro-live-prescan-visible-names
              (TcNameIdList.Nil))]
          [has-visible-macro-call : bool
            (if has-summary-macro-import
              (begin
                (macro-expand-set-macro-names! prescan-macro-names)
                (macro-program-might-fire-expression-macro? decls))
              false)]
          (begin
            ;; The CTFE-env cache is reset once per program at the macro-expand
            ;; entry and rebuilt at most once per run by
            ;; macro-expand-ctfe-env-build-once! below, then reused (rebased onto
            ;; the active pools) across every in-pass splice rebuild.
            (cfg compile-profile (compiler-tc-macro-profile-reset))
            (cfg compile-profile (compiler-tc-env-profile-reset))
            ;; Same per-compile reset for the clone-able type set cache.
            (tc-clone-able-cache-reset!)
            ;; Type-name misses are keyed only by lookup text; in-pass splice
            ;; rebuilds swap in a different expanded program, so a miss recorded
            ;; against an earlier view must not hide generated module-local
            ;; types introduced since.
            (tc-nominal-owner-cache-reset!)
            ;; Same per-compile reset for the qualified-alias resolution cache:
            ;; the (module, qualifier) -> target mapping is derived from this
            ;; program's declarations.
            (macro-alias-derived-cache-reset!)
            ;; The ctfe-module-macro-export map is not reset per pass: it is owned
            ;; by macro-live-prescan-ensure!, which populates it once (with the
            ;; cached visible-name prescan) and repopulates it on the non-inert
            ;; splice fallback. Clearing it here left every pass after the first
            ;; with an empty export set, breaking module-hook.
            (set! macro-expand-expr-type-macro-names expr-type-macro-names)
            ;; Only build the (tens-of-MB, O(types^2)) reflection/layout metadata if
            ;; the program actually contains a `(type T)` literal -- the sole entry
            ;; point for every CTFE reflection/layout query.
            (set!
              ctfe-needs-metadata
              (or
                has-defmacro
                has-visible-macro-call
                (ctfe-program-has-type-literal? decls)
                has-expr-type-macros))
            (if (or has-defmacro has-visible-macro-call program-needs-expansion)
              (let
                [prefix-reserve : i64 1024]
                [active-decls : AstDeclList
                  (macro-decl-list-with-prefix-reserve decls prefix-reserve)]
                [active-paths : AstDeclPathList
                  (macro-decl-path-list-with-prefix-reserve
                    paths
                    prefix-reserve)]
                [active-program : AstProgram (ast-program active-decls)]
                (begin
                  (macro-expand-scratch-begin!)
                  (cfg compile-profile (compiler-tc-profile-start))
                  (match (macro-live-symbols-build-or-reuse!
                    active-program
                    active-paths)
                    [(ResultCompilerSymbols.Ok symbols)
                      (let
                        [registries : CompilerRegistries
                          macro-live-registries-value]
                        (begin
                          (set! macro-expand-active-module "")
                          (macro-expand-set-macro-names!
                            macro-live-prescan-visible-names)
                          (let
                            [ctx : TcContext
                              (TcContext
                                active-program
                                symbols
                                registries
                                ""
                                cbi.compiler-builtin-id-fix-empty
                                pools
                                source-names)]
                            (match (tc-stdlib-comptime-surface-ok-for-macro ctx)
                              [(ResultTcUnit.Ok)
                                (match (tc-build-top-env ctx active-program)
                                  [(ResultTcEnv.Ok top-env)
                                    (begin
                                      (tc-hygiene-reset-active-top-env! top-env)
                                      (tc-context-capture-active-pools! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-finish
                                          "macro_setup"))
                                      (macro-expand-ctfe-env-build-once! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-start))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-note-walk-share-gate
                                          true))
                                      (match (macro-expand-decls
                                        ctx
                                        top-env
                                        active-decls
                                        active-decls
                                        active-paths
                                        ""
                                        true
                                        stdlib-roots
                                        cfgs)
                                        [(ResultMacroDeclsWithPaths.Ok
                                            ndecls
                                            npaths)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-env-profile-emit-prefix
                                                "macro_"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpand.Ok
                                              (ast-program ndecls)
                                              npaths))]
                                        [(ResultMacroDeclsWithPaths.Err diag)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-env-profile-emit-prefix
                                                "macro_"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpand.Err diag))]))]
                                  [(ResultTcEnv.Err message)
                                    (ResultMacroExpand.Err
                                      (box (tc-diag-at-start message)))])]
                              [(ResultTcUnit.Err message)
                                (ResultMacroExpand.Err
                                  (box (tc-diag-at-start message)))]))))]
                    [(ResultCompilerSymbols.Err message)
                      (ResultMacroExpand.Err
                        (box (compiler-symbols-last-error-diagnostic message)))])))
              (ResultMacroExpand.Ok program paths))))])))

(defenum MacroMaybeGeneratedNormalImport
  (No)
  (Some
    AstImportKind
    String
    AstMaybeModuleName
    AstMaybeImportAlias
    AstSourceSpan
    AstDecl))

(defenum ResultMacroMaterializeImport
  (Ok AstDeclList AstDeclPathList sym_i64_env.SymI64Env)
  (Err (Box CompilerDiagnostic)))

(define (macro-generated-normal-import [decl : AstDecl]) : MacroMaybeGeneratedNormalImport
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some _ _ _ _)
      (let
        [template : AstDecl (ast-decl-unwrapped decl)]
        (match template
          [(AstDecl.Import
              decl-meta
              (AstImportSpec.Spec kind import-path expected alias span))
            (if (macro-import-placeholder-kind? kind)
              (MacroMaybeGeneratedNormalImport.No)
              (MacroMaybeGeneratedNormalImport.Some
                kind
                import-path
                expected
                alias
                (box-get span)
                template))]
          [_ (MacroMaybeGeneratedNormalImport.No)]))]
    [(AstGeneratedDeclMeta.No) (MacroMaybeGeneratedNormalImport.No)]))

(define (macro-materialize-seen-from
  [decls : (& decls AstDeclList)]
  [paths : (& paths AstDeclPathList)]
  [seen : sym_i64_env.SymI64Env]
  [module-id : i64]) : sym_i64_env.SymI64Env
  (let
    [count : i64 (ast-decl-list-len decls)]
    [path-count : i64 (ast-decl-path-list-len paths)]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : sym_i64_env.SymI64Env seen]
    (begin
      (while (< index count)
        (let
          [decl-path : String
            (if (< index path-count)
              (ast-decl-path-list-get paths index "")
              "")]
          [decl-owner-id : i64
            (if (< index path-count)
              (ast-decl-path-list-owner-id
                paths
                index
                cbi.compiler-builtin-id-fix-empty)
              cbi.compiler-builtin-id-fix-empty)]
          (begin
            (if (and
              (> (string.string-length decl-path) 0)
              (not (= decl-owner-id cbi.compiler-builtin-id-fix-empty)))
              (set!
                out
                (sym_i64_env.sym-i64-bind-id
                  out
                  (compiler-load-seen-path-key-id decl-owner-id cur-module-id)
                  1))
              unit)
            (match (ast-decl-list-ref-borrowed decls index)
              [(AstDecl.Module _)
                (match (array-ref
                  (struct-get decls slots)
                  (+ (struct-get decls offset) index))
                  [(AstDecl.Module name)
                    (begin
                      (if (= name cbi.compiler-builtin-id-fix-empty)
                        unit
                        (set! out (sym_i64_env.sym-i64-bind-id out name 1)))
                      (set! cur-module-id name))]
                  [_ unit])]
              [_ unit])
            (set! index (+ index 1)))))
      out)))

(define (macro-materialize-import-diagnostic
  [path : String]
  [span : AstSourceSpan]
  [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic
    (compiler-diagnostic-from-ast-span path span message)))

(define (macro-materialize-generated-import
  [decl : AstDecl]
  [decl-path : String]
  [decl-owner-id : i64]
  [module : String]
  [module-id : i64]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.No)
      (ResultMacroMaterializeImport.Ok
        (ast-decl-cons decl (ast-decl-list-new))
        (ast-decl-path-list-prepend-builder-with-owner-id
          decl-path
          decl-owner-id
          (ast-decl-path-list-new))
        seen)]
    [(MacroMaybeGeneratedNormalImport.Some
        kind
        import-path
        expected
        alias
        span
        _)
      (let
        [import-root : String (compiler-load-dirname decl-path)]
        (match (compiler-load-resolve-import-spec-with-roots
          decl-path
          import-root
          kind
          import-path
          expected
          stdlib-roots)
          [(ResultPkgResolve.Ok resolved)
            (match (compiler-load-file-with-paths-and-roots-expect-cfg-root-import-with-pools
              resolved
              (compiler-load-resolved-path-id-for-generated-import
                resolved
                expected)
              seen
              stdlib-roots
              kind
              import-path
              expected
              import-root
              cfgs
              pools
              module
              module-id)
              [(ResultCompilerLoadWithPaths.Ok
                  imported-decls
                  imported-paths
                  _
                  next-seen)
                (let
                  [after-import-expected : AstMaybeModuleName
                    (compiler-load-after-import-expected-module
                      kind
                      expected
                      alias
                      imported-decls)]
                  [after-import-alias : AstMaybeImportAlias
                    (compiler-load-after-import-alias
                      kind
                      expected
                      alias
                      imported-decls)]
                  [tail-decls : AstDeclList
                    (compiler-load-decls-after-import
                      kind
                      resolved
                      after-import-expected
                      after-import-alias
                      module
                      module-id
                      imported-decls
                      (ast-decl-list-new))]
                  [tail-paths : AstDeclPathList
                    (compiler-load-paths-after-import
                      decl-path
                      decl-owner-id
                      after-import-alias
                      imported-decls
                      (ast-decl-path-list-new))]
                  [materialized-decls : AstDeclList
                    (macro-decl-list-append imported-decls tail-decls)]
                  [materialized-paths : AstDeclPathList
                    (macro-decl-path-list-append imported-paths tail-paths)]
                  (ResultMacroMaterializeImport.Ok
                    materialized-decls
                    materialized-paths
                    next-seen))]
              [(ResultCompilerLoadWithPaths.Err diag)
                (ResultMacroMaterializeImport.Err diag)])]
          [(ResultPkgResolve.Err message)
            (ResultMacroMaterializeImport.Err
              (box (macro-materialize-import-diagnostic decl-path span message)))]))]))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (begin
    (set!
      macro-expand-stdlib-tlci-route-active
      (and
        (= (svec.len (& stdlib-roots)) 0)
        (compiler-load-session-embedded-stdlib-source-used?)))
    (cfg
      embedded-stdlib-tlci
      (if macro-expand-stdlib-tlci-route-active
        (set! macro-expand-stdlib-tlci-catalog-cache (tc_string_i64_map.new))
        unit))
    (cfg embedded-stdlib-tlci (compiler-embedded-stdlib-tlci-session-close!))
    (cfg compile-profile (compiler-tc-macro-profile-reset-program-counters))
    (tc-stdlib-comptime-macro-surface-ok-reset!)
    (macro-generated-module-memo-reset!)
    (macro-generated-decls-memo-reset!)
    ;; Reset the CTFE base-env cache once per program (plan P2). The pass
    ;; rebuilds it via macro-expand-ctfe-env-build-once!; it is then reused by
    ;; every in-pass splice rebuild and by the downstream typecheck/lower
    ;; comptime, never rebuilt per splice. This is the "build the CTFE-env
    ;; once, after expansion" boundary -- macro-expand-then-build-envs wraps it
    ;; for the typecheck entry.
    (compiler-typecheck-ctfe-env-cache-clear!)
    ;; Reset the live symbols/registries cache once per program (plan P2): the
    ;; pass rebuilds them and in-pass splice rebuilds reuse or refresh them.
    (macro-live-symbols-reset!)
    ;; Reset the hoisted whole-program prescans: computed at
    ;; pass setup and refreshed only when a generated file import loads new
    ;; declarations mid-walk.
    (macro-live-prescan-reset!)
    (match (macro-expand-program-pass-with-paths-and-pools
      program
      paths
      pools
      source-names
      stdlib-roots
      cfgs)
      [(ResultMacroExpand.Ok expanded expanded-paths)
        (begin
          (cfg
            embedded-stdlib-tlci
            (compiler-embedded-stdlib-tlci-session-close!))
          (let
            [_profile-owners : unit
              (macro-expand-allocation-profile-snapshot! 0)]
            [_release-scratch : unit (macro-expand-scratch-release!)]
            (if (compiler-specialize-needed? expanded)
              (match (gen-normalize-program-with-paths-and-pools
                expanded
                expanded-paths
                (tc-decl-path-list-last expanded-paths "")
                pools)
                [(ResultGenProgramWithPaths.Ok normalized normalized-paths)
                  (ResultMacroExpand.Ok normalized normalized-paths)]
                [(ResultGenProgramWithPaths.Err diag)
                  (ResultMacroExpand.Err diag)])
              (ResultMacroExpand.Ok expanded expanded-paths))))]
      [(ResultMacroExpand.Err diag)
        (begin
          (cfg
            embedded-stdlib-tlci
            (compiler-embedded-stdlib-tlci-session-close!))
          (macro-expand-allocation-profile-snapshot! 0)
          (macro-expand-scratch-release!)
          (ResultMacroExpand.Err diag))])))

(define (macro-expand-program-with-paths-and-pools-roots-cfg
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names
    program
    paths
    pools
    (ci.intern-source-name-session-capture-active-handle)
    stdlib-roots
    cfgs))

;; Expansion + build-once env boundary (plan P2). Runs the single demand-driven
;; expansion pass (which builds the CTFE base env exactly once and reuses it
;; across in-pass splice rebuilds) and hands the fully-expanded program to the
;; caller. The typecheck entry then builds the heavy top-env once over the
;; expanded program and reuses the CTFE env the expansion left cached, instead
;; of rebuilding either per pass.
(define (macro-expand-then-build-envs
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg
    program
    paths
    pools
    stdlib-roots
    cfgs))

(define (macro-expand-program-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg
    program
    paths
    pools
    (svec.new)
    (compiler-cfg-empty)))

(define (macro-expand-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools
    program
    paths
    (ast-node-pool-context-capture-active)))

(define (macro-expand-program [program : AstProgram]) : ResultMacroExpand
  (macro-expand-program-with-paths program (ast-decl-path-list-new)))

(define (tc-cleanup-owning-struct-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct struct-name)
      (match (tc-struct-decl-id ctx struct-name)
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [(AstType.StructArgs struct-name _)
      (match (tc-struct-decl-id ctx struct-name)
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-enum-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Enum enum-name)
      (match (tc-enum-decl-id ctx enum-name)
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [(AstType.EnumArgs enum-name _)
      (match (tc-enum-decl-id ctx enum-name)
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-aggregate-type? [ctx : TcContext] [ty : AstType]) : bool
  (or
    (tc-cleanup-owning-struct-type? ctx ty)
    (tc-cleanup-owning-enum-type? ctx ty)))

(define (tc-struct-field-cleanup-outside-message
  [struct-name : String]
  [field-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " has cleanup metadata but struct is not cleanup-owning"))

(define (tc-struct-field-cleanup-owning-without-owned-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-struct-field-owned-non-cleanup-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-struct-field-cleanup-fn-mismatch-message
  [struct-name : String]
  [field-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-cleanup-source-slash-alias-helper-name
  [ctx : TcContext]
  [cleanup-name : i64]) : i64
  (match (tc-context-program ctx)
    [(AstProgram.Program decls-box)
      (match (macro-import-alias-target-cached-id
        (box-get decls-box)
        (tc-context-module-id ctx)
        (intern-qualified-module-id cleanup-name))
        [(TcMaybeNameId.Some target-module-id)
          (compiler-symbol-module-key-id-by-id
            target-module-id
            (intern-qualified-base-id cleanup-name))]
        [(TcMaybeNameId.No) cleanup-name])]))

(define (tc-cleanup-field-helper-name
  [ctx : TcContext]
  [owner-name-id : i64]
  [cleanup-name : i64]) : i64
  (let
    [cleanup-str : String (intern-str cleanup-name)]
    (if (tc-source-slash-qualified-id? cleanup-str cleanup-name)
      (tc-cleanup-source-slash-alias-helper-name ctx cleanup-name)
      (if (tc-name-qualified-id? cleanup-name)
        cleanup-name
        (compiler-symbol-module-key-id-by-id
          (let
            [owner-module-id : i64 (tc-qualified-name-module-id owner-name-id)]
            (if (>= owner-module-id 0)
              owner-module-id
              cbi.compiler-builtin-id-fix-empty))
          cleanup-name)))))

(define (tc-check-struct-field-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [field-name : String]
  [cleanup-name : i64]
  [field-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx struct-name-id cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions field-ty) (AstType.Unit))
          (tc-struct-field-cleanup-fn-mismatch-message
            struct-name
            field-name
            (intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [struct-cleanup : AstStructCleanup]
  [field : AstFieldDef]) : ResultTcUnit
  (match field
    [(AstFieldDef.Def field-name ty field-cleanup)
      (let
        [field-name-str : String (intern-str field-name)]
        [resolved-ty : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        [field-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        (if (not (ast-struct-cleanup? struct-cleanup))
          (if (ast-field-cleanup? field-cleanup)
            (ResultTcUnit.Err
              (tc-struct-field-cleanup-outside-message
                struct-name
                field-name-str))
            (if field-cleanup-owning
              (ResultTcUnit.Err
                (tc-struct-field-cleanup-owning-without-owned-message
                  struct-name
                  field-name-str
                  resolved-ty))
              ResultTcUnit.Ok))
          (match field-cleanup
            [(AstFieldCleanup.Owned)
              (if field-cleanup-owning
                ResultTcUnit.Ok
                (ResultTcUnit.Err
                  (tc-struct-field-owned-non-cleanup-message
                    struct-name
                    field-name-str
                    resolved-ty)))]
            [(AstFieldCleanup.Fn cleanup-name)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                (tc-check-struct-field-cleanup-fn
                  ctx
                  env
                  struct-name
                  struct-name-id
                  field-name-str
                  cleanup-name
                  resolved-ty))]
            [(AstFieldCleanup.No)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                ResultTcUnit.Ok)])))]))

(define (tc-check-cleanup-struct-fields
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-check-cleanup-struct-fields-at
    ctx
    env
    struct-name
    struct-name-id
    cleanup
    (& fields)
    0))

(define (tc-check-cleanup-struct-fields-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : AstStructCleanup]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (tc-check-cleanup-struct-field
      ctx
      env
      struct-name
      struct-name-id
      cleanup
      (ast-field-def-list-get fields index (ast-field-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-struct-fields-at
          ctx
          env
          struct-name
          struct-name-id
          cleanup
          fields
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [repr : AstStructRepr]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (let
    [struct-name : String (tc-nominal-name-id-display name-id)]
    (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
      (ResultTcUnit.Err (tc-struct-cleanup-repr-c-message struct-name))
      (tc-check-cleanup-struct-fields
        ctx
        env
        struct-name
        name-id
        cleanup
        fields))))

(define (tc-enum-payload-cleanup-outside-message
  [enum-name : String]
  [variant-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " has payload cleanup metadata but enum is not cleanup-owning"))

(define (tc-enum-payload-cleanup-owning-without-owned-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-enum-payload-owned-non-cleanup-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-enum-payload-cleanup-fn-mismatch-message
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-check-enum-payload-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [cleanup-name : i64]
  [payload-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx enum-name-id cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions payload-ty) (AstType.Unit))
          (tc-enum-payload-cleanup-fn-mismatch-message
            enum-name
            variant-name
            (intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-payloads
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : AstEnumCleanup]
  [payloads : AstTypeList]
  [payload-cleanups : AstVariantPayloadCleanupList]) : ResultTcUnit
  (tc-check-cleanup-enum-payloads-at
    ctx
    env
    enum-name
    enum-name-id
    variant-name
    enum-cleanup
    (& payloads)
    (& payload-cleanups)
    0))

(define (tc-check-cleanup-enum-payloads-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : AstEnumCleanup]
  [payloads : (& payloads AstTypeList)]
  [payload-cleanups : (& payload-cleanups AstVariantPayloadCleanupList)]
  [cleanup-index : i64]) : ResultTcUnit
  (if (>= cleanup-index (ast-type-list-len payloads))
    (if (>=
      cleanup-index
      (ast-variant-payload-cleanup-list-len payload-cleanups))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata"))
    (if (>=
      cleanup-index
      (ast-variant-payload-cleanup-list-len payload-cleanups))
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata")
      (let
        [payload-cleanup : AstVariantPayloadCleanup
          (ast-variant-payload-cleanup-list-get
            payload-cleanups
            cleanup-index
            (ast-variant-payload-cleanup-fallback))]
        [payload-ty : AstType
          (ty-node-get
            (ast-type-list-get payloads cleanup-index (ast-type-id-fallback)))]
        [resolved-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx payload-ty))]
        [payload-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        [step : ResultTcUnit
          (if (not (ast-enum-cleanup? enum-cleanup))
            (if (ast-variant-payload-cleanup? payload-cleanup)
              (ResultTcUnit.Err
                (tc-enum-payload-cleanup-outside-message enum-name variant-name))
              (if payload-cleanup-owning
                (ResultTcUnit.Err
                  (tc-enum-payload-cleanup-owning-without-owned-message
                    enum-name
                    variant-name
                    resolved-ty))
                ResultTcUnit.Ok))
            (match payload-cleanup
              [(AstVariantPayloadCleanup.Owned)
                (if payload-cleanup-owning
                  ResultTcUnit.Ok
                  (ResultTcUnit.Err
                    (tc-enum-payload-owned-non-cleanup-message
                      enum-name
                      variant-name
                      resolved-ty)))]
              [(AstVariantPayloadCleanup.Fn cleanup-name)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  (tc-check-enum-payload-cleanup-fn
                    ctx
                    env
                    enum-name
                    enum-name-id
                    variant-name
                    cleanup-name
                    resolved-ty))]
              [(AstVariantPayloadCleanup.No)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  ResultTcUnit.Ok)]))]
        (match step
          [(ResultTcUnit.Ok)
            (tc-check-cleanup-enum-payloads-at
              ctx
              env
              enum-name
              enum-name-id
              variant-name
              enum-cleanup
              payloads
              payload-cleanups
              (+ cleanup-index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))))

(define (tc-check-cleanup-enum-variant
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : AstEnumCleanup]
  [variant : AstVariantDef]) : ResultTcUnit
  (match variant
    [(AstVariantDef.Def variant-name payloads payload-cleanups)
      (tc-check-cleanup-enum-payloads
        ctx
        env
        enum-name
        enum-name-id
        (intern-str variant-name)
        cleanup
        payloads
        payload-cleanups)]))

(define (tc-check-cleanup-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-check-cleanup-enum-variants-at
    ctx
    env
    enum-name
    enum-name-id
    cleanup
    (& variants)
    0))

(define (tc-check-cleanup-enum-variants-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : AstEnumCleanup]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (tc-check-cleanup-enum-variant
      ctx
      env
      enum-name
      enum-name-id
      cleanup
      (ast-variant-def-list-get variants index (ast-variant-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-enum-variants-at
          ctx
          env
          enum-name
          enum-name-id
          cleanup
          variants
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [_lifetimes : AstLifetimeList]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (let
    [enum-name : String (tc-nominal-name-id-display name-id)]
    ;; The declared cleanup name denotes the function synthesized by lowering.
    ;; Validate payload cleanup requirements without looking for a user body.
    (tc-check-cleanup-enum-variants ctx env enum-name name-id cleanup variants)))

;: Check one function declaration's body against its signature.
(define (tc-check-fn-decl-body
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [body : AstExpr (ast-node-get body-box)]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-bind-return-type
        (tc-type-env-scoped-carrier-bind-params
          ctx
          (tc-type-env-scoped-carrier-from-env global-env)
          params)
        (tc-resolve-type ctx ret))]
    [env : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
    [scoped-save : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter! carrier)]
    [typed-result : ResultTcType
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (let
            [persistent : TcTypeEnv
              (tc-bind-return-type
                (tc-bind-params ctx global-env params)
                (tc-resolve-type ctx ret))]
            (if (tc-type-env-scoped-carrier-fn-entry-matches-persistent?
              carrier
              persistent
              params)
              unit
              (io.panic
                "typecheck: scoped carrier diverged from persistent function env")))
          unit)
        (tc-body-early-exit-function-start!)
        (tc-body-type-facts-start-recording!)
        (tc-expr-with-expected-or-actual-id
          ctx
          env
          body-box
          (tc-resolve-type ctx ret)))]
    [_scoped-restored : unit (tc-type-env-scoped-runtime-restore! scoped-save)]
    [result : ResultTcUnit
      (match typed-result
        [(ResultTcType.Ok got)
          (begin
            (tc-body-type-facts-start-consuming!)
            (match (tc-expect
              got
              (tc-resolve-type ctx ret)
              "typecheck: return type mismatch")
              [(ResultTcUnit.Ok)
                (match (tc-ensure-region-value-can-flow-into
                  env
                  (tc-resolve-type ctx ret)
                  got
                  "return value")
                  [(ResultTcUnit.Ok)
                    (match (tc-move-check-body-id ctx env params body-box)
                      [(ResultTcUnit.Ok)
                        (let
                          [result : ResultTcUnit
                            (tc-borrow-check-body-id-with-ret
                              ctx
                              env
                              params
                              ret
                              body-box)]
                          (begin
                            (match result
                              [(ResultTcUnit.Ok)
                                (tc-body-early-exit-function-finish! body-box)]
                              [(ResultTcUnit.Err _) unit])
                            (tc-body-type-facts-clear!)
                            result))]
                      [(ResultTcUnit.Err message)
                        (begin
                          (tc-body-type-facts-clear!)
                          (ResultTcUnit.Err message))])]
                  [(ResultTcUnit.Err message)
                    (begin
                      (tc-body-type-facts-clear!)
                      (ResultTcUnit.Err
                        (tc-rich-escape-at-expr
                          body
                          message
                          "function return type rejects this escaping value")))])]
              [(ResultTcUnit.Err message)
                (begin
                  (tc-body-type-facts-clear!)
                  (ResultTcUnit.Err message))]))]
        [(ResultTcType.Err message)
          (begin
            (tc-body-type-facts-clear!)
            (ResultTcUnit.Err message))])]
    result))

;; Reusable scratch arena for per-function-body typechecks. Mirrors
;; lower-scratch-arena: created lazily, shared by every check (the body walk
;; is never re-entrant into another function-decl check), reclaimed by
;; mark/rewind per check.
(define tc-fn-scratch-arena : i64
  0)

(define (tc-fn-scratch-arena-get) : i64
  (if (= tc-fn-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! tc-fn-scratch-arena scratch)
        scratch))
    tc-fn-scratch-arena))

(define (tc-fn-scratch-arena-release!) : unit
  (if (= tc-fn-scratch-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-fn-scratch-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-fn-scratch-arena))
      (set! tc-fn-scratch-arena 0))))

(define (tc-fn-scratch-arena-release-after-overflow!
  [scratch : i64]
  [scratch-head : i64]) : unit
  ;; A nonzero region reset deliberately retires overflow segments so stale
  ;; unsafe pointers are never remapped. Function-body scratch has no surviving
  ;; values after clone-out, so destroy the whole arena when a body crossed its
  ;; first segment; otherwise thousands of checked functions retain one 64 MiB
  ;; mapping apiece until the end of the compile.
  (if (= scratch scratch-head)
    unit
    (tc-fn-scratch-arena-release!)))

;; Function bodies dominate typecheck allocation (~96% of the phase's live
;; delta) and the check returns only unit -- everything it allocates
;; is garbage once the body is checked, but the program-lifetime arena never
;; frees it. Run each body check in the shared scratch arena and rewind it
;; afterwards, cloning the error diagnostic out first (the mark/rewind/
;; clone-out shape of lower-function-escaping; do NOT re-run the check to
;; regenerate the message -- the body check is not idempotent and a second
;; run can surface a different diagnostic). The interner owns new spellings
;; at insertion, so its entries survive this rewind. Node pools already grow
;; in the persistent base arena.
(define (tc-check-fn-decl-scoped
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (tc-fn-scratch-arena-get)]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [raw : ResultTcUnit
          (tc-check-fn-decl-body ctx global-env params ret body-box)]
        [scratch-head : i64 (arena.tl_arena_current)]
        (begin
          (unsafe
            (arena.tl_arena_set enclosing))
          (let
            [escaped : ResultTcUnit
              (match raw
                [(ResultTcUnit.Ok) ResultTcUnit.Ok]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err (clone message))])]
            [new-enclosing : i64 (arena.tl_arena_current)]
            (begin
              (unsafe
                (arena.tl_arena_set scratch-head)
                (arena.tl_region_reset mark)
                (arena.tl_arena_set new-enclosing))
              (tc-fn-scratch-arena-release-after-overflow! scratch scratch-head)
              ;; Single-entry name caches may hold strings allocated in the
              ;; scratch that was just rewound; invalidate them before
              ;; anything can compare against freed memory.
              (tc-nominal-owner-cache-reset!)
              escaped)))))))

;; Reusable scratch arena for per-declaration checks that are not function
;; bodies (Def values, macros, externs, dispatches, enum/struct declarations).
;; Same mark/rewind/clone-out shape as the function-body scratch above, but a
;; SEPARATE arena so a function-body scope nested inside a declaration scope
;; (a comptime/unsafe template containing a DefFn) never invalidates a live
;; declaration mark. Released with the function-body scratch at each typecheck
;; boundary.
(define tc-decl-scratch-arena : i64
  0)

;; Open outer declaration scopes in the declaration scratch arena.
;; Compile-time metadata and Unsafe recurse into the declaration dispatcher;
;; nested checks stay inside the outer scope so only that scope rewinds or
;; destroys the arena.
(define tc-decl-scratch-depth : i64
  0)

(define (tc-decl-scratch-arena-get) : i64
  (if (= tc-decl-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! tc-decl-scratch-arena scratch)
        scratch))
    tc-decl-scratch-arena))

(define (tc-decl-scratch-arena-release!) : unit
  (if (= tc-decl-scratch-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-decl-scratch-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-decl-scratch-arena))
      (set! tc-decl-scratch-arena 0))))

;; Non-function declaration checks pin their transient env layers, CTFE eval
;; trees, and partial caches in the persistent arena for the rest of the
;; compile even though the check returns only unit. Run each such check in the
;; shared declaration scratch arena and rewind it afterwards, cloning the error
;; diagnostic out first (the same shape as tc-check-fn-decl-scoped). State that
;; must persist is unaffected: env bindings are built by the module-env walk
;; outside this scope, the interner owns new spellings at insertion, node pools
;; grow in the persistent base arena, and cross-declaration caches live in
;; dedicated persistent arenas. The one cross-declaration cache that cannot be
;; rewound safely, the macro helper env, is rebuilt per declaration instead
;; (reset at the end of this scope).
(define (tc-check-decl-scoped
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (if (> tc-decl-scratch-depth 0)
    ;; Compile-time metadata and Unsafe recursively dispatch their template.
    ;; Keep nested checks in the outer declaration scope: an inner rewind would
    ;; also free an error cloned into that same scratch arena, while the outer
    ;; scope already provides the required reclamation boundary.
    (tc-check-nonfn-decl-with-global-env ctx top-env global-env decl)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (tc-decl-scratch-arena-get)]
      (begin
        (set! tc-decl-scratch-depth (+ tc-decl-scratch-depth 1))
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [mark : i64 (arena.tl_region_mark)]
          [raw : ResultTcUnit
            (tc-check-nonfn-decl-with-global-env ctx top-env global-env decl)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (unsafe
              (arena.tl_arena_set enclosing))
            (let
              [escaped : ResultTcUnit
                (match raw
                  [(ResultTcUnit.Ok) ResultTcUnit.Ok]
                  [(ResultTcUnit.Err message)
                    (ResultTcUnit.Err (clone message))])]
              [new-enclosing : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set scratch-head)
                  (arena.tl_region_reset mark)
                  (arena.tl_arena_set new-enclosing))
                (set! tc-decl-scratch-depth (- tc-decl-scratch-depth 1))
                (if (and
                  (= tc-decl-scratch-depth 0)
                  (not (= scratch scratch-head)))
                  (tc-decl-scratch-arena-release!)
                  unit)
                ;; Single-entry name caches may hold strings allocated in the
                ;; scratch that was just rewound; invalidate them before
                ;; anything can compare against freed memory.
                (tc-nominal-owner-cache-reset!)
                ;; The macro helper env cache persists across declarations, but
                ;; its spine is extended with per-check partial cache layers
                ;; while a DefMacro body is checked; those layers (and any
                ;; rewind-sensitive content reached through them) must not
                ;; outlive this declaration, so rebuild the cache per
                ;; declaration inside the scratch scope.
                (tc-macro-helper-env-cache-reset!)
                escaped))))))))

(define (tc-check-decl-with-global-env-inner
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (begin
    ;; Type-name and owner caches are keyed by text/handle only. Helper passes
    ;; may typecheck with short-lived symbol tables before the final declaration
    ;; walk, so keep cache entries scoped to one checked declaration.
    (tc-nominal-owner-cache-reset!)
    (match decl
      [(AstDecl.DefFn decl-meta _ params ret body-box _)
        (match (tc-elide-function-signature params ret)
          [(ResultTcElidedSignature.Ok signature)
            (tc-check-fn-decl-scoped
              ctx
              global-env
              (struct-get signature params)
              (struct-get signature ret)
              body-box)]
          [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
      [_ (tc-check-decl-scoped ctx top-env global-env decl)])))

(define (tc-check-nonfn-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDecl.Def decl-meta _ maybe-ty expr-box)
      (match maybe-ty
        [(AstMaybeType.Some want)
          (match (tc-expr-with-expected-or-actual-id
            ctx
            global-env
            expr-box
            (tc-resolve-type ctx want))
            [(ResultTcType.Ok got)
              (match (tc-expect
                got
                (tc-resolve-type ctx want)
                "typecheck: value definition type mismatch")
                [(ResultTcUnit.Ok)
                  (tc-ensure-region-value-can-flow-into
                    global-env
                    (tc-resolve-type ctx want)
                    got
                    "top-level value")]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
        [(AstMaybeType.No)
          (match (tc-expr-id ctx global-env expr-box)
            [(ResultTcType.Ok _) ResultTcUnit.Ok]
            [(ResultTcType.Err message) (ResultTcUnit.Err message)])])]
    [(AstDecl.DefFn decl-meta _ params ret body-box _)
      ;; Unreachable via the dispatcher above; kept so a direct call can never
      ;; silently skip a function body check.
      (match (tc-elide-function-signature params ret)
        [(ResultTcElidedSignature.Ok signature)
          (tc-check-fn-decl-scoped
            ctx
            global-env
            (struct-get signature params)
            (struct-get signature ret)
            body-box)]
        [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefMacro decl-meta name params ret body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-check-defmacro name ctx top-env params ret body))]
    [(AstDecl.Extern decl-meta _ kind metadata ty)
      (tc-check-extern-decl ctx kind (box-get metadata) ty)]
    [(AstDecl.DefDispatch decl-meta name variants)
      (match (tc-dispatch-decl-type ctx name variants)
        [(ResultTcType.Ok _) ResultTcUnit.Ok]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefEnum decl-meta name cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        (ast-lifetime-list-new)
        cleanup
        variants)]
    [(AstDecl.DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        lifetimes
        cleanup
        variants)]
    [(AstDecl.DefStruct decl-meta name repr cleanup fields)
      (tc-check-cleanup-struct-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        repr
        cleanup
        fields)]
    [(AstDecl.DefStructLifetimes decl-meta name _ repr cleanup fields)
      (tc-check-cleanup-struct-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        repr
        cleanup
        fields)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-check-decl-with-global-env ctx top-env global-env inner))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (if (ast-decl-comptime-only? decl)
    (let
      [template : AstDecl (ast-decl-with-meta ast-decl-meta-runtime decl)]
      (match (ast-decl-generated-meta decl)
        [(AstGeneratedDeclMeta.Some _ _ _ _)
          (tc-check-decl-with-global-env-inner ctx top-env global-env template)]
        [(AstGeneratedDeclMeta.No)
          (match (tc-check-comptime-decl-purity ctx top-env template)
            [(ResultTcUnit.Ok)
              (tc-check-decl-with-global-env-inner
                ctx
                top-env
                global-env
                template)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]))
    (tc-check-decl-with-global-env-inner ctx top-env global-env decl)))

(define (tc-check-decl [ctx : TcContext] [top-env : TcTypeEnv] [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl-with-global-env
    ctx
    top-env
    (tc-hygiene-global-env top-env)
    decl))

(define (tc-check-decl-scoped-name [ctx : TcContext] [name : i64]) : String
  (let
    [text : String (tc-env-key-name-text name)]
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified-id? name)))
      (compiler-symbol-module-key module text)
      text)))

(define (tc-check-decl-scoped-name-id [ctx : TcContext] [name : i64]) : i64
  (if (and
    (> (string.string-length (tc-context-module ctx)) 0)
    (not (tc-name-qualified-id? name)))
    (tc-module-name-id-by-id (tc-context-module-id ctx) name)
    name))

(define (tc-check-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (tc-check-decls-in-module ctx top-env decls summary ""))

(define (tc-check-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]
  [module : String]) : ResultCompilerTypecheck
  (let
    [cursor : AstDeclList decls]
    [current-summary : CompilerTypecheckSummary summary]
    [current-module : String module]
    [current-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [done : bool false]
    [result : ResultCompilerTypecheck
      (ResultCompilerTypecheck.Ok current-summary)]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil)
            (begin
              (set! result (ResultCompilerTypecheck.Ok current-summary))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [next : AstDeclList rest]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! current-module (intern-str next-module))
                    (set! current-module-id next-module)
                    (set! cursor next))]
                [_
                  (match (tc-module-local-env-id
                    ctx
                    top-env
                    current-module
                    current-module-id)
                    [(ResultTcEnv.Ok local-env)
                      (let
                        [decl-ctx : TcContext
                          (tc-context-with-module-id
                            ctx
                            current-module
                            current-module-id)]
                        (match (tc-check-decl decl-ctx local-env decl)
                          [(ResultTcUnit.Ok)
                            (begin
                              (set!
                                current-summary
                                (tc-summary-add-decl current-summary decl))
                              (set! cursor next))]
                          [(ResultTcUnit.Err message)
                            (begin
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box (tc-decl-diag decl message))))
                              (set! done true))]))]
                    [(ResultTcEnv.Err message)
                      (begin
                        (set!
                          result
                          (ResultCompilerTypecheck.Err
                            (box (tc-decl-diag decl message))))
                        (set! done true))])]))]))
      result)))

(define (tc-decl-path-list-last [paths : AstDeclPathList] [last : String]) : String
  (match (ast-decl-path-list-step paths)
    [(AstDeclPathListStep.Nil) last]
    [(AstDeclPathListStep.Cons path rest)
      (let
        [rest : AstDeclPathList rest]
        (tc-decl-path-list-last rest path))]))

(define (tc-prefix-decl-key-inner [decl : AstDecl]) : String
  (match decl
    [(AstDecl.Module name)
      (str_cat.str-cat "module:" (tc-env-key-name-text name))]
    [(AstDecl.ModuleBody name _)
      (str_cat.str-cat "module-body:" (tc-env-key-name-text name))]
    [(AstDecl.Def decl-meta name _ _)
      (str_cat.str-cat "def:" (tc-env-key-name-text name))]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (str_cat.str-cat "fn:" (tc-env-key-name-text name))]
    [(AstDecl.DefMacro decl-meta name _ _ _)
      (str_cat.str-cat "macro:" (tc-env-key-name-text name))]
    [(AstDecl.Extern decl-meta name _ _ _)
      (str_cat.str-cat "extern:" (tc-env-key-name-text name))]
    [(AstDecl.DefEnum decl-meta name _ _)
      (str_cat.str-cat "enum:" (tc-env-key-name-text name))]
    [(AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (str_cat.str-cat "enum-lifetimes:" (tc-env-key-name-text name))]
    [(AstDecl.DefStruct decl-meta name _ _ _)
      (str_cat.str-cat "struct:" (tc-env-key-name-text name))]
    [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (str_cat.str-cat "struct-lifetimes:" (tc-env-key-name-text name))]
    [(AstDecl.Import decl-meta _) "import"]
    [(AstDecl.IncludeStr name _)
      (str_cat.str-cat "include-str:" (tc-env-key-name-text name))]
    [(AstDecl.IncludeStrComptime name _)
      (str_cat.str-cat "include-str-comptime:" (tc-env-key-name-text name))]
    [(AstDecl.IncludeStrLzss name _)
      (str_cat.str-cat "include-str-lzss:" (tc-env-key-name-text name))]
    [(AstDecl.IncludeBin name _)
      (str_cat.str-cat "include-bin:" (tc-env-key-name-text name))]
    [(AstDecl.DefDispatch decl-meta name _)
      (str_cat.str-cat "dispatch:" (tc-env-key-name-text name))]
    [(AstDecl.Test name _ _)
      (str_cat.str-cat "test:" (tc-env-key-name-text name))]
    [(AstDecl.Unsafe inner)
      (str_cat.str-cat "unsafe:" (tc-prefix-decl-key-inner (box-get inner)))]))

(define (tc-prefix-decl-key [decl : AstDecl]) : String
  (if (ast-decl-comptime-only? decl)
    (str_cat.str-cat "comptime:" (tc-prefix-decl-key-inner decl))
    (tc-prefix-decl-key-inner decl)))

(define (tc-prefix-key-add [key : String] [decl-path : String] [decl : AstDecl]) : String
  (str_cat.str-cat
    key
    (string.int->string (string.string-length decl-path))
    ":"
    decl-path
    ":"
    (tc-prefix-decl-key decl)
    ";"))

(define (tc-prefix-key-add-entry-module-marker [key : String] [module : String]) : String
  (str_cat.str-cat
    key
    "entry-module:"
    (string.int->string (string.string-length module))
    ":"
    module
    ";"))

(define (tc-prefix-key-start [scope : String]) : String
  (str_cat.str-cat
    "tc-prefix-v3;"
    (string.int->string (string.string-length scope))
    ":"
    scope
    ";"))

(define (tc-prefix-default-cache-scope) : String
  "direct")

(define (tc-prefix-cache-stdlib-path? [path : String] [stdlib-roots : svec.Vec]) : bool
  (if (compiler-load-stdlib-import? path)
    true
    (let
      [normalized : String (compiler-load-normalize-path path)]
      (if (compiler-load-stdlib-import? normalized)
        true
        (compiler-load-path-under-roots-from?
          normalized
          stdlib-roots
          0
          (svec.len (& stdlib-roots)))))))

(define (tc-prefix-cache-module-marker? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Module name)
      (> (string.string-length (tc-env-key-name-text name)) 0)]
    [_ false]))

(define (tc-prefix-cache-decl-safe?
  [decl-path : String]
  [decl : AstDecl]
  [stdlib-roots : svec.Vec]
  [same-path-module-safe : bool]) : bool
  (if (tc-prefix-cache-stdlib-path? decl-path stdlib-roots)
    true
    (or same-path-module-safe (tc-prefix-cache-module-marker? decl))))

(define (tc-prefix-candidate-from
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [entry-path : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [active-path : String]
  [active-path-module-safe : bool]
  [key : String]) : TcPrefixCandidate
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (TcPrefixCandidate.No)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) ""])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [same-path : bool (string.eq active-path decl-path)]
        [same-path-module-safe : bool
          (if same-path
            active-path-module-safe
            false)]
        [decl-module-safe : bool
          (or same-path-module-safe (tc-prefix-cache-module-marker? decl))]
        (cond
          [(and
              (string.eq decl-path entry-path)
              (= count 0)
              (tc-prefix-cache-module-marker? decl))
            (let
              [next-module : String
                (match decl
                  [(AstDecl.Module next-module) (intern-str next-module)]
                  [_ module])]
              [next-module-id : i64
                (match decl
                  [(AstDecl.Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                next-module-id
                decl-path
                true
                (tc-prefix-key-add-entry-module-marker key next-module)))]
          [(string.eq decl-path entry-path)
            (if (> count 0)
              (TcPrefixCandidate.Some key count module module-id)
              (TcPrefixCandidate.No))]
          [(tc-prefix-cache-decl-safe?
              decl-path
              decl
              stdlib-roots
              same-path-module-safe)
            (let
              [next-module : String
                (match decl
                  [(AstDecl.Module next-module) (intern-str next-module)]
                  [_ module])]
              [next-module-id : i64
                (match decl
                  [(AstDecl.Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                next-module-id
                decl-path
                decl-module-safe
                (tc-prefix-key-add key decl-path decl)))]
          [(> count 0) (TcPrefixCandidate.Some key count module module-id)]
          [else (TcPrefixCandidate.No)]))]))

(define (tc-prefix-candidate
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : TcPrefixCandidate
  (let
    [entry-path : String (tc-decl-path-list-last paths "")]
    [effective-roots : svec.Vec (compiler-load-roots-with-env stdlib-roots)]
    (if (string.eq entry-path "")
      (TcPrefixCandidate.No)
      (tc-prefix-candidate-from
        decls
        paths
        effective-roots
        entry-path
        0
        ""
        cbi.compiler-builtin-id-fix-empty
        ""
        false
        (tc-prefix-key-start cache-scope)))))

(define (tc-decl-list-take [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    (ast-decl-list-new)
    (let
      [len : i64 (ast-decl-list-len (& decls))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (AstDeclList
        (struct-get decls slots)
        (struct-get decls offset)
        take-count
        false))))

(define (tc-decl-path-list-take [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    (ast-decl-path-list-new)
    (let
      [len : i64 (ast-decl-path-list-len (& paths))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (AstDeclPathList
        (struct-get paths slots)
        (struct-get paths owner-ids)
        (struct-get paths offset)
        take-count
        false))))

(define (tc-decl-list-drop [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    decls
    (let
      [len : i64 (ast-decl-list-len (& decls))]
      (if (>= count len)
        (ast-decl-list-new)
        (AstDeclList
          (struct-get decls slots)
          (+ (struct-get decls offset) count)
          (- len count)
          false)))))

(define (tc-decl-path-list-drop [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    paths
    (let
      [len : i64 (ast-decl-path-list-len (& paths))]
      (if (>= count len)
        (ast-decl-path-list-new)
        (AstDeclPathList
          (struct-get paths slots)
          (struct-get paths owner-ids)
          (+ (struct-get paths offset) count)
          (- len count)
          false)))))

(define (tc-check-decls-with-paths-cold
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      decls
      paths
      summary
      ""
      cbi.compiler-builtin-id-fix-empty
      (TcModuleLocalEnvCache.Nil))))

(define (tc-check-decls-with-prefix-hit
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-hit!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      summary
      module
      module-id
      (TcModuleLocalEnvCache.Nil))))

(define (tc-check-decls-with-prefix-miss
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-miss!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (match (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-take decls count)
      (tc-decl-path-list-take paths count)
      (CompilerTypecheckSummary 0 0 0)
      ""
      cbi.compiler-builtin-id-fix-empty
      (TcModuleLocalEnvCache.Nil))
      [(ResultCompilerTypecheck.Ok prefix-summary)
        (begin
          (tc-prefix-snapshot-cache-store-persistent
            key
            count
            module
            module-id
            prefix-summary)
          (cfg compile-profile (compiler-tc-decl-profile-reset))
          (tc-check-decls-with-paths-in-module
            ctx
            top-env
            (tc-decl-list-drop decls count)
            (tc-decl-path-list-drop paths count)
            prefix-summary
            module
            module-id
            (TcModuleLocalEnvCache.Nil)))]
      [(ResultCompilerTypecheck.Err diag) (ResultCompilerTypecheck.Err diag)])))

(define (tc-check-decls-with-paths
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerTypecheck
  ;; A cached prefix contains only its summary, not semantic observations from
  ;; the declarations it skipped. Clone-root collection therefore takes the
  ;; ordinary declaration walk even when the interactive prefix cache is on.
  (if (and
    (tc-prefix-snapshot-cache-active?)
    (not tc-clone-root-collection-active))
    (match (tc-prefix-candidate decls paths stdlib-roots cache-scope)
      [(TcPrefixCandidate.Some key count module module-id)
        (match (tc-prefix-snapshot-cache-lookup key)
          [(TcPrefixSnapshotLookup.Hit
              cached-count
              cached-module
              cached-module-id
              cached-summary)
            (tc-check-decls-with-prefix-hit
              ctx
              top-env
              decls
              paths
              cached-count
              cached-module
              cached-module-id
              cached-summary)]
          [(TcPrefixSnapshotLookup.Miss)
            (tc-check-decls-with-prefix-miss
              ctx
              top-env
              decls
              paths
              key
              count
              module
              module-id)])]
      [(TcPrefixCandidate.No)
        (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])
    (tc-check-decls-with-paths-cold ctx top-env decls paths summary)))

(define (tc-generated-clone-name? [name : String]) : bool
  (if (>= (string.string-length name) 6)
    (string.eq (string.substring name 0 6) "clone$")
    false))

(define (tc-generated-clone-decl-with-path? [decl : AstDecl] [path : String]) : bool
  (if (string.eq path "")
    (match decl
      [(AstDecl.DefFn decl-meta name _ _ _ _)
        (tc-generated-clone-name? (tc-env-key-name-text name))]
      [_ false])
    false))

(define (tc-typecheck-diag-with-maybe-origin-and-path
  [origin : CompilerParseMaybeDeclSpan]
  [decl : AstDecl]
  [path : String]
  [message : String]) : CompilerDiagnostic
  (let
    [diag : CompilerDiagnostic
      (tc-decl-diag-with-maybe-origin origin decl message)]
    (if (string.eq path "")
      diag
      (compiler-diagnostic-with-path diag path))))

(define (tc-typecheck-diag-with-path
  [decls : (& decls AstDeclList)]
  [decl : AstDecl]
  [path : String]
  [message : String]) : CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    (compiler-parse-decl-origin-span decls 0)
    decl
    path
    message))

(define (tc-typecheck-diag-with-rest-path
  [rest : (& rest AstDeclList)]
  [decl : AstDecl]
  [path : String]
  [message : String]) : CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    (compiler-parse-decl-origin-span-key-slot
      (compiler-parse-decl-list-storage-key rest)
      (- (struct-get rest offset) 1))
    decl
    path
    message))

;; Direct declaration typechecking stays below the self-build memory budget and
;; avoids the per-declaration scratch arena overhead.
(define (tc-check-decl-escaping
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl ctx top-env decl))

(define (tc-check-decls-with-paths-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-start-section))
    (match (tc-module-local-env-cached-id ctx top-env module module-id cache)
      [(ResultTcModuleLocalEnv.Ok local-env next-cache)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (tc-check-decls-with-paths-in-module-env
            ctx
            top-env
            decls
            paths
            summary
            module
            module-id
            next-cache
            local-env
            (tc-hygiene-global-env local-env)))]
      [(ResultTcModuleLocalEnv.Err message)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (ResultCompilerTypecheck.Err (box (tc-diag-at-start message))))])))

(define (tc-check-decls-with-paths-in-module-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]
  [local-env : TcTypeEnv]
  [global-env : TcTypeEnv]) : ResultCompilerTypecheck
  ;; This walks every expanded top-level declaration during self-compile.
  ;; Keep it iterative so a large program does not consume one native stack frame
  ;; per declaration on Windows selfhost binaries.
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-summary : CompilerTypecheckSummary summary]
    [cur-module-id : i64 module-id]
    [cur-module : String (clone module)]
    [cur-cache : TcModuleLocalEnvCache cache]
    [cur-local-env : TcTypeEnv local-env]
    [cur-global-env : TcTypeEnv global-env]
    [result : ResultCompilerTypecheck
      (ResultCompilerTypecheck.Err
        (box (tc-diag-at-start "typecheck: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (begin
              (cfg compile-profile (compiler-tc-decl-profile-finish))
              (set! result (ResultCompilerTypecheck.Ok cur-summary))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons path _) path]
                  [(AstDeclPathListStep.Nil) ""])]
              [rest-paths : AstDeclPathList
                (match (ast-decl-path-list-step cur-paths)
                  [(AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList path-rest]
                      path-rest)]
                  [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
              [_select-clone-root-decl : unit
                (tc-clone-root-collection-select-decl! decl cur-module-id)]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-tc-decl-profile-start-section))
                    (tc-context-capture-active-pools! ctx)
                    (match (tc-module-local-env-cached-id
                      ctx
                      top-env
                      (intern-str next-module)
                      next-module
                      cur-cache)
                      [(ResultTcModuleLocalEnv.Ok next-local-env next-cache)
                        (match (tc-module-local-env-cached-id
                          ctx
                          top-env
                          (intern-str next-module)
                          next-module
                          cur-cache)
                          [(ResultTcModuleLocalEnv.Ok next-local-env-copy _)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set! cur-module (intern-str next-module))
                              (set! cur-module-id next-module)
                              (set! cur-cache next-cache)
                              (set!
                                cur-global-env
                                (tc-hygiene-global-env next-local-env))
                              (set! cur-local-env next-local-env-copy))]
                          [(ResultTcModuleLocalEnv.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box
                                    (tc-typecheck-diag-with-rest-path
                                      (& rest)
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))])]
                      [(ResultTcModuleLocalEnv.Err message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-decl-profile-add-local-env))
                          (set!
                            result
                            (ResultCompilerTypecheck.Err
                              (box
                                (tc-typecheck-diag-with-rest-path
                                  (& rest)
                                  decl
                                  decl-path
                                  message))))
                          (set! done true))]))]
                [_
                  (if (tc-generated-clone-decl-with-path? decl decl-path)
                    (begin
                      (set! cur-decls rest)
                      (set! cur-paths rest-paths)
                      (set! cur-summary (tc-summary-add-decl cur-summary decl)))
                    (let
                      [decl-ctx : TcContext
                        (tc-context-with-module-id ctx cur-module cur-module-id)]
                      [prev-path : String
                        (tc-unused-unsafe-set-current-path! decl-path)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-decl-profile-start-section))
                        (tc-context-capture-active-pools! decl-ctx)
                        (match (tc-check-decl-with-global-env
                          decl-ctx
                          cur-local-env
                          cur-global-env
                          decl)
                          [(ResultTcUnit.Ok)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-record decl))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set!
                                cur-summary
                                (tc-summary-add-decl cur-summary decl)))]
                          [(ResultTcUnit.Err message)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (set!
                                result
                                (ResultCompilerTypecheck.Err
                                  (box
                                    (tc-typecheck-diag-with-rest-path
                                      (& rest)
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))]))))]))]))
      result)))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools-and-source-names
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerTypecheckChecked
  (begin
    (tc-nominal-owner-cache-reset!)
    (tc-install-pools! pools)
    (match (build-compiler-symbols-diagnostic-with-paths program paths)
      [(ResultCompilerSymbolsDiagnostic.Ok symbols)
        (match (build-compiler-registries-diagnostic-with-symbols-and-paths
          program
          symbols
          paths)
          [(ResultCompilerRegistriesDiagnostic.Ok registries)
            (let
              [ctx : TcContext
                (TcContext
                  program
                  symbols
                  registries
                  ""
                  cbi.compiler-builtin-id-fix-empty
                  pools
                  source-names)]
              (match (tc-stdlib-comptime-surface-ok ctx)
                [(ResultTcUnit.Ok)
                  (match (tc-program-source-types-policy-ok ctx program paths)
                    [(ResultTcSourcePolicyDiagnostic.Ok)
                      (match (tc-build-top-env ctx program)
                        [(ResultTcEnv.Ok top-env)
                          (match program
                            [(AstProgram.Program decls-box)
                              (let
                                [decls : AstDeclList (box-get decls-box)]
                                (begin
                                  (tc-hygiene-reset-active-top-env! top-env)
                                  (tc-context-capture-active-pools! ctx)
                                  (tc-clone-able-cache-populate! ctx)
                                  (tc-macro-helper-env-cache-reset!)
                                  (match (tc-check-decls-with-paths
                                    ctx
                                    top-env
                                    decls
                                    paths
                                    (CompilerTypecheckSummary 0 0 0)
                                    stdlib-roots
                                    cache-scope)
                                    [(ResultCompilerTypecheck.Ok summary)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (ResultCompilerTypecheckChecked.Ok
                                          summary
                                          ctx
                                          top-env))]
                                    [(ResultCompilerTypecheck.Err diag)
                                      (ResultCompilerTypecheckChecked.Err diag)])))])]
                        [(ResultTcEnv.Err message)
                          (ResultCompilerTypecheckChecked.Err
                            (box (tc-diag-at-start message)))])]
                    [(ResultTcSourcePolicyDiagnostic.Err diag)
                      (ResultCompilerTypecheckChecked.Err diag)])]
                [(ResultTcUnit.Err message)
                  (ResultCompilerTypecheckChecked.Err
                    (box (tc-diag-at-start message)))]))]
          [(ResultCompilerRegistriesDiagnostic.Err diag)
            (ResultCompilerTypecheckChecked.Err diag)])]
      [(ResultCompilerSymbolsDiagnostic.Err diag)
        (ResultCompilerTypecheckChecked.Err diag)])))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools-and-source-names
    program
    paths
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner
      program
      paths
      stdlib-roots
      cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools-and-source-names
      program
      paths
      stdlib-roots
      cache-scope
      pools
      source-names)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names
    program
    paths
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (typecheck-compiler-specialized-program-with-paths-checked
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    (svec.new)
    (tc-prefix-default-cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    stdlib-roots
    cache-scope)
    [(ResultCompilerTypecheckChecked.Ok summary _ _)
      (ResultCompilerTypecheck.Ok summary)]
    [(ResultCompilerTypecheckChecked.Err diag)
      (ResultCompilerTypecheck.Err diag)]))

(define (typecheck-compiler-specialized-program-with-paths-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    pools)
    [(ResultCompilerTypecheckChecked.Ok summary _ _)
      (ResultCompilerTypecheck.Ok summary)]
    [(ResultCompilerTypecheckChecked.Err diag)
      (ResultCompilerTypecheck.Err diag)]))

(define (typecheck-compiler-specialized-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheck
  (typecheck-compiler-specialized-program-with-paths-cache
    program
    paths
    (svec.new)
    (tc-prefix-default-cache-scope)))

(define (compiler-typecheck-clear-macro-expanded-source-caches!) : unit
  (begin
    (tc-clone-able-cache-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-spmd-inline-helper-stack-reset!)
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (tc-stdlib-comptime-macro-surface-ok-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    (macro-alias-cache-reset!)
    (compiler-load-surface-summaries-reset!)
    (ctfe-build-seen-reset!)
    (set! macro-expand-active-module "")
    (macro-expand-set-macro-names! (TcNameIdList.Nil))
    (set! macro-expand-expr-type-macro-names (TcStringList.Nil))
    (compiler-typecheck-ctfe-env-cache-clear!)
    (macro-live-symbols-reset!)
    (macro-live-prescan-reset!)
    (set! tc-hygiene-active-top-env-ready false)
    (set! tc-hygiene-active-top-env (tc-empty-type-env))
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))
    (set! tc-lazy-import-summary-macro-force-record-count 0)
    (ctfe-module-macro-export-reset!)
    (set! ctfe-needs-metadata true)
    (macro-generated-module-memo-reset!)
    (macro-generated-decls-memo-reset!)))

(define (compiler-typecheck-reset-file-state!) : unit
  (begin
    (tc-fn-scratch-arena-release!)
    (tc-decl-scratch-arena-release!)
    (tc-body-early-exit-facts-abort!)
    (ctfe-builtin-reset!)
    (set! tc-stdlib-comptime-syntax-type-cache-generation -1)
    (tc-clone-able-cache-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-spmd-inline-helper-stack-reset!)
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (tc-stdlib-comptime-macro-surface-ok-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    (macro-alias-cache-reset!)
    (tc-lazy-import-stubs-reset!)
    (compiler-load-surface-summaries-reset!)
    (ctfe-build-seen-reset!)
    (set! tc-hygiene-active-top-env-ready false)
    (set! tc-hygiene-active-top-env (tc-empty-type-env))
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))
    (set! macro-expand-active-module "")
    (macro-expand-set-macro-names! (TcNameIdList.Nil))
    (set! macro-expand-expr-type-macro-names (TcStringList.Nil))
    (set! macro-expand-ctfe-env-ready false)
    (set! macro-expand-ctfe-env-has-metadata false)
    (set! macro-expand-ctfe-env-value (ctfe-env-empty))
    (macro-live-symbols-reset!)
    (macro-live-prescan-reset!)
    (set! tc-lazy-import-summary-macro-force-record-count 0)
    (ctfe-module-macro-export-reset!)
    (set! ctfe-needs-metadata true)))

(define (compiler-typecheck-reset-intern-owned-state!) : unit
  (begin
    (set! tc-type-env-scoped-runtime-marker-id-generation -1)
    (set! tc-stdlib-comptime-syntax-type-cache-generation -1)
    (set! tc-comptime-helper-prefix-cache-generation -1)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))