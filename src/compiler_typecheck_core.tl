(define tc-macro-helper-env-cache-ready : bool
  false)
(define tc-macro-helper-env-cache-value : TcTypeEnv
  (TcTypeEnv.Nil))

(define (tc-macro-helper-env-cache-reset!) : unit
  (begin
    (set! tc-macro-helper-env-cache-ready false)
    (set! tc-macro-helper-env-cache-value (TcTypeEnv.Nil))))

(define (tc-macro-helper-env-cached [env : TcTypeEnv]) : TcTypeEnv
  (if tc-macro-helper-env-cache-ready
    tc-macro-helper-env-cache-value
    (let
      [helper-env : TcTypeEnv (tc-macro-helper-env env)]
      (begin
        (set! tc-macro-helper-env-cache-value helper-env)
        (set! tc-macro-helper-env-cache-ready true)
        tc-macro-helper-env-cache-value))))

(define (tc-env-key-display [name-id : i64]) : String
  (if (or
    (tc-env-key-has-name-id? name-id)
    (macro-hygiene-global-id? name-id)
    (tc-structural-local-name-id? name-id))
    (tc-hygiene-name-text-id name-id)
    (let
      [capacity : i64 (intern-capacity)]
      [pair-limit : i64 (+ capacity (* capacity capacity))]
      (if (and (>= name-id capacity) (< name-id pair-limit))
        (let
          [packed : i64 (- name-id capacity)]
          [module-id : i64 (/ packed capacity)]
          [base-id : i64 (% packed capacity)]
          (compiler-symbol-module-key
            (intern-str module-id)
            (intern-str base-id)))
        (string.append
          "<structural-id:"
          (string.append (string.int->string name-id) ">"))))))

(define (tc-env-key-name-text [name-id : i64]) : String
  (if (or
    (tc-env-key-has-name-id? name-id)
    (macro-hygiene-global-id? name-id)
    (tc-structural-local-name-id? name-id))
    (tc-hygiene-name-text-id name-id)
    (tc-env-key-display name-id)))

(define (tc-lookup-persistent-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (let
      [lookup-id : i64 (tc-env-name-key-id name-id)]
      [cur : TcTypeEnv env]
      [done : bool false]
      [found : bool false]
      [found-ty : AstType (AstType.Unit)]
      (begin
        (while (not done)
          (match cur
            [(TcTypeEnv.Nil) (set! done true)]
            [(TcTypeEnv.Cache ids values _ _ _ _ partial _ below)
              (let
                [index : i64 (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
                (if (>= index 0)
                  (begin
                    ;; AstType is multi-word; keep this checked value read.
                    (set! found-ty (array-ref values index))
                    (set! found true)
                    (set! done true))
                  (if partial
                    (set! cur (box-get below))
                    (set! done true))))]
            [(TcTypeEnv.Bind key ty rest)
              (if (= key lookup-id)
                (begin
                  (set! found-ty ty)
                  (set! found true)
                  (set! done true))
                (set! cur (box-get rest)))]))
        (if found
          (ResultTcType.Ok found-ty)
          (ResultTcType.Err
            (string.append
              "typecheck: unbound name "
              (tc-env-key-display name-id))))))))

(define (tc-lookup-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (if tc-type-env-scoped-runtime-active
    (let
      [index : i64 (tc-type-env-scoped-runtime-lookup-index name-id)]
      [scoped : ResultTcType
        (if (>= index 0)
          (begin
            (cfg compile-profile (compiler-tc-env-profile-note-lookup))
            (ResultTcType.Ok
              (struct-get
                (array-ref
                  (struct-get
                    (struct-get
                      (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                      stack)
                    slots)
                  index)
                ty)))
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-tail-fallback))
            (tc-lookup-persistent-id
              (struct-get
                (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                persistent)
              name-id)))]
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (if (tc-type-env-scoped-dual-result-type-matches? scoped env name-id)
            unit
            (io.panic
              "typecheck: scoped type lookup diverged from persistent env")))
        scoped))
    (tc-lookup-persistent-id env name-id)))

(define (tc-name-bound-persistent-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [lookup-id : i64 (tc-env-name-key-id name-id)]
    [cur : TcTypeEnv env]
    [done : bool false]
    [found : bool false]
    (begin
      (while (not done)
        (match cur
          [(TcTypeEnv.Nil) (set! done true)]
          [(TcTypeEnv.Cache ids _ _ _ _ _ partial _ below)
            (let
              [index : i64 (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
              (if (>= index 0)
                (begin
                  (set! found true)
                  (set! done true))
                (if partial
                  (set! cur (box-get below))
                  (set! done true))))]
          [(TcTypeEnv.Bind key _ rest)
            (if (= key lookup-id)
              (begin
                (set! found true)
                (set! done true))
              (set! cur (box-get rest)))]))
      found)))

(define (tc-name-bound-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (let
      [scoped : bool
        (if (>= (tc-type-env-scoped-runtime-lookup-index name-id) 0)
          true
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-tail-fallback))
            (tc-name-bound-persistent-id?
              (struct-get
                (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                persistent)
              name-id)))]
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (if (= scoped (tc-name-bound-persistent-id? env name-id))
            unit
            (io.panic
              "typecheck: scoped exact-bound lookup diverged from persistent env")))
        scoped))
    (tc-name-bound-persistent-id? env name-id)))

(define (tc-lookup-unsafe-persistent-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (let
      [lookup-id : i64 (tc-env-name-key-id name-id)]
      [cur : TcTypeEnv env]
      [done : bool false]
      [found : bool false]
      [found-ty : AstType (AstType.Unit)]
      [found-unsafe : bool false]
      (begin
        (while (not done)
          (match cur
            [(TcTypeEnv.Nil) (set! done true)]
            [(TcTypeEnv.Cache ids values unsafe-flags _ _ _ partial _ below)
              (let
                [index : i64 (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
                (if (>= index 0)
                  (begin
                    ;; AstType read stays checked; the flag is scalar i64.
                    (set! found-ty (array-ref values index))
                    (set!
                      found-unsafe
                      (=
                        (unsafe
                          (ptr-read
                            (ptr-offset
                              (ptr-cast (array-data unsafe-flags) : (Ptr i64))
                              index)))
                        1))
                    (set! found true)
                    (set! done true))
                  (if partial
                    (set! cur (box-get below))
                    (set! done true))))]
            [(TcTypeEnv.Bind key ty rest)
              (if (= key lookup-id)
                (begin
                  (set! found-ty ty)
                  (set!
                    found-unsafe
                    (tc-binding-unsafe-marker-head-id? (box-get rest) lookup-id))
                  (set! found true)
                  (set! done true))
                (set! cur (box-get rest)))]))
        (if found
          (ResultTcTypeUnsafe.Ok found-ty found-unsafe)
          (ResultTcTypeUnsafe.Err
            (string.append
              "typecheck: unbound name "
              (tc-env-key-display name-id))))))))

(define (tc-lookup-unsafe-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (if tc-type-env-scoped-runtime-active
    (let
      [index : i64 (tc-type-env-scoped-runtime-lookup-index name-id)]
      [scoped : ResultTcTypeUnsafe
        (if (>= index 0)
          (let
            [slot : TcTypeEnvScopedSlot
              (array-ref
                (struct-get
                  (struct-get
                    (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                    stack)
                  slots)
                index)]
            (begin
              (cfg compile-profile (compiler-tc-env-profile-note-lookup))
              (ResultTcTypeUnsafe.Ok
                (struct-get slot ty)
                (tc-type-env-scoped-flag?
                  (struct-get slot flags)
                  tc-type-env-scoped-flag-unsafe))))
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-tail-fallback))
            (tc-lookup-unsafe-persistent-id
              (struct-get
                (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                persistent)
              name-id)))]
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (if (tc-type-env-scoped-dual-result-unsafe-matches?
            scoped
            env
            name-id)
            unit
            (io.panic
              (string.append
                "typecheck: scoped unsafe lookup diverged for "
                (tc-env-key-display name-id)))))
        scoped))
    (tc-lookup-unsafe-persistent-id env name-id)))

(define (tc-name-bound-before-hygiene-global-boundary-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-name-bound-before-hygiene-global-boundary-id?
          (box-get rest)
          name-id)
        false)]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        false
        (if (= key name-id)
          true
          (tc-name-bound-before-hygiene-global-boundary-id?
            (box-get rest)
            name-id)))]))

(define (tc-unqualified-import-ambiguity-message-for-key
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [_module : String]
  [name : String]
  [name-id : i64]
  [key-id : i64]) : TcMaybeString
  (let
    [first-module : i64
      (sym_i64_env.sym-i64-lookup-id-or
        tc-unqualified-import-ambiguous-first-modules
        key-id
        (compiler-symbols-missing-handle))]
    (if (not (compiler-symbols-handle-found? first-module))
      (TcMaybeString.No)
      (if (tc-name-bound-before-hygiene-global-boundary-id? env name-id)
        (TcMaybeString.No)
        (let
          [second-module : i64
            (sym_i64_env.sym-i64-lookup-id-or
              tc-unqualified-import-ambiguous-second-modules
              key-id
              (compiler-symbols-missing-handle))]
          (if (not (compiler-symbols-handle-found? second-module))
            (TcMaybeString.No)
            (TcMaybeString.Some
              (str_cat.str-cat
                "typecheck: ambiguous unqualified import for value "
                name
                " between modules "
                (intern-str first-module)
                " and "
                (intern-str second-module)
                "; use an explicit alias or qualified access"))))))))

(define (tc-unqualified-import-ambiguity-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeString
  (if (and
    tc-unqualified-import-has-ambiguity
    (not (tc-structural-local-name-id? name-id)))
    (let
      [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
      [name : String (intern-str source-id)]
      [module-id : i64
        (if (macro-hygiene-global-id? name-id)
          (macro-hygiene-global-module-id name-id)
          (tc-context-module-id ctx))]
      (if (tc-name-qualified-id? source-id)
        (TcMaybeString.No)
        (let
          [module : String
            (if (compiler-symbol-root-module-id? module-id)
              ""
              (intern-str module-id))]
          (tc-unqualified-import-ambiguity-message-for-key
            ctx
            env
            module
            name
            source-id
            (tc-unqualified-import-key-id module-id source-id)))))
    (TcMaybeString.No)))

(define (tc-lookup-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (if (tc-env-key-has-name-id? name-id)
    (let
      [env-name-id : i64 (tc-env-name-key-id name-id)]
      [found : ResultTcType
        (match (tc-lookup-id env env-name-id)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (let
              [module : String (tc-context-module ctx)]
              (if (and
                (> (string.string-length module) 0)
                (not (tc-name-qualified-id? name-id)))
                (match (tc-lookup-id
                  env
                  (tc-module-name-id-by-id (tc-context-module-id ctx) name-id))
                  [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                  [(ResultTcType.Err _) (ResultTcType.Err message)])
                (ResultTcType.Err message)))])]
      (match found
        [(ResultTcType.Ok ty)
          (match (tc-unqualified-import-ambiguity-message ctx env name-id)
            [(TcMaybeString.No) (ResultTcType.Ok ty)]
            [(TcMaybeString.Some message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (tc-lookup-id env name-id)))

(define (tc-lookup-hygiene-global-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) (tc-lookup-persistent-id root name-id)]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-lookup-hygiene-global-scan root rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-lookup-persistent-id rest-env name-id)
        (tc-lookup-hygiene-global-scan root rest-env name-id))]))

(define (tc-lookup-hygiene-global-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-hygiene-global-scan env env name-id))

(define (tc-lookup-hygiene-global-visible-id
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match (tc-lookup-hygiene-global-id env (tc-env-name-key-id name-id))
    [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-lookup-dotted-source-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]) : ResultTcType
  (match (tc-source-name-lookup-key-with-field-check-lookup
    ctx
    env
    name
    name-id
    false)
    [(TcNameLookup.Ok lookup-name lookup-id)
      (match (tc-lookup-unsafe-id env (tc-env-name-key-id lookup-id))
        [(ResultTcTypeUnsafe.Ok ty unsafe)
          (if unsafe
            (match (tc-require-unsafe
              env
              (tc-source-lookup-display-name ctx name name-id lookup-name))
              [(ResultTcUnit.Ok) (ResultTcType.Ok ty)]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])
            (ResultTcType.Ok ty))]
        [(ResultTcTypeUnsafe.Err message)
          (match (tc-dotted-alias-variant-handle ctx name name-id)
            [(option_i64.Some handle)
              (tc-variant-constructor-type-for-handle ctx handle)]
            [(option_i64.None)
              (tc-variant-constructor-type-for-lookup-or-id
                ctx
                lookup-name
                lookup-id
                (tc-source-unbound-display-message
                  ctx
                  name
                  name-id
                  lookup-name
                  message))])])]
    [(TcNameLookup.Err message) (ResultTcType.Err message)]))

(define (tc-hygiene-definition-env-id-inner
  [ctx : TcContext]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if tc-hygiene-active-top-env-ready
    (if (or
      (compiler-symbol-root-module-id? module-id)
      (= module-id cbi.compiler-builtin-id-fix-empty))
      (ResultTcEnv.Ok tc-hygiene-active-top-env)
      ;; Build cache entries in the dedicated persistent arena (see
      ;; tc-hygiene-module-env-cache-arena) so the chain stored in the global
      ;; survives the scratch arenas active during per-decl typechecking.
      (let
        [prev-arena : i64 (arena.tl_arena_current)]
        [_switched : unit
          (unsafe
            (arena.tl_arena_set (tc-hygiene-module-env-cache-arena-handle)))]
        (match (tc-module-local-env-cached-id
          ctx
          tc-hygiene-active-top-env
          module
          module-id
          tc-hygiene-module-env-cache)
          [(ResultTcModuleLocalEnv.Ok def-env next-cache)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (set! tc-hygiene-module-env-cache next-cache)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (ResultTcEnv.Ok def-env)))]
          [(ResultTcModuleLocalEnv.Err message)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (ResultTcEnv.Err message)))])))
    (ResultTcEnv.Err "typecheck: macro hygiene definition context unavailable")))

(define (tc-hygiene-definition-env-id
  [ctx : TcContext]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-suspend!)]
    [result : ResultTcEnv
      (tc-hygiene-definition-env-id-inner ctx module module-id)]
    (begin
      (tc-type-env-scoped-runtime-restore! saved)
      result)))

(define (tc-lookup-hygiene-context-global-visible-id-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [def-ctx : TcContext
      (tc-context-with-module-id
        ctx
        module
        (if (compiler-symbol-root-module-id? module-id)
          cbi.compiler-builtin-id-fix-empty
          module-id))]
    (match (tc-hygiene-definition-env-id ctx module module-id)
      [(ResultTcEnv.Ok def-env)
        (if (>= (tc-name-first-dot-id name-id) 0)
          (tc-lookup-dotted-source-visible def-ctx def-env name name-id)
          (let
            [env-name-id : i64 (tc-env-name-key-id name-id)]
            (match (tc-lookup-unsafe-persistent-id def-env env-name-id)
              [(ResultTcTypeUnsafe.Ok ty unsafe)
                (if unsafe
                  (match (tc-require-unsafe env name)
                    [(ResultTcUnit.Ok) (ResultTcType.Ok ty)]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                  (ResultTcType.Ok ty))]
              [(ResultTcTypeUnsafe.Err message) (ResultTcType.Err message)])))]
      [(ResultTcEnv.Err message) (ResultTcType.Err message)])))

(define (tc-lookup-hygiene-context-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [name-id : i64]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-suspend!)]
    [result : ResultTcType
      (tc-lookup-hygiene-context-global-visible-id-inner
        ctx
        env
        module
        module-id
        name-id)]
    (begin
      (tc-type-env-scoped-runtime-restore! saved)
      result)))

(define (tc-hygiene-global-binding-unsafe-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) (tc-binding-unsafe-id? root name-id)]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-hygiene-global-binding-unsafe-scan root rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-binding-unsafe-id? rest-env name-id)
        (tc-hygiene-global-binding-unsafe-scan root rest-env name-id))]))

(define (tc-hygiene-global-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-hygiene-global-binding-unsafe-scan env env name-id))

(define (tc-active-region-scan [env : TcTypeEnv]) : TcMaybeNameId
  (match env
    [(TcTypeEnv.Nil) (TcMaybeNameId.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-region-scan (box-get rest))
        (TcMaybeNameId.No))]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key (tc-region-marker-id))
        (match ty
          [(AstType.Var region) (TcMaybeNameId.Some region)]
          [_ (tc-active-region-scan (box-get rest))])
        (tc-active-region-scan (box-get rest)))]))

(define (tc-active-region [env : TcTypeEnv]) : TcMaybeNameId
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-active-region
      (tc-type-env-scoped-runtime-current))
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (match (tc-env-marker-type env (tc-region-marker-id))
        [(AstMaybeType.Some (AstType.Var region)) (TcMaybeNameId.Some region)]
        [(AstMaybeType.Some _) (tc-active-region-scan env)]
        [(AstMaybeType.No) (TcMaybeNameId.No)]))))

(define (tc-push-region-id [env : TcTypeEnv] [region-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-region-marker-id)
    (AstType.Var region-id)
    TcTypeEnvScopedMarkerKind.Region))

(define (tc-push-region [env : TcTypeEnv] [region : i64]) : TcTypeEnv
  (tc-push-region-id env region))

(define (tc-string-list-contains [items : TcStringList] [name : String]) : bool
  (match items
    [(TcStringList.Nil) false]
    [(TcStringList.Cons item rest)
      (if (string.eq item name)
        true
        (tc-string-list-contains (box-get rest) name))]))

(define (tc-string-list-add [items : TcStringList] [name : String]) : TcStringList
  (if (tc-string-list-contains items name)
    items
    (TcStringList.Cons name (box items))))

(define (tc-string-list-add-all [items : TcStringList] [names : TcStringList]) : TcStringList
  (match names
    [(TcStringList.Nil) items]
    [(TcStringList.Cons name rest)
      (tc-string-list-add-all (tc-string-list-add items name) (box-get rest))]))

(define (tc-name-id-list-contains [items : TcNameIdList] [name : i64]) : bool
  (match items
    [(TcNameIdList.Nil) false]
    [(TcNameIdList.Cons item rest)
      (if (= item name)
        true
        (tc-name-id-list-contains (box-get rest) name))]))

(define (tc-name-id-list-add [items : TcNameIdList] [name : i64]) : TcNameIdList
  (if (tc-name-id-list-contains items name)
    items
    (TcNameIdList.Cons name (box items))))

(define (tc-name-id-list-add-all [items : TcNameIdList] [names : TcNameIdList]) : TcNameIdList
  (match names
    [(TcNameIdList.Nil) items]
    [(TcNameIdList.Cons name rest)
      (tc-name-id-list-add-all (tc-name-id-list-add items name) (box-get rest))]))

(define (tc-name-id-list-overlaps? [a : TcNameIdList] [b : TcNameIdList]) : bool
  (match a
    [(TcNameIdList.Nil) false]
    [(TcNameIdList.Cons item rest)
      (if (tc-name-id-list-contains b item)
        true
        (tc-name-id-list-overlaps? (box-get rest) b))]))

(define (tc-name-id-list-eq [a : TcNameIdList] [b : TcNameIdList]) : bool
  (match a
    [(TcNameIdList.Nil)
      (match b
        [(TcNameIdList.Nil) true]
        [_ false])]
    [(TcNameIdList.Cons item rest)
      (and
        (tc-name-id-list-contains b item)
        (tc-name-id-list-eq (box-get rest) b))]))

(define (tc-name-id-list-all-in?
  [items : TcNameIdList]
  [allowed : TcNameIdList]) : bool
  (match items
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons item rest)
      (and
        (tc-name-id-list-contains allowed item)
        (tc-name-id-list-all-in? (box-get rest) allowed))]))

(define (tc-bind-cleanup-owner [env : TcTypeEnv] [name-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-cleanup-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.CleanupOwner))

(define (tc-bind-ordinary-arena-owner [env : TcTypeEnv] [name-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-ordinary-arena-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner))

(define (tc-bind-atomic-arena-owner [env : TcTypeEnv] [name-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-atomic-arena-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.AtomicArenaOwner))

(define (tc-arena-phase-structural-base) : i64
  (let
    [stride : i64 (intern-capacity)]
    [stride2 : i64 (* stride stride)]
    (+ (+ stride stride2) (* stride2 stride))))

(define (tc-arena-phase-structural-id
  [kind : i64]
  [first-id : i64]
  [second-id : i64]) : i64
  (let
    [stride : i64 (intern-capacity)]
    [stride2 : i64 (* stride stride)]
    (+
      (tc-arena-phase-structural-base)
      (+ (* kind stride2) (+ (* first-id stride) second-id)))))

(define (tc-arena-phase-structural-kind [value : i64]) : i64
  (let
    [stride : i64 (intern-capacity)]
    [stride2 : i64 (* stride stride)]
    (/ (- value (tc-arena-phase-structural-base)) stride2)))

(define (tc-arena-phase-structural-first-id [value : i64]) : i64
  (let
    [stride : i64 (intern-capacity)]
    (% (/ (- value (tc-arena-phase-structural-base)) stride) stride)))

(define (tc-arena-phase-region-id [owner-id : i64] [token-id : i64]) : i64
  (tc-arena-phase-structural-id 0 owner-id token-id))

(define (tc-arena-phase-current-region-marker-id [owner-id : i64]) : i64
  (tc-arena-phase-structural-id 1 owner-id 0))

(define (tc-arena-phase-token-owner-marker-id [token-id : i64]) : i64
  (tc-arena-phase-structural-id 2 token-id 0))

(define (tc-arena-phase-token-region-marker-id [token-id : i64]) : i64
  (tc-arena-phase-structural-id 3 token-id 0))

(define (tc-qualified-name-key-id [module-id : i64] [base-id : i64]) : i64
  (compiler-symbol-module-key-id-by-id module-id base-id))

(define (tc-generated-module-name-id [name : String]) : i64
  (ci.intern-generated-canonical-name name))

(define (tc-generated-name-id [name : String]) : i64
  (tc-generated-module-name-id name))

(define (tc-arena-region-owned-by-id? [owner-id : i64] [region-id : i64]) : bool
  (if (or (< owner-id 0) (< region-id 0))
    false
    (or
      (= owner-id region-id)
      (and
        (>= region-id (tc-arena-phase-structural-base))
        (= (tc-arena-phase-structural-kind region-id) 0)
        (= (tc-arena-phase-structural-first-id region-id) owner-id)))))

(define (tc-bind-arena-phase-token
  [env : TcTypeEnv]
  [token-id : i64]
  [owner-id : i64]) : TcTypeEnv
  (let
    [region-id : i64 (tc-arena-phase-region-id owner-id token-id)]
    (tc-bind-id
      (tc-bind-id
        (tc-bind-id
          env
          (tc-arena-phase-current-region-marker-id owner-id)
          (AstType.Var region-id))
        (tc-arena-phase-token-owner-marker-id token-id)
        (AstType.Var owner-id))
      (tc-arena-phase-token-region-marker-id token-id)
      (AstType.Var region-id))))

(define (tc-arena-phase-token-region-head
  [env : TcTypeEnv]
  [region-marker-id : i64]) : TcMaybeNameId
  (match env
    [(TcTypeEnv.Bind key ty _)
      (if (= key region-marker-id)
        (match ty
          [(AstType.Var region) (TcMaybeNameId.Some region)]
          [_ (TcMaybeNameId.No)])
        (TcMaybeNameId.No))]
    [_ (TcMaybeNameId.No)]))

(define (tc-arena-phase-token-owner-head
  [env : TcTypeEnv]
  [owner-marker-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match env
    [(TcTypeEnv.Bind key ty rest)
      (if (= key owner-marker-id)
        (match ty
          [(AstType.Var owner) (TcMaybeNameId.Some owner)]
          [_ (TcMaybeNameId.No)])
        (if (= key region-marker-id)
          (tc-arena-phase-token-owner-head
            (box-get rest)
            owner-marker-id
            region-marker-id)
          (TcMaybeNameId.No)))]
    [_ (TcMaybeNameId.No)]))

(define (tc-arena-phase-token-region-active-scan
  [env : TcTypeEnv]
  [token-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match env
    [(TcTypeEnv.Nil) (TcMaybeNameId.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-region-active-scan
          (box-get rest)
          token-id
          region-marker-id)
        (TcMaybeNameId.No))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key token-id)
        (tc-arena-phase-token-region-head (box-get rest) region-marker-id)
        (tc-arena-phase-token-region-active-scan
          (box-get rest)
          token-id
          region-marker-id))]))

(define (tc-arena-phase-token-region-active [env : TcTypeEnv] [token-id : i64]) : TcMaybeNameId
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (let
      [region-marker-id : i64 (tc-arena-phase-token-region-marker-id token-id)]
      (match env
        [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
          (tc-arena-phase-token-region-active-scan
            (box-get rest)
            token-id
            region-marker-id)]
        [_
          (tc-arena-phase-token-region-active-scan
            env
            token-id
            region-marker-id)]))))

(define (tc-arena-phase-token-owner-active-scan
  [env : TcTypeEnv]
  [token-id : i64]
  [owner-marker-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match env
    [(TcTypeEnv.Nil) (TcMaybeNameId.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-owner-active-scan
          (box-get rest)
          token-id
          owner-marker-id
          region-marker-id)
        (TcMaybeNameId.No))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key token-id)
        (tc-arena-phase-token-owner-head
          (box-get rest)
          owner-marker-id
          region-marker-id)
        (tc-arena-phase-token-owner-active-scan
          (box-get rest)
          token-id
          owner-marker-id
          region-marker-id))]))

(define (tc-arena-phase-token-owner-active [env : TcTypeEnv] [token-id : i64]) : TcMaybeNameId
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (let
      [owner-marker-id : i64 (tc-arena-phase-token-owner-marker-id token-id)]
      [region-marker-id : i64 (tc-arena-phase-token-region-marker-id token-id)]
      (match env
        [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
          (tc-arena-phase-token-owner-active-scan
            (box-get rest)
            token-id
            owner-marker-id
            region-marker-id)]
        [_
          (tc-arena-phase-token-owner-active-scan
            env
            token-id
            owner-marker-id
            region-marker-id)]))))

(define (tc-current-arena-owner-region [env : TcTypeEnv] [owner : i64]) : i64
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match (tc-env-marker-type
      env
      (tc-arena-phase-current-region-marker-id owner))
      [(AstMaybeType.Some (AstType.Var region)) region]
      [_ owner])))

(define (tc-active-region-owned-by-arena-id? [env : TcTypeEnv] [owner : i64]) : bool
  (match (tc-active-region env)
    [(TcMaybeNameId.Some region) (tc-arena-region-owned-by-id? owner region)]
    [(TcMaybeNameId.No) false]))

(define (tc-cleanup-owner-marker-for?
  [key : i64]
  [ty : AstType]
  [name-id : i64]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstType.Var owner) (= owner name-id)]
      [_ false])
    false))

(define (tc-arena-owner-marker-for?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]
  [name-id : i64]) : bool
  (if (= key marker-id)
    (match ty
      [(AstType.Var owner) (= owner name-id)]
      [_ false])
    false))

(define (tc-cleanup-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstType.Var _) true]
      [_ false])
    false))

(define (tc-arena-owner-marker-entry?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]) : bool
  (if (= key marker-id)
    (match ty
      [(AstType.Var _) true]
      [_ false])
    false))

(define (tc-ordinary-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-ordinary-arena-owner-marker-id) key ty))

(define (tc-atomic-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-atomic-arena-owner-marker-id) key ty))

(define (tc-owner-active-indexed-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]
  [sidecar-flag : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache ids _ _ _ sidecar-flags _ partial _ below)
      (match (tc_i64_i64_map.get (& ids) name-id)
        [(tc_i64_i64_map.LookupFound index)
          (not (= (bit-and (array-ref sidecar-flags index) sidecar-flag) 0))]
        [(tc_i64_i64_map.LookupMissing)
          (if partial
            (tc-owner-active-indexed-id?
              (box-get below)
              name-id
              marker-id
              sidecar-flag)
            false)])]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        (tc-env-cache-owner-marker-head-id? (box-get rest) name-id marker-id)
        (tc-owner-active-indexed-id?
          (box-get rest)
          name-id
          marker-id
          sidecar-flag))]))

(define (tc-cleanup-owner-active-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (tc-owner-active-indexed-id?
    env
    name-id
    (tc-cleanup-owner-marker-id)
    tc-env-cache-flag-cleanup-owner))

(define (tc-cleanup-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-cleanup-owner-active?
      (tc-type-env-scoped-runtime-current)
      name-id)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (tc-cleanup-owner-active-persistent-id? env name-id))))

(define (tc-arena-owner-active-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (tc-owner-active-indexed-id?
    env
    name-id
    marker-id
    (if (= marker-id (tc-ordinary-arena-owner-marker-id))
      tc-env-cache-flag-ordinary-arena-owner
      tc-env-cache-flag-atomic-arena-owner)))

(define (tc-arena-owner-active-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-arena-owner-active?
      (tc-type-env-scoped-runtime-current)
      name-id
      marker-id)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (tc-arena-owner-active-persistent-id? env name-id marker-id))))

(define (tc-ordinary-arena-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-arena-owner-active-id? env name-id (tc-ordinary-arena-owner-marker-id)))

(define (tc-atomic-arena-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-arena-owner-active-id? env name-id (tc-atomic-arena-owner-marker-id)))

(define (tc-active-cleanup-owners-scan [root : TcTypeEnv] [env : TcTypeEnv]) : TcStringList
  (match env
    [(TcTypeEnv.Nil) TcStringList.Nil]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-cleanup-owners-scan root (box-get rest))
        TcStringList.Nil)]
    [(TcTypeEnv.Bind key ty rest)
      (let
        [owners : TcStringList
          (tc-active-cleanup-owners-scan root (box-get rest))]
        (if (= key (tc-cleanup-owner-marker-id))
          (match ty
            [(AstType.Var owner)
              (let
                [owner-str : String (intern-str owner)]
                (if (tc-cleanup-owner-active-id? root owner)
                  (tc-string-list-add owners owner-str)
                  owners))]
            [_ owners])
          owners))]))

(define (tc-active-cleanup-owners [env : TcTypeEnv]) : TcStringList
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-active-cleanup-owners-scan env (box-get rest))]
      [_ (tc-active-cleanup-owners-scan env env)])))

(define (tc-string-list-eq [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringList.Nil)
      (match b
        [(TcStringList.Nil) true]
        [_ false])]
    [(TcStringList.Cons item rest)
      (and
        (tc-string-list-contains b item)
        (tc-string-list-eq (box-get rest) b))]))

(define (tc-string-list-overlaps? [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringList.Nil) false]
    [(TcStringList.Cons item rest)
      (if (tc-string-list-contains b item)
        true
        (tc-string-list-overlaps? (box-get rest) b))]))

(define (tc-string-list-all-in? [items : TcStringList] [allowed : TcStringList]) : bool
  (match items
    [(TcStringList.Nil) true]
    [(TcStringList.Cons item rest)
      (and
        (tc-string-list-contains allowed item)
        (tc-string-list-all-in? (box-get rest) allowed))]))

(define (tc-lifetime-list-count [items : AstLifetimeList]) : i64
  (ast-lifetime-list-len (& items)))

(define (tc-lifetime-list-contains [items : AstLifetimeList] [name : i64]) : bool
  (tc-lifetime-list-contains-at? (& items) name 0))

(define (tc-lifetime-list-contains-at?
  [items : (& items AstLifetimeList)]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (if (= (ast-lifetime-list-get items index (ast-lifetime-fallback)) name)
      true
      (tc-lifetime-list-contains-at? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates? [items : AstLifetimeList]) : bool
  (tc-lifetime-list-duplicates-at? (& items) 0))

(define (tc-lifetime-list-contains-after?
  [items : (& items AstLifetimeList)]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (if (= (ast-lifetime-list-get items index (ast-lifetime-fallback)) name)
      true
      (tc-lifetime-list-contains-after? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates-at?
  [items : (& items AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (let
      [item : i64 (ast-lifetime-list-get items index (ast-lifetime-fallback))]
      (or
        (tc-lifetime-list-contains-after? items item (+ index 1))
        (tc-lifetime-list-duplicates-at? items (+ index 1))))))

(define (tc-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (ast-lifetime-list-eq? a b))

(define (tc-lifetime-list-to-name-id-list-into
  [items : AstLifetimeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-lifetime-list-to-name-id-list-into-at (& items) out 0))

(define (tc-lifetime-list-to-name-id-list-into-at
  [items : (& items AstLifetimeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast-lifetime-list-len items))
    out
    (tc-lifetime-list-to-name-id-list-into-at
      items
      (tc-name-id-list-add
        out
        (ast-lifetime-list-get items index (ast-lifetime-fallback)))
      (+ index 1))))

(define (tc-name-id-list-to-lifetime-list [items : TcNameIdList]) : AstLifetimeList
  (match items
    [(TcNameIdList.Nil) (ast-lifetime-list-new)]
    [(TcNameIdList.Cons item rest)
      (ast-lifetime-cons item (tc-name-id-list-to-lifetime-list (box-get rest)))]))

(define (tc-lifetime-subst-lookup [subst : TcLifetimeSubst] [name : i64]) : TcMaybeNameId
  (match subst
    [(TcLifetimeSubst.Nil) (TcMaybeNameId.No)]
    [(TcLifetimeSubst.Cons from to rest)
      (if (= from name)
        (TcMaybeNameId.Some to)
        (tc-lifetime-subst-lookup (box-get rest) name))]))

(define (tc-lifetime-subst-bind
  [subst : TcLifetimeSubst]
  [from : i64]
  [to : i64]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(TcMaybeNameId.Some existing)
      (if (= existing to)
        (ResultTcLifetimeSubst.Ok subst)
        (ResultTcLifetimeSubst.Err "typecheck: constructor lifetime mismatch"))]
    [(TcMaybeNameId.No)
      (ResultTcLifetimeSubst.Ok (TcLifetimeSubst.Cons from to (box subst)))]))

(define (tc-lifetime-subst-apply [subst : TcLifetimeSubst] [name : i64]) : i64
  (match (tc-lifetime-subst-lookup subst name)
    [(TcMaybeNameId.Some replacement) replacement]
    [(TcMaybeNameId.No) name]))

(define (tc-lifetime-subst-list
  [subst : TcLifetimeSubst]
  [items : AstLifetimeList]) : AstLifetimeList
  (tc-lifetime-subst-list-at subst (& items) 0))

(define (tc-lifetime-subst-list-at
  [subst : TcLifetimeSubst]
  [items : (& items AstLifetimeList)]
  [index : i64]) : AstLifetimeList
  (if (>= index (ast-lifetime-list-len items))
    (ast-lifetime-list-new)
    (ast-lifetime-cons
      (tc-lifetime-subst-apply
        subst
        (ast-lifetime-list-get items index (ast-lifetime-fallback)))
      (tc-lifetime-subst-list-at subst items (+ index 1)))))

;; V1 lifetime names are owner names. Normal environment bindings own stack
;; slots, and the synthetic region marker owns a with-arena scope. Environment
;; order is the lexical outlives relation: older owners appear farther down the
;; list and outlive nested stack bindings or scoped arenas. The default program
;; arena is inferred for untagged aggregate handles, so it has no lexical
;; binder in this environment walk.
(define (tc-env-binding-matches-lifetime-id?
  [key : i64]
  [ty : AstType]
  [lifetime-id : i64]) : bool
  (cond
    [(= key lifetime-id) true]
    [(= key (tc-region-marker-id))
      (match ty
        [(AstType.Var region) (and (>= lifetime-id 0) (= region lifetime-id))]
        [_ false])]
    [(or
        (= key (tc-ordinary-arena-owner-marker-id))
        (= key (tc-atomic-arena-owner-marker-id)))
      (match ty
        [(AstType.Var owner) (tc-arena-region-owned-by-id? owner lifetime-id)]
        [_ false])]
    [else false]))

(define (tc-env-cache-covered-count [sidecar-flags : (Array i64)]) : i64
  (array-ref sidecar-flags (- (array-length sidecar-flags) 1)))

;; Return the head-first lexical rank of an ordinary binding, or -1.  Local
;; cache layers store the original spine position in the packed sidecar, so a
;; miss can jump over the covered window while preserving the exact ordering
;; used by lifetime outlives checks.  Marker-owned lifetime spellings still use
;; the established scan below.
(define (tc-ordinary-binding-rank-id-from
  [env : TcTypeEnv]
  [name-id : i64]
  [base : i64]) : i64
  (match env
    [(TcTypeEnv.Nil) -1]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        base
        (tc-ordinary-binding-rank-id-from (box-get rest) name-id (+ base 1)))]
    [(TcTypeEnv.Cache ids _ _ _ sidecar-flags scan-through partial _ below)
      (if scan-through
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(tc_i64_i64_map.LookupFound index)
            (+
              base
              (/
                (array-ref sidecar-flags index)
                tc-env-cache-sidecar-position-scale))]
          [(tc_i64_i64_map.LookupMissing)
            (if partial
              (tc-ordinary-binding-rank-id-from
                (box-get below)
                name-id
                (+ base (tc-env-cache-covered-count sidecar-flags)))
              -1)])
        -1)]))

(define (tc-lifetime-visible-scan-id? [env : TcTypeEnv] [lifetime-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-visible-scan-id? (box-get rest) lifetime-id)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (tc-env-binding-matches-lifetime-id? key ty lifetime-id)
        true
        (tc-lifetime-visible-scan-id? (box-get rest) lifetime-id))]))

(define (tc-lifetime-visible-persistent-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]) : bool
  (if (< lifetime-id 0)
    false
    (or
      (>= (tc-ordinary-binding-rank-id-from env lifetime-id 0) 0)
      (match env
        [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
          (tc-lifetime-visible-scan-id? (box-get rest) lifetime-id)]
        [_ (tc-lifetime-visible-scan-id? env lifetime-id)]))))

(define (tc-lifetime-visible-id? [env : TcTypeEnv] [lifetime-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-lifetime-visible-id?
      (tc-type-env-scoped-runtime-current)
      lifetime-id)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (tc-lifetime-visible-persistent-id? env lifetime-id))))

(define (tc-reference-lifetimes-visible?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]) : bool
  (match lifetimes
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons lifetime rest)
      (and
        (tc-lifetime-visible-id? env lifetime)
        (tc-reference-lifetimes-visible? env (box-get rest)))]))

(define (tc-lifetime-outlives-binding-scan-inner-id
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-outlives-binding-scan-inner-id
          (box-get rest)
          lifetime-id
          target-id
          seen-target)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (tc-env-binding-matches-lifetime-id? key ty lifetime-id)
        seen-target
        (tc-lifetime-outlives-binding-scan-inner-id
          (box-get rest)
          lifetime-id
          target-id
          (or seen-target (= key target-id))))]))

(define (tc-lifetime-outlives-binding-scan-id
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-binding-scan-inner-id
        (box-get rest)
        lifetime-id
        target-id
        seen-target)]
    [_
      (tc-lifetime-outlives-binding-scan-inner-id
        env
        lifetime-id
        target-id
        seen-target)]))

(define (tc-lifetime-outlives-binding-persistent-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (if (or (< lifetime-id 0) (< target-id 0))
    false
    (let
      [lifetime-rank : i64 (tc-ordinary-binding-rank-id-from env lifetime-id 0)]
      [target-rank : i64 (tc-ordinary-binding-rank-id-from env target-id 0)]
      (if (and (>= lifetime-rank 0) (>= target-rank 0))
        (> lifetime-rank target-rank)
        (tc-lifetime-outlives-binding-scan-id env lifetime-id target-id false)))))

(define (tc-lifetime-outlives-binding-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
      (tc-type-env-scoped-runtime-current)
      lifetime-id
      target-id)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (tc-lifetime-outlives-binding-persistent-id? env lifetime-id target-id))))

(define (tc-reference-lifetimes-outlive-binding-id?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-id : i64]) : bool
  (match lifetimes
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons lifetime rest)
      (and
        (tc-lifetime-outlives-binding-id? env lifetime target-id)
        (tc-reference-lifetimes-outlive-binding-id?
          env
          (box-get rest)
          target-id))]))

(define (tc-lifetime-outlives-lifetime-scan-inner-id
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]
  [seen-target : bool]) : bool
  (if (and (>= value-lifetime-id 0) (= value-lifetime-id target-lifetime-id))
    true
    (match env
      [(TcTypeEnv.Nil) false]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-lifetime-outlives-lifetime-scan-inner-id
            (box-get rest)
            value-lifetime-id
            target-lifetime-id
            seen-target)
          false)]
      [(TcTypeEnv.Bind key ty rest)
        (if (tc-env-binding-matches-lifetime-id? key ty value-lifetime-id)
          seen-target
          (tc-lifetime-outlives-lifetime-scan-inner-id
            (box-get rest)
            value-lifetime-id
            target-lifetime-id
            (or
              seen-target
              (tc-env-binding-matches-lifetime-id? key ty target-lifetime-id))))])))

(define (tc-lifetime-outlives-lifetime-scan-id
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-lifetime-scan-inner-id
        (box-get rest)
        value-lifetime-id
        target-lifetime-id
        seen-target)]
    [_
      (tc-lifetime-outlives-lifetime-scan-inner-id
        env
        value-lifetime-id
        target-lifetime-id
        seen-target)]))

(define (tc-lifetime-outlives-lifetime-persistent-id?
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (or (< value-lifetime-id 0) (< target-lifetime-id 0))
    false
    (if (= value-lifetime-id target-lifetime-id)
      true
      (let
        [value-rank : i64
          (tc-ordinary-binding-rank-id-from env value-lifetime-id 0)]
        [target-rank : i64
          (tc-ordinary-binding-rank-id-from env target-lifetime-id 0)]
        (if (and (>= value-rank 0) (>= target-rank 0))
          (> value-rank target-rank)
          (tc-lifetime-outlives-lifetime-scan-id
            env
            value-lifetime-id
            target-lifetime-id
            false))))))

(define (tc-lifetime-outlives-lifetime-id?
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (= value-lifetime-id target-lifetime-id)
    true
    (if tc-type-env-scoped-runtime-active
      (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
        (tc-type-env-scoped-runtime-current)
        value-lifetime-id
        target-lifetime-id)
      (begin
        (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
        (tc-lifetime-outlives-lifetime-persistent-id?
          env
          value-lifetime-id
          target-lifetime-id)))))

(define (tc-reference-lifetimes-outlive-lifetime-id?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-lifetime-id : i64]) : bool
  (match lifetimes
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons lifetime rest)
      (and
        (tc-lifetime-outlives-lifetime-id? env lifetime target-lifetime-id)
        (tc-reference-lifetimes-outlive-lifetime-id?
          env
          (box-get rest)
          target-lifetime-id))]))

(define (tc-reference-lifetimes-outlive-lifetime?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-lifetime : i64]) : bool
  (tc-reference-lifetimes-outlive-lifetime-id? env lifetimes target-lifetime))

(define (tc-ensure-reference-value-can-bind
  [env : TcTypeEnv]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList (tc-type-collect-regions value-ty)]
    (if (tc-reference-lifetimes-visible? env lifetimes)
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: reference value would escape lexical scope"))))

(define (tc-ensure-reference-value-can-assign
  [env : TcTypeEnv]
  [target-id : i64]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList (tc-type-collect-reference-lifetimes value-ty)]
    (if (tc-reference-lifetimes-outlive-binding-id? env lifetimes target-id)
      ResultTcUnit.Ok
      (ResultTcUnit.Err
        "typecheck: cannot store reference into longer-lived binding; reference value would escape lexical scope"))))

(define (tc-ensure-reference-type-does-not-escape-names
  [ty : AstType]
  [names : TcNameIdList]) : ResultTcUnit
  (if (tc-name-id-list-overlaps? (tc-type-collect-regions ty) names)
    (ResultTcUnit.Err "typecheck: reference value would escape lexical scope")
    ResultTcUnit.Ok))

(define (tc-type-strip-region [ty : AstType]) : AstType
  (match ty
    [(AstType.Region _ inner) (tc-type-strip-region (ty-node-get inner))]
    [_ ty]))

(define (tc-type-list-contains-region-tag? [types : AstTypeList]) : bool
  (tc-type-list-contains-region-tag-at? (& types) 0))

(define (tc-type-list-contains-region-tag-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (if (tc-type-contains-region-tag?
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      true
      (tc-type-list-contains-region-tag-at? types (+ index 1)))))

(define (tc-type-contains-region-tag? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (if (tc-type-list-contains-region-tag? (box-get args))
        true
        (tc-type-contains-region-tag? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-region-tag? (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Ref _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstType.MutRef _ inner)
      (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstType.Region _ _) true]
    [_ false]))

(define (tc-type-list-without-regions [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-contains-region-tag? types)
    (tc-type-list-without-regions-at (& types) 0)
    types))

(define (tc-type-list-without-regions-at
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-type-without-regions
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-without-regions-at types (+ index 1)))))

(define (tc-type-without-regions [ty : AstType]) : AstType
  (if (tc-type-contains-region-tag? ty)
    (match ty
      [(AstType.Func args ret)
        (ast-ty-func
          (tc-type-list-without-regions (box-get args))
          (tc-type-without-regions (ty-node-get ret)))]
      [(AstType.Tuple elems)
        (ast-ty-tuple (tc-type-list-without-regions (box-get elems)))]
      [(AstType.Array elem len)
        (ast-ty-array (tc-type-without-regions (ty-node-get elem)) len)]
      [(AstType.DynArray elem)
        (ast-ty-dyn-array (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Box elem)
        (ast-ty-box (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Ptr elem)
        (ast-ty-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.MutPtr elem)
        (ast-ty-mut-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Ref region inner)
        (ast-ty-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstType.MutRef region inner)
        (ast-ty-mut-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstType.Region _ inner) (tc-type-without-regions (ty-node-get inner))]
      [(AstType.EnumArgs name lifetimes)
        (ast-ty-enum-args name (box-get lifetimes))]
      [(AstType.StructArgs name lifetimes)
        (ast-ty-struct-args name (box-get lifetimes))]
      [(AstType.VarArgs name lifetimes)
        (ast-ty-var-args name (box-get lifetimes))]
      [_ ty])
    ty))

(define (tc-type-list-contains-region [types : AstTypeList] [region : i64]) : bool
  (tc-type-list-contains-region-at? (& types) region 0))

(define (tc-type-list-contains-region-at?
  [types : (& types AstTypeList)]
  [region : i64]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-region
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        region)
      (tc-type-list-contains-region-at? types region (+ index 1)))))

(define (tc-type-contains-region [ty : AstType] [region : i64]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-region (box-get args) region)
        (tc-type-contains-region (ty-node-get ret) region))]
    [(AstType.Tuple elems)
      (tc-type-list-contains-region (box-get elems) region)]
    [(AstType.Array elem _) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.DynArray elem)
      (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Box elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Ptr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.MutPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Ref name inner)
      (or (= name region) (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.MutRef name inner)
      (or (= name region) (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.Region name inner)
      (or (= name region) (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [_ false]))

(define (tc-type-list-contains-any-region [types : AstTypeList]) : bool
  (tc-type-list-contains-any-region-at? (& types) 0))

(define (tc-type-list-contains-any-region-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-any-region
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-any-region-at? types (+ index 1)))))

(define (tc-type-contains-any-region [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-any-region (box-get args))
        (tc-type-contains-any-region (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-any-region (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ _) true]
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.VarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-list-contains-reference? [types : AstTypeList]) : bool
  (tc-type-list-contains-reference-at? (& types) 0))

(define (tc-type-list-contains-reference-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-reference?
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-reference-at? types (+ index 1)))))

(define (tc-type-list-contains-mut-reference? [types : AstTypeList]) : bool
  (tc-type-list-contains-mut-reference-at? (& types) 0))

(define (tc-type-list-contains-mut-reference-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-mut-reference?
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-mut-reference-at? types (+ index 1)))))

(define (tc-type-contains-reference? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-reference? (box-get args))
        (tc-type-contains-reference? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-reference? (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ inner) (tc-type-contains-reference? (ty-node-get inner))]
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.VarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-contains-mut-reference? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-mut-reference? (box-get args))
        (tc-type-contains-mut-reference? (ty-node-get ret)))]
    [(AstType.Tuple elems)
      (tc-type-list-contains-mut-reference? (box-get elems))]
    [(AstType.Array elem _)
      (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.DynArray elem)
      (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Ref _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [_ false]))

;; An empty reference lifetime is the parser's marker for source-level
;; `(& T)` / `(&mut T)`. It never survives signature normalization. The
;; generated spelling cannot be written by source code, so it cannot collide
;; with an explicit lifetime name.
(defstruct TcElidedType
  (ty AstType)
  (next-index i64))

(defstruct TcElidedTypes
  (types AstTypeList)
  (next-index i64))

(defstruct TcElidedParams
  (params AstParamList)
  (next-index i64))

(defstruct TcElidedSignature
  (params AstParamList)
  (ret AstType))

(defenum ResultTcElidedType
  (Ok TcElidedType)
  (Err String))

(defenum ResultTcElidedTypes
  (Ok TcElidedTypes)
  (Err String))

(defenum ResultTcElidedParams
  (Ok TcElidedParams)
  (Err String))

(defenum ResultTcElidedSignature
  (Ok TcElidedSignature)
  (Err String))

(define (tc-elided-lifetime-name [index : i64]) : i64
  (let
    [name : String
      (string.append
        (tc-elided-lifetime-name-prefix)
        (string.int->string index))]
    (tc-generated-name-id name)))

(define (tc-elided-lifetime? [name : i64]) : bool
  (= name cbi.compiler-builtin-id-fix-empty))

(test
  tc-type-render-hides-elaborated-lifetimes
  (let
    [hidden : i64 (tc-elided-lifetime-name 0)]
    [named : i64 (intern "named")]
    (if (and
      (string.eq (tc-type-render (ast-ty-ref hidden (AstType.I64))) "(& i64)")
      (string.eq
        (tc-type-render (ast-ty-mut-ref hidden (AstType.I64)))
        "(&mut i64)")
      (string.eq
        (tc-type-render (ast-ty-ref named (AstType.I64)))
        "(& named i64)"))
      unit
      (io.panic "typecheck: elaborated lifetime leaked through type rendering"))))

(define (tc-signature-input-lifetimes-into [ty : AstType] [out : TcNameIdList]) : TcNameIdList
  ;; A nested function type owns a separate signature scope. Its lifetimes are
  ;; intentionally not candidates for the enclosing function's elided return.
  (match ty
    [(AstType.Func _ _) out]
    [(AstType.Tuple elems)
      (tc-signature-input-type-list-lifetimes-into (box-get elems) out)]
    [(AstType.Array elem _)
      (tc-signature-input-lifetimes-into (ty-node-get elem) out)]
    [(AstType.DynArray elem)
      (tc-signature-input-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Box elem)
      (tc-signature-input-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Ptr elem)
      (tc-signature-input-lifetimes-into (ty-node-get elem) out)]
    [(AstType.MutPtr elem)
      (tc-signature-input-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Region _ inner)
      (tc-signature-input-lifetimes-into (ty-node-get inner) out)]
    [(AstType.Ref lifetime inner)
      (tc-signature-input-lifetimes-into
        (ty-node-get inner)
        (tc-name-id-list-add out lifetime))]
    [(AstType.MutRef lifetime inner)
      (tc-signature-input-lifetimes-into
        (ty-node-get inner)
        (tc-name-id-list-add out lifetime))]
    [_ out]))

(define (tc-signature-input-type-list-lifetimes-into
  [types : AstTypeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-signature-input-type-list-lifetimes-at (& types) 0 out))

(define (tc-signature-input-type-list-lifetimes-at
  [types : (& types AstTypeList)]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast-type-list-len types))
    out
    (tc-signature-input-type-list-lifetimes-at
      types
      (+ index 1)
      (tc-signature-input-lifetimes-into
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        out))))

(define (tc-signature-single-input-lifetime [types : AstTypeList]) : TcMaybeNameId
  (match (tc-signature-input-type-list-lifetimes-into types TcNameIdList.Nil)
    [(TcNameIdList.Nil) (TcMaybeNameId.No)]
    [(TcNameIdList.Cons lifetime rest)
      (match (box-get rest)
        [(TcNameIdList.Nil) (TcMaybeNameId.Some lifetime)]
        [_ (TcMaybeNameId.No)])]))

(define (tc-elide-input-type-list [types : AstTypeList] [index : i64]) : ResultTcElidedTypes
  (tc-elide-input-type-list-at (& types) 0 index (ast-type-list-new)))

(define (tc-elide-input-type-list-at
  [types : (& types AstTypeList)]
  [offset : i64]
  [index : i64]
  [out : AstTypeList]) : ResultTcElidedTypes
  (if (>= offset (ast-type-list-len types))
    (ResultTcElidedTypes.Ok (TcElidedTypes out index))
    (match (tc-elide-input-type
      (ty-node-get (ast-type-list-get types offset (ast-type-id-fallback)))
      index)
      [(ResultTcElidedType.Ok item)
        (let
          [next-out : AstTypeList out]
          (begin
            (ast-type-list-push
              (&mut next-out)
              (ty-node-push (struct-get item ty)))
            (tc-elide-input-type-list-at
              types
              (+ offset 1)
              (struct-get item next-index)
              next-out)))]
      [(ResultTcElidedType.Err message) (ResultTcElidedTypes.Err message)])))

(define (tc-elide-output-type-list
  [types : AstTypeList]
  [lifetime : TcMaybeNameId]) : ResultTcElidedTypes
  (tc-elide-output-type-list-at (& types) 0 lifetime (ast-type-list-new)))

(define (tc-elide-output-type-list-at
  [types : (& types AstTypeList)]
  [index : i64]
  [lifetime : TcMaybeNameId]
  [out : AstTypeList]) : ResultTcElidedTypes
  (if (>= index (ast-type-list-len types))
    (ResultTcElidedTypes.Ok (TcElidedTypes out 0))
    (match (tc-elide-output-type
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
      lifetime)
      [(ResultTcElidedType.Ok item)
        (let
          [next-out : AstTypeList out]
          (begin
            (ast-type-list-push
              (&mut next-out)
              (ty-node-push (struct-get item ty)))
            (tc-elide-output-type-list-at types (+ index 1) lifetime next-out)))]
      [(ResultTcElidedType.Err message) (ResultTcElidedTypes.Err message)])))

(define (tc-elide-function-type [args : AstTypeList] [ret : AstType]) : ResultTcElidedType
  (match (tc-elide-input-type-list args 0)
    [(ResultTcElidedTypes.Ok inputs)
      (let
        [input-types : AstTypeList (struct-get inputs types)]
        [lifetime : TcMaybeNameId
          (tc-signature-single-input-lifetime input-types)]
        (match (tc-elide-output-type ret lifetime)
          [(ResultTcElidedType.Ok output)
            (ResultTcElidedType.Ok
              (TcElidedType
                (ast-ty-func input-types (struct-get output ty))
                (struct-get inputs next-index)))]
          [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)]))]
    [(ResultTcElidedTypes.Err message) (ResultTcElidedType.Err message)]))

(define (tc-elide-input-type [ty : AstType] [index : i64]) : ResultTcElidedType
  (match ty
    [(AstType.Func args ret)
      (tc-elide-function-type (box-get args) (ty-node-get ret))]
    [(AstType.Tuple elems)
      (match (tc-elide-input-type-list (box-get elems) index)
        [(ResultTcElidedTypes.Ok items)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-tuple (struct-get items types))
              (struct-get items next-index)))]
        [(ResultTcElidedTypes.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Array elem count)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-array (struct-get inner ty) count)
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.DynArray elem)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-dyn-array (struct-get inner ty))
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Box elem)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-box (struct-get inner ty))
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Ptr elem)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-ptr (struct-get inner ty))
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.MutPtr elem)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-mut-ptr (struct-get inner ty))
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Region region elem)
      (match (tc-elide-input-type (ty-node-get elem) index)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType
              (ast-ty-region region (struct-get inner ty))
              (struct-get inner next-index)))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Ref lifetime elem)
      (let
        [next-lifetime : i64
          (if (tc-elided-lifetime? lifetime)
            (tc-elided-lifetime-name index)
            lifetime)]
        [next-index : i64
          (if (tc-elided-lifetime? lifetime)
            (+ index 1)
            index)]
        (match (tc-elide-input-type (ty-node-get elem) next-index)
          [(ResultTcElidedType.Ok inner)
            (ResultTcElidedType.Ok
              (TcElidedType
                (ast-ty-ref next-lifetime (struct-get inner ty))
                (struct-get inner next-index)))]
          [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)]))]
    [(AstType.MutRef lifetime elem)
      (let
        [next-lifetime : i64
          (if (tc-elided-lifetime? lifetime)
            (tc-elided-lifetime-name index)
            lifetime)]
        [next-index : i64
          (if (tc-elided-lifetime? lifetime)
            (+ index 1)
            index)]
        (match (tc-elide-input-type (ty-node-get elem) next-index)
          [(ResultTcElidedType.Ok inner)
            (ResultTcElidedType.Ok
              (TcElidedType
                (ast-ty-mut-ref next-lifetime (struct-get inner ty))
                (struct-get inner next-index)))]
          [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)]))]
    [_ (ResultTcElidedType.Ok (TcElidedType ty index))]))

(define (tc-elide-output-type [ty : AstType] [lifetime : TcMaybeNameId]) : ResultTcElidedType
  (match ty
    [(AstType.Func args ret)
      (tc-elide-function-type (box-get args) (ty-node-get ret))]
    [(AstType.Tuple elems)
      (match (tc-elide-output-type-list (box-get elems) lifetime)
        [(ResultTcElidedTypes.Ok items)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-tuple (struct-get items types)) 0))]
        [(ResultTcElidedTypes.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Array elem count)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-array (struct-get inner ty) count) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.DynArray elem)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-dyn-array (struct-get inner ty)) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Box elem)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-box (struct-get inner ty)) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Ptr elem)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-ptr (struct-get inner ty)) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.MutPtr elem)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-mut-ptr (struct-get inner ty)) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Region region elem)
      (match (tc-elide-output-type (ty-node-get elem) lifetime)
        [(ResultTcElidedType.Ok inner)
          (ResultTcElidedType.Ok
            (TcElidedType (ast-ty-region region (struct-get inner ty)) 0))]
        [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])]
    [(AstType.Ref name elem)
      (match lifetime
        [(TcMaybeNameId.No)
          (if (tc-elided-lifetime? name)
            (ResultTcElidedType.Err
              "typecheck: elided reference return is ambiguous; write an explicit lifetime")
            (match (tc-elide-output-type (ty-node-get elem) lifetime)
              [(ResultTcElidedType.Ok inner)
                (ResultTcElidedType.Ok
                  (TcElidedType (ast-ty-ref name (struct-get inner ty)) 0))]
              [(ResultTcElidedType.Err message)
                (ResultTcElidedType.Err message)]))]
        [(TcMaybeNameId.Some source)
          (match (tc-elide-output-type (ty-node-get elem) lifetime)
            [(ResultTcElidedType.Ok inner)
              (ResultTcElidedType.Ok
                (TcElidedType
                  (ast-ty-ref
                    (if (tc-elided-lifetime? name)
                      source
                      name)
                    (struct-get inner ty))
                  0))]
            [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])])]
    [(AstType.MutRef name elem)
      (match lifetime
        [(TcMaybeNameId.No)
          (if (tc-elided-lifetime? name)
            (ResultTcElidedType.Err
              "typecheck: elided reference return is ambiguous; write an explicit lifetime")
            (match (tc-elide-output-type (ty-node-get elem) lifetime)
              [(ResultTcElidedType.Ok inner)
                (ResultTcElidedType.Ok
                  (TcElidedType (ast-ty-mut-ref name (struct-get inner ty)) 0))]
              [(ResultTcElidedType.Err message)
                (ResultTcElidedType.Err message)]))]
        [(TcMaybeNameId.Some source)
          (match (tc-elide-output-type (ty-node-get elem) lifetime)
            [(ResultTcElidedType.Ok inner)
              (ResultTcElidedType.Ok
                (TcElidedType
                  (ast-ty-mut-ref
                    (if (tc-elided-lifetime? name)
                      source
                      name)
                    (struct-get inner ty))
                  0))]
            [(ResultTcElidedType.Err message) (ResultTcElidedType.Err message)])])]
    [_ (ResultTcElidedType.Ok (TcElidedType ty 0))]))

(define (tc-elide-input-params-at
  [params : (& params AstParamList)]
  [offset : i64]
  [index : i64]
  [out : AstParamList]) : ResultTcElidedParams
  (if (>= offset (ast-param-list-len params))
    (ResultTcElidedParams.Ok (TcElidedParams out index))
    (match (ast-param-list-get params offset (ast-param-fallback))
      [(AstParam.Param name ty is-comptime consume?)
        (match (tc-elide-input-type ty index)
          [(ResultTcElidedType.Ok item)
            (let
              [next-out : AstParamList out]
              (begin
                (ast-param-list-push
                  (&mut next-out)
                  (ast-param-id-with-consume
                    name
                    (struct-get item ty)
                    is-comptime
                    consume?))
                (tc-elide-input-params-at
                  params
                  (+ offset 1)
                  (struct-get item next-index)
                  next-out)))]
          [(ResultTcElidedType.Err message) (ResultTcElidedParams.Err message)])])))

(define (tc-elided-param-type-list [params : AstParamList]) : AstTypeList
  (tc-elided-param-type-list-at (& params) 0))

(define (tc-elided-param-type-list-at
  [params : (& params AstParamList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-param-list-len params))
    (ast-type-list-new)
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ consume?)
        (ast-type-cons
          (if consume?
            (ast-ty-consume ty)
            ty)
          (tc-elided-param-type-list-at params (+ index 1)))])))

(define (tc-elide-function-signature [params : AstParamList] [ret : AstType]) : ResultTcElidedSignature
  (match (tc-elide-input-params-at (& params) 0 0 (ast-param-list-new))
    [(ResultTcElidedParams.Ok inputs)
      (let
        [input-params : AstParamList (struct-get inputs params)]
        [input-types : AstTypeList (tc-elided-param-type-list input-params)]
        [lifetime : TcMaybeNameId
          (tc-signature-single-input-lifetime input-types)]
        (match (tc-elide-output-type ret lifetime)
          [(ResultTcElidedType.Ok output)
            (ResultTcElidedSignature.Ok
              (TcElidedSignature input-params (struct-get output ty)))]
          [(ResultTcElidedType.Err message)
            (ResultTcElidedSignature.Err message)]))]
    [(ResultTcElidedParams.Err message) (ResultTcElidedSignature.Err message)]))

(define (tc-type-list-collect-reference-lifetimes
  [types : AstTypeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-type-list-collect-reference-lifetimes-at (& types) out 0))

(define (tc-type-list-collect-reference-lifetimes-at
  [types : (& types AstTypeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast-type-list-len types))
    out
    (tc-type-list-collect-reference-lifetimes-at
      types
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-reference-lifetimes-into
  [ty : AstType]
  [out : TcNameIdList]) : TcNameIdList
  (match ty
    [(AstType.Func args ret)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get ret)
        (tc-type-list-collect-reference-lifetimes (box-get args) out))]
    [(AstType.Tuple elems)
      (tc-type-list-collect-reference-lifetimes (box-get elems) out)]
    [(AstType.Array elem _)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.DynArray elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Box elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Ptr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.MutPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Ref lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-name-id-list-add out lifetime))]
    [(AstType.MutRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-name-id-list-add out lifetime))]
    [(AstType.Region _ inner)
      (tc-type-collect-reference-lifetimes-into (ty-node-get inner) out)]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [(AstType.Consume inner)
      (tc-type-collect-reference-lifetimes-into (ty-node-get inner) out)]
    [_ out]))

(define (tc-type-collect-reference-lifetimes [ty : AstType]) : TcNameIdList
  (tc-type-collect-reference-lifetimes-into ty TcNameIdList.Nil))

(define (tc-maybe-type-contains-reference? [maybe-ty : AstMaybeType]) : bool
  (match maybe-ty
    [(AstMaybeType.No) false]
    [(AstMaybeType.Some ty) (tc-type-contains-reference? ty)]))

(define (tc-param-list-reference-return-lifetimes-into
  [ctx : TcContext]
  [params : AstParamList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-param-list-reference-return-lifetimes-at ctx (& params) 0 out))

(define (tc-param-list-reference-return-lifetimes-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast-param-list-len params))
    out
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty _ _)
        (tc-param-list-reference-return-lifetimes-at
          ctx
          params
          (+ index 1)
          (tc-type-collect-reference-lifetimes-into
            (tc-resolve-type ctx ty)
            (tc-name-id-list-add out name)))])))

(define (tc-reference-return-lifetimes-allowed?
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : bool
  (tc-name-id-list-all-in?
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))
    (tc-param-list-reference-return-lifetimes-into ctx params TcNameIdList.Nil)))

(define (tc-reference-return-policy-ok
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : ResultTcUnit
  (if (tc-type-contains-reference? (tc-resolve-type ctx ret))
    (if (tc-reference-return-lifetimes-allowed? ctx params ret)
      ResultTcUnit.Ok
      (ResultTcUnit.Err
        "typecheck: returned reference lifetime must be tied to a parameter"))
    ResultTcUnit.Ok))

(define (tc-type-list-collect-regions
  [types : AstTypeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-type-list-collect-regions-at (& types) out 0))

(define (tc-type-list-collect-regions-at
  [types : (& types AstTypeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast-type-list-len types))
    out
    (tc-type-list-collect-regions-at
      types
      (tc-type-collect-regions-into
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-regions-into [ty : AstType] [out : TcNameIdList]) : TcNameIdList
  (match ty
    [(AstType.Func args ret)
      (tc-type-collect-regions-into
        (ty-node-get ret)
        (tc-type-list-collect-regions (box-get args) out))]
    [(AstType.Tuple elems) (tc-type-list-collect-regions (box-get elems) out)]
    [(AstType.Array elem _)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.DynArray elem)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Box elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Ptr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.MutPtr elem)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Ref name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-name-id-list-add out name))]
    [(AstType.MutRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-name-id-list-add out name))]
    [(AstType.Region name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-name-id-list-add out name))]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-regions [ty : AstType]) : TcNameIdList
  (tc-type-collect-regions-into ty TcNameIdList.Nil))

(define (tc-region-list-contains-arena-owner?
  [regions : TcNameIdList]
  [owner : i64]) : bool
  (match regions
    [(TcNameIdList.Nil) false]
    [(TcNameIdList.Cons region rest)
      (or
        (tc-arena-region-owned-by-id? owner region)
        (tc-region-list-contains-arena-owner? (box-get rest) owner))]))

(define (tc-type-contains-arena-owner-region? [ty : AstType] [owner : i64]) : bool
  (tc-region-list-contains-arena-owner? (tc-type-collect-regions ty) owner))

(define (tc-region-list-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [regions : TcNameIdList]) : bool
  (match regions
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons region rest)
      (and
        (tc-atomic-arena-owner-active-id? env region)
        (tc-region-list-all-atomic-arena-owners? env (box-get rest)))]))

(define (tc-type-regions-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [ty : AstType]) : bool
  (tc-region-list-all-atomic-arena-owners? env (tc-type-collect-regions ty)))

(define (tc-type-outer-region [ty : AstType]) : TcMaybeNameId
  (match ty
    [(AstType.Region region _) (TcMaybeNameId.Some region)]
    [_ (TcMaybeNameId.No)]))

(define (tc-type-outer-regions [ty : AstType]) : TcNameIdList
  (match ty
    [(AstType.Region region inner)
      (tc-name-id-list-add (tc-type-outer-regions (ty-node-get inner)) region)]
    [_ TcNameIdList.Nil]))

(define (tc-region-taggable-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [(AstType.Box _) true]
    [(AstType.Tuple _) true]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (tc-tag-region [region : i64] [ty : AstType]) : AstType
  (if (tc-region-taggable-type? ty)
    (ast-ty-region region ty)
    ty))

(define (tc-tag-active-region [env : TcTypeEnv] [ty : AstType]) : AstType
  (match (tc-active-region env)
    [(TcMaybeNameId.Some region) (tc-tag-region region ty)]
    [(TcMaybeNameId.No) ty]))

;; Nominal aggregate types have no lifetime-argument surface yet. Until they do,
;; constructor results carry stored-reference lifetimes as local region facts so
;; existing flow/escape checks can reject boundary escapes.
(define (tc-tag-reference-lifetimes [lifetimes : TcNameIdList] [ty : AstType]) : AstType
  (match lifetimes
    [(TcNameIdList.Nil) ty]
    [(TcNameIdList.Cons lifetime rest)
      (tc-tag-region lifetime (tc-tag-reference-lifetimes (box-get rest) ty))]))

(define (tc-constructor-target-type
  [env : TcTypeEnv]
  [params : AstTypeList]
  [ret : AstType]) : AstType
  (tc-tag-active-region
    env
    (tc-tag-reference-lifetimes
      (tc-type-list-collect-reference-lifetimes params TcNameIdList.Nil)
      ret)))

(define (tc-project-from-region-container
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (match (tc-type-outer-region container-ty)
    [(TcMaybeNameId.Some region) (tc-tag-region region projected-ty)]
    [(TcMaybeNameId.No)
      (match (tc-type-strip-region container-ty)
        [(AstType.Ref region _) (tc-tag-region region projected-ty)]
        [(AstType.MutRef region _) (tc-tag-region region projected-ty)]
        [_ projected-ty])]))

;; Region-tagged aggregate flow uses the same lexical owner ordering as
;; references, but only considers arena owners. A value from an outer region can
;; flow into an inner target; an inner-region value cannot flow outward.
(define (tc-region-outlives-or-matches-scan
  [env : TcTypeEnv]
  [value-region : i64]
  [target-region : i64]) : bool
  (if (= value-region target-region)
    true
    (match env
      [(TcTypeEnv.Nil) false]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region)
          false)]
      [(TcTypeEnv.Bind key ty rest)
        (if (= key (tc-region-marker-id))
          (match ty
            [(AstType.Var region)
              (if (= region value-region)
                false
                (if (= region target-region)
                  true
                  (tc-region-outlives-or-matches-scan
                    (box-get rest)
                    value-region
                    target-region)))]
            [_
              (tc-region-outlives-or-matches-scan
                (box-get rest)
                value-region
                target-region)])
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region))])))

(define (tc-region-outlives-or-matches
  [env : TcTypeEnv]
  [value-region : i64]
  [target-region : i64]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-region-outlives-or-matches-scan
          (box-get rest)
          value-region
          target-region)]
      [_ (tc-region-outlives-or-matches-scan env value-region target-region)])))

(define (tc-region-can-flow-into-any
  [env : TcTypeEnv]
  [value-region : i64]
  [target-regions : TcNameIdList]) : bool
  (match target-regions
    [(TcNameIdList.Nil) false]
    [(TcNameIdList.Cons target rest)
      (if (tc-region-outlives-or-matches env value-region target)
        true
        (tc-region-can-flow-into-any env value-region (box-get rest)))]))

(define (tc-region-list-can-flow-into
  [env : TcTypeEnv]
  [value-regions : TcNameIdList]
  [target-regions : TcNameIdList]) : bool
  (match value-regions
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons value rest)
      (and
        (tc-region-can-flow-into-any env value target-regions)
        (tc-region-list-can-flow-into env (box-get rest) target-regions))]))

(define (tc-ensure-region-value-can-flow-into
  [env : TcTypeEnv]
  [target-ty : AstType]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [value-regions : TcNameIdList (tc-type-collect-regions value-ty)]
    (match value-regions
      [(TcNameIdList.Nil) ResultTcUnit.Ok]
      [_
        (let
          [target-regions : TcNameIdList (tc-type-collect-regions target-ty)]
          (if (and
            (tc-type-contains-any-region target-ty)
            (tc-region-list-can-flow-into env value-regions target-regions))
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              (string.append
                "typecheck: cannot store region-tagged value into "
                (string.append context "; region value would escape")))))])))

(define (tc-resolve-type-list [ctx : TcContext] [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-needs-resolution? types)
    (tc-resolve-type-list-at ctx (& types) 0)
    types))

(define (tc-resolve-type-list-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-resolve-type
        ctx
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-resolve-type-list-at ctx types (+ index 1)))))

(define (tc-type-list-needs-resolution? [types : AstTypeList]) : bool
  (tc-type-list-needs-resolution-at? (& types) 0))

(define (tc-type-list-needs-resolution-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (if (tc-type-needs-resolution?
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      true
      (tc-type-list-needs-resolution-at? types (+ index 1)))))

(define (tc-type-needs-resolution? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (if (tc-type-list-needs-resolution? (box-get args))
        true
        (tc-type-needs-resolution? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-needs-resolution? (box-get elems))]
    [(AstType.Array elem _) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Ref _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.MutRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.Region _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.Consume inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.VarArgs _ _) true]
    [(AstType.Var _) true]
    [_ false]))

;; id-keyed variant: reads the O(1) precomputed "contains-'/'" metadata slot
;; instead of re-hashing the name. The hygiene check needs the string, which
;; intern-str recovers in O(1). `tc-name-qualified? name` ==
;; `tc-name-qualified-id? (intern name)`, so threading the already-interned id
;; from callers is semantics-preserving and skips the hash. Refs #4427.
(define (tc-name-first-dot-id [name-id : i64]) : i64
  (cond
    [(or
        (macro-hygiene-global-id? name-id)
        (tc-structural-local-name-id? name-id))
      (intern-first-dot
        (macro-hygiene-global-source-name-id-or name-id name-id))]
    [(and (>= name-id 0) (< name-id (intern-capacity)))
      (intern-first-dot name-id)]
    [else -1]))

(define (tc-name-qualified-id? [name-id : i64]) : bool
  (cond
    [(< name-id 0) false]
    [(tc-structural-local-name-id? name-id) false]
    [(macro-hygiene-global-id? name-id)
      (not
        (compiler-symbol-root-module-id?
          (macro-hygiene-global-module-id name-id)))]
    [else
      (if (< name-id (intern-capacity))
        (and
          (or
            (< name-id (intern-pool-len))
            (not (tc-hygiene-local-name? (intern-str name-id))))
          (intern-qualified? name-id))
        (or
          (compiler-composite-pair-key-id? name-id)
          (compiler-composite-triple-key-id? name-id)))]))

(define (tc-qualified-name-module-id [name-id : i64]) : i64
  (cond
    [(and
        (>= name-id 0)
        (< name-id (intern-capacity))
        (intern-qualified? name-id))
      (intern-qualified-module-id name-id)]
    [(and (>= name-id 0) (< name-id (intern-capacity))) -1]
    [(compiler-composite-triple-key-id? name-id)
      (compiler-composite-triple-left-id name-id)]
    [(compiler-composite-pair-key-id? name-id)
      (compiler-composite-pair-left-id name-id)]
    [else -1]))

(define (tc-qualified-name-base-id [name-id : i64]) : i64
  (cond
    [(and
        (>= name-id 0)
        (< name-id (intern-capacity))
        (intern-qualified? name-id))
      (intern-qualified-base-id name-id)]
    [(and (>= name-id 0) (< name-id (intern-capacity))) name-id]
    [(compiler-composite-triple-key-id? name-id)
      (compiler-composite-pair-key-id
        (compiler-composite-triple-middle-id name-id)
        (compiler-composite-triple-right-id name-id))]
    [(compiler-composite-pair-key-id? name-id)
      (compiler-composite-pair-right-id name-id)]
    [else name-id]))

(define (tc-name-qualified? [name : String]) : bool
  (and
    (not (tc-hygiene-local-name? name))
    (>= (tc-qualified-name-last-slash name) 0)))

(define (tc-name-first-char [name : String] [needle : char]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (if (string.char-eq (string.string-ref name i) needle)
          (return i)
          (set! i (+ i 1))))
      -1)))

(define (tc-name-first-dot [name : String]) : i64
  (tc-name-first-char name '.'))

;; Variant taking the already-interned `name-id` so the hot name-resolution
;; path interns each name once and reads the slash position from the id-keyed
;; metadata instead of re-hashing the string. The hygiene checks stay on the
;; string (cheap prefix tests, no interning). Slash metadata is read directly
;; from the source identity carried by the AST.
(define (tc-source-slash-qualified-id? [name : String] [name-id : i64]) : bool
  (let
    [source-name-id : i64
      (macro-hygiene-global-source-name-id-or name-id name-id)]
    [slash : i64 (intern-qualified-last-slash source-name-id)]
    [n : i64 (string.string-length name)]
    (and
      (not (tc-hygiene-local-name-id? name-id))
      (not (tc-hygiene-global-name-id? name-id))
      (> slash 0)
      (< slash (- n 1)))))

(define (tc-name-slashes-to-dots [name : String]) : String
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    [out : String ""]
    (begin
      (while (< i n)
        (let
          [chunk : String
            (if (string.char-eq (string.string-ref name i) '/')
              "."
              (string.substring name i 1))]
          (begin
            (set! out (string.concat3 out chunk ""))
            (set! i (+ i 1)))))
      out)))

(define (tc-source-slash-qualified-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: slash-qualified name "
    name
    " is no longer supported; use "
    (tc-name-slashes-to-dots name)))

;; Bootstrap bridge: published stage0 builds may still encounter legacy
;; slash-qualified core macro spellings. Keep this narrow until the seed no
;; longer needs the compatibility path.
(define (tc-source-legacy-core-macro-compat? [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      (and
        (string.eq module "core")
        (or
          (string.eq base "when")
          (string.eq base "unless")
          (string.eq base "and")
          (string.eq base "or")
          (string.eq base "cond"))))
    false))

(define (tc-source-name-bound-exact-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-name-bound-id? env (tc-env-name-key-id name-id)))

(define (tc-current-module-source-lookup-key-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeNameId
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified-id? name-id)))
      (let
        [module-key-id : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name-id)]
        (if (tc-source-name-bound-exact-id? env module-key-id)
          (TcMaybeNameId.Some module-key-id)
          (TcMaybeNameId.No)))
      (TcMaybeNameId.No))))

(define (tc-current-module-source-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_name : String]
  [name-id : i64]) : TcMaybeString
  (match (tc-current-module-source-lookup-key-id ctx env name-id)
    [(TcMaybeNameId.Some key-id)
      (TcMaybeString.Some (tc-env-key-display key-id))]
    [(TcMaybeNameId.No) (TcMaybeString.No)]))

(define (tc-source-leading-segment-wins-over-exact-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        false
        (if (= key prefix-id)
          true
          (tc-source-leading-segment-wins-over-exact-id?
            (box-get rest)
            name-id
            prefix-id)))]
    [(TcTypeEnv.Cache ids _ _ _ _ _ partial _ below)
      (let
        [prefix-index : i64 (tc_i64_i64_map.get-value-or (& ids) prefix-id -1)]
        (if (>= prefix-index 0)
          (let
            [name-index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
            (if (>= name-index 0)
              (< prefix-index name-index)
              true))
          (if partial
            (if (>= (tc_i64_i64_map.get-value-or (& ids) name-id -1) 0)
              false
              (tc-source-leading-segment-wins-over-exact-id?
                (box-get below)
                name-id
                prefix-id))
            false)))]))

(define (tc-source-leading-segment-wins-over-exact-id-from-dot?
  [env : TcTypeEnv]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (or (<= first-dot 0) (< name-id 0) (>= name-id (intern-capacity)))
    false
    (let
      [prefix-id : i64 (intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

;; Variant taking the already-interned `name-id` to avoid re-hashing `name` on
;; the hot resolution path. The prefix comes from intern metadata recorded with
;; the first dot.
(define (tc-source-leading-segment-wins-over-exact-from-id?
  [env : TcTypeEnv]
  [_name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (or (<= first-dot 0) (< name-id 0) (>= name-id (intern-capacity)))
    false
    (let
      [prefix-id : i64 (intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

(define (tc-dotted-field-index-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: dotted field access "
    name
    " cannot use numeric field segments; use tuple-ref or array-ref"))

(define (tc-dotted-field-empty-message) : String
  "typecheck: malformed dotted field access; field name cannot be empty")

(define (tc-dotted-field-index-like-id? [field-id : i64]) : bool
  (let
    [field : String (intern-str field-id)]
    (and
      (> (string.string-length field) 0)
      (>= (string.string-ref field 0) '0')
      (<= (string.string-ref field 0) '9'))))

(define (tc-dotted-local-field-name-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (or (< name-id 0) (>= name-id (intern-capacity)))
    false
    (let
      [first-dot : i64 (tc-name-first-dot-id name-id)]
      (if (< first-dot 0)
        false
        (tc-source-leading-segment-wins-over-exact-id-from-dot?
          env
          name-id
          first-dot)))))

(define (tc-dotted-local-field-expr-id-tail
  [source-name-id : i64]
  [remaining-id : i64]
  [current : i64]) : ResultTcExprId
  (let
    [next-remaining-id : i64 (intern-dotted-tail-id remaining-id)]
    [field-id : i64
      (if (>= next-remaining-id 0)
        (intern-leading-dot-id remaining-id)
        remaining-id)]
    [field : String (intern-str field-id)]
    (if (= (string.string-length field) 0)
      (ResultTcExprId.Err (tc-dotted-field-empty-message))
      (if (tc-dotted-field-index-like-id? field-id)
        (ResultTcExprId.Err
          (tc-dotted-field-index-message (intern-str source-name-id)))
        (let
          [next : i64 (ast-expr-struct-get-id current field-id)]
          (if (>= next-remaining-id 0)
            (tc-dotted-local-field-expr-id-tail
              source-name-id
              next-remaining-id
              next)
            (ResultTcExprId.Ok next)))))))

(define (tc-dotted-local-field-expr-id-from-source-name-id [name-id : i64]) : ResultTcExprId
  (let
    [root-id : i64 (intern-leading-dot-id name-id)]
    [remaining-id : i64 (intern-dotted-tail-id name-id)]
    (if (or (< root-id 0) (< remaining-id 0))
      (ResultTcExprId.Err (tc-dotted-field-empty-message))
      (tc-dotted-local-field-expr-id-tail
        name-id
        remaining-id
        (ast-node-push (AstExpr.Var root-id))))))

(define (tc-dotted-local-field-expr-id-after-check [name-id : i64]) : ResultTcExprId
  (tc-dotted-local-field-expr-id-from-source-name-id name-id))

(define (tc-dotted-local-field-expr-id [env : TcTypeEnv] [name-id : i64]) : ResultTcExprId
  (if (tc-dotted-local-field-name-id? env name-id)
    (tc-dotted-local-field-expr-id-after-check name-id)
    (ResultTcExprId.Err "")))

(define (tc-dotted-local-field-set-expr-id-after-check
  [name-id : i64]
  [value : i64]) : ResultTcExprId
  (match (tc-dotted-local-field-expr-id-after-check name-id)
    [(ResultTcExprId.Ok get-id)
      (match (ast-expr-unspan (ast-node-get get-id))
        [(AstExpr.StructGet receiver-box field)
          (ResultTcExprId.Ok (ast-expr-struct-set-id receiver-box field value))]
        [_
          (ResultTcExprId.Err
            "typecheck: internal dotted field target mismatch")])]
    [(ResultTcExprId.Err message) (ResultTcExprId.Err message)]))

(define (tc-dotted-local-field-set-expr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [value : i64]) : ResultTcExprId
  (if (tc-dotted-local-field-name-id? env name-id)
    (tc-dotted-local-field-set-expr-id-after-check name-id value)
    (ResultTcExprId.Err "")))

;; Local dotted fields must become ordinary projection nodes before the
;; move/borrow/lower passes see them.  Keeping `root.field` as a raw Var and
;; teaching each later pass to rebuild it independently loses the rooted place
;; identity those passes use for conflict tracking.  This mutates the parsed
;; node exactly once, after the current lexical environment has decided that
;; the leading segment is a local rather than a module alias.
(define (tc-normalize-dotted-local-field-direct-node!
  [env : TcTypeEnv]
  [expr-id : i64]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Var name)
      (if (or
        (macro-hygiene-global-id? name)
        (tc-structural-local-name-id? name)
        (< (tc-name-first-dot-id name) 0))
        ResultTcUnit.Ok
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id-after-check name)
            [(ResultTcExprId.Ok projection-id)
              (begin
                (ast-node-set! expr-id (ast-node-get projection-id))
                ResultTcUnit.Ok)]
            [(ResultTcExprId.Err message) (ResultTcUnit.Err message)])
          ResultTcUnit.Ok))]
    [(AstExpr.Set name value-box)
      (if (or
        (macro-hygiene-global-id? name)
        (tc-structural-local-name-id? name)
        (< (tc-name-first-dot-id name) 0))
        ResultTcUnit.Ok
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id-after-check name value-box)
            [(ResultTcExprId.Ok projection-id)
              (begin
                (ast-node-set! expr-id (ast-node-get projection-id))
                ResultTcUnit.Ok)]
            [(ResultTcExprId.Err message) (ResultTcUnit.Err message)])
          ResultTcUnit.Ok))]
    [_ ResultTcUnit.Ok]))

;; Most typecheck entrypoints visit every expression in a program, so their
;; hot path only dispatches direct `Var` and `Set` nodes above.  Places and
;; call arguments can be source-span wrappers around those nodes; keep the
;; recursive walk for those focused paths only.
(define (tc-normalize-dotted-local-field-node!
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcUnit
  (match (ast-node-get expr-id)
    [(AstExpr.Spanned inner-box _)
      (tc-normalize-dotted-local-field-node! env inner-box)]
    [(AstExpr.Ann inner-box _)
      (tc-normalize-dotted-local-field-node! env inner-box)]
    [(AstExpr.Cast inner-box _)
      (tc-normalize-dotted-local-field-node! env inner-box)]
    [(AstExpr.Borrow _ _ place-box)
      (tc-normalize-dotted-local-field-node! env place-box)]
    [_
      (tc-normalize-dotted-local-field-direct-node!
        env
        expr-id
        (ast-node-get expr-id))]))

(define (tc-normalize-dotted-local-field-expr-list!
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-normalize-dotted-local-field-expr-list-at! env (& exprs) 0))

(define (tc-normalize-dotted-local-field-expr-list-at!
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-normalize-dotted-local-field-node!
      env
      (ast-expr-list-get exprs index 0))
      [(ResultTcUnit.Ok)
        (tc-normalize-dotted-local-field-expr-list-at! env exprs (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define tc-imported-module-identity-cache-capacity : i64
  8192)
(define tc-imported-module-identity-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-target-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-count : i64
  0)
(define tc-imported-module-identity-cache-generation : i64
  -1)
(define tc-imported-module-identity-cache-ready : bool
  false)

(define (tc-imported-module-identity-cache-reset!) : unit
  (set! tc-imported-module-identity-cache-ready false))

(define (tc-imported-module-identity-cache-ensure!) : unit
  (if (if tc-imported-module-identity-cache-ready
    (= tc-imported-module-identity-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-imported-module-identity-cache-capacity)
          (begin
            (array-set! tc-imported-module-identity-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-imported-module-identity-cache-count 0)
        (set! tc-imported-module-identity-cache-generation (intern-generation))
        (set! tc-imported-module-identity-cache-ready true)))))

(define (tc-imported-module-identity-cache-bucket
  [current-module-id : i64]
  [target-id : i64]) : i64
  (bit-and
    (+ (* current-module-id 2654435761) (* target-id 40503))
    (- tc-imported-module-identity-cache-capacity 1)))

;; Returns 1 for true, -1 for false, or -2 when absent.
(define (tc-imported-module-identity-cache-get
  [current-module-id : i64]
  [target-id : i64]) : i64
  (let
    [cursor : i64
      (tc-imported-module-identity-cache-bucket current-module-id target-id)]
    [module-key : i64 (+ current-module-id 1)]
    [target-key : i64 (+ target-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps tc-imported-module-identity-cache-capacity))
        (let
          [slot : i64
            (array-ref tc-imported-module-identity-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref tc-imported-module-identity-cache-target-keys cursor)
                target-key))
              (begin
                (set!
                  out
                  (array-ref tc-imported-module-identity-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- tc-imported-module-identity-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (tc-imported-module-identity-cache-put!
  [current-module-id : i64]
  [target-id : i64]
  [value : bool]) : unit
  (if (>=
    (* tc-imported-module-identity-cache-count 2)
    tc-imported-module-identity-cache-capacity)
    unit
    (let
      [cursor : i64
        (tc-imported-module-identity-cache-bucket current-module-id target-id)]
      [module-key : i64 (+ current-module-id 1)]
      [target-key : i64 (+ target-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps tc-imported-module-identity-cache-capacity))
          (let
            [slot : i64
              (array-ref tc-imported-module-identity-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  tc-imported-module-identity-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  tc-imported-module-identity-cache-target-keys
                  cursor
                  target-key)
                (array-set!
                  tc-imported-module-identity-cache-values
                  cursor
                  (if value
                    1
                    -1))
                (set!
                  tc-imported-module-identity-cache-count
                  (+ tc-imported-module-identity-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref
                    tc-imported-module-identity-cache-target-keys
                    cursor)
                  target-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- tc-imported-module-identity-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (tc-imported-module-identity-ids?
  [decls : AstDeclList]
  [current-module-id : i64]
  [target-id : i64]
  [module-id : i64]) : bool
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [current-module : i64 module-id]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (begin
          (match (ast-decl-list-ref-borrowed (& decls) index)
            [(AstDecl.Module _)
              (match (ast-decl-list-ref decls index)
                [(AstDecl.Module next-module) (set! current-module next-module)]
                [_ unit])]
            [(AstDecl.Import decl-meta _)
              ;; Copy only module/import declarations whose scalar and String
              ;; payloads are consumed. All other declarations stay borrowed.
              (match (ast-decl-list-ref decls index)
                [(AstDecl.Import
                    decl-meta
                    (AstImportSpec.Spec _ _ expected _ _))
                  (if (= current-module current-module-id)
                    (match expected
                      [(AstMaybeModuleName.Some target)
                        (if (= target target-id)
                          (set! found true)
                          unit)]
                      [(AstMaybeModuleName.No) unit])
                    unit)]
                [_ unit])]
            [_ unit])
          (set! index (+ index 1))))
      found)))

(define (tc-imported-module-identity-id? [ctx : TcContext] [target-id : i64]) : bool
  (match ctx
    [(TcContext program _ _ current-module current-module-id _ _)
      (match program
        [(AstProgram.Program decls-box)
          (begin
            (tc-imported-module-identity-cache-ensure!)
            (let
              [cached : i64
                (tc-imported-module-identity-cache-get
                  current-module-id
                  target-id)]
              (if (= cached -2)
                (let
                  [found : bool
                    (tc-imported-module-identity-ids?
                      (box-get decls-box)
                      current-module-id
                      target-id
                      cbi.compiler-builtin-id-fix-empty)]
                  (begin
                    (tc-imported-module-identity-cache-put!
                      current-module-id
                      target-id
                      found)
                    found))
                (> cached 0))))])]))

(define (tc-stdlib-string-module-name? [module-name : String]) : bool
  (or
    (string.eq module-name "string")
    (string.eq module-name "string.tl")
    (string.eq module-name "stdlib.string")
    (string.eq module-name "stdlib/string")
    (string.eq module-name "stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib/string.tl")
    (tc-string-has-suffix? module-name "\\stdlib\\string.tl")
    (tc-string-has-suffix? module-name "\\stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib\\string.tl")))

(define (tc-context-is-stdlib-string? [ctx : TcContext]) : bool
  (tc-stdlib-string-module-name? (tc-context-module ctx)))

(define (tc-type-list-ty-node-get [types : AstTypeList] [index : i64]) : AstType
  (ty-node-get (ast-type-list-get (& types) index (ast-type-id-fallback))))

(define (tc-stdlib-string-length-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 1)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ty-node-get ret) (AstType.I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (tc-type-list-ty-node-get args 1) (AstType.I64))
            (tc-type-eq (ty-node-get ret) (AstType.Char)))
          false))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-string-handle-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ty-node-get ret) (AstType.Bool)))
          false))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-str-ref-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ty-node-get ret) (AstType.String)))
          false))]
    [_ false]))

(define (tc-stdlib-string-to-int-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 1)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ty-node-get ret) (AstType.I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-helper-wrapper-type? [base : String] [ty : AstType]) : bool
  (cond
    [(string.eq base "string-length")
      (tc-stdlib-string-length-wrapper-type? ty)]
    [(string.eq base "string-ref") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "char-at") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string=?") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-append") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base "string-concat") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base "string->int") (tc-stdlib-string-to-int-wrapper-type? ty)]
    [else false]))

(define (tc-stdlib-string-helper-bound-wrapper?
  [env : TcTypeEnv]
  [base-id : i64]
  [base : String]) : bool
  (match (tc-lookup-id env base-id)
    [(ResultTcType.Ok ty) (tc-stdlib-string-helper-wrapper-type? base ty)]
    [(ResultTcType.Err _) false]))

(define (tc-stdlib-string-length-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.I64))
        (= (ast-param-list-len (& params)) 1)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ text _ _)
            (tc-str-ref-type? (tc-resolve-type ctx text))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.Char))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ text _ _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ index _ _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx text))
                  (tc-type-eq (tc-resolve-type ctx index) (AstType.I64)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.Bool))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ left _ _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ right _ _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.String))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ left _ _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ right _ _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-helper-symbol-wrapper?
  [ctx : TcContext]
  [base-id : i64]
  [base : String]) : bool
  (match ctx
    [(TcContext _ symbols _ _ _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-value-id-or
            symbols
            base-id
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (let
            [decls : (Array AstDecl) (compiler-symbols-decls symbols)]
            [index : i64 (compiler-symbol-handle-index handle)]
            (if (or (< index 0) (>= index (array.length decls)))
              false
              (let
                [decl : AstDecl (array-ref decls index)]
                (cond
                  [(string.eq base "string-length")
                    (tc-stdlib-string-length-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-ref")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.eq base "char-at")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.eq base "eq")
                    (tc-stdlib-string-eq-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-append")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-concat")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [else false]))))
          false))]))

(define (tc-stdlib-string-qualified-helper-id?
  [lookup-id : i64]
  [base-id : i64]
  [_base : String]) : bool
  (and
    (tc-name-qualified-id? lookup-id)
    (= (tc-qualified-name-base-id lookup-id) base-id)
    (tc-stdlib-string-module-name?
      (tc-nominal-name-id-display (tc-qualified-name-module-id lookup-id)))))

;; --- per-epoch module -> decl-position index ----------------------------------
;; tc-module-local-env-list and tc-decl-list-module-imports-stdlib-string? both
;; filter the whole-program decl list down to one module by scanning every
;; declaration and tracking (module NAME) markers, re-paying O(program) AstDecl
;; copies per query. This CSR index maps module ids to program-order decl
;; positions (module markers excluded); consumers keep their own per-decl match
;; arms, so they process exactly the subsequence the full scan would have. The
;; program view changes at in-pass splice rebuilds, so validity is stamped by
;; (len, offset, intern generation) and dropped by macro-alias-derived-cache-
;; reset! (the same per-splice/per-program boundary as the alias caches); a
;; single-decl splice that preserves the list length also preserves every
;; module's positions (memo markers never add or remove module markers), so
;; the stamp is sufficient. Backing storage lives in a dedicated arena (the
;; tc-hygiene-module-env-cache-arena idiom) because queries run while
;; transient scratch arenas are active.
(define tc-module-decl-index-ready : bool
  false)
(define tc-module-decl-index-decl-count : i64
  -1)
(define tc-module-decl-index-decl-offset : i64
  -1)
(define tc-module-decl-index-generation : i64
  -1)
(define tc-module-decl-index-arena : i64
  0)
(define tc-module-decl-index-modules : tc_i64_i64_map.Map
  (tc_i64_i64_map.with-capacity 16))
(define tc-module-decl-index-starts : (Array i64)
  (array.make-array i64 0))
(define tc-module-decl-index-ends : (Array i64)
  (array.make-array i64 0))
(define tc-module-decl-index-positions : (Array i64)
  (array.make-array i64 0))
(define tc-module-import-index-starts : (Array i64)
  (array.make-array i64 0))
(define tc-module-import-index-ends : (Array i64)
  (array.make-array i64 0))
(define tc-module-import-index-positions : (Array i64)
  (array.make-array i64 0))

(define (tc-module-decl-index-reset!) : unit
  (begin
    (set! tc-module-decl-index-ready false)
    (set! tc-module-decl-index-decl-count -1)
    (set! tc-module-decl-index-decl-offset -1)
    ;; The stale array/map globals are never read while ready is false (every
    ;; consumer goes through ensure!), so destroying their arena here is safe.
    (if (= tc-module-decl-index-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-module-decl-index-arena))
        (set! tc-module-decl-index-arena 0)))))

(define (tc-module-decl-index-ensure! [decls : AstDeclList]) : unit
  (if (and
    tc-module-decl-index-ready
    (= tc-module-decl-index-decl-count (struct-get decls len))
    (= tc-module-decl-index-decl-offset (struct-get decls offset))
    (= tc-module-decl-index-generation (intern-generation)))
    unit
    (let
      [count : i64 (struct-get decls len)]
      [decl-offset : i64 (struct-get decls offset)]
      [decl-slots : (Array AstDecl) (struct-get decls slots)]
      [empty-module-id : i64 cbi.compiler-builtin-id-fix-empty]
      [prev-arena : i64 (arena.tl_arena_current)]
      [_make-arena : unit
        (if (= tc-module-decl-index-arena 0)
          (set! tc-module-decl-index-arena (arena.tl_arena_make))
          unit)]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set tc-module-decl-index-arena))]
      [modules : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 512)]
      [module-count : i64 0]
      [counts : (Array i64) (array.make-array i64 (+ count 1))]
      [import-counts : (Array i64) (array.make-array i64 (+ count 1))]
      [starts : (Array i64) (array.make-array i64 (+ count 1))]
      [ends : (Array i64) (array.make-array i64 (+ count 1))]
      [positions : (Array i64) (array.make-array i64 (+ count 1))]
      [import-starts : (Array i64) (array.make-array i64 (+ count 1))]
      [import-ends : (Array i64) (array.make-array i64 (+ count 1))]
      [import-positions : (Array i64) (array.make-array i64 (+ count 1))]
      [cur-module-id : i64 empty-module-id]
      [i : i64 0]
      [running : i64 0]
      [import-running : i64 0]
      (begin
        ;; Pass 1: assign a dense slot per module id and count its decls.
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (let
                  [slot : i64
                    (let
                      [found-slot : i64
                        (tc_i64_i64_map.get-value-or
                          (& modules)
                          cur-module-id
                          -1)]
                      (if (>= found-slot 0)
                        found-slot
                        (let
                          [new-slot : i64 module-count]
                          (begin
                            (tc_i64_i64_map.insert-ref!
                              (&mut modules)
                              cur-module-id
                              new-slot)
                            (set! module-count (+ module-count 1))
                            new-slot))))]
                  (array-set! counts slot (+ (array-ref counts slot) 1))
                  (match (ast-decl-unwrapped
                    (array-ref decl-slots (+ decl-offset i)))
                    [(AstDecl.Import decl-meta _)
                      (array-set!
                        import-counts
                        slot
                        (+ (array-ref import-counts slot) 1))]
                    [_ unit]))])
            (set! i (+ i 1))))
        ;; Prefix sums: starts fixed, ends double as fill cursors below.
        (set! i 0)
        (while (< i module-count)
          (begin
            (array-set! starts i running)
            (array-set! ends i running)
            (array-set! import-starts i import-running)
            (array-set! import-ends i import-running)
            (set! running (+ running (array-ref counts i)))
            (set! import-running (+ import-running (array-ref import-counts i)))
            (set! i (+ i 1))))
        ;; Pass 2: fill program-order positions per module slot.
        (set! cur-module-id empty-module-id)
        (set! i 0)
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (let
                  [slot : i64
                    (tc_i64_i64_map.get-value-or (& modules) cur-module-id -1)]
                  (if (>= slot 0)
                    (let
                      [cursor : i64 (array-ref ends slot)]
                      (begin
                        (array-set! positions cursor i)
                        (array-set! ends slot (+ cursor 1))
                        (match (ast-decl-unwrapped
                          (array-ref decl-slots (+ decl-offset i)))
                          [(AstDecl.Import decl-meta _)
                            (let
                              [import-cursor : i64 (array-ref import-ends slot)]
                              (begin
                                (array-set! import-positions import-cursor i)
                                (array-set!
                                  import-ends
                                  slot
                                  (+ import-cursor 1))))]
                          [_ unit])))
                    unit))])
            (set! i (+ i 1))))
        (set! tc-module-decl-index-modules modules)
        (set! tc-module-decl-index-starts starts)
        (set! tc-module-decl-index-ends ends)
        (set! tc-module-decl-index-positions positions)
        (set! tc-module-import-index-starts import-starts)
        (set! tc-module-import-index-ends import-ends)
        (set! tc-module-import-index-positions import-positions)
        (set! tc-module-decl-index-decl-count count)
        (set! tc-module-decl-index-decl-offset decl-offset)
        (set! tc-module-decl-index-generation (intern-generation))
        ;; The arena head advances as it grows; re-capture it so reset!
        ;; destroys the whole chain, then restore the caller's arena.
        (set! tc-module-decl-index-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set prev-arena))
        (set! tc-module-decl-index-ready true)))))

;; Dense slot for a module id, or -1 when the module owns no declarations.
(define (tc-module-decl-index-slot [module-id : i64]) : i64
  (tc_i64_i64_map.get-value-or (& tc-module-decl-index-modules) module-id -1))

(define (tc-decl-list-module-imports-stdlib-string?
  [decls : AstDeclList]
  [target-module-id : i64]
  [current-module-id : i64]) : bool
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [_unused-module-id : i64 current-module-id]
    [slot : i64 (tc-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      false
      (let
        [j : i64 (array-ref tc-module-decl-index-starts slot)]
        [end : i64 (array-ref tc-module-decl-index-ends slot)]
        [found : bool false]
        (begin
          (while (and (not found) (< j end))
            (begin
              (match (array-ref
                (struct-get decls slots)
                (+
                  (struct-get decls offset)
                  (array-ref tc-module-decl-index-positions j)))
                [(AstDecl.Import
                    decl-meta
                    (AstImportSpec.Spec
                      _
                      _
                      (AstMaybeModuleName.Some import-module)
                      _
                      _))
                  (if (tc-stdlib-string-module-name? (intern-str import-module))
                    (set! found true)
                    unit)]
                [_ unit])
              (set! j (+ j 1))))
          found)))))

(define (tc-context-imports-stdlib-string? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ module module-id _ _)
      (match program
        [(AstProgram.Program decls-box)
          (tc-decl-list-module-imports-stdlib-string?
            (box-get decls-box)
            module-id
            cbi.compiler-builtin-id-fix-empty)])]))

(define (tc-stdlib-string-helper-visible-or-wrapper-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-match : bool]
  [lookup-id : i64]
  [base-id : i64]
  [base : String]) : bool
  (if source-match
    (or
      (tc-context-is-stdlib-string? ctx)
      (tc-context-imports-stdlib-string? ctx)
      (tc-stdlib-string-helper-bound-wrapper? env base-id base)
      (tc-stdlib-string-helper-symbol-wrapper? ctx base-id base)
      (tc-stdlib-string-qualified-helper-id? lookup-id base-id base))
    (tc-stdlib-string-qualified-helper-id? lookup-id base-id base)))

(define tc-source-dotted-alias-key-cache-capacity : i64
  8192)
(define tc-source-dotted-alias-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-generation : i64
  -1)
(define tc-source-dotted-alias-key-cache-ready : bool
  false)
(define tc-source-dotted-full-path-key-cache-capacity : i64
  8192)
(define tc-source-dotted-full-path-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-generation : i64
  -1)
(define tc-source-dotted-full-path-key-cache-ready : bool
  false)
(define tc-source-qualified-variant-key-cache-capacity : i64
  8192)
(define tc-source-qualified-variant-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-handle-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-registry-id : i64
  -1)
(define tc-source-qualified-variant-key-cache-ready : bool
  false)

(define (tc-source-dotted-alias-key-cache-reset!) : unit
  (set! tc-source-dotted-alias-key-cache-ready false))

(define (tc-source-dotted-full-path-key-cache-reset!) : unit
  (set! tc-source-dotted-full-path-key-cache-ready false))

(define (tc-source-qualified-variant-key-cache-reset!) : unit
  (set! tc-source-qualified-variant-key-cache-ready false))

(define (tc-source-dotted-alias-key-cache-ensure!) : unit
  (if (and
    tc-source-dotted-alias-key-cache-ready
    (= tc-source-dotted-alias-key-cache-generation (intern-generation)))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-dotted-alias-key-cache-capacity)
          (begin
            (array-set! tc-source-dotted-alias-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-source-dotted-alias-key-cache-generation (intern-generation))
        (set! tc-source-dotted-alias-key-cache-ready true)))))

(define (tc-source-dotted-full-path-key-cache-ensure!) : unit
  (if (and
    tc-source-dotted-full-path-key-cache-ready
    (= tc-source-dotted-full-path-key-cache-generation (intern-generation)))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-dotted-full-path-key-cache-capacity)
          (begin
            (array-set! tc-source-dotted-full-path-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set!
          tc-source-dotted-full-path-key-cache-generation
          (intern-generation))
        (set! tc-source-dotted-full-path-key-cache-ready true)))))

(define (tc-source-qualified-variant-key-cache-ensure! [registry-id : i64]) : unit
  (if (and
    tc-source-qualified-variant-key-cache-ready
    (= tc-source-qualified-variant-key-cache-registry-id registry-id))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-qualified-variant-key-cache-capacity)
          (begin
            (array-set! tc-source-qualified-variant-key-cache-name-keys i 0)
            (set! i (+ i 1))))
        (set! tc-source-qualified-variant-key-cache-registry-id registry-id)
        (set! tc-source-qualified-variant-key-cache-ready true)))))

(define (tc-source-dotted-alias-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- tc-source-dotted-alias-key-cache-capacity 1)))

(define (tc-source-dotted-full-path-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2246822519) (* name-id 3266489917))
    (- tc-source-dotted-full-path-key-cache-capacity 1)))

(define (tc-source-qualified-variant-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 668265263) (* name-id 374761393))
    (- tc-source-qualified-variant-key-cache-capacity 1)))

;; Returns the cached lookup-name id, -1 for no alias import, or -2 when absent.
(define (tc-source-dotted-alias-key-cache-get [module-id : i64] [name-id : i64]) : i64
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-dotted-alias-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-dotted-alias-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-dotted-alias-key-cache-values cursor)
        -2))))

;; Returns the cached lookup-name id, -1 for no full path, or -2 when absent.
(define (tc-source-dotted-full-path-key-cache-get
  [module-id : i64]
  [name-id : i64]) : i64
  (begin
    (tc-source-dotted-full-path-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-dotted-full-path-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-dotted-full-path-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-dotted-full-path-key-cache-values cursor)
        -2))))

;; Returns the cached lookup-name id, -1 for no variant, or -2 when absent.
(define (tc-source-qualified-variant-key-cache-get
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (begin
    (tc-source-qualified-variant-key-cache-ensure! registry-id)
    (let
      [cursor : i64
        (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-qualified-variant-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-qualified-variant-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-qualified-variant-key-cache-values cursor)
        -2))))

;; Returns the cached registry handle, -1 for no variant, or -2 when absent.
(define (tc-source-qualified-variant-handle-cache-get
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (begin
    (tc-source-qualified-variant-key-cache-ensure! registry-id)
    (let
      [cursor : i64
        (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-qualified-variant-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-qualified-variant-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-qualified-variant-handle-cache-values cursor)
        -2))))

(define (tc-source-dotted-alias-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-dotted-alias-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-dotted-alias-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-dotted-alias-key-cache-values cursor value)))))

(define (tc-source-dotted-full-path-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-dotted-full-path-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-dotted-full-path-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-dotted-full-path-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-dotted-full-path-key-cache-values cursor value)))))

(define (tc-source-qualified-variant-key-cache-put!
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]
  [value : i64]
  [handle : i64]) : unit
  (begin
    (tc-source-qualified-variant-key-cache-ensure! registry-id)
    (let
      [cursor : i64
        (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-qualified-variant-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-qualified-variant-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-qualified-variant-key-cache-values cursor value)
        (array-set!
          tc-source-qualified-variant-handle-cache-values
          cursor
          handle)))))

(define tc-lazy-import-stubs : TcLazyImportStubList
  (TcLazyImportStubList.Nil))
(define tc-lazy-import-stub-capacity : i64
  65536)
(define tc-lazy-import-stub-module-ids : (Array i64)
  (array.make-array i64 65536))
(define tc-lazy-import-stub-alias-ids : (Array i64)
  (array.make-array i64 65536))
(define tc-lazy-import-stub-target-ids : (Array i64)
  (array.make-array i64 65536))
(define tc-lazy-import-stub-summary-backed : (Array bool)
  (array.make-array bool 65536))
(define tc-lazy-import-stub-index-slots : (Array i64)
  (array.make-array i64 65536))
(define tc-lazy-import-stub-record-count : i64
  0)
(define tc-lazy-import-stub-generation : i64
  -1)
(define tc-lazy-import-summary-backed-count : i64
  0)
(define tc-lazy-import-summary-macro-force-record-count : i64
  0)

;; Return either the matching record-index slot or the first empty slot. Slots
;; store record index + 1, so reset can clear the index without touching the
;; record arrays. Key equality is checked against those existing arrays.
(define (tc-lazy-import-stub-index-probe
  [importer-module-id : i64]
  [alias-id : i64]
  [cursor : i64]
  [probes : i64]) : i64
  (if (>= probes tc-lazy-import-stub-capacity)
    -1
    (let
      [entry : i64 (array-ref tc-lazy-import-stub-index-slots cursor)]
      (if (= entry 0)
        cursor
        (let
          [record-index : i64 (- entry 1)]
          (if (and
            (=
              (array-ref tc-lazy-import-stub-module-ids record-index)
              importer-module-id)
            (= (array-ref tc-lazy-import-stub-alias-ids record-index) alias-id))
            cursor
            (tc-lazy-import-stub-index-probe
              importer-module-id
              alias-id
              (bit-and (+ cursor 1) (- tc-lazy-import-stub-capacity 1))
              (+ probes 1))))))))

(define (tc-lazy-import-stub-index-slot
  [importer-module-id : i64]
  [alias-id : i64]) : i64
  (let
    [start : i64
      (bit-and
        (+ (* importer-module-id 2654435761) (* alias-id 40503))
        (- tc-lazy-import-stub-capacity 1))]
    (tc-lazy-import-stub-index-probe importer-module-id alias-id start 0)))

(define (tc-lazy-import-stub-index-reset!) : unit
  (let
    [slot : i64 0]
    (while (< slot tc-lazy-import-stub-capacity)
      (begin
        (array-set! tc-lazy-import-stub-index-slots slot 0)
        (set! slot (+ slot 1))))))

(define (tc-lazy-import-stub-index-record!
  [record-index : i64]
  [importer-module-id : i64]
  [alias-id : i64]
  [target-module-id : i64]) : unit
  (let
    [slot : i64 (tc-lazy-import-stub-index-slot importer-module-id alias-id)]
    (if (< slot 0)
      unit
      (let
        [entry : i64 (array-ref tc-lazy-import-stub-index-slots slot)]
        (if (or
          (= entry 0)
          (not (= target-module-id alias-id))
          (= (array-ref tc-lazy-import-stub-target-ids (- entry 1)) alias-id))
          (array-set! tc-lazy-import-stub-index-slots slot (+ record-index 1))
          unit)))))

(define (tc-lazy-import-stubs-reset!) : unit
  (begin
    (set! tc-lazy-import-stubs (TcLazyImportStubList.Nil))
    (set! tc-lazy-import-stub-record-count 0)
    (set! tc-lazy-import-summary-backed-count 0)
    (set! tc-lazy-import-summary-macro-force-record-count 0)
    (tc-lazy-import-stub-index-reset!)
    (set! tc-lazy-import-stub-generation (intern-generation))
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))

(define (tc-lazy-import-stubs-ensure!) : unit
  (if (= tc-lazy-import-stub-generation (intern-generation))
    unit
    (tc-lazy-import-stubs-reset!)))

(define (tc-lazy-import-stub-count) : i64
  (begin
    (tc-lazy-import-stubs-ensure!)
    tc-lazy-import-stub-record-count))

(define (tc-lazy-import-summary-backed-stub-count) : i64
  (begin
    (tc-lazy-import-stubs-ensure!)
    tc-lazy-import-summary-backed-count))

(define (tc-lazy-import-summary-macro-force-count) : i64
  (begin
    (tc-lazy-import-stubs-ensure!)
    tc-lazy-import-summary-macro-force-record-count))

(define (tc-lazy-import-summary-macro-force-record!) : unit
  (begin
    (tc-lazy-import-stubs-ensure!)
    (set!
      tc-lazy-import-summary-macro-force-record-count
      (+ tc-lazy-import-summary-macro-force-record-count 1))))

(define (tc-lazy-import-stub-record!
  [importer-module-id : i64]
  [alias-id : i64]
  [target-module-id : i64]
  [summary-backed : bool]) : unit
  (begin
    (tc-lazy-import-stubs-ensure!)
    (if (< tc-lazy-import-stub-record-count tc-lazy-import-stub-capacity)
      (let
        [index : i64 tc-lazy-import-stub-record-count]
        (begin
          (array-set! tc-lazy-import-stub-module-ids index importer-module-id)
          (array-set! tc-lazy-import-stub-alias-ids index alias-id)
          (array-set! tc-lazy-import-stub-target-ids index target-module-id)
          (array-set! tc-lazy-import-stub-summary-backed index summary-backed)
          (tc-lazy-import-stub-index-record!
            index
            importer-module-id
            alias-id
            target-module-id)
          (set! tc-lazy-import-stub-record-count (+ index 1))))
      unit)
    (if summary-backed
      (set!
        tc-lazy-import-summary-backed-count
        (+ tc-lazy-import-summary-backed-count 1))
      unit)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))

(define (tc-lazy-import-stub-target-indexed
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (begin
    (tc-lazy-import-stubs-ensure!)
    (let
      [slot : i64 (tc-lazy-import-stub-index-slot importer-module-id alias-id)]
      (if (< slot 0)
        (TcMaybeNameId.No)
        (let
          [entry : i64 (array-ref tc-lazy-import-stub-index-slots slot)]
          (if (= entry 0)
            (TcMaybeNameId.No)
            (TcMaybeNameId.Some
              (array-ref tc-lazy-import-stub-target-ids (- entry 1)))))))))

(define (tc-lazy-import-stub-target-in
  [stubs : TcLazyImportStubList]
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (match stubs
    [(TcLazyImportStubList.Nil) (TcMaybeNameId.No)]
    [(TcLazyImportStubList.Cons
        stub-module-id
        stub-alias-id
        target-module-id
        _
        rest-box)
      (if (and (= stub-module-id importer-module-id) (= stub-alias-id alias-id))
        (if (= target-module-id alias-id)
          (match (tc-lazy-import-stub-target-in
            (box-get rest-box)
            importer-module-id
            alias-id)
            [(TcMaybeNameId.Some concrete-target-id)
              (TcMaybeNameId.Some concrete-target-id)]
            [(TcMaybeNameId.No) (TcMaybeNameId.Some target-module-id)])
          (TcMaybeNameId.Some target-module-id))
        (tc-lazy-import-stub-target-in
          (box-get rest-box)
          importer-module-id
          alias-id))]))

(define (tc-lazy-import-stub-target-id
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (tc-lazy-import-stub-target-indexed importer-module-id alias-id))

;; Generated declarations can be checked before their source module's marker is
;; reached in the expansion walk. Use an alias-wide target only when every
;; concrete recorded target that exports the requested type resolves to the
;; same symbol handle; otherwise preserve the ordinary unresolved result.
(define (tc-lazy-import-unique-type-key-id
  [symbols : CompilerSymbols]
  [alias-id : i64]
  [base-id : i64]) : TcMaybeNameId
  (begin
    (tc-lazy-import-stubs-ensure!)
    (let
      [index : i64 (- tc-lazy-import-stub-record-count 1)]
      [found-key : i64 -1]
      [found-handle : i64 -1]
      [ambiguous : bool false]
      (begin
        (while (and (not ambiguous) (>= index 0))
          (let
            [stub-alias-id : i64
              (array-ref tc-lazy-import-stub-alias-ids index)]
            [target-id : i64 (array-ref tc-lazy-import-stub-target-ids index)]
            (begin
              (if (and (= stub-alias-id alias-id) (not (= target-id alias-id)))
                (let
                  [key-id : i64
                    (compiler-symbol-module-key-id-by-id target-id base-id)]
                  [handle : i64
                    (compiler-symbols-lookup-type-id-or symbols key-id -1)]
                  (if (compiler-symbols-handle-found? handle)
                    (if (< found-handle 0)
                      (begin
                        (set! found-key key-id)
                        (set! found-handle handle))
                      (if (= handle found-handle)
                        unit
                        (set! ambiguous true)))
                    unit))
                unit)
              (set! index (- index 1)))))
        (if (and (not ambiguous) (>= found-handle 0))
          (TcMaybeNameId.Some found-key)
          (TcMaybeNameId.No))))))

(define (tc-source-dotted-alias-target-id
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (match (tc-lazy-import-stub-target-id current-module-id alias-id)
    [(TcMaybeNameId.Some target-module-id)
      (if (= target-module-id alias-id)
        (macro-import-alias-target-cached-id decls current-module-id alias-id)
        (TcMaybeNameId.Some target-module-id))]
    [(TcMaybeNameId.No)
      (macro-import-alias-target-cached-id decls current-module-id alias-id)]))

(define (tc-call-builtin-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : i64
  (cond
    [(< source-id 0) source-id]
    [(and
        (not (tc-hygiene-local-name? source-name))
        (tc-name-qualified-id? source-id))
      source-id]
    [(>= (tc-name-first-dot-id source-id) 0)
      (match (tc-source-name-lookup-key-with-field-check-lookup
        ctx
        env
        source-name
        source-id
        true)
        [(TcNameLookup.Ok lookup-name lookup-id)
          (begin
            (cbi.compiler-builtin-refresh!)
            lookup-id)]
        [(TcNameLookup.Err _) source-id])]
    [else source-id]))

(define (tc-call-variant-name-id?
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : bool
  (if (< name-id 0)
    false
    (match (tc-enum-qualified-variant-lookup-handle ctx name name-id)
      [(option_i64.Some _) true]
      [(option_i64.None) false])))

(define (tc-source-dotted-alias-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [first-dot : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcMaybeString.No)
      (let
        [alias-id : i64 (intern-leading-dot-id name-id)]
        [cached : i64
          (tc-source-dotted-alias-key-cache-get current-module-id name-id)]
        (if (= cached -2)
          (let
            [base-id : i64 (intern-dotted-tail-id name-id)]
            (match (tc-context-program ctx)
              [(AstProgram.Program decls-box)
                (match (tc-source-dotted-alias-target-id
                  (box-get decls-box)
                  current-module-id
                  alias-id)
                  [(TcMaybeNameId.Some target-module-id)
                    (if (< base-id 0)
                      (TcMaybeString.No)
                      (let
                        [lookup-name : String
                          (compiler-symbol-module-key
                            (intern-str target-module-id)
                            (intern-str base-id))]
                        [lookup-id : i64
                          (tc-qualified-name-key-id target-module-id base-id)]
                        (begin
                          (tc-source-dotted-alias-key-cache-put!
                            current-module-id
                            name-id
                            lookup-id)
                          (TcMaybeString.Some lookup-name))))]
                  [(TcMaybeNameId.No)
                    (begin
                      (tc-source-dotted-alias-key-cache-put!
                        current-module-id
                        name-id
                        -1)
                      (TcMaybeString.No))])]))
          (if (< cached 0)
            (TcMaybeString.No)
            (TcMaybeString.Some (tc-nominal-name-id-display cached))))))))

(define (tc-source-alias-display-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    [first-dot : i64 (tc-name-first-dot-id name-id)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcMaybeString.No)
      (let
        [alias-id : i64 (intern-leading-dot-id name-id)]
        [alias : String (string.substring name 0 first-dot)]
        [base-start : i64 (+ first-dot 1)]
        [base : String (string.substring name base-start (- n base-start))]
        (match ctx
          [(TcContext program _ _ _ current-module-id _ _)
            (match program
              [(AstProgram.Program decls-box)
                (match (macro-import-alias-target-cached-id
                  (box-get decls-box)
                  current-module-id
                  alias-id)
                  [(TcMaybeNameId.Some target-id)
                    (if (= target-id alias-id)
                      (TcMaybeString.No)
                      (TcMaybeString.Some
                        (compiler-symbol-module-key alias base)))]
                  [(TcMaybeNameId.No) (TcMaybeString.No)])])])))))

(define (tc-source-lookup-display-name
  [ctx : TcContext]
  [source-name : String]
  [source-name-id : i64]
  [lookup-name : String]) : String
  (match (tc-source-alias-display-key ctx source-name source-name-id)
    [(TcMaybeString.Some display-name) display-name]
    [(TcMaybeString.No) lookup-name]))

(define (tc-source-unbound-display-message
  [ctx : TcContext]
  [source-name : String]
  [source-name-id : i64]
  [lookup-name : String]
  [message : String]) : String
  (let
    [lookup-unbound : String
      (string.append "typecheck: unbound name " lookup-name)]
    (match (tc-source-alias-display-key ctx source-name source-name-id)
      [(TcMaybeString.Some display-name)
        (if (string.eq message lookup-unbound)
          (string.append "typecheck: unbound name " display-name)
          message)]
      [(TcMaybeString.No) message])))

(define (tc-dotted-prefix-depth [name-id : i64]) : i64
  (let
    [current : i64 name-id]
    [depth : i64 0]
    (begin
      (while (>= (intern-first-dot current) 0)
        (begin
          (set! depth (+ depth 1))
          (set! current (intern-dotted-prefix-id current))))
      depth)))

(define (tc-dotted-tail-after [name-id : i64] [count : i64]) : i64
  (let
    [current : i64 name-id]
    [remaining : i64 count]
    (begin
      (while (and (> remaining 0) (>= current 0))
        (begin
          (set! current (intern-dotted-tail-id current))
          (set! remaining (- remaining 1))))
      current)))

(define (tc-source-dotted-full-path-key-from-id
  [ctx : TcContext]
  [_name : String]
  [name-id : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [cached : i64
      (tc-source-dotted-full-path-key-cache-get current-module-id name-id)]
    (if (= cached -2)
      (let
        [candidate-id : i64 (intern-dotted-prefix-id name-id)]
        [module-id : i64 -1]
        (begin
          (while (and (>= candidate-id 0) (< module-id 0))
            (if (or
              (= candidate-id current-module-id)
              (tc-imported-module-identity-id? ctx candidate-id))
              (set! module-id candidate-id)
              (set! candidate-id (intern-dotted-prefix-id candidate-id))))
          (if (>= module-id 0)
            (let
              [base-id : i64
                (tc-dotted-tail-after
                  name-id
                  (+ (tc-dotted-prefix-depth module-id) 1))]
              [lookup-name : String
                (compiler-symbol-module-key
                  (intern-str module-id)
                  (intern-str base-id))]
              [lookup-id : i64 (tc-qualified-name-key-id module-id base-id)]
              (begin
                (tc-source-dotted-full-path-key-cache-put!
                  current-module-id
                  name-id
                  lookup-id)
                (TcMaybeString.Some lookup-name)))
            (begin
              (tc-source-dotted-full-path-key-cache-put!
                current-module-id
                name-id
                -1)
              (TcMaybeString.No)))))
      (if (< cached 0)
        (TcMaybeString.No)
        (TcMaybeString.Some (tc-nominal-name-id-display cached))))))

(define (tc-unresolved-dotted-name-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown qualified name "
    name
    "; import the module or use a visible dotted module alias"))

(define (tc-string-prefix-at? [text : String] [prefix : String] [start : i64]) : bool
  (string.is-string-prefix-at (& text) (& prefix) start))

(define tc-comptime-helper-prefix-cache-generation : i64
  -1)
(define tc-comptime-helper-prefix-comptime-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-comptime-id : i64
  -1)
(define tc-comptime-helper-prefix-string-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-string-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-id : i64
  -1)

(define (tc-comptime-helper-prefix-cache-ensure!) : unit
  (if (= tc-comptime-helper-prefix-cache-generation (intern-generation))
    unit
    (begin
      (set!
        tc-comptime-helper-prefix-comptime-id
        cbi.compiler-builtin-id-fix-comptime)
      (set!
        tc-comptime-helper-prefix-stdlib-comptime-id
        cbi.compiler-builtin-id-fix-stdlib_slash_comptime)
      (set!
        tc-comptime-helper-prefix-string-id
        cbi.compiler-builtin-id-fix-string)
      (set!
        tc-comptime-helper-prefix-stdlib-string-id
        cbi.compiler-builtin-id-fix-stdlib_slash_string)
      (set!
        tc-comptime-helper-prefix-stdlib-id
        cbi.compiler-builtin-id-fix-stdlib)
      (set! tc-comptime-helper-prefix-cache-generation (intern-generation)))))

(define (tc-comptime-helper-qualified-candidate-from-id?
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (begin
      (tc-comptime-helper-prefix-cache-ensure!)
      (let
        [prefix-id : i64 (intern-leading-dot-id name-id)]
        (cond
          [(or
              (= prefix-id tc-comptime-helper-prefix-comptime-id)
              (= prefix-id tc-comptime-helper-prefix-stdlib-comptime-id)
              (= prefix-id tc-comptime-helper-prefix-string-id)
              (= prefix-id tc-comptime-helper-prefix-stdlib-string-id))
            true]
          [(= prefix-id tc-comptime-helper-prefix-stdlib-id)
            (or
              (tc-string-prefix-at? name "comptime." (+ first-dot 1))
              (tc-string-prefix-at? name "comptime/" (+ first-dot 1))
              (tc-string-prefix-at? name "string." (+ first-dot 1))
              (tc-string-prefix-at? name "string/" (+ first-dot 1)))]
          [else false])))))

(define (tc-comptime-helper-qualified-lookup-key
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeString
  (match (tc-comptime-helper-qualified-lookup-key-id env name name-id first-dot)
    [(TcMaybeNameId.Some call-name-id)
      (TcMaybeString.Some (intern-str call-name-id))]
    [(TcMaybeNameId.No) (TcMaybeString.No)]))

(define (tc-comptime-helper-qualified-lookup-key-id
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeNameId
  (if (tc-comptime-helper-qualified-candidate-from-id? name name-id first-dot)
    (let
      [call-name-id : i64 (ctfe-comptime-helper-call-name-id name-id)]
      (if (and
        (>= call-name-id 0)
        (not (= call-name-id name-id))
        (ctfe-comptime-syntax-helper-id? call-name-id)
        (tc-source-name-bound-exact-id? env call-name-id))
        (TcMaybeNameId.Some call-name-id)
        (TcMaybeNameId.No)))
    (TcMaybeNameId.No)))

;; Variant taking the already-interned `name-id`; reads the first-dot position
;; from id-keyed metadata instead of re-hashing `name`.
(define (tc-dotted-type-name-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (let
    [first-dot : i64 (tc-name-first-dot-id name-id)]
    (if (< first-dot 0)
      (ResultTcString.Ok name)
      (let
        [current-module-id : i64 (tc-context-module-id ctx)]
        (match (tc-source-dotted-alias-key
          ctx
          name
          name-id
          first-dot
          current-module-id)
          [(TcMaybeString.Some key) (ResultTcString.Ok key)]
          [(TcMaybeString.No)
            (match (tc-source-dotted-full-path-key-from-id
              ctx
              name
              name-id
              current-module-id)
              [(TcMaybeString.Some key) (ResultTcString.Ok key)]
              [(TcMaybeString.No)
                (ResultTcString.Err (tc-unresolved-dotted-name-message name))])])))))

(define (tc-dotted-resolved-key-id-or
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (let
    [module-id : i64 (tc-context-module-id ctx)]
    [alias-key-id : i64
      (tc-source-dotted-alias-key-cache-get module-id name-id)]
    (if (>= alias-key-id 0)
      alias-key-id
      (let
        [full-key-id : i64
          (tc-source-dotted-full-path-key-cache-get module-id name-id)]
        (if (>= full-key-id 0)
          full-key-id
          fallback)))))

(define (tc-dotted-type-name-lookup-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcNameLookup
  (match (tc-dotted-type-name-lookup-key-from-id ctx name name-id)
    [(ResultTcString.Ok key)
      (let
        [resolved-key-id : i64 (tc-dotted-resolved-key-id-or ctx name-id -1)]
        [key-id : i64
          (if (>= resolved-key-id 0)
            resolved-key-id
            (if (string.eq key name)
              name-id
              -1))]
        (if (>= key-id 0)
          (TcNameLookup.Ok key key-id)
          (TcNameLookup.Err
            "typecheck: resolved type name has no interned identity")))]
    [(ResultTcString.Err message) (TcNameLookup.Err message)]))

(define (tc-source-type-name-lookup-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (if (tc-source-slash-qualified-id? name name-id)
    (ResultTcString.Err (tc-source-slash-qualified-message name))
    (tc-dotted-type-name-lookup-key-from-id ctx name name-id)))

(define (tc-source-type-name-lookup-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcNameLookup
  (if (tc-source-slash-qualified-id? name name-id)
    (TcNameLookup.Err (tc-source-slash-qualified-message name))
    (tc-dotted-type-name-lookup-from-id ctx name name-id)))

(define (tc-enum-qualified-variant-lookup-name? [name : String]) : bool
  (>= (tc-name-first-dot (tc-qualified-name-base name)) 0))

(define (tc-enum-qualified-variant-lookup-name-id? [name-id : i64]) : bool
  (if (compiler-composite-triple-key-id? name-id)
    true
    (let
      [base-id : i64
        (if (tc-name-qualified-id? name-id)
          (tc-qualified-name-base-id name-id)
          name-id)]
      (and
        (>= base-id 0)
        (< base-id (intern-capacity))
        (>= (tc-name-first-dot-id base-id) 0)))))

(define (tc-enum-qualified-variant-lookup-handle
  [ctx : TcContext]
  [_name : String]
  [name-id : i64]) : option_i64.Option
  (match ctx
    [(TcContext _ _ registries _ module-id _ _)
      (let
        [registry-id : i64 (compiler-registries-identity registries)]
        [cached-handle : i64
          (tc-source-qualified-variant-handle-cache-get
            registry-id
            module-id
            name-id)]
        (if (>= cached-handle 0)
          (option_i64.Some cached-handle)
          (if (= cached-handle -1)
            option_i64.None
            (match (tc-enum-qualified-variant-lookup-key-id
              ctx
              name-id
              module-id)
              [(option_i64.Some key-id)
                (let
                  [resolved-handle : i64
                    (tc-source-qualified-variant-handle-cache-get
                      registry-id
                      module-id
                      name-id)]
                  (if (>= resolved-handle 0)
                    (option_i64.Some resolved-handle)
                    (compiler-registries-lookup-variant-key-id
                      registries
                      key-id)))]
              [(option_i64.None) option_i64.None]))))]))

(define (tc-enum-qualified-variant-lookup-key-id
  [ctx : TcContext]
  [name-id : i64]
  [module-id : i64]) : option_i64.Option
  (if (tc-enum-qualified-variant-lookup-name-id? name-id)
    (match ctx
      [(TcContext _ _ registries module _ _ _)
        (let
          [registry-id : i64 (compiler-registries-identity registries)]
          [cached : i64
            (tc-source-qualified-variant-key-cache-get
              registry-id
              module-id
              name-id)]
          (if (= cached -2)
            (let
              [structural : bool (>= name-id (intern-capacity))]
              [module-key-id : i64
                (if (and
                  (not structural)
                  (> (string.string-length module) 0)
                  (not (tc-name-qualified-id? name-id)))
                  (compiler-symbol-dotted-variant-key-id-in-module-or
                    name-id
                    module-id
                    -1)
                  -1)]
              [module-handle : i64
                (if (< module-key-id 0)
                  -1
                  (match (compiler-registries-lookup-variant-key-id
                    registries
                    module-key-id)
                    [(option_i64.Some handle) handle]
                    [(option_i64.None) -1]))]
              [fallback-key-id : i64
                (if structural
                  (compiler-symbol-name-id-key name-id)
                  (compiler-symbol-dotted-variant-key-id-in-module-or
                    name-id
                    (compiler-symbol-root-module-id)
                    -1))]
              [fallback-handle : i64
                (if (or (>= module-handle 0) (< fallback-key-id 0))
                  -1
                  (match (compiler-registries-lookup-variant-key-id
                    registries
                    fallback-key-id)
                    [(option_i64.Some handle) handle]
                    [(option_i64.None) -1]))]
              [resolved : i64
                (if (>= module-handle 0)
                  module-key-id
                  (if (>= fallback-handle 0)
                    fallback-key-id
                    -1))]
              [resolved-handle : i64
                (if (>= module-handle 0)
                  module-handle
                  fallback-handle)]
              (begin
                (tc-source-qualified-variant-key-cache-put!
                  registry-id
                  module-id
                  name-id
                  resolved
                  resolved-handle)
                (if (< resolved 0)
                  option_i64.None
                  (option_i64.Some resolved))))
            (if (< cached 0)
              option_i64.None
              (option_i64.Some cached))))])
    option_i64.None))

(define (tc-enum-qualified-variant-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [module-id : i64]) : ResultTcString
  (match (tc-enum-qualified-variant-lookup-key-id ctx name-id module-id)
    [(option_i64.Some key-id)
      (ResultTcString.Ok
        (if (compiler-composite-triple-key-id? key-id)
          (tc-nominal-name-id-display key-id)
          name))]
    [(option_i64.None) (ResultTcString.Err "")]))

(define (tc-source-name-lookup-key-with-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : ResultTcString
  ;; Intern `name` once; every metadata query below reads the id-keyed slots
  ;; instead of re-hashing the string. This is the hottest name-resolution
  ;; function, previously hashing each name 3-4x (slash-qualified?, first-dot,
  ;; leading-segment, bound-exact?). The already-interned `name-id` is threaded
  ;; from the caller (AST field or upstream intern) so this hot path no longer
  ;; re-interns the string; the public String wrappers below intern once.
  (if (tc-source-slash-qualified-id? name name-id)
    (ResultTcString.Err (tc-source-slash-qualified-message name))
    (let
      [first-dot : i64 (tc-name-first-dot-id name-id)]
      (if (< first-dot 0)
        (if (tc-source-name-bound-exact-id? env name-id)
          (ResultTcString.Ok name)
          (match (tc-current-module-source-lookup-key ctx env name name-id)
            [(TcMaybeString.Some key) (ResultTcString.Ok key)]
            [(TcMaybeString.No) (ResultTcString.Ok name)]))
        (if (and
          check-local-field
          (tc-source-leading-segment-wins-over-exact-from-id?
            env
            name
            name-id
            first-dot))
          (ResultTcString.Ok name)
          (match (tc-comptime-helper-qualified-lookup-key
            env
            name
            name-id
            first-dot)
            [(TcMaybeString.Some key) (ResultTcString.Ok key)]
            [(TcMaybeString.No)
              (let
                [current-module-id : i64 (tc-context-module-id ctx)]
                (match (tc-source-dotted-alias-key
                  ctx
                  name
                  name-id
                  first-dot
                  current-module-id)
                  [(TcMaybeString.Some key) (ResultTcString.Ok key)]
                  [(TcMaybeString.No)
                    (match (tc-enum-qualified-variant-lookup-key-from-id
                      ctx
                      name
                      name-id
                      current-module-id)
                      [(ResultTcString.Ok key) (ResultTcString.Ok key)]
                      [(ResultTcString.Err _)
                        (match (tc-source-dotted-full-path-key-from-id
                          ctx
                          name
                          name-id
                          current-module-id)
                          [(TcMaybeString.Some key) (ResultTcString.Ok key)]
                          [(TcMaybeString.No)
                            (if (tc-source-name-bound-exact-id? env name-id)
                              (ResultTcString.Ok name)
                              (ResultTcString.Err
                                (tc-unresolved-dotted-name-message name)))])])]))]))))))

;; id-returning variant of tc-source-name-lookup-key-with-field-check. Takes the
;; already-interned name-id (the AST stores it) so it does not (intern name),
;; and returns the resolved lookup name together with its id, so the hot tc-expr
;; Var path gets the lookup id without re-interning the returned String. For the
;; common bound-name case the result id is the passed name-id (zero interning);
;; qualified/dotted cases carry the ID already recorded by their resolver
;; caches instead of recovering identity from a generated display String.
(define (tc-source-name-lookup-key-with-field-check-source-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : TcNameLookup
  (if (tc-source-slash-qualified-id? name name-id)
    (TcNameLookup.Err (tc-source-slash-qualified-message name))
    (let
      [first-dot : i64 (tc-name-first-dot-id name-id)]
      (if (< first-dot 0)
        (if (tc-source-name-bound-exact-id? env name-id)
          (TcNameLookup.Ok name name-id)
          (match (tc-current-module-source-lookup-key-id ctx env name-id)
            [(TcMaybeNameId.Some key-id)
              (TcNameLookup.Ok (tc-env-key-display key-id) key-id)]
            [(TcMaybeNameId.No) (TcNameLookup.Ok name name-id)]))
        (if (and
          check-local-field
          (tc-source-leading-segment-wins-over-exact-from-id?
            env
            name
            name-id
            first-dot))
          (TcNameLookup.Ok name name-id)
          (match (tc-comptime-helper-qualified-lookup-key-id
            env
            name
            name-id
            first-dot)
            [(TcMaybeNameId.Some key-id)
              (TcNameLookup.Ok (intern-str key-id) key-id)]
            [(TcMaybeNameId.No)
              (let
                [current-module-id : i64 (tc-context-module-id ctx)]
                (match (tc-source-dotted-alias-key
                  ctx
                  name
                  name-id
                  first-dot
                  current-module-id)
                  [(TcMaybeString.Some key)
                    (TcNameLookup.Ok
                      key
                      (tc-source-dotted-alias-key-cache-get
                        current-module-id
                        name-id))]
                  [(TcMaybeString.No)
                    (match (tc-enum-qualified-variant-lookup-key-id
                      ctx
                      name-id
                      current-module-id)
                      [(option_i64.Some key-id)
                        (TcNameLookup.Ok
                          (if (compiler-composite-triple-key-id? key-id)
                            (tc-nominal-name-id-display key-id)
                            name)
                          key-id)]
                      [(option_i64.None)
                        (match (tc-source-dotted-full-path-key-from-id
                          ctx
                          name
                          name-id
                          current-module-id)
                          [(TcMaybeString.Some key)
                            (TcNameLookup.Ok
                              key
                              (tc-source-dotted-full-path-key-cache-get
                                current-module-id
                                name-id))]
                          [(TcMaybeString.No)
                            (match (tc-dotted-alias-flat-variant-key-id
                              ctx
                              env
                              name
                              name-id)
                              [(option_i64.Some flat-key-id)
                                (TcNameLookup.Ok name flat-key-id)]
                              [(option_i64.None)
                                (if (tc-source-name-bound-exact-id? env name-id)
                                  (TcNameLookup.Ok name name-id)
                                  (TcNameLookup.Err
                                    (tc-unresolved-dotted-name-message name)))])])])]))]))))))

(define (tc-source-name-lookup-key-with-field-check-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : TcNameLookup
  (if (tc-structural-local-name-id? name-id)
    (TcNameLookup.Ok (tc-hygiene-name-text-id name-id) name-id)
    (if (macro-hygiene-global-id? name-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or name-id name-id)]
        [module-id : i64 (macro-hygiene-global-module-id name-id)]
        [source-ctx : TcContext
          (if (compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id ctx (intern-str module-id) module-id))]
        (tc-source-name-lookup-key-with-field-check-source-lookup
          source-ctx
          env
          (intern-str source-id)
          source-id
          check-local-field))
      (tc-source-name-lookup-key-with-field-check-source-lookup
        ctx
        env
        name
        name-id
        check-local-field))))

(define (tc-qualified-access-target-module-id
  [ctx : TcContext]
  [qualifier-id : i64]) : i64
  (match ctx
    [(TcContext program _ _ _ current-module-id _ _)
      (match program
        [(AstProgram.Program decls-box)
          (macro-resolve-qualified-module-id
            (box-get decls-box)
            current-module-id
            qualifier-id)])]))

(define (tc-resolved-nominal-type-id [name-id : i64] [handle : i64]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (AstType.Enum name-id)
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (AstType.Struct name-id)
      (AstType.Var name-id))))

(define (tc-resolved-nominal-type-with-args-id
  [name-id : i64]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (ast-ty-enum-args name-id lifetimes)
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (ast-ty-struct-args name-id lifetimes)
      (ast-ty-var-args name-id lifetimes))))

(define (tc-nominal-name-id-display [name-id : i64]) : String
  (ast-nominal-name-id-display name-id))

(define (tc-current-module-owner-name-matches-id?
  [lookup-id : i64]
  [owner-id : i64]) : bool
  (and
    (>= lookup-id 0)
    (>= owner-id 0)
    (or
      (= owner-id lookup-id)
      (and
        (compiler-composite-pair-key-id? lookup-id)
        (< owner-id (intern-capacity))
        (not (tc-name-qualified-id? owner-id))
        (= owner-id (compiler-composite-pair-right-id lookup-id)))
      (and
        (< lookup-id (intern-capacity))
        (tc-name-qualified-id? lookup-id)
        (not (tc-name-qualified-id? owner-id))
        (= owner-id (tc-qualified-name-base-id lookup-id))))))

(define (tc-current-module-enum-id? [ctx : TcContext] [name-id : i64]) : bool
  (match (tc-context-enum-variants-id
    ctx
    name-id
    (tc-nominal-name-id-display name-id))
    [(ResultAstVariantDefList.Ok _) true]
    [(ResultAstVariantDefList.Err _) false]))

(define (tc-nominal-owner-id-or
  [ctx : TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (let
    [owner-id : i64
      (compiler-symbols-owner-id-at-index-or
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        fallback)]
    owner-id))

(define (tc-resolved-current-module-nominal-type-id
  [ctx : TcContext]
  [name-id : i64]
  [handle : i64]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(ResultTcString.Ok owner-name)
      (if (string.eq (tc-nominal-name-id-display name-id) owner-name)
        (tc-resolved-nominal-type-id name-id handle)
        (let
          [owner-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
          (if (tc-current-module-owner-name-matches-id? name-id owner-id)
            (tc-resolved-nominal-type-id name-id handle)
            (if (and
              (> (string.string-length (tc-context-module ctx)) 0)
              (tc-current-module-enum-id? ctx name-id))
              (AstType.Enum name-id)
              (tc-resolved-nominal-type-id owner-id handle)))))]
    [(ResultTcString.Err _)
      (if (and
        (> (string.string-length (tc-context-module ctx)) 0)
        (tc-current-module-enum-id? ctx name-id))
        (AstType.Enum name-id)
        (tc-resolved-nominal-type-id name-id handle))]))

(define (tc-resolved-current-module-nominal-type-with-args-id
  [ctx : TcContext]
  [name-id : i64]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(ResultTcString.Ok owner-name)
      (if (string.eq (tc-nominal-name-id-display name-id) owner-name)
        (tc-resolved-nominal-type-with-args-id name-id handle lifetimes)
        (let
          [owner-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
          (if (tc-current-module-owner-name-matches-id? name-id owner-id)
            (tc-resolved-nominal-type-with-args-id name-id handle lifetimes)
            (if (and
              (> (string.string-length (tc-context-module ctx)) 0)
              (tc-current-module-enum-id? ctx name-id))
              (ast-ty-enum-args name-id lifetimes)
              (tc-resolved-nominal-type-with-args-id owner-id handle lifetimes)))))]
    [(ResultTcString.Err _)
      (if (and
        (> (string.string-length (tc-context-module ctx)) 0)
        (tc-current-module-enum-id? ctx name-id))
        (ast-ty-enum-args name-id lifetimes)
        (tc-resolved-nominal-type-with-args-id name-id handle lifetimes))]))

(define (tc-qualified-lookup-owner-id [lookup-id : i64] [owner-id : i64]) : i64
  (if (and
    (>= lookup-id 0)
    (or
      (tc-name-qualified-id? lookup-id)
      (>= (tc-name-first-dot-id lookup-id) 0))
    (>= owner-id 0)
    (not (tc-name-qualified-id? owner-id)))
    lookup-id
    owner-id))

(define tc-nominal-owner-cache-handle : i64
  -1)
(define tc-nominal-owner-cache-name : String
  "")
(define tc-nominal-owner-cache-handle1 : i64
  -1)
(define tc-nominal-owner-cache-name1 : String
  "")
(define tc-nominal-owner-cache-handle2 : i64
  -1)
(define tc-nominal-owner-cache-name2 : String
  "")
(define tc-nominal-owner-cache-handle3 : i64
  -1)
(define tc-nominal-owner-cache-name3 : String
  "")
(define tc-nominal-owner-cache-handle4 : i64
  -1)
(define tc-nominal-owner-cache-name4 : String
  "")
(define tc-nominal-owner-cache-handle5 : i64
  -1)
(define tc-nominal-owner-cache-name5 : String
  "")
(define tc-nominal-owner-cache-handle6 : i64
  -1)
(define tc-nominal-owner-cache-name6 : String
  "")
(define tc-nominal-owner-cache-handle7 : i64
  -1)
(define tc-nominal-owner-cache-name7 : String
  "")
(define tc-resolve-type-name-cache-valid : bool
  false)
(define tc-resolve-type-name-cache-found : bool
  false)
(define tc-resolve-type-name-cache-key : i64
  -1)
(define tc-resolve-type-name-cache-handle : i64
  0)

;; The cached name strings are caller-provided and may live in a transient
;; scratch arena (per-function typecheck arenas): clear them to the
;; static empty string as well, so no slot can compare against freed memory
;; after the owning arena is destroyed.
(define (tc-nominal-owner-cache-reset!) : unit
  (begin
    (set! tc-nominal-owner-cache-handle -1)
    (set! tc-nominal-owner-cache-name "")
    (set! tc-nominal-owner-cache-handle1 -1)
    (set! tc-nominal-owner-cache-name1 "")
    (set! tc-nominal-owner-cache-handle2 -1)
    (set! tc-nominal-owner-cache-name2 "")
    (set! tc-nominal-owner-cache-handle3 -1)
    (set! tc-nominal-owner-cache-name3 "")
    (set! tc-nominal-owner-cache-handle4 -1)
    (set! tc-nominal-owner-cache-name4 "")
    (set! tc-nominal-owner-cache-handle5 -1)
    (set! tc-nominal-owner-cache-name5 "")
    (set! tc-nominal-owner-cache-handle6 -1)
    (set! tc-nominal-owner-cache-name6 "")
    (set! tc-nominal-owner-cache-handle7 -1)
    (set! tc-nominal-owner-cache-name7 "")
    (set! tc-resolve-type-name-cache-valid false)
    (set! tc-resolve-type-name-cache-key -1)))

(define (tc-resolve-type-name-cache-lookup [lookup-id : i64]) : TcTypeNameLookupCache
  (if (and
    tc-resolve-type-name-cache-valid
    (= tc-resolve-type-name-cache-key lookup-id))
    (if tc-resolve-type-name-cache-found
      (TcTypeNameLookupCache.Found tc-resolve-type-name-cache-handle)
      (TcTypeNameLookupCache.Missing))
    (TcTypeNameLookupCache.Miss)))

(define (tc-resolve-type-name-cache-store!
  [lookup-id : i64]
  [found : bool]
  [handle : i64]) : unit
  (begin
    (set! tc-resolve-type-name-cache-key lookup-id)
    (set! tc-resolve-type-name-cache-found found)
    (set! tc-resolve-type-name-cache-handle handle)
    (set! tc-resolve-type-name-cache-valid true)))

(define (tc-resolve-type-name-symbol-lookup-id
  [symbols : CompilerSymbols]
  [lookup-id : i64]) : i64
  (match (tc-resolve-type-name-cache-lookup lookup-id)
    [(TcTypeNameLookupCache.Found handle) handle]
    [(TcTypeNameLookupCache.Missing) (compiler-symbols-missing-handle)]
    [(TcTypeNameLookupCache.Miss)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-id-or
            symbols
            lookup-id
            (compiler-symbols-missing-handle))]
        (begin
          (tc-resolve-type-name-cache-store!
            lookup-id
            (compiler-symbols-handle-found? handle)
            (if (compiler-symbols-handle-found? handle)
              handle
              0))
          handle))]))

(define (tc-nominal-owner-cache-slot [handle : i64]) : i64
  (% (compiler-symbol-handle-index handle) 8))

(define (tc-nominal-owner-cache-entry-lookup
  [_ctx : TcContext]
  [handle : i64]
  [cached-handle : i64]
  [cached-name : String]) : ResultTcString
  (if (= cached-handle handle)
    (ResultTcString.Ok cached-name)
    (ResultTcString.Err "")))

(define (tc-nominal-owner-cache-lookup [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [slot : i64 (tc-nominal-owner-cache-slot handle)]
    (cond
      [(= slot 0)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle
          tc-nominal-owner-cache-name)]
      [(= slot 1)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle1
          tc-nominal-owner-cache-name1)]
      [(= slot 2)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle2
          tc-nominal-owner-cache-name2)]
      [(= slot 3)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle3
          tc-nominal-owner-cache-name3)]
      [(= slot 4)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle4
          tc-nominal-owner-cache-name4)]
      [(= slot 5)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle5
          tc-nominal-owner-cache-name5)]
      [(= slot 6)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle6
          tc-nominal-owner-cache-name6)]
      [else
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle7
          tc-nominal-owner-cache-name7)])))

(define (tc-nominal-owner-cache-store-if-safe! [handle : i64] [name : String]) : unit
  (if (tc-name-qualified? name)
    unit
    (let
      [slot : i64 (tc-nominal-owner-cache-slot handle)]
      (cond
        [(= slot 0)
          (begin
            (set! tc-nominal-owner-cache-handle handle)
            (set! tc-nominal-owner-cache-name name))]
        [(= slot 1)
          (begin
            (set! tc-nominal-owner-cache-handle1 handle)
            (set! tc-nominal-owner-cache-name1 name))]
        [(= slot 2)
          (begin
            (set! tc-nominal-owner-cache-handle2 handle)
            (set! tc-nominal-owner-cache-name2 name))]
        [(= slot 3)
          (begin
            (set! tc-nominal-owner-cache-handle3 handle)
            (set! tc-nominal-owner-cache-name3 name))]
        [(= slot 4)
          (begin
            (set! tc-nominal-owner-cache-handle4 handle)
            (set! tc-nominal-owner-cache-name4 name))]
        [(= slot 5)
          (begin
            (set! tc-nominal-owner-cache-handle5 handle)
            (set! tc-nominal-owner-cache-name5 name))]
        [(= slot 6)
          (begin
            (set! tc-nominal-owner-cache-handle6 handle)
            (set! tc-nominal-owner-cache-name6 name))]
        [else
          (begin
            (set! tc-nominal-owner-cache-handle7 handle)
            (set! tc-nominal-owner-cache-name7 name))]))))

(define (tc-nominal-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultTcString.Err "typecheck: nominal owner not found")]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Import decl-meta _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeStr _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeStrComptime _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeStrLzss _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeBin _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.Module next-module)
            (tc-nominal-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDecl.ModuleBody name body-box)
            (let
              [body : AstDeclList (box-get body-box)]
              [body-count : i64 (compiler-decl-list-index-count body)]
              (if (< target (+ index body-count))
                (tc-nominal-owner-name-list
                  body
                  target
                  index
                  (tc-env-key-name-text name))
                (tc-nominal-owner-name-list
                  rest
                  target
                  (+ index body-count)
                  module)))]
          [(AstDecl.Test _ _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.DefEnum decl-meta name _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (tc-env-key-name-text name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefEnumLifetimes decl-meta name _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (tc-env-key-name-text name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefStruct decl-meta name _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (tc-env-key-name-text name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (tc-env-key-name-text name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]))

(define (tc-nominal-owner-name-scan
  [program : AstProgram]
  [handle : i64]
  [index : i64]) : ResultTcString
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (match (tc-nominal-owner-name-list decls index 0 "")
          [(ResultTcString.Ok name)
            (begin
              (tc-nominal-owner-cache-store-if-safe! handle name)
              (ResultTcString.Ok name))]
          [(ResultTcString.Err message) (ResultTcString.Err message)]))]))

(define (tc-nominal-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (tc-nominal-owner-cache-lookup ctx handle)
    [(ResultTcString.Ok cached) (ResultTcString.Ok cached)]
    [(ResultTcString.Err _)
      (match ctx
        [(TcContext program symbols _ _ _ _ _)
          (match (compiler-symbols-owner-name-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(CompilerSomeString name)
              (begin
                (tc-nominal-owner-cache-store-if-safe! handle name)
                (ResultTcString.Ok name))]
            [(CompilerNoString)
              (tc-nominal-owner-name-scan
                program
                handle
                (compiler-symbol-handle-index handle))])])]))

(define (tc-nominal-owner-name-at-index [ctx : TcContext] [index : i64]) : ResultTcString
  (match (compiler-symbols-owner-name-at-index (tc-context-symbols ctx) index)
    [(CompilerSomeString name) (ResultTcString.Ok name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(AstProgram.Program decls-box)
          (tc-nominal-owner-name-list (box-get decls-box) index 0 "")])]))

(define (tc-context-with-owner-name-module [ctx : TcContext] [owner-id : i64]) : TcContext
  (if (tc-name-qualified-id? owner-id)
    (let
      [module-id : i64 (tc-qualified-name-module-id owner-id)]
      (tc-context-with-module-id ctx (intern-str module-id) module-id))
    (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))

(define (tc-context-with-nominal-owner-index-module
  [ctx : TcContext]
  [index : i64]) : TcContext
  (let
    [module-id : i64
      (compiler-symbols-owner-module-id-at-index-or
        (tc-context-symbols ctx)
        index
        (compiler-symbol-root-module-id))]
    (if (compiler-symbol-root-module-id? module-id)
      (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
      (tc-context-with-module-id ctx (intern-str module-id) module-id))))

;; Macro-generated modules already have an identity, but their dotted display
;; names are intentionally absent from the source interner. Resolve
;; `current.module.Type` from the context's module id and the parsed base id.
(define (tc-current-module-dotted-name-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : i64
  (let
    [module : String (tc-context-module ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    [module-len : i64 (string.string-length module)]
    [name-len : i64 (string.string-length name)]
    [base-start : i64 (+ module-len 1)]
    (if (and
      (> module-len 0)
      (> name-len base-start)
      (string.eq (string.substring name 0 module-len) module)
      (string.char-eq (string.string-ref name module-len) '.'))
      (let
        [base-id : i64 (intern-dotted-final-id name-id)]
        (if (< base-id 0)
          -1
          (tc-qualified-name-key-id module-id base-id)))
      -1)))

(define (tc-decl-nominal-name-id-matches? [decl : AstDecl] [name-id : i64]) : bool
  (match decl
    [(AstDecl.DefEnum decl-meta name _ _) (= name name-id)]
    [(AstDecl.DefEnumLifetimes decl-meta name _ _ _) (= name name-id)]
    [(AstDecl.DefStruct decl-meta name _ _ _) (= name name-id)]
    [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _) (= name name-id)]
    [_ false]))

(define (tc-symbols-unique-nominal-name-id?
  [symbols : CompilerSymbols]
  [name-id : i64]) : bool
  (let
    [decls : (Array AstDecl) (compiler-symbols-decls symbols)]
    [i : i64 0]
    [matches : i64 0]
    (begin
      (while (and (< i (array-length decls)) (< matches 2))
        (begin
          (if (tc-decl-nominal-name-id-matches? (array-ref decls i) name-id)
            (set! matches (+ matches 1))
            unit)
          (set! i (+ i 1))))
      (= matches 1))))

(define (tc-dotted-type-symbol-key-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : option_i64.Option
  (let
    [first-dot : i64 (tc-name-first-dot-id name-id)]
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      option_i64.None
      (let
        [alias-id : i64 (intern-leading-dot-id name-id)]
        [base-id : i64 (intern-dotted-tail-id name-id)]
        (if (or (< alias-id 0) (< base-id 0))
          option_i64.None
          (match (tc-context-program ctx)
            [(AstProgram.Program decls-box)
              (let
                [symbols : CompilerSymbols (tc-context-symbols ctx)]
                (match (tc-source-dotted-alias-target-id
                  (box-get decls-box)
                  (tc-context-module-id ctx)
                  alias-id)
                  [(TcMaybeNameId.Some target-module-id)
                    (let
                      [key-id : i64
                        (compiler-symbol-module-key-id-by-id
                          target-module-id
                          base-id)]
                      (match (compiler-symbols-lookup-type-id symbols key-id)
                        [(option_i64.Some _) (option_i64.Some key-id)]
                        [(option_i64.None)
                          (match (tc-lazy-import-unique-type-key-id
                            symbols
                            alias-id
                            base-id)
                            [(TcMaybeNameId.Some unique-key-id)
                              (option_i64.Some unique-key-id)]
                            [(TcMaybeNameId.No) option_i64.None])]))]
                  [(TcMaybeNameId.No)
                    (let
                      [key-id : i64
                        (compiler-symbol-module-key-id-by-id alias-id base-id)]
                      (match (compiler-symbols-lookup-type-id symbols key-id)
                        [(option_i64.Some _) (option_i64.Some key-id)]
                        [(option_i64.None)
                          (match (tc-lazy-import-unique-type-key-id
                            symbols
                            alias-id
                            base-id)
                            [(TcMaybeNameId.Some unique-key-id)
                              (option_i64.Some unique-key-id)]
                            [(TcMaybeNameId.No) option_i64.None])]))]))]))))))

(define (tc-dotted-unique-nominal-type-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : option_i64.Option
  (let
    [first-dot : i64 (tc-name-first-dot-id name-id)]
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      option_i64.None
      (let
        [base-id : i64 (intern-dotted-tail-id name-id)]
        [symbols : CompilerSymbols (tc-context-symbols ctx)]
        (if (or
          (< base-id 0)
          (not (tc-symbols-unique-nominal-name-id? symbols base-id)))
          option_i64.None
          (match (compiler-symbols-lookup-type-id symbols base-id)
            [(option_i64.Some _) (option_i64.Some base-id)]
            [(option_i64.None) option_i64.None]))))))

(define (tc-resolve-source-type-name
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : AstType
  (match ctx
    [(TcContext _ symbols _ module module-id _ _)
      (let
        [current-dotted-id : i64
          (tc-current-module-dotted-name-id ctx name name-id)]
        [direct-source-key : option_i64.Option
          (if (>= current-dotted-id 0)
            option_i64.None
            (tc-dotted-type-symbol-key-id ctx name name-id))]
        [source-result : ResultTcString
          (if (>= current-dotted-id 0)
            (ResultTcString.Ok (tc-nominal-name-id-display current-dotted-id))
            (match direct-source-key
              [(option_i64.Some _) (ResultTcString.Ok name)]
              [(option_i64.None)
                (tc-dotted-type-name-lookup-key-from-id ctx name name-id)]))]
        [source-name : String
          (match source-result
            [(ResultTcString.Ok key) key]
            [(ResultTcString.Err _) name])]
        [source-id : i64
          (if (>= current-dotted-id 0)
            current-dotted-id
            (match direct-source-key
              [(option_i64.Some key-id) key-id]
              [(option_i64.None)
                (match source-result
                  [(ResultTcString.Ok key)
                    (if (string.eq key name)
                      name-id
                      (tc-dotted-resolved-key-id-or ctx name-id name-id))]
                  [(ResultTcString.Err _)
                    (match (tc-dotted-unique-nominal-type-id ctx name name-id)
                      [(option_i64.Some unique-id) unique-id]
                      [(option_i64.None) name-id])])]))]
        [in-current-module : bool
          (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified-id? source-id)))]
        [lookup-id : i64
          (if in-current-module
            (tc-qualified-name-key-id module-id source-id)
            source-id)]
        [handle : i64
          (if (>= lookup-id 0)
            (tc-resolve-type-name-symbol-lookup-id symbols lookup-id)
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (if (and
            (tc-name-qualified-id? lookup-id)
            (= (tc-qualified-name-module-id lookup-id) module-id))
            (match (tc-stdlib-comptime-syntax-type-id lookup-id)
              [(AstMaybeType.Some syntax-ty) syntax-ty]
              [(AstMaybeType.No)
                (tc-resolved-current-module-nominal-type-id
                  ctx
                  lookup-id
                  handle)])
            (let
              [canonical-id : i64 (tc-nominal-owner-id-or ctx handle lookup-id)]
              (match (tc-stdlib-comptime-syntax-type-id canonical-id)
                [(AstMaybeType.Some syntax-ty) syntax-ty]
                [(AstMaybeType.No)
                  (tc-resolved-nominal-type-id
                    (tc-qualified-lookup-owner-id lookup-id canonical-id)
                    handle)])))
          (if (tc-name-qualified-id? source-id)
            (match (tc-context-enum-variants-id ctx source-id source-name)
              [(ResultAstVariantDefList.Ok _) (AstType.Enum source-id)]
              [(ResultAstVariantDefList.Err _)
                (cond
                  [(string.eq name "Expr") (AstType.Expr)]
                  [(string.eq name "ExprList") (AstType.ExprList)]
                  [(string.eq name "ExprClause") (tc-macro-expr-clause-type)]
                  [(string.eq name "ExprClauseList")
                    (tc-macro-expr-clause-list-type)]
                  [(string.eq name "ExprBindingClause")
                    (tc-macro-expr-binding-clause-type)]
                  [(string.eq name "ExprBindingClauseList")
                    (tc-macro-expr-binding-clause-list-type)]
                  [(string.eq name "Pattern") (tc-macro-pattern-type)]
                  [(string.eq name "PatternList") (tc-macro-pattern-list-type)]
                  [(string.eq name "MatchArm") (tc-macro-match-arm-type)]
                  [(string.eq name "MatchArmList")
                    (tc-macro-match-arm-list-type)]
                  [else (AstType.Var name-id)])])
            (cond
              [(string.eq name "Expr") (AstType.Expr)]
              [(string.eq name "ExprList") (AstType.ExprList)]
              [(string.eq name "ExprClause") (tc-macro-expr-clause-type)]
              [(string.eq name "ExprClauseList")
                (tc-macro-expr-clause-list-type)]
              [(string.eq name "ExprBindingClause")
                (tc-macro-expr-binding-clause-type)]
              [(string.eq name "ExprBindingClauseList")
                (tc-macro-expr-binding-clause-list-type)]
              [(string.eq name "Pattern") (tc-macro-pattern-type)]
              [(string.eq name "PatternList") (tc-macro-pattern-list-type)]
              [(string.eq name "MatchArm") (tc-macro-match-arm-type)]
              [(string.eq name "MatchArmList") (tc-macro-match-arm-list-type)]
              [else (AstType.Var name-id)]))))]))

(define (tc-resolve-type-name [ctx : TcContext] [name : String] [name-id : i64]) : AstType
  (if (macro-hygiene-global-id? name-id)
    (let
      [source-id : i64 (macro-hygiene-structural-source-name-id name-id)]
      [module-id : i64 (macro-hygiene-global-module-id name-id)]
      [source-ctx : TcContext
        (if (compiler-symbol-root-module-id? module-id)
          (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
          (tc-context-with-module-id ctx (intern-str module-id) module-id))]
      (tc-resolve-source-type-name source-ctx (intern-str source-id) source-id))
    (tc-resolve-source-type-name ctx name name-id)))

(define (tc-resolve-type [ctx : TcContext] [ty : AstType]) : AstType
  (if (tc-type-needs-resolution? ty)
    (match ty
      [(AstType.Func args ret)
        (ast-ty-func
          (tc-resolve-type-list ctx (box-get args))
          (tc-resolve-type ctx (ty-node-get ret)))]
      [(AstType.Tuple elems)
        (ast-ty-tuple (tc-resolve-type-list ctx (box-get elems)))]
      [(AstType.Array elem len)
        (ast-ty-array (tc-resolve-type ctx (ty-node-get elem)) len)]
      [(AstType.DynArray elem)
        (ast-ty-dyn-array (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Box elem) (ast-ty-box (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Ptr elem) (ast-ty-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.MutPtr elem)
        (ast-ty-mut-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Ref region inner)
        (ast-ty-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.MutRef region inner)
        (ast-ty-mut-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.Region region inner)
        (ast-ty-region region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.Consume inner)
        (ast-ty-consume (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.VarArgs name lifetimes)
        (tc-resolve-type-name-with-args
          ctx
          (tc-hygiene-name-text-id name)
          name
          (box-get lifetimes))]
      [(AstType.Var name)
        (tc-resolve-type-name ctx (tc-hygiene-name-text-id name) name)]
      [_ ty])
    ty))

(define (tc-resolve-source-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (match ctx
    [(TcContext _ symbols _ module module-id _ _)
      (let
        [current-dotted-id : i64
          (tc-current-module-dotted-name-id ctx name name-id)]
        [direct-source-key : option_i64.Option
          (if (>= current-dotted-id 0)
            option_i64.None
            (tc-dotted-type-symbol-key-id ctx name name-id))]
        [source-result : ResultTcString
          (if (>= current-dotted-id 0)
            (ResultTcString.Ok (tc-nominal-name-id-display current-dotted-id))
            (match direct-source-key
              [(option_i64.Some _) (ResultTcString.Ok name)]
              [(option_i64.None)
                (tc-dotted-type-name-lookup-key-from-id ctx name name-id)]))]
        [source-name : String
          (match source-result
            [(ResultTcString.Ok key) key]
            [(ResultTcString.Err _) name])]
        [source-id : i64
          (if (>= current-dotted-id 0)
            current-dotted-id
            (match direct-source-key
              [(option_i64.Some key-id) key-id]
              [(option_i64.None)
                (match source-result
                  [(ResultTcString.Ok key)
                    (if (string.eq key name)
                      name-id
                      (tc-dotted-resolved-key-id-or ctx name-id name-id))]
                  [(ResultTcString.Err _)
                    (match (tc-dotted-unique-nominal-type-id ctx name name-id)
                      [(option_i64.Some unique-id) unique-id]
                      [(option_i64.None) name-id])])]))]
        [in-current-module : bool
          (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified-id? source-id)))]
        [lookup-id : i64
          (if in-current-module
            (tc-qualified-name-key-id module-id source-id)
            source-id)]
        [handle : i64
          (if (>= lookup-id 0)
            (tc-resolve-type-name-symbol-lookup-id symbols lookup-id)
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (if (and
            (tc-name-qualified-id? lookup-id)
            (= (tc-qualified-name-module-id lookup-id) module-id))
            (match (tc-stdlib-comptime-syntax-type-id lookup-id)
              [(AstMaybeType.Some syntax-ty) syntax-ty]
              [(AstMaybeType.No)
                (tc-resolved-current-module-nominal-type-with-args-id
                  ctx
                  lookup-id
                  handle
                  lifetimes)])
            (let
              [canonical-id : i64 (tc-nominal-owner-id-or ctx handle lookup-id)]
              (match (tc-stdlib-comptime-syntax-type-id canonical-id)
                [(AstMaybeType.Some syntax-ty) syntax-ty]
                [(AstMaybeType.No)
                  (tc-resolved-nominal-type-with-args-id
                    (tc-qualified-lookup-owner-id lookup-id canonical-id)
                    handle
                    lifetimes)])))
          (if (tc-name-qualified-id? source-id)
            (match (tc-context-enum-variants-id ctx source-id source-name)
              [(ResultAstVariantDefList.Ok _)
                (ast-ty-enum-args source-id lifetimes)]
              [(ResultAstVariantDefList.Err _)
                (ast-ty-var-args name-id lifetimes)])
            (ast-ty-var-args name-id lifetimes))))]))

(define (tc-resolve-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (if (macro-hygiene-global-id? name-id)
    (let
      [source-id : i64 (macro-hygiene-structural-source-name-id name-id)]
      [module-id : i64 (macro-hygiene-global-module-id name-id)]
      [source-ctx : TcContext
        (if (compiler-symbol-root-module-id? module-id)
          (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
          (tc-context-with-module-id ctx (intern-str module-id) module-id))]
      (tc-resolve-source-type-name-with-args
        source-ctx
        (intern-str source-id)
        source-id
        lifetimes))
    (tc-resolve-source-type-name-with-args ctx name name-id lifetimes)))

(define (tc-source-str-value-policy-message) : String
  "typecheck: str is a borrowed string-slice referent; use (& lifetime str)")

(define (tc-source-str-mut-ref-policy-message) : String
  "typecheck: mutable references to str are reserved; use immutable (& lifetime str)")

(define (tc-source-bytes-value-policy-message) : String
  "typecheck: bytes is a borrowed byte-slice referent; use (& lifetime bytes) or (&mut lifetime bytes)")

(define (tc-source-type-policy-message [name : String]) : String
  (cond
    [(string.eq name "varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach"]
    [(string.eq name "Varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach"]
    [(string.eq name "Vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal"]
    [(string.eq name "vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal"]
    [(string.eq name "Mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal"]
    [(string.eq name "mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal"]
    [else
      (string.append
        "typecheck: unknown type "
        (string.append
          name
          "; TypeLisp has no source-level type parameters; use comptime-generated concrete declarations instead"))]))

(define (tc-nominal-lifetimes-from-decl [decl : AstDecl]) : ResultTcLifetimeList
  (match decl
    [(AstDecl.DefEnum decl-meta _ _ _)
      (ResultTcLifetimeList.Ok (ast-lifetime-list-new))]
    [(AstDecl.DefEnumLifetimes decl-meta _ lifetimes _ _)
      (ResultTcLifetimeList.Ok lifetimes)]
    [(AstDecl.DefStruct decl-meta _ _ _ _)
      (ResultTcLifetimeList.Ok (ast-lifetime-list-new))]
    [(AstDecl.DefStructLifetimes decl-meta _ lifetimes _ _ _)
      (ResultTcLifetimeList.Ok lifetimes)]
    [_ (ResultTcLifetimeList.Err "typecheck: nominal type not found")]))

(define (tc-nominal-decl-name-id-matches?
  [lookup-id : i64]
  [module-id : i64]
  [decl-id : i64]) : bool
  (or
    (= lookup-id decl-id)
    (and
      (tc-name-qualified-id? lookup-id)
      (= (tc-qualified-name-module-id lookup-id) module-id)
      (= (tc-qualified-name-base-id lookup-id) decl-id))))

(define (tc-program-nominal-lifetimes-from-decl
  [decl : AstDecl]
  [lookup-id : i64]
  [module-id : i64]) : ResultTcLifetimeList
  (match decl
    [(AstDecl.DefEnum decl-meta name _ _)
      (if (tc-nominal-decl-name-id-matches? lookup-id module-id name)
        (ResultTcLifetimeList.Ok (ast-lifetime-list-new))
        (ResultTcLifetimeList.Err "typecheck: nominal type not found"))]
    [(AstDecl.DefEnumLifetimes decl-meta name lifetimes _ _)
      (if (tc-nominal-decl-name-id-matches? lookup-id module-id name)
        (ResultTcLifetimeList.Ok lifetimes)
        (ResultTcLifetimeList.Err "typecheck: nominal type not found"))]
    [(AstDecl.DefStruct decl-meta name _ _ _)
      (if (tc-nominal-decl-name-id-matches? lookup-id module-id name)
        (ResultTcLifetimeList.Ok (ast-lifetime-list-new))
        (ResultTcLifetimeList.Err "typecheck: nominal type not found"))]
    [(AstDecl.DefStructLifetimes decl-meta name lifetimes _ _ _)
      (if (tc-nominal-decl-name-id-matches? lookup-id module-id name)
        (ResultTcLifetimeList.Ok lifetimes)
        (ResultTcLifetimeList.Err "typecheck: nominal type not found"))]
    [(AstDecl.Unsafe inner-box)
      (tc-program-nominal-lifetimes-from-decl
        (box-get inner-box)
        lookup-id
        module-id)]
    [_ (ResultTcLifetimeList.Err "typecheck: nominal type not found")]))

(define (tc-program-nominal-lifetimes-in-module
  [decls : AstDeclList]
  [lookup-id : i64]
  [module-id : i64]) : ResultTcLifetimeList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultTcLifetimeList.Err "typecheck: nominal type not found")]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module next-module)
          (tc-program-nominal-lifetimes-in-module rest lookup-id next-module)]
        [_
          (match (tc-program-nominal-lifetimes-from-decl
            decl
            lookup-id
            module-id)
            [(ResultTcLifetimeList.Ok lifetimes)
              (ResultTcLifetimeList.Ok lifetimes)]
            [(ResultTcLifetimeList.Err _)
              (tc-program-nominal-lifetimes-in-module rest lookup-id module-id)])])]))

(define (tc-program-nominal-lifetimes [program : AstProgram] [lookup-id : i64]) : ResultTcLifetimeList
  (match program
    [(AstProgram.Program decls-box)
      (tc-program-nominal-lifetimes-in-module (box-get decls-box) lookup-id -1)]))

(define (tc-nominal-lifetimes-id [ctx : TcContext] [name-id : i64]) : ResultTcLifetimeList
  (match ctx
    [(TcContext _ symbols _ _ _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-id-or
            symbols
            name-id
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-symbols-decl-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(ResultAstDecl.Ok decl) (tc-nominal-lifetimes-from-decl decl)]
            [(ResultAstDecl.Err message) (ResultTcLifetimeList.Err message)])
          (match (tc-program-nominal-lifetimes (tc-context-program ctx) name-id)
            [(ResultTcLifetimeList.Ok lifetimes)
              (ResultTcLifetimeList.Ok lifetimes)]
            [(ResultTcLifetimeList.Err message)
              (ResultTcLifetimeList.Err
                (str_cat.str-cat
                  message
                  ": "
                  (tc-nominal-name-id-display name-id)
                  "#"
                  (string.int->string name-id)))])))]))

(define (tc-nominal-lifetime-use-policy-ok
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : AstLifetimeList]) : ResultTcUnit
  (match (tc-nominal-lifetimes-id ctx name-id)
    [(ResultTcLifetimeList.Ok params)
      (if (= (tc-lifetime-list-count params) (tc-lifetime-list-count lifetimes))
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: nominal lifetime argument arity mismatch"))]
    [(ResultTcLifetimeList.Err message)
      (ResultTcUnit.Err
        (str_cat.str-cat
          message
          ": "
          (tc-nominal-name-id-display name-id)
          "#"
          (string.int->string name-id)))]))

(define (tc-bare-nominal-lifetime-policy-ok [ctx : TcContext] [name-id : i64]) : ResultTcUnit
  (match (tc-nominal-lifetimes-id ctx name-id)
    [(ResultTcLifetimeList.Ok params)
      (if (ast-lifetime-list-empty? (& params))
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: missing nominal lifetime arguments"))]
    [(ResultTcLifetimeList.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-type-list-policy-ok [ctx : TcContext] [types : AstTypeList]) : ResultTcUnit
  (tc-source-type-list-policy-ok-at ctx (& types) 0))

(define (tc-source-type-list-policy-ok-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (match (tc-source-type-policy-ok
      ctx
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      [(ResultTcUnit.Ok)
        (tc-source-type-list-policy-ok-at ctx types (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-source-elided-reference-policy-message) : String
  "typecheck: elided reference lifetime is only allowed in function signatures; write an explicit lifetime")

(define (tc-source-function-type-policy-ok
  [ctx : TcContext]
  [args : AstTypeList]
  [ret : AstType]) : ResultTcUnit
  (match (tc-elide-function-type args ret)
    [(ResultTcElidedType.Ok normalized)
      (match (struct-get normalized ty)
        [(AstType.Func normalized-args normalized-ret)
          (match (tc-source-type-list-policy-ok ctx (box-get normalized-args))
            [(ResultTcUnit.Ok)
              (tc-source-type-policy-ok ctx (ty-node-get normalized-ret))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [_
          (ResultTcUnit.Err
            "typecheck: internal lifetime-elision function type mismatch")])]
    [(ResultTcElidedType.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-type-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-type-unquote-marker? ty)
    ResultTcUnit.Ok
    (let
      [syntax-ok : ResultTcUnit
        (match ty
          [(AstType.Var name)
            (match (tc-source-type-name-lookup-key
              ctx
              (tc-env-key-name-text name)
              name)
              [(ResultTcString.Ok _) ResultTcUnit.Ok]
              [(ResultTcString.Err message) (ResultTcUnit.Err message)])]
          [(AstType.VarArgs name _)
            (match (tc-source-type-name-lookup-key
              ctx
              (tc-env-key-name-text name)
              name)
              [(ResultTcString.Ok _) ResultTcUnit.Ok]
              [(ResultTcString.Err message) (ResultTcUnit.Err message)])]
          [_ ResultTcUnit.Ok])]
      (match syntax-ok
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]
        [(ResultTcUnit.Ok)
          (match (tc-resolve-type ctx ty)
            [(AstType.Func args ret)
              (tc-source-function-type-policy-ok
                ctx
                (box-get args)
                (ty-node-get ret))]
            [(AstType.Tuple elems)
              (tc-source-type-list-policy-ok ctx (box-get elems))]
            [(AstType.Array elem _)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.DynArray elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Box elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Ptr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.MutPtr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Ref lifetime inner)
              (if (tc-elided-lifetime? lifetime)
                (ResultTcUnit.Err (tc-source-elided-reference-policy-message))
                (match (tc-resolve-type ctx (ty-node-get inner))
                  [(AstType.Str) ResultTcUnit.Ok]
                  [(AstType.Bytes) ResultTcUnit.Ok]
                  [_ (tc-source-type-policy-ok ctx (ty-node-get inner))]))]
            [(AstType.MutRef lifetime inner)
              (if (tc-elided-lifetime? lifetime)
                (ResultTcUnit.Err (tc-source-elided-reference-policy-message))
                (match (tc-resolve-type ctx (ty-node-get inner))
                  [(AstType.Str)
                    (ResultTcUnit.Err (tc-source-str-mut-ref-policy-message))]
                  [(AstType.Bytes) ResultTcUnit.Ok]
                  [_ (tc-source-type-policy-ok ctx (ty-node-get inner))]))]
            [(AstType.Region _ inner)
              (tc-source-type-policy-ok ctx (ty-node-get inner))]
            [(AstType.Str)
              (ResultTcUnit.Err (tc-source-str-value-policy-message))]
            [(AstType.Bytes)
              (ResultTcUnit.Err (tc-source-bytes-value-policy-message))]
            [(AstType.Enum name) (tc-bare-nominal-lifetime-policy-ok ctx name)]
            [(AstType.Struct name)
              (tc-bare-nominal-lifetime-policy-ok ctx name)]
            [(AstType.EnumArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok ctx name (box-get lifetimes))]
            [(AstType.StructArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok ctx name (box-get lifetimes))]
            [(AstType.VarArgs name _)
              (ResultTcUnit.Err
                (tc-source-type-policy-message
                  (tc-nominal-name-id-display name)))]
            [(AstType.Var name)
              (if (or
                (= name cbi.compiler-builtin-id-fix-ExprClause)
                (= name cbi.compiler-builtin-id-fix-ExprClauseList)
                (= name cbi.compiler-builtin-id-fix-ExprBindingClause)
                (= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
                (= name cbi.compiler-builtin-id-fix-Pattern)
                (= name cbi.compiler-builtin-id-fix-PatternList)
                (= name cbi.compiler-builtin-id-fix-MatchArm)
                (= name cbi.compiler-builtin-id-fix-MatchArmList))
                ResultTcUnit.Ok
                (ResultTcUnit.Err
                  (tc-source-type-policy-message
                    (tc-nominal-name-id-display name))))]
            [_ ResultTcUnit.Ok])]))))

(define (tc-source-maybe-type-policy-ok
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]) : ResultTcUnit
  (match maybe-ty
    [(AstMaybeType.No) ResultTcUnit.Ok]
    [(AstMaybeType.Some ty) (tc-source-type-policy-ok ctx ty)]))

(define (tc-source-param-list-policy-ok
  [ctx : TcContext]
  [params : AstParamList]) : ResultTcUnit
  (tc-source-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-param-list-len params))
    ResultTcUnit.Ok
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (tc-source-param-list-policy-ok-at ctx params (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-macro-param-list-policy-ok
  [ctx : TcContext]
  [params : AstMacroParamList]) : ResultTcUnit
  (tc-source-macro-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-macro-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params AstMacroParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-macro-param-list-len params))
    ResultTcUnit.Ok
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty variadic _)
        (if (tc-macro-type-param-kind? ty)
          (if variadic
            (ResultTcUnit.Err
              "typecheck: type macro operand cannot be variadic")
            (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))
          (if (tc-macro-module-param-kind? ty)
            (if variadic
              (ResultTcUnit.Err
                "typecheck: Module macro operand cannot be variadic")
              (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))
            (match (tc-source-type-policy-ok ctx ty)
              [(ResultTcUnit.Ok)
                (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))])))

(define (tc-macro-result-name-id?
  [ty : AstType]
  [upper-id : i64]
  [lower-id : i64]) : bool
  (match ty
    [(AstType.Var name) (or (= name upper-id) (= name lower-id))]
    [_ false]))

(define (tc-macro-result-module? [ty : AstType]) : bool
  (tc-macro-result-name-id?
    ty
    cbi.compiler-builtin-id-fix-Module
    cbi.compiler-builtin-id-fix-module))

(define (tc-macro-result-decls? [ty : AstType]) : bool
  (tc-macro-result-name-id?
    ty
    cbi.compiler-builtin-id-fix-Decls
    cbi.compiler-builtin-id-fix-decls))

(define (tc-macro-result-decl-emitting? [ty : AstType]) : bool
  (or (tc-macro-result-module? ty) (tc-macro-result-decls? ty)))

(define (tc-source-macro-result-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-macro-result-decl-emitting? ty)
    ResultTcUnit.Ok
    (tc-source-type-policy-ok ctx ty)))

(define (tc-source-field-list-policy-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-policy-ok-at ctx (& fields) 0))

(define (tc-source-field-list-policy-ok-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (tc-source-field-list-policy-ok-at ctx fields (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-struct-cleanup-repr-c-message [struct-name : String]) : String
  (str_cat.str-cat
    "typecheck: cleanup-owning struct "
    struct-name
    " cannot use repr c"))

(define (tc-source-variant-list-policy-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-policy-ok-at ctx (& variants) 0))

(define (tc-source-variant-list-policy-ok-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (match (tc-source-type-list-policy-ok ctx fields)
          [(ResultTcUnit.Ok)
            (tc-source-variant-list-policy-ok-at ctx variants (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-decl-lifetime-name-allowed? [params : AstLifetimeList] [name : i64]) : bool
  (or
    (string.eq (tc-env-key-name-text name) "program")
    (tc-lifetime-list-contains params name)))

(define (tc-decl-lifetime-id-list-all-in?
  [lifetimes : TcNameIdList]
  [params : AstLifetimeList]) : bool
  (match lifetimes
    [(TcNameIdList.Nil) true]
    [(TcNameIdList.Cons lifetime rest)
      (and
        (tc-decl-lifetime-name-allowed? params lifetime)
        (tc-decl-lifetime-id-list-all-in? (box-get rest) params))]))

(define (tc-source-type-decl-lifetimes-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))]
    (if (tc-decl-lifetime-id-list-all-in? lifetimes params)
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: unknown aggregate lifetime parameter"))))

(define (tc-source-field-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-lifetimes-policy-ok-at ctx params (& fields) 0))

(define (tc-source-field-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (match (tc-source-type-decl-lifetimes-ok ctx params ty)
              [(ResultTcUnit.Ok)
                (tc-source-field-list-lifetimes-policy-ok-at
                  ctx
                  params
                  fields
                  (+ index 1))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-type-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : AstTypeList]) : ResultTcUnit
  (tc-source-type-list-lifetimes-policy-ok-at ctx params (& types) 0))

(define (tc-source-type-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (let
      [head : AstType
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (tc-source-type-policy-ok ctx head)
        [(ResultTcUnit.Ok)
          (match (tc-source-type-decl-lifetimes-ok ctx params head)
            [(ResultTcUnit.Ok)
              (tc-source-type-list-lifetimes-policy-ok-at
                ctx
                params
                types
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-variant-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-lifetimes-policy-ok-at ctx params (& variants) 0))

(define (tc-source-variant-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (match (tc-source-type-list-lifetimes-policy-ok ctx params fields)
          [(ResultTcUnit.Ok)
            (tc-source-variant-list-lifetimes-policy-ok-at
              ctx
              params
              variants
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-default-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name-id : i64]) : ResultTcUnit
  (let
    [qualified-id : i64
      (tc-module-name-id-by-id (tc-context-module-id ctx) name-id)]
    (tc-inline-aggregate-nominal-finite-ok
      ctx
      (tc-nominal-name-id-display qualified-id)
      qualified-id
      TcStringList.Nil)))

(define (tc-source-default-struct-layout-finite-ok
  [ctx : TcContext]
  [name-id : i64]
  [repr : AstStructRepr]) : ResultTcUnit
  (if (ast-struct-repr-c? repr)
    ResultTcUnit.Ok
    (tc-source-default-aggregate-layout-finite-ok ctx name-id)))

(define (tc-source-pattern-list-policy-ok
  [ctx : TcContext]
  [patterns : AstPatternList]) : ResultTcUnit
  (tc-source-pattern-list-policy-ok-at ctx (& patterns) 0))

(define (tc-source-pattern-list-policy-ok-at
  [ctx : TcContext]
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get patterns len))
    ResultTcUnit.Ok
    (match (tc-source-pattern-policy-ok
      ctx
      (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      [(ResultTcUnit.Ok)
        (tc-source-pattern-list-policy-ok-at ctx patterns (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-source-pattern-policy-ok [ctx : TcContext] [pattern : AstPattern]) : ResultTcUnit
  (match pattern
    [(AstPattern.Var _ maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [(AstPattern.Variant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [_ ResultTcUnit.Ok]))

(define (tc-source-match-arm-list-policy-ok
  [ctx : TcContext]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-source-match-arm-list-policy-ok-at ctx (& arms) 0))

(define (tc-source-match-arm-list-policy-ok-at
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-source-pattern-policy-ok ctx pattern)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx body)
                [(ResultTcUnit.Ok)
                  (tc-source-match-arm-list-policy-ok-at ctx arms (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-let-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : ResultTcUnit
  (tc-source-let-binding-list-policy-ok-at ctx (& bindings) 0))

(define (tc-source-let-binding-list-policy-ok-at
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx init)
                [(ResultTcUnit.Ok)
                  (tc-source-let-binding-list-policy-ok-at
                    ctx
                    bindings
                    (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-resource-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (tc-source-resource-binding-list-policy-ok-at ctx (& bindings) 0))

(define (tc-source-resource-binding-list-policy-ok-at
  [ctx : TcContext]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-source-expr-policy-ok ctx init)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx cleanup)
                [(ResultTcUnit.Ok)
                  (tc-source-resource-binding-list-policy-ok-at
                    ctx
                    bindings
                    (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-expr-list-policy-ok [ctx : TcContext] [exprs : AstExprList]) : ResultTcUnit
  (tc-source-expr-list-policy-ok-at ctx (& exprs) 0))

(define (tc-source-expr-list-policy-ok-at
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-source-expr-policy-ok ctx expr)
        [(ResultTcUnit.Ok)
          (tc-source-expr-list-policy-ok-at ctx exprs (+ index 1))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-expr-pair-policy-ok
  [ctx : TcContext]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-policy-ok ctx left)
    [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-expr-triple-policy-ok
  [ctx : TcContext]
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-pair-policy-ok ctx first second)
    [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx third)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-broadcast-scope-message) : String
  "typecheck: spmd-broadcast is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-shuffle-scope-message) : String
  "typecheck: spmd-shuffle is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-lane-scope-message [name : String]) : String
  (string.append
    (string.append "typecheck: " name)
    " is only valid inside a foreach body or spmd-reduce value expression"))

(define (tc-source-expr-list-spmd-broadcast-scope-ok
  [exprs : AstExprList]
  [allow : bool]) : ResultTcUnit
  (tc-source-expr-list-spmd-broadcast-scope-ok-at (& exprs) 0 allow))

(define (tc-source-expr-list-spmd-broadcast-scope-ok-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [allow : bool]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-source-expr-spmd-broadcast-scope-ok expr allow)
        [(ResultTcUnit.Ok)
          (tc-source-expr-list-spmd-broadcast-scope-ok-at
            exprs
            (+ index 1)
            allow)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-expr-pair-spmd-broadcast-scope-ok
  [left : AstExpr]
  [right : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-spmd-broadcast-scope-ok left allow)
    [(ResultTcUnit.Ok) (tc-source-expr-spmd-broadcast-scope-ok right allow)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-expr-triple-spmd-broadcast-scope-ok
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-pair-spmd-broadcast-scope-ok first second allow)
    [(ResultTcUnit.Ok) (tc-source-expr-spmd-broadcast-scope-ok third allow)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok
  [bindings : AstLetBindingList]
  [allow : bool]) : ResultTcUnit
  (tc-source-let-binding-list-spmd-broadcast-scope-ok-at (& bindings) allow 0))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
  [bindings : (& bindings AstLetBindingList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-source-expr-spmd-broadcast-scope-ok init allow)
            [(ResultTcUnit.Ok)
              (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
                bindings
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok
  [bindings : AstResourceBindingList]
  [allow : bool]) : ResultTcUnit
  (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
    (& bindings)
    allow
    0))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
  [bindings : (& bindings AstResourceBindingList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-source-expr-pair-spmd-broadcast-scope-ok
            init
            cleanup
            allow)
            [(ResultTcUnit.Ok)
              (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
                bindings
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok
  [arms : AstMatchArmList]
  [allow : bool]) : ResultTcUnit
  (tc-source-match-arm-list-spmd-broadcast-scope-ok-at (& arms) allow 0))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
  [arms : (& arms AstMatchArmList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-source-expr-spmd-broadcast-scope-ok body allow)
            [(ResultTcUnit.Ok)
              (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
                arms
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-expr-spmd-broadcast-scope-ok [expr : AstExpr] [allow : bool]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok left right allow))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok func allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          cond
          then-branch
          else-branch
          allow))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-spmd-broadcast-scope-ok
              bindings
              allow)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok body allow)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-source-expr-spmd-broadcast-scope-ok body false))])]
    [(AstExpr.Tuple exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-spmd-broadcast-scope-ok tuple allow))]
    [(AstExpr.Array exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.DynArray exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-spmd-broadcast-scope-ok len allow))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array index allow))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok array index value allow))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [live : AstExpr (ast-node-get live-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok array live index allow))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array value allow))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok str index allow))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok cond body allow))]
    [(AstExpr.Begin exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.Unsafe exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-spmd-broadcast-scope-ok place allow))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-spmd-broadcast-scope-ok scrutinee allow)
              [(ResultTcUnit.Ok)
                (tc-source-match-arm-list-spmd-broadcast-scope-ok arms allow)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-pair-spmd-broadcast-scope-ok start end false)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok body true)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok value true)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-spmd-broadcast-scope-ok value false)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-spmd-broadcast-scope-ok body true)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ResultTcUnit.Err (tc-spmd-broadcast-scope-message)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ResultTcUnit.Err (tc-spmd-shuffle-scope-message)))]
    [(AstExpr.SpmdProgramIndex)
      (if allow
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-spmd-lane-scope-message "program-index")))]
    [(AstExpr.SpmdProgramCount)
      (if allow
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-spmd-lane-scope-message "program-count")))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-spmd-broadcast-scope-ok receiver allow))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok receiver value allow))]
    [(AstExpr.WithRegion _ body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok scratch allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithScratch body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok arena allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-source-resource-binding-list-spmd-broadcast-scope-ok
            bindings
            allow)
            [(ResultTcUnit.Ok)
              (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok inner value allow))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Quote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BracketClause items)
      (tc-source-expr-list-spmd-broadcast-scope-ok items allow)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrAddrOf inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr value allow))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr offset allow))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-spmd-broadcast-scope-ok str allow))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr len allow))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-spmd-broadcast-scope-ok array allow))]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-spmd-broadcast-scope-ok index allow))]
    [(AstExpr.Syscall args)
      (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
    [_ ResultTcUnit.Ok]))

(define (tc-source-lambda-signature-policy-ok
  [ctx : TcContext]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]) : ResultTcUnit
  (match maybe-ret
    [(AstMaybeType.Some ret)
      (match (tc-elide-function-signature params ret)
        [(ResultTcElidedSignature.Ok signature)
          (match (tc-source-param-list-policy-ok
            ctx
            (struct-get signature params))
            [(ResultTcUnit.Ok)
              (tc-source-type-policy-ok ctx (struct-get signature ret))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
    [(AstMaybeType.No)
      (match (tc-elide-input-params-at (& params) 0 0 (ast-param-list-new))
        [(ResultTcElidedParams.Ok inputs)
          (tc-source-param-list-policy-ok ctx (struct-get inputs params))]
        [(ResultTcElidedParams.Err message) (ResultTcUnit.Err message)])]))

(define (tc-source-expr-policy-ok [ctx : TcContext] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-policy-ok ctx left right))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-policy-ok ctx func)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx args)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.BracketClause items) (tc-source-expr-list-policy-ok ctx items)]
    [(AstExpr.TypeLiteral ty) (tc-source-type-policy-ok ctx ty)]
    [(AstExpr.Init maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (tc-source-expr-triple-policy-ok ctx cond then-branch else-branch))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-policy-ok ctx bindings)
              [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-lambda-signature-policy-ok ctx params maybe-ret)
              [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Tuple exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-policy-ok ctx tuple))]
    [(AstExpr.Array exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.DynArray exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.MakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-source-type-policy-ok ctx elem-ty)
          [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx len)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx array index))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-policy-ok ctx array index value))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [live : AstExpr (ast-node-get live-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-triple-policy-ok ctx array live index))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx array value))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx str index))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-policy-ok ctx cond body))]
    [(AstExpr.Begin exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.Unsafe exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-policy-ok ctx value))]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-policy-ok ctx place))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx inner value))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-policy-ok ctx scrutinee)
              [(ResultTcUnit.Ok) (tc-source-match-arm-list-policy-ok ctx arms)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (tc-source-expr-triple-policy-ok ctx start end body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-triple-policy-ok ctx start end init)
                  [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx value)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-type-policy-ok ctx prefix-ty)
                  [(ResultTcUnit.Ok)
                    (match (tc-source-expr-triple-policy-ok ctx start end init)
                      [(ResultTcUnit.Ok)
                        (match (tc-source-expr-policy-ok ctx value)
                          [(ResultTcUnit.Ok)
                            (tc-source-expr-policy-ok ctx body)]
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (tc-source-expr-pair-policy-ok ctx value lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (tc-source-expr-pair-policy-ok ctx value lane))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-policy-ok ctx receiver))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx receiver value))]
    [(AstExpr.WithRegion _ body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-policy-ok ctx scratch)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithScratch body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-policy-ok ctx arena)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-source-resource-binding-list-policy-ok ctx bindings)
            [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote _) ResultTcUnit.Ok]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-policy-ok ctx place))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx ptr value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-policy-ok ctx ptr offset))]
    [(AstExpr.PtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-source-expr-policy-ok ctx ptr)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExpr.IntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-source-expr-policy-ok ctx value)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-policy-ok ctx str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-policy-ok ctx ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-policy-ok ctx array))]
    [(AstExpr.BinaryData _) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgc) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgv) ResultTcUnit.Ok]
    [(AstExpr.ProgramEnvp) ResultTcUnit.Ok]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-policy-ok ctx index))]
    [(AstExpr.Syscall args) (tc-source-expr-list-policy-ok ctx args)]
    [_ ResultTcUnit.Ok]))

(define (tc-source-decl-policy-ok [ctx : TcContext] [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDecl.Def decl-meta _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
          [(ResultTcUnit.Ok)
            (if (tc-maybe-type-contains-reference? maybe-ty)
              (ResultTcUnit.Err
                "typecheck: storing references in top-level values requires lifetime support")
              (match (tc-source-expr-policy-ok ctx expr)
                [(ResultTcUnit.Ok)
                  (tc-source-expr-spmd-broadcast-scope-ok expr false)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefFn decl-meta _ params ret body-box _)
      (match (tc-elide-function-signature params ret)
        [(ResultTcElidedSignature.Ok signature)
          (let
            [signature-params : AstParamList (struct-get signature params)]
            [signature-ret : AstType (struct-get signature ret)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-param-list-policy-ok ctx signature-params)
              [(ResultTcUnit.Ok)
                (match (tc-source-type-policy-ok ctx signature-ret)
                  [(ResultTcUnit.Ok)
                    (match (tc-reference-return-policy-ok
                      ctx
                      signature-params
                      signature-ret)
                      [(ResultTcUnit.Ok)
                        (match (tc-source-expr-policy-ok ctx body)
                          [(ResultTcUnit.Ok)
                            (tc-source-expr-spmd-broadcast-scope-ok body false)]
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
        [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefMacro decl-meta _ params ret body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-source-macro-param-list-policy-ok ctx params)
          [(ResultTcUnit.Ok)
            (match (tc-source-macro-result-policy-ok ctx ret)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-policy-ok ctx body)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-spmd-broadcast-scope-ok body false)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.Extern decl-meta _ _ _ ty) (tc-source-type-policy-ok ctx ty)]
    [(AstDecl.DefEnum decl-meta name _ variants)
      (match (tc-source-variant-list-policy-ok ctx variants)
        [(ResultTcUnit.Ok)
          (tc-source-default-aggregate-layout-finite-ok ctx name)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefEnumLifetimes decl-meta name lifetimes _ variants)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
        (match (tc-source-variant-list-lifetimes-policy-ok
          ctx
          lifetimes
          variants)
          [(ResultTcUnit.Ok)
            (tc-source-default-aggregate-layout-finite-ok ctx name)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefStruct decl-meta name repr cleanup fields)
      (match (tc-source-field-list-policy-ok ctx fields)
        [(ResultTcUnit.Ok)
          (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
            (ResultTcUnit.Err
              (tc-struct-cleanup-repr-c-message
                (compiler-symbol-module-key
                  (tc-context-module ctx)
                  (tc-env-key-name-text name))))
            (tc-source-default-struct-layout-finite-ok ctx name repr))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefStructLifetimes decl-meta name lifetimes repr cleanup fields)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
        (match (tc-source-field-list-lifetimes-policy-ok ctx lifetimes fields)
          [(ResultTcUnit.Ok)
            (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
              (ResultTcUnit.Err
                (tc-struct-cleanup-repr-c-message
                  (compiler-symbol-module-key
                    (tc-context-module ctx)
                    (tc-env-key-name-text name))))
              (tc-source-default-struct-layout-finite-ok ctx name repr))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefDispatch decl-meta _ variants)
      (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
        (ResultTcUnit.Err
          "typecheck: defdispatch requires exactly one scalar variant")
        (if (tc-dispatch-variant-list-duplicate-isa? variants)
          (ResultTcUnit.Err "typecheck: duplicate defdispatch ISA variant")
          ResultTcUnit.Ok))]
    [(AstDecl.IncludeStr _ _)
      (ResultTcUnit.Err
        "typecheck: include-str must be expanded by compiler loader")]
    [(AstDecl.IncludeStrComptime _ _)
      (ResultTcUnit.Err
        "typecheck: include-str-comptime must be expanded by compiler loader")]
    [(AstDecl.IncludeStrLzss _ _)
      (ResultTcUnit.Err
        "typecheck: include-str-lzss must be expanded by compiler loader")]
    [(AstDecl.IncludeBin _ _)
      (ResultTcUnit.Err
        "typecheck: include-bin must be expanded by compiler loader")]
    [(AstDecl.Import decl-meta _) ResultTcUnit.Ok]
    [(AstDecl.Module _) ResultTcUnit.Ok]
    ;; Module bodies are traversed by the declaration-list diagnostic adapter,
    ;; which retains their nested list origin and owning path.
    [(AstDecl.ModuleBody _ _) ResultTcUnit.Ok]
    [(AstDecl.Test _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-policy-ok ctx body))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-source-decl-policy-ok ctx inner))]))

(defenum ResultTcSourcePolicyDiagnostic
  (Ok)
  (Err (Box CompilerDiagnostic)))

(define (tc-source-decl-shape-origin-message? [message : String]) : bool
  (or
    (string.eq
      message
      "typecheck: defdispatch requires exactly one scalar variant")
    (string.eq message "typecheck: duplicate defdispatch ISA variant")
    (string.eq message "typecheck: duplicate lifetime parameter")
    (string.contains message " cannot use repr c")))

(define (tc-source-decl-list-policy-diagnostic-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [fallback-path : String]
  [module-id : i64]) : ResultTcSourcePolicyDiagnostic
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) ResultTcSourcePolicyDiagnostic.Ok]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) fallback-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        (match decl
          [(AstDecl.Module next-module)
            (tc-source-decl-list-policy-diagnostic-in-module
              ctx
              rest
              rest-paths
              fallback-path
              next-module)]
          [(AstDecl.ModuleBody target-module body-box)
            (match (tc-source-decl-list-policy-diagnostic-in-module
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text target-module)
                target-module)
              (box-get body-box)
              (ast-decl-path-list-new)
              decl-path
              target-module)
              [(ResultTcSourcePolicyDiagnostic.Ok)
                (tc-source-decl-list-policy-diagnostic-in-module
                  ctx
                  rest
                  rest-paths
                  fallback-path
                  module-id)]
              [(ResultTcSourcePolicyDiagnostic.Err diag)
                (ResultTcSourcePolicyDiagnostic.Err diag)])]
          [_
            (match (tc-source-decl-policy-ok
              (tc-context-with-module-id
                ctx
                (if (compiler-symbol-root-module-id? module-id)
                  ""
                  (tc-env-key-name-text module-id))
                module-id)
              decl)
              [(ResultTcUnit.Ok)
                (tc-source-decl-list-policy-diagnostic-in-module
                  ctx
                  rest
                  rest-paths
                  fallback-path
                  module-id)]
              [(ResultTcUnit.Err message)
                (ResultTcSourcePolicyDiagnostic.Err
                  (box
                    (if (tc-source-decl-shape-origin-message? message)
                      (tc-typecheck-diag-with-path
                        (& decls)
                        decl
                        decl-path
                        message)
                      (tc-diag-at-start message))))])]))]))

(define (tc-program-source-types-policy-ok
  [ctx : TcContext]
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultTcSourcePolicyDiagnostic
  (begin
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (tc-source-decl-list-policy-diagnostic-in-module
            ctx
            decls
            paths
            ""
            (compiler-symbol-root-module-id)))])))

(define (tc-type-list-eq [a : AstTypeList] [b : AstTypeList]) : bool
  (and
    (= (ast-type-list-len (& a)) (ast-type-list-len (& b)))
    (tc-type-list-eq-at? (& a) (& b) 0)))

(define (tc-type-list-eq-at?
  [a : (& a AstTypeList)]
  [b : (& b AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len a))
    true
    (and
      (tc-type-eq
        (ty-node-get (ast-type-list-get a index (ast-type-id-fallback)))
        (ty-node-get (ast-type-list-get b index (ast-type-id-fallback))))
      (tc-type-list-eq-at? a b (+ index 1)))))

(define (tc-nominal-name-id-eq? [a : i64] [b : i64]) : bool
  (= (compiler-symbol-name-id-key a) (compiler-symbol-name-id-key b)))

(define (tc-type-eq-core [a : AstType] [b : AstType]) : bool
  (match a
    [(AstType.I64)
      (match b
        [(AstType.I64) true]
        [_ false])]
    [(AstType.I32)
      (match b
        [(AstType.I32) true]
        [_ false])]
    [(AstType.I16)
      (match b
        [(AstType.I16) true]
        [_ false])]
    [(AstType.I8)
      (match b
        [(AstType.I8) true]
        [_ false])]
    [(AstType.U64)
      (match b
        [(AstType.U64) true]
        [_ false])]
    [(AstType.U32)
      (match b
        [(AstType.U32) true]
        [_ false])]
    [(AstType.U16)
      (match b
        [(AstType.U16) true]
        [_ false])]
    [(AstType.U8)
      (match b
        [(AstType.U8) true]
        [_ false])]
    [(AstType.F64)
      (match b
        [(AstType.F64) true]
        [_ false])]
    [(AstType.F32)
      (match b
        [(AstType.F32) true]
        [_ false])]
    [(AstType.Bool)
      (match b
        [(AstType.Bool) true]
        [_ false])]
    [(AstType.Char)
      (match b
        [(AstType.Char) true]
        [_ false])]
    [(AstType.String)
      (match b
        [(AstType.String) true]
        [_ false])]
    [(AstType.Str)
      (match b
        [(AstType.Str) true]
        [_ false])]
    [(AstType.Bytes)
      (match b
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.Unit)
      (match b
        [(AstType.Unit) true]
        [_ false])]
    [(AstType.Never)
      (match b
        [(AstType.Never) true]
        [_ false])]
    [(AstType.Expr)
      (match b
        [(AstType.Expr) true]
        [_ false])]
    [(AstType.ExprList)
      (match b
        [(AstType.ExprList) true]
        [_ false])]
    [(AstType.Func a-args a-ret)
      (match b
        [(AstType.Func b-args b-ret)
          (and
            (tc-type-list-eq (box-get a-args) (box-get b-args))
            (tc-type-eq (ty-node-get a-ret) (ty-node-get b-ret)))]
        [_ false])]
    [(AstType.Tuple a-elems)
      (match b
        [(AstType.Tuple b-elems)
          (tc-type-list-eq (box-get a-elems) (box-get b-elems))]
        [_ false])]
    [(AstType.Array a-elem a-len)
      (match b
        [(AstType.Array b-elem b-len)
          (and
            (= a-len b-len)
            (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem)))]
        [_ false])]
    [(AstType.DynArray a-elem)
      (match b
        [(AstType.DynArray b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Box a-elem)
      (match b
        [(AstType.Box b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Ptr a-elem)
      (match b
        [(AstType.Ptr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.MutPtr a-elem)
      (match b
        [(AstType.MutPtr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Ref a-region a-inner)
      (match b
        [(AstType.Ref b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstType.MutRef a-region a-inner)
      (match b
        [(AstType.MutRef b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstType.Region _ inner)
      (tc-type-eq-core
        (tc-type-without-regions (ty-node-get inner))
        (tc-type-without-regions b))]
    [(AstType.Enum a-name)
      (match b
        [(AstType.Enum b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(AstType.EnumArgs a-name a-lifetimes)
      (match b
        [(AstType.EnumArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Struct a-name)
      (match b
        [(AstType.Struct b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(AstType.StructArgs a-name a-lifetimes)
      (match b
        [(AstType.StructArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Var a-name)
      (match b
        [(AstType.Var b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(AstType.VarArgs a-name a-lifetimes)
      (match b
        [(AstType.VarArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Consume a-inner)
      (match b
        [(AstType.Consume b-inner)
          (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner))]
        [_ false])]))

(define (tc-type-eq [a : AstType] [b : AstType]) : bool
  (match a
    [(AstType.Region _ inner) (tc-type-eq (ty-node-get inner) b)]
    [_
      (match b
        [(AstType.Region _ inner) (tc-type-eq a (ty-node-get inner))]
        [_ (tc-type-eq-core a b)])]))

(define (tc-never-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Never) true]
    [_ false]))

(define (tc-f32-to-f64-compatible? [expected : AstType] [actual : AstType]) : bool
  (match (tc-type-strip-region expected)
    [(AstType.F64)
      (match (tc-type-strip-region actual)
        [(AstType.F32) true]
        [_ false])]
    [_ false]))

(define (tc-type-compatible? [expected : AstType] [actual : AstType]) : bool
  (if (tc-never-type? actual)
    true
    (if (tc-type-eq expected actual)
      true
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-merge-branch-type [a : AstType] [b : AstType]) : ResultTcType
  (cond
    [(tc-never-type? a) (ResultTcType.Ok b)]
    [(tc-never-type? b) (ResultTcType.Ok a)]
    [(tc-type-eq a b)
      (let
        [a-regions : TcNameIdList (tc-type-collect-regions a)]
        [b-regions : TcNameIdList (tc-type-collect-regions b)]
        (if (tc-name-id-list-eq a-regions b-regions)
          (ResultTcType.Ok a)
          (match a-regions
            [(TcNameIdList.Nil) (ResultTcType.Ok b)]
            [_
              (match b-regions
                [(TcNameIdList.Nil) (ResultTcType.Ok a)]
                [_ (ResultTcType.Err "typecheck: if branches must match")])])))]
    [(tc-type-compatible? a b) (ResultTcType.Ok a)]
    [(tc-type-compatible? b a) (ResultTcType.Ok b)]
    [else (ResultTcType.Err "typecheck: if branches must match")]))

(define (tc-match-arm-merge-message [previous : AstType] [current : AstType]) : String
  (string.append
    "typecheck: match arms must agree: previous arm type "
    (string.append
      (tc-type-render previous)
      (string.append ", current arm type " (tc-type-render current)))))

(define (tc-integer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [_ false]))

(define (tc-repeat-text [piece : String] [count : i64]) : String
  (let
    [out : String ""]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! out (string.concat3 out piece ""))
          (set! i (+ i 1))))
      out)))

(define (tc-binary-ones [bits : i64]) : String
  (tc-repeat-text "1" bits))

(define (tc-binary-min-signed [bits : i64]) : String
  (string.append "1" (tc-repeat-text "0" (- bits 1))))

(define (tc-integer-literal-fits-positive-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8)
      (ast-int-literal-magnitude-fits-limit? text "127" "7f" (tc-binary-ones 7))]
    [(AstType.I16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32767"
        "7fff"
        (tc-binary-ones 15))]
    [(AstType.I32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483647"
        "7fffffff"
        (tc-binary-ones 31))]
    [(AstType.I64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775807"
        "7fffffffffffffff"
        (tc-binary-ones 63))]
    [(AstType.U8)
      (ast-int-literal-magnitude-fits-limit? text "255" "ff" (tc-binary-ones 8))]
    [(AstType.U16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "65535"
        "ffff"
        (tc-binary-ones 16))]
    [(AstType.U32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "4294967295"
        "ffffffff"
        (tc-binary-ones 32))]
    [(AstType.U64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "18446744073709551615"
        "ffffffffffffffff"
        (tc-binary-ones 64))]
    [_ false]))

(define (tc-integer-literal-fits-negative-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8)
      (ast-int-literal-magnitude-fits-limit?
        text
        "128"
        "80"
        (tc-binary-min-signed 8))]
    [(AstType.I16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32768"
        "8000"
        (tc-binary-min-signed 16))]
    [(AstType.I32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483648"
        "80000000"
        (tc-binary-min-signed 32))]
    [(AstType.I64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775808"
        "8000000000000000"
        (tc-binary-min-signed 64))]
    [_ false]))

(define (tc-integer-literal-fits-type? [text : String] [ty : AstType]) : bool
  (if (ast-int-literal-negative? text)
    (tc-integer-literal-fits-negative-type? text ty)
    (tc-integer-literal-fits-positive-type? text ty)))

(define (tc-integer-literal-value-fits-type? [value : i64] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8) (and (>= value -128) (<= value 127))]
    [(AstType.I16) (and (>= value -32768) (<= value 32767))]
    [(AstType.I32) (and (>= value -2147483648) (<= value 2147483647))]
    [(AstType.I64) true]
    [(AstType.U8) (and (>= value 0) (<= value 255))]
    [(AstType.U16) (and (>= value 0) (<= value 65535))]
    [(AstType.U32) (and (>= value 0) (<= value 4294967295))]
    [(AstType.U64) (>= value 0)]
    [_ false]))

(define (tc-integer-literal-fits-value-or-text?
  [value : i64]
  [text : String]
  [ty : AstType]) : bool
  (if (> (string.string-length text) 0)
    (tc-integer-literal-fits-type? text ty)
    (tc-integer-literal-value-fits-type? value ty)))

(define (tc-integer-literal-render [value : i64] [text : String]) : String
  (if (> (string.string-length text) 0)
    text
    (string.int->string value)))

(define (tc-integer-literal-range-message
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : String
  (str_cat.str-cat
    "typecheck: integer literal "
    (tc-integer-literal-render value text)
    " does not fit expected type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx expected)))))

(define (tc-integer-literal-type-with-expected
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : ResultTcType
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (if (tc-integer-type? resolved)
      (if (tc-integer-literal-fits-value-or-text? value text resolved)
        (ResultTcType.Ok resolved)
        (ResultTcType.Err
          (tc-integer-literal-range-message ctx value text expected)))
      (ResultTcType.Ok (AstType.I32)))))

(define (tc-float-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

;; Word-class for register-resident aggregates: a POD type that occupies
;; at most one machine word and is trivially copyable by value. Integers, bool,
;; char, and raw pointers qualify. Floats are excluded (a register-resident
;; aggregate is packed into general-purpose words). Owning handles (Box, String,
;; Array, DynArray), references, closures, tuples, and nested struct/enum fields
;; are excluded too: they would need deep-clone or multi-word handling that the
;; word-copy representation does not provide.
(define (tc-word-class-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (tc-ordered-comparison-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (if (tc-float-type? ty)
      true
      (match (tc-type-strip-region ty)
        [(AstType.Char) true]
        [_ false]))))

(define (tc-castable-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstType.Char) true]
      [(AstType.F64) true]
      [(AstType.F32) true]
      [_ false])))

(define (tc-function-to-integer-cast? [from-ty : AstType] [to-ty : AstType]) : bool
  (match (tc-type-strip-region from-ty)
    [(AstType.Func _ _) (tc-integer-type? (tc-type-strip-region to-ty))]
    [_ false]))

(define (tc-raw-pointer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (tc-type-move-kind [ty : AstType]) : TcMoveKind
  (match ty
    [(AstType.I64) (TcMoveKind.Copyable)]
    [(AstType.I32) (TcMoveKind.Copyable)]
    [(AstType.I16) (TcMoveKind.Copyable)]
    [(AstType.I8) (TcMoveKind.Copyable)]
    [(AstType.U64) (TcMoveKind.Copyable)]
    [(AstType.U32) (TcMoveKind.Copyable)]
    [(AstType.U16) (TcMoveKind.Copyable)]
    [(AstType.U8) (TcMoveKind.Copyable)]
    [(AstType.F64) (TcMoveKind.Copyable)]
    [(AstType.F32) (TcMoveKind.Copyable)]
    [(AstType.Bool) (TcMoveKind.Copyable)]
    [(AstType.Char) (TcMoveKind.Copyable)]
    [(AstType.Unit) (TcMoveKind.Copyable)]
    [(AstType.Never) (TcMoveKind.Copyable)]
    [(AstType.Expr) (TcMoveKind.Copyable)]
    [(AstType.ExprList) (TcMoveKind.Copyable)]
    [(AstType.Func _ _) (TcMoveKind.Copyable)]
    [(AstType.Ptr _) (TcMoveKind.Copyable)]
    [(AstType.MutPtr _) (TcMoveKind.Copyable)]
    [(AstType.Ref _ _) (TcMoveKind.Copyable)]
    [(AstType.Region _ inner) (tc-type-move-kind (ty-node-get inner))]
    [(AstType.String) (TcMoveKind.MoveOnly)]
    [(AstType.Str) (TcMoveKind.MoveOnly)]
    [(AstType.Bytes) (TcMoveKind.MoveOnly)]
    [(AstType.Tuple _) (TcMoveKind.MoveOnly)]
    [(AstType.Array _ _) (TcMoveKind.MoveOnly)]
    [(AstType.DynArray _) (TcMoveKind.MoveOnly)]
    [(AstType.Box _) (TcMoveKind.MoveOnly)]
    [(AstType.MutRef _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Enum _) (TcMoveKind.MoveOnly)]
    [(AstType.EnumArgs _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Struct _) (TcMoveKind.MoveOnly)]
    [(AstType.StructArgs _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Var _) (TcMoveKind.MoveOnly)]
    [(AstType.VarArgs _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Consume inner) (tc-type-move-kind (ty-node-get inner))]))

(define (tc-move-kind-copyable? [kind : TcMoveKind]) : bool
  (match kind
    [(TcMoveKind.Copyable) true]
    [(TcMoveKind.MoveOnly) false]))

(define (tc-type-copyable? [ty : AstType]) : bool
  (tc-move-kind-copyable? (tc-type-move-kind ty)))

(define (tc-type-move-only? [ty : AstType]) : bool
  (not (tc-type-copyable? ty)))

(define (tc-raw-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstType.Ptr elem) (ResultTcType.Ok (ty-node-get elem))]
    [(AstType.MutPtr elem) (ResultTcType.Ok (ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-mut-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstType.MutPtr elem) (ResultTcType.Ok (ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-atomic-pointer-name? [name : String]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")
    (string.eq name "volatile-load")
    (string.eq name "volatile-store!")))

(define (tc-atomic-load-name? [name : String]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (tc-atomic-store-name? [name : String]) : bool
  (or (string.eq name "atomic-store!") (string.eq name "volatile-store!")))

(define (tc-atomic-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (tc-atomic-elem-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [_ false]))

(define (tc-atomic-kind-volatile? [name : String]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (tc-atomic-check-elem [name : String] [elem : AstType]) : ResultTcType
  (let
    [resolved : AstType (tc-type-strip-region elem)]
    (if (tc-atomic-elem-type? resolved)
      (ResultTcType.Ok resolved)
      (ResultTcType.Err
        (if (tc-atomic-kind-volatile? name)
          "typecheck: volatile pointer element must be i32, i64, u32, or u64"
          "typecheck: atomic pointer element must be i32, i64, u32, or u64")))))

(define (tc-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : AstType]) : ResultTcType
  (if (tc-atomic-load-name? name)
    (match (tc-raw-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (string.append
        "typecheck: "
        (string.append name " requires a raw pointer operand")))
      [(ResultTcType.Ok elem)
        (tc-atomic-check-elem name (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (match (tc-mut-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (string.append
        "typecheck: "
        (string.append name " requires a MutPtr pointer operand")))
      [(ResultTcType.Ok elem)
        (tc-atomic-check-elem name (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-atomic-value-mismatch-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    "typecheck: volatile value type mismatch"
    "typecheck: atomic value type mismatch"))

(define (tc-atomic-load-arity-message [name : String]) : String
  (string.append
    "typecheck: "
    (string.append name " expects exactly one argument")))

(define (tc-atomic-update-arity-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    "typecheck: volatile-store! expects exactly two arguments"
    "typecheck: atomic update expects exactly two arguments"))

(define (tc-atomic-check-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : AstExpr]
  [elem : AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env value elem)
    [(ResultTcType.Ok value-ty) (tc-expect value-ty elem message)]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-atomic-one-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem) (ResultTcType.Ok elem)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err (tc-atomic-load-arity-message name))))

(define (tc-atomic-two-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              value
              elem
              (tc-atomic-value-mismatch-message name))
              [(ResultTcUnit.Ok)
                (if (tc-atomic-store-name? name)
                  (ResultTcType.Ok (AstType.Unit))
                  (if (string.eq name "atomic-add!")
                    (ResultTcType.Ok (AstType.Unit))
                    (ResultTcType.Ok elem)))]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err (tc-atomic-update-arity-message name))))

(define (tc-atomic-cas-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [expected : AstExpr]
  [new-value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx "atomic-cas!" ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              expected
              elem
              "typecheck: atomic expected value type mismatch")
              [(ResultTcUnit.Ok)
                (match (tc-atomic-check-value
                  ctx
                  env
                  new-value
                  elem
                  "typecheck: atomic new value type mismatch")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok elem)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err "typecheck: atomic-cas! expects exactly three arguments")))

(define (tc-atomic-nonload-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [tail0 : AstExprList]) : ResultTcType
  (if (> (struct-get (& tail0) len) 0)
    (let
      [value : AstExpr (ast-node-get (ast-expr-list-get (& tail0) 0 0))]
      [tail1 : AstExprList (ast-expr-list-tail-from-ref (& tail0) 1)]
      (if (tc-atomic-cas-name? name)
        (if (> (struct-get (& tail1) len) 0)
          (tc-atomic-cas-call
            ctx
            env
            ptr
            value
            (ast-node-get (ast-expr-list-get (& tail1) 0 0))
            (ast-expr-list-tail-from-ref (& tail1) 1))
          (ResultTcType.Err
            "typecheck: atomic-cas! expects exactly three arguments"))
        (tc-atomic-two-arg-call ctx env name ptr value tail1)))
    (ResultTcType.Err
      (if (tc-atomic-cas-name? name)
        "typecheck: atomic-cas! expects exactly three arguments"
        (tc-atomic-update-arity-message name)))))

(define (tc-atomic-pointer-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env name)
    [(ResultTcUnit.Ok)
      (if (> (struct-get (& args) len) 0)
        (let
          [ptr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
          [tail0 : AstExprList (ast-expr-list-tail-from-ref (& args) 1)]
          (if (tc-atomic-load-name? name)
            (tc-atomic-one-arg-call ctx env name ptr tail0)
            (tc-atomic-nonload-call ctx env name ptr tail0)))
        (ResultTcType.Err
          (if (tc-atomic-load-name? name)
            (tc-atomic-load-arity-message name)
            (if (tc-atomic-cas-name? name)
              "typecheck: atomic-cas! expects exactly three arguments"
              (tc-atomic-update-arity-message name)))))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-addr-of-local-lookup [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done)
      (ResultTcType.Err
        "typecheck: ptr-addr-of requires a local or parameter name")]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-ptr-addr-of-local-lookup rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key ty rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (ResultTcType.Err
          "typecheck: ptr-addr-of requires a local or parameter name")
        (if (= key name-id)
          (ResultTcType.Ok ty)
          (tc-ptr-addr-of-local-lookup rest-env name-id)))]))

(define (tc-ptr-addr-of-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : AstExpr]) : ResultTcType
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (match (tc-ptr-addr-of-local-lookup env name)
        [(ResultTcType.Ok ty)
          (match (tc-type-strip-region (tc-resolve-type ctx ty))
            [(AstType.Ref _ _)
              (ResultTcType.Err
                "typecheck: ptr-addr-of reference roots are not addressable")]
            [(AstType.MutRef _ _)
              (ResultTcType.Err
                "typecheck: ptr-addr-of reference roots are not addressable")]
            [_ (ResultTcType.Ok ty)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (match (tc-ptr-addr-of-place ctx env receiver)
          [(ResultTcType.Ok receiver-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
              [(AstType.Struct _)
                (tc-struct-get-result-type-id ctx receiver-ty field)]
              [(AstType.StructArgs _ _)
                (tc-struct-get-result-type-id ctx receiver-ty field)]
              [_
                (ResultTcType.Err
                  "typecheck: ptr-addr-of requires a local/parameter, struct-get, or fixed-array array-ref place")])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (match (tc-expr-with-expected-or-actual-id
        ctx
        env
        index-box
        (AstType.I64))
        [(ResultTcType.Ok index-ty)
          (if (tc-integer-type? index-ty)
            (let
              [array : AstExpr (ast-node-get array-box)]
              (match (tc-ptr-addr-of-place ctx env array)
                [(ResultTcType.Ok array-ty)
                  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
                    [(AstType.Array elem-ty _)
                      (ResultTcType.Ok (ty-node-get elem-ty))]
                    [(AstType.DynArray _)
                      (ResultTcType.Err
                        "typecheck: ptr-addr-of dynamic array elements are not addressable; use array-data plus ptr-offset")]
                    [_
                      (ResultTcType.Err
                        "typecheck: ptr-addr-of requires a local/parameter, struct-get, or fixed-array array-ref place")])]
                [(ResultTcType.Err message) (ResultTcType.Err message)]))
            (ResultTcType.Err "typecheck: array index must be integer"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [_
      (ResultTcType.Err
        "typecheck: ptr-addr-of requires a local/parameter, struct-get, or fixed-array array-ref place")]))

(define (tc-require-unsafe [env : TcTypeEnv] [name : String]) : ResultTcUnit
  (if (tc-in-unsafe? env)
    (begin
      (tc-unused-unsafe-mark-current-used!)
      ResultTcUnit.Ok)
    (ResultTcUnit.Err
      (string.append
        "typecheck: "
        (string.append name " requires unsafe context")))))

(define (tc-dyn-array-elem-list-supported?
  [env : TcTypeEnv]
  [types : AstTypeList]) : bool
  (tc-dyn-array-elem-list-supported-at? env (& types) 0))

(define (tc-dyn-array-elem-list-supported-at?
  [env : TcTypeEnv]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    true
    (if (tc-dyn-array-elem-supported?
      env
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-dyn-array-elem-list-supported-at? env types (+ index 1))
      false)))

(define (tc-dyn-array-elem-supported? [env : TcTypeEnv] [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstType.Bool) true]
      [(AstType.Char) true]
      [(AstType.F64) true]
      [(AstType.F32) true]
      [(AstType.String) true]
      [(AstType.Enum _) true]
      [(AstType.EnumArgs _ _) true]
      [(AstType.Struct _) true]
      [(AstType.StructArgs _ _) true]
      [(AstType.DynArray _) true]
      [(AstType.Tuple elems)
        (tc-dyn-array-elem-list-supported? env (box-get elems))]
      [(AstType.Ref _ _)
        (tc-reference-lifetimes-visible?
          env
          (tc-type-collect-reference-lifetimes ty))]
      [_ false])))

(define (tc-spmd-varying? [class : TcSpmdClass]) : bool
  (match class
    [(TcSpmdClass.Uniform) false]
    [(TcSpmdClass.Varying) true]))

(define (tc-spmd-merge-class [a : TcSpmdClass] [b : TcSpmdClass]) : TcSpmdClass
  (if (tc-spmd-varying? a)
    TcSpmdClass.Varying
    (if (tc-spmd-varying? b)
      TcSpmdClass.Varying
      TcSpmdClass.Uniform)))

(define (tc-spmd-varying-value-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [_ false]))

(define (tc-spmd-varying-expr-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-varying-enum-type-supported? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Var name)
      (match (tc-context-enum-variants-id ctx name (tc-env-key-name-text name))
        [(ResultAstVariantDefList.Ok _) true]
        [(ResultAstVariantDefList.Err _) false])]
    [_ false]))

(define (tc-spmd-lane-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [_ false]))

(define (tc-spmd-broadcast-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

(define (tc-spmd-broadcast-type-message) : String
  "typecheck: spmd-broadcast value must have type i32, u32, i64, u64, f32, or f64; bool broadcast remains deferred")

(define (tc-spmd-shuffle-type-message) : String
  "typecheck: spmd-shuffle value must have type i32, u32, i64, u64, f32, or f64; bool shuffle remains deferred")

(define (tc-spmd-broadcast-finish
  [ctx : TcContext]
  [expr-ty : AstType]
  [value-class : TcSpmdClass]
  [lane-ty : AstType]
  [lane-class : TcSpmdClass]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-spmd-require-uniform
      lane-class
      "typecheck: spmd-broadcast lane must be uniform")
      [(ResultTcUnit.Ok)
        (match (tc-expect
          (tc-resolve-type ctx lane-ty)
          (AstType.I64)
          "typecheck: spmd-broadcast lane must have type i64")
          [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
          [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-broadcast-type-message))))

(define (tc-spmd-shuffle-finish
  [ctx : TcContext]
  [expr-ty : AstType]
  [value-class : TcSpmdClass]
  [lane-ty : AstType]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-expect
      (tc-resolve-type ctx lane-ty)
      (AstType.I64)
      "typecheck: spmd-shuffle lane must have type i64")
      [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-shuffle-type-message))))

(define (tc-spmd-finish [ty : AstType] [class : TcSpmdClass] [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and
    (tc-spmd-varying? class)
    (not (tc-spmd-varying-expr-type-supported? ty)))
    (ResultTcSpmdExprInfo.Err
      (string.append
        "typecheck: foreach varying value type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo ty class env))))

(define (tc-spmd-finish-ctx
  [ctx : TcContext]
  [ty : AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (if (and
      (tc-spmd-varying? class)
      (tc-spmd-varying-enum-type-supported? ctx resolved))
      (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
      (tc-spmd-finish resolved class env))))

(define (tc-spmd-finish-lane
  [ctx : TcContext]
  [ty : AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    [supported-enum : bool (tc-spmd-varying-enum-type-supported? ctx resolved)]
    (if (and
      (tc-spmd-varying? class)
      (not (tc-spmd-lane-type-supported? resolved))
      (not supported-enum))
      (ResultTcSpmdExprInfo.Err
        (string.append
          "typecheck: foreach varying array lane type is not supported: "
          (tc-type-render (tc-type-strip-region resolved))))
      (if (and (tc-spmd-varying? class) supported-enum)
        (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
        (tc-spmd-finish-ctx ctx resolved class env)))))

(define (tc-spmd-cpuid-like
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [leaf : AstExpr]
  [subleaf : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env leaf)
    [(ResultTcSpmdExprInfo.Ok leaf-info)
      (match leaf-info
        [(TcSpmdExprInfo _ leaf-class leaf-env)
          (match (tc-spmd-expr ctx env leaf-env subleaf)
            [(ResultTcSpmdExprInfo.Ok subleaf-info)
              (match subleaf-info
                [(TcSpmdExprInfo _ subleaf-class subleaf-env)
                  (tc-spmd-finish
                    expr-ty
                    (tc-spmd-merge-class leaf-class subleaf-class)
                    subleaf-env)])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-env-empty) : TcSpmdEnv
  (TcSpmdEnv (array.make-array TcSpmdBinding 0) 0))

(define (tc-spmd-binding
  [name-id : i64]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdBinding
  (TcSpmdBinding name-id ty class scope role))

(define (tc-spmd-env-binding-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) 0]
    [(TcTypeEnvSpineStep.Cache rest-env) (tc-spmd-env-binding-count rest-env)]
    [(TcTypeEnvSpineStep.Bind _ _ rest-env)
      (+ 1 (tc-spmd-env-binding-count rest-env))]))

(define (tc-spmd-env-fill-from-type-env
  [env : TcTypeEnv]
  [bindings : (Array TcSpmdBinding)]
  [index : i64]) : unit
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) unit]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-spmd-env-fill-from-type-env rest-env bindings index)]
    [(TcTypeEnvSpineStep.Bind name-id ty rest-env)
      (begin
        (array-set!
          bindings
          index
          (tc-spmd-binding
            name-id
            ty
            TcSpmdClass.Uniform
            TcSpmdScope.Outer
            TcSpmdRole.Value))
        (tc-spmd-env-fill-from-type-env rest-env bindings (- index 1)))]))

(define (tc-spmd-env-from-type-env [env : TcTypeEnv]) : TcSpmdEnv
  (let
    [count : i64 (tc-spmd-env-binding-count env)]
    [bindings : (Array TcSpmdBinding) (array.make-array TcSpmdBinding count)]
    (begin
      (tc-spmd-env-fill-from-type-env env bindings (- count 1))
      (TcSpmdEnv bindings count))))

(define (tc-spmd-env-bindings [env : TcSpmdEnv]) : (Array TcSpmdBinding)
  (struct-get env bindings))

(define (tc-spmd-env-len [env : TcSpmdEnv]) : i64
  (struct-get env len))

(define (tc-spmd-env-mark [env : TcSpmdEnv]) : TcSpmdEnvMark
  (TcSpmdEnvMark (tc-spmd-env-len env)))

(define (tc-spmd-env-restore [env : TcSpmdEnv] [mark : TcSpmdEnvMark]) : TcSpmdEnv
  (let
    [mark-len : i64 (struct-get mark len)]
    [current-len : i64 (tc-spmd-env-len env)]
    [restored-len : i64
      (if (< mark-len 0)
        0
        (if (> mark-len current-len)
          current-len
          mark-len))]
    (TcSpmdEnv (tc-spmd-env-bindings env) restored-len)))

(define (tc-spmd-env-copy-bindings
  [dst : (Array TcSpmdBinding)]
  [src : (Array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (array-set! dst index (array-ref src index))
      (tc-spmd-env-copy-bindings dst src (+ index 1) count))))

(define (tc-spmd-env-bind-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]) : TcSpmdEnv
  (tc-spmd-env-bind-role-id env name-id ty class scope TcSpmdRole.Value))

(define (tc-spmd-env-bind-role-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-len : i64 (+ old-len 1)]
    [new-bindings : (Array TcSpmdBinding)
      (array.make-array TcSpmdBinding new-len)]
    (begin
      (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
      (array-set!
        new-bindings
        old-len
        (tc-spmd-binding name-id ty class scope role))
      (TcSpmdEnv new-bindings new-len))))

(define (tc-spmd-env-lookup-from
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : TcSpmdLookup
  (if (< index 0)
    TcSpmdLookup.Missing
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= (struct-get binding name) name-id)
        (TcSpmdLookup.Found
          (struct-get binding ty)
          (struct-get binding class)
          (struct-get binding scope)
          (struct-get binding role))
        (tc-spmd-env-lookup-from bindings (- index 1) name-id)))))

(define (tc-spmd-env-lookup-id [env : TcSpmdEnv] [name-id : i64]) : TcSpmdLookup
  (tc-spmd-env-lookup-from
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-has-local-from?
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= (struct-get binding name) name-id)
        (match (struct-get binding scope)
          [(TcSpmdScope.Local) true]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-has-local-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-local-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-local-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-local-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-has-outer-from?
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= (struct-get binding name) name-id)
        (match (struct-get binding scope)
          [(TcSpmdScope.Outer) true]
          [(TcSpmdScope.Local)
            (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-outer-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-outer-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-local-index
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= (struct-get binding name) name-id)
        (match (struct-get binding scope)
          [(TcSpmdScope.Local) index]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-local-index bindings (- index 1) name-id)])
        (tc-spmd-env-local-index bindings (- index 1) name-id)))))

(define (tc-spmd-env-set-local-class-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [class : TcSpmdClass]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [local-index : i64
      (tc-spmd-env-local-index old-bindings (- old-len 1) name-id)]
    (if (< local-index 0)
      env
      (let
        [new-bindings : (Array TcSpmdBinding)
          (array.make-array TcSpmdBinding old-len)]
        [old-binding : TcSpmdBinding (array-ref old-bindings local-index)]
        (begin
          (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
          (array-set!
            new-bindings
            local-index
            (tc-spmd-binding
              (struct-get old-binding name)
              (struct-get old-binding ty)
              class
              (struct-get old-binding scope)
              (struct-get old-binding role)))
          (TcSpmdEnv new-bindings old-len))))))

(define (tc-spmd-env-pop [env : TcSpmdEnv] [count : i64]) : TcSpmdEnv
  (if (<= count 0)
    env
    (tc-spmd-env-restore env (TcSpmdEnvMark (- (tc-spmd-env-len env) count)))))

(define (tc-spmd-env-mark-outer-into
  [dst : (Array TcSpmdBinding)]
  [src : (Array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (let
      [binding : TcSpmdBinding (array-ref src index)]
      (begin
        (array-set!
          dst
          index
          (tc-spmd-binding
            (struct-get binding name)
            (struct-get binding ty)
            (struct-get binding class)
            TcSpmdScope.Outer
            (struct-get binding role)))
        (tc-spmd-env-mark-outer-into dst src (+ index 1) count)))))

(define (tc-spmd-env-mark-outer [env : TcSpmdEnv]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-bindings : (Array TcSpmdBinding)
      (array.make-array TcSpmdBinding old-len)]
    (begin
      (tc-spmd-env-mark-outer-into new-bindings old-bindings 0 old-len)
      (TcSpmdEnv new-bindings old-len))))

(define (tc-spmd-env-merge-binding-class
  [left : TcSpmdBinding]
  [right-bindings : (Array TcSpmdBinding)]
  [right-len : i64]
  [index : i64]) : TcSpmdClass
  (if (>= index right-len)
    (struct-get left class)
    (let
      [right : TcSpmdBinding (array-ref right-bindings index)]
      (tc-spmd-merge-class (struct-get left class) (struct-get right class)))))

(define (tc-spmd-env-merge-classes-into
  [dst : (Array TcSpmdBinding)]
  [left-bindings : (Array TcSpmdBinding)]
  [right-bindings : (Array TcSpmdBinding)]
  [left-len : i64]
  [right-len : i64]
  [index : i64]) : unit
  (if (>= index left-len)
    unit
    (let
      [left : TcSpmdBinding (array-ref left-bindings index)]
      (begin
        (array-set!
          dst
          index
          (tc-spmd-binding
            (struct-get left name)
            (struct-get left ty)
            (tc-spmd-env-merge-binding-class
              left
              right-bindings
              right-len
              index)
            (struct-get left scope)
            (struct-get left role)))
        (tc-spmd-env-merge-classes-into
          dst
          left-bindings
          right-bindings
          left-len
          right-len
          (+ index 1))))))

(define (tc-spmd-env-merge-classes [left : TcSpmdEnv] [right : TcSpmdEnv]) : TcSpmdEnv
  (let
    [left-len : i64 (tc-spmd-env-len left)]
    [right-len : i64 (tc-spmd-env-len right)]
    [left-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings left)]
    [right-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings right)]
    [merged : (Array TcSpmdBinding) (array.make-array TcSpmdBinding left-len)]
    (begin
      ;; Branch merge is index-aligned: both branches start from the same
      ;; snapshot and local lets restore to that mark before the merge.
      (tc-spmd-env-merge-classes-into
        merged
        left-bindings
        right-bindings
        left-len
        right-len
        0)
      (TcSpmdEnv merged left-len))))

(define (tc-type-env-box-smoke?) : bool
  (let
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-id
          (tc-bind-id
            (tc-push-region-id (tc-empty-env) (intern "arena"))
            (intern "x")
            (AstType.I64))
          (intern "x")
          (AstType.Bool))
        (AstType.I64))]
    [cached : TcTypeEnv (tc-env-with-cache env)]
    (and
      (= (tc-env-cache-count cached) 4)
      (match (tc-lookup-id cached (intern "x"))
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-current-return-type env)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region env)
        [(TcMaybeNameId.Some region) (= region (intern "arena"))]
        [_ false])
      (tc-lifetime-visible-id? env (intern "arena")))))

(define (tc-type-env-cache-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ _ _) true]
    [_ false]))

(define (tc-type-env-cache-partial-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ partial _ _) partial]
    [_ false]))

(define (tc-type-env-bind-many [env : TcTypeEnv] [count : i64]) : TcTypeEnv
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (tc-bind-id
              out
              (intern (string.append "local" (string.int->string i)))
              (AstType.I64)))
          (set! i (+ i 1))))
      out)))

(defstruct TcTypeEnvBindManyEndpoints
  (env TcTypeEnv)
  (first-id i64)
  (last-id i64))

(define (tc-type-env-bind-many-endpoints [env : TcTypeEnv] [count : i64]) : TcTypeEnvBindManyEndpoints
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    [first-id : i64 -1]
    [last-id : i64 -1]
    (begin
      (while (< i count)
        (let
          [name-id : i64
            (intern (string.append "local" (string.int->string i)))]
          (begin
            (if (= i 0)
              (set! first-id name-id)
              unit)
            (set! last-id name-id)
            (set! out (tc-bind-id out name-id (AstType.I64)))
            (set! i (+ i 1)))))
      (TcTypeEnvBindManyEndpoints out first-id last-id))))

(define (tc-type-env-local-cache-behavior-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (intern "global") (AstType.String)))]
    [marked : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-unsafe-id
          (tc-push-region-id base (intern "arena"))
          (intern "danger")
          (AstType.I64))
        (AstType.I64))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        (tc-bind-id marked (intern "shadow") (AstType.I64))
        (intern "shadow")
        (AstType.Bool))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 6))]
    (and
      (tc-type-env-cache-head? cached)
      (match (tc-lookup-id cached (intern "shadow"))
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-lookup-id cached (intern "global"))
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup-unsafe-id cached (intern "danger"))
        [(ResultTcTypeUnsafe.Ok (AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-lookup-id cached (intern "missing"))
        [(ResultTcType.Err message)
          (string.eq message "typecheck: unbound name missing")]
        [_ false])
      (match (tc-current-return-type cached)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region cached)
        [(TcMaybeNameId.Some region) (= region (intern "arena"))]
        [_ false])
      (tc-lifetime-visible-id? cached (intern "shadow")))))

(define (tc-type-env-local-cache-default-shadow-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        base
        (intern "__tl_string_length")
        (tc-fn1 (AstType.I64) (AstType.I64)))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-head? cached)
      (not
        (tc-default-builtin-unshadowed-id?
          cached
          cbi.compiler-builtin-id-tl-private-string-length)))))

(define (tc-type-env-local-cache-partial-layer-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (intern "global") (AstType.String)))]
    [layer1 : TcTypeEnv (tc-type-env-bind-many base (tc-local-cache-threshold))]
    [older-shadow : TcTypeEnv
      (tc-bind-id layer1 (intern "shadow") (AstType.I64))]
    [layer2 : TcTypeEnv
      (tc-type-env-bind-many older-shadow (- (tc-local-cache-threshold) 1))]
    [newer-shadow : TcTypeEnv
      (tc-bind-id layer2 (intern "shadow") (AstType.Bool))]
    [layer3 : TcTypeEnv
      (tc-type-env-bind-many newer-shadow (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-partial-head? layer1)
      (tc-type-env-cache-partial-head? layer2)
      (tc-type-env-cache-partial-head? layer3)
      (= (tc-env-partial-layer-depth layer3) 3)
      (match (tc-lookup-id layer3 (intern "global"))
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup-id layer2 (intern "shadow"))
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-lookup-id layer3 (intern "shadow"))
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false]))))

(define (tc-type-env-local-cache-default-shadow-partial-miss-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        base
        (intern "__tl_string_length")
        (tc-fn1 (AstType.I64) (AstType.I64)))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    [miss-layer : TcTypeEnv
      (tc-type-env-bind-many shadow-layer (tc-local-cache-threshold))]
    [clear-layer : TcTypeEnv
      (tc-type-env-bind-many base (tc-local-cache-threshold))]
    (and
      (tc-type-env-cache-partial-head? shadow-layer)
      (tc-type-env-cache-partial-head? miss-layer)
      (tc-type-env-cache-partial-head? clear-layer)
      (not
        (tc-default-builtin-unshadowed-id?
          shadow-layer
          cbi.compiler-builtin-id-tl-private-string-length))
      (not
        (tc-default-builtin-unshadowed-id?
          miss-layer
          cbi.compiler-builtin-id-tl-private-string-length))
      (tc-default-builtin-unshadowed-id?
        clear-layer
        cbi.compiler-builtin-id-tl-private-string-length))))

(define (tc-type-env-local-cache-depth-cap-smoke?) : bool
  (let
    [global-id : i64 (intern "global")]
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind-id (tc-empty-env) global-id (AstType.String)))]
    [bound : TcTypeEnvBindManyEndpoints
      (tc-type-env-bind-many-endpoints
        base
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))]
    [deep : TcTypeEnv (struct-get bound env)]
    (and
      (tc-type-env-cache-head? deep)
      (tc-type-env-cache-partial-head? deep)
      (= (tc-env-partial-layer-depth deep) 1)
      (=
        (tc-env-partial-local-covered-count deep)
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))
      (match (tc-env-partial-local-base deep)
        [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ _ _) (not scan-through)]
        [_ false])
      (match (tc-lookup-id deep global-id)
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup-id deep (struct-get bound first-id))
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-lookup-id deep (struct-get bound last-id))
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false]))))

;; Markers buried below MORE THAN ONE compaction window. The behavior
;; smoke above only crosses one threshold, so the head cache is unwrapped and
;; the markers are reached by the plain bind walk; with two stacked
;; compaction caches the scans must recurse through scan-through cache nodes
;; or the markers disappear (with-arena escape checking was silently disabled
;; past 32 local binds). Scans must still terminate at the explicit
;; non-scan-through base cache.
(define (tc-type-env-local-cache-deep-scan-smoke?) : bool
  (let
    [global-id : i64 (intern "global")]
    [arena-id : i64 (intern "arena")]
    [atomic-arena-id : i64 (intern "atomic-arena")]
    [phase-id : i64 (intern "phase")]
    [phase-region-id : i64 (tc-arena-phase-region-id arena-id phase-id)]
    [resource-id : i64 (intern "resource")]
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind-id (tc-empty-env) global-id (AstType.String)))]
    [marked : TcTypeEnv
      (tc-bind-id
        (tc-bind-cleanup-owner
          (tc-bind-id
            (tc-bind-arena-phase-token
              (tc-bind-id
                (tc-bind-atomic-arena-owner
                  (tc-bind-id
                    (tc-bind-ordinary-arena-owner
                      (tc-bind-return-type
                        (tc-enter-unsafe (tc-push-region-id base arena-id))
                        (AstType.I64))
                      arena-id)
                    arena-id
                    (AstType.I64))
                  atomic-arena-id)
                atomic-arena-id
                (AstType.I64))
              phase-id
              arena-id)
            phase-id
            (AstType.I64))
          resource-id)
        resource-id
        (AstType.String))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many marked (+ (* (tc-local-cache-threshold) 2) 8))]
    [resource-shadow : TcTypeEnv (tc-bind-id deep resource-id (AstType.Bool))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many resource-shadow (- (tc-local-cache-threshold) 1))]
    [below-base : TcTypeEnv
      (tc-type-env-bind-many base (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (match (tc-active-region deep)
        [(TcMaybeNameId.Some region) (= region arena-id)]
        [_ false])
      (match (tc-current-return-type deep)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (tc-in-unsafe? deep)
      (tc-ordinary-arena-owner-active-id? deep arena-id)
      (tc-atomic-arena-owner-active-id? deep atomic-arena-id)
      (match (tc-arena-phase-token-region-active deep phase-id)
        [(TcMaybeNameId.Some region) (= region phase-region-id)]
        [_ false])
      (match (tc-arena-phase-token-owner-active deep phase-id)
        [(TcMaybeNameId.Some owner) (= owner arena-id)]
        [_ false])
      (tc-string-list-contains (tc-active-cleanup-owners deep) "resource")
      (tc-lifetime-visible-id? deep arena-id)
      (tc-lifetime-visible-id? deep resource-id)
      (tc-lifetime-outlives-binding-id? deep arena-id resource-id)
      (not (tc-lifetime-outlives-binding-id? deep resource-id arena-id))
      (tc-lifetime-outlives-lifetime-id? deep arena-id resource-id)
      (not (tc-lifetime-outlives-lifetime-id? deep resource-id arena-id))
      (not (tc-cleanup-owner-active-id? shadow-layer resource-id))
      (tc-ordinary-arena-owner-active-id? shadow-layer arena-id)
      (tc-atomic-arena-owner-active-id? shadow-layer atomic-arena-id)
      (tc-region-outlives-or-matches deep arena-id arena-id)
      (match (tc-active-region below-base)
        [(TcMaybeNameId.No) true]
        [_ false])
      (not (tc-lifetime-visible-id? below-base (intern "global"))))))

(define (tc-type-env-local-cache-c-abi-fnptr-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [callback-ty : AstType (tc-fn0 (AstType.I64))]
    [marked : TcTypeEnv
      (tc-bind-c-abi-fnptr-id base (intern "callback") callback-ty)]
    [both : TcTypeEnv
      (tc-bind-unsafe-c-abi-fnptr-id
        marked
        (intern "danger-callback")
        callback-ty)]
    [deep : TcTypeEnv
      (tc-type-env-bind-many both (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (tc-binding-c-abi-fnptr-id? deep (intern "callback"))
      (not (tc-binding-unsafe-id? deep (intern "callback")))
      (tc-binding-c-abi-fnptr-id? deep (intern "danger-callback"))
      (tc-binding-unsafe-id? deep (intern "danger-callback"))
      (match (tc-lookup-unsafe-id deep (intern "danger-callback"))
        [(ResultTcTypeUnsafe.Ok (AstType.Func _ _) unsafe) unsafe]
        [_ false]))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-lookup-smoke?) : bool
    (let
      [base-id : i64 (intern "base")]
      [dup-id : i64 (intern "dup")]
      [missing-id : i64 (intern "missing")]
      [base : TcTypeEnv
        (tc-env-with-cache (tc-bind-id (tc-empty-env) base-id (AstType.I64)))]
      [older : TcTypeEnv (tc-bind-id base dup-id (AstType.I64))]
      [newer : TcTypeEnv (tc-bind-id older dup-id (AstType.Bool))]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit newer)]
      (and
        (= (tc-env-uncached-prefix-to-explicit-cache-count newer) 2)
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (match (tc-lookup-id layer dup-id)
          [(ResultTcType.Ok (AstType.Bool)) true]
          [_ false])
        (match (tc-lookup-id layer base-id)
          [(ResultTcType.Ok (AstType.I64)) true]
          [_ false])
        (match (tc-lookup-id layer missing-id)
          [(ResultTcType.Err message)
            (string.eq message "typecheck: unbound name missing")]
          [_ false])))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-flags-smoke?) : bool
    (let
      [callback-ty : AstType (tc-fn0 (AstType.I64))]
      [base-callback-id : i64 (intern "base-callback")]
      [danger-callback-id : i64 (intern "danger-callback")]
      [base : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-c-abi-fnptr-id (tc-empty-env) base-callback-id callback-ty))]
      [layer-source : TcTypeEnv
        (tc-bind-unsafe-c-abi-fnptr-id base danger-callback-id callback-ty)]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit layer-source)]
      (and
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (tc-binding-c-abi-fnptr-id? layer base-callback-id)
        (not (tc-binding-unsafe-id? layer base-callback-id))
        (tc-binding-c-abi-fnptr-id? layer danger-callback-id)
        (tc-binding-unsafe-id? layer danger-callback-id)
        (match (tc-lookup-unsafe-id layer danger-callback-id)
          [(ResultTcTypeUnsafe.Ok (AstType.Func _ _) unsafe) unsafe]
          [_ false])))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-marker-smoke?) : bool
    (let
      [base : TcTypeEnv
        (tc-env-with-cache (tc-push-region (tc-default-env) (intern "hidden")))]
      [shadowed : TcTypeEnv
        (tc-bind-id
          base
          (intern "__tl_string_length")
          (tc-fn1 (AstType.I64) (AstType.I64)))]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit shadowed)]
      (and
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (tc-default-builtin-unshadowed-id?
          base
          cbi.compiler-builtin-id-tl-private-string-length)
        (not
          (tc-default-builtin-unshadowed-id?
            layer
            cbi.compiler-builtin-id-tl-private-string-length))
        (match (tc-active-region layer)
          [(TcMaybeNameId.No) true]
          [_ false])
        (not (tc-lifetime-visible-id? layer (intern "hidden")))))))

(define (tc-type-env-local-cache-lambda-capture-smoke?) : bool
  (let
    [body : AstExpr (AstExpr.Var (intern "captured"))]
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [env : TcTypeEnv
      (tc-bind-id
        (tc-push-region-id base (intern "outer"))
        (intern "captured")
        (ast-ty-ref (intern "outer") (AstType.I64)))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many env (+ (* (tc-local-cache-threshold) 2) 8))]
    [scoped : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-marker-visible-env deep)]
    (and
      (tc-lambda-captures-reference? deep (ast-param-list-new) body)
      (tc-type-env-scoped-carrier-lambda-captures-reference?
        scoped
        (ast-param-list-new)
        body)
      (match (tc-check-lambda-region-captures deep (ast-param-list-new) body)
        [(ResultTcUnit.Err message)
          (string.eq
            message
            "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")]
        [_ false])
      (match (tc-check-lambda-region-captures-allow-refs
        deep
        (ast-param-list-new)
        body)
        [(ResultTcUnit.Ok) true]
        [_ false]))))

(define (tc-type-env-scoped-stack-grow-smoke?) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-type-env-scoped-stack-with-capacity 1 1)]
    [a-id : i64 (intern "scoped-grow-a")]
    [b-id : i64 (intern "scoped-grow-b")]
    [c-id : i64 (intern "scoped-grow-c")]
    (begin
      (tc-type-env-scoped-stack-bind-id! (&mut stack) a-id (AstType.I64))
      (let
        [outer : TcTypeEnvScopedMark
          (tc-type-env-scoped-stack-save! (&mut stack))]
        (begin
          (tc-type-env-scoped-stack-bind-id! (&mut stack) b-id (AstType.Bool))
          (let
            [inner : TcTypeEnvScopedMark
              (tc-type-env-scoped-stack-save! (&mut stack))]
            (begin
              (tc-type-env-scoped-stack-bind-id!
                (&mut stack)
                c-id
                (AstType.String))
              (tc-type-env-scoped-stack-restore! (&mut stack) inner)
              (let
                [after-inner : bool
                  (and
                    (= (tc-type-env-scoped-stack-len stack) 2)
                    (= (tc-type-env-scoped-stack-mark-count stack) 1)
                    (= (tc-type-env-scoped-stack-scope-depth stack) 1)
                    (match (tc-type-env-scoped-stack-lookup-id stack c-id)
                      [(TcTypeEnvScopedLookup.Missing) true]
                      [_ false])
                    (match (tc-type-env-scoped-stack-lookup-id stack b-id)
                      [(TcTypeEnvScopedLookup.Found
                          (AstType.Bool)
                          unsafe
                          c-abi-fnptr
                          _
                          depth
                          _)
                        (and (not unsafe) (not c-abi-fnptr) (= depth 1))]
                      [_ false]))]
                (begin
                  (tc-type-env-scoped-stack-restore! (&mut stack) outer)
                  (and
                    after-inner
                    (= (tc-type-env-scoped-stack-len stack) 1)
                    (= (tc-type-env-scoped-stack-mark-count stack) 0)
                    (= (tc-type-env-scoped-stack-scope-depth stack) 0)
                    (match (tc-type-env-scoped-stack-lookup-id stack b-id)
                      [(TcTypeEnvScopedLookup.Missing) true]
                      [_ false])
                    (match (tc-type-env-scoped-stack-lookup-id stack a-id)
                      [(TcTypeEnvScopedLookup.Found
                          (AstType.I64)
                          unsafe
                          c-abi-fnptr
                          marker-kind
                          depth
                          _)
                        (and
                          (not unsafe)
                          (not c-abi-fnptr)
                          (tc-type-env-scoped-marker-kind-same?
                            marker-kind
                            TcTypeEnvScopedMarkerKind.None)
                          (= depth 0))]
                      [_ false])))))))))))

(define (tc-type-env-scoped-stack-sparse-cache-repair-smoke?) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-type-env-scoped-stack-with-capacity 1 1)]
    [name-id : i64 (+ tc-type-env-scoped-dense-lookup-capacity 17)]
    (begin
      (tc-type-env-scoped-stack-bind-id! (&mut stack) name-id (AstType.I64))
      (let
        [mark : TcTypeEnvScopedMark
          (tc-type-env-scoped-stack-save! (&mut stack))]
        (begin
          (tc-type-env-scoped-stack-bind-id!
            (&mut stack)
            name-id
            (AstType.Bool))
          (let
            [shadowed : bool
              (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                [(TcTypeEnvScopedLookup.Found (AstType.Bool) _ _ _ _ _) true]
                [_ false])]
            (begin
              (tc-type-env-scoped-stack-restore! (&mut stack) mark)
              (let
                [restored : bool
                  (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                    [(TcTypeEnvScopedLookup.Found (AstType.I64) _ _ _ _ _) true]
                    [_ false])]
                [repaired-index : i64
                  (match (tc_i64_i64_map.get
                    (& (struct-get stack lookup-cache))
                    name-id)
                    [(tc_i64_i64_map.LookupFound index) index]
                    [(tc_i64_i64_map.LookupMissing) -1])]
                [restored-again : bool
                  (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                    [(TcTypeEnvScopedLookup.Found (AstType.I64) _ _ _ _ _) true]
                    [_ false])]
                (and shadowed restored (= repaired-index 0) restored-again)))))))))

(define (tc-type-env-scoped-sidecar-smoke?) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar (tc-type-env-scoped-sidecar-new)]
    [value-id : i64 (intern "scoped-value")]
    [fn-id : i64 (intern "scoped-callback")]
    (begin
      (set!
        sidecar
        (tc-type-env-scoped-sidecar-bind-id sidecar value-id (AstType.I64)))
      (let
        [stack-mark : TcTypeEnvScopedMark
          (tc-type-env-scoped-sidecar-save! (&mut sidecar))]
        [mark : TcTypeEnvScopedSidecarMark
          (tc-type-env-scoped-sidecar-mark sidecar stack-mark)]
        [generation-before : i64
          (tc-type-env-scoped-stack-cache-generation (struct-get sidecar stack))]
        (begin
          (set!
            sidecar
            (tc-type-env-scoped-sidecar-bind-id sidecar value-id (AstType.Bool)))
          (set!
            sidecar
            (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
              sidecar
              fn-id
              (AstType.I64)))
          (let
            [before-restore : bool
              (and
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar value-id)
                  [(TcTypeEnvScopedLookup.Found
                      (AstType.Bool)
                      unsafe
                      c-abi-fnptr
                      marker-kind
                      depth
                      generation)
                    (and
                      (not unsafe)
                      (not c-abi-fnptr)
                      (tc-type-env-scoped-marker-kind-same?
                        marker-kind
                        TcTypeEnvScopedMarkerKind.None)
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar fn-id)
                  [(TcTypeEnvScopedLookup.Found
                      (AstType.I64)
                      unsafe
                      c-abi-fnptr
                      _
                      depth
                      generation)
                    (and
                      unsafe
                      c-abi-fnptr
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (struct-get sidecar stack)
                  TcTypeEnvScopedMarkerKind.UnsafeDecl)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (AstType.Unit)
                      depth
                      generation)
                    (and
                      (= marker-id (tc-unsafe-decl-marker-id fn-id))
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-persistent sidecar)
                  value-id)
                  [(ResultTcType.Err _) true]
                  [_ false])
                (match (tc-lookup-unsafe-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                  [(ResultTcTypeUnsafe.Ok (AstType.I64) unsafe) unsafe]
                  [_ false])
                (tc-binding-c-abi-fnptr-id?
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  value-id)
                  [(ResultTcType.Ok (AstType.Bool)) true]
                  [_ false]))]
            (begin
              (tc-type-env-scoped-sidecar-restore! (&mut sidecar) mark)
              (and
                before-restore
                (= (tc-type-env-scoped-stack-len (struct-get sidecar stack)) 1)
                (=
                  (tc-type-env-scoped-stack-mark-count
                    (struct-get sidecar stack))
                  0)
                (=
                  (tc-type-env-scoped-stack-cache-generation
                    (struct-get sidecar stack))
                  (+ generation-before 1))
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar fn-id)
                  [(TcTypeEnvScopedLookup.Missing) true]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar value-id)
                  [(TcTypeEnvScopedLookup.Found
                      (AstType.I64)
                      unsafe
                      c-abi-fnptr
                      marker-kind
                      depth
                      _)
                    (and
                      (not unsafe)
                      (not c-abi-fnptr)
                      (tc-type-env-scoped-marker-kind-same?
                        marker-kind
                        TcTypeEnvScopedMarkerKind.None)
                      (= depth 0))]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  value-id)
                  [(ResultTcType.Ok (AstType.I64)) true]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                  [(ResultTcType.Err _) true]
                  [_ false])))))))))

(define (tc-type-env-scoped-carrier-bind-many
  [carrier : TcTypeEnvScopedCarrier]
  [count : i64]) : TcTypeEnvScopedCarrier
  (let
    [i : i64 0]
    [out : TcTypeEnvScopedCarrier carrier]
    (begin
      (while (< i count)
        (let
          [name : String (string.append "carrier-local" (string.int->string i))]
          (begin
            (set!
              out
              (tc-type-env-scoped-carrier-bind-id
                out
                (tc-generated-name-id name)
                (AstType.I64)))
            (set! i (+ i 1)))))
      out)))

(define (tc-type-env-scoped-carrier-region-matches-env?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-active-region carrier)
    [(TcMaybeNameId.Some sidecar-region)
      (match (tc-active-region (tc-type-env-scoped-carrier-env carrier))
        [(TcMaybeNameId.Some env-region) (= sidecar-region env-region)]
        [_ false])]
    [(TcMaybeNameId.No)
      (match (tc-active-region (tc-type-env-scoped-carrier-env carrier))
        [(TcMaybeNameId.No) true]
        [_ false])]))

(define (tc-type-env-scoped-carrier-return-matches-env?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-current-return-type carrier)
    [(ResultTcType.Ok carrier-ty)
      (match (tc-current-return-type (tc-type-env-scoped-carrier-env carrier))
        [(ResultTcType.Ok env-ty) (tc-type-eq carrier-ty env-ty)]
        [_ false])]
    [(ResultTcType.Err _)
      (match (tc-current-return-type (tc-type-env-scoped-carrier-env carrier))
        [(ResultTcType.Err _) true]
        [_ false])]))

(define (tc-type-env-scoped-carrier-smoke?) : bool
  (let
    [_outer-id : i64 (intern "outer")]
    [_inner-id : i64 (intern "inner")]
    [_resource-id : i64 (intern "resource")]
    [_arena-id : i64 (intern "arena")]
    [_atomic-id : i64 (intern "atomic")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-push-region-id (tc-empty-env) (intern "cached-base")))]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-env base)]
    [fn-id : i64 (intern "carrier-callback")]
    [callback-ty : AstType (tc-fn0 (AstType.I64))]
    (begin
      (set! carrier (tc-type-env-scoped-carrier-bind-default-boundary carrier))
      (set! carrier (tc-type-env-scoped-carrier-push-region carrier _outer-id))
      (set! carrier (tc-type-env-scoped-carrier-enter-unsafe carrier))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-return-type carrier (AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-cleanup-owner carrier _resource-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id
          carrier
          _resource-id
          (AstType.String)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-ordinary-arena-owner carrier _arena-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier _arena-id (AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-atomic-arena-owner carrier _atomic-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier _atomic-id (AstType.I64)))
      (let
        [outer-save : TcTypeEnvScopedCarrierSave
          (tc-type-env-scoped-carrier-save carrier)]
        [outer-mark : TcTypeEnvScopedCarrierMark (struct-get outer-save mark)]
        (begin
          (set! carrier (struct-get outer-save carrier))
          (set!
            carrier
            (tc-type-env-scoped-carrier-push-region carrier _inner-id))
          (set!
            carrier
            (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
              carrier
              fn-id
              callback-ty))
          (let
            [deep : TcTypeEnvScopedCarrier
              (tc-type-env-scoped-carrier-bind-many
                carrier
                (+ (* (tc-local-cache-threshold) 2) 8))]
            [snapshot : TcTypeEnvScopedCarrier
              (tc-type-env-scoped-carrier-from-marker-visible-env
                (tc-type-env-scoped-carrier-env deep))]
            [before-restore : bool
              (and
                (tc-type-env-scoped-carrier-region-matches-env? deep)
                (tc-type-env-scoped-carrier-return-matches-env? deep)
                (tc-type-env-scoped-carrier-in-unsafe? deep)
                (tc-in-unsafe? (tc-type-env-scoped-carrier-env deep))
                (match (tc-type-env-scoped-carrier-active-region deep)
                  [(TcMaybeNameId.Some region) (= region _inner-id)]
                  [_ false])
                (tc-cleanup-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _resource-id)
                (tc-ordinary-arena-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _arena-id)
                (tc-atomic-arena-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _atomic-id)
                (tc-type-env-scoped-carrier-in-unsafe? snapshot)
                (match (tc-type-env-scoped-carrier-active-region snapshot)
                  [(TcMaybeNameId.Some region) (= region _inner-id)]
                  [_ false])
                (match (tc-type-env-scoped-carrier-current-return-type snapshot)
                  [(ResultTcType.Ok (AstType.I64)) true]
                  [_ false])
                (tc-type-env-scoped-carrier-cleanup-owner-active?
                  snapshot
                  _resource-id)
                (tc-type-env-scoped-carrier-ordinary-arena-owner-active?
                  snapshot
                  _arena-id)
                (tc-type-env-scoped-carrier-atomic-arena-owner-active?
                  snapshot
                  _atomic-id)
                (tc-type-env-scoped-carrier-lifetime-visible-id?
                  snapshot
                  _arena-id)
                (tc-type-env-scoped-carrier-lifetime-visible-id?
                  snapshot
                  _resource-id)
                (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
                  snapshot
                  _resource-id
                  _arena-id)
                (not
                  (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
                    snapshot
                    _arena-id
                    _resource-id))
                (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
                  snapshot
                  _resource-id
                  _arena-id)
                (not
                  (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
                    snapshot
                    _arena-id
                    _resource-id))
                (tc-binding-unsafe-id?
                  (tc-type-env-scoped-carrier-env deep)
                  fn-id)
                (tc-binding-c-abi-fnptr-id?
                  (tc-type-env-scoped-carrier-env deep)
                  fn-id)
                (match (tc-type-env-scoped-sidecar-lookup-id
                  (tc-type-env-scoped-carrier-sidecar deep)
                  fn-id)
                  [(TcTypeEnvScopedLookup.Found
                      (AstType.Func _ _)
                      unsafe
                      c-abi-fnptr
                      _
                      _
                      _)
                    (and unsafe c-abi-fnptr)]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (struct-get (tc-type-env-scoped-carrier-sidecar deep) stack)
                  TcTypeEnvScopedMarkerKind.DefaultBoundary)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (AstType.Unit)
                      _
                      _)
                    (= marker-id (tc-default-boundary-id))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (struct-get (tc-type-env-scoped-carrier-sidecar deep) stack)
                  TcTypeEnvScopedMarkerKind.CleanupOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-cleanup-owner-marker-id))
                      (string.eq (intern-str owner) "resource"))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (struct-get (tc-type-env-scoped-carrier-sidecar deep) stack)
                  TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-ordinary-arena-owner-marker-id))
                      (string.eq (intern-str owner) "arena"))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (struct-get (tc-type-env-scoped-carrier-sidecar deep) stack)
                  TcTypeEnvScopedMarkerKind.AtomicArenaOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-atomic-arena-owner-marker-id))
                      (string.eq (intern-str owner) "atomic"))]
                  [_ false]))]
            (begin
              (set!
                carrier
                (tc-type-env-scoped-carrier-restore carrier outer-mark))
              (and
                before-restore
                (tc-type-env-scoped-carrier-region-matches-env? carrier)
                (tc-type-env-scoped-carrier-return-matches-env? carrier)
                (match (tc-type-env-scoped-carrier-active-region carrier)
                  [(TcMaybeNameId.Some region) (= region _outer-id)]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id
                  (tc-type-env-scoped-carrier-sidecar carrier)
                  fn-id)
                  [(TcTypeEnvScopedLookup.Missing) true]
                  [_ false])
                (not
                  (tc-binding-c-abi-fnptr-id?
                    (tc-type-env-scoped-carrier-env carrier)
                    fn-id))))))))))

(cfg
  test
  (define (tc-type-env-scoped-runtime-smoke?) : bool
    (let
      [was-active : bool (tc-type-env-scoped-runtime-active?)]
      [outer-id : i64 (intern "outer")]
      [inner-id : i64 (intern "inner")]
      [resource-id : i64 (intern "resource")]
      [runtime-tail-id : i64 (intern "runtime-tail")]
      [runtime-unsafe-id : i64 (intern "runtime-unsafe")]
      [runtime-callback-id : i64 (intern "runtime-callback")]
      [base-env : TcTypeEnv
        (tc-bind-return-type
          (tc-push-region-id
            (tc-enter-unsafe
              (tc-bind-id (tc-default-env) runtime-tail-id (AstType.String)))
            outer-id)
          (AstType.I64))]
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-from-env base-env)]
      [outer-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-enter! carrier)]
      [runtime-env : TcTypeEnv
        (tc-bind-id
          (tc-bind-cleanup-owner base-env resource-id)
          resource-id
          (AstType.String))]
      [scope-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-save)]
      [unsafe-env : TcTypeEnv
        (tc-bind-unsafe-id runtime-env runtime-unsafe-id (AstType.I64))]
      [c-abi-env : TcTypeEnv
        (tc-bind-c-abi-fnptr-id
          unsafe-env
          runtime-callback-id
          (tc-fn0 (AstType.I64)))]
      [shadow-env : TcTypeEnv
        (tc-bind-id
          c-abi-env
          cbi.compiler-builtin-id-tl-private-string-length
          (tc-fn1 (AstType.I64) (AstType.I64)))]
      [inner-env : TcTypeEnv (tc-push-region-id shadow-env inner-id)]
      [inner-ok : bool
        (and
          (match (tc-active-region inner-env)
            [(TcMaybeNameId.Some region) (= region inner-id)]
            [_ false])
          (match (tc-lookup-id inner-env runtime-tail-id)
            [(ResultTcType.Ok (AstType.String)) true]
            [_ false])
          (match (tc-lookup-id inner-env runtime-unsafe-id)
            [(ResultTcType.Ok (AstType.I64)) true]
            [_ false])
          (tc-name-bound-id? inner-env runtime-unsafe-id)
          (match (tc-lookup-unsafe-id inner-env runtime-unsafe-id)
            [(ResultTcTypeUnsafe.Ok (AstType.I64) unsafe) unsafe]
            [_ false])
          (tc-binding-c-abi-fnptr-id? inner-env runtime-callback-id)
          (not
            (tc-default-builtin-unshadowed-id?
              inner-env
              cbi.compiler-builtin-id-tl-private-string-length)))]
      (begin
        (tc-type-env-scoped-runtime-restore! scope-save)
        (let
          [restored-ok : bool
            (and
              (match (tc-active-region runtime-env)
                [(TcMaybeNameId.Some region) (= region outer-id)]
                [_ false])
              (match (tc-current-return-type runtime-env)
                [(ResultTcType.Ok (AstType.I64)) true]
                [_ false])
              (tc-in-unsafe? runtime-env)
              (tc-cleanup-owner-active-id? runtime-env resource-id)
              (match (tc-lookup-id runtime-env runtime-tail-id)
                [(ResultTcType.Ok (AstType.String)) true]
                [_ false])
              (match (tc-lookup-id runtime-env runtime-unsafe-id)
                [(ResultTcType.Err _) true]
                [_ false])
              (not (tc-name-bound-id? runtime-env runtime-unsafe-id))
              (not (tc-binding-c-abi-fnptr-id? runtime-env runtime-callback-id))
              (tc-default-builtin-unshadowed-id?
                runtime-env
                cbi.compiler-builtin-id-tl-private-string-length))]
          (begin
            (tc-type-env-scoped-runtime-restore! outer-save)
            (and
              (not was-active)
              (not (tc-type-env-scoped-runtime-active?))
              inner-ok
              restored-ok)))))))

(define (tc-type-env-scoped-primary-storage-smoke?) : bool
  (let
    [tail-only-id : i64 (tc-generated-name-id "tail-only")]
    [shadow-id : i64 (tc-generated-name-id "shadow")]
    [alias-id : i64 (tc-generated-name-id "alias")]
    [hygiene-id : i64 (tc-generated-name-id "hygiene-value")]
    [mirrored-id : i64 (tc-generated-name-id "mirrored")]
    [fresh-id : i64 (tc-generated-name-id "fresh")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) tail-only-id (AstType.String)))]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-env base)]
    [fn-id : i64 (tc-generated-name-id "scoped-primary-fn")]
    (begin
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier shadow-id (AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier shadow-id (AstType.Bool)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-alias-id-if-free
          carrier
          shadow-id
          (AstType.String)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-alias-id-if-free
          carrier
          alias-id
          (AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
          carrier
          fn-id
          (tc-fn0 (AstType.I64))))
      (let
        [snapshot : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
        [default-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-env
              (tc-env-with-cache (tc-default-env)))
            cbi.compiler-builtin-id-tl-private-string-length
            (tc-fn1 (AstType.I64) (AstType.I64)))]
        [hygiene-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-env
              (tc-hygiene-global-env
                (tc-bind-id (tc-empty-env) hygiene-id (AstType.I64))))
            hygiene-id
            (AstType.Bool))]
        [mirrored-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-marker-visible-env
              (tc-bind-id (tc-empty-env) mirrored-id (AstType.I64)))
            fresh-id
            (AstType.Bool))]
        [mirrored-snapshot : TcTypeEnv
          (tc-type-env-scoped-carrier-env mirrored-carrier)]
        (and
          (match (tc-type-env-scoped-carrier-lookup-id carrier tail-only-id)
            [(ResultTcType.Ok (AstType.String)) true]
            [_ false])
          (match (tc-type-env-scoped-carrier-lookup-id carrier shadow-id)
            [(ResultTcType.Ok (AstType.Bool)) true]
            [_ false])
          (match (tc-type-env-scoped-carrier-lookup-id carrier alias-id)
            [(ResultTcType.Ok (AstType.I64)) true]
            [_ false])
          (tc-type-env-scoped-carrier-binding-unsafe-id? carrier fn-id)
          (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id? carrier fn-id)
          (match (tc-lookup-id snapshot tail-only-id)
            [(ResultTcType.Ok (AstType.String)) true]
            [_ false])
          (match (tc-lookup-id snapshot shadow-id)
            [(ResultTcType.Ok (AstType.Bool)) true]
            [_ false])
          (tc-binding-unsafe-id? snapshot fn-id)
          (tc-binding-c-abi-fnptr-id? snapshot fn-id)
          (not
            (tc-default-builtin-unshadowed-id?
              (tc-type-env-scoped-carrier-env default-carrier)
              cbi.compiler-builtin-id-tl-private-string-length))
          (match (tc-lookup-hygiene-global-id
            (tc-type-env-scoped-carrier-env hygiene-carrier)
            hygiene-id)
            [(ResultTcType.Ok (AstType.I64)) true]
            [_ false])
          (= (tc-ordinary-binding-rank-id-from mirrored-snapshot fresh-id 0) 0)
          (=
            (tc-ordinary-binding-rank-id-from mirrored-snapshot mirrored-id 0)
            1))))))

(define (tc-type-env-scoped-stack-smoke?) : bool
  (begin
    (cbi.compiler-builtin-initialize-for-parse!)
    (and
      (tc-type-env-scoped-stack-grow-smoke?)
      (tc-type-env-scoped-stack-sparse-cache-repair-smoke?)
      (tc-type-env-scoped-sidecar-smoke?)
      (tc-type-env-scoped-carrier-smoke?)
      (tc-type-env-scoped-primary-storage-smoke?)
      (cfg test (tc-type-env-scoped-runtime-smoke?) true))))

(test
  tc-type-env-scoped-stack
  (if (tc-type-env-scoped-stack-smoke?)
    unit
    (io.panic "typecheck: scoped type env smoke failed")))

(define (tc-type-env-walker-api-smoke?) : bool
  (let
    [lookup-base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (intern "global") (AstType.String)))]
    [lookup-local : TcTypeEnv
      (tc-bind-id lookup-base (intern "local") (AstType.I64))]
    [lookup-deep : TcTypeEnv
      (tc-type-env-bind-many lookup-local (+ (tc-local-cache-threshold) 4))]
    [marker-base : TcTypeEnv
      (tc-env-with-cache (tc-push-region-id (tc-empty-env) (intern "outer")))]
    [inner-id : i64 (intern "inner")]
    [marker-local : TcTypeEnv (tc-push-region-id marker-base inner-id)]
    [marker-deep : TcTypeEnv
      (tc-type-env-bind-many
        marker-local
        (+ (* (tc-local-cache-threshold) 2) 8))]
    [marker-scoped : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-marker-visible-env marker-deep)]
    [unsafe-env : TcTypeEnv
      (tc-bind-unsafe-id (tc-empty-env) (intern "unsafe-value") (AstType.I64))]
    [hygiene-top : TcTypeEnv
      (tc-bind-id (tc-empty-env) (intern "visible") (AstType.I64))]
    [hygiene-root : TcTypeEnv (tc-hygiene-global-env hygiene-top)]
    [hygiene-env : TcTypeEnv
      (tc-bind-id hygiene-root (intern "visible") (AstType.Bool))]
    (and
      (match (tc-type-env-lookup-step lookup-local (intern "local"))
        [(TcTypeEnvLookupStep.Found (AstType.I64)) true]
        [_ false])
      (match (tc-type-env-lookup-step lookup-local (intern "global"))
        [(TcTypeEnvLookupStep.Miss rest-env)
          (match (tc-type-env-lookup-step rest-env (intern "global"))
            [(TcTypeEnvLookupStep.Found (AstType.String)) true]
            [_ false])]
        [_ false])
      (match (tc-type-env-marker-step (tc-type-env-marker-start marker-local))
        [(TcTypeEnvMarkerStep.Bind key (AstType.Var region) _)
          (and (= key (tc-region-marker-id)) (= region inner-id))]
        [_ false])
      (match (tc-type-env-scoped-marker-step
        (tc-type-env-scoped-carrier-marker-cursor marker-scoped))
        [(TcTypeEnvScopedMarkerStep.Bind key (AstType.I64) _)
          (=
            key
            (intern
              (string.append
                "local"
                (string.int->string
                  (- (+ (* (tc-local-cache-threshold) 2) 8) 1)))))]
        [_ false])
      (match (tc-type-env-unsafe-lookup-step unsafe-env (intern "unsafe-value"))
        [(TcTypeEnvUnsafeLookupStep.Found (AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-ptr-addr-of-local-lookup hygiene-env (intern "visible"))
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-ptr-addr-of-local-lookup hygiene-root (intern "visible"))
        [(ResultTcType.Err _) true]
        [_ false])
      (match (tc-lookup-id lookup-deep (intern "global"))
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup-id lookup-deep (intern "local"))
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region marker-deep)
        [(TcMaybeNameId.Some region) (= region (intern "inner"))]
        [_ false])
      (tc-lifetime-visible-id? marker-deep (intern "inner"))
      (not (tc-lifetime-visible-id? marker-deep (intern "outer")))
      (match (tc-lookup-id hygiene-env (intern "visible"))
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-lookup-hygiene-global-id hygiene-env (intern "visible"))
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false]))))

