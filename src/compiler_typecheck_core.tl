(define (tc-return-type-name) : String
  "__tl_return_type")

(define tc-return-type-id-cache : i64
  -1)
(define tc-return-type-id-cache-generation : i64
  -1)

(define (tc-return-type-id) : i64
  (if (= tc-return-type-id-cache-generation (intern-generation))
    tc-return-type-id-cache
    (let
      [id : i64 (tc-name-id (tc-return-type-name))]
      (begin
        (set! tc-return-type-id-cache id)
        (set! tc-return-type-id-cache-generation (intern-generation))
        id))))

(define (tc-hygiene-global-boundary-name) : String
  "__tl_hygiene_global_boundary")

(define tc-hygiene-global-boundary-id-cache : i64
  -1)
(define tc-hygiene-global-boundary-id-cache-generation : i64
  -1)

(define (tc-hygiene-global-boundary-id) : i64
  (if (= tc-hygiene-global-boundary-id-cache-generation (intern-generation))
    tc-hygiene-global-boundary-id-cache
    (let
      [id : i64 (tc-name-id (tc-hygiene-global-boundary-name))]
      (begin
        (set! tc-hygiene-global-boundary-id-cache id)
        (set!
          tc-hygiene-global-boundary-id-cache-generation
          (intern-generation))
        id))))

(define (tc-hygiene-template-prefix) : String
  "__tl_macro_template$")

(define (tc-hygiene-global-prefix) : String
  "__tl_macro_global$")

(define (tc-hygiene-local-prefix) : String
  "__tl_macro_local$")

(defenum TcHygieneGlobalName
  (TcHygieneLegacyGlobal String)
  (TcHygieneContextGlobal String String))

(define tc-hygiene-active-top-env-ready : bool
  false)

(define (tc-empty-type-env) : TcTypeEnv
  TcTypeNil)

(define (tc-empty-module-local-env-cache) : TcModuleLocalEnvCache
  TcModuleLocalEnvNil)

(define tc-hygiene-active-top-env : TcTypeEnv
  (tc-empty-type-env))
(define tc-hygiene-module-env-cache : TcModuleLocalEnvCache
  (tc-empty-module-local-env-cache))

;; #2357: arena that owns the module-local env cache chain. The cache lives in
;; the GLOBAL above, but hygiene lookups fire deep inside per-decl typechecking
;; whose allocations land in scratch arenas; the cache's (box ...) cells and
;; the cached env internals allocated there dangle once the scratch arena is
;; reclaimed, and a later arena.tl_arena_make reuses the pages (observed: a fresh
;; arena header written over a live cache node, then a garbage module String
;; crashing string.string-eq). Build cache entries inside this dedicated persistent
;; arena instead (same idiom as the node pools' base arena).
(define tc-hygiene-module-env-cache-arena : i64
  0)

(define (tc-hygiene-module-env-cache-arena-handle) : i64
  (begin
    (if (= tc-hygiene-module-env-cache-arena 0)
      (set! tc-hygiene-module-env-cache-arena (arena.tl_arena_make))
      unit)
    tc-hygiene-module-env-cache-arena))

(define (tc-hygiene-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (if (= (string.string-ref text 0) (string.string-ref prefix 0))
        (string.string-eq (string.substring text 0 prefix-len) prefix)
        false))))

(define (tc-hygiene-name-base [name : String] [prefix : String]) : String
  (string.substring
    name
    (string.string-length prefix)
    (- (string.string-length name) (string.string-length prefix))))

(define (tc-hygiene-template-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-template-prefix)))

(define (tc-hygiene-template-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-template-prefix)))

(define (tc-hygiene-global-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-global-prefix)))

(define (tc-hygiene-local-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-local-prefix)))

(define (tc-hygiene-global-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-global-prefix)))

(define (tc-hygiene-global-name [name : String]) : String
  (string.string-append (tc-hygiene-global-prefix) name))

(define (tc-hygiene-global-context-name [module : String] [name : String]) : String
  (tc-hygiene-global-name (str_cat.str-cat module "|" name)))

(define (tc-hygiene-context-separator-index [payload : String]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length payload)]
    [found : i64 -1]
    (begin
      (while (and (< i n) (< found 0))
        (if (= (cast (string.string-ref payload i) : i64) 124)
          (set! found i)
          (set! i (+ i 1))))
      found)))

(define (tc-hygiene-global-decode [name : String]) : TcHygieneGlobalName
  (let
    [payload : String (tc-hygiene-global-base name)]
    [sep : i64 (tc-hygiene-context-separator-index payload)]
    (if (< sep 0)
      (TcHygieneLegacyGlobal payload)
      (let
        [start : i64 (+ sep 1)]
        (TcHygieneContextGlobal
          (string.substring payload 0 sep)
          (string.substring
            payload
            start
            (- (string.string-length payload) start)))))))

(define (tc-hygiene-global-call-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneLegacyGlobal lookup-name) lookup-name]
      [(TcHygieneContextGlobal _ lookup-name) lookup-name])
    name))

(define (tc-hygiene-global-symbol-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneLegacyGlobal lookup-name) lookup-name]
      [(TcHygieneContextGlobal module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (compiler-symbol-module-key module lookup-name))])
    name))

(define (tc-hygiene-global-env [top-env : TcTypeEnv]) : TcTypeEnv
  (tc-bind top-env (tc-hygiene-global-boundary-name) (AstTyUnit)))

(define (tc-hygiene-reset-active-top-env! [top-env : TcTypeEnv]) : unit
  (begin
    (set! tc-hygiene-active-top-env top-env)
    (set! tc-hygiene-active-top-env-ready true)
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    ;; #2357: release the persistent cache arena with the chain it owns; the
    ;; next cache miss creates a fresh one (keeps batch compiles from leaking
    ;; one arena's worth of dead cache entries per program).
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))))

(define (tc-unsafe-marker-name) : String
  " __tl_unsafe_context")

(define tc-unsafe-marker-id-cache : i64
  -1)
(define tc-unsafe-marker-id-cache-generation : i64
  -1)

(define (tc-unsafe-marker-id) : i64
  (if (= tc-unsafe-marker-id-cache-generation (intern-generation))
    tc-unsafe-marker-id-cache
    (let
      [id : i64 (tc-name-id (tc-unsafe-marker-name))]
      (begin
        (set! tc-unsafe-marker-id-cache id)
        (set! tc-unsafe-marker-id-cache-generation (intern-generation))
        id))))

(define (tc-enter-unsafe [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind env (tc-unsafe-marker-name) (AstTyUnit)))

(define (tc-in-unsafe-scan? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-in-unsafe-scan? (box-get rest))
        false)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-unsafe-marker-id))
        true
        (tc-in-unsafe-scan? (box-get rest)))]))

(define (tc-in-unsafe? [env : TcTypeEnv]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _) (tc-in-unsafe-scan? (box-get rest))]
      [_ (tc-in-unsafe-scan? env)])))

(define tc-unused-unsafe-tracking-enabled : bool
  false)
(define tc-unused-unsafe-current-block : i64
  -1)
(define tc-unused-unsafe-current-path : String
  "")
(define tc-unused-unsafe-target-path : String
  "")
(define tc-unused-unsafe-block-spans : (Array AstSourceSpan)
  (array.make-array AstSourceSpan 128))
(define tc-unused-unsafe-block-paths : (Array String)
  (array.make-array String 128))
(define tc-unused-unsafe-block-used : (Array bool)
  (array.make-array bool 128))
(define tc-unused-unsafe-block-len : i64
  0)

(define (tc-unused-unsafe-no-span) : AstSourceSpan
  (AstSourceSpan 0 0 0 0))

(define (tc-unused-unsafe-tracking-reset! [path : String]) : unit
  (begin
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path path)
    (set! tc-unused-unsafe-block-len 0)
    (set! tc-unused-unsafe-tracking-enabled true)))

(define (tc-unused-unsafe-tracking-disable!) : unit
  (begin
    (set! tc-unused-unsafe-tracking-enabled false)
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path "")))

(define (tc-unused-unsafe-block-count) : i64
  tc-unused-unsafe-block-len)

(define (tc-unused-unsafe-block-path [index : i64]) : String
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array.array-ref tc-unused-unsafe-block-paths index)
    ""))

(define (tc-unused-unsafe-block-span [index : i64]) : AstSourceSpan
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array.array-ref tc-unused-unsafe-block-spans index)
    (tc-unused-unsafe-no-span)))

(define (tc-unused-unsafe-block-used? [index : i64]) : bool
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array.array-ref tc-unused-unsafe-block-used index)
    false))

(define (tc-unused-unsafe-set-current-path! [path : String]) : String
  (let
    [prev : String tc-unused-unsafe-current-path]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (set! tc-unused-unsafe-current-path path)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-current-path! [path : String]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-path path)
    unit))

(define (tc-unused-unsafe-span-eq? [a : AstSourceSpan] [b : AstSourceSpan]) : bool
  (and
    (= (struct-get a start-line) (struct-get b start-line))
    (= (struct-get a start-col) (struct-get b start-col))
    (= (struct-get a end-line) (struct-get b end-line))
    (= (struct-get a end-col) (struct-get b end-col))))

(define (tc-unused-unsafe-find-existing
  [path : String]
  [span : AstSourceSpan]
  [index : i64]) : i64
  (if (>= index tc-unused-unsafe-block-len)
    -1
    (if (and
      (string.string-eq
        (array.array-ref tc-unused-unsafe-block-paths index)
        path)
      (tc-unused-unsafe-span-eq?
        (array.array-ref tc-unused-unsafe-block-spans index)
        span))
      index
      (tc-unused-unsafe-find-existing path span (+ index 1)))))

(define (tc-unused-unsafe-grow-copy
  [new-spans : (Array AstSourceSpan)]
  [new-paths : (Array String)]
  [new-used : (Array bool)]
  [index : i64]) : unit
  (if (>= index tc-unused-unsafe-block-len)
    unit
    (begin
      (array.array-set!
        new-spans
        index
        (array.array-ref tc-unused-unsafe-block-spans index))
      (array.array-set!
        new-paths
        index
        (array.array-ref tc-unused-unsafe-block-paths index))
      (array.array-set!
        new-used
        index
        (array.array-ref tc-unused-unsafe-block-used index))
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used (+ index 1)))))

(define (tc-unused-unsafe-grow!) : unit
  (let
    [old-cap : i64 (array.array-length tc-unused-unsafe-block-spans)]
    [new-cap : i64 (* old-cap 2)]
    [new-spans : (Array AstSourceSpan) (array.make-array AstSourceSpan new-cap)]
    [new-paths : (Array String) (array.make-array String new-cap)]
    [new-used : (Array bool) (array.make-array bool new-cap)]
    (begin
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used 0)
      (set! tc-unused-unsafe-block-spans new-spans)
      (set! tc-unused-unsafe-block-paths new-paths)
      (set! tc-unused-unsafe-block-used new-used))))

(define (tc-unused-unsafe-push [span : AstSourceSpan]) : i64
  (let
    [existing : i64
      (tc-unused-unsafe-find-existing tc-unused-unsafe-current-path span 0)]
    (if (>= existing 0)
      existing
      (let
        [slot : i64 tc-unused-unsafe-block-len]
        (begin
          (if (>= slot (array.array-length tc-unused-unsafe-block-spans))
            (tc-unused-unsafe-grow!)
            unit)
          (array.array-set! tc-unused-unsafe-block-spans slot span)
          (array.array-set!
            tc-unused-unsafe-block-paths
            slot
            tc-unused-unsafe-current-path)
          (array.array-set! tc-unused-unsafe-block-used slot false)
          (set! tc-unused-unsafe-block-len (+ tc-unused-unsafe-block-len 1))
          slot)))))

(define (tc-unused-unsafe-enter-block [span : TcMaybeAstSourceSpan]) : i64
  (let
    [prev : i64 tc-unused-unsafe-current-block]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (if (string.string-eq
          tc-unused-unsafe-current-path
          tc-unused-unsafe-target-path)
          (match span
            [(TcSomeAstSourceSpan real-span)
              (set!
                tc-unused-unsafe-current-block
                (tc-unused-unsafe-push real-span))]
            [(TcNoAstSourceSpan) unit])
          unit)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-block! [prev : i64]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-block prev)
    unit))

(define (tc-unused-unsafe-mark-current-used!) : unit
  (if (and
    tc-unused-unsafe-tracking-enabled
    (>= tc-unused-unsafe-current-block 0)
    (< tc-unused-unsafe-current-block tc-unused-unsafe-block-len))
    (array.array-set!
      tc-unused-unsafe-block-used
      tc-unused-unsafe-current-block
      true)
    unit))

(define (tc-unsafe-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected : AstType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType
      (tc-begin-list-with-expected ctx (tc-enter-unsafe env) exprs expected)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-unsafe-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType (tc-begin-list ctx (tc-enter-unsafe env) exprs)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-bind-return-type [env : TcTypeEnv] [ty : AstType]) : TcTypeEnv
  (tc-bind env (tc-return-type-name) ty))

(define (tc-current-return-type-scan [env : TcTypeEnv]) : ResultTcType
  (match env
    [(TcTypeNil)
      (ErrTcType "typecheck: try requires enclosing Result-like function")]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-current-return-type-scan (box-get rest))
        (ErrTcType "typecheck: try requires enclosing Result-like function"))]
    [(TcTypeBind key ty rest)
      (if (= key (tc-return-type-id))
        (OkTcType ty)
        (tc-current-return-type-scan (box-get rest)))]))

(define (tc-current-return-type [env : TcTypeEnv]) : ResultTcType
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-current-return-type-scan (box-get rest))]
      [_ (tc-current-return-type-scan env)])))

(define (tc-type-list1 [a : AstType]) : AstTypeList
  (ast-type-cons a AstTypeNil))

(define (tc-type-list2 [a : AstType] [b : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b AstTypeNil)))

(define (tc-type-list3 [a : AstType] [b : AstType] [c : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b (ast-type-cons c AstTypeNil))))

(define (tc-type-list1-with-pools [pools : AstNodePoolContext] [a : AstType]) : AstTypeList
  (ast-type-cons-with-pools pools a AstTypeNil))

(define (tc-type-list2-with-pools
  [pools : AstNodePoolContext]
  [a : AstType]
  [b : AstType]) : AstTypeList
  (let
    [rest : AstTypeList (ast-type-cons-with-pools pools b AstTypeNil)]
    (ast-type-cons-with-pools pools a rest)))

(define (tc-type-list3-with-pools
  [pools : AstNodePoolContext]
  [a : AstType]
  [b : AstType]
  [c : AstType]) : AstTypeList
  (let
    [tail : AstTypeList (ast-type-cons-with-pools pools c AstTypeNil)]
    [rest : AstTypeList (ast-type-cons-with-pools pools b tail)]
    (ast-type-cons-with-pools pools a rest)))

(define (tc-fn0 [ret : AstType]) : AstType
  (ast-ty-func AstTypeNil ret))

(define (tc-fn1 [a : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list1 a) ret))

(define (tc-fn2 [a : AstType] [b : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list2 a b) ret))

(define (tc-fn3 [a : AstType] [b : AstType] [c : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list3 a b c) ret))

(define (tc-type-list-render [types : AstTypeList]) : String
  (match types
    [(AstTypeNil) ""]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (str_cat.str-cat
          (tc-type-render head)
          (match rest
            [(AstTypeNil) ""]
            [_ (str_cat.str-cat " " (tc-type-list-render rest))])))]))

(define (tc-lifetime-list-render [lifetimes : AstLifetimeList]) : String
  (match lifetimes
    [(AstLifetimeNil) ""]
    [(AstLifetimeCons head rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (str_cat.str-cat
          head
          (match rest
            [(AstLifetimeNil) ""]
            [_ (str_cat.str-cat " " (tc-lifetime-list-render rest))])))]))

(define (tc-render-nominal-lifetime-type
  [name : String]
  [lifetimes : AstLifetimeList]) : String
  (str_cat.str-cat "(" name " " (tc-lifetime-list-render lifetimes) ")"))

(define (tc-type-render [ty : AstType]) : String
  (match ty
    [(AstTyI64) "i64"]
    [(AstTyI32) "i32"]
    [(AstTyI16) "i16"]
    [(AstTyI8) "i8"]
    [(AstTyU64) "u64"]
    [(AstTyU32) "u32"]
    [(AstTyU16) "u16"]
    [(AstTyU8) "u8"]
    [(AstTyF64) "f64"]
    [(AstTyF32) "f32"]
    [(AstTyBool) "bool"]
    [(AstTyChar) "char"]
    [(AstTyString) "String"]
    [(AstTyStr) "str"]
    [(AstTyBytes) "bytes"]
    [(AstTyUnit) "unit"]
    [(AstTyNever) "never"]
    [(AstTyExpr) "Expr"]
    [(AstTyExprList) "ExprList"]
    [(AstTyFunc args ret)
      (str_cat.str-cat
        "(-> "
        (tc-type-list-render (box-get args))
        " "
        (tc-type-render (ty-node-get ret))
        ")")]
    [(AstTyTuple elems)
      (str_cat.str-cat "(Tuple " (tc-type-list-render (box-get elems)) ")")]
    [(AstTyArray elem count)
      (str_cat.str-cat
        "(Array "
        (tc-type-render (ty-node-get elem))
        " "
        (string.int->string count)
        ")")]
    [(AstTyDynArray elem)
      (str_cat.str-cat "(Array " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyBox elem)
      (str_cat.str-cat "(Box " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyPtr elem)
      (str_cat.str-cat "(Ptr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyMutPtr elem)
      (str_cat.str-cat "(MutPtr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyRef region inner)
      (str_cat.str-cat
        "(& "
        region
        " "
        (tc-type-render (ty-node-get inner))
        ")")]
    [(AstTyMutRef region inner)
      (str_cat.str-cat
        "(&mut "
        region
        " "
        (tc-type-render (ty-node-get inner))
        ")")]
    [(AstTyRegion region inner)
      (str_cat.str-cat
        "(Region "
        region
        " "
        (tc-type-render (ty-node-get inner))
        ")")]
    [(AstTyEnum name) (intern-str name)]
    [(AstTyEnumArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]
    [(AstTyStruct name) (intern-str name)]
    [(AstTyStructArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]
    [(AstTyVar name) (intern-str name)]
    [(AstTyVarArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]))

(define (tc-default-env) : TcTypeEnv
  (tc-bind (tc-default-env-base) (tc-default-boundary-name) (AstTyUnit)))

(define (tc-default-env-base) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env)]
    [e1 : TcTypeEnv
      (tc-bind
        e0
        "cpuid"
        (tc-fn2
          (AstTyI64)
          (AstTyI64)
          (ast-ty-tuple
            (ast-type-cons
              (AstTyI32)
              (ast-type-cons
                (AstTyI32)
                (ast-type-cons
                  (AstTyI32)
                  (ast-type-cons (AstTyI32) (AstTypeNil))))))))]
    [e2 : TcTypeEnv (tc-bind e1 "xgetbv" (tc-fn1 (AstTyI64) (AstTyI64)))]
    (tc-bind e2 (tc-default-boundary-name) (AstTyUnit))))

(define (tc-macro-expr-clause-type) : AstType
  (AstTyVar (intern "ExprClause")))

(define (tc-macro-expr-clause-list-type) : AstType
  (AstTyVar (intern "ExprClauseList")))

(define (tc-macro-expr-binding-clause-type) : AstType
  (AstTyVar (intern "ExprBindingClause")))

(define (tc-macro-expr-binding-clause-list-type) : AstType
  (AstTyVar (intern "ExprBindingClauseList")))

(define (tc-macro-expr-clause-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprClause"))]
    [_ false]))

(define (tc-macro-expr-clause-list-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprClauseList"))]
    [_ false]))

(define (tc-macro-expr-binding-clause-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprBindingClause"))]
    [_ false]))

(define (tc-macro-expr-binding-clause-list-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprBindingClauseList"))]
    [_ false]))

(define (tc-macro-type-param-kind? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "type"))]
    [_ false]))

(define (tc-macro-module-param-kind? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Module" "module"))

(define (tc-type-unquote-marker? [ty : AstType]) : bool
  (match ty
    [(AstTyVarArgs name _) (= name (intern "unquote"))]
    [_ false]))

(define (tc-stdlib-comptime-module-name) : String
  "stdlib.comptime")

(define (tc-stdlib-comptime-type-key [name : String]) : String
  (compiler-symbol-module-key (tc-stdlib-comptime-module-name) name))

(define (tc-stdlib-comptime-type-display-name [name : String]) : String
  (str_cat.str-cat (tc-stdlib-comptime-module-name) "." name))

(define (tc-stdlib-comptime-syntax-type [canonical-name : String]) : AstMaybeType
  (cond
    [(string.string-eq canonical-name (tc-stdlib-comptime-type-key "Expr"))
      (AstSomeType (AstTyExpr))]
    [(string.string-eq canonical-name (tc-stdlib-comptime-type-key "ExprList"))
      (AstSomeType (AstTyExprList))]
    [(string.string-eq
        canonical-name
        (tc-stdlib-comptime-type-key "ExprClause"))
      (AstSomeType (tc-macro-expr-clause-type))]
    [(string.string-eq
        canonical-name
        (tc-stdlib-comptime-type-key "ExprClauseList"))
      (AstSomeType (tc-macro-expr-clause-list-type))]
    [(string.string-eq
        canonical-name
        (tc-stdlib-comptime-type-key "ExprBindingClause"))
      (AstSomeType (tc-macro-expr-binding-clause-type))]
    [(string.string-eq
        canonical-name
        (tc-stdlib-comptime-type-key "ExprBindingClauseList"))
      (AstSomeType (tc-macro-expr-binding-clause-list-type))]
    [else (AstNoType)]))

(defenum TcStdlibTypeSpec
  (TcStdlibTyI64)
  (TcStdlibTyBool)
  (TcStdlibTyString)
  (TcStdlibTyName String)
  (TcStdlibTyBoxName String)
  (TcStdlibTyArrayName String))

(defenum TcStdlibTypeSpecList
  (TcStdlibTypeSpecNil)
  (TcStdlibTypeSpecCons TcStdlibTypeSpec (Box TcStdlibTypeSpecList)))

(defenum TcStdlibFieldSpecList
  (TcStdlibFieldSpecNil)
  (TcStdlibFieldSpecCons String TcStdlibTypeSpec (Box TcStdlibFieldSpecList)))

(defenum TcStdlibVariantSpecList
  (TcStdlibVariantSpecNil)
  (TcStdlibVariantSpecCons
    String
    TcStdlibTypeSpecList
    (Box TcStdlibVariantSpecList)))

(define (tc-stdlib-type-spec-list1 [a : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecCons a (box (TcStdlibTypeSpecNil))))

(define (tc-stdlib-type-spec-list2
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecCons
    a
    (box (TcStdlibTypeSpecCons b (box (TcStdlibTypeSpecNil))))))

(define (tc-stdlib-type-spec-list3
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]
  [c : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecCons
    a
    (box
      (TcStdlibTypeSpecCons
        b
        (box (TcStdlibTypeSpecCons c (box (TcStdlibTypeSpecNil))))))))

(define (tc-stdlib-field-spec-cons
  [name : String]
  [ty : TcStdlibTypeSpec]
  [rest : TcStdlibFieldSpecList]) : TcStdlibFieldSpecList
  (begin
    (cfg compile-profile (tc-lp-note 8))
    (TcStdlibFieldSpecCons name ty (box rest))))

(define (tc-stdlib-variant-spec-cons
  [name : String]
  [payloads : TcStdlibTypeSpecList]
  [rest : TcStdlibVariantSpecList]) : TcStdlibVariantSpecList
  (begin
    (cfg compile-profile (tc-lp-note 10))
    (TcStdlibVariantSpecCons name payloads (box rest))))

(define (tc-stdlib-name-type [name : String]) : AstType
  (AstTyVar (intern name)))

(define (tc-stdlib-well-known-mismatch [type-name : String] [detail : String]) : ResultTcUnit
  (ErrTcUnit
    (str_cat.str-cat
      "typecheck: stdlib well-known type mismatch for "
      (tc-stdlib-comptime-type-display-name type-name)
      ": "
      detail)))

(define (tc-stdlib-comptime-plain-declaration-message) : String
  "expected plain stdlib.comptime well-known declaration")

(define (tc-stdlib-comptime-well-known-type? [type-name : String]) : bool
  (or
    (string.string-eq type-name "Expr")
    (string.string-eq type-name "ExprList")
    (string.string-eq type-name "ExprClause")
    (string.string-eq type-name "ExprClauseList")
    (string.string-eq type-name "ExprBindingClause")
    (string.string-eq type-name "ExprBindingClauseList")
    (string.string-eq type-name "TypeInfo")
    (string.string-eq type-name "TypeInfoList")
    (string.string-eq type-name "TypeField")
    (string.string-eq type-name "TypeFieldList")
    (string.string-eq type-name "TypeVariantPayload")
    (string.string-eq type-name "TypeVariantPayloadList")
    (string.string-eq type-name "TypeVariant")
    (string.string-eq type-name "TypeVariantList")
    (string.string-eq type-name "TypeParam")
    (string.string-eq type-name "TypeParamList")))

(define (tc-stdlib-comptime-raw-type-name [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDeclComptimeDecl _ template-box)
      (tc-stdlib-comptime-raw-type-name (box-get template-box))]
    [(AstDeclUnsafe inner-box)
      (tc-stdlib-comptime-raw-type-name (box-get inner-box))]
    [(AstDeclDefEnum name _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefEnumLifetimes name _ _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefStruct name _ _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefStructLifetimes name _ _ _ _) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (tc-stdlib-comptime-raw-comptime-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclComptimeDecl _ _) true]
    [(AstDeclUnsafe inner-box)
      (tc-stdlib-comptime-raw-comptime-decl? (box-get inner-box))]
    [_ false]))

(define (tc-stdlib-check-comptime-declaration-surface-decl
  [module : String]
  [decl : AstDecl]) : ResultTcUnit
  (if (not (string.string-eq module (tc-stdlib-comptime-module-name)))
    OkTcUnit
    (match (tc-stdlib-comptime-raw-type-name decl)
      [(TcNoString) OkTcUnit]
      [(TcSomeString type-name)
        (if (not (tc-stdlib-comptime-well-known-type? type-name))
          OkTcUnit
          (if (tc-stdlib-comptime-raw-comptime-decl? decl)
            (tc-stdlib-well-known-mismatch
              type-name
              (tc-stdlib-comptime-plain-declaration-message))
            OkTcUnit))])))

(define (tc-stdlib-check-comptime-declaration-surface-list
  [decls : AstDeclList]
  [module : String]) : ResultTcUnit
  (match decls
    [(AstDeclNil) OkTcUnit]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule module-id)
            (tc-stdlib-check-comptime-declaration-surface-list
              rest
              (intern-str module-id))]
          [_
            (match (tc-stdlib-check-comptime-declaration-surface-decl
              module
              decl)
              [(OkTcUnit)
                (tc-stdlib-check-comptime-declaration-surface-list rest module)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-stdlib-check-comptime-declaration-surface [ctx : TcContext]) : ResultTcUnit
  (match (tc-context-program ctx)
    [(AstProgram decls-box)
      (tc-stdlib-check-comptime-declaration-surface-list (box-get decls-box) "")]))

(define (tc-stdlib-type-normalize-name [ctx : TcContext] [ty : AstType]) : AstType
  (match ty
    [(AstTyVar name) (tc-resolve-type-name ctx (intern-str name))]
    [_ ty]))

(define (tc-stdlib-type-match-normalized?
  [ctx : TcContext]
  [actual : AstType]
  [expected : AstType]) : bool
  (match actual
    [(AstTyI64)
      (match expected
        [(AstTyI64) true]
        [_ false])]
    [(AstTyI32)
      (match expected
        [(AstTyI32) true]
        [_ false])]
    [(AstTyBool)
      (match expected
        [(AstTyBool) true]
        [_ false])]
    [(AstTyString)
      (match expected
        [(AstTyString) true]
        [_ false])]
    [(AstTyExpr)
      (match expected
        [(AstTyExpr) true]
        [_ false])]
    [(AstTyExprList)
      (match expected
        [(AstTyExprList) true]
        [_ false])]
    [(AstTyBox actual-inner)
      (match expected
        [(AstTyBox expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ty-node-get expected-inner))]
        [_ false])]
    [(AstTyDynArray actual-inner)
      (match expected
        [(AstTyDynArray expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ty-node-get expected-inner))]
        [_ false])]
    [(AstTyStruct actual-name)
      (match expected
        [(AstTyStruct expected-name) (= actual-name expected-name)]
        [_ false])]
    [(AstTyEnum actual-name)
      (match expected
        [(AstTyEnum expected-name) (= actual-name expected-name)]
        [_ false])]
    [(AstTyVar actual-name)
      (match expected
        [(AstTyVar expected-name) (= actual-name expected-name)]
        [_ false])]
    [_ false]))

(define (tc-stdlib-type-match?
  [ctx : TcContext]
  [actual : AstType]
  [expected : AstType]) : bool
  (tc-stdlib-type-match-normalized?
    ctx
    (tc-stdlib-type-normalize-name ctx actual)
    (tc-stdlib-type-normalize-name ctx expected)))

(define (tc-stdlib-type-name-match?
  [ctx : TcContext]
  [actual : AstType]
  [name : String]) : bool
  (tc-stdlib-type-match? ctx actual (tc-stdlib-name-type name)))

(define (tc-stdlib-type-spec-match?
  [ctx : TcContext]
  [actual : AstType]
  [expected : TcStdlibTypeSpec]) : bool
  (match expected
    [(TcStdlibTyI64)
      (match actual
        [(AstTyI64) true]
        [_ false])]
    [(TcStdlibTyBool)
      (match actual
        [(AstTyBool) true]
        [_ false])]
    [(TcStdlibTyString)
      (match actual
        [(AstTyString) true]
        [_ false])]
    [(TcStdlibTyName name) (tc-stdlib-type-name-match? ctx actual name)]
    [(TcStdlibTyBoxName name)
      (match actual
        [(AstTyBox inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]
    [(TcStdlibTyArrayName name)
      (match actual
        [(AstTyDynArray inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]))

(define (tc-stdlib-type-spec-render [expected : TcStdlibTypeSpec]) : String
  (match expected
    [(TcStdlibTyI64) "i64"]
    [(TcStdlibTyBool) "bool"]
    [(TcStdlibTyString) "String"]
    [(TcStdlibTyName name) name]
    [(TcStdlibTyBoxName name) (str_cat.str-cat "(Box " name ")")]
    [(TcStdlibTyArrayName name) (str_cat.str-cat "(Array " name ")")]))

(define (tc-stdlib-check-field-specs
  [ctx : TcContext]
  [type-name : String]
  [fields : AstFieldDefList]
  [specs : TcStdlibFieldSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibFieldSpecNil)
      (match fields
        [(AstFieldDefNil) OkTcUnit]
        [_ (tc-stdlib-well-known-mismatch type-name "unexpected extra field")])]
    [(TcStdlibFieldSpecCons expected-name expected-ty rest-specs)
      (begin
        (cfg compile-profile (tc-lp-note 9))
        (match fields
          [(AstFieldDefNil)
            (tc-stdlib-well-known-mismatch
              type-name
              (str_cat.str-cat "missing field " expected-name))]
          [(AstFieldDefCons field rest-fields)
            (let
              [rest-fields : AstFieldDefList (box-get rest-fields)]
              [rest-specs : TcStdlibFieldSpecList (box-get rest-specs)]
              (match field
                [(AstFieldDef actual-name actual-ty _)
                  (if (not
                    (string.string-eq (intern-str actual-name) expected-name))
                    (tc-stdlib-well-known-mismatch
                      type-name
                      (str_cat.str-cat
                        "expected field "
                        expected-name
                        " at index "
                        (string.int->string index)))
                    (if (tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
                      (tc-stdlib-check-field-specs
                        ctx
                        type-name
                        rest-fields
                        rest-specs
                        (+ index 1))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name
                          " type "
                          (tc-stdlib-type-spec-render expected-ty)))))]))]))]))

(define (tc-stdlib-check-payload-specs
  [ctx : TcContext]
  [type-name : String]
  [variant-name : String]
  [actual : AstTypeList]
  [expected : TcStdlibTypeSpecList]
  [index : i64]) : ResultTcUnit
  (match expected
    [(TcStdlibTypeSpecNil)
      (match actual
        [(AstTypeNil) OkTcUnit]
        [_
          (tc-stdlib-well-known-mismatch
            type-name
            (str_cat.str-cat "payload arity mismatch for variant " variant-name))])]
    [(TcStdlibTypeSpecCons expected-ty rest-expected)
      (match actual
        [(AstTypeNil)
          (tc-stdlib-well-known-mismatch
            type-name
            (str_cat.str-cat "payload arity mismatch for variant " variant-name))]
        [(AstTypeCons actual-id rest-actual)
          (let
            [actual-ty : AstType (tc-context-type-get ctx actual-id)]
            [rest-actual : AstTypeList (box-get rest-actual)]
            [rest-expected : TcStdlibTypeSpecList (box-get rest-expected)]
            (if (tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
              (tc-stdlib-check-payload-specs
                ctx
                type-name
                variant-name
                rest-actual
                rest-expected
                (+ index 1))
              (tc-stdlib-well-known-mismatch
                type-name
                (str_cat.str-cat
                  "payload type mismatch for variant "
                  variant-name
                  " at index "
                  (string.int->string index)))))])]))

(define (tc-stdlib-check-variant-specs
  [ctx : TcContext]
  [type-name : String]
  [variants : AstVariantDefList]
  [specs : TcStdlibVariantSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibVariantSpecNil)
      (match variants
        [(AstVariantDefNil) OkTcUnit]
        [_ (tc-stdlib-well-known-mismatch type-name "unexpected extra variant")])]
    [(TcStdlibVariantSpecCons expected-name expected-payloads rest-specs)
      (begin
        (cfg compile-profile (tc-lp-note 11))
        (match variants
          [(AstVariantDefNil)
            (tc-stdlib-well-known-mismatch
              type-name
              (str_cat.str-cat "missing variant " expected-name))]
          [(AstVariantDefCons variant rest-variants)
            (let
              [rest-variants : AstVariantDefList (box-get rest-variants)]
              [rest-specs : TcStdlibVariantSpecList (box-get rest-specs)]
              (match variant
                [(AstVariantDef actual-name actual-payloads _)
                  (if (not
                    (string.string-eq (intern-str actual-name) expected-name))
                    (tc-stdlib-well-known-mismatch
                      type-name
                      (str_cat.str-cat
                        "expected variant "
                        expected-name
                        " at index "
                        (string.int->string index)))
                    (match (tc-stdlib-check-payload-specs
                      ctx
                      type-name
                      expected-name
                      actual-payloads
                      expected-payloads
                      0)
                      [(OkTcUnit)
                        (tc-stdlib-check-variant-specs
                          ctx
                          type-name
                          rest-variants
                          rest-specs
                          (+ index 1))]
                      [(ErrTcUnit message) (ErrTcUnit message)]))]))]))]))

(define (tc-stdlib-check-struct
  [ctx : TcContext]
  [type-name : String]
  [specs : TcStdlibFieldSpecList]) : ResultTcUnit
  (match (compiler-symbols-lookup-type-in-module
    (tc-context-symbols ctx)
    (tc-stdlib-comptime-module-name)
    type-name)
    [(SomeI64 handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(OkAstDecl decl)
          (match decl
            [(AstDeclDefStruct _ _ _ fields)
              (tc-stdlib-check-field-specs
                (tc-context-with-module ctx (tc-stdlib-comptime-module-name))
                type-name
                fields
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defstruct")])]
        [(ErrAstDecl message) (tc-stdlib-well-known-mismatch type-name message)])]
    [(NoneI64) (tc-stdlib-well-known-mismatch type-name "missing declaration")]))

(define (tc-stdlib-check-enum
  [ctx : TcContext]
  [type-name : String]
  [specs : TcStdlibVariantSpecList]) : ResultTcUnit
  (match (compiler-symbols-lookup-type-in-module
    (tc-context-symbols ctx)
    (tc-stdlib-comptime-module-name)
    type-name)
    [(SomeI64 handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(OkAstDecl decl)
          (match decl
            [(AstDeclDefEnum _ _ variants)
              (tc-stdlib-check-variant-specs
                (tc-context-with-module ctx (tc-stdlib-comptime-module-name))
                type-name
                variants
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defenum")])]
        [(ErrAstDecl message) (tc-stdlib-well-known-mismatch type-name message)])]
    [(NoneI64) (tc-stdlib-well-known-mismatch type-name "missing declaration")]))

(define (tc-stdlib-comptime-present? [ctx : TcContext]) : bool
  (or
    (match (compiler-symbols-lookup-type-in-module
      (tc-context-symbols ctx)
      (tc-stdlib-comptime-module-name)
      "Expr")
      [(SomeI64 _) true]
      [(NoneI64) false])
    (match (compiler-symbols-lookup-type-in-module
      (tc-context-symbols ctx)
      (tc-stdlib-comptime-module-name)
      "TypeInfo")
      [(SomeI64 _) true]
      [(NoneI64) false])))

(define (tc-stdlib-expr-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    "ExprBool"
    (tc-stdlib-type-spec-list1 (TcStdlibTyBool))
    (tc-stdlib-variant-spec-cons
      "ExprInt"
      (tc-stdlib-type-spec-list1 (TcStdlibTyI64))
      (tc-stdlib-variant-spec-cons
        "ExprVar"
        (tc-stdlib-type-spec-list1 (TcStdlibTyString))
        (tc-stdlib-variant-spec-cons
          "ExprSplice"
          (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "Expr"))
          (tc-stdlib-variant-spec-cons
            "ExprIf"
            (tc-stdlib-type-spec-list3
              (TcStdlibTyBoxName "Expr")
              (TcStdlibTyBoxName "Expr")
              (TcStdlibTyBoxName "Expr"))
            (tc-stdlib-variant-spec-cons
              "ExprCall"
              (tc-stdlib-type-spec-list2
                (TcStdlibTyBoxName "Expr")
                (TcStdlibTyName "ExprList"))
              (tc-stdlib-variant-spec-cons
                "ExprBegin"
                (tc-stdlib-type-spec-list1 (TcStdlibTyName "ExprList"))
                (tc-stdlib-variant-spec-cons
                  "ExprQuote"
                  (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "Expr"))
                  (tc-stdlib-variant-spec-cons
                    "ExprQuasiquote"
                    (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "Expr"))
                    (tc-stdlib-variant-spec-cons
                      "ExprUnquote"
                      (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "Expr"))
                      (tc-stdlib-variant-spec-cons
                        "ExprUnquoteSplicing"
                        (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "Expr"))
                        (TcStdlibVariantSpecNil)))))))))))))

(define (tc-stdlib-sequence-fields [_ctx : TcContext] [elem-name : String]) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "items"
    (TcStdlibTyArrayName elem-name)
    (tc-stdlib-field-spec-cons "len" (TcStdlibTyI64) (TcStdlibFieldSpecNil))))

(define (tc-stdlib-type-info-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    "TypeInfoBuiltin"
    (tc-stdlib-type-spec-list1 (TcStdlibTyString))
    (tc-stdlib-variant-spec-cons
      "TypeInfoArray"
      (tc-stdlib-type-spec-list2 (TcStdlibTyBoxName "TypeInfo") (TcStdlibTyI64))
      (tc-stdlib-variant-spec-cons
        "TypeInfoDynArray"
        (tc-stdlib-type-spec-list1 (TcStdlibTyBoxName "TypeInfo"))
        (tc-stdlib-variant-spec-cons
          "TypeInfoFunction"
          (tc-stdlib-type-spec-list2
            (TcStdlibTyName "TypeInfoList")
            (TcStdlibTyBoxName "TypeInfo"))
          (tc-stdlib-variant-spec-cons
            "TypeInfoTuple"
            (tc-stdlib-type-spec-list1 (TcStdlibTyName "TypeInfoList"))
            (tc-stdlib-variant-spec-cons
              "TypeInfoStruct"
              (tc-stdlib-type-spec-list2
                (TcStdlibTyString)
                (TcStdlibTyName "TypeFieldList"))
              (tc-stdlib-variant-spec-cons
                "TypeInfoEnum"
                (tc-stdlib-type-spec-list2
                  (TcStdlibTyString)
                  (TcStdlibTyName "TypeVariantList"))
                (tc-stdlib-variant-spec-cons
                  "TypeInfoOpaque"
                  (tc-stdlib-type-spec-list1 (TcStdlibTyString))
                  (TcStdlibVariantSpecNil))))))))))

(define (tc-stdlib-comptime-surface-step
  [current : ResultTcUnit]
  [next : ResultTcUnit]) : ResultTcUnit
  (match current
    [(OkTcUnit) next]
    [(ErrTcUnit _) current]))

(define (tc-stdlib-expr-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "first"
    (TcStdlibTyName "Expr")
    (tc-stdlib-field-spec-cons
      "second"
      (TcStdlibTyName "Expr")
      (TcStdlibFieldSpecNil))))

(define (tc-stdlib-expr-binding-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "name"
    (TcStdlibTyString)
    (tc-stdlib-field-spec-cons
      "has-type"
      (TcStdlibTyBool)
      (tc-stdlib-field-spec-cons
        "ty"
        (TcStdlibTyName "Expr")
        (tc-stdlib-field-spec-cons
          "init"
          (TcStdlibTyName "Expr")
          (TcStdlibFieldSpecNil))))))

(define (tc-stdlib-type-field-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "name"
    (TcStdlibTyString)
    (tc-stdlib-field-spec-cons
      "ty"
      (TcStdlibTyName "TypeInfo")
      (TcStdlibFieldSpecNil))))

(define (tc-stdlib-type-variant-payload-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "ty"
    (TcStdlibTyName "TypeInfo")
    (TcStdlibFieldSpecNil)))

(define (tc-stdlib-type-variant-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "name"
    (TcStdlibTyString)
    (tc-stdlib-field-spec-cons
      "payloads"
      (TcStdlibTyName "TypeVariantPayloadList")
      (TcStdlibFieldSpecNil))))

(define (tc-stdlib-type-param-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "name"
    (TcStdlibTyString)
    (tc-stdlib-field-spec-cons
      "ty"
      (TcStdlibTyName "TypeInfo")
      (TcStdlibFieldSpecNil))))

(define (tc-stdlib-comptime-surface-ok-impl [ctx : TcContext]) : ResultTcUnit
  (if (not (tc-stdlib-comptime-present? ctx))
    OkTcUnit
    (let
      [result : ResultTcUnit (tc-stdlib-check-comptime-declaration-surface ctx)]
      (begin
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-enum ctx "Expr" (tc-stdlib-expr-specs ctx))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprList"
              (tc-stdlib-sequence-fields ctx "Expr"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprClause"
              (tc-stdlib-expr-clause-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprClauseList"
              (tc-stdlib-sequence-fields ctx "ExprClause"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprBindingClause"
              (tc-stdlib-expr-binding-clause-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprBindingClauseList"
              (tc-stdlib-sequence-fields ctx "ExprBindingClause"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeInfoList"
              (tc-stdlib-sequence-fields ctx "TypeInfo"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeField"
              (tc-stdlib-type-field-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeFieldList"
              (tc-stdlib-sequence-fields ctx "TypeField"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantPayload"
              (tc-stdlib-type-variant-payload-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantPayloadList"
              (tc-stdlib-sequence-fields ctx "TypeVariantPayload"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariant"
              (tc-stdlib-type-variant-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantList"
              (tc-stdlib-sequence-fields ctx "TypeVariant"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeParam"
              (tc-stdlib-type-param-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeParamList"
              (tc-stdlib-sequence-fields ctx "TypeParam"))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-enum
              ctx
              "TypeInfo"
              (tc-stdlib-type-info-specs ctx))))
        result))))

(define (tc-stdlib-comptime-surface-ok [ctx : TcContext]) : ResultTcUnit
  (let
    [prev : AstNodePoolContext (ast-node-pool-context-capture-active)]
    [_install : unit (ast-node-pool-context-install! (tc-context-pools ctx))]
    ;; #3677: the well-known spec builder pushes fresh type nodes (e.g. the
    ;; `(Box Expr)` payload of ExprSplice) into this context's type-node pool.
    ;; In a long-lived `test --check --batch` process the captured pool snapshot
    ;; inherits a dedup index whose entries can point at slot ids that a later
    ;; batch entry's nodes now occupy, so a deduped spec push would resolve to a
    ;; slot holding an unrelated node and the well-known compare spuriously
    ;; mismatches. Drop the dedup index here (no live nodes are truncated) so
    ;; spec pushes rebuild it against the current entry's nodes only.
    [_dedup : unit
      (ast-node-pool-context-type-dedup-clear! (tc-context-pools ctx))]
    [result : ResultTcUnit (tc-stdlib-comptime-surface-ok-impl ctx)]
    (begin
      (ast-node-pool-context-install! prev)
      result)))

(define (tc-macro-helper-env [env : TcTypeEnv]) : TcTypeEnv
  (let
    [expr : AstType (AstTyExpr)]
    [clause : AstType (tc-macro-expr-clause-type)]
    [clause-list : AstType (tc-macro-expr-clause-list-type)]
    [binding-clause : AstType (tc-macro-expr-binding-clause-type)]
    [binding-clause-list : AstType (tc-macro-expr-binding-clause-list-type)]
    [out : TcTypeEnv env]
    (begin
      (set!
        out
        (tc-bind
          out
          "string-append"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyString))))
      (set!
        out
        (tc-bind
          out
          "string-concat"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyString))))
      (set! out (tc-bind out "string-length" (tc-fn1 (AstTyString) (AstTyI64))))
      (set! out (tc-bind out "length" (tc-fn1 (AstTyString) (AstTyI64))))
      (set!
        out
        (tc-bind out "string-ref" (tc-fn2 (AstTyString) (AstTyI64) (AstTyChar))))
      (set!
        out
        (tc-bind out "char-at" (tc-fn2 (AstTyString) (AstTyI64) (AstTyChar))))
      (set!
        out
        (tc-bind
          out
          "string-eq"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyBool))))
      (set!
        out
        (tc-bind
          out
          "string=?"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyBool))))
      (set! out (tc-bind out "string->int" (tc-fn1 (AstTyString) (AstTyI64))))
      (set! out (tc-bind out "int->string" (tc-fn1 (AstTyI64) (AstTyString))))
      (set! out (tc-bind out "expr-bool" (tc-fn1 (AstTyBool) expr)))
      (set! out (tc-bind out "expr-int" (tc-fn1 (AstTyI64) expr)))
      (set! out (tc-bind out "expr-string" (tc-fn1 (AstTyString) expr)))
      (set! out (tc-bind out "expr-var" (tc-fn1 (AstTyString) expr)))
      (set!
        out
        (tc-bind out "expr-struct-get" (tc-fn2 expr (AstTyString) expr)))
      (set!
        out
        (tc-bind out "expr-struct-set" (tc-fn3 expr (AstTyString) expr expr)))
      (set! out (tc-bind out "expr-splice" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if" (tc-fn3 expr expr expr expr)))
      (set! out (tc-bind out "expr-type" (tc-fn1 expr expr)))
      (set!
        out
        (tc-bind out "module-name" (tc-fn1 (AstTyString) (AstTyString))))
      (set!
        out
        (tc-bind
          out
          "module-export-macro?"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyBool))))
      (set!
        out
        (tc-bind out "module-hook" (tc-fn2 (AstTyString) (AstTyString) expr)))
      (set! out (tc-bind out "type-kind" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "type-key" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "type-nominal-module" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "type-nominal-name" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "struct-field-count" (tc-fn1 expr (AstTyI64))))
      (set!
        out
        (tc-bind out "struct-field-name" (tc-fn2 expr (AstTyI64) (AstTyString))))
      (set! out (tc-bind out "struct-field-type" (tc-fn2 expr (AstTyI64) expr)))
      (set! out (tc-bind out "enum-variant-count" (tc-fn1 expr (AstTyI64))))
      (set!
        out
        (tc-bind out "enum-variant-name" (tc-fn2 expr (AstTyI64) (AstTyString))))
      (set!
        out
        (tc-bind
          out
          "enum-variant-payload-count"
          (tc-fn2 expr (AstTyI64) (AstTyI64))))
      (set!
        out
        (tc-bind
          out
          "enum-variant-payload-type"
          (tc-fn3 expr (AstTyI64) (AstTyI64) expr)))
      (set! out (tc-bind out "array-element-type" (tc-fn1 expr expr)))
      (set! out (tc-bind out "array-length" (tc-fn1 expr (AstTyI64))))
      (set! out (tc-bind out "array-dynamic?" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "tuple-element-count" (tc-fn1 expr (AstTyI64))))
      (set!
        out
        (tc-bind out "tuple-element-type" (tc-fn2 expr (AstTyI64) expr)))
      (set! out (tc-bind out "function-param-count" (tc-fn1 expr (AstTyI64))))
      (set!
        out
        (tc-bind out "function-param-type" (tc-fn2 expr (AstTyI64) expr)))
      (set! out (tc-bind out "function-return-type" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-bool?" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-bool-value" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-if?" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-if-cond" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if-then" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if-else" (tc-fn1 expr expr)))
      (set!
        out
        (tc-bind out "expr-list-empty?" (tc-fn1 (AstTyExprList) (AstTyBool))))
      (set!
        out
        (tc-bind out "expr-list-length" (tc-fn1 (AstTyExprList) (AstTyI64))))
      (set! out (tc-bind out "expr-list-head" (tc-fn1 (AstTyExprList) expr)))
      (set!
        out
        (tc-bind out "expr-list-tail" (tc-fn1 (AstTyExprList) (AstTyExprList))))
      (set!
        out
        (tc-bind out "expr-list-nth" (tc-fn2 (AstTyExprList) (AstTyI64) expr)))
      (set! out (tc-bind out "expr-clause-first" (tc-fn1 clause expr)))
      (set! out (tc-bind out "expr-clause-second" (tc-fn1 clause expr)))
      (set!
        out
        (tc-bind out "expr-clause-list-empty?" (tc-fn1 clause-list (AstTyBool))))
      (set!
        out
        (tc-bind out "expr-clause-list-length" (tc-fn1 clause-list (AstTyI64))))
      (set!
        out
        (tc-bind out "expr-clause-list-head" (tc-fn1 clause-list clause)))
      (set!
        out
        (tc-bind out "expr-clause-list-tail" (tc-fn1 clause-list clause-list)))
      (set!
        out
        (tc-bind
          out
          "expr-clause-list-nth"
          (tc-fn2 clause-list (AstTyI64) clause)))
      (set!
        out
        (tc-bind
          out
          "expr-clause-list->expr-list"
          (tc-fn1 clause-list (AstTyExprList))))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-name"
          (tc-fn1 binding-clause (AstTyString))))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-has-type?"
          (tc-fn1 binding-clause (AstTyBool))))
      (set!
        out
        (tc-bind out "expr-binding-clause-type" (tc-fn1 binding-clause expr)))
      (set!
        out
        (tc-bind out "expr-binding-clause-init" (tc-fn1 binding-clause expr)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-empty?"
          (tc-fn1 binding-clause-list (AstTyBool))))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-length"
          (tc-fn1 binding-clause-list (AstTyI64))))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-head"
          (tc-fn1 binding-clause-list binding-clause)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-tail"
          (tc-fn1 binding-clause-list binding-clause-list)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-nth"
          (tc-fn2 binding-clause-list (AstTyI64) binding-clause)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list->expr-list"
          (tc-fn1 binding-clause-list (AstTyExprList))))
      out)))

(define tc-macro-helper-env-cache-ready : bool
  false)
(define tc-macro-helper-env-cache-value : TcTypeEnv
  (TcTypeNil))

(define (tc-macro-helper-env-cache-reset!) : unit
  (begin
    (set! tc-macro-helper-env-cache-ready false)
    (set! tc-macro-helper-env-cache-value (TcTypeNil))))

(define (tc-macro-helper-env-cached [env : TcTypeEnv]) : TcTypeEnv
  (if tc-macro-helper-env-cache-ready
    tc-macro-helper-env-cache-value
    (let
      [helper-env : TcTypeEnv (tc-macro-helper-env env)]
      (begin
        (set! tc-macro-helper-env-cache-value helper-env)
        (set! tc-macro-helper-env-cache-ready true)
        tc-macro-helper-env-cache-value))))

(define (tc-lookup-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (match env
      [(TcTypeNil)
        (ErrTcType
          (string.string-append "typecheck: unbound name " (intern-str name-id)))]
      [(TcTypeCache ids values _ _ _ _ partial _ below)
        (match (hashmap.i64-i64-map-get ids name-id)
          ;; #2357: MUST stay `array-ref` -- with #1867 inline-by-value `AstType` is
          ;; a multi-word value and the raw ptr-offset/ptr-read path mis-scales the
          ;; element stride, reading garbage.
          [(hashmap.I64I64MapFound index)
            (OkTcType (array.array-ref values index))]
          [(hashmap.I64I64MapMissing)
            (if partial
              (tc-lookup-id (box-get below) name-id)
              (ErrTcType
                (string.string-append
                  "typecheck: unbound name "
                  (intern-str name-id))))])]
      [(TcTypeBind key ty rest)
        (if (= key name-id)
          (OkTcType ty)
          (tc-lookup-id (box-get rest) name-id))])))

(define (tc-lookup [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-id env (tc-name-id name)))

(define (tc-name-bound-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache ids _ _ _ _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound _) true]
        [(hashmap.I64I64MapMissing)
          (if partial
            (tc-name-bound-id? (box-get below) name-id)
            false)])]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        true
        (tc-name-bound-id? (box-get rest) name-id))]))

(define (tc-lookup-unsafe-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (match env
      [(TcTypeNil)
        (ErrTcTypeUnsafe
          (string.string-append "typecheck: unbound name " (intern-str name-id)))]
      [(TcTypeCache ids values unsafe-flags _ _ _ partial _ below)
        (match (hashmap.i64-i64-map-get ids name-id)
          ;; #2357: AstType read MUST stay `array-ref` (inline-by-value multi-word
          ;; value); the `unsafe-flags` i64 read below is scalar so the raw ptr path
          ;; is still sound there.
          [(hashmap.I64I64MapFound index)
            (OkTcTypeUnsafe
              (array.array-ref values index)
              (=
                (unsafe
                  (ptr-read
                    (ptr-offset
                      (ptr-cast (array-data unsafe-flags) : (Ptr i64))
                      index)))
                1))]
          [(hashmap.I64I64MapMissing)
            (if partial
              (tc-lookup-unsafe-id (box-get below) name-id)
              (ErrTcTypeUnsafe
                (string.string-append
                  "typecheck: unbound name "
                  (intern-str name-id))))])]
      [(TcTypeBind key ty rest)
        (if (= key name-id)
          (OkTcTypeUnsafe
            ty
            (tc-binding-unsafe-marker-head-id? (box-get rest) name-id))
          (tc-lookup-unsafe-id (box-get rest) name-id))])))

(define (tc-lookup-unsafe [env : TcTypeEnv] [name : String]) : ResultTcTypeUnsafe
  (tc-lookup-unsafe-id env (tc-name-id name)))

(define (tc-name-bound-before-hygiene-global-boundary-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-name-bound-before-hygiene-global-boundary-id?
          (box-get rest)
          name-id)
        false)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        false
        (if (= key name-id)
          true
          (tc-name-bound-before-hygiene-global-boundary-id?
            (box-get rest)
            name-id)))]))

(define (tc-unqualified-import-ambiguity-message-for-key
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [_module : String]
  [name : String]
  [name-id : i64]
  [key-id : i64]) : TcMaybeString
  (match (sym-i64-lookup-id
    tc-unqualified-import-ambiguous-first-modules
    key-id)
    [NoneI64 (TcNoString)]
    [(SomeI64 first-module)
      (if (tc-name-bound-before-hygiene-global-boundary-id? env name-id)
        (TcNoString)
        (match (sym-i64-lookup-id
          tc-unqualified-import-ambiguous-second-modules
          key-id)
          [NoneI64 (TcNoString)]
          [(SomeI64 second-module)
            (TcSomeString
              (str_cat.str-cat
                "typecheck: ambiguous unqualified import for value "
                name
                " between modules "
                (intern-str first-module)
                " and "
                (intern-str second-module)
                "; use an explicit alias or qualified access"))]))]))

(define (tc-unqualified-import-ambiguity-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeString
  (if tc-unqualified-import-has-ambiguity
    (let
      [name : String (intern-str name-id)]
      (if (tc-name-qualified? name)
        (TcNoString)
        (let
          [module : String (tc-context-module ctx)]
          (tc-unqualified-import-ambiguity-message-for-key
            ctx
            env
            module
            name
            name-id
            (tc-unqualified-import-key-id module name-id)))))
    (TcNoString)))

(define (tc-lookup-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [found : ResultTcType
      (match (tc-lookup-id env name-id)
        [(OkTcType ty) (OkTcType ty)]
        [(ErrTcType message)
          (let
            [module : String (tc-context-module ctx)]
            (if (and
              (> (string.string-length module) 0)
              (not (tc-name-qualified? name)))
              (match (tc-lookup-id
                env
                (tc-name-id (compiler-symbol-module-key module name)))
                [(OkTcType ty) (OkTcType ty)]
                [(ErrTcType _) (ErrTcType message)])
              (ErrTcType message)))])]
    (match found
      [(OkTcType ty)
        (match (tc-unqualified-import-ambiguity-message ctx env name-id)
          [(TcNoString) (OkTcType ty)]
          [(TcSomeString message) (ErrTcType message)])]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-lookup-visible [ctx : TcContext] [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-hygiene-global-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match env
    [(TcTypeNil) (tc-lookup-id root name-id)]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lookup-hygiene-global-scan root (box-get rest) name-id)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-lookup-id (box-get rest) name-id)
        (tc-lookup-hygiene-global-scan root (box-get rest) name-id))]))

(define (tc-lookup-hygiene-global-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-hygiene-global-scan env env name-id))

(define (tc-lookup-hygiene-global [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-id env (tc-name-id name)))

(define (tc-lookup-hygiene-global-visible-id
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match (tc-lookup-hygiene-global-id env name-id)
    [(OkTcType ty) (OkTcType ty)]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-lookup-hygiene-global-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-dotted-source-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (match (tc-source-name-lookup-key-after-local-field-check ctx env name)
    [(OkTcString lookup-name)
      (let
        [lookup-id : i64 (tc-name-id lookup-name)]
        (match (tc-lookup-unsafe-id env lookup-id)
          [(OkTcTypeUnsafe ty unsafe)
            (if unsafe
              (match (tc-require-unsafe
                env
                (tc-source-lookup-display-name ctx name lookup-name))
                [(OkTcUnit) (OkTcType ty)]
                [(ErrTcUnit message) (ErrTcType message)])
              (OkTcType ty))]
          [(ErrTcTypeUnsafe message)
            (tc-variant-constructor-type-for-lookup-or
              ctx
              lookup-name
              (tc-source-lookup-display-name ctx name lookup-name)
              (tc-source-unbound-display-message ctx name lookup-name message))]))]
    [(ErrTcString message) (ErrTcType message)]))

(define (tc-hygiene-definition-env [ctx : TcContext] [module : String]) : ResultTcEnv
  (if tc-hygiene-active-top-env-ready
    (if (string.string-eq module "")
      (OkTcEnv tc-hygiene-active-top-env)
      ;; #2357: build cache entries in the dedicated persistent arena (see
      ;; tc-hygiene-module-env-cache-arena) so the chain stored in the global
      ;; survives the scratch arenas active during per-decl typechecking.
      (let
        [prev-arena : i64 (arena.tl_arena_current)]
        [_switched : unit
          (unsafe
            (arena.tl_arena_set (tc-hygiene-module-env-cache-arena-handle)))]
        (match (tc-module-local-env-cached
          ctx
          tc-hygiene-active-top-env
          module
          tc-hygiene-module-env-cache)
          [(OkTcModuleLocalEnv def-env next-cache)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (set! tc-hygiene-module-env-cache next-cache)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (OkTcEnv def-env)))]
          [(ErrTcModuleLocalEnv message)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (ErrTcEnv message)))])))
    (ErrTcEnv "typecheck: macro hygiene definition context unavailable")))

(define (tc-lookup-hygiene-context-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [def-ctx : TcContext (tc-context-with-module ctx module)]
    (if (>= (intern-first-dot name-id) 0)
      (tc-lookup-dotted-source-visible def-ctx env name)
      (match (tc-hygiene-definition-env ctx module)
        [(OkTcEnv def-env)
          (match (tc-lookup-unsafe-id def-env name-id)
            [(OkTcTypeUnsafe ty unsafe)
              (if unsafe
                (match (tc-require-unsafe env name)
                  [(OkTcUnit) (OkTcType ty)]
                  [(ErrTcUnit message) (ErrTcType message)])
                (OkTcType ty))]
            [(ErrTcTypeUnsafe message) (ErrTcType message)])]
        [(ErrTcEnv message) (ErrTcType message)]))))

(define (tc-hygiene-global-binding-unsafe-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeNil) (tc-binding-unsafe-id? root name-id)]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-hygiene-global-binding-unsafe-scan root (box-get rest) name-id)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-binding-unsafe-id? (box-get rest) name-id)
        (tc-hygiene-global-binding-unsafe-scan root (box-get rest) name-id))]))

(define (tc-hygiene-global-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-hygiene-global-binding-unsafe-scan env env name-id))

(define (tc-hygiene-global-binding-unsafe? [env : TcTypeEnv] [name : String]) : bool
  (tc-hygiene-global-binding-unsafe-id? env (tc-name-id name)))

(define (tc-active-region-scan [env : TcTypeEnv]) : TcMaybeString
  (match env
    [(TcTypeNil) (TcNoString)]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-region-scan (box-get rest))
        (TcNoString))]
    [(TcTypeBind key ty rest)
      (if (= key (tc-region-marker-id))
        (match ty
          [(AstTyVar region) (TcSomeString (intern-str region))]
          [_ (tc-active-region-scan (box-get rest))])
        (tc-active-region-scan (box-get rest)))]))

(define (tc-active-region [env : TcTypeEnv]) : TcMaybeString
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-active-region-scan (box-get rest))]
      [_ (tc-active-region-scan env)])))

(define (tc-push-region [env : TcTypeEnv] [region : String]) : TcTypeEnv
  (tc-bind env (tc-region-marker-name) (AstTyVar (intern region))))

(define (tc-string-list-contains [items : TcStringList] [name : String]) : bool
  (match items
    [(TcStringNil) false]
    [(TcStringCons item rest)
      (if (string.string-eq item name)
        true
        (tc-string-list-contains (box-get rest) name))]))

(define (tc-string-list-add [items : TcStringList] [name : String]) : TcStringList
  (if (tc-string-list-contains items name)
    items
    (TcStringCons name (box items))))

(define (tc-bind-cleanup-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-cleanup-owner-marker-name) (AstTyVar (intern name))))

(define (tc-bind-ordinary-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-ordinary-arena-owner-marker-name) (AstTyVar (intern name))))

(define (tc-bind-atomic-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-atomic-arena-owner-marker-name) (AstTyVar (intern name))))

(define (tc-cleanup-owner-marker-for?
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstTyVar owner) (string.string-eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-arena-owner-marker-for?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key marker-id)
    (match ty
      [(AstTyVar owner) (string.string-eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-cleanup-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstTyVar _) true]
      [_ false])
    false))

(define (tc-arena-owner-marker-entry?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]) : bool
  (if (= key marker-id)
    (match ty
      [(AstTyVar _) true]
      [_ false])
    false))

(define (tc-ordinary-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-ordinary-arena-owner-marker-id) key ty))

(define (tc-atomic-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-atomic-arena-owner-marker-id) key ty))

(define (tc-arena-owner-marker-head?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeBind key ty _) (tc-arena-owner-marker-for? marker-id key ty name)]))

(define (tc-cleanup-owner-marker-head? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeBind key ty _) (tc-cleanup-owner-marker-for? key ty name)]))

(define (tc-cleanup-owner-active-scan? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-cleanup-owner-active-scan? (box-get rest) name)
        false)]
    [(TcTypeBind key ty rest)
      (if (= key (tc-name-id name))
        (tc-cleanup-owner-marker-head? (box-get rest) name)
        (tc-cleanup-owner-active-scan? (box-get rest) name))]))

(define (tc-cleanup-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-cleanup-owner-active-scan? (box-get rest) name)]
      [_ (tc-cleanup-owner-active-scan? env name)])))

(define (tc-arena-owner-active-scan?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-owner-active-scan? (box-get rest) name marker-id)
        false)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-name-id name))
        (tc-arena-owner-marker-head? (box-get rest) name marker-id)
        (tc-arena-owner-active-scan? (box-get rest) name marker-id))]))

(define (tc-arena-owner-active?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-arena-owner-active-scan? (box-get rest) name marker-id)]
      [_ (tc-arena-owner-active-scan? env name marker-id)])))

(define (tc-ordinary-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-ordinary-arena-owner-marker-id)))

(define (tc-atomic-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-atomic-arena-owner-marker-id)))

(define (tc-active-cleanup-owners-scan [root : TcTypeEnv] [env : TcTypeEnv]) : TcStringList
  (match env
    [(TcTypeNil) TcStringNil]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-cleanup-owners-scan root (box-get rest))
        TcStringNil)]
    [(TcTypeBind key ty rest)
      (let
        [owners : TcStringList
          (tc-active-cleanup-owners-scan root (box-get rest))]
        (if (= key (tc-cleanup-owner-marker-id))
          (match ty
            [(AstTyVar owner)
              (let
                [owner-str : String (intern-str owner)]
                (if (tc-cleanup-owner-active? root owner-str)
                  (tc-string-list-add owners owner-str)
                  owners))]
            [_ owners])
          owners))]))

(define (tc-active-cleanup-owners [env : TcTypeEnv]) : TcStringList
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-active-cleanup-owners-scan env (box-get rest))]
      [_ (tc-active-cleanup-owners-scan env env)])))

(define (tc-string-list-eq [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringNil)
      (match b
        [(TcStringNil) true]
        [_ false])]
    [(TcStringCons item rest)
      (and
        (tc-string-list-contains b item)
        (tc-string-list-eq (box-get rest) b))]))

(define (tc-string-list-overlaps? [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringNil) false]
    [(TcStringCons item rest)
      (if (tc-string-list-contains b item)
        true
        (tc-string-list-overlaps? (box-get rest) b))]))

(define (tc-string-list-all-in? [items : TcStringList] [allowed : TcStringList]) : bool
  (match items
    [(TcStringNil) true]
    [(TcStringCons item rest)
      (and
        (tc-string-list-contains allowed item)
        (tc-string-list-all-in? (box-get rest) allowed))]))

(define (tc-lifetime-list-count [items : AstLifetimeList]) : i64
  (match items
    [(AstLifetimeNil) 0]
    [(AstLifetimeCons _ rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (+ 1 (tc-lifetime-list-count rest)))]))

(define (tc-lifetime-list-contains [items : AstLifetimeList] [name : String]) : bool
  (match items
    [(AstLifetimeNil) false]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (if (string.string-eq item name)
          true
          (tc-lifetime-list-contains rest name)))]))

(define (tc-lifetime-list-duplicates? [items : AstLifetimeList]) : bool
  (match items
    [(AstLifetimeNil) false]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (or
          (tc-lifetime-list-contains rest item)
          (tc-lifetime-list-duplicates? rest)))]))

(define (tc-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (match a
    [(AstLifetimeNil)
      (match b
        [(AstLifetimeNil) true]
        [_ false])]
    [(AstLifetimeCons a-head a-rest)
      (let
        [a-rest : AstLifetimeList (box-get a-rest)]
        (match b
          [(AstLifetimeCons b-head b-rest)
            (let
              [b-rest : AstLifetimeList (box-get b-rest)]
              (and
                (string.string-eq a-head b-head)
                (tc-lifetime-list-eq a-rest b-rest)))]
          [_ false]))]))

(define (tc-lifetime-list-all-in?
  [items : AstLifetimeList]
  [allowed : AstLifetimeList]) : bool
  (match items
    [(AstLifetimeNil) true]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (and
          (or
            (string.string-eq item "program")
            (tc-lifetime-list-contains allowed item))
          (tc-lifetime-list-all-in? rest allowed)))]))

(define (tc-lifetime-list-to-string-list-into
  [items : AstLifetimeList]
  [out : TcStringList]) : TcStringList
  (match items
    [(AstLifetimeNil) out]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (tc-lifetime-list-to-string-list-into
          rest
          (tc-string-list-add out item)))]))

(define (tc-string-list-to-lifetime-list [items : TcStringList]) : AstLifetimeList
  (match items
    [(TcStringNil) AstLifetimeNil]
    [(TcStringCons item rest)
      (ast-lifetime-cons item (tc-string-list-to-lifetime-list (box-get rest)))]))

(define (tc-lifetime-subst-lookup [subst : TcLifetimeSubst] [name : String]) : TcMaybeString
  (match subst
    [(TcLifetimeSubstNil) (TcNoString)]
    [(TcLifetimeSubstCons from to rest)
      (if (string.string-eq from name)
        (TcSomeString to)
        (tc-lifetime-subst-lookup (box-get rest) name))]))

(define (tc-lifetime-subst-bind
  [subst : TcLifetimeSubst]
  [from : String]
  [to : String]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(TcSomeString existing)
      (if (string.string-eq existing to)
        (OkTcLifetimeSubst subst)
        (ErrTcLifetimeSubst "typecheck: constructor lifetime mismatch"))]
    [(TcNoString) (OkTcLifetimeSubst (TcLifetimeSubstCons from to (box subst)))]))

(define (tc-lifetime-subst-apply [subst : TcLifetimeSubst] [name : String]) : String
  (match (tc-lifetime-subst-lookup subst name)
    [(TcSomeString replacement) replacement]
    [(TcNoString) name]))

(define (tc-lifetime-subst-list
  [subst : TcLifetimeSubst]
  [items : AstLifetimeList]) : AstLifetimeList
  (match items
    [(AstLifetimeNil) AstLifetimeNil]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (ast-lifetime-cons
          (tc-lifetime-subst-apply subst item)
          (tc-lifetime-subst-list subst rest)))]))

;; V1 lifetime names are owner names. Normal environment bindings own stack
;; slots, and the synthetic region marker owns a with-arena scope. Environment
;; order is the lexical outlives relation: older owners appear farther down the
;; list and outlive nested stack bindings or scoped arenas. The default program
;; arena is inferred for untagged aggregate handles, so it has no lexical
;; binder in this environment walk.
(define (tc-env-binding-matches-lifetime?
  [key : i64]
  [ty : AstType]
  [lifetime : String]) : bool
  (if (= key (tc-name-id lifetime))
    true
    (if (= key (tc-region-marker-id))
      (match ty
        [(AstTyVar region) (string.string-eq (intern-str region) lifetime)]
        [_ false])
      false)))

(define (tc-lifetime-visible-scan? [env : TcTypeEnv] [lifetime : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-visible-scan? (box-get rest) lifetime)
        false)]
    [(TcTypeBind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        true
        (tc-lifetime-visible-scan? (box-get rest) lifetime))]))

(define (tc-lifetime-visible? [env : TcTypeEnv] [lifetime : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-lifetime-visible-scan? (box-get rest) lifetime)]
      [_ (tc-lifetime-visible-scan? env lifetime)])))

(define (tc-reference-lifetimes-visible?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-visible? env lifetime)
        (tc-reference-lifetimes-visible? env (box-get rest)))]))

(define (tc-lifetime-outlives-binding-scan-inner
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          seen-target)
        false)]
    [(TcTypeBind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        seen-target
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          (or seen-target (= key (tc-name-id target)))))]))

(define (tc-lifetime-outlives-binding-scan
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-binding-scan-inner
        (box-get rest)
        lifetime
        target
        seen-target)]
    [_
      (tc-lifetime-outlives-binding-scan-inner env lifetime target seen-target)]))

(define (tc-lifetime-outlives-binding?
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (tc-lifetime-outlives-binding-scan env lifetime target false)))

(define (tc-reference-lifetimes-outlive-binding?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target : String]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-outlives-binding? env lifetime target)
        (tc-reference-lifetimes-outlive-binding? env (box-get rest) target))]))

(define (tc-lifetime-outlives-lifetime-scan-inner
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (if (string.string-eq value-lifetime target-lifetime)
    true
    (match env
      [(TcTypeNil) false]
      [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            seen-target)
          false)]
      [(TcTypeBind key ty rest)
        (if (tc-env-binding-matches-lifetime? key ty value-lifetime)
          seen-target
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            (or
              seen-target
              (tc-env-binding-matches-lifetime? key ty target-lifetime))))])))

(define (tc-lifetime-outlives-lifetime-scan
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-lifetime-scan-inner
        (box-get rest)
        value-lifetime
        target-lifetime
        seen-target)]
    [_
      (tc-lifetime-outlives-lifetime-scan-inner
        env
        value-lifetime
        target-lifetime
        seen-target)]))

(define (tc-lifetime-outlives-lifetime?
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (tc-lifetime-outlives-lifetime-scan
      env
      value-lifetime
      target-lifetime
      false)))

(define (tc-reference-lifetimes-outlive-lifetime?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target-lifetime : String]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-outlives-lifetime? env lifetime target-lifetime)
        (tc-reference-lifetimes-outlive-lifetime?
          env
          (box-get rest)
          target-lifetime))]))

(define (tc-ensure-reference-value-can-bind
  [env : TcTypeEnv]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-regions value-ty)]
    (if (tc-reference-lifetimes-visible? env lifetimes)
      OkTcUnit
      (ErrTcUnit "typecheck: reference value would escape lexical scope"))))

(define (tc-ensure-reference-value-can-assign
  [env : TcTypeEnv]
  [target : String]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-reference-lifetimes value-ty)]
    (if (tc-reference-lifetimes-outlive-binding? env lifetimes target)
      OkTcUnit
      (ErrTcUnit
        "typecheck: cannot store reference into longer-lived binding; reference value would escape lexical scope"))))

(define (tc-ensure-reference-type-does-not-escape-names
  [ty : AstType]
  [names : TcStringList]) : ResultTcUnit
  (if (tc-string-list-overlaps? (tc-type-collect-regions ty) names)
    (ErrTcUnit "typecheck: reference value would escape lexical scope")
    OkTcUnit))

(define (tc-type-strip-region [ty : AstType]) : AstType
  (match ty
    [(AstTyRegion _ inner) (tc-type-strip-region (ty-node-get inner))]
    [_ ty]))

(define (tc-type-list-contains-region-tag? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (if (tc-type-contains-region-tag? head)
          true
          (tc-type-list-contains-region-tag? tail)))]))

(define (tc-type-contains-region-tag? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (if (tc-type-list-contains-region-tag? (box-get args))
        true
        (tc-type-contains-region-tag? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-region-tag? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstTyMutRef _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstTyRegion _ _) true]
    [_ false]))

(define (tc-type-list-without-regions [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-contains-region-tag? types)
    (match types
      [(AstTypeNil) AstTypeNil]
      [(AstTypeCons head tail)
        (let
          [head : AstType (ty-node-get head)]
          [tail : AstTypeList (box-get tail)]
          (ast-type-cons
            (tc-type-without-regions head)
            (tc-type-list-without-regions tail)))])
    types))

(define (tc-type-without-regions [ty : AstType]) : AstType
  (if (tc-type-contains-region-tag? ty)
    (match ty
      [(AstTyFunc args ret)
        (ast-ty-func
          (tc-type-list-without-regions (box-get args))
          (tc-type-without-regions (ty-node-get ret)))]
      [(AstTyTuple elems)
        (ast-ty-tuple (tc-type-list-without-regions (box-get elems)))]
      [(AstTyArray elem len)
        (ast-ty-array (tc-type-without-regions (ty-node-get elem)) len)]
      [(AstTyDynArray elem)
        (ast-ty-dyn-array (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyBox elem)
        (ast-ty-box (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyPtr elem)
        (ast-ty-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyMutPtr elem)
        (ast-ty-mut-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyRef region inner)
        (ast-ty-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstTyMutRef region inner)
        (ast-ty-mut-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstTyRegion _ inner) (tc-type-without-regions (ty-node-get inner))]
      [(AstTyEnumArgs name lifetimes)
        (ast-ty-enum-args name (box-get lifetimes))]
      [(AstTyStructArgs name lifetimes)
        (ast-ty-struct-args name (box-get lifetimes))]
      [(AstTyVarArgs name lifetimes) (ast-ty-var-args name (box-get lifetimes))]
      [_ ty])
    ty))

(define (tc-type-list-contains-region [types : AstTypeList] [region : String]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-region head region)
          (tc-type-list-contains-region tail region)))]))

(define (tc-type-contains-region [ty : AstType] [region : String]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-region (box-get args) region)
        (tc-type-contains-region (ty-node-get ret) region))]
    [(AstTyTuple elems) (tc-type-list-contains-region (box-get elems) region)]
    [(AstTyArray elem _) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyDynArray elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyBox elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyMutPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyRef name inner)
      (or
        (string.string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyMutRef name inner)
      (or
        (string.string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyRegion name inner)
      (or
        (string.string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [_ false]))

(define (tc-type-list-contains-any-region [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-any-region head)
          (tc-type-list-contains-any-region tail)))]))

(define (tc-type-contains-any-region [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-any-region (box-get args))
        (tc-type-contains-any-region (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-any-region (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ _) true]
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyVarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-list-contains-reference? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-reference? head)
          (tc-type-list-contains-reference? tail)))]))

(define (tc-type-list-contains-mut-reference? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-mut-reference? head)
          (tc-type-list-contains-mut-reference? tail)))]))

(define (tc-type-contains-reference? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-reference? (box-get args))
        (tc-type-contains-reference? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-reference? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ inner) (tc-type-contains-reference? (ty-node-get inner))]
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyVarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-contains-mut-reference? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-mut-reference? (box-get args))
        (tc-type-contains-mut-reference? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-mut-reference? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-contains-mut-reference? (ty-node-get inner))]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [_ false]))

(define (tc-type-list-collect-reference-lifetimes
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (match types
    [(AstTypeNil) out]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (tc-type-list-collect-reference-lifetimes
          tail
          (tc-type-collect-reference-lifetimes-into head out)))]))

(define (tc-type-collect-reference-lifetimes-into
  [ty : AstType]
  [out : TcStringList]) : TcStringList
  (match ty
    [(AstTyFunc args ret)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get ret)
        (tc-type-list-collect-reference-lifetimes (box-get args) out))]
    [(AstTyTuple elems)
      (tc-type-list-collect-reference-lifetimes (box-get elems) out)]
    [(AstTyArray elem _)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyDynArray elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyBox elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyMutPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstTyMutRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstTyRegion _ inner)
      (tc-type-collect-reference-lifetimes-into (ty-node-get inner) out)]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-reference-lifetimes [ty : AstType]) : TcStringList
  (tc-type-collect-reference-lifetimes-into ty TcStringNil))

(define (tc-maybe-type-contains-reference? [maybe-ty : AstMaybeType]) : bool
  (match maybe-ty
    [(AstNoType) false]
    [(AstSomeType ty) (tc-type-contains-reference? ty)]))

(define (tc-param-list-contains-reference? [params : AstParamList]) : bool
  (match params
    [(AstParamNil) false]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam _ ty _)
            (or
              (tc-type-contains-reference? ty)
              (tc-param-list-contains-reference? rest))]))]))

(define (tc-param-list-reference-return-lifetimes-into
  [ctx : TcContext]
  [params : AstParamList]
  [out : TcStringList]) : TcStringList
  (match params
    [(AstParamNil) out]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name ty _)
            (tc-param-list-reference-return-lifetimes-into
              ctx
              rest
              (tc-type-collect-reference-lifetimes-into
                (tc-resolve-type ctx ty)
                (tc-string-list-add out (intern-str name))))]))]))

(define (tc-reference-return-lifetimes-allowed?
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : bool
  (tc-string-list-all-in?
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))
    (tc-param-list-reference-return-lifetimes-into ctx params TcStringNil)))

(define (tc-reference-return-policy-ok
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : ResultTcUnit
  (if (tc-type-contains-reference? (tc-resolve-type ctx ret))
    (if (tc-reference-return-lifetimes-allowed? ctx params ret)
      OkTcUnit
      (ErrTcUnit
        "typecheck: returned reference lifetime must be tied to a parameter"))
    OkTcUnit))

(define (tc-type-list-collect-regions
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (match types
    [(AstTypeNil) out]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (tc-type-list-collect-regions
          tail
          (tc-type-collect-regions-into head out)))]))

(define (tc-type-collect-regions-into [ty : AstType] [out : TcStringList]) : TcStringList
  (match ty
    [(AstTyFunc args ret)
      (tc-type-collect-regions-into
        (ty-node-get ret)
        (tc-type-list-collect-regions (box-get args) out))]
    [(AstTyTuple elems) (tc-type-list-collect-regions (box-get elems) out)]
    [(AstTyArray elem _) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyDynArray elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyBox elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyPtr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyMutPtr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyMutRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyRegion name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-regions [ty : AstType]) : TcStringList
  (tc-type-collect-regions-into ty TcStringNil))

(define (tc-region-list-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [regions : TcStringList]) : bool
  (match regions
    [(TcStringNil) true]
    [(TcStringCons region rest)
      (and
        (tc-atomic-arena-owner-active? env region)
        (tc-region-list-all-atomic-arena-owners? env (box-get rest)))]))

(define (tc-type-regions-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [ty : AstType]) : bool
  (tc-region-list-all-atomic-arena-owners? env (tc-type-collect-regions ty)))

(define (tc-type-outer-region [ty : AstType]) : TcMaybeString
  (match ty
    [(AstTyRegion region _) (TcSomeString region)]
    [_ (TcNoString)]))

(define (tc-region-taggable-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyString) true]
    [(AstTyDynArray _) true]
    [(AstTyBox _) true]
    [(AstTyTuple _) true]
    [(AstTyStruct _) true]
    [(AstTyStructArgs _ _) true]
    [(AstTyEnum _) true]
    [(AstTyEnumArgs _ _) true]
    [_ false]))

(define (tc-tag-region [region : String] [ty : AstType]) : AstType
  (if (tc-region-taggable-type? ty)
    (ast-ty-region region ty)
    ty))

(define (tc-tag-active-region [env : TcTypeEnv] [ty : AstType]) : AstType
  (match (tc-active-region env)
    [(TcSomeString region) (tc-tag-region region ty)]
    [(TcNoString) ty]))

;; Nominal aggregate types have no lifetime-argument surface yet. Until they do,
;; constructor results carry stored-reference lifetimes as local region facts so
;; existing flow/escape checks can reject boundary escapes.
(define (tc-tag-reference-lifetimes [lifetimes : TcStringList] [ty : AstType]) : AstType
  (match lifetimes
    [(TcStringNil) ty]
    [(TcStringCons lifetime rest)
      (tc-tag-region lifetime (tc-tag-reference-lifetimes (box-get rest) ty))]))

(define (tc-constructor-target-type
  [env : TcTypeEnv]
  [params : AstTypeList]
  [ret : AstType]) : AstType
  (tc-tag-active-region
    env
    (tc-tag-reference-lifetimes
      (tc-type-list-collect-reference-lifetimes params TcStringNil)
      ret)))

(define (tc-project-from-region-container
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (match (tc-type-outer-region container-ty)
    [(TcSomeString region) (tc-tag-region region projected-ty)]
    [(TcNoString)
      (match (tc-type-strip-region container-ty)
        [(AstTyRef region _) (tc-tag-region region projected-ty)]
        [(AstTyMutRef region _) (tc-tag-region region projected-ty)]
        [_ projected-ty])]))

;; Region-tagged aggregate flow uses the same lexical owner ordering as
;; references, but only considers arena owners. A value from an outer region can
;; flow into an inner target; an inner-region value cannot flow outward.
(define (tc-region-outlives-or-matches-scan
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (if (string.string-eq value-region target-region)
    true
    (match env
      [(TcTypeNil) false]
      [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region)
          false)]
      [(TcTypeBind key ty rest)
        (if (= key (tc-region-marker-id))
          (match ty
            [(AstTyVar region)
              (if (string.string-eq (intern-str region) value-region)
                false
                (if (string.string-eq (intern-str region) target-region)
                  true
                  (tc-region-outlives-or-matches-scan
                    (box-get rest)
                    value-region
                    target-region)))]
            [_
              (tc-region-outlives-or-matches-scan
                (box-get rest)
                value-region
                target-region)])
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region))])))

(define (tc-region-outlives-or-matches
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-region-outlives-or-matches-scan
          (box-get rest)
          value-region
          target-region)]
      [_ (tc-region-outlives-or-matches-scan env value-region target-region)])))

(define (tc-region-can-flow-into-any
  [env : TcTypeEnv]
  [value-region : String]
  [target-regions : TcStringList]) : bool
  (match target-regions
    [(TcStringNil) false]
    [(TcStringCons target rest)
      (if (tc-region-outlives-or-matches env value-region target)
        true
        (tc-region-can-flow-into-any env value-region (box-get rest)))]))

(define (tc-region-list-can-flow-into
  [env : TcTypeEnv]
  [value-regions : TcStringList]
  [target-regions : TcStringList]) : bool
  (match value-regions
    [(TcStringNil) true]
    [(TcStringCons value rest)
      (and
        (tc-region-can-flow-into-any env value target-regions)
        (tc-region-list-can-flow-into env (box-get rest) target-regions))]))

(define (tc-ensure-region-value-can-flow-into
  [env : TcTypeEnv]
  [target-ty : AstType]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [value-regions : TcStringList (tc-type-collect-regions value-ty)]
    (match value-regions
      [(TcStringNil) OkTcUnit]
      [_
        (let
          [target-regions : TcStringList (tc-type-collect-regions target-ty)]
          (if (and
            (tc-type-contains-any-region target-ty)
            (tc-region-list-can-flow-into env value-regions target-regions))
            OkTcUnit
            (ErrTcUnit
              (string.string-append
                "typecheck: cannot store region-tagged value into "
                (string.string-append context "; region value would escape")))))])))

(define (tc-resolve-type-list [ctx : TcContext] [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-needs-resolution? types)
    (match types
      [(AstTypeNil) AstTypeNil]
      [(AstTypeCons head tail)
        (let
          [head : AstType (ty-node-get head)]
          [tail : AstTypeList (box-get tail)]
          (ast-type-cons
            (tc-resolve-type ctx head)
            (tc-resolve-type-list ctx tail)))])
    types))

(define (tc-type-list-needs-resolution? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (if (tc-type-needs-resolution? head)
          true
          (tc-type-list-needs-resolution? tail)))]))

(define (tc-type-needs-resolution? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (if (tc-type-list-needs-resolution? (box-get args))
        true
        (tc-type-needs-resolution? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-needs-resolution? (box-get elems))]
    [(AstTyArray elem _) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyMutRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyRegion _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyVarArgs _ _) true]
    [(AstTyVar _) true]
    [_ false]))

(define (tc-name-qualified? [name : String]) : bool
  (and (not (tc-hygiene-local-name? name)) (intern-name-qualified? name)))

(define (tc-name-first-char [name : String] [needle : char]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (if (string.char-eq (string.string-ref name i) needle)
          (return i)
          (set! i (+ i 1))))
      -1)))

(define (tc-name-first-dot [name : String]) : i64
  (intern-name-first-dot name))

(define (tc-source-slash-qualified? [name : String]) : bool
  (tc-source-slash-qualified-id? name (tc-name-id name)))

;; Variant taking the already-interned `name-id` so the hot name-resolution
;; path interns each name once and reads the slash position from the id-keyed
;; metadata instead of re-hashing the string. The hygiene checks stay on the
;; string (cheap prefix tests, no interning). `intern-name-last-slash name`
;; is exactly `intern-qualified-last-slash (intern name)`, so this is
;; semantics-preserving.
(define (tc-source-slash-qualified-id? [name : String] [name-id : i64]) : bool
  (let
    [slash : i64 (intern-qualified-last-slash name-id)]
    [n : i64 (string.string-length name)]
    (and
      (not (tc-hygiene-local-name? name))
      (not (tc-hygiene-global-name? name))
      (> slash 0)
      (< slash (- n 1)))))

(define (tc-name-slashes-to-dots [name : String]) : String
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    [out : String ""]
    (begin
      (while (< i n)
        (let
          [chunk : String
            (if (string.char-eq (string.string-ref name i) '/')
              "."
              (string.substring name i 1))]
          (begin
            (set! out (string.string-concat3 out chunk ""))
            (set! i (+ i 1)))))
      out)))

(define (tc-source-slash-qualified-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: slash-qualified name "
    name
    " is no longer supported; use "
    (tc-name-slashes-to-dots name)))

;; Bootstrap bridge: published stage0 builds may still encounter legacy
;; slash-qualified core macro spellings. Keep this narrow until the seed no
;; longer needs the compatibility path.
(define (tc-source-legacy-core-macro-compat? [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      (and
        (string.string-eq module "core")
        (or
          (string.string-eq base "when")
          (string.string-eq base "unless")
          (string.string-eq base "and")
          (string.string-eq base "or")
          (string.string-eq base "cond"))))
    false))

(define (tc-source-name-bound-exact-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-name-bound-id? env name-id))

(define (tc-source-name-bound-exact? [env : TcTypeEnv] [name : String]) : bool
  (tc-source-name-bound-exact-id? env (tc-name-id name)))

(define (tc-current-module-source-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : TcMaybeString
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name)))
      (let
        [module-key : String (compiler-symbol-module-key module name)]
        [module-key-id : i64 (tc-name-id module-key)]
        (if (tc-source-name-bound-exact-id? env module-key-id)
          (TcSomeString module-key)
          (TcNoString)))
      (TcNoString))))

(define (tc-source-leading-segment-bound?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (tc-source-name-bound-exact? env (string.substring name 0 first-dot))))

(define (tc-source-leading-segment-wins-over-exact-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        false
        (if (= key prefix-id)
          true
          (tc-source-leading-segment-wins-over-exact-id?
            (box-get rest)
            name-id
            prefix-id)))]
    [(TcTypeCache ids _ _ _ _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids prefix-id)
        [(hashmap.I64I64MapFound prefix-index)
          (match (hashmap.i64-i64-map-get ids name-id)
            [(hashmap.I64I64MapFound name-index) (< prefix-index name-index)]
            [(hashmap.I64I64MapMissing) true])]
        [(hashmap.I64I64MapMissing)
          (match (hashmap.i64-i64-map-get ids name-id)
            [(hashmap.I64I64MapFound _) false]
            [(hashmap.I64I64MapMissing)
              (if partial
                (tc-source-leading-segment-wins-over-exact-id?
                  (box-get below)
                  name-id
                  prefix-id)
                false)])])]))

(define (tc-source-leading-segment-wins-over-exact-id-from-dot?
  [env : TcTypeEnv]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (tc-source-leading-segment-wins-over-exact-id?
      env
      name-id
      (intern-slice (intern-str name-id) 0 first-dot))))

(define (tc-source-leading-segment-wins-over-exact?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (tc-source-leading-segment-wins-over-exact-from-id?
    env
    name
    (tc-name-id name)
    first-dot))

;; Variant taking the already-interned `name-id` to avoid re-hashing `name` on
;; the hot resolution path. The prefix is still interned via the cached
;; `intern-slice`.
(define (tc-source-leading-segment-wins-over-exact-from-id?
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (let
      [prefix-id : i64 (intern-slice name 0 first-dot)]
      (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id))))

(define (tc-dotted-field-index-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: dotted field access "
    name
    " cannot use numeric field segments; use tuple-ref or array-ref"))

(define (tc-dotted-field-empty-message) : String
  "typecheck: malformed dotted field access; field name cannot be empty")

(define (tc-dotted-field-index-like? [name : String] [start : i64] [len : i64]) : bool
  (and
    (> len 0)
    (>= (string.string-ref name start) '0')
    (<= (string.string-ref name start) '9')))

(define (tc-dotted-local-field-name? [env : TcTypeEnv] [name : String]) : bool
  (let
    [first-dot : i64 (tc-name-first-dot name)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact? env name first-dot))))

(define (tc-dotted-local-field-name-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact-id-from-dot?
        env
        name-id
        first-dot))))

(define (tc-dotted-local-field-expr-id-tail
  [name : String]
  [start : i64]
  [current : i64]) : ResultTcExprId
  (let
    [n : i64 (string.string-length name)]
    [i : i64 start]
    (begin
      (while (and (< i n) (not (string.char-eq (string.string-ref name i) '.')))
        (set! i (+ i 1)))
      (let
        [len : i64 (- i start)]
        (if (<= len 0)
          (ErrTcExprId (tc-dotted-field-empty-message))
          (if (tc-dotted-field-index-like? name start len)
            (ErrTcExprId (tc-dotted-field-index-message name))
            (let
              [field : String (string.substring name start len)]
              [next : i64 (ast-expr-struct-get current field)]
              (if (< i n)
                (tc-dotted-local-field-expr-id-tail name (+ i 1) next)
                (OkTcExprId next)))))))))

(define (tc-dotted-local-field-expr-id [env : TcTypeEnv] [name : String]) : ResultTcExprId
  (if (tc-dotted-local-field-name? env name)
    (let
      [first-dot : i64 (tc-name-first-dot name)]
      [root-name : String (string.substring name 0 first-dot)]
      [root : i64 (ast-node-push (AstExprVar (intern root-name)))]
      (tc-dotted-local-field-expr-id-tail name (+ first-dot 1) root))
    (ErrTcExprId "")))

(define (tc-dotted-local-field-set-expr-id
  [env : TcTypeEnv]
  [name : String]
  [value : i64]) : ResultTcExprId
  (match (tc-dotted-local-field-expr-id env name)
    [(OkTcExprId get-id)
      (match (ast-expr-unspan (ast-node-get get-id))
        [(AstExprStructGet receiver-box field)
          (OkTcExprId (ast-expr-struct-set-id receiver-box field value))]
        [_ (ErrTcExprId "typecheck: internal dotted field target mismatch")])]
    [(ErrTcExprId message) (ErrTcExprId message)]))

(define tc-imported-module-identity-cache-capacity : i64
  8192)
(define tc-imported-module-identity-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-target-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-count : i64
  0)
(define tc-imported-module-identity-cache-generation : i64
  -1)
(define tc-imported-module-identity-cache-ready : bool
  false)

(define (tc-imported-module-identity-cache-reset!) : unit
  (set! tc-imported-module-identity-cache-ready false))

(define (tc-imported-module-identity-cache-ensure!) : unit
  (if (if tc-imported-module-identity-cache-ready
    (= tc-imported-module-identity-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-imported-module-identity-cache-capacity)
          (begin
            (array.array-set! tc-imported-module-identity-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-imported-module-identity-cache-count 0)
        (set! tc-imported-module-identity-cache-generation (intern-generation))
        (set! tc-imported-module-identity-cache-ready true)))))

(define (tc-imported-module-identity-cache-bucket
  [current-module-id : i64]
  [target-id : i64]) : i64
  (bit-and
    (+ (* current-module-id 2654435761) (* target-id 40503))
    (- tc-imported-module-identity-cache-capacity 1)))

;; Returns 1 for true, -1 for false, or -2 when absent.
(define (tc-imported-module-identity-cache-get
  [current-module-id : i64]
  [target-id : i64]) : i64
  (let
    [cursor : i64
      (tc-imported-module-identity-cache-bucket current-module-id target-id)]
    [module-key : i64 (+ current-module-id 1)]
    [target-key : i64 (+ target-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps tc-imported-module-identity-cache-capacity))
        (let
          [slot : i64
            (array.array-ref
              tc-imported-module-identity-cache-module-keys
              cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array.array-ref
                  tc-imported-module-identity-cache-target-keys
                  cursor)
                target-key))
              (begin
                (set!
                  out
                  (array.array-ref
                    tc-imported-module-identity-cache-values
                    cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- tc-imported-module-identity-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (tc-imported-module-identity-cache-put!
  [current-module-id : i64]
  [target-id : i64]
  [value : bool]) : unit
  (if (>=
    (* tc-imported-module-identity-cache-count 2)
    tc-imported-module-identity-cache-capacity)
    unit
    (let
      [cursor : i64
        (tc-imported-module-identity-cache-bucket current-module-id target-id)]
      [module-key : i64 (+ current-module-id 1)]
      [target-key : i64 (+ target-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps tc-imported-module-identity-cache-capacity))
          (let
            [slot : i64
              (array.array-ref
                tc-imported-module-identity-cache-module-keys
                cursor)]
            (if (= slot 0)
              (begin
                (array.array-set!
                  tc-imported-module-identity-cache-module-keys
                  cursor
                  module-key)
                (array.array-set!
                  tc-imported-module-identity-cache-target-keys
                  cursor
                  target-key)
                (array.array-set!
                  tc-imported-module-identity-cache-values
                  cursor
                  (if value
                    1
                    -1))
                (set!
                  tc-imported-module-identity-cache-count
                  (+ tc-imported-module-identity-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array.array-ref
                    tc-imported-module-identity-cache-target-keys
                    cursor)
                  target-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- tc-imported-module-identity-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (tc-imported-module-identity-ids?
  [decls : AstDeclList]
  [current-module-id : i64]
  [target-id : i64]
  [module-id : i64]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-imported-module-identity-ids?
              rest
              current-module-id
              target-id
              next-module)]
          [(AstDeclImport (AstImportSpec _ _ expected _ _))
            (if (= module-id current-module-id)
              (match expected
                [(AstSomeModuleName target)
                  (if (= (intern target) target-id)
                    true
                    (tc-imported-module-identity-ids?
                      rest
                      current-module-id
                      target-id
                      module-id))]
                [(AstNoModuleName)
                  (tc-imported-module-identity-ids?
                    rest
                    current-module-id
                    target-id
                    module-id)])
              (tc-imported-module-identity-ids?
                rest
                current-module-id
                target-id
                module-id))]
          [_
            (tc-imported-module-identity-ids?
              rest
              current-module-id
              target-id
              module-id)]))]))

(define (tc-imported-module-identity? [ctx : TcContext] [module-name : String]) : bool
  (match ctx
    [(TcContext program _ _ current-module _)
      (match program
        [(AstProgram decls-box)
          (begin
            (tc-imported-module-identity-cache-ensure!)
            (let
              [current-module-id : i64 (intern current-module)]
              [target-id : i64 (intern module-name)]
              [cached : i64
                (tc-imported-module-identity-cache-get
                  current-module-id
                  target-id)]
              (if (= cached -2)
                (let
                  [found : bool
                    (tc-imported-module-identity-ids?
                      (box-get decls-box)
                      current-module-id
                      target-id
                      (intern ""))]
                  (begin
                    (tc-imported-module-identity-cache-put!
                      current-module-id
                      target-id
                      found)
                    found))
                (> cached 0))))])]))

(define (tc-stdlib-string-module-name? [module-name : String]) : bool
  (or
    (string.string-eq module-name "string")
    (string.string-eq module-name "string.tl")
    (string.string-eq module-name "stdlib.string")
    (string.string-eq module-name "stdlib/string")
    (string.string-eq module-name "stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib/string.tl")
    (tc-string-has-suffix? module-name "\\stdlib\\string.tl")
    (tc-string-has-suffix? module-name "\\stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib\\string.tl")))

(define (tc-context-is-stdlib-string? [ctx : TcContext]) : bool
  (tc-stdlib-string-module-name? (tc-context-module ctx)))

(define (tc-stdlib-string-length-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc args ret)
      (match (box-get args)
        [(AstTypeCons text rest)
          (let
            [text : AstType (ty-node-get text)]
            [rest : AstTypeList (box-get rest)]
            (match rest
              [(AstTypeNil)
                (and
                  (tc-str-ref-type? text)
                  (tc-type-eq (ty-node-get ret) (AstTyI64)))]
              [_ false]))]
        [_ false])]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc args ret)
      (match (box-get args)
        [(AstTypeCons text rest1)
          (let
            [text : AstType (ty-node-get text)]
            [rest1 : AstTypeList (box-get rest1)]
            (match rest1
              [(AstTypeCons index rest2)
                (let
                  [index : AstType (ty-node-get index)]
                  [rest2 : AstTypeList (box-get rest2)]
                  (match rest2
                    [(AstTypeNil)
                      (and
                        (tc-str-ref-type? text)
                        (tc-type-eq index (AstTyI64))
                        (tc-type-eq (ty-node-get ret) (AstTyChar)))]
                    [_ false]))]
              [_ false]))]
        [_ false])]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc args ret)
      (match (box-get args)
        [(AstTypeCons left rest1)
          (let
            [left : AstType (ty-node-get left)]
            [rest1 : AstTypeList (box-get rest1)]
            (match rest1
              [(AstTypeCons right rest2)
                (let
                  [right : AstType (ty-node-get right)]
                  [rest2 : AstTypeList (box-get rest2)]
                  (match rest2
                    [(AstTypeNil)
                      (and
                        (tc-string-handle-type? left)
                        (tc-string-handle-type? right)
                        (tc-type-eq (ty-node-get ret) (AstTyBool)))]
                    [_ false]))]
              [_ false]))]
        [_ false])]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc args ret)
      (match (box-get args)
        [(AstTypeCons left rest1)
          (let
            [left : AstType (ty-node-get left)]
            [rest1 : AstTypeList (box-get rest1)]
            (match rest1
              [(AstTypeCons right rest2)
                (let
                  [right : AstType (ty-node-get right)]
                  [rest2 : AstTypeList (box-get rest2)]
                  (match rest2
                    [(AstTypeNil)
                      (and
                        (tc-str-ref-type? left)
                        (tc-str-ref-type? right)
                        (tc-type-eq (ty-node-get ret) (AstTyString)))]
                    [_ false]))]
              [_ false]))]
        [_ false])]
    [_ false]))

(define (tc-stdlib-string-to-int-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc args ret)
      (match (box-get args)
        [(AstTypeCons text rest)
          (let
            [text : AstType (ty-node-get text)]
            [rest : AstTypeList (box-get rest)]
            (match rest
              [(AstTypeNil)
                (and
                  (tc-string-handle-type? text)
                  (tc-type-eq (ty-node-get ret) (AstTyI64)))]
              [_ false]))]
        [_ false])]
    [_ false]))

(define (tc-stdlib-string-helper-wrapper-type? [base : String] [ty : AstType]) : bool
  (cond
    [(string.string-eq base "string-length")
      (tc-stdlib-string-length-wrapper-type? ty)]
    [(string.string-eq base "string-ref")
      (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.string-eq base "char-at") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.string-eq base "string-eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.string-eq base "string=?") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.string-eq base "string-append")
      (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.string-eq base "string-concat")
      (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.string-eq base "string->int")
      (tc-stdlib-string-to-int-wrapper-type? ty)]
    [else false]))

(define (tc-stdlib-string-helper-bound-wrapper?
  [env : TcTypeEnv]
  [base : String]) : bool
  (match (tc-lookup env base)
    [(OkTcType ty) (tc-stdlib-string-helper-wrapper-type? base ty)]
    [(ErrTcType _) false]))

(define (tc-stdlib-string-length-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDefFn name params ret _ _)
      (and
        (string.string-eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstTyI64))
        (match params
          [(AstParamCons param rest)
            (let
              [rest : AstParamList (box-get rest)]
              (match param
                [(AstParam _ text _)
                  (and
                    (tc-str-ref-type? (tc-resolve-type ctx text))
                    (match rest
                      [(AstParamNil) true]
                      [_ false]))]))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDefFn name params ret _ _)
      (and
        (string.string-eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstTyChar))
        (match params
          [(AstParamCons text-param rest1)
            (let
              [rest1 : AstParamList (box-get rest1)]
              (match rest1
                [(AstParamCons index-param rest2)
                  (let
                    [rest2 : AstParamList (box-get rest2)]
                    (match text-param
                      [(AstParam _ text _)
                        (match index-param
                          [(AstParam _ index _)
                            (and
                              (tc-str-ref-type? (tc-resolve-type ctx text))
                              (tc-type-eq
                                (tc-resolve-type ctx index)
                                (AstTyI64))
                              (match rest2
                                [(AstParamNil) true]
                                [_ false]))])]))]
                [_ false]))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDefFn name params ret _ _)
      (and
        (string.string-eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstTyString))
        (match params
          [(AstParamCons left-param rest1)
            (let
              [rest1 : AstParamList (box-get rest1)]
              (match rest1
                [(AstParamCons right-param rest2)
                  (let
                    [rest2 : AstParamList (box-get rest2)]
                    (match left-param
                      [(AstParam _ left _)
                        (match right-param
                          [(AstParam _ right _)
                            (and
                              (tc-str-ref-type? (tc-resolve-type ctx left))
                              (tc-str-ref-type? (tc-resolve-type ctx right))
                              (match rest2
                                [(AstParamNil) true]
                                [_ false]))])]))]
                [_ false]))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-helper-symbol-wrapper?
  [ctx : TcContext]
  [base : String]) : bool
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-symbols-lookup-value symbols base)
        [(SomeI64 handle)
          (let
            [decls : (Array AstDecl) (compiler-symbols-decls symbols)]
            [index : i64 (compiler-symbol-handle-index handle)]
            (if (or (< index 0) (>= index (array.array-length decls)))
              false
              (let
                [decl : AstDecl (array.array-ref decls index)]
                (cond
                  [(string.string-eq base "string-length")
                    (tc-stdlib-string-length-wrapper-decl? ctx base decl)]
                  [(string.string-eq base "string-ref")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.string-eq base "char-at")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.string-eq base "string-append")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [(string.string-eq base "string-concat")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [else false]))))]
        [(NoneI64) false])]))

(define (tc-stdlib-string-qualified-helper-id?
  [lookup-id : i64]
  [base : String]) : bool
  (and
    (intern-qualified? lookup-id)
    (= (intern-qualified-base-id lookup-id) (tc-name-id base))
    (tc-stdlib-string-module-name? (intern-qualified-module lookup-id))))

(define (tc-decl-list-module-imports-stdlib-string?
  [decls : AstDeclList]
  [target-module-id : i64]
  [current-module-id : i64]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest-box)
      (let
        [rest : AstDeclList (box-get rest-box)]
        (match decl
          [(AstDeclModule next-module)
            (tc-decl-list-module-imports-stdlib-string?
              rest
              target-module-id
              next-module)]
          [(AstDeclImport
              (AstImportSpec _ _ (AstSomeModuleName import-module) _ _))
            (if (and
              (= current-module-id target-module-id)
              (tc-stdlib-string-module-name? import-module))
              true
              (tc-decl-list-module-imports-stdlib-string?
                rest
                target-module-id
                current-module-id))]
          [_
            (tc-decl-list-module-imports-stdlib-string?
              rest
              target-module-id
              current-module-id)]))]))

(define (tc-context-imports-stdlib-string? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ module _)
      (match program
        [(AstProgram decls-box)
          (tc-decl-list-module-imports-stdlib-string?
            (box-get decls-box)
            (intern module)
            (intern ""))])]))

(define (tc-stdlib-string-helper-visible-or-wrapper-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-match : bool]
  [lookup-id : i64]
  [base : String]) : bool
  (if source-match
    (or
      (tc-context-is-stdlib-string? ctx)
      (tc-context-imports-stdlib-string? ctx)
      (tc-stdlib-string-helper-bound-wrapper? env base)
      (tc-stdlib-string-helper-symbol-wrapper? ctx base)
      (tc-stdlib-string-qualified-helper-id? lookup-id base))
    (tc-stdlib-string-qualified-helper-id? lookup-id base)))

(define tc-source-dotted-alias-key-cache-capacity : i64
  8192)
(define tc-source-dotted-alias-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-generation : i64
  -1)
(define tc-source-dotted-alias-key-cache-ready : bool
  false)

(define (tc-source-dotted-alias-key-cache-reset!) : unit
  (set! tc-source-dotted-alias-key-cache-ready false))

(define (tc-source-dotted-alias-key-cache-ensure!) : unit
  (if (if tc-source-dotted-alias-key-cache-ready
    (= tc-source-dotted-alias-key-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-dotted-alias-key-cache-capacity)
          (begin
            (array.array-set! tc-source-dotted-alias-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-source-dotted-alias-key-cache-generation (intern-generation))
        (set! tc-source-dotted-alias-key-cache-ready true)))))

(define (tc-source-dotted-alias-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- tc-source-dotted-alias-key-cache-capacity 1)))

;; Returns the cached lookup-name id, -1 for no alias import, or -2 when absent.
(define (tc-source-dotted-alias-key-cache-get [module-id : i64] [name-id : i64]) : i64
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array.array-ref tc-source-dotted-alias-key-cache-module-keys cursor)
          module-key)
        (=
          (array.array-ref tc-source-dotted-alias-key-cache-name-keys cursor)
          name-key))
        (array.array-ref tc-source-dotted-alias-key-cache-values cursor)
        -2))))

(define (tc-source-dotted-alias-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      (begin
        (array.array-set!
          tc-source-dotted-alias-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array.array-set!
          tc-source-dotted-alias-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array.array-set! tc-source-dotted-alias-key-cache-values cursor value)))))

(define tc-lazy-import-stubs : TcLazyImportStubList
  (TcLazyImportStubNil))
(define tc-lazy-import-stub-record-count : i64
  0)
(define tc-lazy-import-summary-backed-count : i64
  0)
(define tc-lazy-import-summary-macro-force-record-count : i64
  0)

(define (tc-lazy-import-stubs-reset!) : unit
  (begin
    (set! tc-lazy-import-stubs (TcLazyImportStubNil))
    (set! tc-lazy-import-stub-record-count 0)
    (set! tc-lazy-import-summary-backed-count 0)
    (tc-source-dotted-alias-key-cache-reset!)))

(define (tc-lazy-import-stub-count) : i64
  tc-lazy-import-stub-record-count)

(define (tc-lazy-import-summary-backed-stub-count) : i64
  tc-lazy-import-summary-backed-count)

(define (tc-lazy-import-summary-macro-force-count) : i64
  tc-lazy-import-summary-macro-force-record-count)

(define (tc-lazy-import-summary-macro-force-record!) : unit
  (set!
    tc-lazy-import-summary-macro-force-record-count
    (+ tc-lazy-import-summary-macro-force-record-count 1)))

(define (tc-lazy-import-stub-record!
  [importer-module-id : i64]
  [alias : String]
  [target-module : String]
  [summary-backed : bool]) : unit
  (begin
    (set!
      tc-lazy-import-stubs
      (TcLazyImportStubCons
        importer-module-id
        (intern alias)
        target-module
        summary-backed
        (box tc-lazy-import-stubs)))
    (set!
      tc-lazy-import-stub-record-count
      (+ tc-lazy-import-stub-record-count 1))
    (if summary-backed
      (set!
        tc-lazy-import-summary-backed-count
        (+ tc-lazy-import-summary-backed-count 1))
      unit)
    (tc-source-dotted-alias-key-cache-reset!)))

(define (tc-lazy-import-stub-target-in
  [stubs : TcLazyImportStubList]
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeString
  (match stubs
    [(TcLazyImportStubNil) (TcNoString)]
    [(TcLazyImportStubCons
        stub-module-id
        stub-alias-id
        target-module
        _
        rest-box)
      (if (and (= stub-module-id importer-module-id) (= stub-alias-id alias-id))
        (TcSomeString target-module)
        (tc-lazy-import-stub-target-in
          (box-get rest-box)
          importer-module-id
          alias-id))]))

(define (tc-lazy-import-stub-target [importer-module-id : i64] [alias : String]) : TcMaybeString
  (tc-lazy-import-stub-target-in
    tc-lazy-import-stubs
    importer-module-id
    (intern alias)))

(define (tc-source-dotted-alias-target
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias : String]) : TcMaybeString
  (match (tc-lazy-import-stub-target current-module-id alias)
    [(TcSomeString target-module) (TcSomeString target-module)]
    [(TcNoString)
      (macro-import-alias-target-cached decls current-module-id alias)]))

(define (tc-call-builtin-lookup-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]) : String
  (if (tc-name-qualified? source-name)
    source-name
    (if (>= (tc-name-first-dot source-name) 0)
      (match (tc-source-name-lookup-key ctx env source-name)
        [(OkTcString lookup-name) lookup-name]
        [(ErrTcString _) source-name])
      source-name)))

(define (tc-call-builtin-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : i64
  (if (and
    (not (tc-hygiene-local-name? source-name))
    (intern-qualified? source-id))
    source-id
    (if (>= (intern-first-dot source-id) 0)
      (match (tc-source-name-lookup-key ctx env source-name)
        [(OkTcString lookup-name) (tc-builtin-name-id lookup-name)]
        [(ErrTcString _) source-id])
      source-id)))

(define (tc-source-dotted-alias-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcNoString)
      (let
        [current-module-id : i64 (intern (tc-context-module ctx))]
        [cached : i64
          (tc-source-dotted-alias-key-cache-get current-module-id name-id)]
        (if (= cached -2)
          (let
            [alias : String (string.substring name 0 first-dot)]
            [base-start : i64 (+ first-dot 1)]
            [base : String (string.substring name base-start (- n base-start))]
            (match (tc-context-program ctx)
              [(AstProgram decls-box)
                (match (tc-source-dotted-alias-target
                  (box-get decls-box)
                  current-module-id
                  alias)
                  [(TcSomeString target-module)
                    (let
                      [lookup-name : String
                        (compiler-symbol-module-key target-module base)]
                      (begin
                        (tc-source-dotted-alias-key-cache-put!
                          current-module-id
                          name-id
                          (intern lookup-name))
                        (TcSomeString lookup-name)))]
                  [(TcNoString)
                    (begin
                      (tc-source-dotted-alias-key-cache-put!
                        current-module-id
                        name-id
                        -1)
                      (TcNoString))])]))
          (if (< cached 0)
            (TcNoString)
            (TcSomeString (intern-str cached))))))))

(define (tc-source-alias-display-key [ctx : TcContext] [name : String]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    [first-dot : i64 (tc-name-first-dot name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcNoString)
      (let
        [alias : String (string.substring name 0 first-dot)]
        [base-start : i64 (+ first-dot 1)]
        [base : String (string.substring name base-start (- n base-start))]
        (match ctx
          [(TcContext program _ _ current-module _)
            (match program
              [(AstProgram decls-box)
                (let
                  [target : String
                    (macro-resolve-qualified-module
                      (box-get decls-box)
                      current-module
                      alias)]
                  (if (string.string-eq target alias)
                    (TcNoString)
                    (TcSomeString (compiler-symbol-module-key alias base))))])])))))

(define (tc-source-lookup-display-name
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]) : String
  (match (tc-source-alias-display-key ctx source-name)
    [(TcSomeString display-name) display-name]
    [(TcNoString) lookup-name]))

(define (tc-source-unbound-display-message
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [message : String]) : String
  (let
    [lookup-unbound : String
      (string.string-append "typecheck: unbound name " lookup-name)]
    (match (tc-source-alias-display-key ctx source-name)
      [(TcSomeString display-name)
        (if (string.string-eq message lookup-unbound)
          (string.string-append "typecheck: unbound name " display-name)
          message)]
      [(TcNoString) message])))

(define (tc-source-dotted-full-path-key [ctx : TcContext] [name : String]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    [i : i64 0]
    [best-dot : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref name i) '.')
            (let
              [candidate : String (string.substring name 0 i)]
              (if (or
                (string.string-eq candidate (tc-context-module ctx))
                (tc-imported-module-identity? ctx candidate))
                (set! best-dot i)
                unit))
            unit)
          (set! i (+ i 1))))
      (if (and (> best-dot 0) (< best-dot (- n 1)))
        (let
          [base-start : i64 (+ best-dot 1)]
          [module-name : String (string.substring name 0 best-dot)]
          [base : String (string.substring name base-start (- n base-start))]
          (TcSomeString (compiler-symbol-module-key module-name base)))
        (TcNoString)))))

(define (tc-unresolved-dotted-name-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown qualified name "
    name
    "; import the module or use a visible dotted module alias"))

(define (tc-comptime-syntax-helper-name? [name : String]) : bool
  (or
    (string.string-eq name "expr-bool")
    (string.string-eq name "expr-int")
    (string.string-eq name "expr-string")
    (string.string-eq name "expr-var")
    (string.string-eq name "expr-struct-get")
    (string.string-eq name "expr-struct-set")
    (string.string-eq name "expr-splice")
    (string.string-eq name "expr-if")
    (string.string-eq name "expr-type")
    (string.string-eq name "module-name")
    (string.string-eq name "module-export-macro?")
    (string.string-eq name "module-hook")
    (ctfe-expr-inspector-name? name)
    (ctfe-expr-list-inspector-name? name)
    (ctfe-expr-clause-inspector-name? name)
    (ctfe-expr-clause-list-inspector-name? name)
    (ctfe-expr-binding-clause-inspector-name? name)
    (ctfe-expr-binding-clause-list-inspector-name? name)
    (string.string-eq name "comptime-error")))

(define (tc-string-prefix-at? [text : String] [prefix : String] [start : i64]) : bool
  (string.is-string-prefix-at (& text) (& prefix) start))

(define (tc-comptime-helper-qualified-candidate-from-id?
  [name : String]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (let
      [prefix-id : i64 (intern-slice name 0 first-dot)]
      (if (or
        (= prefix-id (intern "comptime"))
        (= prefix-id (intern "stdlib/comptime")))
        true
        (if (= prefix-id (intern "stdlib"))
          (or
            (tc-string-prefix-at? name "comptime." (+ first-dot 1))
            (tc-string-prefix-at? name "comptime/" (+ first-dot 1)))
          false)))))

(define (tc-comptime-helper-qualified-lookup-key
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : TcMaybeString
  (if (tc-comptime-helper-qualified-candidate-from-id? name first-dot)
    (let
      [call-name : String (ctfe-comptime-helper-call-name name)]
      (if (and
        (not (string.string-eq call-name name))
        (tc-comptime-syntax-helper-name? call-name)
        (tc-source-name-bound-exact? env call-name))
        (TcSomeString call-name)
        (TcNoString)))
    (TcNoString)))

(define (tc-dotted-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (tc-dotted-type-name-lookup-key-from-id ctx name (tc-name-id name)))

;; Variant taking the already-interned `name-id`; reads the first-dot position
;; from id-keyed metadata instead of re-hashing `name`.
(define (tc-dotted-type-name-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      (OkTcString name)
      (match (tc-source-dotted-alias-key ctx name name-id first-dot)
        [(TcSomeString key) (OkTcString key)]
        [(TcNoString)
          (match (tc-source-dotted-full-path-key ctx name)
            [(TcSomeString key) (OkTcString key)]
            [(TcNoString)
              (ErrTcString (tc-unresolved-dotted-name-message name))])]))))

(define (tc-source-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ErrTcString (tc-source-slash-qualified-message name))
      (tc-dotted-type-name-lookup-key-from-id ctx name name-id))))

(define (tc-enum-qualified-variant-lookup-name? [name : String]) : bool
  (>= (tc-name-first-dot (tc-qualified-name-base name)) 0))

(define (tc-enum-qualified-variant-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (if (tc-enum-qualified-variant-lookup-name? name)
    (match ctx
      [(TcContext _ _ registries module _)
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? name)))
          (let
            [module-key : String (compiler-symbol-module-key module name)]
            (match (compiler-registries-lookup-variant registries module-key)
              [(SomeI64 _) (OkTcString module-key)]
              [(NoneI64)
                (match (compiler-registries-lookup-variant registries name)
                  [(SomeI64 _) (OkTcString name)]
                  [(NoneI64) (ErrTcString "")])]))
          (match (compiler-registries-lookup-variant registries name)
            [(SomeI64 _) (OkTcString name)]
            [(NoneI64) (ErrTcString "")]))])
    (ErrTcString "")))

(define (tc-source-name-lookup-key-with-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [check-local-field : bool]) : ResultTcString
  ;; Intern `name` once; every metadata query below reads the id-keyed slots
  ;; instead of re-hashing the string. This is the hottest name-resolution
  ;; function, previously hashing each name 3-4x (slash-qualified?, first-dot,
  ;; leading-segment, bound-exact?).
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ErrTcString (tc-source-slash-qualified-message name))
      (let
        [first-dot : i64 (intern-first-dot name-id)]
        (if (< first-dot 0)
          (if (tc-source-name-bound-exact-id? env name-id)
            (OkTcString name)
            (match (tc-current-module-source-lookup-key ctx env name)
              [(TcSomeString key) (OkTcString key)]
              [(TcNoString) (OkTcString name)]))
          (if (and
            check-local-field
            (tc-source-leading-segment-wins-over-exact-from-id?
              env
              name
              name-id
              first-dot))
            (OkTcString name)
            (match (tc-comptime-helper-qualified-lookup-key env name first-dot)
              [(TcSomeString key) (OkTcString key)]
              [(TcNoString)
                (match (tc-source-dotted-alias-key ctx name name-id first-dot)
                  [(TcSomeString key) (OkTcString key)]
                  [(TcNoString)
                    (match (tc-source-dotted-full-path-key ctx name)
                      [(TcSomeString key) (OkTcString key)]
                      [(TcNoString)
                        (if (tc-source-name-bound-exact-id? env name-id)
                          (OkTcString name)
                          (match (tc-enum-qualified-variant-lookup-key ctx name)
                            [(OkTcString key) (OkTcString key)]
                            [(ErrTcString _)
                              (ErrTcString
                                (tc-unresolved-dotted-name-message name))]))])])])))))))

(define (tc-source-name-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name true))

(define (tc-source-name-lookup-key-after-local-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name false))

(define (tc-qualified-access-target-module
  [ctx : TcContext]
  [qualifier : String]) : String
  (match ctx
    [(TcContext program _ _ current-module _)
      (match program
        [(AstProgram decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (macro-resolve-qualified-module decls current-module qualifier))])]))

(define (tc-resolved-nominal-type [name : String] [handle : i64]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (AstTyEnum (intern name))
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (AstTyStruct (intern name))
      (AstTyVar (intern name)))))

(define (tc-resolved-nominal-type-with-args
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (ast-ty-enum-args (intern name) lifetimes)
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (ast-ty-struct-args (intern name) lifetimes)
      (ast-ty-var-args (intern name) lifetimes))))

(define (tc-current-module-owner-name-matches?
  [lookup-name : String]
  [owner-name : String]) : bool
  (or
    (string.string-eq owner-name lookup-name)
    (and
      (tc-name-qualified? lookup-name)
      (not (tc-name-qualified? owner-name))
      (string.string-eq owner-name (tc-qualified-name-base lookup-name)))))

(define (tc-current-module-enum? [ctx : TcContext] [name : String]) : bool
  (match (tc-program-enum-variants (tc-context-program ctx) name)
    [(OkAstVariantDefList _) true]
    [(ErrAstVariantDefList _) false]))

(define (tc-resolved-current-module-nominal-type
  [ctx : TcContext]
  [name : String]
  [handle : i64]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(OkTcString owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type name handle)
        (if (tc-current-module-enum? ctx name)
          (AstTyEnum (intern name))
          (tc-resolved-nominal-type owner-name handle)))]
    [(ErrTcString _)
      (if (tc-current-module-enum? ctx name)
        (AstTyEnum (intern name))
        (tc-resolved-nominal-type name handle))]))

(define (tc-resolved-current-module-nominal-type-with-args
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(OkTcString owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type-with-args name handle lifetimes)
        (if (tc-current-module-enum? ctx name)
          (ast-ty-enum-args (intern name) lifetimes)
          (tc-resolved-nominal-type-with-args owner-name handle lifetimes)))]
    [(ErrTcString _)
      (if (tc-current-module-enum? ctx name)
        (ast-ty-enum-args (intern name) lifetimes)
        (tc-resolved-nominal-type-with-args name handle lifetimes))]))

(define (tc-qualified-lookup-owner-name
  [lookup-name : String]
  [owner-name : String]) : String
  (if (and
    (or (tc-name-qualified? lookup-name) (>= (tc-name-first-dot lookup-name) 0))
    (not (tc-name-qualified? owner-name)))
    lookup-name
    owner-name))

(define tc-nominal-owner-cache-handle : i64
  0)
(define tc-nominal-owner-cache-name : String
  "")
(define tc-nominal-owner-cache-handle1 : i64
  0)
(define tc-nominal-owner-cache-name1 : String
  "")
(define tc-nominal-owner-cache-handle2 : i64
  0)
(define tc-nominal-owner-cache-name2 : String
  "")
(define tc-nominal-owner-cache-handle3 : i64
  0)
(define tc-nominal-owner-cache-name3 : String
  "")
(define tc-nominal-owner-cache-handle4 : i64
  0)
(define tc-nominal-owner-cache-name4 : String
  "")
(define tc-nominal-owner-cache-handle5 : i64
  0)
(define tc-nominal-owner-cache-name5 : String
  "")
(define tc-nominal-owner-cache-handle6 : i64
  0)
(define tc-nominal-owner-cache-name6 : String
  "")
(define tc-nominal-owner-cache-handle7 : i64
  0)
(define tc-nominal-owner-cache-name7 : String
  "")
(define tc-resolve-type-name-cache-valid : bool
  false)
(define tc-resolve-type-name-cache-found : bool
  false)
(define tc-resolve-type-name-cache-key : String
  "")
(define tc-resolve-type-name-cache-handle : i64
  0)

;; The cached name strings are caller-provided and may live in a transient
;; scratch arena (per-function typecheck arenas; #2596): clear them to the
;; static empty string as well, so no slot can compare against freed memory
;; after the owning arena is destroyed.
(define (tc-nominal-owner-cache-reset!) : unit
  (begin
    (set! tc-nominal-owner-cache-handle 0)
    (set! tc-nominal-owner-cache-name "")
    (set! tc-nominal-owner-cache-handle1 0)
    (set! tc-nominal-owner-cache-name1 "")
    (set! tc-nominal-owner-cache-handle2 0)
    (set! tc-nominal-owner-cache-name2 "")
    (set! tc-nominal-owner-cache-handle3 0)
    (set! tc-nominal-owner-cache-name3 "")
    (set! tc-nominal-owner-cache-handle4 0)
    (set! tc-nominal-owner-cache-name4 "")
    (set! tc-nominal-owner-cache-handle5 0)
    (set! tc-nominal-owner-cache-name5 "")
    (set! tc-nominal-owner-cache-handle6 0)
    (set! tc-nominal-owner-cache-name6 "")
    (set! tc-nominal-owner-cache-handle7 0)
    (set! tc-nominal-owner-cache-name7 "")
    (set! tc-resolve-type-name-cache-valid false)
    (set! tc-resolve-type-name-cache-key "")))

(define (tc-resolve-type-name-cache-lookup [lookup-name : String]) : TcTypeNameLookupCache
  (if (and
    tc-resolve-type-name-cache-valid
    (string.string-eq tc-resolve-type-name-cache-key lookup-name))
    (if tc-resolve-type-name-cache-found
      (TcTypeNameLookupCacheFound tc-resolve-type-name-cache-handle)
      (TcTypeNameLookupCacheMissing))
    (TcTypeNameLookupCacheMiss)))

(define (tc-resolve-type-name-cache-store!
  [lookup-name : String]
  [found : bool]
  [handle : i64]) : unit
  (begin
    (set! tc-resolve-type-name-cache-key (intern-persistent-copy lookup-name))
    (set! tc-resolve-type-name-cache-found found)
    (set! tc-resolve-type-name-cache-handle handle)
    (set! tc-resolve-type-name-cache-valid true)))

(define (tc-resolve-type-name-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : MaybeI64
  (match (tc-resolve-type-name-cache-lookup lookup-name)
    [(TcTypeNameLookupCacheFound handle) (SomeI64 handle)]
    [(TcTypeNameLookupCacheMissing) NoneI64]
    [(TcTypeNameLookupCacheMiss)
      (match (compiler-symbols-lookup-type symbols lookup-name)
        [(SomeI64 handle)
          (begin
            (tc-resolve-type-name-cache-store! lookup-name true handle)
            (SomeI64 handle))]
        [(NoneI64)
          (begin
            (tc-resolve-type-name-cache-store! lookup-name false 0)
            NoneI64)])]))

(define (tc-nominal-owner-cache-slot [handle : i64]) : i64
  (% (compiler-symbol-handle-index handle) 8))

(define (tc-nominal-owner-cache-entry-lookup
  [ctx : TcContext]
  [handle : i64]
  [cached-handle : i64]
  [cached-name : String]) : ResultTcString
  (if (= cached-handle handle)
    (match (tc-resolve-type-name-symbol-lookup
      (tc-context-symbols ctx)
      cached-name)
      [(SomeI64 cached-handle)
        (if (= cached-handle handle)
          (OkTcString cached-name)
          (ErrTcString ""))]
      [(NoneI64) (ErrTcString "")])
    (ErrTcString "")))

(define (tc-nominal-owner-cache-lookup [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [slot : i64 (tc-nominal-owner-cache-slot handle)]
    (cond
      [(= slot 0)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle
          tc-nominal-owner-cache-name)]
      [(= slot 1)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle1
          tc-nominal-owner-cache-name1)]
      [(= slot 2)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle2
          tc-nominal-owner-cache-name2)]
      [(= slot 3)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle3
          tc-nominal-owner-cache-name3)]
      [(= slot 4)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle4
          tc-nominal-owner-cache-name4)]
      [(= slot 5)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle5
          tc-nominal-owner-cache-name5)]
      [(= slot 6)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle6
          tc-nominal-owner-cache-name6)]
      [else
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle7
          tc-nominal-owner-cache-name7)])))

(define (tc-nominal-owner-cache-store-if-safe! [handle : i64] [name : String]) : unit
  (if (tc-name-qualified? name)
    unit
    (let
      [slot : i64 (tc-nominal-owner-cache-slot handle)]
      (cond
        [(= slot 0)
          (begin
            (set! tc-nominal-owner-cache-handle handle)
            (set! tc-nominal-owner-cache-name name))]
        [(= slot 1)
          (begin
            (set! tc-nominal-owner-cache-handle1 handle)
            (set! tc-nominal-owner-cache-name1 name))]
        [(= slot 2)
          (begin
            (set! tc-nominal-owner-cache-handle2 handle)
            (set! tc-nominal-owner-cache-name2 name))]
        [(= slot 3)
          (begin
            (set! tc-nominal-owner-cache-handle3 handle)
            (set! tc-nominal-owner-cache-name3 name))]
        [(= slot 4)
          (begin
            (set! tc-nominal-owner-cache-handle4 handle)
            (set! tc-nominal-owner-cache-name4 name))]
        [(= slot 5)
          (begin
            (set! tc-nominal-owner-cache-handle5 handle)
            (set! tc-nominal-owner-cache-name5 name))]
        [(= slot 6)
          (begin
            (set! tc-nominal-owner-cache-handle6 handle)
            (set! tc-nominal-owner-cache-name6 name))]
        [else
          (begin
            (set! tc-nominal-owner-cache-handle7 handle)
            (set! tc-nominal-owner-cache-name7 name))]))))

(define (tc-nominal-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match decls
    [(AstDeclNil) (ErrTcString "typecheck: nominal owner not found")]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclImport _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclIncludeStr _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclIncludeBin _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclModule next-module)
            (tc-nominal-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDeclTest _ _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclDefEnum name _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefEnumLifetimes name _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefStruct name _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefStructLifetimes name _ _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDeclDefEnum name _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefEnumLifetimes name _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefStruct name _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefStructLifetimes name _ _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]
          [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]))

(define (tc-nominal-owner-name-scan
  [program : AstProgram]
  [handle : i64]
  [index : i64]) : ResultTcString
  (match program
    [(AstProgram decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (match (tc-nominal-owner-name-list decls index 0 "")
          [(OkTcString name)
            (begin
              (tc-nominal-owner-cache-store-if-safe! handle name)
              (OkTcString name))]
          [(ErrTcString message) (ErrTcString message)]))]))

(define (tc-nominal-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (tc-nominal-owner-cache-lookup ctx handle)
    [(OkTcString cached) (OkTcString cached)]
    [(ErrTcString _)
      (match ctx
        [(TcContext program symbols _ _ _)
          (match (compiler-symbols-owner-name-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(CompilerSomeString name)
              (begin
                (tc-nominal-owner-cache-store-if-safe! handle name)
                (OkTcString name))]
            [(CompilerNoString)
              (tc-nominal-owner-name-scan
                program
                handle
                (compiler-symbol-handle-index handle))])])]))

(define (tc-nominal-owner-name-at-index [ctx : TcContext] [index : i64]) : ResultTcString
  (match (compiler-symbols-owner-name-at-index (tc-context-symbols ctx) index)
    [(CompilerSomeString name) (OkTcString name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(AstProgram decls-box)
          (tc-nominal-owner-name-list (box-get decls-box) index 0 "")])]))

(define (tc-context-with-owner-name-module
  [ctx : TcContext]
  [owner-name : String]) : TcContext
  (if (tc-name-qualified? owner-name)
    (tc-context-with-module ctx (tc-qualified-name-module owner-name))
    (tc-context-with-module ctx "")))

(define (tc-context-with-nominal-owner-index-module
  [ctx : TcContext]
  [index : i64]) : TcContext
  (match (tc-nominal-owner-name-at-index ctx index)
    [(OkTcString owner-name) (tc-context-with-owner-name-module ctx owner-name)]
    [(ErrTcString _) ctx]))

(define (tc-resolve-type-name [ctx : TcContext] [name : String]) : AstType
  (match ctx
    [(TcContext _ symbols _ module _)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(OkTcString key) key]
            [(ErrTcString _) name])]
        [lookup-name : String
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        (match (tc-resolve-type-name-symbol-lookup symbols lookup-name)
          [(SomeI64 handle)
            (if (and
              (tc-name-qualified? lookup-name)
              (string.string-eq (tc-qualified-name-module lookup-name) module))
              (match (tc-stdlib-comptime-syntax-type lookup-name)
                [(AstSomeType syntax-ty) syntax-ty]
                [(AstNoType)
                  (tc-resolved-current-module-nominal-type
                    ctx
                    lookup-name
                    handle)])
              (match (tc-nominal-owner-name ctx handle)
                [(OkTcString canonical-name)
                  (match (tc-stdlib-comptime-syntax-type canonical-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type
                        (tc-qualified-lookup-owner-name
                          lookup-name
                          canonical-name)
                        handle)])]
                [(ErrTcString _)
                  (match (tc-stdlib-comptime-syntax-type lookup-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType) (tc-resolved-nominal-type lookup-name handle)])]))]
          [(NoneI64)
            (cond
              [(string.string-eq name "Expr") (AstTyExpr)]
              [(string.string-eq name "ExprList") (AstTyExprList)]
              [(string.string-eq name "ExprClause") (tc-macro-expr-clause-type)]
              [(string.string-eq name "ExprClauseList")
                (tc-macro-expr-clause-list-type)]
              [(string.string-eq name "ExprBindingClause")
                (tc-macro-expr-binding-clause-type)]
              [(string.string-eq name "ExprBindingClauseList")
                (tc-macro-expr-binding-clause-list-type)]
              [else (AstTyVar (intern name))])]))]))

(define (tc-resolve-type [ctx : TcContext] [ty : AstType]) : AstType
  (if (tc-type-needs-resolution? ty)
    (match ty
      [(AstTyFunc args ret)
        (ast-ty-func
          (tc-resolve-type-list ctx (box-get args))
          (tc-resolve-type ctx (ty-node-get ret)))]
      [(AstTyTuple elems)
        (ast-ty-tuple (tc-resolve-type-list ctx (box-get elems)))]
      [(AstTyArray elem len)
        (ast-ty-array (tc-resolve-type ctx (ty-node-get elem)) len)]
      [(AstTyDynArray elem)
        (ast-ty-dyn-array (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyBox elem) (ast-ty-box (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyPtr elem) (ast-ty-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyMutPtr elem)
        (ast-ty-mut-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyRef region inner)
        (ast-ty-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyMutRef region inner)
        (ast-ty-mut-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyRegion region inner)
        (ast-ty-region region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyVarArgs name lifetimes)
        (tc-resolve-type-name-with-args
          ctx
          (intern-str name)
          (box-get lifetimes))]
      [(AstTyVar name) (tc-resolve-type-name ctx (intern-str name))]
      [_ ty])
    ty))

(define (tc-resolve-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : AstType
  (match ctx
    [(TcContext _ symbols _ module _)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(OkTcString key) key]
            [(ErrTcString _) name])]
        [lookup-name : String
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        (match (tc-resolve-type-name-symbol-lookup symbols lookup-name)
          [(SomeI64 handle)
            (if (and
              (tc-name-qualified? lookup-name)
              (string.string-eq (tc-qualified-name-module lookup-name) module))
              (match (tc-stdlib-comptime-syntax-type lookup-name)
                [(AstSomeType syntax-ty) syntax-ty]
                [(AstNoType)
                  (tc-resolved-current-module-nominal-type-with-args
                    ctx
                    lookup-name
                    handle
                    lifetimes)])
              (match (tc-nominal-owner-name ctx handle)
                [(OkTcString canonical-name)
                  (match (tc-stdlib-comptime-syntax-type canonical-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type-with-args
                        (tc-qualified-lookup-owner-name
                          lookup-name
                          canonical-name)
                        handle
                        lifetimes)])]
                [(ErrTcString _)
                  (match (tc-stdlib-comptime-syntax-type lookup-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type-with-args
                        lookup-name
                        handle
                        lifetimes)])]))]
          [(NoneI64) (ast-ty-var-args (intern name) lifetimes)]))]))

(define (tc-source-str-value-policy-message) : String
  "typecheck: str is a borrowed string-slice referent; use (& lifetime str)")

(define (tc-source-str-mut-ref-policy-message) : String
  "typecheck: mutable references to str are reserved; use immutable (& lifetime str)")

(define (tc-source-bytes-value-policy-message) : String
  "typecheck: bytes is a borrowed byte-slice referent; use (& lifetime bytes) or (&mut lifetime bytes)")

(define (tc-source-type-policy-message [name : String]) : String
  (cond
    [(string.string-eq name "varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string.string-eq name "Varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string.string-eq name "Vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string.string-eq name "vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string.string-eq name "Mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [(string.string-eq name "mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [else
      (string.string-append
        "typecheck: unknown type "
        (string.string-append
          name
          "; TypeLisp has no source-level type parameters; use comptime-generated concrete declarations instead (#893/#913/#970/#902)"))]))

(define (tc-nominal-lifetimes-from-decl [decl : AstDecl]) : ResultTcLifetimeList
  (match decl
    [(AstDeclDefEnum _ _ _) (OkTcLifetimeList AstLifetimeNil)]
    [(AstDeclDefEnumLifetimes _ lifetimes _ _) (OkTcLifetimeList lifetimes)]
    [(AstDeclDefStruct _ _ _ _) (OkTcLifetimeList AstLifetimeNil)]
    [(AstDeclDefStructLifetimes _ lifetimes _ _ _) (OkTcLifetimeList lifetimes)]
    [_ (ErrTcLifetimeList "typecheck: nominal type not found")]))

(define (tc-nominal-lifetimes [ctx : TcContext] [name : String]) : ResultTcLifetimeList
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-symbols-lookup-type symbols name)
        [(SomeI64 handle)
          (match (compiler-symbols-decl-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(OkAstDecl decl) (tc-nominal-lifetimes-from-decl decl)]
            [(ErrAstDecl message) (ErrTcLifetimeList message)])]
        [(NoneI64) (ErrTcLifetimeList "typecheck: nominal type not found")])]))

(define (tc-nominal-lifetime-use-policy-ok
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(OkTcLifetimeList params)
      (if (= (tc-lifetime-list-count params) (tc-lifetime-list-count lifetimes))
        OkTcUnit
        (ErrTcUnit "typecheck: nominal lifetime argument arity mismatch"))]
    [(ErrTcLifetimeList message) (ErrTcUnit message)]))

(define (tc-bare-nominal-lifetime-policy-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(OkTcLifetimeList params)
      (match params
        [(AstLifetimeNil) OkTcUnit]
        [_ (ErrTcUnit "typecheck: missing nominal lifetime arguments")])]
    [(ErrTcLifetimeList message) (ErrTcUnit message)]))

(define (tc-source-type-list-policy-ok [ctx : TcContext] [types : AstTypeList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (match (tc-source-type-policy-ok ctx head)
          [(OkTcUnit) (tc-source-type-list-policy-ok ctx tail)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-type-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-type-unquote-marker? ty)
    OkTcUnit
    (let
      [syntax-ok : ResultTcUnit
        (match ty
          [(AstTyVar name)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(OkTcString _) OkTcUnit]
              [(ErrTcString message) (ErrTcUnit message)])]
          [(AstTyVarArgs name _)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(OkTcString _) OkTcUnit]
              [(ErrTcString message) (ErrTcUnit message)])]
          [_ OkTcUnit])]
      (match syntax-ok
        [(ErrTcUnit message) (ErrTcUnit message)]
        [(OkTcUnit)
          (match (tc-resolve-type ctx ty)
            [(AstTyFunc args ret)
              (match (tc-source-type-list-policy-ok ctx (box-get args))
                [(OkTcUnit) (tc-source-type-policy-ok ctx (ty-node-get ret))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyTuple elems)
              (tc-source-type-list-policy-ok ctx (box-get elems))]
            [(AstTyArray elem _)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyDynArray elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyBox elem) (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyPtr elem) (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyMutPtr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyRef _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstTyStr) OkTcUnit]
                [(AstTyBytes) OkTcUnit]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstTyMutRef _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstTyStr) (ErrTcUnit (tc-source-str-mut-ref-policy-message))]
                [(AstTyBytes) OkTcUnit]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstTyRegion _ inner)
              (tc-source-type-policy-ok ctx (ty-node-get inner))]
            [(AstTyStr) (ErrTcUnit (tc-source-str-value-policy-message))]
            [(AstTyBytes) (ErrTcUnit (tc-source-bytes-value-policy-message))]
            [(AstTyEnum name)
              (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
            [(AstTyStruct name)
              (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
            [(AstTyEnumArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok
                ctx
                (intern-str name)
                (box-get lifetimes))]
            [(AstTyStructArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok
                ctx
                (intern-str name)
                (box-get lifetimes))]
            [(AstTyVarArgs name _)
              (ErrTcUnit (tc-source-type-policy-message (intern-str name)))]
            [(AstTyVar name)
              (if (or
                (= name (intern "ExprClause"))
                (= name (intern "ExprClauseList"))
                (= name (intern "ExprBindingClause"))
                (= name (intern "ExprBindingClauseList")))
                OkTcUnit
                (ErrTcUnit (tc-source-type-policy-message (intern-str name))))]
            [_ OkTcUnit])]))))

(define (tc-source-maybe-type-policy-ok
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]) : ResultTcUnit
  (match maybe-ty
    [(AstNoType) OkTcUnit]
    [(AstSomeType ty) (tc-source-type-policy-ok ctx ty)]))

(define (tc-source-param-list-policy-ok
  [ctx : TcContext]
  [params : AstParamList]) : ResultTcUnit
  (match params
    [(AstParamNil) OkTcUnit]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit) (tc-source-param-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-macro-param-list-policy-ok
  [ctx : TcContext]
  [params : AstMacroParamList]) : ResultTcUnit
  (match params
    [(AstMacroParamNil) OkTcUnit]
    [(AstMacroParamCons param rest)
      (let
        [rest : AstMacroParamList (box-get rest)]
        (match param
          [(AstMacroParam _ ty variadic)
            (if (tc-macro-type-param-kind? ty)
              (if variadic
                (ErrTcUnit "typecheck: type macro operand cannot be variadic")
                (tc-source-macro-param-list-policy-ok ctx rest))
              (if (tc-macro-module-param-kind? ty)
                (if variadic
                  (ErrTcUnit
                    "typecheck: Module macro operand cannot be variadic")
                  (tc-source-macro-param-list-policy-ok ctx rest))
                (match (tc-source-type-policy-ok ctx ty)
                  [(OkTcUnit) (tc-source-macro-param-list-policy-ok ctx rest)]
                  [(ErrTcUnit message) (ErrTcUnit message)])))]))]))

(define (tc-macro-result-name? [ty : AstType] [upper : String] [lower : String]) : bool
  (match ty
    [(AstTyVar name) (or (= name (intern upper)) (= name (intern lower)))]
    [_ false]))

(define (tc-macro-result-module? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Module" "module"))

(define (tc-macro-result-decls? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Decls" "decls"))

(define (tc-macro-result-decl-emitting? [ty : AstType]) : bool
  (or (tc-macro-result-module? ty) (tc-macro-result-decls? ty)))

(define (tc-source-macro-result-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-macro-result-decl-emitting? ty)
    OkTcUnit
    (tc-source-type-policy-ok ctx ty)))

(define (tc-source-field-list-policy-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit) (tc-source-field-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-struct-cleanup-repr-c-message [struct-name : String]) : String
  (str_cat.str-cat
    "typecheck: cleanup-owning struct "
    struct-name
    " cannot use repr c"))

(define (tc-source-variant-list-policy-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ fields _)
            (match (tc-source-type-list-policy-ok ctx fields)
              [(OkTcUnit) (tc-source-variant-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-decl-lifetime-name-allowed?
  [params : AstLifetimeList]
  [name : String]) : bool
  (or (string.string-eq name "program") (tc-lifetime-list-contains params name)))

(define (tc-decl-lifetime-string-list-all-in?
  [lifetimes : TcStringList]
  [params : AstLifetimeList]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-decl-lifetime-name-allowed? params lifetime)
        (tc-decl-lifetime-string-list-all-in? (box-get rest) params))]))

(define (tc-source-type-decl-lifetimes-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))]
    (if (tc-decl-lifetime-string-list-all-in? lifetimes params)
      OkTcUnit
      (ErrTcUnit "typecheck: unknown aggregate lifetime parameter"))))

(define (tc-source-field-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : AstFieldDefList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit)
                (match (tc-source-type-decl-lifetimes-ok ctx params ty)
                  [(OkTcUnit)
                    (tc-source-field-list-lifetimes-policy-ok ctx params rest)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-type-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : AstTypeList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (match (tc-source-type-policy-ok ctx head)
          [(OkTcUnit)
            (match (tc-source-type-decl-lifetimes-ok ctx params head)
              [(OkTcUnit)
                (tc-source-type-list-lifetimes-policy-ok ctx params tail)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-variant-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ fields _)
            (match (tc-source-type-list-lifetimes-policy-ok ctx params fields)
              [(OkTcUnit)
                (tc-source-variant-list-lifetimes-policy-ok ctx params rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-default-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name : String]) : ResultTcUnit
  (tc-inline-aggregate-layout-finite-ok
    ctx
    (compiler-symbol-module-key (tc-context-module ctx) name)))

(define (tc-source-default-struct-layout-finite-ok
  [ctx : TcContext]
  [name : String]
  [repr : AstStructRepr]) : ResultTcUnit
  (if (ast-struct-repr-c? repr)
    OkTcUnit
    (tc-source-default-aggregate-layout-finite-ok ctx name)))

(define (tc-source-pattern-list-policy-ok
  [ctx : TcContext]
  [patterns : AstPatternList]) : ResultTcUnit
  (match patterns
    [(AstPatternNil) OkTcUnit]
    [(AstPatternCons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (match (tc-source-pattern-policy-ok ctx pattern)
          [(OkTcUnit) (tc-source-pattern-list-policy-ok ctx rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-pattern-policy-ok [ctx : TcContext] [pattern : AstPattern]) : ResultTcUnit
  (match pattern
    [(AstPatVar _ maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstPatTuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [(AstPatVariant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [_ OkTcUnit]))

(define (tc-source-match-arm-list-policy-ok
  [ctx : TcContext]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-source-pattern-policy-ok ctx pattern)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx body)
                    [(OkTcUnit) (tc-source-match-arm-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-let-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx init)
                    [(OkTcUnit) (tc-source-let-binding-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-resource-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (match bindings
    [(AstResourceBindingNil) OkTcUnit]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-source-expr-policy-ok ctx init)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx cleanup)
                    [(OkTcUnit)
                      (tc-source-resource-binding-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-expr-list-policy-ok [ctx : TcContext] [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-source-expr-policy-ok ctx expr)
          [(OkTcUnit) (tc-source-expr-list-policy-ok ctx rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-expr-pair-policy-ok
  [ctx : TcContext]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-policy-ok ctx left)
    [(OkTcUnit) (tc-source-expr-policy-ok ctx right)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-expr-triple-policy-ok
  [ctx : TcContext]
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-pair-policy-ok ctx first second)
    [(OkTcUnit) (tc-source-expr-policy-ok ctx third)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-spmd-broadcast-scope-message) : String
  "typecheck: spmd-broadcast is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-shuffle-scope-message) : String
  "typecheck: spmd-shuffle is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-lane-scope-message [name : String]) : String
  (string.string-append
    (string.string-append "typecheck: " name)
    " is only valid inside a foreach body or spmd-reduce value expression"))

(define (tc-source-expr-list-spmd-broadcast-scope-ok
  [exprs : AstExprList]
  [allow : bool]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-source-expr-spmd-broadcast-scope-ok expr allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok rest allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-expr-pair-spmd-broadcast-scope-ok
  [left : AstExpr]
  [right : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-spmd-broadcast-scope-ok left allow)
    [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok right allow)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-expr-triple-spmd-broadcast-scope-ok
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-pair-spmd-broadcast-scope-ok first second allow)
    [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok third allow)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok
  [bindings : AstLetBindingList]
  [allow : bool]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-source-expr-spmd-broadcast-scope-ok init allow)
                [(OkTcUnit)
                  (tc-source-let-binding-list-spmd-broadcast-scope-ok
                    rest
                    allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok
  [bindings : AstResourceBindingList]
  [allow : bool]) : ResultTcUnit
  (match bindings
    [(AstResourceBindingNil) OkTcUnit]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-source-expr-pair-spmd-broadcast-scope-ok
                init
                cleanup
                allow)
                [(OkTcUnit)
                  (tc-source-resource-binding-list-spmd-broadcast-scope-ok
                    rest
                    allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok
  [arms : AstMatchArmList]
  [allow : bool]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm _ body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-source-expr-spmd-broadcast-scope-ok body allow)
                [(OkTcUnit)
                  (tc-source-match-arm-list-spmd-broadcast-scope-ok rest allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-expr-spmd-broadcast-scope-ok [expr : AstExpr] [allow : bool]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok left right allow))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok func allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprIf cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          cond
          then-branch
          else-branch
          allow))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-spmd-broadcast-scope-ok
              bindings
              allow)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok body allow)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-source-expr-spmd-broadcast-scope-ok body false))])]
    [(AstExprTuple exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-spmd-broadcast-scope-ok tuple allow))]
    [(AstExprArray exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-spmd-broadcast-scope-ok len allow))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array index allow))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok array index value allow))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array value allow))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok str index allow))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok cond body allow))]
    [(AstExprBegin exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprUnsafe exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprSet _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-spmd-broadcast-scope-ok place allow))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-spmd-broadcast-scope-ok scrutinee allow)
              [(OkTcUnit)
                (tc-source-match-arm-list-spmd-broadcast-scope-ok arms allow)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-pair-spmd-broadcast-scope-ok start end false)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok body true)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok value true)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(OkTcUnit)
                (match (tc-source-expr-spmd-broadcast-scope-ok value false)
                  [(OkTcUnit)
                    (tc-source-expr-spmd-broadcast-scope-ok body true)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ErrTcUnit (tc-spmd-broadcast-scope-message)))]
    [(AstExprSpmdShuffle value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ErrTcUnit (tc-spmd-shuffle-scope-message)))]
    [(AstExprSpmdProgramIndex)
      (if allow
        OkTcUnit
        (ErrTcUnit (tc-spmd-lane-scope-message "program-index")))]
    [(AstExprSpmdProgramCount)
      (if allow
        OkTcUnit
        (ErrTcUnit (tc-spmd-lane-scope-message "program-count")))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-spmd-broadcast-scope-ok receiver allow))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok receiver value allow))]
    [(AstExprWithRegion _ body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok scratch allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithScratch body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok arena allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (tc-source-resource-binding-list-spmd-broadcast-scope-ok
            bindings
            allow)
            [(OkTcUnit)
              (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok inner value allow))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprQuote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBracketClause items)
      (tc-source-expr-list-spmd-broadcast-scope-ok items allow)]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrAddrOf inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr value allow))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr offset allow))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
