  (TcSpmdInlineCallState TcSpmdEnv TcTypeEnv TcSpmdEnv TcSpmdClass))

(defenum ResultTcSpmdInlineCallState
  (Ok TcSpmdInlineCallState)
  (Err String))

(defenum TcStructDecl
  (TcStructDecl AstStructRepr AstStructCleanup AstFieldDefList))

(defenum ResultTcStructDecl
  (Ok TcStructDecl)
  (Err String))

(defenum TcEnumDecl
  (TcEnumDecl AstEnumCleanup AstVariantDefList))

(defenum ResultTcEnumDecl
  (Ok TcEnumDecl)
  (Err String))

(defenum TcLayoutInfo
  (TcLayoutInfo i64 i64))

(defenum ResultTcLayoutInfo
  (Ok TcLayoutInfo)
  (Err String))

(defenum TcReprCFieldLayout
  (Field String AstType i64))

(defenum TcReprCFieldLayoutList
  (Nil)
  (Cons TcReprCFieldLayout (Box TcReprCFieldLayoutList)))

(defenum TcReprCLayout
  (Layout i64 i64 TcReprCFieldLayoutList))

(defenum ResultTcReprCLayout
  (Ok TcReprCLayout)
  (Err String))

(defenum TcInlineFieldLayout
  (Field i64 AstType i64))

(defenum TcInlineFieldLayoutList
  (Nil)
  (Cons TcInlineFieldLayout (Box TcInlineFieldLayoutList)))

(defenum TcInlinePayloadLayout
  (Payload i64 AstType i64))

(defenum TcInlinePayloadLayoutList
  (Nil)
  (Cons TcInlinePayloadLayout (Box TcInlinePayloadLayoutList)))

(defenum TcInlineVariantLayout
  (Variant i64 i64 i64 TcInlinePayloadLayoutList))

(defenum TcInlineVariantLayoutList
  (Nil)
  (Cons TcInlineVariantLayout (Box TcInlineVariantLayoutList)))

(defenum TcInlineFieldsLayout
  (Fields i64 i64 TcInlineFieldLayoutList))

(defenum ResultTcInlineFieldsLayout
  (Ok TcInlineFieldsLayout)
  (Err String))

(defenum TcInlinePayloadFieldsLayout
  (Fields i64 i64 TcInlinePayloadLayoutList))

(defenum ResultTcInlinePayloadFieldsLayout
  (Ok TcInlinePayloadFieldsLayout)
  (Err String))

(defenum TcInlineAggregateLayout
  (Struct i64 i64 TcInlineFieldLayoutList)
  (Enum i64 i64 TcInlineVariantLayoutList))

(defenum ResultTcInlineAggregateLayout
  (Ok TcInlineAggregateLayout)
  (Err String))

;; Aggregate layouts outlive transient typecheck/lowering scratch regions.
;; Keep their owned list tails in a cache-owned arena and retain its newest
;; segment after every allocation. A fixed node-pool arena handle becomes stale
;; as soon as that segment fills, causing every later box to reserve a sibling
;; segment that no owner can advance to.
(define tc-agg-layout-cache-storage-arena : i64
  0)

(define (tc-agg-layout-cache-storage-handle) : i64
  (begin
    (if (= tc-agg-layout-cache-storage-arena 0)
      (set! tc-agg-layout-cache-storage-arena (arena.tl_arena_make))
      unit)
    tc-agg-layout-cache-storage-arena))

(define (tc-agg-layout-cache-storage-reset!) : unit
  (let
    [storage : i64 tc-agg-layout-cache-storage-arena]
    (begin
      (set! tc-agg-layout-cache-storage-arena 0)
      (if (= storage 0)
        unit
        (unsafe
          (arena.tl_arena_destroy storage))))))

(define (tc-agg-layout-cache-storage-restore! [previous : i64] [storage : i64]) : unit
  (let
    [head : i64 (arena.tl_arena_current)]
    (begin
      (set! tc-agg-layout-cache-storage-arena head)
      (unsafe
        (arena.tl_arena_set
          (if (= previous storage)
            head
            previous))))))

;; Layout list tails escape the current lowering/optimizer scratch arena through
;; the aggregate-layout cache. Allocate each tail directly in its retained arena
;; so storing a completed layout is a shallow value copy rather than a second
;; recursive clone of the entire layout.
(define (tc-inline-field-layout-list-persistent-box
  [value : TcInlineFieldLayoutList]) : (Box TcInlineFieldLayoutList)
  (let
    [previous : i64 (arena.tl_arena_current)]
    [storage : i64 (tc-agg-layout-cache-storage-handle)]
    (begin
      (unsafe
        (arena.tl_arena_set storage))
      (let
        [out : (Box TcInlineFieldLayoutList) (box value)]
        (begin
          (tc-agg-layout-cache-storage-restore! previous storage)
          out)))))

(define (tc-inline-payload-layout-list-persistent-box
  [value : TcInlinePayloadLayoutList]) : (Box TcInlinePayloadLayoutList)
  (let
    [previous : i64 (arena.tl_arena_current)]
    [storage : i64 (tc-agg-layout-cache-storage-handle)]
    (begin
      (unsafe
        (arena.tl_arena_set storage))
      (let
        [out : (Box TcInlinePayloadLayoutList) (box value)]
        (begin
          (tc-agg-layout-cache-storage-restore! previous storage)
          out)))))

(define (tc-inline-variant-layout-list-persistent-box
  [value : TcInlineVariantLayoutList]) : (Box TcInlineVariantLayoutList)
  (let
    [previous : i64 (arena.tl_arena_current)]
    [storage : i64 (tc-agg-layout-cache-storage-handle)]
    (begin
      (unsafe
        (arena.tl_arena_set storage))
      (let
        [out : (Box TcInlineVariantLayoutList) (box value)]
        (begin
          (tc-agg-layout-cache-storage-restore! previous storage)
          out)))))

(defenum CompilerTypecheckSummary
  (CompilerTypecheckSummary i64 i64 i64))

(defenum ResultCompilerTypecheck
  (Ok CompilerTypecheckSummary)
  (Err (Box CompilerDiagnostic)))

(defenum ResultCompilerTypecheckChecked
  (Ok CompilerTypecheckSummary TcContext TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum TcPrefixSnapshotLookup
  (Miss)
  (Hit i64 String i64 CompilerTypecheckSummary))

(defenum TcPrefixSnapshotSlot
  (Empty)
  (Full String i64 String i64 CompilerTypecheckSummary))

(defenum TcPrefixCandidate
  (No)
  (Some String i64 String i64))

(define tc-prefix-snapshot-cache-capacity : i64
  64)
(define tc-prefix-snapshot-cache : (Array TcPrefixSnapshotSlot)
  (array.make-array TcPrefixSnapshotSlot 64))
(define tc-prefix-snapshot-cache-arena : i64
  0)
(define tc-prefix-snapshot-cache-enabled : bool
  false)
(define tc-prefix-snapshot-cache-ready : bool
  false)
(define tc-prefix-snapshot-cache-hit-count : i64
  0)
(define tc-prefix-snapshot-cache-miss-count : i64
  0)
(define tc-prefix-snapshot-cache-store-count : i64
  0)

(define (tc-prefix-snapshot-cache-fill! [index : i64]) : unit
  (if (>= index tc-prefix-snapshot-cache-capacity)
    unit
    (begin
      (array-set! tc-prefix-snapshot-cache index (TcPrefixSnapshotSlot.Empty))
      (tc-prefix-snapshot-cache-fill! (+ index 1)))))

(define (tc-prefix-snapshot-cache-stats-reset!) : unit
  (begin
    (set! tc-prefix-snapshot-cache-hit-count 0)
    (set! tc-prefix-snapshot-cache-miss-count 0)
    (set! tc-prefix-snapshot-cache-store-count 0)))

(define (tc-prefix-snapshot-cache-arena-handle) : i64
  (begin
    (if (= tc-prefix-snapshot-cache-arena 0)
      (set! tc-prefix-snapshot-cache-arena (arena.tl_arena_make))
      unit)
    tc-prefix-snapshot-cache-arena))

(define (tc-prefix-snapshot-cache-arena-reset!) : unit
  (if (= tc-prefix-snapshot-cache-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-prefix-snapshot-cache-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-prefix-snapshot-cache-arena))
      (set! tc-prefix-snapshot-cache-arena 0))))

(define (tc-prefix-snapshot-cache-clear!) : unit
  (begin
    (tc-prefix-snapshot-cache-fill! 0)
    (tc-prefix-snapshot-cache-arena-reset!)
    (set! tc-prefix-snapshot-cache-ready true)
    (tc-prefix-snapshot-cache-stats-reset!)))

(define (tc-prefix-snapshot-cache-enable!) : unit
  (set! tc-prefix-snapshot-cache-enabled true))

(define (tc-prefix-snapshot-cache-disable!) : unit
  (set! tc-prefix-snapshot-cache-enabled false))

(define (tc-prefix-snapshot-cache-active?) : bool
  (or tc-prefix-snapshot-cache-enabled (compiler-load-session-cache-enabled?)))

(define (tc-prefix-snapshot-cache-ensure!) : unit
  (if tc-prefix-snapshot-cache-ready
    unit
    (tc-prefix-snapshot-cache-clear!)))

(define (tc-prefix-snapshot-cache-note-hit!) : unit
  (set!
    tc-prefix-snapshot-cache-hit-count
    (+ tc-prefix-snapshot-cache-hit-count 1)))

(define (tc-prefix-snapshot-cache-note-miss!) : unit
  (set!
    tc-prefix-snapshot-cache-miss-count
    (+ tc-prefix-snapshot-cache-miss-count 1)))

(define (tc-prefix-snapshot-cache-note-store!) : unit
  (set!
    tc-prefix-snapshot-cache-store-count
    (+ tc-prefix-snapshot-cache-store-count 1)))

(define (tc-prefix-snapshot-cache-lookup-count) : i64
  (+ tc-prefix-snapshot-cache-hit-count tc-prefix-snapshot-cache-miss-count))

(define (tc-prefix-snapshot-cache-hit-rate-per-mille) : i64
  (let
    [lookups : i64 (tc-prefix-snapshot-cache-lookup-count)]
    (if (= lookups 0)
      0
      (/ (* tc-prefix-snapshot-cache-hit-count 1000) lookups))))

(define (tc-prefix-snapshot-cache-stats-line [label : String]) : String
  (str_cat.str-cat
    "typecheck-prefix-cache|"
    label
    "|hits="
    (string.int->string tc-prefix-snapshot-cache-hit-count)
    "|misses="
    (string.int->string tc-prefix-snapshot-cache-miss-count)
    "|stores="
    (string.int->string tc-prefix-snapshot-cache-store-count)
    "|lookups="
    (string.int->string (tc-prefix-snapshot-cache-lookup-count))
    "|hit-rate-per-mille="
    (string.int->string (tc-prefix-snapshot-cache-hit-rate-per-mille))))

(define (tc-prefix-snapshot-cache-print-stats [label : String]) : unit
  (io.print-error
    (string.append (tc-prefix-snapshot-cache-stats-line label) "\n")))

(define (tc-prefix-snapshot-cache-lookup-from [key : String] [index : i64]) : TcPrefixSnapshotLookup
  (if (>= index tc-prefix-snapshot-cache-capacity)
    (TcPrefixSnapshotLookup.Miss)
    (match (array-ref tc-prefix-snapshot-cache index)
      [(TcPrefixSnapshotSlot.Empty) (TcPrefixSnapshotLookup.Miss)]
      [(TcPrefixSnapshotSlot.Full slot-key count module module-id summary)
        (if (string.eq slot-key key)
          (TcPrefixSnapshotLookup.Hit count module module-id summary)
          (tc-prefix-snapshot-cache-lookup-from key (+ index 1)))])))

(define (tc-prefix-snapshot-cache-lookup [key : String]) : TcPrefixSnapshotLookup
  (begin
    (tc-prefix-snapshot-cache-ensure!)
    (tc-prefix-snapshot-cache-lookup-from key 0)))

(define (tc-prefix-snapshot-cache-store-at
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]
  [index : i64]) : bool
  (if (>= index tc-prefix-snapshot-cache-capacity)
    false
    (match (array-ref tc-prefix-snapshot-cache index)
      [(TcPrefixSnapshotSlot.Empty)
        (begin
          (array-set!
            tc-prefix-snapshot-cache
            index
            (TcPrefixSnapshotSlot.Full key count module module-id summary))
          (tc-prefix-snapshot-cache-note-store!)
          true)]
      [(TcPrefixSnapshotSlot.Full slot-key _ _ _ _)
        (if (string.eq slot-key key)
          (begin
            (array-set!
              tc-prefix-snapshot-cache
              index
              (TcPrefixSnapshotSlot.Full key count module module-id summary))
            (tc-prefix-snapshot-cache-note-store!)
            true)
          (tc-prefix-snapshot-cache-store-at
            key
            count
            module
            module-id
            summary
            (+ index 1)))])))

(define (tc-prefix-snapshot-cache-store
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : bool
  (begin
    (tc-prefix-snapshot-cache-ensure!)
    (tc-prefix-snapshot-cache-store-at key count module module-id summary 0)))

(define (tc-prefix-snapshot-cache-store-persistent
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : bool
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    (begin
      (tc-prefix-snapshot-cache-ensure!)
      (unsafe
        (arena.tl_arena_set (tc-prefix-snapshot-cache-arena-handle)))
      (let
        [persistent-key : String (string.copy (& key))]
        [persistent-module : String (string.copy (& module))]
        [stored : bool
          (tc-prefix-snapshot-cache-store
            persistent-key
            count
            persistent-module
            module-id
            summary)]
        [cache-head : i64 (arena.tl_arena_current)]
        (begin
          (set! tc-prefix-snapshot-cache-arena cache-head)
          (unsafe
            (arena.tl_arena_set prev-arena))
          stored)))))

(define (tc-context-with-module-id
  [ctx : TcContext]
  [module : String]
  [module-id : i64]) : TcContext
  (match ctx
    [(TcContext program symbols registries _ _ pools source-names)
      (TcContext program symbols registries module module-id pools source-names)]))

(define (tc-context-with-program [ctx : TcContext] [program : AstProgram]) : TcContext
  (match ctx
    [(TcContext _ symbols registries module module-id pools source-names)
      (TcContext program symbols registries module module-id pools source-names)]))

(define (tc-context-module [ctx : TcContext]) : String
  (match ctx
    [(TcContext _ _ _ module _ _ _) module]))

(define (tc-context-module-id [ctx : TcContext]) : i64
  (match ctx
    [(TcContext _ _ _ _ module-id _ _) module-id]))

(define (tc-context-pools [ctx : TcContext]) : AstNodePoolContext
  (match ctx
    [(TcContext _ _ _ _ _ pools _) pools]))

(define (tc-context-source-names [ctx : TcContext]) : ci.InternSourceNameSessionHandle
  (match ctx
    [(TcContext _ _ _ _ _ _ source-names) source-names]))

(define (tc-context-capture-active-pools! [ctx : TcContext]) : unit
  (if (ast-node-pool-compat-context-active?)
    unit
    (ast-node-pool-context-capture-active! (tc-context-pools ctx))))

(define (tc-context-install-pools! [ctx : TcContext]) : unit
  (if (ast-node-pool-compat-context-active?)
    unit
    (ast-node-pool-context-install! (tc-context-pools ctx))))

(define (tc-install-pools! [pools : AstNodePoolContext]) : unit
  (if (ast-node-pool-compat-context-active?)
    unit
    (ast-node-pool-context-install! pools)))

(define (tc-context-type-get [ctx : TcContext] [id : i64]) : AstType
  (ast-node-pool-context-type-get (tc-context-pools ctx) id))

(define (tc-context-expr-get [ctx : TcContext] [id : i64]) : AstExpr
  (ast-node-pool-context-expr-get (tc-context-pools ctx) id))

;; The typechecker receives an already-loaded program and so does not know the
;; source path; it builds diagnostics with an empty path (the CLI driver stamps
;; the real path before rendering). Synthetic/internal errors fall back to 1:1.
(define (tc-canonical-diagnostic [diag : CompilerDiagnostic]) : CompilerDiagnostic
  (compiler-diagnostic-with-category
    (compiler-diagnostic-with-code diag (compiler-diagnostic-code-typecheck))
    "typecheck"))

(define (tc-diag-at-start [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic (compiler-diagnostic-at-start "" message)))

(define (tc-located-error-prefix) : String
  "__tl_tc_loc|")

(define (tc-rich-error-prefix) : String
  "__tl_tc_diag|")

(define (tc-diag-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (tc-located-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-located-error-prefix)))

(define (tc-rich-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-rich-error-prefix)))

(define (tc-rich-error-span-fields [span : AstSourceSpan]) : String
  (str_cat.str-cat
    (string.int->string (ast-source-span-start-line span))
    "|"
    (string.int->string (ast-source-span-start-col span))
    "|"
    (string.int->string (ast-source-span-end-line span))
    "|"
    (string.int->string (ast-source-span-end-col span))
    "|"))

(define (tc-rich-error-one-secondary
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [secondary : AstSourceSpan]
  [secondary-label : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|1|"
    (tc-rich-error-span-fields secondary)
    secondary-label))

(define (tc-rich-error-two-secondaries
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [first : AstSourceSpan]
  [first-label : String]
  [second : AstSourceSpan]
  [second-label : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|2|"
    (tc-rich-error-span-fields first)
    first-label
    "|"
    (tc-rich-error-span-fields second)
    second-label))

(define (tc-located-error-field-end [text : String] [start : i64]) : i64
  (let
    [i : i64 start]
    [n : i64 (string.string-length text)]
    [done : bool false]
    (begin
      (while (and (< i n) (not done))
        (if (= (cast (string.string-ref text i) : i64) 124)
          (set! done true)
          (set! i (+ i 1))))
      i)))

(define (tc-located-error-field [text : String] [start : i64] [end : i64]) : String
  (string.substring text start (- end start)))

(define (tc-rich-error-diag [message : String]) : CompilerDiagnostic
  (let
    [prefix-len : i64 (string.string-length (tc-rich-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [msg-start : i64 (+ end-col-end 1)]
    [msg-end : i64 (tc-located-error-field-end message msg-start)]
    [help-start : i64 (+ msg-end 1)]
    [help-end : i64 (tc-located-error-field-end message help-start)]
    [count-start : i64 (+ help-end 1)]
    [count-end : i64 (tc-located-error-field-end message count-start)]
    [clean-message : String (tc-located-error-field message msg-start msg-end)]
    [help : String (tc-located-error-field message help-start help-end)]
    [remaining : i64
      (string.>int (tc-located-error-field message count-start count-end))]
    [idx : i64 (+ count-end 1)]
    [diag : CompilerDiagnostic
      (compiler-diagnostic-from-ast-span
        ""
        (ast-source-span
          (string.>int (tc-located-error-field message prefix-len line-end))
          (string.>int (tc-located-error-field message col-start col-end))
          (string.>int
            (tc-located-error-field message end-line-start end-line-end))
          (string.>int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message)]
    (begin
      (if (> (string.string-length help) 0)
        (set! diag (compiler-diagnostic-with-help diag help))
        unit)
      (while (> remaining 0)
        (let
          [sec-line-end : i64 (tc-located-error-field-end message idx)]
          [sec-col-start : i64 (+ sec-line-end 1)]
          [sec-col-end : i64 (tc-located-error-field-end message sec-col-start)]
          [sec-end-line-start : i64 (+ sec-col-end 1)]
          [sec-end-line-end : i64
            (tc-located-error-field-end message sec-end-line-start)]
          [sec-end-col-start : i64 (+ sec-end-line-end 1)]
          [sec-end-col-end : i64
            (tc-located-error-field-end message sec-end-col-start)]
          [label-start : i64 (+ sec-end-col-end 1)]
          [label-end : i64
            (if (= remaining 1)
              (string.string-length message)
              (tc-located-error-field-end message label-start))]
          [label : String
            (tc-located-error-field message label-start label-end)]
          (begin
            (set!
              diag
              (compiler-diagnostic-with-secondary
                diag
                (CompilerDiagnosticSpan
                  ""
                  (string.>int
                    (tc-located-error-field message idx sec-line-end))
                  (string.>int
                    (tc-located-error-field message sec-col-start sec-col-end))
                  (string.>int
                    (tc-located-error-field
                      message
                      sec-end-line-start
                      sec-end-line-end))
                  (string.>int
                    (tc-located-error-field
                      message
                      sec-end-col-start
                      sec-end-col-end)))
                (CompilerDiagnosticSomeString label)))
            (set! idx (+ label-end 1))
            (set! remaining (- remaining 1)))))
      (tc-canonical-diagnostic diag))))

(define (tc-located-error [span : AstSourceSpan] [message : String]) : String
  (str_cat.str-cat
    (tc-located-error-prefix)
    (string.int->string (ast-source-span-start-line span))
    "|"
    (string.int->string (ast-source-span-start-col span))
    "|"
    (string.int->string (ast-source-span-end-line span))
    "|"
    (string.int->string (ast-source-span-end-col span))
    "|"
    message))

(define (tc-located-error-diag [message : String]) : CompilerDiagnostic
  (let
    [prefix-len : i64 (string.string-length (tc-located-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [clean-start : i64 (+ end-col-end 1)]
    [clean-message : String
      (string.substring
        message
        clean-start
        (- (string.string-length message) clean-start))]
    (tc-canonical-diagnostic
      (compiler-diagnostic-from-ast-span
        ""
        (ast-source-span
          (string.>int (tc-located-error-field message prefix-len line-end))
          (string.>int (tc-located-error-field message col-start col-end))
          (string.>int
            (tc-located-error-field message end-line-start end-line-end))
          (string.>int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message))))

(define (tc-ty-node-pool-exhausted-diagnostic) : CompilerDiagnostic
  (tc-diag-at-start (ty-node-pool-exhausted-message)))

(define (tc-typecheck-result-with-pool-check [result : ResultCompilerTypecheck]) : ResultCompilerTypecheck
  (begin
    (tc-fn-scratch-arena-release!)
    (tc-decl-scratch-arena-release!)
    (if (ty-node-pool-exhausted?)
      (ResultCompilerTypecheck.Err (box (tc-ty-node-pool-exhausted-diagnostic)))
      result)))

(define (tc-typecheck-checked-result-with-pool-check
  [result : ResultCompilerTypecheckChecked]) : ResultCompilerTypecheckChecked
  (begin
    (tc-fn-scratch-arena-release!)
    (tc-decl-scratch-arena-release!)
    (if (ty-node-pool-exhausted?)
      (ResultCompilerTypecheckChecked.Err
        (box (tc-ty-node-pool-exhausted-diagnostic)))
      result)))

(cfg
  compile-profile
  (define compiler-tc-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-live : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-tc-profile-start) : unit
    (begin
      (set! compiler-tc-profile-start-ms (profile.now-ms))
      (set! compiler-tc-profile-start-total (profile.alloc-total))
      (set! compiler-tc-profile-start-live (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-tc-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64 (- (profile.alloc-peak) compiler-tc-profile-start-live)]
      (io.print-error
        (string.append
          "compile-profile|typecheck."
          (string.append
            phase
            (string.append
              (compiler-tc-profile-field
                (- end-ms compiler-tc-profile-start-ms))
              (string.append
                (compiler-tc-profile-field
                  (- end-total compiler-tc-profile-start-total))
                (string.append
                  (compiler-tc-profile-field
                    (- end-live compiler-tc-profile-start-live))
                  (string.append (compiler-tc-profile-field peak-delta) "\n"))))))))))

(cfg
  compile-profile
  (define compiler-tc-macro-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-profile-entries : CompilerTcMacroProfileEntries
    (CompilerTcMacroProfileEntries.Nil)))
(cfg
  compile-profile
  (define compiler-tc-macro-profile-active : bool
    false))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-reset) : unit
    (begin
      (set! compiler-tc-macro-profile-start-ms 0)
      (set! compiler-tc-macro-profile-active true)
      (set!
        compiler-tc-macro-profile-entries
        (CompilerTcMacroProfileEntries.Nil)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-clear) : unit
    (begin
      (set! compiler-tc-macro-profile-active false)
      (set!
        compiler-tc-macro-profile-entries
        (CompilerTcMacroProfileEntries.Nil)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-start) : unit
    (set! compiler-tc-macro-profile-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-arg-count [args : AstExprList]) : i64
    (struct-get (& args) len)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-in
    [entries : CompilerTcMacroProfileEntries]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : CompilerTcMacroProfileEntries
    (match entries
      [(CompilerTcMacroProfileEntries.Nil)
        (CompilerTcMacroProfileEntries.Cons
          macro-name
          arity
          1
          elapsed-ms
          (box (CompilerTcMacroProfileEntries.Nil)))]
      [(CompilerTcMacroProfileEntries.Cons
          entry-name
          entry-arity
          calls
          total-ms
          rest)
        (if (and (string.eq entry-name macro-name) (= entry-arity arity))
          (CompilerTcMacroProfileEntries.Cons
            entry-name
            entry-arity
            (+ calls 1)
            (+ total-ms elapsed-ms)
            rest)
          (CompilerTcMacroProfileEntries.Cons
            entry-name
            entry-arity
            calls
            total-ms
            (box
              (compiler-tc-macro-profile-record-in
                (box-get rest)
                macro-name
                arity
                elapsed-ms))))])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (if compiler-tc-macro-profile-active
      (set!
        compiler-tc-macro-profile-entries
        (compiler-tc-macro-profile-record-in
          compiler-tc-macro-profile-entries
          macro-name
          arity
          elapsed-ms))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-finish
    [macro-name : String]
    [args : AstExprList]) : unit
    (compiler-tc-macro-profile-record
      macro-name
      (compiler-tc-macro-profile-arg-count args)
      (- (profile.now-ms) compiler-tc-macro-profile-start-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-finish-arity
    [macro-name : String]
    [arity : i64]) : unit
    (compiler-tc-macro-profile-record
      macro-name
      arity
      (- (profile.now-ms) compiler-tc-macro-profile-start-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-detail
    [macro-name : String]
    [arity : i64]
    [calls : i64]) : String
    (string.append
      macro-name
      (string.append
        " arity="
        (string.append
          (string.int->string arity)
          (string.append " calls=" (string.int->string calls)))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entry
    [macro-name : String]
    [arity : i64]
    [calls : i64]
    [total-ms : i64]) : unit
    (cfg
      compile-profile-summary
      unit
      (io.print-error
        (string.append
          "compile-profile-detail|typecheck.macro_expand|"
          (string.append
            (string.int->string total-ms)
            (string.append
              "|"
              (string.append
                (compiler-tc-macro-profile-detail macro-name arity calls)
                "\n"))))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entries
    [entries : CompilerTcMacroProfileEntries]) : unit
    (match entries
      [(CompilerTcMacroProfileEntries.Nil) unit]
      [(CompilerTcMacroProfileEntries.Cons macro-name arity calls total-ms rest)
        (begin
          (compiler-tc-macro-profile-emit-entry macro-name arity calls total-ms)
          (compiler-tc-macro-profile-emit-entries (box-get rest)))])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit) : unit
    (begin
      (compiler-tc-macro-profile-emit-entries compiler-tc-macro-profile-entries)
      (set! compiler-tc-macro-profile-active false))))

(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-site-count : i64
    18))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-calls : (Array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-ms : (Array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-alloc : (Array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-live : (Array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-body-fact-profile-hits : (Array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-body-fact-profile-misses : (Array i64)
    (array.make-array i64 18)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-site-index [site : String]) : i64
    (cond
      [(string.eq site "move.call_func") 0]
      [(string.eq site "move.call_arg") 1]
      [(string.eq site "move.let_init") 2]
      [(string.eq site "move.resource_init") 3]
      [(string.eq site "move.match_scrutinee") 4]
      [(string.eq site "move.tuple_list") 5]
      [(string.eq site "move.array_list") 6]
      [(string.eq site "move.bind_init") 7]
      [(string.eq site "borrow.call_func") 8]
      [(string.eq site "borrow.call_arg") 9]
      [(string.eq site "borrow.let_init") 10]
      [(string.eq site "borrow.resource_init") 11]
      [(string.eq site "borrow.match_scrutinee") 12]
      [(string.eq site "borrow.tuple_list") 13]
      [(string.eq site "borrow.array_list") 14]
      [(string.eq site "borrow.bind_init") 15]
      [(string.eq site "borrow.return_arg") 16]
      [(string.eq site "borrow.return_call") 17]
      [else -1])))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-site-name [index : i64]) : String
    (cond
      [(= index 0) "move.call_func"]
      [(= index 1) "move.call_arg"]
      [(= index 2) "move.let_init"]
      [(= index 3) "move.resource_init"]
      [(= index 4) "move.match_scrutinee"]
      [(= index 5) "move.tuple_list"]
      [(= index 6) "move.array_list"]
      [(= index 7) "move.bind_init"]
      [(= index 8) "borrow.call_func"]
      [(= index 9) "borrow.call_arg"]
      [(= index 10) "borrow.let_init"]
      [(= index 11) "borrow.resource_init"]
      [(= index 12) "borrow.match_scrutinee"]
      [(= index 13) "borrow.tuple_list"]
      [(= index 14) "borrow.array_list"]
      [(= index 15) "borrow.bind_init"]
      [(= index 16) "borrow.return_arg"]
      [(= index 17) "borrow.return_call"]
      [else "unknown"])))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-reset-at [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (array-set! compiler-tc-reinfer-profile-calls index 0)
        (array-set! compiler-tc-reinfer-profile-ms index 0)
        (array-set! compiler-tc-reinfer-profile-alloc index 0)
        (array-set! compiler-tc-reinfer-profile-live index 0)
        (compiler-tc-reinfer-profile-reset-at (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-reset) : unit
    (compiler-tc-reinfer-profile-reset-at 0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-reset-at [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (array-set! compiler-tc-body-fact-profile-hits index 0)
        (array-set! compiler-tc-body-fact-profile-misses index 0)
        (compiler-tc-body-fact-profile-reset-at (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-reset) : unit
    (compiler-tc-body-fact-profile-reset-at 0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-hit [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (array-set!
          compiler-tc-body-fact-profile-hits
          index
          (+ (array.ref compiler-tc-body-fact-profile-hits index) 1))))))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-miss [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (array-set!
          compiler-tc-body-fact-profile-misses
          index
          (+ (array.ref compiler-tc-body-fact-profile-misses index) 1))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-record
    [site : String]
    [start-ms : i64]
    [start-total : i64]
    [start-live : i64]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (or (< index 0) (>= index compiler-tc-reinfer-profile-site-count))
        unit
        (begin
          (array-set!
            compiler-tc-reinfer-profile-calls
            index
            (+ (array-ref compiler-tc-reinfer-profile-calls index) 1))
          (array-set!
            compiler-tc-reinfer-profile-ms
            index
            (+
              (array-ref compiler-tc-reinfer-profile-ms index)
              (- (profile.now-ms) start-ms)))
          (array-set!
            compiler-tc-reinfer-profile-alloc
            index
            (+
              (array-ref compiler-tc-reinfer-profile-alloc index)
              (- (profile.alloc-total) start-total)))
          (array-set!
            compiler-tc-reinfer-profile-live
            index
            (+
              (array-ref compiler-tc-reinfer-profile-live index)
              (- (profile.alloc-live) start-live))))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-expr
    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [expr : AstExpr]) : ResultTcType
    (let
      [start-ms : i64 (profile.now-ms)]
      [start-total : i64 (profile.alloc-total)]
      [start-live : i64 (profile.alloc-live)]
      [result : ResultTcType (tc-expr ctx env expr)]
      (begin
        (compiler-tc-reinfer-profile-record
          site
          start-ms
          start-total
          start-live)
        result))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-expr-id
    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [expr-id : i64]) : ResultTcType
    (let
      [start-ms : i64 (profile.now-ms)]
      [start-total : i64 (profile.alloc-total)]
      [start-live : i64 (profile.alloc-live)]
      [result : ResultTcType (tc-expr-id ctx env expr-id)]
      (begin
        (compiler-tc-reinfer-profile-record
          site
          start-ms
          start-total
          start-live)
        result))))

(cfg
  compile-profile
