    (ptr-read
      (int->ptr
        (cast (tc-type-env-scoped-state-field ,state ,address-field i64) : u64)
        : (Ptr ,_T)))))

(defmacro (tc-type-env-scoped-cache-write!
  [state : Expr]
  [address-field : Expr]
