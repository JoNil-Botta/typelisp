              env
              locals
              loop-carried
              moved1
              value-box)
              [(TcMoveResult.Ok moved2)
                (match (tc-move-after-bind-id
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  value-box)
                  [(TcMoveResult.Ok moved3) (TcMoveResult.Ok moved3)]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.TypeLiteral _) (TcMoveResult.Ok moved)]
    [(AstExpr.Init _) (TcMoveResult.Ok moved)]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (begin
          ;; Compile-time code cannot cause a runtime early exit in the
          ;; containing function; mirror lower's existing RVO scanner.
          (tc-body-early-exit-suppress-push!)
          (let
            [result : TcMoveResult
              (tc-move-check-expr ctx env locals loop-carried moved inner)]
            (begin
              (tc-body-early-exit-suppress-pop!)
              result))))]
    [(AstExpr.Quote _) (TcMoveResult.Ok moved)]
    [(AstExpr.Quasiquote _) (TcMoveResult.Ok moved)]
    [(AstExpr.Unquote _) (TcMoveResult.Ok moved)]
    [(AstExpr.UnquoteSplicing _) (TcMoveResult.Ok moved)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (begin
          (tc-body-early-exit-note!)
          (tc-move-check-expr ctx env locals loop-carried moved inner)))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (begin
          (tc-body-early-exit-note!)
          (match (tc-move-check-expr ctx env locals loop-carried moved inner)
            [(TcMoveResult.Ok moved1)
              (match (tc-current-return-type env)
                [(ResultTcType.Ok return-ty)
                  (tc-move-after-consuming-value
                    ctx
                    env
                    locals
                    loop-carried
                    moved1
                    inner
                    return-ty)]
                [(ResultTcType.Err _) (TcMoveResult.Ok moved1)])]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])))]
    [(AstExpr.Break)
      (begin
        (tc-body-early-exit-note!)
        (TcMoveResult.Ok moved))]
    [(AstExpr.Continue)
      (begin
        (tc-body-early-exit-note!)
        (TcMoveResult.Ok moved))]
    [(AstExpr.PtrNull _) (TcMoveResult.Ok moved)]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-move-check-ptr-addr-of-place
          ctx
          env
          locals
          loop-carried
          moved
          place
          expr))]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 value)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 offset)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.PtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.IntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 len)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.BinaryData _) (TcMoveResult.Ok moved)]
    [(AstExpr.SpmdProgramIndex) (TcMoveResult.Ok moved)]
    [(AstExpr.SpmdProgramCount) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramArgc) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramArgv) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramEnvp) (TcMoveResult.Ok moved)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-move-check-expr ctx env locals loop-carried moved index))]
    [(AstExpr.Syscall args)
      (tc-move-check-exprs ctx env locals loop-carried moved args)]))

(define (tc-move-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-move-check-expr
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(TcMoveResult.Ok _) ResultTcUnit.Ok]
    [(TcMoveResult.Err message) (ResultTcUnit.Err message)]))

(define (tc-move-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-move-check-expr-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(TcMoveResult.Ok _) ResultTcUnit.Ok]
    [(TcMoveResult.Err message) (ResultTcUnit.Err message)]))

;; --- lexical borrow conflict checker ---------------------------------------
;;
;; Borrows are lexical in this model: `begin` keeps borrows live, while
;; `let`, `with-arena`, resource `with`, lambdas, and individual match arms
;; bound their own borrow additions. Move and borrow facts share structural paths,
;; so whole roots, fields, tuple elements, and fixed-array literal elements use
;; the same ancestor/descendant conflict policy. Mutable borrows add shared and
;; exclusive facts for one path, allowing many immutable borrows but only one
;; exclusive mutable borrow.
(defenum TcBorrowCheckResult
  (Ok TcMovedSet)
  (Err String))

(defenum TcBorrowCheckBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowCheckResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowConflictOrigin
  (No)
  (Some i64))

(define (tc-borrow-check-move-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot move borrowed place `" path)
    "`"))

(define (tc-borrow-check-assign-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot assign to borrowed place `" path)
    "`"))

(define (tc-borrow-check-mutably-borrow-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot mutably borrow borrowed place `" path)
    "`"))

(define (tc-borrow-check-immutably-borrow-message [path : String]) : String
  (string.append
    (string.append
      "typecheck: cannot immutably borrow mutably borrowed place `"
      path)
    "`"))

(define (tc-borrow-check-read-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot read mutably borrowed place `" path)
    "`"))

(define (tc-borrow-check-help) : String
  "let the last reference use occur before this operation, shorten the borrow with a narrower lexical scope, clone the owner before borrowing when ownership must move later, or use an immutable borrow for non-mutating access")

(define (tc-borrow-check-origin-label [path : String]) : String
  (str_cat.str-cat
    "borrow of `"
    path
    "` remains live because a later reference use may still depend on it"))

(define (tc-borrow-check-conflict-origin
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcBorrowConflictOrigin
  (match (tc-moved-path-conflict-kind borrowed path kind)
    [(TcMoveConflict.Some _ origin-id) (TcBorrowConflictOrigin.Some origin-id)]
    [TcMoveConflict.No TcBorrowConflictOrigin.No]))

(define (tc-borrow-check-rich-conflict-message
  [borrowed : TcMovedSet]
  [conflict-path : TcMovePath]
  [conflict-kind : TcMovedPathKind]
  [primary : AstExpr]
  [message : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcMaybeAstSourceSpan.Some primary-span)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(TcMaybeAstSourceSpan.No)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                primary-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))])]
        [(TcBorrowConflictOrigin.No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-borrow-check-help)
            primary-span
            (tc-borrow-check-origin-label (tc-move-path-render conflict-path)))])]
    [(TcMaybeAstSourceSpan.No)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                origin-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(TcMaybeAstSourceSpan.No) message])]
        [(TcBorrowConflictOrigin.No) message])]))

;; Lending borrows retain the ordinary place path for conflict checks and add
;; a non-conflicting marker that identifies the result binding for NLL pruning.
(define (tc-borrow-check-lending-binding-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (match facts
    [(TcMovedPathFacts.Nil) (TcMaybeNameId.No)]
    [(TcMovedPathFacts.Cons fact rest)
      (if (tc-move-path-eq? (struct-get fact path) path)
        (match (struct-get fact kind)
          [(TcMovedPathKind.BorrowLending binding-id)
            (TcMaybeNameId.Some binding-id)]
          [_ (tc-borrow-check-lending-binding-at (box-get rest) path)])
        (tc-borrow-check-lending-binding-at (box-get rest) path))]))

(define (tc-borrow-check-lending-binding
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (tc-borrow-check-lending-binding-at facts path))

(define (tc-borrow-check-lending-binding?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : bool
  (match (tc-borrow-check-lending-binding facts path)
    [(TcMaybeNameId.Some _) true]
    [(TcMaybeNameId.No) false]))

(define (tc-borrow-check-has-lending-binding?
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : bool
  (tc-borrow-check-lending-binding? (tc-moved-paths borrowed) path))

(define (tc-borrow-check-add-lending-marker
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [binding-id : i64]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (TcMovedPathKind.BorrowLending binding-id)
    (ast-node-push origin)))

(define (tc-borrow-check-remove-root-state
  [borrowed : TcMovedSet]
  [name-id : i64]) : TcMovedSet
  (tc-moved-remove-root-state borrowed name-id))

(define (tc-moved-path-facts-remove-lending
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMovedPathFacts
  (match facts
    [(TcMovedPathFacts.Nil) TcMovedPathFacts.Nil]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [tail : TcMovedPathFacts
          (tc-moved-path-facts-remove-lending (box-get rest) path)]
        (if (and
          (tc-move-path-eq? (struct-get fact path) path)
          (match (struct-get fact kind)
            [(TcMovedPathKind.BorrowLending _) true]
            [_ false]))
          tail
          (TcMovedPathFacts.Cons fact (box tail))))]))

(define (tc-borrow-check-remove-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMovedSet
  (let
    [without-shared : TcMovedSet
      (tc-moved-remove-path-kind borrowed path (TcMovedPathKind.BorrowShared))]
    [without-mut : TcMovedSet
      (tc-moved-remove-path-kind
        without-shared
        path
        (TcMovedPathKind.BorrowMut))]
    [without-two-phase : TcMovedSet
      (tc-moved-remove-path-kind
        without-mut
        path
        (TcMovedPathKind.BorrowTwoPhaseMut))]
    [facts : TcMovedPathFacts
      (tc-moved-path-facts-remove-lending
        (tc-moved-paths without-two-phase)
        path)]
    (TcMovedSet
      (tc-moved-roots without-two-phase)
      (tc-moved-partials without-two-phase)
      facts
      (tc-moved-exact-path-index-from-facts facts)
      (tc-moved-hidden-atomic-users without-two-phase))))

(define (tc-borrow-check-two-phase-mut-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMoveConflict
  (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)))

(define (tc-borrow-check-two-phase-mut-conflict-message
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]
  [message : String]) : String
  (tc-borrow-check-rich-conflict-message
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)
    primary
    message))

(define (tc-borrow-check-path-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [path : TcMovePath]) : i64
  (let
    [root-id : i64 (tc-move-path-root-id path)]
    (match (tc-lookup-visible-id ctx env root-id)
      [(ResultTcType.Ok ty)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          (match (tc-type-strip-region resolved)
            [(AstType.Ref lifetime _) lifetime]
            [(AstType.MutRef lifetime _) lifetime]
            [_
              (match (tc-type-outer-region resolved)
                [(TcMaybeNameId.Some region) region]
                [(TcMaybeNameId.No) root-id])]))]
      [(ResultTcType.Err _) root-id])))

(define (tc-borrow-check-root-in-scope?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [root-id : i64]) : bool
  (or
    (tc-moved-contains? locals root-id)
    (match (tc-lookup-visible-id ctx env root-id)
      [(ResultTcType.Ok _) true]
      [(ResultTcType.Err _) false])))

(define (tc-borrow-check-type-contains-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : i64]) : bool
  (tc-name-id-list-contains
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
    lifetime))

(define (tc-borrow-check-binding-stores-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : i64]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Func _ ret)
      (tc-borrow-check-type-contains-lifetime? ctx (ty-node-get ret) lifetime)]
    [_ (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]))

(define (tc-borrow-check-env-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : i64]
  [seen : TcStringList]) : bool
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) false]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-borrow-check-env-lifetime-used-in-exprs?
        ctx
        rest-env
        exprs
        lifetime
        seen)]
    [(TcTypeEnvSpineStep.Bind name-id ty rest-env)
      (let
        [name : String (tc-env-key-name-text name-id)]
        (if (tc-string-list-contains seen name)
          (tc-borrow-check-env-lifetime-used-in-exprs?
            ctx
            rest-env
            exprs
            lifetime
            seen)
          (if (and
            (tc-borrow-check-binding-stores-lifetime? ctx ty lifetime)
            (tc-expr-list-uses-free-name? exprs name TcStringList.Nil))
            true
            (tc-borrow-check-env-lifetime-used-in-exprs?
              ctx
              rest-env
              exprs
              lifetime
              (tc-string-list-add seen name)))))]))

(define (tc-borrow-check-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : i64]) : bool
  (tc-borrow-check-env-lifetime-used-in-exprs?
    ctx
    env
    exprs
    lifetime
    TcStringList.Nil))

;; A lexical child scope can return a reference whose source borrow was created
;; inside that scope. Retain the source path at the enclosing scope when its
;; lifetime appears in the result, while dropping child-local state and NLL
;; markers. This preserves the actual source projection instead of collapsing
;; it to the lifetime root.
(define (tc-borrow-check-result-expr-list-path
  [locals : TcMovedSet]
  [exprs : AstExprList]) : TcMaybeMovePath
  (if (ast-expr-list-empty? (& exprs))
    (TcMaybeMovePath.No)
    (tc-borrow-check-result-direct-borrow-path
      locals
      (ast-node-get
        (ast-expr-list-get (& exprs) (- (struct-get (& exprs) len) 1) 0)))))

;; Recover a direct place borrow from the value position of an expression.
;; Indirect call/aggregate results deliberately return No so their existing
;; lifetime-based propagation remains conservative.
(define (tc-borrow-check-result-direct-borrow-path
  [locals : TcMovedSet]
  [expr : AstExpr]) : TcMaybeMovePath
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-result-direct-borrow-path
        locals
        (ast-node-get inner-box))]
    [(AstExpr.Borrow _ _ place-box)
      (match (tc-borrow-check-place-path (ast-node-get place-box))
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No) (TcMaybeMovePath.No)])]
    [(AstExpr.Begin exprs) (tc-borrow-check-result-expr-list-path locals exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-result-expr-list-path locals exprs)]
    [(AstExpr.Ann inner-box _)
      (tc-borrow-check-result-direct-borrow-path
        locals
        (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (tc-borrow-check-result-direct-borrow-path
        locals
        (ast-node-get inner-box))]
    [(AstExpr.Comptime inner-box)
      (tc-borrow-check-result-direct-borrow-path
        locals
        (ast-node-get inner-box))]
    [(AstExpr.Try inner-box)
      (tc-borrow-check-result-direct-borrow-path
        locals
        (ast-node-get inner-box))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-borrow-check-propagate-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [facts : TcMovedPathFacts]
  [result-lifetimes : TcNameIdList]
  [direct-path : TcMaybeMovePath]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [kind : TcMovedPathKind (struct-get fact kind)]
        [keep-kind : bool
          (match kind
            [(TcMovedPathKind.BorrowShared) true]
            [(TcMovedPathKind.BorrowMut) true]
            [_ false])]
        [keep-direct : bool
          (match direct-path
            [(TcMaybeMovePath.Some direct)
              (tc-move-path-conflicts? path direct)]
            [(TcMaybeMovePath.No) true])]
        [missing : bool
          (match (tc-moved-path-exact-conflict-kind out path kind)
            [(TcMoveConflict.Some _ _) false]
            [TcMoveConflict.No true])]
        [out2 : TcMovedSet
          (if (and
            keep-kind
            (tc-borrow-check-root-in-scope?
              ctx
              env
              outer-locals
              (tc-move-path-root-id path))
            (tc-name-id-list-contains
              result-lifetimes
              (tc-borrow-check-path-lifetime ctx env path))
            keep-direct
            missing)
            (tc-moved-add-path-fact
              out
              path
              kind
              (tc-moved-path-fact-origin fact))
            out)]
        (tc-borrow-check-propagate-return-borrows-at
          ctx
          env
          outer-locals
          (box-get rest)
          result-lifetimes
          direct-path
          out2))]))

(define (tc-borrow-check-propagate-return-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [outer-borrowed : TcMovedSet]
  [inner-borrowed : TcMovedSet]
  [result-ty : AstType]
  [result-expr : AstExpr]) : TcMovedSet
  ;; The protected outer state cannot be pruned while checking the child.
  ;; Therefore an unchanged entry count proves that the child introduced no
  ;; source borrow to propagate and avoids a result-type walk on ordinary lets.
  (if (<= (tc-moved-len inner-borrowed) (tc-moved-len outer-borrowed))
    outer-borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [TcNameIdList.Nil outer-borrowed]
        [_
          (tc-borrow-check-propagate-return-borrows-at
            ctx
            env
            outer-locals
            (tc-moved-paths inner-borrowed)
            result-lifetimes
            (tc-borrow-check-result-direct-borrow-path outer-locals result-expr)
            (tc-moved-clone outer-borrowed))]))))

(define (tc-borrow-check-mark-new-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [result-lifetimes : TcNameIdList]
  [origin : AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [shared : bool
          (match (struct-get fact kind)
            [(TcMovedPathKind.BorrowShared) true]
            [_ false])]
        [new : bool
          (match (tc-moved-path-exact-conflict-kind
            prior
            path
            (struct-get fact kind))
            [(TcMoveConflict.Some _ _) false]
            [TcMoveConflict.No true])]
        [out2 : TcMovedSet
          (if (and
            shared
            new
            (tc-borrow-check-root-in-scope?
              ctx
              env
              locals
              (tc-move-path-root-id path))
            (tc-name-id-list-contains
              result-lifetimes
              (tc-borrow-check-path-lifetime ctx env path)))
            (tc-borrow-check-add-lending-marker out path binding-id origin)
            out)]
        (tc-borrow-check-mark-new-return-borrows-at
          ctx
          env
          locals
          prior
          (box-get rest)
          binding-id
          result-lifetimes
          origin
          out2))]))

;; A propagated returned borrow needs an NLL marker for the outer result
;; binding. Mark only source paths newly introduced by the initializer; this
;; keeps pre-existing unrelated borrows untouched and removes both shared and
;; mutable source state after the binding's last use.
(define (tc-borrow-check-mark-new-return-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [result-ty : AstType]
  [origin : AstExpr]) : TcMovedSet
  ;; Initializer checking protects the incoming state. Equal entry counts mean
  ;; there is no newly propagated source borrow that needs an NLL marker.
  (if (<= (tc-moved-len borrowed) (tc-moved-len prior))
    borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [TcNameIdList.Nil borrowed]
        [_
          (tc-borrow-check-mark-new-return-borrows-at
            ctx
            env
            locals
            prior
            (tc-moved-paths borrowed)
            binding-id
            result-lifetimes
            origin
            (tc-moved-clone borrowed))]))))

(define (tc-borrow-check-protected-path?
  [protected : TcMovedSet]
  [path : TcMovePath]) : bool
  (or
    (match (tc-moved-path-conflict-kind
      protected
      path
      (TcMovedPathKind.BorrowShared))
      [(TcMoveConflict.Some _ _) true]
      [TcMoveConflict.No false])
    (match (tc-moved-path-conflict-kind
      protected
      path
      (TcMovedPathKind.BorrowMut))
      [(TcMoveConflict.Some _ _) true]
      [TcMoveConflict.No false])))

(define (tc-borrow-check-prune-before-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [protected : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [shared : bool
          (match (struct-get fact kind)
            [(TcMovedPathKind.BorrowShared) true]
            [_ false])]
        [out2 : TcMovedSet
          (if (or
            (not shared)
            (and
              (not (tc-borrow-check-has-lending-binding? out path))
              (tc-borrow-check-protected-path? protected path)))
            out
            (match (tc-borrow-check-lending-binding (tc-moved-paths out) path)
              [(TcMaybeNameId.Some lending-binding-id)
                (if (tc-expr-list-uses-free-name?
                  exprs
                  (tc-env-key-name-text lending-binding-id)
                  TcStringList.Nil)
                  out
                  (tc-borrow-check-remove-borrow-path out path))]
              [(TcMaybeNameId.No)
                (if (tc-borrow-check-lifetime-used-in-exprs?
                  ctx
                  env
                  exprs
                  (tc-borrow-check-path-lifetime ctx env path))
                  out
                  (tc-borrow-check-remove-borrow-path out path))]))]
        (tc-borrow-check-prune-before-exprs-loop
          ctx
          env
          exprs
          protected
          (box-get rest)
          out2))]))

(define (tc-borrow-check-prune-before-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcMovedSet
  (if (or (ast-expr-list-empty? (& exprs)) (= (tc-moved-len borrowed) 0))
    borrowed
    (tc-borrow-check-prune-before-exprs-loop
      ctx
      env
      exprs
      protected
      (tc-moved-paths borrowed)
      borrowed)))

(define (tc-borrow-check-place-path [expr : AstExpr]) : TcMaybeMovePath
  (match (tc-move-root-projection-var-id expr)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-direct-root-base-path expr)
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No)
          (TcMaybeMovePath.Some (TcMovePath root-id TcMovePathSegments.Nil))])]
    [(TcMaybeNameId.No) (TcMaybeMovePath.No)]))

(define (tc-borrow-check-add-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [mutable : bool]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    [borrowed1 : TcMovedSet
      (tc-moved-add-path-fact
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        origin-id)]
    (if mutable
      (tc-moved-add-path-fact
        borrowed1
        path
        (TcMovedPathKind.BorrowMut)
        origin-id)
      borrowed1)))

(define (tc-borrow-check-add-two-phase-mut-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)
    (ast-node-push origin)))

(define (tc-borrow-check-add-two-phase-mut-place
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path place)
    [(TcMaybeMovePath.Some path)
      (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
        [(ResultTcUnit.Ok)
          (TcBorrowCheckResult.Ok
            (tc-borrow-check-add-two-phase-mut-borrow-path borrowed path origin))]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-move-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-move-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-move-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-assign-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-assign-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-assign-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-mutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-immutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowMut))
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false])
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        (TcMovedPathKind.BorrowMut)
        primary
        (tc-borrow-check-immutably-borrow-message (tc-move-path-render path))))
    ResultTcUnit.Ok))

(define (tc-borrow-check-read-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowMut))
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false])
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        (TcMovedPathKind.BorrowMut)
        primary
        (tc-borrow-check-read-message (tc-move-path-render path))))
    ResultTcUnit.Ok))

(define (tc-borrow-check-place-read-conflict
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-borrow-check-place-path expr)
      [(TcMaybeMovePath.Some path)
        (match (tc-borrow-check-read-conflict borrowed path primary)
          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)])))

(define (tc-borrow-check-add-place-with-mutability
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [mutable : bool]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path place)
    [(TcMaybeMovePath.Some path)
      (if mutable
        (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path true origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (match (tc-borrow-check-immutably-borrow-conflict borrowed path origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path false origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)]))]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-place
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr)
    [(TcMaybeMovePath.Some path)
      (match (tc-borrow-check-move-conflict borrowed path expr)
        [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-call-param-consuming-now? ctx target-ty)
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-move-only-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-move-only? (tc-resolve-type ctx target-ty))
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-reading-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-call-param-consuming-now? ctx target-ty)
    (TcBorrowCheckResult.Ok borrowed)
    (tc-borrow-check-place-read-conflict locals borrowed expr expr)))

(define (tc-borrow-check-after-bind-typed
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : AstExpr]
  [init-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx init-ty)
    (tc-borrow-check-after-consuming-place locals borrowed init)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : AstExpr]) : TcBorrowCheckResult
  (match (tc-move-bare-var init)
    [(TcMaybeMoveName.Some name-id name)
      (if (and
        (tc-moved-contains? locals name-id)
        (tc-move-var-move-only-id? env name-id))
        (match (tc-borrow-check-move-conflict
          borrowed
          (TcMovePath name-id TcMovePathSegments.Nil)
          init)
          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(TcMaybeMoveName.No)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "borrow.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(ResultTcType.Ok init-ty)
          (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])]))

(define (tc-borrow-check-after-bind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init-id : i64]) : TcBorrowCheckResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeMoveName.Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? env name-id))
          (match (tc-borrow-check-move-conflict
            borrowed
            (TcMovePath name-id TcMovePathSegments.Nil)
            init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeMoveName.No)
        (match (tc-body-type-fact-expr-id "borrow.bind_init" ctx env init-id)
          [(ResultTcType.Ok init-ty)
            (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)]
          [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])])))

(define (tc-borrow-check-call-constructor? [ctx : TcContext] [func : AstExpr]) : bool
  (let
    [name-id : i64 (tc-expr-var-name-id func)]
    (if (>= name-id 0)
      (tc-constructor-name-id? ctx name-id)
      false)))

(define (tc-borrow-check-lending-result-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.EnumArgs _ _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Tuple elems) (tc-type-list-contains-reference? (box-get elems))]
    [_ false]))

;; The ordinary returned-call effect uses the inferred result type, which can
;; retain a symbolic lifetime for a lending call. At an annotated binding we
;; have the concrete caller lifetime, so attach a result-binding marker to the
;; direct mutable borrow for precise NLL pruning.
(define (tc-borrow-check-first-overlapping-lifetime
  [type-lifetimes : TcNameIdList]
  [result-lifetimes : TcNameIdList]) : TcMaybeNameId
  (match result-lifetimes
    [(TcNameIdList.Nil) TcMaybeNameId.No]
    [(TcNameIdList.Cons lifetime rest)
      (if (tc-name-id-list-contains type-lifetimes lifetime)
        (TcMaybeNameId.Some lifetime)
        (tc-borrow-check-first-overlapping-lifetime
          type-lifetimes
          (box-get rest)))]))

(define (tc-borrow-check-add-bound-returned-call-arg-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [arg : AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (ast-expr-unspan arg)
    [(AstExpr.Borrow true _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (match (tc-borrow-check-place-path place)
          [(TcMaybeMovePath.Some path)
            (let
              [without-temporary
                : TcMovedSet
                ;; A second binding of the same lending borrow must not erase
                ;; the first binding's live marker while discarding its own
                ;; transient call effect. Keeping it makes the ordinary
                ;; mutable-borrow check report the aliasing conflict.
                (if (tc-borrow-check-has-lending-binding? borrowed path)
                  borrowed
                  (tc-borrow-check-remove-borrow-path borrowed path))]
              (match (tc-expr ctx env arg)
                [(ResultTcType.Ok borrow-ty)
                  (match (tc-borrow-check-first-overlapping-lifetime
                    (tc-type-collect-reference-lifetimes
                      (tc-resolve-type ctx borrow-ty))
                    result-lifetimes)
                    [(TcMaybeNameId.Some _)
                      (match (tc-borrow-check-add-place-with-mutability
                        locals
                        without-temporary
                        true
                        place
                        arg)
                        [(TcBorrowCheckResult.Ok borrowed1)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-add-lending-marker
                              borrowed1
                              path
                              binding-id
                              arg))]
                        [(TcBorrowCheckResult.Err message)
                          (TcBorrowCheckResult.Err message)])]
                    [(TcMaybeNameId.No) (TcBorrowCheckResult.Ok borrowed)])]
                [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))]
          [(TcMaybeMovePath.No)
            (tc-borrow-check-add-returned-call-arg-borrow
              ctx
              env
              locals
              borrowed
              arg
              result-lifetimes)]))]
    [(AstExpr.Ann inner-box _)
      (tc-borrow-check-add-bound-returned-call-arg-borrow
        ctx
        env
        locals
        borrowed
        binding-id
        (ast-node-get inner-box)
        result-lifetimes)]
    [(AstExpr.Cast inner-box _)
      (tc-borrow-check-add-bound-returned-call-arg-borrow
        ctx
        env
        locals
        borrowed
        binding-id
        (ast-node-get inner-box)
        result-lifetimes)]
    [_ (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-add-bound-returned-call-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : (& args AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index (struct-get args len))
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-borrow-check-add-bound-returned-call-arg-borrow
      ctx
      env
      locals
      borrowed
      binding-id
      (ast-node-get (ast-expr-list-get args index 0))
      result-lifetimes)
      [(TcBorrowCheckResult.Ok borrowed1)
        (tc-borrow-check-add-bound-returned-call-borrows-at
          ctx
          env
          locals
          borrowed1
          binding-id
          args
          (+ index 1)
          result-lifetimes)]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))

(define (tc-borrow-check-add-bound-returned-call-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (tc-borrow-check-add-bound-returned-call-borrows-at
    ctx
    env
    locals
    borrowed
    binding-id
    (& args)
    0
    result-lifetimes))

(define (tc-borrow-check-after-bind-known-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [init-id : i64]
  [init-ty : AstType]) : TcBorrowCheckResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeMoveName.Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? env name-id))
          (match (tc-borrow-check-move-conflict
            borrowed
            (TcMovePath name-id TcMovePathSegments.Nil)
            init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeMoveName.No)
        (match (ast-expr-unspan init)
          [(AstExpr.Call func-box args)
            (let
              [func : AstExpr (ast-node-get func-box)]
              (if (or
                (tc-borrow-check-call-constructor? ctx func)
                (not (tc-borrow-check-lending-result-type? ctx init-ty)))
                (tc-borrow-check-after-bind-typed
                  ctx
                  locals
                  borrowed
                  init
                  init-ty)
                (match (tc-borrow-check-add-bound-returned-call-borrows
                  ctx
                  env
                  locals
                  borrowed
                  binding-id
                  args
                  (tc-type-collect-reference-lifetimes
                    (tc-resolve-type ctx init-ty)))
                  [(TcBorrowCheckResult.Ok borrowed1)
                    (tc-borrow-check-after-bind-typed
                      ctx
                      locals
                      borrowed1
                      init
                      init-ty)]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])))]
          [_
            (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)])])))

(define (tc-borrow-check-prune-value-temporaries-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [value : AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [kind : TcMovedPathKind (struct-get fact kind)]
        [borrow-kind : bool
          (match kind
            [(TcMovedPathKind.BorrowShared) true]
            [(TcMovedPathKind.BorrowMut) true]
            [(TcMovedPathKind.BorrowTwoPhaseMut) true]
            [_ false])]
        [new : bool
          (not
            (tc-moved-path-facts-contains-exact-kind?
              (tc-moved-paths prior)
              path
              kind))]
        [remove : bool
          (if (and borrow-kind new)
            (let
              [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
              (not
                (or
                  (tc-borrow-check-expr-type-contains-lifetime?
                    ctx
                    env
                    value
                    lifetime)
                  (tc-borrow-check-expr-stores-lifetime? ctx env value lifetime))))
            false)]
        [out2 : TcMovedSet
          (if remove
            (tc-moved-remove-path-kind out path kind)
            out)]
        (tc-borrow-check-prune-value-temporaries-at
          ctx
          env
          prior
          (box-get rest)
          value
          out2))]))

;; Argument auto-borrows created while evaluating an assignment RHS end after
;; that value is produced unless the result or a nested store retains their
;; lifetime. Drop only newly introduced facts so pre-existing live borrows keep
;; protecting the assigned place.
(define (tc-borrow-check-prune-value-temporaries
  [ctx : TcContext]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [value : AstExpr]) : TcMovedSet
  (tc-borrow-check-prune-value-temporaries-at
    ctx
    env
    prior
    (tc-moved-paths borrowed)
    value
    borrowed))

(define (tc-borrow-check-assignment
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [name-id : i64]
  [primary : AstExpr]) : ResultTcUnit
  (tc-borrow-check-assign-conflict
    borrowed
    (TcMovePath name-id TcMovePathSegments.Nil)
    primary))

(define (tc-borrow-check-array-set-conflict
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id array)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-array-set-path array index)
        [(TcMaybeMovePath.Some path)
          (tc-borrow-check-assign-conflict borrowed path primary)]
        [(TcMaybeMovePath.No)
          (tc-borrow-check-assign-conflict
            borrowed
            (TcMovePath root-id TcMovePathSegments.Nil)
            primary)])]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-struct-set-conflict
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [receiver : AstExpr]
  [field-id : i64]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id receiver)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-struct-set-path receiver field-id)
        [(TcMaybeMovePath.Some path)
          (tc-borrow-check-assign-conflict borrowed path primary)]
        [(TcMaybeMovePath.No)
          (tc-borrow-check-assign-conflict
            borrowed
            (TcMovePath root-id TcMovePathSegments.Nil)
            primary)])]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-root-mutation-conflict
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id place)
    [(TcMaybeNameId.Some root-id)
      (tc-borrow-check-assign-conflict
        borrowed
        (TcMovePath root-id TcMovePathSegments.Nil)
        primary)]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-region-invalidation-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [region : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-borrow-check-region-invalidation-scan
          ctx
          rest-env
          locals
          borrowed
          region
          seen
          remaining
          primary)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-region-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              region
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-region-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-region ty region)
            (match (tc-borrow-check-assign-conflict
              borrowed
              (TcMovePath key TcMovePathSegments.Nil)
              primary)
              [(ResultTcUnit.Ok)
                (tc-borrow-check-region-invalidation-scan
                  ctx
                  rest-env
                  locals
                  borrowed
                  region
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  primary)]
              [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
          [else
            (tc-borrow-check-region-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-owner-invalidation-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-borrow-check-owner-invalidation-scan
          ctx
          rest-env
          locals
          borrowed
          owner
          seen
          remaining
          primary)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-owner-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              owner
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-owner-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-arena-owner-region? ty owner)
            (match (tc-borrow-check-assign-conflict
              borrowed
              (TcMovePath key TcMovePathSegments.Nil)
              primary)
              [(ResultTcUnit.Ok)
                (tc-borrow-check-owner-invalidation-scan
                  ctx
                  rest-env
                  locals
                  borrowed
                  owner
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  primary)]
              [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
          [else
            (tc-borrow-check-owner-invalidation-scan
              ctx
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-safe-arena-rewind-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [phase-box : i64 (ast-expr-list-get (& args) 0 0)]
      [phase-expr : AstExpr (ast-node-get phase-box)]
      [pid : i64 (tc-expr-var-name-id phase-expr)]
      (if (>= pid 0)
        (match (tc-borrow-check-assign-conflict
          borrowed
          (TcMovePath pid TcMovePathSegments.Nil)
          primary)
          [(ResultTcUnit.Ok)
            (match (tc-arena-phase-token-region-active env pid)
              [(TcMaybeNameId.Some region)
                (tc-borrow-check-region-invalidation-scan
                  ctx
                  env
                  locals
                  borrowed
                  region
                  TcNameIdList.Nil
                  (tc-moved-len locals)
                  primary)]
              [(TcMaybeNameId.No) (TcBorrowCheckResult.Ok borrowed)])]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (TcBorrowCheckResult.Ok borrowed)))))

(define (tc-borrow-check-safe-arena-destroy-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [owner-box : i64 (ast-expr-list-get (& args) 0 0)]
      [owner-expr : AstExpr (ast-node-get owner-box)]
      [oid : i64 (tc-expr-var-name-id owner-expr)]
      (if (>= oid 0)
        (if (or
          (tc-ordinary-arena-owner-active-id? env oid)
          (tc-atomic-arena-owner-active-id? env oid))
          (match (tc-borrow-check-assign-conflict
            borrowed
            (TcMovePath oid TcMovePathSegments.Nil)
            primary)
            [(ResultTcUnit.Ok)
              (tc-borrow-check-owner-invalidation-scan
                ctx
                env
                locals
                borrowed
                oid
                TcNameIdList.Nil
                (tc-moved-len locals)
                primary)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))
        (TcBorrowCheckResult.Ok borrowed)))))

(define (tc-borrow-check-safe-arena-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]) : TcBorrowCheckResult
  (let
    [raw-id : i64 (tc-expr-var-name-id func)]
    (if (>= raw-id 0)
      (let
        [raw-name : String (tc-hygiene-name-text-id raw-id)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-id)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-id)))
            (tc-hygiene-global-symbol-name raw-name)
            raw-name)]
        [name-id : i64 (tc-builtin-symbol-name-id raw-id hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        [arena-call-kind : i64
          (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
        (cond
          [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
            (tc-borrow-check-safe-arena-rewind-effect
              ctx
              env
              locals
              borrowed
              args
              call-expr)]
          [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
            (tc-borrow-check-safe-arena-destroy-effect
              ctx
              env
              locals
              borrowed
              args
              call-expr)]
          [else (TcBorrowCheckResult.Ok borrowed)]))
      (TcBorrowCheckResult.Ok borrowed))))

(define (tc-string-has-suffix-at?
  [text : String]
  [suffix : String]
  [base : i64]
  [index : i64]
  [n : i64]) : bool
  (if (>= index n)
    true
    (if (=
      (cast (string.string-ref text (+ base index)) : i64)
      (cast (string.string-ref suffix index) : i64))
      (tc-string-has-suffix-at? text suffix base (+ index 1) n)
      false)))

(define (tc-string-has-suffix? [text : String] [suffix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (< text-len suffix-len)
      false
      (tc-string-has-suffix-at?
        text
        suffix
        (- text-len suffix-len)
        0
        suffix-len))))

(define (tc-hashmap-mutating-call-name? [name : String]) : bool
  (cond
    [(tc-string-has-suffix? name "-map-insert") true]
    [(tc-string-has-suffix? name "-map-put") true]
    [(tc-string-has-suffix? name "-map-remove") true]
    [(tc-string-has-suffix? name "-map-remove-borrowed") true]
    [(tc-string-has-suffix? name "-map-update-if-present") true]
    [(tc-string-has-suffix? name "-map-update-borrowed-if-present") true]
    [(tc-string-has-suffix? name "-map-insert-or-update") true]
    [(tc-string-has-suffix? name "-map-entry-or-insert") true]
    [(tc-string-has-suffix? name "-map-resized") true]
    [(tc-string-has-suffix? name "-map-grow") true]
    [else false]))

(define (tc-borrow-check-first-call-arg-root-mutation
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-borrow-check-root-mutation-conflict locals borrowed arg arg)
        [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-after-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match (tc-borrow-check-safe-arena-call-effects
    ctx
    env
    locals
    borrowed
    call-expr
    func
    args)
    [(TcBorrowCheckResult.Ok borrowed0)
      (let
        [nid : i64 (tc-expr-var-name-id func)]
        (if (and
          (>= nid 0)
          (tc-hashmap-mutating-call-name? (tc-hygiene-name-text-id nid)))
          (match (tc-borrow-check-first-call-arg-root-mutation
            locals
            borrowed0
            args)
            [(TcBorrowCheckResult.Ok _)
              (tc-borrow-check-after-returning-call
                ctx
                env
                locals
                borrowed0
                call-expr
                args
                return-lifetimes)]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])
          (tc-borrow-check-after-returning-call
            ctx
            env
            locals
            borrowed0
            call-expr
            args
            return-lifetimes)))]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-add-names [locals : TcMovedSet] [names : TcNameIdList]) : TcMovedSet
  (match names
    [(TcNameIdList.Nil) locals]
    [(TcNameIdList.Cons name-id rest)
      (tc-borrow-check-add-names (tc-moved-add locals name-id) (box-get rest))]))

(define (tc-borrow-check-remove-root-states
  [borrowed : TcMovedSet]
  [names : TcNameIdList]) : TcMovedSet
  (match names
    [(TcNameIdList.Nil) borrowed]
    [(TcNameIdList.Cons name-id rest)
      (tc-borrow-check-remove-root-states
        (tc-borrow-check-remove-root-state borrowed name-id)
        (box-get rest))]))

(define (tc-borrow-check-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcNameIdList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

(define (tc-borrow-check-pattern-locals
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]
  [locals : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-add-names
    locals
    (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern)))

(define (tc-borrow-check-effective-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (let
    [want : AstType (ast-type-strip-consuming-param ty)]
    (match (tc-borrow-check-expr ctx env locals borrowed arg)
      [(TcBorrowCheckResult.Ok borrowed1)
        (match (tc-borrow-check-after-consuming-value
          ctx
          locals
          borrowed1
          arg
          ty)
          [(TcBorrowCheckResult.Ok borrowed2)
            (if (= (tc-moved-len borrowed2) 0)
              (TcBorrowCheckResult.Ok borrowed2)
              (tc-borrow-check-after-reading-value
                ctx
                locals
                borrowed2
                arg
                want))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))

(define (tc-borrow-check-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (let
    [want : AstType (ast-type-strip-consuming-param ty)]
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        want)
      (tc-call-effective-arg-expr ctx env arg want))
      [(ResultTcExpr.Ok effective)
        (tc-borrow-check-effective-arg-with-type
          ctx
          env
          locals
          borrowed
          effective
          ty)]
      [(ResultTcExpr.Err message)
        (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-types-at
    ctx
    env
    locals
    borrowed
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-exprs-with-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-borrow-check-arg-with-type
          ctx
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-types-at
              ctx
              env
              locals
              borrowed1
              exprs
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-activate-two-phase-mut-borrows-loop
  [borrowed : TcMovedSet]
  [facts : TcMovedPathFacts]
  [primary : AstExpr]) : TcBorrowCheckResult
  (match facts
    [(TcMovedPathFacts.Nil) (TcBorrowCheckResult.Ok borrowed)]
    [(TcMovedPathFacts.Cons fact rest)
      (match (struct-get fact kind)
        [(TcMovedPathKind.BorrowTwoPhaseMut)
          (let
            [path : TcMovePath (struct-get fact path)]
            (match (tc-moved-path-conflict borrowed path)
              [(TcMoveConflict.Some _ _)
                (TcBorrowCheckResult.Err
                  (tc-borrow-check-rich-conflict-message
                    borrowed
                    path
                    (TcMovedPathKind.BorrowShared)
                    primary
                    (tc-borrow-check-mutably-borrow-message
                      (tc-move-path-render path))))]
              [TcMoveConflict.No
                (tc-borrow-check-activate-two-phase-mut-borrows-loop
                  borrowed
                  (box-get rest)
                  primary)]))]
        [_
          (tc-borrow-check-activate-two-phase-mut-borrows-loop
            borrowed
            (box-get rest)
            primary)])]))

(define (tc-borrow-check-activate-two-phase-mut-borrows
  [borrowed : TcMovedSet]
  [primary : AstExpr]) : TcBorrowCheckResult
  (tc-borrow-check-activate-two-phase-mut-borrows-loop
    borrowed
    (tc-moved-paths borrowed)
    primary))

(define (tc-borrow-check-reserve-two-phase-mut-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [borrow-expr : AstExpr]
  [place : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-read-conflict locals borrowed place borrow-expr)
    [(TcBorrowCheckResult.Ok borrowed0)
      (match (tc-borrow-check-expr ctx env locals borrowed0 place)
        [(TcBorrowCheckResult.Ok borrowed1)
          (match (tc-borrow-place ctx env place)
            [(ResultTcBorrowPlace.Ok _)
              (tc-borrow-check-add-two-phase-mut-place
                locals
                borrowed1
                place
                borrow-expr)]
            [(ResultTcBorrowPlace.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-call-args-two-phase-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : AstExpr]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-call-args-two-phase-with-types-at
    ctx
    env
    locals
    borrowed
    reserved
    call-expr
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-call-args-two-phase-with-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : AstExpr]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (begin
    (when
      (>= index (struct-get exprs len))
      (return
        (if (>= index (ast-type-list-len types))
          (if reserved
            (tc-borrow-check-activate-two-phase-mut-borrows borrowed call-expr)
            (TcBorrowCheckResult.Ok borrowed))
          (TcBorrowCheckResult.Err
            (tc-call-arity-invariant-message "borrow-check")))))
    (when
      (>= index (ast-type-list-len types))
      (return
        (TcBorrowCheckResult.Err
          (tc-call-arity-invariant-message "borrow-check"))))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      [raw-ty : AstType
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
      [ty : AstType (ast-type-strip-consuming-param raw-ty)]
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-effective-arg-expr
          "borrow.call_arg"
          ctx
          env
          head-expr
          ty)
        (tc-call-effective-arg-expr ctx env head-expr ty))
        [(ResultTcExpr.Ok effective-head)
          (match (ast-expr-unspan effective-head)
            [(AstExpr.Borrow mutable _ place-box)
              (if (and mutable (tc-call-mutable-ref-formal? ctx ty))
                (let
                  [place : AstExpr (ast-node-get place-box)]
                  (match (tc-borrow-check-reserve-two-phase-mut-call-arg
                    ctx
                    env
                    locals
                    borrowed
                    effective-head
                    place)
                    [(TcBorrowCheckResult.Ok borrowed1)
                      (tc-borrow-check-call-args-two-phase-with-types-at
                        ctx
                        env
                        locals
                        borrowed1
                        true
                        call-expr
                        exprs
                        types
                        (+ index 1))]
                    [(TcBorrowCheckResult.Err message)
                      (TcBorrowCheckResult.Err message)]))
                (match (tc-borrow-check-effective-arg-with-type
                  ctx
                  env
                  locals
                  borrowed
                  effective-head
                  raw-ty)
                  [(TcBorrowCheckResult.Ok borrowed1)
                    (tc-borrow-check-call-args-two-phase-with-types-at
                      ctx
                      env
                      locals
                      borrowed1
                      reserved
                      call-expr
                      exprs
                      types
                      (+ index 1))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)]))]
            [_
              (match (tc-borrow-check-effective-arg-with-type
                ctx
                env
                locals
                borrowed
                effective-head
                raw-ty)
                [(TcBorrowCheckResult.Ok borrowed1)
                  (tc-borrow-check-call-args-two-phase-with-types-at
                    ctx
                    env
                    locals
                    borrowed1
                    reserved
                    call-expr
                    exprs
                    types
                    (+ index 1))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])])]
        [(ResultTcExpr.Err message)
          (TcBorrowCheckResult.Err (tc-locate-error-at-expr head-expr message))]))))

(define (tc-call-explicit-borrow-expr? [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Borrow _ _ _) true]
    [_ false]))

(define (tc-borrow-check-add-call-arg-auto-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (if (tc-call-explicit-borrow-expr? arg)
    (TcBorrowCheckResult.Ok borrowed)
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        ty)
      (tc-call-effective-arg-expr ctx env arg ty))
      [(ResultTcExpr.Ok effective)
        (match (ast-expr-unspan effective)
          [(AstExpr.Borrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [_ (TcBorrowCheckResult.Ok borrowed)])]
      [(ResultTcExpr.Err message)
        (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-auto-borrowed-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-auto-borrowed-call-args-at
    ctx
    env
    locals
    borrowed
    (& args)
    (& types)
    0))

(define (tc-borrow-check-auto-borrowed-call-args-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-borrow-check-add-call-arg-auto-borrow
          ctx
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-auto-borrowed-call-args-at
              ctx
              env
              locals
              borrowed1
              args
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcBorrowCheckResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcMaybeString.Some _)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (tc-borrow-check-after-move-only-value
                  ctx
                  locals
                  borrowed
                  message-expr
                  message-ty)]
              [(ResultTcExpr.Err message) (TcBorrowCheckResult.Err message)])]
          [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)])
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-string-helper-intrinsic-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (tc-hygiene-name-text-id raw-name)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-name)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-name)))
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        [name-id : i64 (tc-builtin-call-name-id raw-name hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (or
          (tc-string-length-helper-call-id? ctx env name-id lookup-id)
          (tc-string-ref-helper-call-id? ctx env name-id lookup-id)))]
    [_ false]))

(define (tc-borrow-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [types : AstTypeList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (if (tc-borrow-check-string-helper-intrinsic-call? ctx env func)
    (match (tc-borrow-check-read-exprs
      ctx
      env
      locals
      (tc-moved-clone borrowed)
      args)
      [(TcBorrowCheckResult.Ok _)
        (tc-borrow-check-after-call-effects
          ctx
          env
          locals
          borrowed
          call-expr
          func
          args
          return-lifetimes)]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])
    (let
      [validation-borrowed : TcMovedSet (tc-moved-clone borrowed)]
      [validation-result : TcBorrowCheckResult
        (tc-borrow-check-call-args-two-phase-with-types
          ctx
          env
          locals
          validation-borrowed
          false
          call-expr
          args
          types)]
      (match validation-result
        [(TcBorrowCheckResult.Ok _)
          (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
            (match (tc-borrow-check-auto-borrowed-call-args
              ctx
              env
              locals
              borrowed
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-thread-channel-send-message
                  ctx
                  env
                  locals
                  borrowed2
                  func
                  args
                  types)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed3
                      call-expr
                      func
                      args
                      return-lifetimes)]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])
            (match (tc-borrow-check-thread-channel-send-message
              ctx
              env
              locals
              borrowed
              func
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-after-call-effects
                  ctx
                  env
                  locals
                  borrowed2
                  call-expr
                  func
                  args
                  return-lifetimes)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-exprs-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr ctx env locals borrowed0 head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-protected
              ctx
              env
              locals
              borrowed1
              protected
              rest)]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected-at
    ctx
    env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-with-protected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : i64 (ast-expr-list-get exprs index 0)]
      (match (tc-borrow-check-expr-id ctx env locals borrowed head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-exprs-with-protected-at
            ctx
            env
            locals
            borrowed1
            protected
            exprs
            (+ index 1))]
        [(TcBorrowCheckResult.Err message)
          (let
            [head-expr : AstExpr (ast-node-get head)]
            [rest : AstExprList (ast-expr-list-tail-from-ref exprs (+ index 1))]
            [current : AstExprList (ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-retry-after-prune
              ctx
              env
              locals
              borrowed
              protected
              current
              head-expr
              rest
              message))]))))

(define (tc-borrow-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected ctx env locals borrowed borrowed exprs))

(define (tc-borrow-check-expr-with-protected-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr-with-protected
    ctx
    env
    locals
    borrowed
    protected
    (ast-node-get expr-id)))

(define (tc-borrow-check-expr-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-with-protected-id
        ctx
        env
        locals
        borrowed
        protected
        inner-box)]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-expr-type-contains-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : i64]) : bool
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty)
      (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
    [(ResultTcType.Err _) false]))

(define (tc-borrow-check-expr-list-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : i64]) : bool
  (tc-borrow-check-expr-list-stores-lifetime-at? ctx env (& exprs) 0 lifetime))

(define (tc-borrow-check-expr-list-stores-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [lifetime : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (if (tc-borrow-check-expr-stores-lifetime?
      ctx
      env
      (ast-node-get (ast-expr-list-get exprs index 0))
      lifetime)
      true
      (tc-borrow-check-expr-list-stores-lifetime-at?
        ctx
        env
        exprs
        (+ index 1)
        lifetime))))

(define (tc-borrow-check-let-bindings-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [lifetime : i64]) : bool
  (tc-borrow-check-let-bindings-store-lifetime-at?
    ctx
    env
    (& bindings)
    lifetime
    0))

(define (tc-borrow-check-let-bindings-store-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get init-box)
          lifetime)
          true
          (tc-borrow-check-let-bindings-store-lifetime-at?
            ctx
            env
            bindings
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-match-arms-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arms : AstMatchArmList]
  [lifetime : i64]) : bool
  (tc-borrow-check-match-arms-store-lifetime-at? ctx env (& arms) lifetime 0))

(define (tc-borrow-check-match-arms-store-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arms : (& arms AstMatchArmList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get body-box)
          lifetime)
          true
          (tc-borrow-check-match-arms-store-lifetime-at?
            ctx
            env
            arms
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-expr-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : i64]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Ann inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Cast inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get cond-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get then-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get else-box)
          lifetime))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              env
              bindings
              lifetime)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get body-box)
              lifetime))])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (or
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get scrut-box)
              lifetime)
            (tc-borrow-check-match-arms-store-lifetime? ctx env arms lifetime))])]
    [(AstExpr.Set name rhs-box)
      (if (tc-dotted-local-field-name-id? env name)
        (match (tc-dotted-local-field-set-expr-id env name rhs-box)
          [(ResultTcExprId.Ok virtual-id)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get virtual-id)
              lifetime)]
          [(ResultTcExprId.Err _) false])
        (match (tc-lookup-id env name)
          [(ResultTcType.Ok ty)
            (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
          [(ResultTcType.Err _) false]))]
    [(AstExpr.ArraySet array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExpr.ArrayTake array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExpr.ArrayPush array-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExpr.StructSet receiver-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get receiver-box)
        lifetime)]
    [(AstExpr.BoxSet box-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get box-box)
        lifetime)]
    [_ false]))

(define (tc-borrow-check-loop-protect-carried-facts-loop
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [kind : TcMovedPathKind (struct-get fact kind)]
        [out2 : TcMovedSet
          (if (or
            (match (tc-moved-path-exact-conflict-kind before path kind)
              [(TcMoveConflict.Some _ _) true]
              [TcMoveConflict.No false])
            (match (tc-moved-path-exact-conflict-kind out path kind)
              [(TcMoveConflict.Some _ _) true]
              [TcMoveConflict.No false]))
            out
            (tc-moved-add-path-fact
              out
              path
              kind
              (tc-moved-path-fact-origin fact)))]
        (tc-borrow-check-loop-protect-carried-facts-loop
          ctx
          loop-env
          before
          (box-get rest)
          out2))]))

(define (tc-borrow-check-loop-protect-carried-facts
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-carried-facts-loop
    ctx
    loop-env
    before
    (tc-moved-paths after)
    protected))

(define (tc-borrow-check-loop-protect-stored-facts-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (match facts
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [path : TcMovePath (struct-get fact path)]
        [kind : TcMovedPathKind (struct-get fact kind)]
        [out2 : TcMovedSet
          (if (match (tc-moved-path-exact-conflict-kind out path kind)
            [(TcMoveConflict.Some _ _) true]
            [TcMoveConflict.No false])
            out
            (let
              [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
              (if (tc-borrow-check-expr-stores-lifetime? ctx env expr lifetime)
                (tc-moved-add-path-fact
                  out
                  path
                  kind
                  (tc-moved-path-fact-origin fact))
                out)))]
        (tc-borrow-check-loop-protect-stored-facts-loop
          ctx
          env
          expr
          (box-get rest)
          out2))]))

(define (tc-borrow-check-loop-protect-stored-facts
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-stored-facts-loop
    ctx
    env
    expr
    (tc-moved-paths borrowed)
    protected))

(define (tc-borrow-check-loop-visible-body-borrows
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [body-borrowed : TcMovedSet]) : TcMovedSet
  (tc-moved-union
    (tc-borrow-check-loop-protect-carried-facts
      ctx
      loop-env
      entry
      body-borrowed
      (tc-moved-empty))
    entry))

(define (tc-borrow-check-exprs-loop-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed0
          protected
          head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (let
              [protected1 : TcMovedSet
                (tc-borrow-check-loop-protect-stored-facts
                  ctx
                  env
                  head
                  borrowed1
                  (tc-borrow-check-loop-protect-carried-facts
                    ctx
                    loop-env
                    borrowed0
                    borrowed1
                    protected))]
              (tc-borrow-check-exprs-loop
                ctx
                env
                loop-env
                locals
                borrowed1
                protected1
                rest))]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-loop-at
    ctx
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-loop-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-borrow-check-expr-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (let
            [protected1 : TcMovedSet
              (tc-borrow-check-loop-protect-stored-facts
                ctx
                env
                head
                borrowed1
                (tc-borrow-check-loop-protect-carried-facts
                  ctx
                  loop-env
                  borrowed
                  borrowed1
                  protected))]
            (tc-borrow-check-exprs-loop-at
              ctx
              env
              loop-env
              locals
              borrowed1
              protected1
              exprs
              (+ index 1)))]
        [(TcBorrowCheckResult.Err message)
          (let
            [rest : AstExprList (ast-expr-list-tail-from-ref exprs (+ index 1))]
            [current : AstExprList (ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-loop-retry-after-prune
              ctx
              env
              loop-env
              locals
              borrowed
              protected
              current
              head
              rest
              message))]))))

(define (tc-borrow-check-arms-loop-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join-at
    ctx
    env
    loop-env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-loop-join-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get arms len))
    (TcBorrowCheckResult.Ok joined)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-borrow-check-expr-loop
                ctx
                arm-env
                loop-env
                (tc-borrow-check-pattern-locals
                  ctx
                  scrut-ty
                  pattern
                  (tc-moved-clone locals))
                (tc-moved-clone borrowed)
                borrowed
                body)
                [(TcBorrowCheckResult.Ok arm-borrowed)
                  (let
                    [visible-arm-borrowed : TcMovedSet
                      (tc-borrow-check-remove-root-states
                        arm-borrowed
                        (tc-borrow-check-pattern-bound-names
                          ctx
                          scrut-ty
                          pattern))]
                    (tc-borrow-check-arms-loop-join-at
                      ctx
                      env
                      loop-env
                      locals
                      borrowed
                      scrut-ty
                      arms
                      (tc-moved-union joined visible-arm-borrowed)
                      (+ index 1)))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)]))])))

(define (tc-borrow-check-arms-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join
    ctx
    env
    loop-env
    locals
    borrowed
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed
          protected
          inner))]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(TcBorrowCheckResult.Ok borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              then-branch)
              [(TcBorrowCheckResult.Ok borrowedt)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env
                  loop-env
                  (tc-moved-clone locals)
                  (tc-moved-clone borrowedc)
                  borrowedc
                  else-branch)
                  [(TcBorrowCheckResult.Ok borrowede)
                    (TcBorrowCheckResult.Ok
                      (tc-moved-union borrowedt borrowede))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-let-bindings
              ctx
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowed)
              bindings)
              [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env2
                  loop-env
                  locals2
                  borrowed2
                  borrowed
                  body)
                  [(TcBorrowCheckResult.Ok body-borrowed)
                    (TcBorrowCheckResult.Ok
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        body-borrowed))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckBindings.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(TcBorrowCheckResult.Ok borroweds)
                (match (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-borrow-check-arms-loop
                      ctx
                      env
                      loop-env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-read-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-read-exprs-at ctx env locals borrowed (& exprs) 0))

(define (tc-borrow-check-read-exprs-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-borrow-check-expr ctx env locals borrowed head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (if (= (tc-moved-len borrowed1) 0)
            (tc-borrow-check-read-exprs-at
              ctx
              env
              locals
              borrowed1
              exprs
              (+ index 1))
            (match (tc-borrow-check-place-read-conflict
              locals
              borrowed1
              head
              head)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-read-exprs-at
                  ctx
                  env
                  locals
                  borrowed2
                  exprs
                  (+ index 1))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-add-returned-call-arg-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-expr "borrow.return_arg" ctx env arg)
    (tc-expr ctx env arg))
    [(ResultTcType.Ok arg-ty)
      (if (tc-name-id-list-overlaps?
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx arg-ty))
        result-lifetimes)
        (match (ast-expr-unspan arg)
          [(AstExpr.Borrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [(AstExpr.Ann inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [(AstExpr.Cast inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [_ (TcBorrowCheckResult.Ok borrowed)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-add-returned-call-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (tc-borrow-check-add-returned-call-borrows-at
    ctx
    env
    locals
    borrowed
    (& args)
    0
    result-lifetimes))

(define (tc-borrow-check-add-returned-call-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index (struct-get args len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (tc-borrow-check-add-returned-call-arg-borrow
        ctx
        env
        locals
        borrowed
        arg
        result-lifetimes)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-add-returned-call-borrows-at
            ctx
            env
            locals
            borrowed1
            args
            (+ index 1)
            result-lifetimes)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-after-returning-call-lifetimes
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match result-lifetimes
    [(TcNameIdList.Nil) (TcBorrowCheckResult.Ok borrowed)]
    [_
      (tc-borrow-check-add-returned-call-borrows
        ctx
        env
        locals
        borrowed
        args
        result-lifetimes)]))

(define (tc-borrow-check-after-returning-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [args : AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match return-lifetimes
    [(TcBorrowCallReturnLifetimes.Known result-lifetimes)
      (tc-borrow-check-after-returning-call-lifetimes
        ctx
        env
        locals
        borrowed
        args
        result-lifetimes)]
    [(TcBorrowCallReturnLifetimes.Fallback)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr
          "borrow.return_call"
          ctx
          env
          call-expr)
        (tc-expr ctx env call-expr))
        [(ResultTcType.Ok result-ty)
          (tc-borrow-check-after-returning-call-lifetimes
            ctx
            env
            locals
            borrowed
            args
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx result-ty)))]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])]))

(define (tc-borrow-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstLetBindingList]) : TcBorrowCheckBindings
  (tc-borrow-check-let-bindings-at ctx env locals borrowed (& bindings) 0))

(define (tc-borrow-check-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : TcBorrowCheckBindings
  (if (>= index (ast-let-binding-list-len bindings))
    (TcBorrowCheckBindings.Ok env locals borrowed)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (let
                [binding-ty : AstType
                  (tc-move-binding-type-id
                    "borrow.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                (match (tc-borrow-check-after-bind-known-type-id
                  ctx
                  env
                  locals
                  borrowed1
                  name
                  init-box
                  binding-ty)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (let
                      [borrowed3 : TcMovedSet
                        (tc-borrow-check-mark-new-return-borrows
                          ctx
                          env
                          locals
                          borrowed
                          borrowed2
                          name
                          binding-ty
                          init)]
                      (tc-borrow-check-let-bindings-at
                        ctx
                        (tc-bind-c-abi-fnptr-if-needed-id
                          ctx
                          env
                          name
                          binding-ty
                          init)
                        (tc-moved-add locals name)
                        (tc-borrow-check-remove-root-state borrowed3 name)
                        bindings
                        (+ index 1)))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckBindings.Err message)]))]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckBindings.Err message)]))])))

(define (tc-borrow-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcBorrowCheckResourceBindings
  (tc-borrow-check-resource-bindings-at ctx env locals borrowed (& bindings) 0))

(define (tc-borrow-check-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : TcBorrowCheckResourceBindings
  (if (>= index (ast-resource-binding-list-len bindings))
    (TcBorrowCheckResourceBindings.Ok env locals borrowed)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box _)
        (let
          [_init : AstExpr (ast-node-get init-box)]
          (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-after-bind-id
                ctx
                env
                locals
                borrowed1
                init-box)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (match (tc-body-type-fact-expr-id
                    "borrow.resource_init"
                    ctx
                    env
                    init-box)
                    [(ResultTcType.Ok init-ty)
                      (tc-borrow-check-resource-bindings-at
                        ctx
                        (tc-bind-id
                          (tc-bind-id
                            env
                            (tc-cleanup-owner-marker-id)
                            (AstType.Var name))
                          name
                          (tc-type-without-regions init-ty))
                        (tc-moved-add locals name)
                        (tc-borrow-check-remove-root-state borrowed2 name)
                        bindings
                        (+ index 1))]
                    [(ResultTcType.Err message)
                      (TcBorrowCheckResourceBindings.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResourceBindings.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResourceBindings.Err message)]))])))

(define (tc-borrow-check-arms-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join-at
    ctx
    env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-join-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get arms len))
    (TcBorrowCheckResult.Ok joined)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env)
            (match (tc-borrow-check-expr-id
              ctx
              arm-env
              (tc-borrow-check-pattern-locals
                ctx
                scrut-ty
                pattern
                (tc-moved-clone locals))
              (tc-moved-clone borrowed)
              body-box)
              [(TcBorrowCheckResult.Ok arm-borrowed)
                (let
                  [visible-arm-borrowed : TcMovedSet
                    (tc-borrow-check-remove-root-states
                      arm-borrowed
                      (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern))]
                  (tc-borrow-check-arms-join-at
                    ctx
                    env
                    locals
                    borrowed
                    scrut-ty
                    arms
                    (tc-moved-union joined visible-arm-borrowed)
                    (+ index 1)))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)])])))

(define (tc-borrow-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join ctx env locals borrowed scrut-ty arms borrowed))

(define (tc-borrow-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr ctx env locals borrowed (ast-node-get expr-id)))

(define (tc-borrow-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExpr.Literal _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Var name)
      (if (tc-dotted-local-field-name-id? env name)
        (match (tc-dotted-local-field-expr-id env name)
          [(ResultTcExprId.Ok virtual-id)
            (tc-borrow-check-expr-id ctx env locals borrowed virtual-id)]
          [(ResultTcExprId.Err message) (TcBorrowCheckResult.Err message)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(AstExpr.Binary _ left-box right-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed left-box)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-expr-id ctx env locals borrowed1 right-box)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.Unary _ inner-box)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-borrow-check-expr-id ctx env locals borrowed func-box)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-call-info-id-with-facts
              "borrow.call_func"
              ctx
              env
              func-box
              args)
              [(ResultTcBorrowCallInfo.Ok params return-lifetimes)
                (match (tc-call-extern-abi ctx func)
                  [(TcMaybeExternAbi.Some abi)
                    (if (tc-call-dynamic-c-varargs-abi? abi)
                      (match (tc-call-extern-varargs-params
                        ctx
                        env
                        func
                        args
                        params
                        abi)
                        [(ResultTcTypeList.Ok expanded-params)
                          (tc-borrow-check-call-args-with-types
                            ctx
                            env
                            locals
                            borrowed1
                            expr
                            func
                            args
                            expanded-params
                            (TcBorrowCallReturnLifetimes.Fallback))]
                        [(ResultTcTypeList.Err message)
                          (TcBorrowCheckResult.Err message)])
                      (tc-borrow-check-call-args-with-types
                        ctx
                        env
                        locals
                        borrowed1
                        expr
                        func
                        args
                        params
                        return-lifetimes))]
                  [(TcMaybeExternAbi.No)
                    (tc-borrow-check-call-args-with-types
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args
                      params
                      return-lifetimes)])]
              [(ResultTcBorrowCallInfo.Err _)
                (match (tc-borrow-check-read-exprs
                  ctx
                  env
                  locals
                  (tc-moved-clone borrowed1)
                  args)
                  [(TcBorrowCheckResult.Ok _)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args
                      (TcBorrowCallReturnLifetimes.Fallback))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BracketClause items)
      (tc-borrow-check-exprs ctx env locals borrowed items)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed cond-box)
        [(TcBorrowCheckResult.Ok borrowedc)
          (match (tc-borrow-check-expr-id
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowedc)
            then-branch-box)
            [(TcBorrowCheckResult.Ok borrowedt)
              (match (tc-borrow-check-expr-id
                ctx
                env
                (tc-moved-clone locals)
                (tc-moved-clone borrowedc)
                else-branch-box)
                [(TcBorrowCheckResult.Ok borrowede)
                  (TcBorrowCheckResult.Ok (tc-moved-union borrowedt borrowede))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (match (tc-borrow-check-let-bindings
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowed)
            bindings)
            [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
              (match (tc-borrow-check-expr-with-protected-id
                ctx
                env2
                locals2
                borrowed2
                borrowed
                body-box)
                [(TcBorrowCheckResult.Ok body-borrowed)
                  (if (<= (tc-moved-len body-borrowed) (tc-moved-len borrowed))
                    (TcBorrowCheckResult.Ok borrowed)
                    (match (tc-body-type-fact-expr-id
                      "borrow.let_return"
                      ctx
                      env2
                      body-box)
                      [(ResultTcType.Ok result-ty)
                        (TcBorrowCheckResult.Ok
                          (tc-borrow-check-propagate-return-borrows
                            ctx
                            env2
                            locals
                            borrowed
                            body-borrowed
                            result-ty
                            (ast-node-get body-box)))]
                      [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckBindings.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (match (tc-borrow-check-expr-id
            ctx
            (tc-bind-params ctx env params)
            (tc-move-params-locals params (tc-moved-clone locals))
            (tc-moved-empty)
            body-box)
            [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Tuple exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.tuple_list"
        ctx
        env
        exprs)
        [(ResultTcTypeList.Ok types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ResultTcTypeList.Err _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Array exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.array_list"
        ctx
        env
        exprs)
        [(ResultTcTypeList.Ok types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ResultTcTypeList.Err _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExpr.DynArray exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.dyn_array_list"
        ctx
        env
        exprs)
        [(ResultTcTypeList.Ok types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ResultTcTypeList.Err _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExpr.MakeArray _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-expr-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-after-bind-id
                      ctx
                      env
                      locals
                      borrowed3
                      value-box)
                      [(TcBorrowCheckResult.Ok borrowed4)
                        (match (tc-borrow-check-array-set-conflict
                          locals
                          borrowed4
                          array
                          index
                          array)
                          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed4)]
                          [(ResultTcUnit.Err message)
                            (TcBorrowCheckResult.Err message)])]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [live : AstExpr (ast-node-get live-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 live)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-expr ctx env locals borrowed2 index)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-array-set-conflict
                      locals
                      borrowed3
                      live
                      index
                      expr)
                      [(ResultTcUnit.Ok)
                        (match (tc-borrow-check-array-set-conflict
                          locals
                          borrowed3
                          array
                          index
                          expr)
                          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                          [(ResultTcUnit.Err message)
                            (TcBorrowCheckResult.Err message)])]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed receiver)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-struct-set-conflict
                      locals
                      borrowed3
                      receiver
                      field
                      receiver)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      array
                      array)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed str)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(TcBorrowCheckResult.Ok borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              body)
              [(TcBorrowCheckResult.Ok body-borrowed)
                (TcBorrowCheckResult.Ok
                  (tc-borrow-check-loop-visible-body-borrows
                    ctx
                    env
                    borrowedc
                    body-borrowed))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExpr.Set name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name rhs-box)
            [(ResultTcExprId.Ok virtual-id)
              (tc-borrow-check-expr
                ctx
                env
                locals
                borrowed
                (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (TcBorrowCheckResult.Err message)])
          (match (tc-borrow-check-expr-id ctx env locals borrowed rhs-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-after-bind-id
                ctx
                env
                locals
                borrowed1
                rhs-box)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (let
                    [borrowed3 : TcMovedSet
                      (tc-borrow-check-prune-value-temporaries
                        ctx
                        env
                        borrowed
                        borrowed2
                        rhs)]
                    (match (tc-borrow-check-assignment
                      locals
                      borrowed3
                      name
                      rhs)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)]))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Borrow mutable _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (if (= (tc-moved-len borrowed) 0)
          (match (tc-borrow-check-expr ctx env locals borrowed inner)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-place ctx env inner)
                [(ResultTcBorrowPlace.Ok _)
                  (tc-borrow-check-add-place-with-mutability
                    locals
                    borrowed1
                    mutable
                    inner
                    inner)]
                [(ResultTcBorrowPlace.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])
          (match (tc-borrow-check-place-read-conflict
            locals
            borrowed
            inner
            expr)
            [(TcBorrowCheckResult.Ok borrowed0)
              (match (tc-borrow-check-expr ctx env locals borrowed0 inner)
                [(TcBorrowCheckResult.Ok borrowed1)
                  (match (tc-borrow-place ctx env inner)
                    [(ResultTcBorrowPlace.Ok _)
                      (tc-borrow-check-add-place-with-mutability
                        locals
                        borrowed1
                        mutable
                        inner
                        inner)]
                    [(ResultTcBorrowPlace.Err message)
                      (TcBorrowCheckResult.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(TcBorrowCheckResult.Ok borroweds)
                (match (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-borrow-check-arms
                      ctx
                      env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (let
                      [body-env : TcTypeEnv
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))]
                      [body-locals : TcMovedSet
                        (tc-moved-add (tc-moved-clone locals) index)]
                      [body-entry : TcMovedSet
                        (tc-borrow-check-remove-root-state
                          (tc-moved-clone borrowed2)
                          index)]
                      (match (tc-borrow-check-expr-loop
                        ctx
                        body-env
                        env
                        body-locals
                        body-entry
                        body-entry
                        body)
                        [(TcBorrowCheckResult.Ok body-borrowed)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-loop-visible-body-borrows
                              ctx
                              env
                              body-entry
                              (tc-borrow-check-remove-root-state
                                body-borrowed
                                index)))]
                        [(TcBorrowCheckResult.Err message)
                          (TcBorrowCheckResult.Err message)]))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ a-box b-box c-box d-box)
          (let
            [a : AstExpr (ast-node-get a-box)]
            [b : AstExpr (ast-node-get b-box)]
            [c : AstExpr (ast-node-get c-box)]
            [d : AstExpr (ast-node-get d-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed a)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 b)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 c)
                      [(TcBorrowCheckResult.Ok borrowed3)
                        (tc-borrow-check-expr ctx env locals borrowed3 d)]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id value-env prefix (tc-resolve-type ctx prefix-ty))]
            [value-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone value-locals) prefix)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 init)
                      [(TcBorrowCheckResult.Ok borrowed3)
                        (match (tc-borrow-check-expr-loop
                          ctx
                          value-env
                          env
                          value-locals
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index)
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index)
                          value)
                          [(TcBorrowCheckResult.Ok borrowed4)
                            (let
                              [body-entry : TcMovedSet
                                (tc-borrow-check-remove-root-state
                                  (tc-borrow-check-remove-root-state
                                    (tc-moved-clone borrowed4)
                                    index)
                                  prefix)]
                              (match (tc-borrow-check-expr-loop
                                ctx
                                body-env
                                env
                                body-locals
                                body-entry
                                body-entry
                                body)
                                [(TcBorrowCheckResult.Ok body-borrowed)
                                  (TcBorrowCheckResult.Ok
                                    (tc-borrow-check-loop-visible-body-borrows
                                      ctx
                                      env
                                      borrowed4
                                      (tc-borrow-check-remove-root-state
                                        (tc-borrow-check-remove-root-state
                                          body-borrowed
                                          index)
                                        prefix)))]
                                [(TcBorrowCheckResult.Err message)
                                  (TcBorrowCheckResult.Err message)]))]
                          [(TcBorrowCheckResult.Err message)
                            (TcBorrowCheckResult.Err message)])]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithRegion _ exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed scratch)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed1)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithScratch exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed arena)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed1)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings exprs)
          (match (tc-borrow-check-resource-bindings
            ctx
            env
            locals
            (tc-moved-clone borrowed)
            bindings)
            [(TcBorrowCheckResourceBindings.Ok
                body-env
                body-locals
                body-borrowed)
              (match (tc-borrow-check-exprs-with-protected
                ctx
                body-env
                body-locals
                body-borrowed
                borrowed
                exprs)
                [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResourceBindings.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-expr ctx env inner)
              [(ResultTcType.Ok box-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  box-ty)]
              [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed1)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed box-expr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      (ast-node-get (ast-expr-box-get box-box))
                      box-expr)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.TypeLiteral _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Init _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Quote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Quasiquote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Unquote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.UnquoteSplicing _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-current-return-type env)
              [(ResultTcType.Ok return-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  return-ty)]
              [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed1)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Break) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Continue) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.PtrNull _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-borrow-check-expr ctx env locals borrowed place))]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 value)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 offset)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.PtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.IntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 len)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.BinaryData _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.SpmdProgramIndex) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.SpmdProgramCount) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramArgc) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramArgv) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramEnvp) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-borrow-check-expr ctx env locals borrowed index))]
    [(AstExpr.Syscall args)
      (tc-borrow-check-read-exprs ctx env locals borrowed args)]))

(define (tc-borrow-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(TcBorrowCheckResult.Ok _) ResultTcUnit.Ok]
    [(TcBorrowCheckResult.Err message) (ResultTcUnit.Err message)]))

;; --- borrow-check relevance gate --------------------------------------------
;;
;; The borrow checker can only fire on borrow-relevant constructs: `&` borrow
;; creation, box-take consumption, `with-region` blocks, calls to functions
;; whose signature mentions a region, and region-typed parameters/results
;; (which seed borrowed places). A body with none of those checks out as a pure
;; pass-through (measured: 72.6% of self-compile bodies), so the gate answers
;; `Ok` without walking. A call whose recorded callee type (the body type
;; facts from the tc-expr walk) contains no region keeps its Fallback lifetime
;; handling, which cannot error either; a fact Miss stays conservative.
(define (tc-borrow-gate-call-has-region? [func-id : i64]) : bool
  (match (tc-body-type-fact-lookup func-id)
    [(TcBodyTypeFact.Hit fn-ty) (tc-type-contains-any-region fn-ty)]
    [(TcBodyTypeFact.Miss) true]))

(define (tc-borrow-gate-expr-ty-has-region? [expr-id : i64]) : bool
  (match (tc-body-type-fact-lookup expr-id)
    [(TcBodyTypeFact.Hit ty) (tc-type-contains-any-region ty)]
    [(TcBodyTypeFact.Miss) true]))

(define (tc-borrow-gate-exprs-relevant? [ctx : TcContext] [exprs : AstExprList]) : bool
  (let
    [i : i64 0]
    [count : i64 (ast-expr-list-len (& exprs))]
    [found : bool false]
    (begin
      (while (and (not found) (< i count))
        (if (tc-borrow-gate-expr-relevant?
          ctx
          (ast-node-get (ast-expr-list-get (& exprs) i 0)))
          (set! found true)
          (set! i (+ i 1))))
      found)))

(define (tc-borrow-gate-let-bindings-relevant?
  [ctx : TcContext]
  [bindings : AstLetBindingList]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len (& bindings)))
    false
    (match (ast-let-binding-list-get
      (& bindings)
      index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ maybe-ty init-box)
        (or
          (match maybe-ty
            [(AstMaybeType.Some ty)
              (tc-type-contains-any-region (tc-resolve-type ctx ty))]
            [(AstMaybeType.No) false])
          (tc-borrow-gate-expr-relevant? ctx (ast-node-get init-box))
          (tc-borrow-gate-let-bindings-relevant? ctx bindings (+ index 1)))])))

(define (tc-borrow-gate-match-arms-relevant?
  [ctx : TcContext]
  [arms : AstMatchArmList]
  [index : i64]) : bool
  (if (>= index (ast-match-arm-list-len (& arms)))
    false
    (match (ast-match-arm-list-get (& arms) index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (or
          (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box))
          (tc-borrow-gate-match-arms-relevant? ctx arms (+ index 1)))])))

(define (tc-borrow-gate-resource-bindings-relevant?
  [ctx : TcContext]
  [bindings : AstResourceBindingList]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len (& bindings)))
    false
    (match (ast-resource-binding-list-get
      (& bindings)
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ _ init-box)
        (or
          (tc-borrow-gate-expr-relevant? ctx (ast-node-get init-box))
          (tc-borrow-gate-resource-bindings-relevant? ctx bindings (+ index 1)))])))

(define (tc-borrow-gate-expr-relevant? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Literal _) false]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get left-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get right-box)))]
    [(AstExpr.Unary _ inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Call func-box args)
      (or
        (tc-borrow-gate-call-has-region? func-box)
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get func-box))
        (tc-borrow-gate-exprs-relevant? ctx args))]
    [(AstExpr.BracketClause items) (tc-borrow-gate-exprs-relevant? ctx items)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get cond-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get then-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get else-box)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (tc-borrow-gate-let-bindings-relevant? ctx bindings 0)
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box)))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (or
            (tc-borrow-gate-params-relevant? ctx params)
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box)))])]
    [(AstExpr.Tuple exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [(AstExpr.TupleRef tuple-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get tuple-box))]
    [(AstExpr.Array exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [(AstExpr.DynArray exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [(AstExpr.MakeArray _ len-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get len-box))]
    [(AstExpr.ArrayRef array-box index-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get array-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get index-box)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get array-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get index-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get array-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get live-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get index-box)))]
    [(AstExpr.ArrayPush array-box value-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get array-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))]
    [(AstExpr.StringRef str-box index-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get str-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get index-box)))]
    [(AstExpr.While cond-box body-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get cond-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box)))]
    [(AstExpr.Begin exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [(AstExpr.Unsafe exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [(AstExpr.Set _ value-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))]
    [(AstExpr.Ann inner-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Borrow _ _ _) true]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (or
            (tc-borrow-gate-expr-ty-has-region? scrutinee-box)
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get scrutinee-box))
            (tc-borrow-gate-match-arms-relevant? ctx arms 0))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get start-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get end-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box)))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get start-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get end-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get init-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (or
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get start-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get end-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get init-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))
            (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-box)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get lane-box)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get lane-box)))]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.StructGet receiver-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get receiver-box))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get receiver-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))]
    [(AstExpr.WithRegion _ _) true]
    [(AstExpr.WithEscape scratch-box body)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get scratch-box))
        (tc-borrow-gate-exprs-relevant? ctx body))]
    [(AstExpr.WithScratch body) (tc-borrow-gate-exprs-relevant? ctx body)]
    [(AstExpr.InArena arena-box body)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get arena-box))
        (tc-borrow-gate-exprs-relevant? ctx body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (tc-borrow-gate-resource-bindings-relevant? ctx bindings 0)
            (tc-borrow-gate-exprs-relevant? ctx body))])]
    [(AstExpr.Box inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.BoxGet inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.BoxTake _) true]
    [(AstExpr.BoxSet inner-box value-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))]
    [(AstExpr.Comptime inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Quote _) false]
    [(AstExpr.Quasiquote _) false]
    [(AstExpr.Unquote _) false]
    [(AstExpr.UnquoteSplicing _) false]
    [(AstExpr.Try inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.Return value-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))]
    [(AstExpr.Break) false]
    [(AstExpr.Continue) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrNullCheck ptr-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))]
    [(AstExpr.PtrAddrOf place-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get place-box))]
    [(AstExpr.PtrRead ptr-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get offset-box)))]
    [(AstExpr.PtrCast ptr-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))]
    [(AstExpr.PtrToInt ptr-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))]
    [(AstExpr.IntToPtr value-box _)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get value-box))]
    [(AstExpr.StringData inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get ptr-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get len-box)))]
    [(AstExpr.ArrayData inner-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get inner-box))]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.CpuIdEax a-box b-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get a-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get b-box)))]
    [(AstExpr.CpuIdEbx a-box b-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get a-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get b-box)))]
    [(AstExpr.CpuIdEcx a-box b-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get a-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get b-box)))]
    [(AstExpr.CpuIdEdx a-box b-box)
      (or
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get a-box))
        (tc-borrow-gate-expr-relevant? ctx (ast-node-get b-box)))]
    [(AstExpr.Xgetbv index-box)
      (tc-borrow-gate-expr-relevant? ctx (ast-node-get index-box))]
    [(AstExpr.Syscall exprs) (tc-borrow-gate-exprs-relevant? ctx exprs)]
    [_ true]))

;; Region-typed parameters or results seed borrowed places, so the check must
;; run whenever a param or the return type mentions a region.
(define (tc-borrow-gate-params-relevant?
  [ctx : TcContext]
  [params : AstParamList]) : bool
  (let
    [i : i64 0]
    [count : i64 (ast-param-list-len (& params))]
    [found : bool false]
    (begin
      (while (and (not found) (< i count))
        (match (ast-param-list-get (& params) i (ast-param-fallback))
          [(AstParam.Param _ ty _ _)
            (if (tc-type-contains-any-region (tc-resolve-type ctx ty))
              (set! found true)
              (set! i (+ i 1)))])
        unit)
      found)))

(define (tc-borrow-check-body-irrelevant?
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]
  [body-id : i64]) : bool
  (if (tc-borrow-gate-params-relevant? ctx params)
    false
    (if (tc-type-contains-any-region (tc-resolve-type ctx ret))
      false
      (not (tc-borrow-gate-expr-relevant? ctx (ast-node-get body-id))))))

(define (tc-borrow-check-body-id-with-ret
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-id : i64]) : ResultTcUnit
  (if (tc-borrow-check-body-irrelevant? ctx params ret body-id)
    ResultTcUnit.Ok
    (tc-borrow-check-body-id ctx env params body-id)))

(define (tc-borrow-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(TcBorrowCheckResult.Ok _) ResultTcUnit.Ok]
    [(TcBorrowCheckResult.Err message) (ResultTcUnit.Err message)]))

;; --- macro expansion phase --------------------------------------------------
;;
;; Pipeline: parse -> EXPAND -> typecheck. When a call head names a `defmacro`,
;; the unevaluated operand forms are passed as `Expr` values (CompilerCtfeValue.Expr) to the
;; transformer, which is run via CTFE; the produced `Expr` is spliced at the
;; call site and re-expanded to a fixpoint (depth-limited). Macro calls in
;; ordinary evaluated positions are expanded; quoted/quasiquoted code is left
;; as data. Programs without macro calls pass through unchanged. The normal
;; typechecker then runs over the expanded program as the post-expansion safety
;; net. Call-site arity and operand signature checks run before the transformer
;; so obvious operand type errors are reported at the macro call site.
(defenum MacroMaybeDecl
  (No)
  ;; Parsed name, definition module, and dense symbol declaration ID.
  ;; Lazy surface-only macros use -1 because they have no symbol-table entry.
  (Some i64 i64 i64 AstMacroParamList AstType AstExpr))

(defstruct MacroHygieneContext
  (macro-name-id i64)
  (definition-module-id i64)
  (declaration-id i64)
  (symbols CompilerSymbols))

(defenum ResultMacroCallDecl
  (Ok MacroMaybeDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCallDeclModule
  (Ok MacroMaybeDecl String i64)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpr
  (Ok i64)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCompatCall
  (Ok i64)
  (No)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExprList
  (Ok AstExprList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroArms
  (Ok AstMatchArmList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLetBindings
  (Ok AstLetBindingList TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLetBindingsBuild
  (Ok TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroResourceBindings
  (Ok AstResourceBindingList TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroResourceBindingsBuild
  (Ok TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroEnv
  (Ok CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCheck
  (Ok)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroModuleArg
  (Ok String i64)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClause
  (Ok AstExprClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClauseList
  (Ok AstExprClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClause
  (Ok AstExprBindingClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClauseList
  (Ok AstExprBindingClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecl
  (Ok AstDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDeclExpansion
  (Ok AstDeclList AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDeclsWithPaths
  (Ok AstDeclList AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpand
  (Ok AstProgram AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

;; Plan P3 (C3.1): result of rebuilding the live symbols/registries/top-env over
;; the current program view when the decl walk forces a not-yet-materialized
;; generated module inline. Carries the freshly built context + top-env so the
;; walk can continue over the spliced body's tail in the same pass.
(defenum ResultMacroSpliceRebuild
  (Ok TcContext TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

;; A generated module is additive: its canonical declarations live in a fresh
;; module namespace and its trailing marker only imports that module into the
;; caller. Keep the already-built top env and fold those two pieces into it.
;; Arbitrary Decls splices re-resolve stale cached signatures and refresh their
;; local source tail. Freshly loaded files retain the conservative whole-program
;; rebuild because their imports can alter arbitrary module alias surfaces.
(defenum MacroSpliceEnvPlan
  (Rebuild)
  (Refresh TcTypeEnv AstDeclList AstDeclList)
  (Extend TcTypeEnv AstDeclList AstDeclList AstDeclList))

(defenum MacroMaybeGeneratedModuleExtension
  (No)
  (Some AstDeclList AstDeclList))

(defenum ResultMacroValue
  (Ok CompilerCtfeValue)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroValueEnv
  (Ok CompilerCtfeValue CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroTypeArg
  (Ok AstType)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroSexpr
  (Ok reader.SpannedSexpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroParsedDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum MacroMaybeModuleName
  (No)
  (Some String))

(defenum MacroMaybeDeclList
  (No)
  (Some AstDeclList))

(defenum MacroHygieneEnv
  (Nil)
  (Bind i64 i64 (Box MacroHygieneEnv))
  (PatternName i64 i64 (Box MacroHygieneEnv)))

(defenum MacroMaybeHygieneName
  (No)
  (Some i64))

(defenum MacroHygieneName
  (Name i64 MacroHygieneEnv))

(defenum MacroHygieneParams
  (Params AstParamList MacroHygieneEnv))

(defenum MacroHygieneLetBindings
  (LetBindings AstLetBindingList MacroHygieneEnv))

(defenum MacroHygieneResourceBindings
  (ResourceBindings AstResourceBindingList MacroHygieneEnv))

(defenum MacroHygienePattern
  (Pattern AstPattern MacroHygieneEnv))

(defenum MacroHygienePatternList
  (PatternList AstPatternList MacroHygieneEnv))

(define macro-expand-active-module : String
  "")

;; Set of macro (and compat-guard) names callable in the program. Used as a
;; cheap pre-filter in the macro-use detector so the common case (a plain
;; function call whose name is not a macro) avoids the allocating module-key
;; lookup in `macro-call-decl`. Populated once per expansion run.
(define macro-expand-macro-name-set : tc_i64_i64_map.Map
  (tc_i64_i64_map.with-capacity 128))

;; Macro names whose transformer bodies can call `expr-type`. Only those macros
;; need fixed `Expr` operands to carry produced type metadata.
(define macro-expand-expr-type-macro-names : TcStringList
  (TcStringList.Nil))

;; Cached CTFE base environment (reflection + layout metadata) for the current
;; expansion run. `macro-expand-call` rebuilt this via `tc-ctfe-env` -- which runs
;; `ctfe-reflections-from-program` over the WHOLE program (O(program)) -- on EVERY
;; macro call, costing ~150MB per call on a self-compile. Reuse it across the
;; run unless a splice materializes a reflection-relevant nominal declaration.
(define macro-expand-ctfe-env-ready : bool
  false)
(define macro-expand-ctfe-env-value : CtfeEnv
  (ctfe-env-empty))

;; Whether the cached CTFE env was built with the full reflection/layout metadata
;; (plan P2). The cache is built once per expansion run and reused across every
;; in-pass splice rebuild, but a run whose first build did not need metadata
;; caches an empty env; a later rebuild that does need metadata must not reuse
;; that empty env. Guarded by macro-expand-ctfe-env-build-once!.
(define macro-expand-ctfe-env-has-metadata : bool
  false)

(define (compiler-typecheck-ctfe-env-cache-clear!) : unit
  (begin
    (set! macro-expand-ctfe-env-ready false)
    (set! macro-expand-ctfe-env-has-metadata false)
    (set! macro-expand-ctfe-env-value (ctfe-env-empty))))

;; Additively extend the cached CTFE metadata with a spliced generated module's
;; nominal declarations, avoiding the O(program) reflection/layout rebuild that
;; compiler-typecheck-ctfe-env-cache-clear! forces on the next consumer. Only
;; valid for an isolated generated-module splice: its names are fresh in their
;; own namespace, so appending after the already-cached entries preserves the
;; first-wins dedupe order a whole-program rebuild would produce. ctx must be
;; the post-splice context whose registries already cover the spliced decls
;; (the layout build resolves struct/enum layouts through them), and
;; module/module-id the namespace active at the splice site, matching the
;; module context a whole-program rebuild would attribute to any decl preceding
;; the module's own marker. Returns false when the cache cannot be extended --
;; not built yet, built without metadata while metadata is now required, or the
;; reserved list capacity exhausted -- so the caller can fall back to the
;; conservative clear.
(define (compiler-typecheck-ctfe-env-extend-for-splice!
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [module-id : i64]) : bool
  (if (not ctfe-needs-metadata)
    true
    (if (and macro-expand-ctfe-env-ready macro-expand-ctfe-env-has-metadata)
      (let
        [layouts : CtfeLayoutInfoList
          (ctfe-env-layouts macro-expand-ctfe-env-value)]
        [reflections : CtfeReflectInfoList
          (ctfe-env-reflections macro-expand-ctfe-env-value)]
        [needed : i64 (ctfe-metadata-decl-capacity decls)]
        (if (and
          (<=
            (+ (struct-get layouts len) needed)
            (array.length (struct-get layouts slots)))
          (<=
            (+ (struct-get reflections len) needed)
            (array.length (struct-get reflections slots))))
          (let
            [next-layouts : CtfeLayoutInfoList
              (tc-ctfe-layouts-from-decls ctx decls module module-id layouts)]
            [next-reflections : CtfeReflectInfoList
              (ctfe-reflections-from-decls decls module module-id reflections)]
            ;; The cached base env is always a bare metadata node (built by
            ;; tc-ctfe-env and only ever rebase-copied), so rebuilding it from
            ;; the extended lists drops no bindings.
            (begin
              (set!
                macro-expand-ctfe-env-value
                (ctfe-env-with-metadata-and-pools
                  next-layouts
                  next-reflections
                  (ctfe-env-pools macro-expand-ctfe-env-value)))
              true))
          false))
      false)))

;; Build the CTFE base env (reflection + layout metadata) once per expansion run
;; and reuse it across in-pass splice rebuilds (plan P2). A generated module can
;; materialize a struct or enum whose own metadata is immediately queried by a
;; later macro, so reflection-relevant splices clear the cache before calling this
;; helper. The one other exception is a run whose first build did not need
;; metadata (empty env) and a later rebuild that does; the has-metadata guard
;; rebuilds for that case. On reuse the cached env is only rebased onto the active
;; pools (cheap); a full build otherwise costs ~150MB.
(define (macro-expand-ctfe-env-build-once! [ctx : TcContext]) : unit
  (let
    [reuse? : bool
      (and
        macro-expand-ctfe-env-ready
        (or (not ctfe-needs-metadata) macro-expand-ctfe-env-has-metadata))]
    (begin
      (if reuse?
        unit
        (set! macro-expand-ctfe-env-ready false))
      (set! macro-expand-ctfe-env-value (tc-ctfe-env ctx))
      (if reuse?
        unit
        (set! macro-expand-ctfe-env-has-metadata ctfe-needs-metadata))
      (set! macro-expand-ctfe-env-ready true))))

;; Live compiler symbols/registries reused across the expansion run (plan P2).
;; build-compiler-symbols-with-paths / build-compiler-registries-with-symbols each
;; walk the whole program (O(program)). Built at pass setup and rebuilt whenever
;; the decl walk forces a splice inline (macro-live-symbols-fallback, set via
;; macro-live-symbols-invalidate!), the conservative slow path for
;; arbitrary/shadowing splices and freshly loaded generated file imports.
(define macro-live-symbols-ready : bool
  false)
(define macro-live-symbols-value : CompilerSymbols
  (compiler-symbols-empty))
(define macro-live-registries-value : CompilerRegistries
  (compiler-registries-empty))
(define macro-live-symbols-fallback : bool
  false)
(define macro-live-registries-ready : bool
  false)
(define macro-live-registries-fallback : bool
  true)

;; Whole-program symbol/registry rebuilds replace the previous tables, but the
;; ordinary compile arena retains every obsolete generation until process exit.
;; Keep those tables in one independently owned arena so a successful rebuild
;; can retire its predecessor without putting the longer-lived macro output or
;; top environments in the same lifetime domain.
(define macro-live-symbols-arena : i64
  0)
(define macro-live-symbols-retired-arena : i64
  0)

(define (macro-live-symbols-reset!) : unit
  (begin
    (set! macro-live-symbols-ready false)
    (set! macro-live-symbols-fallback false)
    (set! macro-live-registries-ready false)
    (set! macro-live-registries-fallback true)))

(define (macro-live-symbols-clear!) : unit
  (let
    [current : i64 macro-live-symbols-arena]
    [retired : i64 macro-live-symbols-retired-arena]
    (begin
      (set! macro-live-symbols-ready false)
      (set! macro-live-symbols-fallback false)
      (set! macro-live-registries-ready false)
      (set! macro-live-registries-fallback true)
      (set! macro-live-symbols-value (compiler-symbols-empty))
      (set! macro-live-registries-value (compiler-registries-empty))
      ;; The completed expansion no longer has a consumer for either retained
      ;; generation. Release both here instead of carrying their raw handles
      ;; into the next independent typecheck entry.
      (set! macro-live-symbols-arena 0)
      (set! macro-live-symbols-retired-arena 0)
      (if (= current 0)
        unit
        (unsafe
          (arena.tl_arena_destroy current)))
      (if (or (= retired 0) (= retired current))
        unit
        (unsafe
          (arena.tl_arena_destroy retired))))))

;; Force the next pass to rebuild the live symbols/registries. Called from the
;; decl walk's non-inert splice arm: an arbitrary (potentially shadowing) splice
;; may have introduced a name the reused symbols would resolve differently, so
;; drop the reuse conservatively.
(define (macro-live-symbols-invalidate!) : unit
  (set! macro-live-symbols-fallback true))

(define (macro-live-registries-invalidate!) : unit
  (set! macro-live-registries-fallback true))

;; A direct generated declaration splice is safe to rebase when it has only a
;; positional registry effect. Imports can add aliases and macro definitions
;; change the hoisted macro namespace, so both retain the full-rebuild path.
;; Keep this an explicit whitelist: a future declaration form must opt in only
;; after proving that registry remapping preserves its semantics.
(define (macro-decl-registry-incremental-safe? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta _ _ _) true]
    [(AstDecl.DefFn decl-meta _ _ _ _ _) true]
    [(AstDecl.Extern decl-meta _ _ _ _) true]
    [(AstDecl.DefEnum decl-meta _ _ _) true]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ _ _) true]
    [(AstDecl.DefStruct decl-meta _ _ _ _) true]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(AstDecl.DefDispatch decl-meta _ _) true]
    [(AstDecl.Test _ _ _) true]
    [(AstDecl.Import decl-meta _) false]
    [(AstDecl.IncludeStr _ _) false]
    [(AstDecl.IncludeStrComptime _ _) false]
    [(AstDecl.IncludeStrLzss _ _) false]
    [(AstDecl.IncludeBin _ _) false]
    [(AstDecl.DefMacro decl-meta _ _ _ _) false]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-registry-incremental-safe? (box-get inner-box))]
    [_ false]))

(define (macro-decls-registry-incremental-safe? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) true]
    [(AstDeclListStep.Cons decl rest)
      (and
        (macro-decl-registry-incremental-safe? decl)
        (macro-decls-registry-incremental-safe? rest))]))

;; An existing unqualified import aliases every nominal member of its target
;; module. If a generated splice adds a member to that target, repairing only
;; direct registry entries would leave the import alias stale, so retain the
;; established whole-registry rebuild in that case.
(define (macro-decl-has-unqualified-import-of-module?
  [decl : AstDecl]
  [module-id : i64]) : bool
  (match decl
    [(AstDecl.Import
        decl-meta
        (AstImportSpec.Spec
          _
          _
          (AstMaybeModuleName.Some target-module)
          (AstMaybeImportAlias.Some alias)
          _))
      (and
        (= target-module module-id)
        (= alias cbi.compiler-builtin-id-fix-empty))]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-has-unqualified-import-of-module?
        (box-get inner-box)
        module-id)]
    [(AstDecl.ModuleBody _ body-box)
      (macro-decls-have-unqualified-import-of-module?
        (box-get body-box)
        module-id)]
    [_ false]))

(define (macro-decls-have-unqualified-import-of-module?
  [decls : AstDeclList]
  [module-id : i64]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-has-unqualified-import-of-module? decl module-id)
        (macro-decls-have-unqualified-import-of-module? rest module-id))]))

;; Rebase the cached registry across an additive generated splice before the
;; fresh symbol build. The symbol table still rebuilds to preserve all ordinary
;; duplicate/shadowing diagnostics; this path only avoids rewalking unrelated
;; enum/struct registry entries. On any incremental registry error, retain the
;; conservative full rebuild so its established diagnostic behavior wins.
(define (macro-live-registries-insert-decls!
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [insertion-index : i64]
  [module-id : i64]) : bool
  (match (compiler-registries-insert-decls
    macro-live-registries-value
    decls
    paths
    insertion-index
    module-id)
    [(ResultCompilerRegistries.Ok registries)
      (begin
        (set! macro-live-registries-value registries)
        (set! macro-live-registries-ready true)
        (set! macro-live-registries-fallback false)
        true)]
    [(ResultCompilerRegistries.Err _) false]))

;; Return the live symbols (building both symbols and registries on demand),
;; reusing the cached pair across passes unless a rebuild was requested. Errors
;; from a fresh build propagate as ResultCompilerSymbols.Err; the registries are
;; read back from macro-live-registries-value by the caller.
(define (macro-live-registries-build-current
  [program : AstProgram]
  [symbols : CompilerSymbols]) : ResultCompilerRegistries
  (if (and macro-live-registries-ready (not macro-live-registries-fallback))
    (begin
      (cfg compile-profile (compiler-tc-macro-profile-note-live-registry-reuse))
      (ResultCompilerRegistries.Ok macro-live-registries-value))
    (begin
      (cfg
        compile-profile
        (compiler-tc-macro-profile-note-live-registry-rebuild))
      (match (build-compiler-registries-with-symbols program symbols)
        [(ResultCompilerRegistries.Ok registries)
          (begin
            (set! macro-live-registries-value registries)
            (set! macro-live-registries-ready true)
            (set! macro-live-registries-fallback false)
            (ResultCompilerRegistries.Ok macro-live-registries-value))]
        [(ResultCompilerRegistries.Err message)
          (ResultCompilerRegistries.Err message)]))))

(define (macro-live-symbols-build-fresh-current
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerSymbols
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-note-live-rebuild))
    (match (build-compiler-symbols-diagnostic-with-paths program paths)
      [(ResultCompilerSymbolsDiagnostic.Ok symbols)
        (match (macro-live-registries-build-current program symbols)
          [(ResultCompilerRegistries.Ok registries)
            (begin
              (set! macro-live-symbols-value symbols)
              (set! macro-live-registries-value registries)
              (set! macro-live-symbols-ready true)
              (set! macro-live-symbols-fallback false)
              (ResultCompilerSymbols.Ok macro-live-symbols-value))]
          [(ResultCompilerRegistries.Err message)
            (ResultCompilerSymbols.Err message)])]
      [(ResultCompilerSymbolsDiagnostic.Err diag)
        (ResultCompilerSymbols.Err (compiler-diagnostic-message (box-get diag)))])))

(define (macro-live-symbols-build-fresh
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerSymbols
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [next-arena : i64 (arena.tl_arena_make)]
    [_switch : unit
      (unsafe
        (arena.tl_arena_set next-arena))]
    ;; A reused registry can still point into the previous symbols arena. Keep
    ;; the generation self-contained so retiring it cannot strand those maps.
    [_rebuild-registries : unit (set! macro-live-registries-fallback true)]
    [built : ResultCompilerSymbols
      (macro-live-symbols-build-fresh-current program paths)]
    [next-head : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set enclosing))
      (match built
        [(ResultCompilerSymbols.Ok symbols)
          (let
            [previous : i64 macro-live-symbols-arena]
            [retired : i64 macro-live-symbols-retired-arena]
            (begin
              (set! macro-live-symbols-arena next-head)
              (set! macro-live-symbols-retired-arena previous)
              (macro-expand-allocation-profile-snapshot! retired)
              (if (= retired 0)
                unit
                (unsafe
                  (arena.tl_arena_destroy retired)))
              (ResultCompilerSymbols.Ok symbols)))]
        [(ResultCompilerSymbols.Err message)
          ;; Preserve the public error after releasing the failed generation.
          (let
            [stable-message : String (string.copy (& message))]
            (begin
              (unsafe
                (arena.tl_arena_destroy next-head))
              (ResultCompilerSymbols.Err stable-message)))]))))

(define (macro-live-symbols-build-or-reuse!
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerSymbols
  (if (and macro-live-symbols-ready (not macro-live-symbols-fallback))
    (begin
      (cfg compile-profile (compiler-tc-macro-profile-note-live-reuse))
      (ResultCompilerSymbols.Ok macro-live-symbols-value))
    (macro-live-symbols-build-fresh program paths)))

;; Hoisted whole-program macro prescans. macro-program-has-defmacro?,
;; macro-collect-expr-type-macro-names, macro-program-needs-expansion?,
;; macro-program-has-summary-macro-import? and macro-collect-visible-macro-names
;; each walk the whole program. They are computed once per expansion run under
;; the additive-inert condition: generated splices add module decls in their own
;; namespace but no new defmacros/macro names, so the prescan results are stable
;; across the walk. The one exception is a generated file import loading new
;; declarations mid-walk -- the walk recomputes the prescan there (via
;; macro-live-symbols-invalidate! + macro-live-prescan-ensure!), matching the
;; symbols cache lifecycle.
(define macro-live-prescan-ready : bool
  false)
(define macro-live-prescan-has-defmacro : bool
  false)
(define macro-live-prescan-expr-type-names : TcStringList
  (TcStringList.Nil))
(define macro-live-prescan-needs-expansion : bool
  false)
(define macro-live-prescan-summary-import : bool
  false)
(define macro-live-prescan-visible-names : TcNameIdList
  (TcNameIdList.Nil))

(define (macro-live-prescan-reset!) : unit
  (set! macro-live-prescan-ready false))

(define (macro-live-prescan-ensure-current! [decls : AstDeclList]) : unit
  (let
    [has-defmacro : bool (macro-program-has-defmacro? decls)]
    [needs-expansion : bool (macro-program-needs-expansion? decls)]
    (begin
      (set! macro-live-prescan-has-defmacro has-defmacro)
      (set!
        macro-live-prescan-expr-type-names
        (if has-defmacro
          (macro-collect-expr-type-macro-names decls)
          (TcStringList.Nil)))
      (set! macro-live-prescan-needs-expansion needs-expansion)
      (set!
        macro-live-prescan-summary-import
        (and
          (not has-defmacro)
          (not needs-expansion)
          (macro-program-has-summary-macro-import? decls)))
      ;; The ctfe-module-macro-export map is populated as a side effect of
      ;; macro-collect-visible-macro-names (via the ID-keyed export map).
      ;; Since that walk runs once per program (cached with this prescan),
      ;; the export map is reset here -- immediately before it is repopulated --
      ;; and left intact while the prescan is reused across the walk.
      ;; Resetting it more often would clear the once-collected exports and
      ;; leave the map empty after the collection ran, breaking module-hook /
      ;; module-export-macro?. The export set is additive-inert (generated
      ;; splices add no new defmacros), so it is stable across the walk, exactly
      ;; like macro-live-prescan-visible-names; recomputed together on the
      ;; non-inert splice fallback (macro-live-symbols-fallback).
      (ctfe-module-macro-export-reset!)
      (set!
        macro-live-prescan-visible-names
        (macro-collect-visible-macro-names decls))
      (set! macro-live-prescan-ready true))))

(define (macro-live-prescan-ensure-fresh! [decls : AstDeclList]) : unit
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (macro-live-prescan-ensure-current! decls)
        (set! macro-expand-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))))
    (macro-live-prescan-ensure-current! decls)))

(define (macro-live-prescan-ensure! [decls : AstDeclList]) : unit
  (if (and macro-live-prescan-ready (not macro-live-symbols-fallback))
    unit
    (macro-live-prescan-ensure-fresh! decls)))

;; Whether the current compile needs the CTFE reflection/layout metadata at all
;; (i.e. the program contains a `(type T)` literal). Set per compile at the top of
;; macro-expand-program; when false, tc-ctfe-env returns an empty env and skips
;; the whole-program metadata build. Defaults true (build) for safety.
(define ctfe-needs-metadata : bool
  true)

;; Macro expansion builds whole-program symbols, registries, top-env spines,
;; prescan lists, and splice-rebuild contexts that are dead once the final
;; expanded program has been produced. Keep that compiler-only state in a
;; scratch arena so it can be released at the macro/typecheck boundary while
;; final AST nodes and the CTFE env stay in their existing owners.
(define macro-expand-scratch-enabled : bool
  false)
(define macro-expand-scratch-arena : i64
  0)

(define (macro-expand-scratch-begin!) : unit
  (set! macro-expand-scratch-enabled true))

(define (macro-expand-scratch-arena-get) : i64
  (if (= macro-expand-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! macro-expand-scratch-arena scratch)
        scratch))
    macro-expand-scratch-arena))

;; Emit the dominant macro-expansion owners at the last boundary where all of
;; them are simultaneously live. The control query makes this a single cold
;; branch when profiling is disabled; allocator hot paths remain untouched.
(define (macro-expand-allocation-profile-snapshot! [reclaiming-symbols : i64]) : unit
  (if (= (allocation_profile.compiler-allocation-profile-control! 0 "" "" 0) 0)
    unit
    (begin
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-enclosing"
        (arena.tl_arena_current))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-scratch"
        macro-expand-scratch-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-current"
        macro-live-symbols-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-retired"
        macro-live-symbols-retired-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-symbols-reclaiming"
        reclaiming-symbols)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "macro-hygiene-cache"
        tc-hygiene-module-env-cache-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-function-scratch"
        tc-fn-scratch-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-body-facts"
        tc-body-type-fact-storage-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-prefix-cache"
        tc-prefix-snapshot-cache-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-module-index"
        tc-module-decl-index-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "typecheck-clone-roots"
        tc-clone-root-collection-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "compiler-entry"
        (allocation_profile.compiler-allocation-profile-entry-arena-handle))
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "source-pools"
        node-pool-base-arena)
      (allocation_profile.compiler-allocation-profile-control!
        2
        "typecheck.macro.peak"
        "intern-persistent"
        (intern-persistent-arena-handle))
      unit)))

(define (macro-expand-scratch-clear-owned-caches!) : unit
  (begin
    (set! macro-expand-active-module "")
    (macro-expand-set-macro-names! (TcNameIdList.Nil))
    (set! macro-expand-expr-type-macro-names (TcStringList.Nil))
    (macro-live-symbols-clear!)
    (macro-live-prescan-reset!)
    (set! macro-live-prescan-has-defmacro false)
    (set! macro-live-prescan-expr-type-names (TcStringList.Nil))
    (set! macro-live-prescan-needs-expansion false)
    (set! macro-live-prescan-summary-import false)
    (set! macro-live-prescan-visible-names (TcNameIdList.Nil))
    (ctfe-module-macro-export-reset!)
    (macro-generated-module-memo-reset!)
    (macro-generated-decls-memo-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-nominal-owner-cache-reset!)
    (macro-alias-derived-cache-reset!)
    (set! tc-hygiene-active-top-env-ready false)
    (set! tc-hygiene-active-top-env (tc-empty-type-env))
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (if (= (arena.tl_arena_current) tc-hygiene-module-env-cache-arena)
          (unsafe
            (arena.tl_arena_set node-pool-base-arena))
          unit)
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))))

(define (macro-expand-scratch-release!) : unit
  (if (= macro-expand-scratch-arena 0)
    (set! macro-expand-scratch-enabled false)
    (let
      [scratch : i64 macro-expand-scratch-arena]
      [current : i64 (arena.tl_arena_current)]
      [home : i64
        (if (= current scratch)
          node-pool-base-arena
          current)]
      (begin
        (unsafe
          (arena.tl_arena_set home))
        (set! macro-expand-scratch-enabled false)
        (set! macro-expand-scratch-arena 0)
        (macro-expand-scratch-clear-owned-caches!)
        ;; Macro timing entries were emitted before this boundary and live in
        ;; scratch. Clear the global before destroying their backing storage so
        ;; a later lowering-time declaration macro starts from a valid list.
        (cfg compile-profile (compiler-tc-macro-profile-clear))
        ;; Cache clearing can release independently owned arenas. Start the
        ;; scratch counter after that work so this phase attributes only the
        ;; arena named by macro_scratch_release.
        (cfg compile-profile (compiler-tc-profile-start))
        (unsafe
          (arena.tl_arena_destroy scratch))
        (cfg
          compile-profile
          (compiler-tc-profile-finish "macro_scratch_release"))))))

(define (macro-zero-source-span) : token.SourceSpan
  (token.SourceSpan 1 1 1 1))

(define (macro-source-span-from-ast [span : AstSourceSpan]) : token.SourceSpan
  (token.SourceSpan
    (ast-source-span-start-line span)
    (ast-source-span-start-col span)
    (ast-source-span-end-line span)
    (ast-source-span-end-col span)))

(define (macro-output-syntax-diag [origin : AstExpr] [message : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr origin message))

(define (macro-output-syntax-name [name : String]) : String
  (if (tc-hygiene-template-name? name)
    (tc-hygiene-template-base name)
    name))

(define (macro-output-syntax-id-at [name-id : i64] [site : String]) : i64
  (cond
    [(ci.intern-template-source-id? name-id)
      (ci.intern-template-source-name-id name-id)]
    [(ci.intern-structural-local-id? name-id)
      (ci.intern-structural-local-source-name-id name-id)]
    [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
      (macro-hygiene-structural-source-name-id name-id)]
    [(or
        (compiler-composite-pair-key-id? name-id)
        (compiler-composite-triple-key-id? name-id))
      name-id]
    [else
      (let
        [name : String (macro-output-symbol-text-id name-id site)]
        (if (tc-hygiene-template-name? name)
          (let
            [source-id : i64 (tc-hygiene-template-source-id-or name-id -1)]
            (if (>= source-id 0)
              source-id
              (io.panic
                (string.append
                  "macro template symbol missing source id at "
                  site))))
          name-id))]))

(define (macro-output-symbol-text-id [name-id : i64] [site : String]) : String
  (cond
    [(= name-id (ctfe-internal-resolved-struct-type-marker-id))
      (macro-internal-resolved-struct-type-marker)]
    [(= name-id (ctfe-internal-resolved-enum-type-marker-id))
      (macro-internal-resolved-enum-type-marker)]
    [(tc-structural-local-name-id? name-id) (tc-hygiene-name-text-id name-id)]
    [(macro-hygiene-global-id? name-id)
      (intern-str (macro-hygiene-structural-source-name-id name-id))]
    [(ci.intern-template-source-id? name-id)
      (intern-str (ci.intern-template-source-name-id name-id))]
    [(or
        (compiler-composite-pair-key-id? name-id)
        (compiler-composite-triple-key-id? name-id))
      (ast-nominal-name-id-display name-id)]
    [(and (>= name-id 0) (< name-id (intern-capacity))) (intern-str name-id)]
    [else
      (io.panic
        (string.append
          "macro output received structural id at "
          (string.append site (string.append ": " (string.int->string name-id)))))]))

;; id-taking variant: callers have the interned name id; avoids the (intern
;; source-name) the String variant does inside tc-source-slash-qualified?.
(define (macro-output-source-name-id-at [name-id : i64] [site : String]) : String
  (let
    [name : String (macro-output-symbol-text-id name-id site)]
    [source-name : String
      (if (tc-hygiene-template-name? name)
        (tc-hygiene-template-base name)
        (tc-hygiene-global-symbol-name name))]
    [source-name-id : i64 (macro-output-syntax-id-at name-id site)]
    (if (tc-source-slash-qualified-id? source-name source-name-id)
      (tc-name-slashes-to-dots source-name)
      source-name)))

(define (macro-output-source-name-id [name-id : i64]) : String
  (macro-output-source-name-id-at name-id "source-name"))

(define (macro-output-source-identity-id-at [name-id : i64] [site : String]) : i64
  (cond
    [(or
        (macro-hygiene-global-id? name-id)
        (tc-structural-local-name-id? name-id))
      name-id]
    [(ci.intern-template-source-id? name-id)
      (ci.intern-template-source-name-id name-id)]
    [(or
        (compiler-composite-pair-key-id? name-id)
        (compiler-composite-triple-key-id? name-id))
      name-id]
    [else
      (compiler-symbol-name-id-key (macro-output-syntax-id-at name-id site))]))

(define (macro-decl-list-reverse-into [items : AstDeclList] [out : AstDeclList]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& items))]
    [index : i64 0]
    [result : AstDeclList out]
    (begin
      (while (< index count)
        (begin
          (set!
            result
            (ast-decl-list-prepend-builder
              (ast-decl-list-ref items index)
              result))
          (set! index (+ index 1))))
      result)))

(define (macro-decl-list-reverse [items : AstDeclList]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& items))]
    [index : i64 count]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    (begin
      (while (> index 0)
        (begin
          (set! index (- index 1))
          (ast-decl-list-push (&mut out) (ast-decl-list-ref items index))))
      out)))

(define (macro-decl-list-with-prefix-reserve
  [items : AstDeclList]
  [reserve : i64]) : AstDeclList
  (if (and
    (>= (struct-get items offset) reserve)
    (struct-get items prependable))
    items
    (let
      [count : i64 (ast-decl-list-len (& items))]
      [slots : (Array AstDecl) (array.make-array AstDecl (+ reserve count))]
      (begin
        (ast-decl-list-copy-to
          (&mut slots)
          (& (struct-get items slots))
          (struct-get items offset)
          reserve
          0
          count)
        (AstDeclList slots reserve count true)))))

(define (macro-decl-list-append-from
  [out : (&mut out AstDeclList)]
  [items : (& items AstDeclList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast-decl-list-len items)]
    (while (< index count)
      (begin
        (ast-decl-list-push
          out
          (ast-decl-list-get items index (ast-decl-fallback)))
        (set! index (+ index 1))))))

(define (macro-decl-list-append [left : AstDeclList] [right : AstDeclList]) : AstDeclList
  (let
    [left-len : i64 (ast-decl-list-len (& left))]
    [right-len : i64 (ast-decl-list-len (& right))]
    (if (and
      (<= left-len (struct-get right offset))
      (struct-get right prependable)
      (not
        (unsafe
          (=
            (ptr->int
              (ptr-cast (array-data (struct-get left slots)) : (Ptr u8)))
            (ptr->int
              (ptr-cast (array-data (struct-get right slots)) : (Ptr u8)))))))
      (let
        [new-offset : i64 (- (struct-get right offset) left-len)]
        (begin
          ;; Macro expansion walks a suffix of the current whole-program vector.
          ;; Its consumed prefix is dead after the splice context is rebuilt, so
          ;; reconstruct the next view in that headroom instead of retaining a
          ;; fresh whole-program copy for every splice. Distinct backing storage
          ;; is required because the left copy may otherwise overlap the writes.
          (ast-decl-list-copy-to
            (&mut (struct-get right slots))
            (& (struct-get left slots))
            (struct-get left offset)
            new-offset
            0
            left-len)
          (AstDeclList
            (struct-get right slots)
            new-offset
            (+ left-len right-len)
            true)))
      (let
        [out : AstDeclList (ast-decl-list-with-capacity (+ left-len right-len))]
        (begin
          (macro-decl-list-append-from (&mut out) (& left))
          (macro-decl-list-append-from (&mut out) (& right))
          out)))))

(define (macro-flatten-module-body-decls-into-with-origins
  [decls : AstDeclList]
  [module-id : i64]
  [out : AstDeclList]
  [out-origins : (&mut out-origins CompilerParseDeclOriginAliasVec)]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [current-module-id : i64 module-id]
    [result : AstDeclList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (ast-decl-list-push (&mut result) decl)
                    (compiler-parse-decl-origin-alias-vec-push-key-slot!
                      out-origins
                      (- (ast-decl-list-len (& result)) 1)
                      1
                      (compiler-parse-decl-list-storage-key (& rest))
                      (- (struct-get rest offset) 1)
                      decl
                      false)
                    (set! current-module-id next-module))]
                [(AstDecl.ModuleBody target-module-id body-box)
                  (begin
                    (ast-decl-list-push
                      (&mut result)
                      (ast-decl-module-id target-module-id))
                    (compiler-parse-decl-origin-alias-vec-push-key-slot!
                      out-origins
                      (- (ast-decl-list-len (& result)) 1)
                      1
                      (compiler-parse-decl-list-storage-key (& rest))
                      (- (struct-get rest offset) 1)
                      decl
                      false)
                    (set!
                      result
                      (macro-flatten-module-body-decls-into-with-origins
                        (box-get body-box)
                        target-module-id
                        result
                        out-origins))
                    (ast-decl-list-push
                      (&mut result)
                      (ast-decl-module-id current-module-id))
                    (compiler-parse-decl-origin-alias-vec-push-key-slot!
                      out-origins
                      (- (ast-decl-list-len (& result)) 1)
                      1
                      (compiler-parse-decl-list-storage-key (& rest))
                      (- (struct-get rest offset) 1)
                      decl
                      false))]
                [_
                  (begin
                    (ast-decl-list-push (&mut result) decl)
                    (compiler-parse-decl-origin-alias-vec-push-key-slot!
                      out-origins
                      (- (ast-decl-list-len (& result)) 1)
                      1
                      (compiler-parse-decl-list-storage-key (& rest))
                      (- (struct-get rest offset) 1)
                      decl
                      false))])
              (set! cursor rest))]))
      result)))

(define (macro-flatten-module-body-decls-into
  [decls : AstDeclList]
  [module-id : i64]
  [out : AstDeclList]) : AstDeclList
  (let
    [out-origins : CompilerParseDeclOriginAliasVec
      (compiler-parse-decl-origin-alias-vec-with-capacity
        (ast-decl-list-len (& decls)))]
    [result : AstDeclList
      (macro-flatten-module-body-decls-into-with-origins
        decls
        module-id
        out
        (&mut out-origins))]
    (begin
      (compiler-parse-decl-origin-alias-vec-register!
        (& result)
        (& out-origins))
      result)))

(define (macro-flatten-module-body-decls-in-module
  [decls : AstDeclList]
  [module-id : i64]) : AstDeclList
  (macro-flatten-module-body-decls-into decls module-id (ast-decl-list-new)))

(define (macro-decl-path-list-reverse-into
  [items : AstDeclPathList]
  [out : AstDeclPathList]) : AstDeclPathList
  (let
    [cursor : AstDeclPathList items]
    [result : AstDeclPathList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-path-list-step cursor)
          [(AstDeclPathListStep.Nil) (set! done true)]
          [(AstDeclPathListStep.Cons head rest)
            (begin
              (set!
                result
                (ast-decl-path-list-prepend-builder-with-owner-id
                  head
                  (ast-decl-path-list-owner-id
                    (& cursor)
                    0
                    cbi.compiler-builtin-id-fix-empty)
                  result))
              (set! cursor rest))]))
      result)))

(define (macro-decl-path-list-reverse [items : AstDeclPathList]) : AstDeclPathList
  (let
    [count : i64 (ast-decl-path-list-len (& items))]
    [index : i64 count]
    [out : AstDeclPathList (ast-decl-path-list-with-capacity count)]
    (begin
      (while (> index 0)
        (begin
          (set! index (- index 1))
          (ast-decl-path-list-push-with-owner-id
            (&mut out)
            (ast-decl-path-list-get (& items) index "")
            (ast-decl-path-list-owner-id
              (& items)
              index
              cbi.compiler-builtin-id-fix-empty))))
      out)))

(define (macro-decl-path-list-with-prefix-reserve
  [items : AstDeclPathList]
  [reserve : i64]) : AstDeclPathList
  (if (and
    (>= (struct-get items offset) reserve)
    (struct-get items prependable))
    items
    (let
      [count : i64 (ast-decl-path-list-len (& items))]
      [slots : (Array String) (array.make-array String (+ reserve count))]
      [owner-ids : (Array i64) (array.make-array i64 (+ reserve count))]
      (begin
        (ast-decl-path-list-copy-to
          (&mut slots)
          (& (struct-get items slots))
          (struct-get items offset)
          reserve
          0
          count)
        (ast-decl-module-list-copy-to
          (&mut owner-ids)
          (& (struct-get items owner-ids))
          (struct-get items offset)
          reserve
          0
          count)
        (AstDeclPathList slots owner-ids reserve count true)))))

(define (macro-decl-path-list-append-from
  [out : (&mut out AstDeclPathList)]
  [items : (& items AstDeclPathList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast-decl-path-list-len items)]
    (while (< index count)
      (begin
        (ast-decl-path-list-push-with-owner-id
          out
          (ast-decl-path-list-get items index "")
          (ast-decl-path-list-owner-id
            items
            index
            cbi.compiler-builtin-id-fix-empty))
        (set! index (+ index 1))))))

(define (macro-decl-path-list-append
  [left : AstDeclPathList]
  [right : AstDeclPathList]) : AstDeclPathList
  (let
    [left-len : i64 (ast-decl-path-list-len (& left))]
    [right-len : i64 (ast-decl-path-list-len (& right))]
    (if (and
      (<= left-len (struct-get right offset))
      (struct-get right prependable)
      (not
        (unsafe
          (=
            (ptr->int
              (ptr-cast (array-data (struct-get left slots)) : (Ptr u8)))
            (ptr->int
              (ptr-cast (array-data (struct-get right slots)) : (Ptr u8)))))))
      (let
        [new-offset : i64 (- (struct-get right offset) left-len)]
        (begin
          (ast-decl-path-list-copy-to
            (&mut (struct-get right slots))
            (& (struct-get left slots))
            (struct-get left offset)
            new-offset
            0
            left-len)
          (ast-decl-module-list-copy-to
            (&mut (struct-get right owner-ids))
            (& (struct-get left owner-ids))
            (struct-get left offset)
            new-offset
            0
            left-len)
          (AstDeclPathList
            (struct-get right slots)
            (struct-get right owner-ids)
            new-offset
            (+ left-len right-len)
            true)))
      (let
        [out : AstDeclPathList
          (ast-decl-path-list-with-capacity (+ left-len right-len))]
        (begin
          (macro-decl-path-list-append-from (&mut out) (& left))
          (macro-decl-path-list-append-from (&mut out) (& right))
          out)))))

(cfg
  test
  (define (macro-decl-list-slots-address [items : AstDeclList]) : i64
    (unsafe
      (cast
        (ptr->int (ptr-cast (array-data (struct-get items slots)) : (Ptr u8)))
        : i64))))

(cfg
  test
  (define (macro-decl-path-list-slots-address [items : AstDeclPathList]) : i64
    (unsafe
      (cast
        (ptr->int (ptr-cast (array-data (struct-get items slots)) : (Ptr u8)))
        : i64))))

(cfg
  test
  (define (macro-decl-module-eq? [decl : AstDecl] [wanted : i64]) : bool
    (match decl
      [(AstDecl.Module name) (= name wanted)]
      [_ false])))

(cfg
  test
  (define (macro-decl-list-append-headroom-smoke?) : bool
    (let
      [left-id : i64 (ci.intern-generated-name "left")]
      [right-a-id : i64 (ci.intern-generated-name "right-a")]
      [right-b-id : i64 (ci.intern-generated-name "right-b")]
      [alias-id : i64 (ci.intern-generated-name "alias")]
      [prefix-a-id : i64 (ci.intern-generated-name "prefix-a")]
      [prefix-b-id : i64 (ci.intern-generated-name "prefix-b")]
      [left : AstDeclList (ast-decl-list-with-capacity 1)]
      [_left : unit (ast-decl-list-push (&mut left) (AstDecl.Module left-id))]
      [right-base : AstDeclList (ast-decl-list-new)]
      [right-tail : AstDeclList
        (ast-decl-list-prepend-builder (AstDecl.Module right-b-id) right-base)]
      [right : AstDeclList
        (ast-decl-list-prepend-builder (AstDecl.Module right-a-id) right-tail)]
      [right-address : i64 (macro-decl-list-slots-address right)]
      [reused : AstDeclList (macro-decl-list-append left right)]
      [alias-left : AstDeclList
        (begin
          (array-set! (struct-get right slots) 0 (AstDecl.Module alias-id))
          (AstDeclList (struct-get right slots) 0 1 false))]
      [copied : AstDeclList (macro-decl-list-append alias-left right)]
      [reserved : AstDeclList (macro-decl-list-with-prefix-reserve right 8)]
      [reserved-address : i64 (macro-decl-list-slots-address reserved)]
      [prefix-base : AstDeclList (ast-decl-list-new)]
      [prefix-tail : AstDeclList
        (ast-decl-list-prepend-builder (AstDecl.Module prefix-a-id) prefix-base)]
      [prefix-rev : AstDeclList
        (ast-decl-list-prepend-builder (AstDecl.Module prefix-b-id) prefix-tail)]
      [prefixed : AstDeclList
        (macro-decl-list-prefix-rev-current-suffix prefix-rev reserved)]
      (and
        (= (macro-decl-list-slots-address reused) right-address)
        (= (struct-get reused offset) 1)
        (= (ast-decl-list-len (& reused)) 3)
        (macro-decl-module-eq? (ast-decl-list-ref reused 0) left-id)
        (macro-decl-module-eq? (ast-decl-list-ref reused 1) right-a-id)
        (macro-decl-module-eq? (ast-decl-list-ref reused 2) right-b-id)
        (not (= (macro-decl-list-slots-address copied) right-address))
        (macro-decl-module-eq? (ast-decl-list-ref copied 0) alias-id)
        (macro-decl-module-eq? (ast-decl-list-ref copied 1) right-a-id)
        (macro-decl-module-eq? (ast-decl-list-ref copied 2) right-b-id)
        (= (struct-get reserved offset) 8)
        (= (macro-decl-list-slots-address prefixed) reserved-address)
        (= (struct-get prefixed offset) 6)
        (macro-decl-module-eq? (ast-decl-list-ref prefixed 0) prefix-a-id)
        (macro-decl-module-eq? (ast-decl-list-ref prefixed 1) prefix-b-id)
        (macro-decl-module-eq? (ast-decl-list-ref prefixed 2) right-a-id)
        (macro-decl-module-eq? (ast-decl-list-ref prefixed 3) right-b-id)))))

(cfg
  test
  (define (macro-decl-path-list-append-headroom-smoke?) : bool
    (let
      [left-id : i64 (ci.intern-generated-name "left-path")]
      [right-a-id : i64 (ci.intern-generated-name "right-a-path")]
      [right-b-id : i64 (ci.intern-generated-name "right-b-path")]
      [alias-id : i64 (ci.intern-generated-name "alias-path")]
      [prefix-a-id : i64 (ci.intern-generated-name "prefix-a-path")]
      [prefix-b-id : i64 (ci.intern-generated-name "prefix-b-path")]
      [left : AstDeclPathList (ast-decl-path-list-with-capacity 1)]
      [_left : unit
        (ast-decl-path-list-push-with-owner-id (&mut left) "left" left-id)]
      [right-base : AstDeclPathList (ast-decl-path-list-new)]
      [right-tail : AstDeclPathList
        (ast-decl-path-list-prepend-builder-with-owner-id
          "right-b"
          right-b-id
          right-base)]
      [right : AstDeclPathList
        (ast-decl-path-list-prepend-builder-with-owner-id
          "right-a"
          right-a-id
          right-tail)]
      [right-address : i64 (macro-decl-path-list-slots-address right)]
      [reused : AstDeclPathList (macro-decl-path-list-append left right)]
      [alias-left : AstDeclPathList
        (begin
          (array-set! (struct-get right slots) 0 "alias")
          (array-set! (struct-get right owner-ids) 0 alias-id)
          (AstDeclPathList
            (struct-get right slots)
            (struct-get right owner-ids)
            0
            1
            false))]
      [copied : AstDeclPathList (macro-decl-path-list-append alias-left right)]
      [reserved : AstDeclPathList
        (macro-decl-path-list-with-prefix-reserve right 8)]
      [reserved-address : i64 (macro-decl-path-list-slots-address reserved)]
      [prefix-base : AstDeclPathList (ast-decl-path-list-new)]
      [prefix-tail : AstDeclPathList
        (ast-decl-path-list-prepend-builder-with-owner-id
          "prefix-a"
          prefix-a-id
          prefix-base)]
      [prefix-rev : AstDeclPathList
        (ast-decl-path-list-prepend-builder-with-owner-id
          "prefix-b"
          prefix-b-id
          prefix-tail)]
      [prefixed : AstDeclPathList
        (macro-decl-path-list-prefix-rev-current-suffix prefix-rev reserved)]
      (and
        (= (macro-decl-path-list-slots-address reused) right-address)
        (= (struct-get reused offset) 1)
        (= (ast-decl-path-list-len (& reused)) 3)
        (string.eq (ast-decl-path-list-get (& reused) 0 "") "left")
        (string.eq (ast-decl-path-list-get (& reused) 1 "") "right-a")
        (string.eq (ast-decl-path-list-get (& reused) 2 "") "right-b")
        (= (ast-decl-path-list-owner-id (& reused) 0 -1) left-id)
        (= (ast-decl-path-list-owner-id (& reused) 1 -1) right-a-id)
        (= (ast-decl-path-list-owner-id (& reused) 2 -1) right-b-id)
        (not (= (macro-decl-path-list-slots-address copied) right-address))
        (string.eq (ast-decl-path-list-get (& copied) 0 "") "alias")
        (string.eq (ast-decl-path-list-get (& copied) 1 "") "right-a")
        (string.eq (ast-decl-path-list-get (& copied) 2 "") "right-b")
        (= (ast-decl-path-list-owner-id (& copied) 0 -1) alias-id)
        (= (ast-decl-path-list-owner-id (& copied) 1 -1) right-a-id)
        (= (ast-decl-path-list-owner-id (& copied) 2 -1) right-b-id)
        (= (struct-get reserved offset) 8)
        (= (macro-decl-path-list-slots-address prefixed) reserved-address)
        (= (struct-get prefixed offset) 6)
        (string.eq (ast-decl-path-list-get (& prefixed) 0 "") "prefix-a")
        (string.eq (ast-decl-path-list-get (& prefixed) 1 "") "prefix-b")
        (string.eq (ast-decl-path-list-get (& prefixed) 2 "") "right-a")
        (string.eq (ast-decl-path-list-get (& prefixed) 3 "") "right-b")
        (= (ast-decl-path-list-owner-id (& prefixed) 0 -1) prefix-a-id)
        (= (ast-decl-path-list-owner-id (& prefixed) 1 -1) prefix-b-id)
        (= (ast-decl-path-list-owner-id (& prefixed) 2 -1) right-a-id)
        (= (ast-decl-path-list-owner-id (& prefixed) 3 -1) right-b-id)))))

(cfg
  test
  (test
    macro-decl-list-append-headroom
    (if (macro-decl-list-append-headroom-smoke?)
      (if (macro-decl-path-list-append-headroom-smoke?)
        unit
        (io.panic
          "typecheck: macro decl-path-list append headroom smoke failed"))
      (io.panic "typecheck: macro decl-list append headroom smoke failed"))))

(define (macro-decl-list-current-suffix [head : AstDecl] [rest : AstDeclList]) : AstDeclList
  (let
    [offset : i64 (struct-get rest offset)]
    (if (> offset 0)
      (let
        [head-offset : i64 (- offset 1)]
        (begin
          (array-set! (struct-get rest slots) head-offset head)
          (AstDeclList
            (struct-get rest slots)
            head-offset
            (+ (struct-get rest len) 1)
            false)))
      (ast-decl-cons head rest))))

(define (macro-decl-path-list-current-suffix
  [head : String]
  [head-owner-id : i64]
  [rest : AstDeclPathList]) : AstDeclPathList
  (let
    [offset : i64 (struct-get rest offset)]
    (if (> offset 0)
      (let
        [head-offset : i64 (- offset 1)]
        (begin
          (array-set! (struct-get rest slots) head-offset head)
          (array-set! (struct-get rest owner-ids) head-offset head-owner-id)
          (AstDeclPathList
            (struct-get rest slots)
            (struct-get rest owner-ids)
            head-offset
            (+ (struct-get rest len) 1)
            false)))
      (ast-decl-path-list-prepend-builder-with-owner-id head head-owner-id rest))))

(define (macro-decl-list-prefix-rev-current-suffix
  [prefix-rev : AstDeclList]
  [suffix : AstDeclList]) : AstDeclList
  (let
    [prefix-count : i64 (ast-decl-list-len (& prefix-rev))]
    [suffix-offset : i64 (struct-get suffix offset)]
    (if (<= prefix-count suffix-offset)
      (let
        [cursor : AstDeclList prefix-rev]
        [write-index : i64 (- suffix-offset 1)]
        [done : bool false]
        (begin
          (while (not done)
            (match (ast-decl-list-step cursor)
              [(AstDeclListStep.Nil) (set! done true)]
              [(AstDeclListStep.Cons decl rest)
                (begin
                  (array-set! (struct-get suffix slots) write-index decl)
                  (set! write-index (- write-index 1))
                  (set! cursor rest))]))
          (AstDeclList
            (struct-get suffix slots)
            (- suffix-offset prefix-count)
            (+ prefix-count (struct-get suffix len))
            false)))
      (macro-decl-list-append (macro-decl-list-reverse prefix-rev) suffix))))

(define (macro-decl-path-list-prefix-rev-current-suffix
  [prefix-rev : AstDeclPathList]
  [suffix : AstDeclPathList]) : AstDeclPathList
  (let
    [prefix-count : i64 (ast-decl-path-list-len (& prefix-rev))]
    [suffix-offset : i64 (struct-get suffix offset)]
    (if (<= prefix-count suffix-offset)
      (let
        [cursor : AstDeclPathList prefix-rev]
        [write-index : i64 (- suffix-offset 1)]
        [done : bool false]
        (begin
          (while (not done)
            (let
              [owner-id : i64
                (ast-decl-path-list-owner-id
                  (& cursor)
                  0
                  cbi.compiler-builtin-id-fix-empty)]
              (match (ast-decl-path-list-step cursor)
                [(AstDeclPathListStep.Nil) (set! done true)]
                [(AstDeclPathListStep.Cons path rest)
                  (begin
                    (array-set! (struct-get suffix slots) write-index path)
                    (array-set!
                      (struct-get suffix owner-ids)
                      write-index
                      owner-id)
                    (set! write-index (- write-index 1))
                    (set! cursor rest))])))
          (AstDeclPathList
            (struct-get suffix slots)
            (struct-get suffix owner-ids)
            (- suffix-offset prefix-count)
            (+ prefix-count (struct-get suffix len))
            false)))
      (macro-decl-path-list-append
        (macro-decl-path-list-reverse prefix-rev)
        suffix))))

(define (macro-scratch-decl-list-reverse [items : AstDeclList]) : AstDeclList
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : AstDeclList (macro-decl-list-reverse items)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-decl-list-reverse items)))

(define (macro-scratch-decl-path-list-reverse [items : AstDeclPathList]) : AstDeclPathList
  (if macro-expand-scratch-enabled
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 (macro-expand-scratch-arena-get)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [out : AstDeclPathList (macro-decl-path-list-reverse items)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (begin
            (set! macro-expand-scratch-arena scratch-head)
            (unsafe
              (arena.tl_arena_set enclosing))
            out))))
    (macro-decl-path-list-reverse items)))

(define (macro-scratch-decl-list-append
  [left : AstDeclList]
  [right : AstDeclList]) : AstDeclList
