    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [exprs : AstExprList]) : ResultTcTypeList
    (let
      [start-ms : i64 (profile.now-ms)]
      [start-total : i64 (profile.alloc-total)]
