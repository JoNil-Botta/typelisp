        span
        origin)]
    [(ast.AstExpr.PtrAddrOf place-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 190)
        place-id
        span
        origin)]
    [(ast.AstExpr.PtrRead ptr-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 191)
        ptr-id
        span
        origin)]
    [(ast.AstExpr.PtrWrite ptr-id value-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 192)
        ptr-id
        value-id
        span
        origin)]
    [(ast.AstExpr.PtrOffset ptr-id offset-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 193)
        ptr-id
        offset-id
        span
        origin)]
    [(ast.AstExpr.PtrCast ptr-id ty-id)
      (macro-child-type-form3-id
        (cbi.compiler-builtin-ctfe-ref 194)
        ptr-id
        (ast.ty-node-get ty-id)
        span
        origin)]
    [(ast.AstExpr.PtrToInt ptr-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 195)
        ptr-id
        span
        origin)]
    [(ast.AstExpr.IntToPtr value-id ty-id)
      (macro-child-type-form3-id
        (cbi.compiler-builtin-ctfe-ref 196)
        value-id
        (ast.ty-node-get ty-id)
        span
        origin)]
    [(ast.AstExpr.StringData value-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 197)
        value-id
        span
        origin)]
    [(ast.AstExpr.StringFromBytes ptr-id len-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 198)
        ptr-id
        len-id
        span
        origin)]
    [(ast.AstExpr.ArrayData value-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 199)
        value-id
        span
        origin)]
    [(ast.AstExpr.BinaryData bytes)
      (ResultMacroSexpr.Ok
        (macro-form1-id
          (cbi.compiler-builtin-ctfe-ref 213)
          (reader.SpannedSexpr.Str
            (ci.intern-id-from-renderable
              (ci.intern-generated-canonical-name bytes))
            span)
          span))]
    [(ast.AstExpr.ProgramArgc)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 200) span))]
    [(ast.AstExpr.ProgramArgv)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 201) span))]
    [(ast.AstExpr.ProgramEnvp)
      (ResultMacroSexpr.Ok
        (macro-form0-id (cbi.compiler-builtin-ctfe-ref 202) span))]
    [(ast.AstExpr.CpuIdEax leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 203)
        leaf-id
        subleaf-id
        span
        origin)]
    [(ast.AstExpr.CpuIdEbx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 204)
        leaf-id
        subleaf-id
        span
        origin)]
    [(ast.AstExpr.CpuIdEcx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 205)
        leaf-id
        subleaf-id
        span
        origin)]
    [(ast.AstExpr.CpuIdEdx leaf-id subleaf-id)
      (macro-child-form2-id
        (cbi.compiler-builtin-ctfe-ref 206)
        leaf-id
        subleaf-id
        span
        origin)]
    [(ast.AstExpr.Xgetbv index-id)
      (macro-child-form1-id
        (cbi.compiler-builtin-ctfe-ref 207)
        index-id
        span
        origin)]
    [(ast.AstExpr.Syscall args)
      (macro-expr-list-with-head-symbol-id
        (cbi.compiler-builtin-ctfe-ref 136)
        args
        span
        origin)]
    [_
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output contains syntax that cannot be parsed as a declaration")))]))

(define (macro-expr-to-spanned-sexpr
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span expr (macro-zero-source-span) origin))

(define (macro-parse-decl-sexpr
  [dispatch : sym_i64_env.SymI64Env]
  [form : reader.SpannedSexpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (match (parser.parse-ast-decl-maybe dispatch form)
    [(parser.ResultAstMaybeDecl.SomeDecl decl)
      (ResultMacroParsedDecls.Ok
        (ast.ast-decl-cons decl (ast.ast-decl-list-new)))]
    [(parser.ResultAstMaybeDecl.Decls decls) (ResultMacroParsedDecls.Ok decls)]
    [(parser.ResultAstMaybeDecl.NoDecl)
      (ResultMacroParsedDecls.Ok (ast.ast-decl-list-new))]
    [(parser.ResultAstMaybeDecl.Err message)
      (ResultMacroParsedDecls.Err
        (box (macro-output-syntax-diag origin message)))]))

(define (macro-parse-decls-from-one-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (let
    [mark : i64 (reader.sp-node-pool-len)]
    [sexpr-mark : i64 (reader.sexpr-node-pool-len)]
    (match (macro-expr-to-spanned-sexpr expr origin)
      [(ResultMacroSexpr.Ok form)
        (match (macro-parse-decl-sexpr dispatch form origin)
          [(ResultMacroParsedDecls.Ok decls)
            (begin
              (reader.sp-node-pool-truncate! mark)
              (reader.sexpr-node-pool-truncate! sexpr-mark)
              (ResultMacroParsedDecls.Ok decls))]
          [(ResultMacroParsedDecls.Err diag)
            (begin
              (reader.sp-node-pool-truncate! mark)
              (reader.sexpr-node-pool-truncate! sexpr-mark)
              (ResultMacroParsedDecls.Err diag))])]
      [(ResultMacroSexpr.Err diag)
        (begin
          (reader.sp-node-pool-truncate! mark)
          (reader.sexpr-node-pool-truncate! sexpr-mark)
          (ResultMacroParsedDecls.Err diag))])))

(define (macro-parse-decls-from-exprs
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : ast.AstExprList]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (macro-parse-decls-from-exprs-at dispatch (& exprs) 0 origin))

(define (macro-parse-decls-from-exprs-at
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (if (>= index exprs.len)
    (ResultMacroParsedDecls.Ok (ast.ast-decl-list-new))
    (let
      [head-expr : ast.AstExpr
        (ast.ast-node-get (ast.ast-expr-list-get exprs index 0))]
      (match (macro-parse-decls-from-expr dispatch head-expr origin)
        [(ResultMacroParsedDecls.Ok head-decls)
          (match (macro-parse-decls-from-exprs-at
            dispatch
            exprs
            (+ index 1)
            origin)
            [(ResultMacroParsedDecls.Ok rest-decls)
              (ResultMacroParsedDecls.Ok
                (macro-decl-list-append head-decls rest-decls))]
            [(ResultMacroParsedDecls.Err diag)
              (ResultMacroParsedDecls.Err diag)])]
        [(ResultMacroParsedDecls.Err diag) (ResultMacroParsedDecls.Err diag)]))))

(define (macro-parse-decls-from-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultMacroParsedDecls
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Begin exprs)
      (macro-parse-decls-from-exprs dispatch exprs origin)]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (ast.ast-node-get func-box)]
        (match (ast.ast-expr-unspan func)
          [(ast.AstExpr.Var name)
            (if (=
              (parser.compiler-parse-dispatch-tag-id
                dispatch
                (macro-output-syntax-id-at name "parse-call-head"))
              (parser.compiler-parse-tag-expr-begin))
              (macro-parse-decls-from-exprs dispatch args origin)
              (macro-parse-decls-from-one-expr dispatch expr origin))]
          [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))]
    [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))

(define (macro-module-decls-from-ctfe-value
  [value : ctfe_support.CompilerCtfeValue]
  [origin : ast.AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(ctfe_support.CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast.ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Module macro transformer did not produce Expr")))]))

(define (macro-decls-from-ctfe-value
  [value : ctfe_support.CompilerCtfeValue]
  [origin : ast.AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(ctfe_support.CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast.ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Decls macro transformer did not produce Expr")))]))

(define (macro-hygiene-ctfe-output
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]
  [value : ctfe_support.CompilerCtfeValue]
  [hygiene : MacroHygieneContext]
  [params : ast.AstMacroParamList]
  [depth : i64]) : ctfe_support.CompilerCtfeValue
  (match value
    [(ctfe_support.CompilerCtfeValue.Expr node produced)
      (begin
        (macro-hygiene-env-root-begin! state)
        (let
          [expr-bases : i64
            (ast.ast-node-pool-context-expr-segment-bases pools)]
          [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases node)]
          [param-env : MacroHygieneEnv
            (macro-hygiene-output-macro-param-env
              (& params)
              0
              (macro-hygiene-env-empty state pools))]
          [output-env : MacroHygieneEnv
            (macro-hygiene-output-decl-env expr param-env)]
          [out : ctfe_support.CompilerCtfeValue
            (ctfe_support.CompilerCtfeValue.Expr
              (macro-hygiene-produced-expr node output-env hygiene depth)
              produced)]
          (begin
            (macro-hygiene-env-root-finish! state)
            out)))]
    [_ value]))

(define (macro-collect-decl-name
  [state : TcMacroState]
  [decl : ast.AstDecl]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl
    [(ast.AstDecl.DefMacro decl-meta name _ _ _)
      (begin
        (ctfe_support.ctfe-module-macro-export-add-id-for-state!
          (tc-macro-ctfe-state state)
          module-id
          name)
        (tc-name-id-list-add acc name))]
    [(ast.AstDecl.Import
        decl-meta
        (ast.AstImportSpec.Spec
          (ast.AstImportKind.ModuleItem _)
          _
          _
          (ast.AstMaybeImportAlias.Some alias)
          _))
      ;; Selected imports can rename a macro. Include the local spelling in
      ;; the prescan so the call reaches normal symbol-table resolution; a
      ;; selected value/type is harmless here and resolves as a non-macro.
      (tc-name-id-list-add acc alias)]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-collect-decl-name state (__tl-box-place inner-box) module-id acc)]
    [_ acc]))

;; Index cursor rather than `ast-decl-list-step`: the module arm reads one id
;; out of the row and the other arm hands the row to `macro-collect-decl-name`,
;; so the step result's 144 B and its row copy are both pure overhead.
(define (macro-collect-macro-names-in
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : TcNameIdList acc]
    (begin
      (while (< index count)
        (begin
          (match (ast.ast-decl-list-ref-borrowed (& decls) index)
            [(ast.AstDecl.Module _)
              (set!
                cur-module-id
                (ast.ast-decl-list-module-id-at
                  (& decls)
                  index
                  cbi.compiler-builtin-id-fix-empty))]
            [_
              (set!
                out
                (macro-collect-decl-name
                  state
                  (array-ref decl-slots (+ decl-offset index))
                  cur-module-id
                  out))])
          (set! index (+ index 1))))
      out)))

(define (macro-collect-macro-names
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [acc : TcNameIdList]) : TcNameIdList
  (macro-collect-macro-names-in
    state
    decls
    cbi.compiler-builtin-id-fix-empty
    acc))

(define (macro-collect-surface-decl-name
  [state : TcMacroState]
  [decl : cload.CompilerLoadSurfaceDecl]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl.kind
    [(CompilerLoadSurfaceMacro)
      (let
        [module-id : i64 decl.module]
        [name-id : i64 decl.name]
        (begin
          (ctfe_support.ctfe-module-macro-export-add-id-for-state!
            (tc-macro-ctfe-state state)
            module-id
            name-id)
          (tc-name-id-list-add acc name-id)))]
    [_ acc]))

(define (macro-collect-surface-decl-names
  [state : TcMacroState]
  [decls : cload.CompilerLoadSurfaceDeclList]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [index : i64 0]
    [out : TcNameIdList acc]
    (begin
      (while (< index (cload.compiler-load-surface-decl-list-count decls))
        (begin
          (set!
            out
            (macro-collect-surface-decl-name
              state
              (cload.compiler-load-surface-decl-list-at decls index)
              out))
          (set! index (+ index 1))))
      out)))

(define (macro-collect-surface-summary-macro-names
  [state : TcMacroState]
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [acc : TcNameIdList]) : TcNameIdList
  (let
    [index : i64 0]
    [out : TcNameIdList acc]
    (begin
      (while (<
        index
        (cload.compiler-load-surface-summary-list-count summaries))
        (begin
          (set!
            out
            (macro-collect-surface-decl-names
              state
              (__tl-project-field
                (cload.compiler-load-surface-summary-list-at summaries index)
                decls)
              out))
          (set! index (+ index 1))))
      out)))

(define (macro-collect-visible-macro-names
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : TcNameIdList
  (macro-collect-surface-summary-macro-names
    state
    (cload.compiler-load-surface-summaries)
    (macro-collect-macro-names state decls (TcNameIdList.Nil))))

(define (macro-name-set-add-all
  [state : TcMacroState]
  [names : TcNameIdList]
  [set : (&mut set tc_i64_i64_map.Map)]) : unit
  (let
    [cursor : TcNameIdList names]
    (while (not (tc-name-id-list-empty? cursor))
      (begin
        (if (tc_i64_i64_map.needs-grow? set)
          (in-arena
            (arena.Arena (tc-macro-state-owner-arena state))
            (tc_i64_i64_map.grow! set))
          unit)
        (tc_i64_i64_map.insert-ref! set (tc-name-id-list-head cursor) 1)
        (set! cursor (tc-name-id-list-rest cursor))))))

(define (macro-name-set-rebuild!
  [state : TcMacroState]
  [names : TcNameIdList]
  [set : (&mut set tc_i64_i64_map.Map)]) : unit
  (begin
    (tc_i64_i64_map.clear-ref! set)
    (macro-name-set-add-all state names set)))

(define (macro-ctfe-visible-name-set-add-all
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [cursor : TcNameIdList names]
    (while (not (tc-name-id-list-empty? cursor))
      (begin
        (ctfe_support.ctfe-visible-macro-name-add-for-state!
          (tc-macro-ctfe-state state)
          (tc-name-id-list-head cursor))
        (set! cursor (tc-name-id-list-rest cursor))))))

(define (macro-expand-set-macro-names!
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [set : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-macro-name-set)]
    (begin
      (macro-name-set-rebuild! state names (&mut set))
      (tc-macro-walk-set! state macro-expand-macro-name-set set)
      (ctfe_support.ctfe-visible-macro-names-reset-for-state!
        (tc-macro-ctfe-state state))
      (macro-ctfe-visible-name-set-add-all state names))))

(define (macro-expand-set-expr-type-macro-names!
  [state : TcMacroState]
  [names : TcNameIdList]) : unit
  (let
    [set : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-expr-type-macro-name-set)]
    (begin
      (macro-name-set-rebuild! state names (&mut set))
      (tc-macro-walk-set! state macro-expand-expr-type-macro-name-set set))))

(define (macro-expand-expr-type-macro?
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]) : bool
  (let
    [names : tc_i64_i64_map.Map
      (tc-macro-walk-field state macro-expand-expr-type-macro-name-set)]
    (tc_i64_i64_map.contains?
      (& names)
      (csym.compiler-symbol-module-key-id-by-id module-id name-id))))

(define (macro-surface-decl-macro-in-module?
  [decl : cload.CompilerLoadSurfaceDecl]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (and
    (= decl.module target-module-id)
    (= decl.name base-id)
    (match decl.kind
      [(CompilerLoadSurfaceMacro) true]
      [_ false])))

(define (macro-surface-decls-macro-in-module?
  [decls : cload.CompilerLoadSurfaceDeclList]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (let
    [index : i64 0]
    (begin
      (while (< index (cload.compiler-load-surface-decl-list-count decls))
        (if (macro-surface-decl-macro-in-module?
          (cload.compiler-load-surface-decl-list-at decls index)
          target-module-id
          base-id)
          (return true)
          (set! index (+ index 1))))
      false)))

(define (macro-surface-summaries-macro-in-module?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]
  [base-id : i64]) : bool
  (let
    [index : i64 0]
    (begin
      (while (<
        index
        (cload.compiler-load-surface-summary-list-count summaries))
        (if (macro-surface-decls-macro-in-module?
          (__tl-project-field
            (cload.compiler-load-surface-summary-list-at summaries index)
            decls)
          target-module-id
          base-id)
          (return true)
          (set! index (+ index 1))))
      false)))

(define (macro-surface-macro-in-module?
  [target-module-id : i64]
  [base-id : i64]) : bool
  (macro-surface-summaries-macro-in-module?
    (cload.compiler-load-surface-summaries)
    target-module-id
    base-id))

(define (macro-surface-decls-module-has-macro?
  [decls : cload.CompilerLoadSurfaceDeclList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (begin
      (while (< index (cload.compiler-load-surface-decl-list-count decls))
        (let
          [decl : cload.CompilerLoadSurfaceDecl
            (cload.compiler-load-surface-decl-list-at decls index)]
          (if (and
            (= decl.module target-module-id)
            (match decl.kind
              [(CompilerLoadSurfaceMacro) true]
              [_ false]))
            (return true)
            (set! index (+ index 1)))))
      false)))

(define (macro-surface-summaries-module-has-macro?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (begin
      (while (<
        index
        (cload.compiler-load-surface-summary-list-count summaries))
        (if (macro-surface-decls-module-has-macro?
          (__tl-project-field
            (cload.compiler-load-surface-summary-list-at summaries index)
            decls)
          target-module-id)
          (return true)
          (set! index (+ index 1))))
      false)))

(define (macro-surface-module-has-macro? [target-module-id : i64]) : bool
  (macro-surface-summaries-module-has-macro?
    (cload.compiler-load-surface-summaries)
    target-module-id))

(defenum MacroSurfaceCallDeclCacheLookup
  (Miss)
  (Hit MacroMaybeDecl))

(defstruct TcMacroSurfaceCallStateData
  (capacity i64)
  (module-keys (__tl_dyn-array i64))
  (base-keys (__tl_dyn-array i64))
  (values (__tl_dyn-array MacroMaybeDecl))
  (count i64)
  (owner-table-id i64)
  (owner-reset-generation i64)
  (ready bool))

(define (tc-macro-surface-call-state-new) : TcMacroSurfaceCallStateData
  (TcMacroSurfaceCallStateData
    8192
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array MacroMaybeDecl 0)
    0
    -1
    -1
    false))

(define (tc-macro-surface-call-state-address-initialize [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-surface-call)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcMacroSurfaceCallStateData)
              (array.make-array TcMacroSurfaceCallStateData 1)]
            [_init : unit
              (set! (array-ref cell 0) (tc-macro-surface-call-state-new))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcMacroSurfaceCallStateData))))
                : i64)]
            (begin
              (tc-macro-state-slot-address-set!
                state
                tc-macro-state-slot-surface-call
                next)
              next)))))))

(define (tc-macro-surface-call-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    6
    tc-macro-surface-call-state-address-initialize))

(define (tc-macro-surface-call-state-data [state : TcMacroState]) : TcMacroSurfaceCallStateData
  (unsafe
    (ptr-read
      (int->ptr
        (cast (tc-macro-surface-call-state-address state) : u64)
        : (Ptr TcMacroSurfaceCallStateData)))))

(define (tc-macro-surface-call-state-data-set!
  [state : TcMacroState]
  [data : TcMacroSurfaceCallStateData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr
        (cast (tc-macro-surface-call-state-address state) : u64)
        : (MutPtr TcMacroSurfaceCallStateData))
      data)))

(define (macro-surface-call-decl-cache-reset! [state : TcMacroState]) : unit
  (let
    [cache : TcMacroSurfaceCallStateData
      (tc-macro-surface-call-state-data state)]
    (begin
      (set! cache.ready false)
      (tc-macro-surface-call-state-data-set! state cache))))

(define (macro-surface-call-decl-cache-ensure! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [cache : TcMacroSurfaceCallStateData
      (tc-macro-surface-call-state-data state)]
    (if (and
      cache.ready
      (= cache.owner-table-id table-id)
      (= cache.owner-reset-generation reset-generation))
      unit
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [i : i64 0]
            (begin
              (if (= (array.length cache.module-keys) 0)
                (begin
                  (set! cache.module-keys (array.make-array i64 cache.capacity))
                  (set! cache.base-keys (array.make-array i64 cache.capacity))
                  (set!
                    cache.values
                    (array.make-array MacroMaybeDecl cache.capacity)))
                unit)
              (while (< i cache.capacity)
                (begin
                  (set! (array-ref cache.module-keys i) 0)
                  (set! i (+ i 1))))
              (set! cache.count 0)
              (set! cache.owner-table-id table-id)
              (set! cache.owner-reset-generation reset-generation)
              (set! cache.ready true)
              (tc-macro-surface-call-state-data-set! state cache))))))))

(define (macro-surface-call-decl-cache-bucket [module-id : i64] [base-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) (* base-id 40503)) 8191))

(define (macro-surface-call-decl-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [base-id : i64]) : MacroSurfaceCallDeclCacheLookup
  (let
    [cache : TcMacroSurfaceCallStateData
      (tc-macro-surface-call-state-data state)]
    [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
    [module-key : i64 (+ module-id 1)]
    [base-key : i64 (+ base-id 1)]
    [steps : i64 0]
    [out : MacroSurfaceCallDeclCacheLookup
      (MacroSurfaceCallDeclCacheLookup.Miss)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps cache.capacity))
        (let
          [slot : i64 (array-ref cache.module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (= (array-ref cache.base-keys cursor) base-key))
              (begin
                (set!
                  out
                  (MacroSurfaceCallDeclCacheLookup.Hit
                    (tc-global-array-element-shared-view cache.values cursor)))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) (- cache.capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-surface-call-decl-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [base-id : i64]
  [value : MacroMaybeDecl]) : unit
  (let
    [cache : TcMacroSurfaceCallStateData
      (tc-macro-surface-call-state-data state)]
    (if (>= (* cache.count 2) cache.capacity)
      unit
      (let
        [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
        [module-key : i64 (+ module-id 1)]
        [base-key : i64 (+ base-id 1)]
        [steps : i64 0]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps cache.capacity))
            (let
              [slot : i64 (array-ref cache.module-keys cursor)]
              (if (= slot 0)
                (begin
                  (set! (array-ref cache.module-keys cursor) module-key)
                  (set! (array-ref cache.base-keys cursor) base-key)
                  (set! (array-ref cache.values cursor) value)
                  (set! cache.count (+ cache.count 1))
                  (set! done true))
                (if (and
                  (= slot module-key)
                  (= (array-ref cache.base-keys cursor) base-key))
                  (begin
                    (set! (array-ref cache.values cursor) value)
                    (set! done true))
                  (begin
                    (set! cursor (bit-and (+ cursor 1) (- cache.capacity 1)))
                    (set! steps (+ steps 1)))))))
          (tc-macro-surface-call-state-data-set! state cache))))))

(define (macro-surface-decl-call-decl-in-module
  [state : TcMacroState]
  [decl : cload.CompilerLoadSurfaceDecl]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (if (and
    (= decl.module target-module-id)
    (= decl.name base-id)
    (match decl.kind
      [(CompilerLoadSurfaceMacro) true]
      [_ false]))
    (match decl.signature
      [(CompilerLoadSurfaceMacroSignature params ret body-box)
        (begin
          (tc-lazy-import-summary-macro-force-record-for-state! state)
          (MacroMaybeDecl.Some
            decl.name
            decl.module
            -1
            params
            ret
            (ast.ast-node-get body-box)))]
      [_ (MacroMaybeDecl.No)])
    (MacroMaybeDecl.No)))

(define (macro-surface-decls-call-decl-in-module
  [state : TcMacroState]
  [decls : cload.CompilerLoadSurfaceDeclList]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (let
    [index : i64 0]
    (begin
      (while (< index (cload.compiler-load-surface-decl-list-count decls))
        (match (macro-surface-decl-call-decl-in-module
          state
          (cload.compiler-load-surface-decl-list-at decls index)
          target-module-id
          base-id)
          [(MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body)
            (return
              (MacroMaybeDecl.Some
                macro-name
                def-module
                declaration-id
                params
                ret
                body))]
          [(MacroMaybeDecl.No) (set! index (+ index 1))]))
      (MacroMaybeDecl.No))))

(define (macro-surface-summaries-call-decl-in-module
  [state : TcMacroState]
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (let
    [index : i64 0]
    (begin
      (while (<
        index
        (cload.compiler-load-surface-summary-list-count summaries))
        (match (macro-surface-decls-call-decl-in-module
          state
          (__tl-project-field
            (cload.compiler-load-surface-summary-list-at summaries index)
            decls)
          target-module-id
          base-id)
          [(MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body)
            (return
              (MacroMaybeDecl.Some
                macro-name
                def-module
                declaration-id
                params
                ret
                body))]
          [(MacroMaybeDecl.No) (set! index (+ index 1))]))
      (MacroMaybeDecl.No))))

(define (macro-surface-call-decl-fill-in-module
  [state : TcMacroState]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (let
    [result : MacroMaybeDecl
      (match (macro-surface-summaries-call-decl-in-module
        state
        (cload.compiler-load-surface-summaries)
        target-module-id
        base-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)]
        [(MacroMaybeDecl.No) (MacroMaybeDecl.No)])]
    (begin
      (macro-surface-call-decl-cache-put! state target-module-id base-id result)
      result)))

;; R3-P2 hardening of R3-P1's residual hazard class (its section 6.1: "a
;; per-declaration ambient arena turns every allocate-into-whatever-arena-is-
;; current cache into a use-after-free").
;;
;; This is a VALUE cache: rebuilding `MacroMaybeDecl.Some` heap-copies the enum
;; payload into whatever arena is current -- the struct-assignment variant of
;; the grow-while-transient hazard documented in `compiler_ast_types.tl`
;; ("assigning a struct value heap-copies it in the current arena"). The cache
;; is cleared at EVERY splice by `macro-alias-derived-cache-reset!` and refilled
;; from inside the next declaration's expansion, which under R3-P1 runs in that
;; declaration's generation; the entry then outlives its arena while the cache
;; keeps handing it out. Nothing on the current workload reads a stale entry
;; late enough to fault, so this is a latent defect rather than an observed one.
;;
;; Same owner and same argument as R3-P1's `macro-flat-import-targets` fix: the
;; macro-expansion scratch arena, whose lifetime is exactly this cache's --
;; `macro-expand-scratch-clear-owned-caches!` runs the reset immediately before
;; that arena is destroyed. The payloads the entry points at (`params`, `ret`,
;; `body`, the name strings) are owned by the load surface summaries and are
;; untouched; only the enum cell moves. Redirected only while a generation is
;; live, so every non-generational caller keeps its existing owner.
(define (macro-surface-call-decl-in-module
  [state : TcMacroState]
  [target-module-id : i64]
  [base-id : i64]) : MacroMaybeDecl
  (begin
    (macro-surface-call-decl-cache-ensure! state)
    (match (macro-surface-call-decl-cache-get state target-module-id base-id)
      [(MacroSurfaceCallDeclCacheLookup.Hit cached) cached]
      [(MacroSurfaceCallDeclCacheLookup.Miss)
        (if (not (macro-generation-any-live? state))
          (macro-surface-call-decl-fill-in-module
            state
            target-module-id
            base-id)
          (in-arena
            (arena.Arena (macro-expand-scratch-arena-get state))
            (macro-surface-call-decl-fill-in-module
              state
              target-module-id
              base-id)))])))

(define (macro-expr-uses-expr-type? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr-bases expr "expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime.expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime/expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime.expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime/expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib/comptime.expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib/comptime/expr-type"
      TcStringList.Nil)
    (tc-expr-uses-free-name? expr-bases expr "expr-string?" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime.expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime/expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime.expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime/expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib/comptime.expr-string?"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime.expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime/expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime.expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime/expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib/comptime.expr-string-value"
      TcStringList.Nil)
    (tc-expr-uses-free-name? expr-bases expr "string-slice" TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime.string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "comptime/string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime.string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib.comptime/string-slice"
      TcStringList.Nil)
    (tc-expr-uses-free-name?
      expr-bases
      expr
      "stdlib/comptime.string-slice"
      TcStringList.Nil)))

(define (macro-collect-expr-type-decl-name
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  (match decl
    [(ast.AstDecl.DefMacro decl-meta name _ _ body-box)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (if (macro-expr-uses-expr-type? expr-bases body)
          (tc-name-id-list-add
            acc
            (csym.compiler-symbol-module-key-id-by-id module-id name))
          acc))]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-collect-expr-type-decl-name
        expr-bases
        (__tl-box-place inner-box)
        module-id
        acc)]
    [_ acc]))

(define (macro-collect-expr-type-macro-names-in
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [acc : TcNameIdList]) : TcNameIdList
  ;; Index cursor rather than `ast-decl-list-step`, as in
  ;; `macro-collect-macro-names`.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : TcNameIdList acc]
    (begin
      (while (< index count)
        (begin
          (match (ast.ast-decl-list-ref-borrowed (& decls) index)
            [(ast.AstDecl.Module _)
              (set!
                cur-module-id
                (ast.ast-decl-list-module-id-at
                  (& decls)
                  index
                  cbi.compiler-builtin-id-fix-empty))]
            [_
              (set!
                out
                (macro-collect-expr-type-decl-name
                  expr-bases
                  (array-ref decl-slots (+ decl-offset index))
                  cur-module-id
                  out))])
          (set! index (+ index 1))))
      out)))

(define (macro-collect-expr-type-macro-names
  [expr-bases : i64]
  [decls : ast.AstDeclList]) : TcNameIdList
  (macro-collect-expr-type-macro-names-in
    expr-bases
    decls
    cbi.compiler-builtin-id-fix-empty
    TcNameIdList.Nil))

(define (macro-hygiene-structural-base) : i64
  (ci.intern-macro-global-structural-base))

(define (macro-hygiene-global-id
  [module-id : i64]
  [source-name-id : i64]
  [legacy? : bool]) : i64
  (let
    [stride : i64 (ci.intern-capacity)]
    [stride2 : i64 (* stride stride)]
    [stored-module-id : i64
      (if (csym.compiler-symbol-root-module-id? module-id)
        0
        (+ module-id 1))]
    (begin
      (when
        (or
          (< source-name-id 0)
          (>= source-name-id stride)
          (< stored-module-id 0)
          (>= stored-module-id stride))
        (io.panic
          "typecheck: hygienic global identity exceeds structural range"))
      (+
        (macro-hygiene-structural-base)
        (+
          (if legacy?
            0
            stride2)
          (+ (* stored-module-id stride) source-name-id))))))

(define (macro-hygiene-global-id? [name-id : i64]) : bool
  (ci.intern-macro-global-structural-id? name-id))

(define (macro-hygiene-global-legacy-id? [name-id : i64]) : bool
  (<
    name-id
    (+
      (macro-hygiene-structural-base)
      (* (ci.intern-capacity) (ci.intern-capacity)))))

(define (macro-hygiene-global-module-id [name-id : i64]) : i64
  (begin
    (when
      (not (macro-hygiene-global-id? name-id))
      (io.panic
        "typecheck: expected hygienic global identity for module decode"))
    (let
      [stored : i64
        (%
          (/ (- name-id (macro-hygiene-structural-base)) (ci.intern-capacity))
          (ci.intern-capacity))]
      (if (= stored 0)
        (csym.compiler-symbol-root-module-id)
        (- stored 1)))))

(define (macro-hygiene-local-base) : i64
  (let
    [stride : i64 (ci.intern-capacity)]
    (+ (macro-hygiene-structural-base) (* 2 (* stride stride)))))

;; Hygienic locals are namespaced by the macro that produced them. That
;; namespace must be a *stable* property of the macro itself: the identical
;; macro is re-expanded for every import of a generated module whose parameter
;; list disables the content-addressed memo shortcut (a syntax parameter --
;; see macro-generated-identity-shortcut-safe-params?), and
;; macro-generated-target-replay then compares the fresh body against the
;; already-materialized one declaration by declaration. The macro's dense
;; symbol declaration id is *not* stable across that window: splicing a
;; generated module into the program declaration list re-indexes every
;; declaration after the splice point, so the same `defmacro` answers to
;; different dense ids at two expansions and the two bodies disagree on nothing
;; but their renamed locals. Deriving the namespace from the macro's owning
;; module and name -- the encoding lazy surface macros have always used --
;; keeps the renaming a pure function of (macro, depth, source name).
(define (macro-hygiene-local-id
  [hygiene : MacroHygieneContext]
  [depth : i64]
  [source-name-id : i64]) : i64
  (let
    [stride : i64 (ci.intern-capacity)]
    [module-id : i64 hygiene.definition-module-id]
    [stored-module-id : i64
      (if (csym.compiler-symbol-root-module-id? module-id)
        0
        (+ module-id 1))]
    [macro-name-id : i64 hygiene.macro-name-id]
    [macro-id : i64
      (+ (+ stride 1) (+ (* stored-module-id stride) macro-name-id))]
    (begin
      (when
        (or
          (< stored-module-id 0)
          (>= stored-module-id stride)
          (< macro-name-id 0)
          (>= macro-name-id stride)
          (< depth 0)
          (>= depth 1024)
          (< source-name-id 0)
          (>= source-name-id stride))
        (io.panic "typecheck: hygienic macro identity exceeds structural range"))
      (+
        (macro-hygiene-local-base)
        (+ (* macro-id (* 1024 stride)) (+ (* depth stride) source-name-id))))))

;: A macro's hygienic-local namespace must not move when its dense symbol
;: declaration id does. Two contexts that name the same macro but carry
;: different declaration ids -- what a generated-module re-expansion sees
;: after an intervening splice re-indexes the declaration list -- must rename
;: a local to the same id, while a different macro still gets its own
;: namespace.
(define (macro-hygiene-local-id-declaration-stable?) : bool
  (let
    [macro-name-id : i64 (ci.intern "gen")]
    [other-name-id : i64 (ci.intern "gen-other")]
    [module-id : i64 (ci.intern "stdlib.vector")]
    [source-name-id : i64 (ci.intern "cap")]
    [early : MacroHygieneContext
      (MacroHygieneContext
        macro-name-id
        module-id
        1360
        (csym.compiler-symbols-empty))]
    [late : MacroHygieneContext
      (MacroHygieneContext
        macro-name-id
        module-id
        1367
        (csym.compiler-symbols-empty))]
    [other : MacroHygieneContext
      (MacroHygieneContext
        other-name-id
        module-id
        1360
        (csym.compiler-symbols-empty))]
    (and
      (=
        (macro-hygiene-local-id early 1 source-name-id)
        (macro-hygiene-local-id late 1 source-name-id))
      (not
        (=
          (macro-hygiene-local-id early 1 source-name-id)
          (macro-hygiene-local-id other 1 source-name-id)))
      (not
        (=
          (macro-hygiene-local-id early 1 source-name-id)
          (macro-hygiene-local-id early 2 source-name-id)))
      (macro-hygiene-local-id? (macro-hygiene-local-id early 1 source-name-id)))))

;: The hygienic-local range is the widest structural symbol family in the
;: compiler: `macro-hygiene-local-id` packs a sparse macro identity
;: (module * capacity + macro name, so capacity^2 of them), a depth below 1024,
;: and a source name below the capacity, which spans 1024 * capacity^3. At the
;: fixed capacity of 2^17 that is 2^61, already two thirds of the 3*2^60 window
;: below `intern-structural-local-base`, so the family cannot absorb a larger
;: capacity: doubling it multiplies this span by eight, past the whole positive
;: i64 range.
;: Nothing downstream notices that directly. A hygiene id built past the window
;: lands in another family's range, decodes as a pool id, and the failure
;: surfaces as a bare `tl: array index out of bounds` from `intern-str` in a
;: later bootstrap stage. Check the budget here instead, where the encoding that
;: owns it lives. Refs #6258.
(define (macro-hygiene-id-space-budget-ok?) : bool
  (let
    [stride : i64 (ci.intern-capacity)]
    [stride2 : i64 (* stride stride)]
    [global-base : i64 (macro-hygiene-structural-base)]
    [local-base : i64 (macro-hygiene-local-base)]
    [local-top : i64
      (+ local-base (* 1024 (* stride (+ stride2 (+ stride 1)))))]
    (and
      ;; No bound overflowed into a negative i64 ...
      (> global-base 0)
      (> local-base global-base)
      (> local-top local-base)
      ;; ... the globals lane ends exactly where the locals lane starts ...
      (= local-base (+ global-base (* 2 stride2)))
      (= local-base (ci.intern-macro-local-structural-base))
      (= local-top (ci.intern-macro-local-structural-top))
      ;; ... and the whole hygiene range clears the next family above it.
      (<= local-top (ci.intern-structural-local-base))
      (< (ci.intern-structural-local-base) (ci.intern-template-source-base))
      ;; A hygiene id is never mistaken for a pool id.
      (>= global-base stride)
      (macro-hygiene-local-id? (+ local-base (* 1024 (* stride (- stride2 1)))))
      (not (macro-hygiene-local-id? local-top)))))

(define (macro-hygiene-local-id? [name-id : i64]) : bool
  (let
    [stride : i64 (ci.intern-capacity)]
    [stride2 : i64 (* stride stride)]
    [base : i64 (macro-hygiene-local-base)]
    (and
      (>= name-id base)
      (< name-id (+ base (* 1024 (* stride (+ stride2 (+ stride 1)))))))))

(define (macro-hygiene-structural-source-name-id [name-id : i64]) : i64
  (ci.intern-macro-global-source-name-id name-id))

(define (macro-hygiene-global-source-name-id-or
  [name-id : i64]
  [fallback : i64]) : i64
  ;; Ids inside the intern pool range are the common case and can never be
  ;; structural/hygiene ids (every structural family's base is >= stride^2),
  ;; so dispatch on the pool range first and keep the layered predicate
  ;; checks for the out-of-pool families only.
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (if (and
      (ci.intern-qualified? name-id)
      (ci.intern-macro-global-name-id? name-id))
      (ci.intern-qualified-base-id name-id)
      fallback)
    (cond
      [(ci.intern-structural-local-id? name-id)
        (ci.intern-structural-local-source-name-id name-id)]
      [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
        (macro-hygiene-structural-source-name-id name-id)]
      [else fallback])))

(cfg
  compile-profile
  (define (compiler-tc-macro-hygiene-note-binding!) : unit
    (set!
      compiler-tc-macro-hygiene-env-bindings
      (+ compiler-tc-macro-hygiene-env-bindings 1))))

(cfg
  compile-profile
  (define (compiler-tc-macro-hygiene-note-lookup!) : unit
    (set!
      compiler-tc-macro-hygiene-env-lookups
      (+ compiler-tc-macro-hygiene-env-lookups 1))))

(cfg
  compile-profile
  (define (compiler-tc-macro-hygiene-note-lookup-step!) : unit
    (set!
      compiler-tc-macro-hygiene-env-lookup-steps
      (+ compiler-tc-macro-hygiene-env-lookup-steps 1))))

(cfg
  compile-profile
  (define (compiler-tc-macro-hygiene-note-pattern-lookup!) : unit
    (set!
      compiler-tc-macro-hygiene-pattern-lookups
      (+ compiler-tc-macro-hygiene-pattern-lookups 1))))

(cfg
  compile-profile
  (define (compiler-tc-macro-hygiene-note-pattern-lookup-step!) : unit
    (set!
      compiler-tc-macro-hygiene-pattern-lookup-steps
      (+ compiler-tc-macro-hygiene-pattern-lookup-steps 1))))

(define (macro-hygiene-env-bind-kind) : i64
  0)

(define (macro-hygiene-env-pattern-name-kind) : i64
  1)

;; A nested Module-macro import exposes its flat output surface only after this
;; hygiene walk. Mark that deferred output scope so incidental definition-site
;; names do not capture the generated module's imported bare references.
(define (macro-hygiene-env-output-flat-import-kind) : i64
  2)

(define (macro-hygiene-env-kind-mask) : i64
  3)

(define (macro-hygiene-env-output-flat-import-flag) : i64
  4)

(define (macro-hygiene-env-empty
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]) : MacroHygieneEnv
  (MacroHygieneEnv -1 state pools))

(define (macro-hygiene-env-head [env : MacroHygieneEnv]) : i64
  env.head)

(define (macro-hygiene-env-reset! [state : TcMacroState]) : unit
  (tc-macro-walk-set! state macro-hygiene-env-slot-count 0))

(define (macro-hygiene-env-root-begin! [state : TcMacroState]) : unit
  (begin
    ;; Transformer evaluation can recursively expand another macro while the
    ;; caller still retains snapshot heads. Reuse slots only at the outermost
    ;; root; nested roots append until their caller has finished.
    (if (= (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
      (macro-hygiene-env-reset! state)
      unit)
    (tc-macro-walk-set!
      state
      macro-hygiene-env-root-depth
      (+ (tc-macro-walk-field state macro-hygiene-env-root-depth) 1))))

(define (macro-hygiene-env-root-finish! [state : TcMacroState]) : unit
  (if (> (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
    (tc-macro-walk-set!
      state
      macro-hygiene-env-root-depth
      (- (tc-macro-walk-field state macro-hygiene-env-root-depth) 1))
    (io.panic "typecheck: macro hygiene root depth underflow")))

(define (macro-hygiene-env-storage-handle [state : TcMacroState]) : i64
  (begin
    (if (= (tc-macro-walk-field state macro-hygiene-env-storage-arena) 0)
      (begin
        ;; The retained slot table is small (thousands of 32-byte entries in a
        ;; self-compile), so avoid the default arena's larger virtual reservation.
        (tc-macro-walk-set!
          state
          macro-hygiene-env-storage-arena
          (arena.tl_arena_make_small))
        (ast.compiler-arena-debug-protect-never-reset!
          (tc-macro-walk-field state macro-hygiene-env-storage-arena)))
      unit)
    (tc-macro-walk-field state macro-hygiene-env-storage-arena)))

(define (macro-hygiene-env-grow-copy!
  [dst-kinds : (__tl_dyn-array i64)]
  [dst-keys : (__tl_dyn-array i64)]
  [dst-values : (__tl_dyn-array i64)]
  [dst-parents : (__tl_dyn-array i64)]
  [src-kinds : (& src-kinds (__tl_dyn-array i64))]
  [src-keys : (& src-keys (__tl_dyn-array i64))]
  [src-values : (& src-values (__tl_dyn-array i64))]
  [src-parents : (& src-parents (__tl_dyn-array i64))]
  [slot-count : i64]
  [index : i64]) : unit
  (let
    [i : i64 index]
    (while (< i slot-count)
      (begin
        (set! (array-ref dst-kinds i) (array-ref src-kinds i))
        (set! (array-ref dst-keys i) (array-ref src-keys i))
        (set! (array-ref dst-values i) (array-ref src-values i))
        (set! (array-ref dst-parents i) (array-ref src-parents i))
        (set! i (+ i 1))))))

(define (macro-hygiene-env-ensure-capacity! [state : TcMacroState]) : unit
  (let
    [slot-count : i64 (tc-macro-walk-field state macro-hygiene-env-slot-count)]
    [old-kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [old-keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [old-values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [old-parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    (if (< slot-count (array.length old-keys))
      unit
      (let
        [old-capacity : i64 (array.length old-keys)]
        [next-capacity : i64
          (if (< old-capacity 1)
            64
            (* old-capacity 2))]
        [storage : i64 (macro-hygiene-env-storage-handle state)]
        ;; Snapshots can cross every scratch rewind involved in an expansion.
        ;; The stable storage root remains valid across physical chain growth.
        (in-arena
          (arena.Arena storage)
          (let
            [next-kinds : (__tl_dyn-array i64)
              (array.make-array i64 next-capacity)]
            [next-keys : (__tl_dyn-array i64)
              (array.make-array i64 next-capacity)]
            [next-values : (__tl_dyn-array i64)
              (array.make-array i64 next-capacity)]
            [next-parents : (__tl_dyn-array i64)
              (array.make-array i64 next-capacity)]
            (begin
              (macro-hygiene-env-grow-copy!
                next-kinds
                next-keys
                next-values
                next-parents
                (& old-kinds)
                (& old-keys)
                (& old-values)
                (& old-parents)
                slot-count
                0)
              (tc-macro-walk-set! state macro-hygiene-env-kinds next-kinds)
              (tc-macro-walk-set! state macro-hygiene-env-keys next-keys)
              (tc-macro-walk-set! state macro-hygiene-env-values next-values)
              (tc-macro-walk-set! state macro-hygiene-env-parents next-parents))))))))

(define (macro-hygiene-env-push
  [kind : i64]
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (let
    [state : TcMacroState env.state]
    [_ensure : unit (macro-hygiene-env-ensure-capacity! state)]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [index : i64 (tc-macro-walk-field state macro-hygiene-env-slot-count)]
    [stored-kind : i64
      (if (or
        (= kind (macro-hygiene-env-output-flat-import-kind))
        (macro-hygiene-env-has-output-flat-import? env))
        (bit-or kind (macro-hygiene-env-output-flat-import-flag))
        kind)]
    (begin
      (set! (array-ref kinds index) stored-kind)
      (set! (array-ref keys index) key-id)
      (set! (array-ref values index) value-id)
      (set! (array-ref parents index) (macro-hygiene-env-head env))
      (tc-macro-walk-set! state macro-hygiene-env-slot-count (+ index 1))
      (cfg compile-profile (compiler-tc-macro-hygiene-note-binding!))
      (MacroHygieneEnv index state env.pools))))

(define (macro-hygiene-env-lookup [env : MacroHygieneEnv] [name-id : i64]) : MacroMaybeHygieneName
  (let
    [state : TcMacroState env.state]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [cursor : i64 (macro-hygiene-env-head env)]
    (begin
      (cfg compile-profile (compiler-tc-macro-hygiene-note-lookup!))
      (while (>= cursor 0)
        (begin
          (cfg compile-profile (compiler-tc-macro-hygiene-note-lookup-step!))
          (if (= (array-ref keys cursor) name-id)
            (return (MacroMaybeHygieneName.Some (array-ref values cursor)))
            (set! cursor (array-ref parents cursor)))))
      (MacroMaybeHygieneName.No))))

(define (macro-hygiene-env-lookup-pattern-name
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroMaybeHygieneName
  (let
    [state : TcMacroState env.state]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [keys : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-keys)]
    [values : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-values)]
    [parents : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-parents)]
    [cursor : i64 (macro-hygiene-env-head env)]
    (begin
      (cfg compile-profile (compiler-tc-macro-hygiene-note-pattern-lookup!))
      (while (>= cursor 0)
        (begin
          (cfg
            compile-profile
            (compiler-tc-macro-hygiene-note-pattern-lookup-step!))
          (if (and
            (=
              (bit-and (array-ref kinds cursor) (macro-hygiene-env-kind-mask))
              (macro-hygiene-env-pattern-name-kind))
            (= (array-ref keys cursor) name-id))
            (return (MacroMaybeHygieneName.Some (array-ref values cursor)))
            (set! cursor (array-ref parents cursor)))))
      (MacroMaybeHygieneName.No))))

(define (macro-hygiene-env-has-output-flat-import? [env : MacroHygieneEnv]) : bool
  (let
    [state : TcMacroState env.state]
    [kinds : (__tl_dyn-array i64)
      (tc-macro-walk-field state macro-hygiene-env-kinds)]
    [head : i64 (macro-hygiene-env-head env)]
    (and
      (>= head 0)
      (not
        (=
          (bit-and
            (array-ref kinds head)
            (macro-hygiene-env-output-flat-import-flag))
          0)))))

(define (macro-hygiene-env-bind-raw
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (macro-hygiene-env-push (macro-hygiene-env-bind-kind) env key-id value-id))

(define (macro-hygiene-env-bind-pattern-name-raw
  [env : MacroHygieneEnv]
  [key-id : i64]
  [value-id : i64]) : MacroHygieneEnv
  (macro-hygiene-env-push
    (macro-hygiene-env-pattern-name-kind)
    env
    key-id
    value-id))

(define (macro-hygiene-env-bind-output-flat-import [env : MacroHygieneEnv]) : MacroHygieneEnv
  (macro-hygiene-env-push (macro-hygiene-env-output-flat-import-kind) env 0 0))

(define (macro-hygiene-output-bind-id [env : MacroHygieneEnv] [name-id : i64]) : MacroHygieneEnv
  (if (ci.intern-template-source-id? name-id)
    (macro-hygiene-env-bind-raw
      env
      name-id
      (ci.intern-template-source-name-id name-id))
    env))

(define (macro-hygiene-output-pattern-name-id
  [env : MacroHygieneEnv]
  [name-id : i64]) : MacroHygieneEnv
  (if (ci.intern-template-source-id? name-id)
    (macro-hygiene-env-bind-pattern-name-raw
      env
      name-id
      (ci.intern-template-source-name-id name-id))
    env))

(define (macro-hygiene-output-macro-param-env
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(ast.AstMacroParam.Param name-id _ _ _)
        (macro-hygiene-output-macro-param-env
          params
          (+ index 1)
          (macro-hygiene-env-bind-raw
            env
            (ci.intern-template-source-id name-id)
            name-id))])))

(define (macro-hygiene-output-param-env
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.BracketClause items)
      (if (> items.len 0)
        (match (ast.ast-expr-unspan
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get (& items) 0 0)))
          [(ast.AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
          [_ env])
        env)]
    [_ env]))

(define (macro-hygiene-output-param-list-env
  [expr-bases : i64]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-param-list-env
      expr-bases
      items
      (+ index 1)
      (macro-hygiene-output-param-env
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-signature-env
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(ast.AstExpr.Call func-box params)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [with-name : MacroHygieneEnv
          (match (ast.ast-expr-unspan func)
            [(ast.AstExpr.Var name-id)
              (macro-hygiene-output-bind-id env name-id)]
            [_ env])]
        (macro-hygiene-output-param-list-env expr-bases (& params) 0 with-name))]
    [_ env]))

(define (macro-hygiene-output-declaration-name-env
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [(ast.AstExpr.Call func-box _)
      (match (ast.ast-expr-unspan (ast.ast-node-get func-box))
        [(ast.AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-bind-var-expr
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name-id) (macro-hygiene-output-bind-id env name-id)]
    [_ env]))

(define (macro-hygiene-output-bind-var-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-bind-var-list-env
      items
      (+ index 1)
      (macro-hygiene-output-bind-var-expr
        (ast.ast-node-get (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-aggregate-member-env
  [expr : ast.AstExpr]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name-id)
      (if pattern-name?
        (macro-hygiene-output-pattern-name-id env name-id)
        (macro-hygiene-output-bind-id env name-id))]
    [(ast.AstExpr.Call func-box _)
      (match (ast.ast-expr-unspan (ast.ast-node-get func-box))
        [(ast.AstExpr.Var name-id)
          (let
            [source-id : i64 (tc-hygiene-template-source-id-or name-id name-id)]
            (cond
              [(and
                  (ci.intern-colon-keyword-id? source-id)
                  (string.eq (ci.intern-str source-id) ":lifetimes"))
                (match (ast.ast-expr-unspan expr)
                  [(ast.AstExpr.Call _ args)
                    (macro-hygiene-output-bind-var-list-env (& args) 0 env)]
                  [_ env])]
              [(ci.intern-colon-keyword-id? source-id) env]
              [pattern-name? (macro-hygiene-output-pattern-name-id env name-id)]
              [else (macro-hygiene-output-bind-id env name-id)]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-output-aggregate-member-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [pattern-name? : bool]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-aggregate-member-list-env
      items
      (+ index 1)
      pattern-name?
      (macro-hygiene-output-aggregate-member-env
        (ast.ast-node-get (ast.ast-expr-list-get items index 0))
        pattern-name?
        env))))

(define (macro-hygiene-output-import-env
  [items : (& items ast.AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (let
    [count : i64 items.len]
    [with-target : MacroHygieneEnv
      (if (> count 0)
        (match (ast.ast-expr-unspan
          (ast.ast-node-get (ast.ast-expr-list-get items 0 0)))
          [(ast.AstExpr.Var target-id)
            (macro-hygiene-output-bind-id env target-id)]
          [(ast.AstExpr.Call _ _)
            (if (= count 1)
              (macro-hygiene-env-bind-output-flat-import env)
              env)]
          [_ env])
        env)]
    (if (>= count 3)
      (let
        [as-expr : ast.AstExpr
          (ast.ast-node-get (ast.ast-expr-list-get items (- count 2) 0))]
        [alias-expr : ast.AstExpr
          (ast.ast-node-get (ast.ast-expr-list-get items (- count 1) 0))]
        (match (ast.ast-expr-unspan as-expr)
          [(ast.AstExpr.Var as-id)
            (if (string.eq
              (ci.intern-str (tc-hygiene-template-source-id-or as-id as-id))
              "as")
              (match (ast.ast-expr-unspan alias-expr)
                [(ast.AstExpr.Var alias-id)
                  (macro-hygiene-output-bind-id
                    (macro-hygiene-output-bind-id with-target as-id)
                    alias-id)]
                [_ with-target])
              with-target)]
          [_ with-target]))
      (if (= count 1)
        (match (ast.ast-expr-unspan
          (ast.ast-node-get (ast.ast-expr-list-get items 0 0)))
          [(ast.AstExpr.Var target-id)
            (let
              [source-id : i64
                (tc-hygiene-template-source-id-or target-id target-id)]
              [tail-id : i64 (ci.intern-dotted-tail-id source-id)]
              (if (>= tail-id 0)
                (macro-hygiene-output-bind-id
                  with-target
                  (ci.intern-template-source-id tail-id))
                with-target))]
          [_ with-target])
        with-target))))

(define (macro-hygiene-output-decl-list-env
  [items : (& items ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (if (>= index items.len)
    env
    (macro-hygiene-output-decl-list-env
      items
      (+ index 1)
      (macro-hygiene-output-decl-env
        (ast.ast-node-get (ast.ast-expr-list-get items index 0))
        env))))

(define (macro-hygiene-output-decl-env
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Begin items)
      (macro-hygiene-output-decl-list-env (& items) 0 env)]
    [(ast.AstExpr.Unsafe items)
      (macro-hygiene-output-decl-list-env (& items) 0 env)]
    [(ast.AstExpr.Comptime inner-box)
      (macro-hygiene-output-decl-env (ast.ast-node-get inner-box) env)]
    [(ast.AstExpr.Call func-box args)
      (match (ast.ast-expr-unspan (ast.ast-node-get func-box))
        [(ast.AstExpr.Var head-id)
          (let
            [source-head-id : i64
              (tc-hygiene-template-source-id-or head-id head-id)]
            [tag : i64
              (parser.compiler-parse-dispatch-tag-id
                (parser.compiler-parse-dispatch-env)
                source-head-id)]
            [count : i64 args.len]
            (cond
              [(= source-head-id (cbi.compiler-builtin-ctfe-ref 122))
                (macro-hygiene-output-decl-list-env (& args) 0 env)]
              [(= tag (parser.compiler-parse-tag-decl-module))
                (macro-hygiene-output-decl-list-env (& args) 1 env)]
              [(= tag (parser.compiler-parse-tag-decl-import))
                (macro-hygiene-output-import-env (& args) env)]
              [(= tag (parser.compiler-parse-tag-decl-defenum))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    true
                    (macro-hygiene-output-declaration-name-env
                      (ast.ast-node-get (ast.ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(= tag (parser.compiler-parse-tag-decl-defstruct))
                (if (> count 0)
                  (macro-hygiene-output-aggregate-member-list-env
                    (& args)
                    1
                    false
                    (macro-hygiene-output-declaration-name-env
                      (ast.ast-node-get (ast.ast-expr-list-get (& args) 0 0))
                      env))
                  env)]
              [(or
                  (= tag (parser.compiler-parse-tag-decl-define))
                  (= tag (parser.compiler-parse-tag-decl-extern))
                  (= tag (parser.compiler-parse-tag-decl-defmacro))
                  (= tag (parser.compiler-parse-tag-decl-defdispatch)))
                (if (> count 0)
                  (macro-hygiene-output-declaration-name-env
                    (ast.ast-node-get (ast.ast-expr-list-get (& args) 0 0))
                    env)
                  env)]
              [else env]))]
        [_ env])]
    [_ env]))

(define (macro-hygiene-binding-owner-module-id-or
  [hygiene : MacroHygieneContext]
  [module-id : i64]
  [source-name-id : i64]
  [fallback : i64]) : i64
  (let
    [lookup-module-id : i64
      (if (csym.compiler-symbol-root-module-id? module-id)
        cbi.compiler-builtin-id-fix-empty
        module-id)]
    [value-handle : i64
      (csym.compiler-symbols-lookup-value-in-module-id-or
        hygiene.symbols
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [type-handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        hygiene.symbols
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [macro-handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        hygiene.symbols
        lookup-module-id
        source-name-id
        (csym.compiler-symbols-missing-handle))]
    [declaration-id : i64
      (cond
        [(csym.compiler-symbols-handle-found? value-handle)
          (csym.compiler-symbol-handle-index value-handle)]
        [(csym.compiler-symbols-handle-found? type-handle)
          (csym.compiler-symbol-handle-index type-handle)]
        [(csym.compiler-symbols-handle-found? macro-handle)
          (csym.compiler-symbol-handle-index macro-handle)]
        [else -1])]
    (if (< declaration-id 0)
      fallback
      (let
        [owner-module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            hygiene.symbols
            declaration-id
            fallback)]
        ;; A prior expansion can add a flat unqualified alias after a root
        ;; macro declaration. It is output scope, not a definition-site capture.
        (if (and
          (csym.compiler-symbol-root-module-id? module-id)
          (>= hygiene.declaration-id 0)
          (> declaration-id hygiene.declaration-id)
          (ci.intern-generated-id-active? owner-module-id))
          fallback
          owner-module-id)))))

(define (macro-hygiene-global-name-id
  [state : TcMacroState]
  [source-name-id : i64]
  [hygiene : MacroHygieneContext]) : i64
  (let
    [definition-module-id : i64 hygiene.definition-module-id]
    [legacy? : bool (= source-name-id hygiene.macro-name-id)]
    [first-dot : i64 (tc-name-first-dot-id source-name-id)]
    (if (< first-dot 0)
      (let
        [binding-owner-module-id : i64
          (macro-hygiene-binding-owner-module-id-or
            hygiene
            definition-module-id
            source-name-id
            -2)]
        (if (or legacy? (>= binding-owner-module-id -1))
          (macro-hygiene-global-id
            (if legacy?
              definition-module-id
              binding-owner-module-id)
            source-name-id
            legacy?)
          source-name-id))
      (let
        [alias-id : i64 (ci.intern-leading-dot-id source-name-id)]
        [tail-id : i64 (ci.intern-dotted-tail-id source-name-id)]
        [full-module-id : i64 (ci.intern-dotted-prefix-id source-name-id)]
        [final-id : i64 (ci.intern-dotted-final-id source-name-id)]
        [lookup-module-id : i64
          (if (csym.compiler-symbol-root-module-id? definition-module-id)
            cbi.compiler-builtin-id-fix-empty
            definition-module-id)]
        [full-binding-owner-module-id : i64
          (if (or (< full-module-id 0) (< final-id 0))
            -2
            (macro-hygiene-binding-owner-module-id-or
              hygiene
              full-module-id
              final-id
              -2))]
        (if (>= full-binding-owner-module-id -1)
          (macro-hygiene-global-id full-binding-owner-module-id final-id false)
          (if (or (< alias-id 0) (< tail-id 0))
            source-name-id
            (match (tc-lazy-import-stub-target-id-for-state
              state
              lookup-module-id
              alias-id)
              [(TcMaybeNameId.Some target-module-id)
                (let
                  [binding-owner-module-id : i64
                    (if (< (tc-name-first-dot-id tail-id) 0)
                      (macro-hygiene-binding-owner-module-id-or
                        hygiene
                        target-module-id
                        tail-id
                        target-module-id)
                      target-module-id)]
                  (macro-hygiene-global-id
                    binding-owner-module-id
                    tail-id
                    false))]
              [(TcMaybeNameId.No) source-name-id])))))))

(define (macro-hygiene-rename-var-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (let
    [template-source-id : i64 (tc-hygiene-template-source-id-or name-id -1)]
    [result : i64
      (if (tc-hygiene-template-name-id? name-id)
        (let
          [name : String (ci.intern-str template-source-id)]
          [base : String
            (if (ci.intern-template-source-id? name-id)
              name
              (tc-hygiene-template-base name))]
          [syntax-tag : i64
            (parser.compiler-parse-dispatch-tag-id
              (parser.compiler-parse-dispatch-env)
              template-source-id)]
          (match (macro-hygiene-env-lookup env name-id)
            [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
            [(MacroMaybeHygieneName.No)
              (if (or
                (not (= syntax-tag (parser.compiler-parse-tag-unknown)))
                (= template-source-id cbi.compiler-builtin-id-fix-colon)
                (ci.intern-colon-keyword-id? template-source-id))
                template-source-id
                (let
                  [source-name-id : i64 template-source-id]
                  [leading-id : i64 (ci.intern-leading-dot-id source-name-id)]
                  [renamed-leading-id : i64
                    (if (>= leading-id 0)
                      (match (macro-hygiene-env-lookup
                        env
                        (ci.intern-template-source-id leading-id))
                        [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
                        [(MacroMaybeHygieneName.No) -1])
                      -1)]
                  (if (>= renamed-leading-id 0)
                    (tc-dotted-name-with-source-id
                      renamed-leading-id
                      source-name-id)
                    (begin
                      (when
                        (< source-name-id 0)
                        (io.panic
                          (str_cat.str-cat
                            "typecheck: missing macro template source id: "
                            base)))
                      (if (and
                        (< (tc-name-first-dot-id source-name-id) 0)
                        (macro-hygiene-env-has-output-flat-import? env))
                        source-name-id
                        (macro-hygiene-global-name-id
                          env.state
                          source-name-id
                          macro-name))))))]))
        name-id)]
    result))

(define (macro-hygiene-bind-name-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [name-id : i64]) : MacroHygieneName
  (let
    [source-name-id : i64 (tc-hygiene-template-source-id-or name-id -1)]
    (if (tc-hygiene-template-name-id? name-id)
      (let
        [renamed-id : i64
          (macro-hygiene-local-id macro-name depth source-name-id)]
        (begin
          (when
            (< source-name-id 0)
            (io.panic "typecheck: missing macro template binding source id"))
          (MacroHygieneName.Name
            renamed-id
            (macro-hygiene-env-bind-raw env name-id renamed-id))))
      (MacroHygieneName.Name name-id env))))

;; A transformer appends newly constructed syntax after its bound operands and
;; captured source syntax. Hygiene may therefore rewrite a fresh node in place
;; when it has one reachable occurrence, while preserving the old copy path for
;; source/captured nodes and DAG nodes reused in multiple lexical contexts.
;;
;; Refcounts are saturated at two. When a second path reaches a node, its whole
;; descendant subgraph is marked shared as well: even a child with one incoming
;; AST edge is observed twice through a shared parent and must not retain the
;; hygiene environment from the first occurrence.
(defstruct TcMacroHygieneProducedStateData
  (active bool)
  (floor i64)
  (limit i64)
  (refcounts (__tl_dyn-array i64)))

(define (tc-macro-hygiene-produced-state-new) : TcMacroHygieneProducedStateData
  (TcMacroHygieneProducedStateData false 0 0 (array.make-array i64 0)))

(define (tc-macro-hygiene-produced-state-address-initialize
  [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-hygiene-produced)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcMacroHygieneProducedStateData)
              (array.make-array TcMacroHygieneProducedStateData 1)]
            [_init : unit
              (set! (array-ref cell 0) (tc-macro-hygiene-produced-state-new))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcMacroHygieneProducedStateData))))
                : i64)]
            (begin
              (tc-macro-state-slot-address-set!
                state
                tc-macro-state-slot-hygiene-produced
                next)
              next)))))))

(define (tc-macro-hygiene-produced-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    7
    tc-macro-hygiene-produced-state-address-initialize))

(define (tc-macro-hygiene-produced-state-data [state : TcMacroState]) : TcMacroHygieneProducedStateData
  (unsafe
    (ptr-read
      (int->ptr
        (cast (tc-macro-hygiene-produced-state-address state) : u64)
        : (Ptr TcMacroHygieneProducedStateData)))))

(define (tc-macro-hygiene-produced-state-data-set!
  [state : TcMacroState]
  [data : TcMacroHygieneProducedStateData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr
        (cast (tc-macro-hygiene-produced-state-address state) : u64)
        : (MutPtr TcMacroHygieneProducedStateData))
      data)))

(define (macro-hygiene-produced-eval-start-with-pools!
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]) : unit
  (let
    [produced : TcMacroHygieneProducedStateData
      (tc-macro-hygiene-produced-state-data state)]
    (begin
      (set! produced.active false)
      (set! produced.floor (ast.ast-node-pool-context-expr-len pools))
      (tc-macro-hygiene-produced-state-data-set! state produced))))

(define (macro-hygiene-produced-eval-start!
  [state : TcMacroState]
  [env : ctfe_support.CtfeEnv]) : unit
  (macro-hygiene-produced-eval-start-with-pools!
    state
    (ctfe_support.ctfe-env-syntax-pool-context env)))

(define (macro-hygiene-produced-refcounts-ensure!
  [state : TcMacroState]
  [needed : i64]) : unit
  (let
    [produced : TcMacroHygieneProducedStateData
      (tc-macro-hygiene-produced-state-data state)]
    (if (<= needed (array.length produced.refcounts))
      unit
      (let
        [capacity : i64
          (if (= (array.length produced.refcounts) 0)
            1
            (array.length produced.refcounts))]
        (begin
          (while (< capacity needed)
            (set! capacity (* capacity 2)))
          (in-arena
            (arena.Arena (tc-macro-state-owner-arena state))
            (begin
              (set! produced.refcounts (array.make-array i64 capacity))
              (tc-macro-hygiene-produced-state-data-set! state produced))))))))

(define (macro-hygiene-produced-note-id!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [expr-id : i64]
  [shared-path? : bool]) : unit
  (if (or (< expr-id produced.floor) (>= expr-id produced.limit))
    unit
    (let
      [index : i64 (- expr-id produced.floor)]
      [old : i64 (array-ref produced.refcounts index)]
      [next : i64
        (if shared-path?
          2
          (if (= old 0)
            1
            2))]
      (if (= old next)
        unit
        (begin
          (set! (array-ref produced.refcounts index) next)
          (macro-hygiene-produced-note-children!
            produced
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases expr-id)
            (= next 2)))))))

(define (macro-hygiene-produced-note-expr-list!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index exprs.len)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-expr-list-get (& exprs) index 0)
          shared-path?)
        (set! index (+ index 1))))))

(define (macro-hygiene-produced-note-let-bindings!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index (ast.ast-let-binding-list-len (& bindings)))
      (begin
        (match (ast.ast-let-binding-list-get
          (& bindings)
          index
          (ast.ast-let-binding-fallback))
          [(ast.AstLetBinding.Binding _ _ init-box)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              init-box
              shared-path?)])
        (set! index (+ index 1))))))

(define (macro-hygiene-produced-note-arms!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index arms.len)
      (begin
        (match (ast.ast-match-arm-list-get
          (& arms)
          index
          (ast.ast-match-arm-fallback))
          [(ast.AstMatchArm.Arm _ body-box)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              body-box
              shared-path?)])
        (set! index (+ index 1))))))

(define (macro-hygiene-produced-note-resource-bindings!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [shared-path? : bool]) : unit
  (let
    [index : i64 0]
    (while (< index (ast.ast-resource-binding-list-len (& bindings)))
      (begin
        (match (ast.ast-resource-binding-list-get
          (& bindings)
          index
          (ast.ast-resource-binding-fallback))
          [(ast.AstResourceBinding.Binding _ init-box cleanup-box _)
            (begin
              (macro-hygiene-produced-note-id!
                produced
                expr-bases
                init-box
                shared-path?)
              (macro-hygiene-produced-note-id!
                produced
                expr-bases
                cleanup-box
                shared-path?))])
        (set! index (+ index 1))))))

(define (macro-hygiene-produced-note-children!
  [produced : TcMacroHygieneProducedStateData]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [shared-path? : bool]) : unit
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    ;; A provenance marker encloses syntax that was already hygienized by the
    ;; expansion which produced it, or caller syntax intentionally captured by
    ;; a later expansion.  It is an ownership boundary for this hygiene pass.
    [(ast.AstExpr.MacroExpansion _ _ _) unit]
    [(ast.AstExpr.Binary _ left-box right-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          left-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          right-box
          shared-path?))]
    [(ast.AstExpr.Unary _ inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.Call func-box args)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          func-box
          shared-path?)
        (macro-hygiene-produced-note-expr-list!
          produced
          expr-bases
          args
          shared-path?))]
    [(ast.AstExpr.BracketClause items)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        items
        shared-path?)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          cond-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          then-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          else-box
          shared-path?))]
    [(ast.AstExpr.Let payload)
      (match (__tl-box-place payload)
        [(ast.AstLet.Let bindings body-box)
          (begin
            (macro-hygiene-produced-note-let-bindings!
              produced
              expr-bases
              bindings
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              body-box
              shared-path?))])]
    [(ast.AstExpr.Lambda payload)
      (match (__tl-box-place payload)
        [(ast.AstLambda.Lambda _ _ body-box)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            body-box
            shared-path?)])]
    [(ast.AstExpr.Tuple exprs)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        exprs
        shared-path?)]
    [(ast.AstExpr.TupleRef tuple-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        tuple-box
        shared-path?)]
    [(ast.AstExpr.Array exprs)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        exprs
        shared-path?)]
    [(ast.AstExpr.DynArray exprs)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        exprs
        shared-path?)]
    [(ast.AstExpr.MakeArray _ len-box)
      (macro-hygiene-produced-note-id! produced expr-bases len-box shared-path?)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          array-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          index-box
          shared-path?))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          array-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          index-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          array-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          live-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          index-box
          shared-path?))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          array-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          index-box
          shared-path?))]
    [(ast.AstExpr.Replace place-box replacement-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          place-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          replacement-box
          shared-path?))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          array-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?))]
    [(ast.AstExpr.StringRef string-box index-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          string-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          index-box
          shared-path?))]
    [(ast.AstExpr.While cond-box body-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          cond-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          body-box
          shared-path?))]
    [(ast.AstExpr.ForOwnedState payload)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-state-source-name (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-state-index-name (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-state-source (& payload))
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          (ast.ast-for-owned-state-body (& payload))
          shared-path?))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        (begin
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            (ast.ast-for-owned-step-source-name (& payload))
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            (ast.ast-for-owned-step-index-name (& payload))
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            (ast.ast-for-owned-step-binding-name (& payload))
            shared-path?)
          (when
            (>= expected-type 0)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              expected-type
              shared-path?))
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            (ast.ast-for-owned-step-done-name (& payload))
            shared-path?)
          (macro-hygiene-produced-note-id!
            produced
            expr-bases
            (ast.ast-for-owned-step-body (& payload))
            shared-path?)))]
    [(ast.AstExpr.Begin exprs)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        exprs
        shared-path?)]
    [(ast.AstExpr.Unsafe exprs)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        exprs
        shared-path?)]
    [(ast.AstExpr.Set _ value-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        value-box
        shared-path?)]
    [(ast.AstExpr.Ann inner-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.Cast inner-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.Borrow _ _ place-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        place-box
        shared-path?)]
    [(ast.AstExpr.Match payload)
      (match (__tl-box-place payload)
        [(ast.AstMatch.Match scrutinee-box arms)
          (begin
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              scrutinee-box
              shared-path?)
            (macro-hygiene-produced-note-arms!
              produced
              expr-bases
              arms
              shared-path?))])]
    [(ast.AstExpr.Foreach payload)
      (match (__tl-box-place payload)
        [(ast.AstForeach.Foreach _ _ start-box end-box body-box)
          (begin
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              start-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              end-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              body-box
              shared-path?))])]
    [(ast.AstExpr.SpmdReduce payload)
      (match (__tl-box-place payload)
        [(ast.AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (begin
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              start-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              end-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              init-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              value-box
              shared-path?))])]
    [(ast.AstExpr.SpmdScan payload)
      (match (__tl-box-place payload)
        [(ast.AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (begin
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              start-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              end-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              init-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              value-box
              shared-path?)
            (macro-hygiene-produced-note-id!
              produced
              expr-bases
              body-box
              shared-path?))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          lane-box
          shared-path?))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          lane-box
          shared-path?))]
    [(ast.AstExpr.StructGet receiver-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        receiver-box
        shared-path?)]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          receiver-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?))]
    [(ast.AstExpr.WithRegion _ body)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        body
        shared-path?)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          scratch-box
          shared-path?)
        (macro-hygiene-produced-note-expr-list!
          produced
          expr-bases
          body
          shared-path?))]
    [(ast.AstExpr.WithScratch body)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        body
        shared-path?)]
    [(ast.AstExpr.InArena arena-box body)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          arena-box
          shared-path?)
        (macro-hygiene-produced-note-expr-list!
          produced
          expr-bases
          body
          shared-path?))]
    [(ast.AstExpr.WithResource payload)
      (match (__tl-box-place payload)
        [(ast.AstWithResource.WithResource bindings body)
          (begin
            (macro-hygiene-produced-note-resource-bindings!
              produced
              expr-bases
              bindings
              shared-path?)
            (macro-hygiene-produced-note-expr-list!
              produced
              expr-bases
              body
              shared-path?))])]
    [(ast.AstExpr.Box inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.BoxGet inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.BoxTake inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          inner-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?))]
    [(ast.AstExpr.Comptime inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    ;; Quote payloads intentionally stay opaque to this hygiene walker.
    [(ast.AstExpr.Try inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.Return inner-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        inner-box
        shared-path?)]
    [(ast.AstExpr.PtrNullCheck ptr-box)
      (macro-hygiene-produced-note-id! produced expr-bases ptr-box shared-path?)]
    [(ast.AstExpr.PtrAddrOf place-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        place-box
        shared-path?)]
    [(ast.AstExpr.PtrRead ptr-box)
      (macro-hygiene-produced-note-id! produced expr-bases ptr-box shared-path?)]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          ptr-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          value-box
          shared-path?))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          ptr-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          offset-box
          shared-path?))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (macro-hygiene-produced-note-id! produced expr-bases ptr-box shared-path?)]
    [(ast.AstExpr.PtrToInt ptr-box)
      (macro-hygiene-produced-note-id! produced expr-bases ptr-box shared-path?)]
    [(ast.AstExpr.IntToPtr value-box _)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        value-box
        shared-path?)]
    [(ast.AstExpr.StringData string-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        string-box
        shared-path?)]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          ptr-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          len-box
          shared-path?))]
    [(ast.AstExpr.ArrayData array-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        array-box
        shared-path?)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          leaf-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          subleaf-box
          shared-path?))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          leaf-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          subleaf-box
          shared-path?))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          leaf-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          subleaf-box
          shared-path?))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (begin
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          leaf-box
          shared-path?)
        (macro-hygiene-produced-note-id!
          produced
          expr-bases
          subleaf-box
          shared-path?))]
    [(ast.AstExpr.Xgetbv index-box)
      (macro-hygiene-produced-note-id!
        produced
        expr-bases
        index-box
        shared-path?)]
    [(ast.AstExpr.Syscall args)
      (macro-hygiene-produced-note-expr-list!
        produced
        expr-bases
        args
        shared-path?)]
    [_ unit]))

(define (macro-hygiene-produced-prepare!
  [state : TcMacroState]
  [pools : ast.AstNodePoolContext]
  [expr-bases : i64]
  [root-id : i64]) : unit
  (let
    [produced : TcMacroHygieneProducedStateData
      (tc-macro-hygiene-produced-state-data state)]
    (begin
      (set! produced.limit (ast.ast-node-pool-context-expr-len pools))
      (tc-macro-hygiene-produced-state-data-set! state produced)
      (if (or (< produced.floor 0) (> produced.floor produced.limit))
        (begin
          (set! produced.active false)
          (tc-macro-hygiene-produced-state-data-set! state produced))
        (let
          [needed : i64 (- produced.limit produced.floor)]
          [index : i64 0]
          (begin
            (macro-hygiene-produced-refcounts-ensure! state needed)
            (set! produced (tc-macro-hygiene-produced-state-data state))
            (while (< index needed)
              (begin
                (set! (array-ref produced.refcounts index) 0)
                (set! index (+ index 1))))
            (set! produced.active true)
            (tc-macro-hygiene-produced-state-data-set! state produced)
            (macro-hygiene-produced-note-id! produced expr-bases root-id false)))))))

(define (macro-hygiene-produced-owned? [state : TcMacroState] [expr-id : i64]) : bool
  (let
    [produced : TcMacroHygieneProducedStateData
      (tc-macro-hygiene-produced-state-data state)]
    (and
      produced.active
      (>= expr-id produced.floor)
      (< expr-id produced.limit)
      (= (array-ref produced.refcounts (- expr-id produced.floor)) 1))))

(define (macro-hygiene-expr-list
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    (begin
      (macro-hygiene-expr-list-into
        expr-bases
        (& exprs)
        0
        env
        macro-name
        depth
        (&mut out))
      out)))

(define (macro-hygiene-expr-list-into
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstExprList)]) : unit
  (if (>= index exprs.len)
    unit
    (begin
      (ast.ast-expr-list-push
        out
        (macro-hygiene-expr
          expr-bases
          (ast.ast-expr-list-get exprs index 0)
          env
          macro-name
          depth))
      (macro-hygiene-expr-list-into
        expr-bases
        exprs
        (+ index 1)
        env
        macro-name
        depth
        out))))

(define (macro-hygiene-module-call-args
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    [index : i64 0]
    (begin
      (while (< index exprs.len)
        (begin
          (ast.ast-expr-list-push
            (&mut out)
            (if (= index 0)
              (ast.ast-expr-list-get (& exprs) index 0)
              (macro-hygiene-expr
                expr-bases
                (ast.ast-expr-list-get (& exprs) index 0)
                env
                macro-name
                depth)))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-output-call-env
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [env : MacroHygieneEnv]) : MacroHygieneEnv
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var head-id)
      (let
        [source-head-id : i64
          (tc-hygiene-template-source-id-or head-id head-id)]
        [tag : i64
          (parser.compiler-parse-dispatch-tag-id
            (parser.compiler-parse-dispatch-env)
            source-head-id)]
        [count : i64 args.len]
        (cond
          [(= tag (parser.compiler-parse-tag-decl-import))
            (macro-hygiene-output-import-env args env)]
          [(or
              (= tag (parser.compiler-parse-tag-decl-defenum))
              (= tag (parser.compiler-parse-tag-decl-defstruct)))
            (if (> count 0)
              (macro-hygiene-output-aggregate-member-list-env
                args
                1
                (= tag (parser.compiler-parse-tag-decl-defenum))
                (macro-hygiene-output-signature-env
                  expr-bases
                  (ast.ast-expr-segment-bases-get
                    expr-bases
                    (ast.ast-expr-list-get args 0 0))
                  env))
              env)]
          [(or
              (= tag (parser.compiler-parse-tag-decl-define))
              (= tag (parser.compiler-parse-tag-decl-extern))
              (= tag (parser.compiler-parse-tag-decl-defmacro))
              (= tag (parser.compiler-parse-tag-decl-defdispatch)))
            (if (> count 0)
              (macro-hygiene-output-signature-env
                expr-bases
                (ast.ast-expr-segment-bases-get
                  expr-bases
                  (ast.ast-expr-list-get args 0 0))
                env)
              env)]
          [else env]))]
    [_ env]))

(define (macro-hygiene-lifetime-list
  [lifetimes : ast.AstLifetimeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstLifetimeList
  (let
    [count : i64 (ast.ast-lifetime-list-len (& lifetimes))]
    [out : ast.AstLifetimeList (ast.ast-lifetime-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (ast.ast-lifetime-list-push
            (&mut out)
            (macro-hygiene-rename-lifetime-id
              env
              macro-name
              (ast.ast-lifetime-list-get
                (& lifetimes)
                index
                (ast.ast-lifetime-fallback))))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-rename-lifetime-id
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [name-id : i64]) : i64
  (match (macro-hygiene-env-lookup env name-id)
    [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
    [(MacroMaybeHygieneName.No)
      (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
        (match (macro-hygiene-env-lookup
          env
          (ci.intern-template-source-id name-id))
          [(MacroMaybeHygieneName.Some renamed-id) renamed-id]
          [(MacroMaybeHygieneName.No)
            (macro-hygiene-rename-var-id env macro-name name-id)])
        (macro-hygiene-rename-var-id env macro-name name-id))]))

(define (macro-hygiene-type-list
  [types : ast.AstTypeList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstTypeList
  (let
    [count : i64 (ast.ast-type-list-len (& types))]
    [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (ast.ast-type-list-push
            (&mut out)
            (ast.ast-node-pool-context-type-push
              env.pools
              (macro-hygiene-type
                (ast.ast-node-pool-context-type-get
                  env.pools
                  (ast.ast-type-list-get
                    (& types)
                    index
                    (ast.ast-type-id-fallback)))
                env
                macro-name)))
          (set! index (+ index 1))))
      out)))

(define (macro-hygiene-type
  [ty : ast.AstType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstType
  (match ty
    [(ast.AstType.Func args ret)
      (ast.ast-ty-func-with-pools
        env.pools
        (macro-hygiene-type-list (__tl-box-place args) env macro-name)
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools ret)
          env
          macro-name))]
    [(ast.AstType.Tuple elems)
      (ast.ast-ty-tuple
        (macro-hygiene-type-list (__tl-box-place elems) env macro-name))]
    [(ast.AstType.Array elem count)
      (ast.ast-ty-array-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name)
        count)]
    [(ast.AstType.DynArray elem)
      (ast.ast-ty-dyn-array-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name))]
    [(ast.AstType.Slice elem)
      (ast.ast-ty-slice-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name))]
    [(ast.AstType.Box elem)
      (ast.ast-ty-box-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name))]
    [(ast.AstType.Ptr elem)
      (ast.ast-ty-ptr-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name))]
    [(ast.AstType.MutPtr elem)
      (ast.ast-ty-mut-ptr-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools elem)
          env
          macro-name))]
    [(ast.AstType.Ref region inner)
      (ast.ast-ty-ref-with-pools
        env.pools
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools inner)
          env
          macro-name))]
    [(ast.AstType.MutRef region inner)
      (ast.ast-ty-mut-ref-with-pools
        env.pools
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools inner)
          env
          macro-name))]
    [(ast.AstType.Region region inner)
      (ast.ast-ty-region-with-pools
        env.pools
        (macro-hygiene-rename-lifetime-id env macro-name region)
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools inner)
          env
          macro-name))]
    [(ast.AstType.EnumArgs name lifetimes)
      (ast.ast-ty-enum-args
        name
        (macro-hygiene-lifetime-list (__tl-box-place lifetimes) env macro-name))]
    [(ast.AstType.StructArgs name lifetimes)
      (ast.ast-ty-struct-args
        name
        (macro-hygiene-lifetime-list (__tl-box-place lifetimes) env macro-name))]
    [(ast.AstType.VarArgs name lifetimes)
      (ast.ast-ty-var-args
        name
        (macro-hygiene-lifetime-list (__tl-box-place lifetimes) env macro-name))]
    [(ast.AstType.Consume inner)
      (ast.ast-ty-consume-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools inner)
          env
          macro-name))]
    [_ ty]))

(define (macro-hygiene-maybe-type
  [maybe-ty : ast.AstMaybeType]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstMaybeType
  (match maybe-ty
    [(ast.AstMaybeType.Some ty)
      (ast.AstMaybeType.Some (macro-hygiene-type ty env macro-name))]
    [(ast.AstMaybeType.No) ast.AstMaybeType.No]))

(define (macro-hygiene-borrow-lifetime
  [lifetime : ast.AstBorrowLifetime]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]) : ast.AstBorrowLifetime
  (match lifetime
    [(ast.AstBorrowLifetime.Named name)
      (ast.AstBorrowLifetime.Named
        (macro-hygiene-rename-lifetime-id env macro-name name))]
    [(ast.AstBorrowLifetime.Inferred) ast.AstBorrowLifetime.Inferred]))

(define (macro-hygiene-param-list
  [params : ast.AstParamList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (macro-hygiene-param-list-at (& params) 0 env macro-name depth))

(define (macro-hygiene-param-list-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneParams
  (if (>= index (ast.ast-param-list-len params))
    (MacroHygieneParams.Params (ast.ast-param-list-new) env)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty comptime? consume?)
        (let
          [nty : ast.AstType (macro-hygiene-type ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (match (macro-hygiene-param-list-at
                params
                (+ index 1)
                next-env
                macro-name
                depth)
                [(MacroHygieneParams.Params nrest final-env)
                  (MacroHygieneParams.Params
                    (ast.ast-param-cons
                      (ast.ast-param-id-with-consume
                        renamed-id
                        nty
                        comptime?
                        consume?)
                      nrest)
                    final-env)])]))])))

(define (macro-hygiene-pattern-list
  [patterns : ast.AstPatternList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-with-capacity patterns.len)]
    [final-env : MacroHygieneEnv
      (macro-hygiene-pattern-list-into
        (& patterns)
        0
        env
        macro-name
        depth
        (&mut out))]
    (MacroHygienePatternList.PatternList out final-env)))

(define (macro-hygiene-pattern-list-into
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstPatternList)]) : MacroHygieneEnv
  (if (>= index patterns.len)
    env
    (match (macro-hygiene-pattern
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
      env
      macro-name
      depth)
      [(MacroHygienePattern.Pattern npattern next-env)
        (begin
          (ast.ast-pattern-list-push out npattern)
          (macro-hygiene-pattern-list-into
            patterns
            (+ index 1)
            next-env
            macro-name
            depth
            out))])))

(define (macro-hygiene-pattern
  [pattern : ast.AstPattern]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygienePattern
  (match pattern
    [(ast.AstPattern.Var name maybe-ty)
      (let
        [nmaybe-ty : ast.AstMaybeType
          (macro-hygiene-maybe-type maybe-ty env macro-name)]
        (match (macro-hygiene-bind-name-id env macro-name depth name)
          [(MacroHygieneName.Name renamed-id next-env)
            (MacroHygienePattern.Pattern
              (ast.AstPattern.Var renamed-id nmaybe-ty)
              next-env)]))]
    [(ast.AstPattern.Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast.ast-pat-tuple npatterns) next-env)]))]
    [(ast.AstPattern.Array patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast.ast-pat-array npatterns) next-env)]))]
    [(ast.AstPattern.Wildcard)
      (MacroHygienePattern.Pattern ast.AstPattern.Wildcard env)]
    [(ast.AstPattern.Binding name)
      (let
        [source-name-id : i64 (tc-hygiene-template-source-id-or name name)]
        (if (>= (tc-name-first-dot-id source-name-id) 0)
          (MacroHygienePattern.Pattern
            (ast.ast-pat-binding-id
              (macro-hygiene-rename-var-id env macro-name name))
            env)
          (match (macro-hygiene-env-lookup-pattern-name env name)
            [(MacroMaybeHygieneName.Some pattern-name-id)
              (MacroHygienePattern.Pattern
                (ast.ast-pat-binding-id pattern-name-id)
                env)]
            [(MacroMaybeHygieneName.No)
              (match (macro-hygiene-bind-name-id env macro-name depth name)
                [(MacroHygieneName.Name renamed-id next-env)
                  (MacroHygienePattern.Pattern
                    (ast.ast-pat-binding-id renamed-id)
                    next-env)])])))]
    [(ast.AstPattern.Variant name args-box)
      (let
        [args : ast.AstPatternList (__tl-box-place args-box)]
        (match (macro-hygiene-pattern-list args env macro-name depth)
          [(MacroHygienePatternList.PatternList nargs next-env)
            (MacroHygienePattern.Pattern
              (ast.ast-pat-variant-id
                (macro-hygiene-rename-var-id env macro-name name)
                nargs)
              next-env)]))]
    [(ast.AstPattern.Literal lit)
      (MacroHygienePattern.Pattern (ast.AstPattern.Literal lit) env)]))

(define (macro-hygiene-let-bindings
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-let-bindings-into
        expr-bases
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneLetBindings.LetBindings out final-env)))

(define (macro-hygiene-let-bindings-into
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : MacroHygieneEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    env
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [ninit : i64
            (macro-hygiene-expr expr-bases init-box env macro-name depth)]
          [nmaybe-ty : ast.AstMaybeType
            (macro-hygiene-maybe-type maybe-ty env macro-name)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (begin
                (ast.ast-let-binding-list-push
                  out
                  (ast.ast-let-binding-id renamed-id nmaybe-ty ninit))
                (macro-hygiene-let-bindings-into
                  expr-bases
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-resource-bindings
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : MacroHygieneResourceBindings
  (let
    [out : ast.AstResourceBindingList
      (ast.ast-resource-binding-list-with-capacity
        (ast.ast-resource-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-resource-bindings-into
        expr-bases
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneResourceBindings.ResourceBindings out final-env)))

(define (macro-hygiene-resource-bindings-into
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [index : i64]
  [out : (&mut out ast.AstResourceBindingList)]) : MacroHygieneEnv
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    env
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name init-box cleanup-box move-aware?)
        (let
          [ninit : i64
            (macro-hygiene-expr expr-bases init-box env macro-name depth)]
          [ncleanup : i64
            (macro-hygiene-expr expr-bases cleanup-box env macro-name depth)]
          (match (macro-hygiene-bind-name-id env macro-name depth name)
            [(MacroHygieneName.Name renamed-id next-env)
              (begin
                (ast.ast-resource-binding-list-push
                  out
                  (ast.AstResourceBinding.Binding
                    renamed-id
                    ninit
                    ncleanup
                    move-aware?))
                (macro-hygiene-resource-bindings-into
                  expr-bases
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-arm-list
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : ast.AstMatchArmList
  (let
    [out : ast.AstMatchArmList (ast.ast-match-arm-list-with-capacity arms.len)]
    (begin
      (macro-hygiene-arm-list-into
        expr-bases
        (& arms)
        0
        env
        macro-name
        depth
        (&mut out))
      out)))

(define (macro-hygiene-arm-list-into
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]
  [out : (&mut out ast.AstMatchArmList)]) : unit
  (if (>= index arms.len)
    unit
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (match (macro-hygiene-pattern pattern env macro-name depth)
          [(MacroHygienePattern.Pattern npattern arm-env)
            (begin
              (ast.ast-match-arm-list-push
                out
                (ast.ast-match-arm
                  npattern
                  (macro-hygiene-expr
                    expr-bases
                    body-box
                    arm-env
                    macro-name
                    depth)))
              (macro-hygiene-arm-list-into
                expr-bases
                arms
                (+ index 1)
                env
                macro-name
                depth
                out))])])))

;; Profile shim and copy-on-write commit. The inner walker still constructs one
;; replacement node so its exhaustive syntax logic stays shared with captured
;; syntax. For an owned node, immediately move that replacement into the
;; transformer's original slot and rewind the one-node append.
(define (macro-hygiene-expr
  [expr-bases : i64]
  [expr-id : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (begin
    (cfg compile-profile (compiler-tc-walk-hygiene-start!))
    (let
      [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
      [result : i64
        (macro-hygiene-expr-inner expr-bases expr env macro-name depth)]
      [reuse? : bool
        (and
          (macro-hygiene-produced-owned? env.state expr-id)
          (= (+ result 1) (ast.ast-node-pool-context-expr-len env.pools)))]
      [out : i64
        (if reuse?
          (let
            [replacement : ast.AstExpr
              (ast.ast-node-pool-context-expr-get env.pools result)]
            (begin
              (ast.ast-node-pool-context-expr-set!
                env.pools
                expr-id
                replacement)
              (ast.ast-node-pool-context-expr-truncate! env.pools result)
              expr-id))
          result)]
      (begin
        (cfg
          compile-profile
          (if reuse?
            (set!
              compiler-tc-walk-hygiene-nodes-reused
              (+ compiler-tc-walk-hygiene-nodes-reused 1))
            (set!
              compiler-tc-walk-hygiene-nodes-copied
              (+ compiler-tc-walk-hygiene-nodes-copied 1))))
        (cfg compile-profile (compiler-tc-walk-hygiene-finish!))
        out))))

;; Include ownership discovery in the hygiene profile lane, then disable the
;; transient side table before produced-node expansion starts.
(define (macro-hygiene-produced-expr
  [expr-id : i64]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (begin
    (cfg compile-profile (compiler-tc-walk-hygiene-start!))
    (let
      [expr-bases : i64
        (ast.ast-node-pool-context-expr-segment-bases env.pools)]
      [_prepare : unit
        (macro-hygiene-produced-prepare! env.state env.pools expr-bases expr-id)]
      [result : i64
        (macro-hygiene-expr expr-bases expr-id env macro-name depth)]
      [produced : TcMacroHygieneProducedStateData
        (tc-macro-hygiene-produced-state-data env.state)]
      (begin
        (set! produced.active false)
        (tc-macro-hygiene-produced-state-data-set! env.state produced)
        ;; The recursive walker uses one-node copy-on-write replacements. Keep
        ;; those transient cursors private and publish only the committed root.
        (ast.ast-node-pool-context-expr-sync-installed! env.pools)
        (cfg compile-profile (compiler-tc-walk-hygiene-finish!))
        result))))

(define (macro-hygiene-expr-inner
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [env : MacroHygieneEnv]
  [macro-name : MacroHygieneContext]
  [depth : i64]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-spanned-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          span))]
    ;; Do not apply a later expansion's hygiene environment to syntax behind a
    ;; provenance boundary.  Macro discovery still walks through the marker so
    ;; nested, not-yet-expanded calls can fire in their own hygiene pass.
    [(ast.AstExpr.MacroExpansion _ _ _)
      (ast.ast-node-pool-context-expr-push env.pools expr)]
    [(ast.AstExpr.Var name)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.Var (macro-hygiene-rename-var-id env macro-name name)))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : i64 left-box]
        [right : i64 right-box]
        (ast.ast-expr-binary-with-pools
          env.pools
          op
          (macro-hygiene-expr expr-bases left env macro-name depth)
          (macro-hygiene-expr expr-bases right env macro-name depth)))]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-unary-with-pools
          env.pools
          op
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [call-env : MacroHygieneEnv
          (macro-hygiene-output-call-env expr-bases func (& args) env)]
        (ast.ast-expr-call-with-pools
          env.pools
          (macro-hygiene-expr expr-bases func-box env macro-name depth)
          (match (ast.ast-expr-unspan func)
            [(ast.AstExpr.Var name-id)
              (if (=
                (tc-hygiene-template-source-id-or name-id name-id)
                cbi.compiler-builtin-id-fix-module)
                (macro-hygiene-module-call-args
                  expr-bases
                  args
                  env
                  macro-name
                  depth)
                (macro-hygiene-expr-list
                  expr-bases
                  args
                  call-env
                  macro-name
                  depth))]
            [_
              (macro-hygiene-expr-list
                expr-bases
                args
                call-env
                macro-name
                depth)])))]
    [(ast.AstExpr.BracketClause items)
      (ast.ast-expr-bracket-clause-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases items env macro-name depth))]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : i64 cond-box]
        [then-branch : i64 then-branch-box]
        [else-branch : i64 else-branch-box]
        (ast.ast-expr-if-with-pools
          env.pools
          (macro-hygiene-expr expr-bases cond env macro-name depth)
          (macro-hygiene-expr expr-bases then-branch env macro-name depth)
          (macro-hygiene-expr expr-bases else-branch env macro-name depth)))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : i64 body-box]
            (match (macro-hygiene-let-bindings
              expr-bases
              bindings
              env
              macro-name
              depth)
              [(MacroHygieneLetBindings.LetBindings nbindings body-env)
                (ast.ast-expr-let-with-pools
                  env.pools
                  nbindings
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : i64 body-box]
            (match (macro-hygiene-param-list params env macro-name depth)
              [(MacroHygieneParams.Params nparams body-env)
                (ast.ast-expr-lambda-with-pools
                  env.pools
                  nparams
                  (macro-hygiene-maybe-type maybe-ret body-env macro-name)
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))])]
    [(ast.AstExpr.Tuple exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.Tuple
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(ast.AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : i64 tuple-expr-box]
        (ast.ast-expr-tuple-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases tuple-expr env macro-name depth)
          index))]
    [(ast.AstExpr.Array exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.Array
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(ast.AstExpr.DynArray exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.DynArray
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(ast.AstExpr.MakeArray ty-id len-box)
      (let
        [len : i64 len-box]
        (ast.ast-expr-make-array-with-pools
          env.pools
          (macro-hygiene-type
            (ast.ast-node-pool-context-type-get env.pools ty-id)
            env
            macro-name)
          (macro-hygiene-expr expr-bases len env macro-name depth)))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : i64 array-box]
        [index : i64 index-box]
        (ast.ast-expr-array-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : i64 array-box]
        [index : i64 index-box]
        [value : i64 value-box]
        (ast.ast-expr-array-set-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : i64 array-box]
        [live : i64 live-box]
        [index : i64 index-box]
        (ast.ast-expr-array-take-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases live env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (ast.ast-expr-fixed-array-take-with-pools
        env.pools
        (macro-hygiene-expr expr-bases array-box env macro-name depth)
        (macro-hygiene-expr expr-bases index-box env macro-name depth))]
    [(ast.AstExpr.Replace place-box replacement-box)
      (ast.ast-expr-replace-with-pools
        env.pools
        (macro-hygiene-expr expr-bases place-box env macro-name depth)
        (macro-hygiene-expr expr-bases replacement-box env macro-name depth))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (let
        [array : i64 array-box]
        [value : i64 value-box]
        (ast.ast-expr-array-push-with-pools
          env.pools
          (macro-hygiene-expr expr-bases array env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ast.AstExpr.StringRef text-box index-box)
      (let
        [text : i64 text-box]
        [index : i64 index-box]
        (ast.ast-expr-string-ref-with-pools
          env.pools
          (macro-hygiene-expr expr-bases text env macro-name depth)
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : i64 cond-box]
        [body : i64 body-box]
        (ast.ast-expr-while-with-pools
          env.pools
          (macro-hygiene-expr expr-bases cond env macro-name depth)
          (macro-hygiene-expr expr-bases body env macro-name depth)))]
    [(ast.AstExpr.ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source : i64 (ast.ast-for-owned-state-source (& payload))]
        [body : i64 (ast.ast-for-owned-state-body (& payload))]
        [source-name-id : i64 (tc-for-owned-name-id expr-bases source-name)]
        [index-name-id : i64 (tc-for-owned-name-id expr-bases index-name)]
        (if (or (< source-name-id 0) (< index-name-id 0))
          (ast.ast-expr-for-owned-state-with-pools
            env.pools
            (macro-hygiene-expr expr-bases source-name env macro-name depth)
            (macro-hygiene-expr expr-bases index-name env macro-name depth)
            (macro-hygiene-expr expr-bases source env macro-name depth)
            (macro-hygiene-expr expr-bases body env macro-name depth))
          (match (macro-hygiene-bind-name-id
            env
            macro-name
            depth
            source-name-id)
            [(MacroHygieneName.Name nsource-name source-env)
              (match (macro-hygiene-bind-name-id
                source-env
                macro-name
                depth
                index-name-id)
                [(MacroHygieneName.Name nindex-name body-env)
                  (ast.ast-expr-for-owned-state-with-pools
                    env.pools
                    (ast.ast-node-pool-context-expr-push
                      env.pools
                      (ast.AstExpr.Var nsource-name))
                    (ast.ast-node-pool-context-expr-push
                      env.pools
                      (ast.AstExpr.Var nindex-name))
                    (macro-hygiene-expr expr-bases source env macro-name depth)
                    (macro-hygiene-expr
                      expr-bases
                      body
                      body-env
                      macro-name
                      depth))])])))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name-id : i64 (tc-for-owned-name-id expr-bases binding-name)]
        (if (< binding-name-id 0)
          (ast.ast-expr-for-owned-step-with-pools
            env.pools
            (macro-hygiene-expr expr-bases source-name env macro-name depth)
            (macro-hygiene-expr expr-bases index-name env macro-name depth)
            (macro-hygiene-expr expr-bases binding-name env macro-name depth)
            (if (>= expected-type 0)
              (macro-hygiene-expr expr-bases expected-type env macro-name depth)
              -1)
            (macro-hygiene-expr expr-bases done-name env macro-name depth)
            (macro-hygiene-expr expr-bases body env macro-name depth))
          (let
            ;; This binder is reconstructed from the user clause's name. Map
            ;; its generated template identity back to that source identity so
            ;; captured body references (including a nested `for` source) and
            ;; generated cleanup references resolve to the same local.
            [nbinding-name : i64
              (tc-hygiene-template-source-id-or binding-name-id binding-name-id)]
            [body-env : MacroHygieneEnv
              (macro-hygiene-env-bind-raw env binding-name-id nbinding-name)]
            (ast.ast-expr-for-owned-step-with-pools
              env.pools
              (macro-hygiene-expr expr-bases source-name env macro-name depth)
              (macro-hygiene-expr expr-bases index-name env macro-name depth)
              (ast.ast-node-pool-context-expr-push
                env.pools
                (ast.AstExpr.Var nbinding-name))
              (if (>= expected-type 0)
                (macro-hygiene-expr
                  expr-bases
                  expected-type
                  env
                  macro-name
                  depth)
                -1)
              (macro-hygiene-expr expr-bases done-name env macro-name depth)
              (macro-hygiene-expr expr-bases body body-env macro-name depth)))))]
    [(ast.AstExpr.Begin exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.Begin
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(ast.AstExpr.Unsafe exprs)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.Unsafe
          (macro-hygiene-expr-list expr-bases exprs env macro-name depth)))]
    [(ast.AstExpr.Set name rhs-box)
      (let
        [rhs : i64 rhs-box]
        (ast.ast-expr-set-id-with-pools
          env.pools
          (macro-hygiene-rename-var-id env macro-name name)
          (macro-hygiene-expr expr-bases rhs env macro-name depth)))]
    [(ast.AstExpr.Ann inner-box ty-id)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-ann-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (macro-hygiene-type
            (ast.ast-node-pool-context-type-get env.pools ty-id)
            env
            macro-name)))]
    [(ast.AstExpr.Cast inner-box ty-id)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-cast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (macro-hygiene-type
            (ast.ast-node-pool-context-type-get env.pools ty-id)
            env
            macro-name)))]
    [(ast.AstExpr.Borrow mutable lifetime-id place-box)
      (let
        [place : i64 place-box]
        (ast.ast-expr-borrow-with-pools
          env.pools
          mutable
          (macro-hygiene-borrow-lifetime
            (ast.ast-borrow-lifetime-from-id lifetime-id)
            env
            macro-name)
          (macro-hygiene-expr expr-bases place env macro-name depth)))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (let
            [scrut : i64 scrut-box]
            (ast.ast-expr-match-with-pools
              env.pools
              (macro-hygiene-expr expr-bases scrut env macro-name depth)
              (macro-hygiene-arm-list expr-bases arms env macro-name depth)))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [body : i64 body-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id body-env)
                (ast.ast-expr-foreach-id-with-pools
                  env.pools
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr expr-bases start env macro-name depth)
                  (macro-hygiene-expr expr-bases end env macro-name depth)
                  (macro-hygiene-expr expr-bases body body-env macro-name depth))]))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(ast.AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [init : i64 init-box]
            [value : i64 value-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id body-env)
                (ast.ast-expr-spmd-reduce-id-with-pools
                  env.pools
                  op
                  nindex-id
                  (macro-hygiene-type index-ty env macro-name)
                  (macro-hygiene-expr expr-bases start env macro-name depth)
                  (macro-hygiene-expr expr-bases end env macro-name depth)
                  (macro-hygiene-expr expr-bases init env macro-name depth)
                  (macro-hygiene-expr
                    expr-bases
                    value
                    body-env
                    macro-name
                    depth))]))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(ast.AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : i64 start-box]
            [end : i64 end-box]
            [init : i64 init-box]
            [value : i64 value-box]
            [body : i64 body-box]
            (match (macro-hygiene-bind-name-id env macro-name depth index)
              [(MacroHygieneName.Name nindex-id value-env)
                (match (macro-hygiene-bind-name-id
                  value-env
                  macro-name
                  depth
                  prefix)
                  [(MacroHygieneName.Name nprefix-id body-env)
                    (ast.ast-expr-spmd-scan-id-with-pools
                      env.pools
                      op
                      nindex-id
                      (macro-hygiene-type index-ty env macro-name)
                      (macro-hygiene-expr expr-bases start env macro-name depth)
                      (macro-hygiene-expr expr-bases end env macro-name depth)
                      nprefix-id
                      (macro-hygiene-type prefix-ty value-env macro-name)
                      (macro-hygiene-expr expr-bases init env macro-name depth)
                      (macro-hygiene-expr
                        expr-bases
                        value
                        value-env
                        macro-name
                        depth)
                      (macro-hygiene-expr
                        expr-bases
                        body
                        body-env
                        macro-name
                        depth))])]))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : i64 value-box]
        [lane : i64 lane-box]
        (ast.ast-expr-spmd-broadcast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (macro-hygiene-expr expr-bases lane env macro-name depth)))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : i64 value-box]
        [lane : i64 lane-box]
        (ast.ast-expr-spmd-shuffle-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (macro-hygiene-expr expr-bases lane env macro-name depth)))]
    [(ast.AstExpr.StructGet inner-box field)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-struct-get-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          field))]
    [(ast.AstExpr.StructSet inner-box field value-box)
      (let
        [inner : i64 inner-box]
        [value : i64 value-box]
        (ast.ast-expr-struct-set-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          field
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ast.AstExpr.WithRegion name body)
      (match (macro-hygiene-bind-name-id env macro-name depth name)
        [(MacroHygieneName.Name nname-id body-env)
          (ast.ast-node-pool-context-expr-push
            env.pools
            (ast.AstExpr.WithRegion
              nname-id
              (macro-hygiene-expr-list
                expr-bases
                body
                body-env
                macro-name
                depth)))])]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : i64 scratch-box]
        (ast.ast-expr-with-escape-with-pools
          env.pools
          (macro-hygiene-expr expr-bases scratch env macro-name depth)
          (macro-hygiene-expr-list expr-bases body env macro-name depth)))]
    [(ast.AstExpr.WithScratch body)
      (ast.ast-expr-with-scratch-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases body env macro-name depth))]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : i64 arena-box]
        (ast.ast-expr-in-arena-with-pools
          env.pools
          (macro-hygiene-expr expr-bases arena env macro-name depth)
          (macro-hygiene-expr-list expr-bases body env macro-name depth)))]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (match (macro-hygiene-resource-bindings
            expr-bases
            bindings
            env
            macro-name
            depth)
            [(MacroHygieneResourceBindings.ResourceBindings nbindings body-env)
              (ast.ast-node-pool-context-expr-push
                env.pools
                (ast.AstExpr.WithResource
                  (box
                    (ast.AstWithResource.WithResource
                      nbindings
                      (macro-hygiene-expr-list
                        expr-bases
                        body
                        body-env
                        macro-name
                        depth)))))])])]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-get-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-box-take-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : i64 inner-box]
        [value : i64 value-box]
        (ast.ast-expr-box-set-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ast.AstExpr.TypeLiteral ty-id)
      (ast.ast-expr-type-literal-with-pools
        env.pools
        (macro-hygiene-type
          (ast.ast-node-pool-context-type-get env.pools ty-id)
          env
          macro-name))]
    [(ast.AstExpr.Init maybe-ty-id)
      (ast.ast-expr-init-maybe-with-pools
        env.pools
        (macro-hygiene-maybe-type
          (ast.ast-maybe-type-from-id maybe-ty-id)
          env
          macro-name))]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-comptime-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.Return inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-return-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-try-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.PtrNull ty-id)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.PtrNull
          (ast.ast-node-pool-context-type-push
            env.pools
            (macro-hygiene-type
              (ast.ast-node-pool-context-type-get env.pools ty-id)
              env
              macro-name))))]
    [(ast.AstExpr.PtrNullCheck ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-null-check-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : i64 place-box]
        (ast.ast-expr-ptr-addr-of-id-with-pools
          env.pools
          (macro-hygiene-expr expr-bases place env macro-name depth)))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-read-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : i64 ptr-box]
        [value : i64 value-box]
        (ast.ast-expr-ptr-write-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases value env macro-name depth)))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : i64 ptr-box]
        [offset : i64 offset-box]
        (ast.ast-expr-ptr-offset-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases offset env macro-name depth)))]
    [(ast.AstExpr.PtrCast ptr-box ty-id)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-cast-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-type
            (ast.ast-node-pool-context-type-get env.pools ty-id)
            env
            macro-name)))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : i64 ptr-box]
        (ast.ast-expr-ptr-to-int-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)))]
    [(ast.AstExpr.IntToPtr value-box ty-id)
      (let
        [value : i64 value-box]
        (ast.ast-expr-int-to-ptr-with-pools
          env.pools
          (macro-hygiene-expr expr-bases value env macro-name depth)
          (macro-hygiene-type
            (ast.ast-node-pool-context-type-get env.pools ty-id)
            env
            macro-name)))]
    [(ast.AstExpr.StringData inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-string-data-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : i64 ptr-box]
        [len : i64 len-box]
        (ast.ast-expr-string-from-bytes-with-pools
          env.pools
          (macro-hygiene-expr expr-bases ptr env macro-name depth)
          (macro-hygiene-expr expr-bases len env macro-name depth)))]
    [(ast.AstExpr.ArrayData inner-box)
      (let
        [inner : i64 inner-box]
        (ast.ast-expr-array-data-with-pools
          env.pools
          (macro-hygiene-expr expr-bases inner env macro-name depth)))]
    [(ast.AstExpr.BinaryData bytes)
      (ast.ast-node-pool-context-expr-push
        env.pools
        (ast.AstExpr.BinaryData bytes))]
    [(ast.AstExpr.SpmdProgramIndex)
      (ast.ast-expr-spmd-program-index-with-pools env.pools)]
    [(ast.AstExpr.SpmdProgramCount)
      (ast.ast-expr-spmd-program-count-with-pools env.pools)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-eax-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-ebx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-ecx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : i64 leaf-box]
        [subleaf : i64 subleaf-box]
        (ast.ast-expr-cpuid-edx-with-pools
          env.pools
          (macro-hygiene-expr expr-bases leaf env macro-name depth)
          (macro-hygiene-expr expr-bases subleaf env macro-name depth)))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : i64 index-box]
        (ast.ast-expr-xgetbv-with-pools
          env.pools
          (macro-hygiene-expr expr-bases index env macro-name depth)))]
    [(ast.AstExpr.Syscall args)
      (ast.ast-expr-syscall-with-pools
        env.pools
        (macro-hygiene-expr-list expr-bases args env macro-name depth))]
    [(ast.AstExpr.Quote _) (ast.ast-node-pool-context-expr-push env.pools expr)]
    [(ast.AstExpr.Quasiquote _)
      (ast.ast-node-pool-context-expr-push env.pools expr)]
    [(ast.AstExpr.Unquote _)
      (ast.ast-node-pool-context-expr-push env.pools expr)]
    [(ast.AstExpr.UnquoteSplicing _)
      (ast.ast-node-pool-context-expr-push env.pools expr)]
    [_ (ast.ast-node-pool-context-expr-push env.pools expr)]))

(test
  macro-hygiene-explicit-pool-isolation
  (let
    [installed-len : i64 (ast.ast-node-pool-len)]
    [pools-a : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 16 16)]
    [pools-b : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 16 16)]
    [type-a : i64
      (ast.ast-node-pool-context-type-push pools-a (ast.AstType.I64))]
    [type-b : i64
      (ast.ast-node-pool-context-type-push pools-b (ast.AstType.Bool))]
    [state-a : TcMacroState (tc-job-state-macro-state (tc-job-state-new))]
    [state-b : TcMacroState (tc-job-state-macro-state (tc-job-state-new))]
    [_start-a : unit
      (macro-hygiene-produced-eval-start-with-pools! state-a pools-a)]
    [_start-b : unit
      (macro-hygiene-produced-eval-start-with-pools! state-b pools-b)]
    [root-a : i64
      (ast.ast-node-pool-context-expr-push
        pools-a
        (ast.AstExpr.TypeLiteral type-a))]
    [root-b : i64
      (ast.ast-node-pool-context-expr-push
        pools-b
        (ast.AstExpr.TypeLiteral type-b))]
    [hygiene-a : MacroHygieneContext
      (MacroHygieneContext 0 0 0 (csym.compiler-symbols-empty))]
    [hygiene-b : MacroHygieneContext
      (MacroHygieneContext 0 0 0 (csym.compiler-symbols-empty))]
    [out-a : i64
      (macro-hygiene-produced-expr
        root-a
        (macro-hygiene-env-empty state-a pools-a)
        hygiene-a
        0)]
    [out-b : i64
      (macro-hygiene-produced-expr
        root-b
        (macro-hygiene-env-empty state-b pools-b)
        hygiene-b
        0)]
    [a-ok? : bool
      (match (ast.ast-node-pool-context-expr-get pools-a out-a)
        [(ast.AstExpr.TypeLiteral ty-id)
          (match (ast.ast-node-pool-context-type-get pools-a ty-id)
            [(ast.AstType.I64) true]
            [_ false])]
        [_ false])]
    [b-ok? : bool
      (match (ast.ast-node-pool-context-expr-get pools-b out-b)
        [(ast.AstExpr.TypeLiteral ty-id)
          (match (ast.ast-node-pool-context-type-get pools-b ty-id)
            [(ast.AstType.Bool) true]
            [_ false])]
        [_ false])]
    (if (and
      a-ok?
      b-ok?
      (= out-a root-a)
      (= out-b root-b)
      (= (ast.ast-node-pool-context-expr-len pools-a) 1)
      (= (ast.ast-node-pool-context-expr-len pools-b) 1)
      (= (ast.ast-node-pool-len) installed-len))
      unit
      (io.panic "typecheck: macro hygiene explicit pool isolation failed"))))

(define (macro-expand-depth-limit) : i64
  512)

(define (macro-decl-from-decl
  [decl : ast.AstDecl]
  [module-id : i64]
  [declaration-id : i64]) : MacroMaybeDecl
  (match decl
    [(ast.AstDecl.DefMacro decl-meta name params ret body-box)
      (let
        [body : ast.AstExpr (ast.ast-node-get body-box)]
        (MacroMaybeDecl.Some name module-id declaration-id params ret body))]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (macro-decl-from-decl inner module-id declaration-id))]
    [_ (MacroMaybeDecl.No)]))

;; Resolve a macro decl from its symbol-table index in O(1). The symbols decls
;; array is populated (compiler-symbols-index-decl!) at the SAME index that
;; compiler-symbol-handle-index returns: build-compiler-symbol-list-in-module
;; writes the array slot and registers the handle with one shared `index`,
;; skipping the identical Import/IncludeStr/IncludeBin/Export/Module/Test set
;; that the old linear scan skipped. The array already stores the unwrapped decl
;; (compiler-symbol-indexed-decl peels AstDecl.Unsafe the same
;; way macro-decl-from-decl does), so direct module lookups return the identical
;; MacroMaybeDecl.Some the previous O(decls) macro-find-decl-by-index walk produced.
(define (macro-decl-owner-module-or
  [symbols : csym.CompilerSymbols]
  [target : i64]
  [fallback-id : i64]) : i64
  (let
    [module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        symbols
        target
        (csym.compiler-symbol-root-module-id))]
    (if (csym.compiler-symbol-root-module-id? module-id)
      fallback-id
      module-id)))

;; Imported macro aliases can be looked up from the importing module. In that
;; path, use the indexed owner module so the transformer still runs as its
;; original definition module. The dense declaration ID is carried with it.
(define (macro-decl-at-index-with-owner-module
  [_ctx : TcContext]
  [symbols : csym.CompilerSymbols]
  [target : i64]
  [module-id : i64]) : MacroMaybeDecl
  (match (csym.compiler-symbols-decl-at-index symbols target)
    [(parser.ResultAstDecl.Ok decl)
      (macro-decl-from-decl
        decl
        (macro-decl-owner-module-or symbols target module-id)
        target)]
    [(parser.ResultAstDecl.Err _) (MacroMaybeDecl.No)]))

;; The module accumulator and the current module compare as INTERN IDS: the
;; previous String-based walk converted every AstDecl.Module's interned name
;; back to a fresh String (`intern-str` allocates) and string-compared it, for
;; every declaration walked, on every qualified-alias resolution -- 11.6% of
;; the stage2 self-compile CPU profile. Import aliases still compare by
;; content, but only for imports declared in the current module.
(define (macro-import-kind-module-alias? [kind : ast.AstImportKind]) : bool
  (match kind
    [(ast.AstImportKind.Module) true]
    [(ast.AstImportKind.Macro _ _) true]
    [(ast.AstImportKind.MacroDecls _ _) true]
    [(ast.AstImportKind.ModuleAll) false]
    [(ast.AstImportKind.ModuleItem _) false]))

(test
  macro-import-kind-module-alias-classification
  (begin
    (test.assert-true
      (macro-import-kind-module-alias? ast.AstImportKind.Module)
      "file module imports bind module aliases")
    (test.assert-true
      (macro-import-kind-module-alias?
        (ast.AstImportKind.Macro 0 ast.AstMaybeModuleName.No))
      "expression module macros bind module aliases")
    (test.assert-true
      (macro-import-kind-module-alias?
        (ast.AstImportKind.MacroDecls 0 ast.AstMaybeModuleName.No))
      "declaration module macros bind module aliases")
    (test.assert-false
      (macro-import-kind-module-alias? ast.AstImportKind.ModuleAll)
      "wildcard imports do not bind module aliases")
    (test.assert-false
      (macro-import-kind-module-alias? (ast.AstImportKind.ModuleItem 0))
      "selected imports do not bind module aliases")))

(define (macro-import-alias-target-from-spec
  [spec : ast.AstImportSpec]
  [alias-id : i64]) : TcMaybeNameId
  (match spec
    [(ast.AstImportSpec.Spec kind _ expected maybe-alias _)
      ;; This lookup walks declarations for every uncached qualified macro
      ;; alias. Keep the cheap alias rejection before import-kind
      ;; classification so unrelated imports do not pay for the enum match.
      (match maybe-alias
        [(ast.AstMaybeImportAlias.Some import-alias)
          (if (= import-alias alias-id)
            (if (macro-import-kind-module-alias? kind)
              (match expected
                [(ast.AstMaybeModuleName.Some target)
                  (TcMaybeNameId.Some target)]
                [(ast.AstMaybeModuleName.No) (TcMaybeNameId.Some alias-id)])
              (TcMaybeNameId.No))
            (TcMaybeNameId.No))]
        [(ast.AstMaybeImportAlias.No) (TcMaybeNameId.No)])]))

(define (macro-import-alias-target-from-wrapped-decl
  [decl : ast.AstDecl]
  [alias-id : i64]) : TcMaybeNameId
  (match (ast.ast-decl-unwrapped decl)
    [(ast.AstDecl.Import decl-meta spec)
      (macro-import-alias-target-from-spec spec alias-id)]
    [_ (TcMaybeNameId.No)]))

(define (macro-import-alias-target-ids
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : TcMaybeNameId
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [slot : i64 (tc-module-decl-index-slot current-module-id)]
    [decl-offset : i64 decls.offset]
    [result : TcMaybeNameId (TcMaybeNameId.No)]
    (if (< slot 0)
      result
      (let
        [index : i64 (array-ref tc-module-import-index-starts slot)]
        [end : i64 (array-ref tc-module-import-index-ends slot)]
        [done : bool false]
        (begin
          (while (and (not done) (< index end))
            (let
              [position : i64
                (array-ref tc-module-import-index-positions index)]
              [target : TcMaybeNameId
                (macro-import-alias-target-from-wrapped-decl
                  (array-ref decls.slots (+ decl-offset position))
                  alias-id)]
              (begin
                (match target
                  [(TcMaybeNameId.Some target-id)
                    (if (= target-id alias-id)
                      (match result
                        [(TcMaybeNameId.No)
                          (set! result (TcMaybeNameId.Some alias-id))]
                        [_ unit])
                      (begin
                        (set! result (TcMaybeNameId.Some target-id))
                        (set! done true)))]
                  [(TcMaybeNameId.No) unit])
                (set! index (+ index 1)))))
          result)))))

;; --- import-aware macro resolution caches -------------------------------------
;;
;; Qualified-alias lookup and unqualified flat-import lookup both derive from the
;; program's AstDecl.Module/AstDecl.Import declarations. Cache them at the same
;; per-program boundary so generated macro bodies do not repeatedly rescan the
;; whole declaration list.
(defstruct MacroFlatImportTargetList
  (slots (__tl_dyn-array i64))
  (len i64))

(defenum MacroFlatImportTargetCacheLookup
  (Missing)
  (Hit MacroFlatImportTargetList))

;; Even with id compares, each resolution walks the ENTIRE declaration list
;; (most declarations are neither modules nor imports), and the same
;; (current-module, qualifier) pair resolves identically for the whole
;; program: the mapping is derived only from AstDecl.Module/AstDecl.Import
;; declarations, which macro expansion, comptime generation, and
;; specialization never insert or reorder mid-compile. Memoize per
;; generation (same idiom as the marker name-id memos), open-addressed and
;; keyed by the two intern ids. Module key slots store module-id+1 so the zeroed
;; table is empty; qualifier slots store qualifier-id+1, and values store the
;; resolved target's intern id, -1 for "no alias import", or -3 for an alias
;; definitively resolved to its own qualifier id. The distinct self sentinel
;; prevents every later query from rescanning that module while still allowing
;; a subsequently materialized lazy-import stub to replace it. Inserts stop at
;; half load -- only memoization, never correctness, degrades.
(defstruct TcMacroImportIndexStateData
  (alias-module-keys (__tl_dyn-array i64))
  (alias-qualifier-keys (__tl_dyn-array i64))
  (alias-values (__tl_dyn-array i64))
  (unqualified-module-keys (__tl_dyn-array i64))
  (unqualified-name-keys (__tl_dyn-array i64))
  (unqualified-values (__tl_dyn-array i64))
  (flat-module-keys (__tl_dyn-array i64))
  (flat-values (__tl_dyn-array MacroFlatImportTargetList))
  ;; Scalar slots, kept in shared storage so nested index builders can update
  ;; them without a process-global selector or copying the state carrier.
  ;; 0..10 alias, 11..14 unqualified, 15..22 flat-import targets.
  (control (__tl_dyn-array i64)))

(define (tc-macro-import-index-state-new) : TcMacroImportIndexStateData
  (let
    [control : (__tl_dyn-array i64) (array.make-array i64 23)]
    (begin
      (set! (array-ref control 1) -1)
      (set! (array-ref control 2) -1)
      (set! (array-ref control 7) -1)
      (set! (array-ref control 8) -1)
      (set! (array-ref control 9) -1)
      (set! (array-ref control 10) -1)
      (set! (array-ref control 12) -1)
      (set! (array-ref control 13) -1)
      (set! (array-ref control 16) -1)
      (set! (array-ref control 17) -1)
      (set! (array-ref control 21) -1)
      (set! (array-ref control 22) -1)
      (TcMacroImportIndexStateData
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array MacroFlatImportTargetList 0)
        control))))

(define (tc-macro-import-index-state-address-initialize [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-import-index)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcMacroImportIndexStateData)
              (array.make-array TcMacroImportIndexStateData 1)]
            [_init : unit
              (set! (array-ref cell 0) (tc-macro-import-index-state-new))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcMacroImportIndexStateData))))
                : i64)]
            (begin
              (tc-macro-state-slot-address-set!
                state
                tc-macro-state-slot-import-index
                next)
              next)))))))

(define (tc-macro-import-index-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    8
    tc-macro-import-index-state-address-initialize))

(define (tc-macro-import-index-state-data [state : TcMacroState]) : TcMacroImportIndexStateData
  (unsafe
    (ptr-read
      (int->ptr
        (cast (tc-macro-import-index-state-address state) : u64)
        : (Ptr TcMacroImportIndexStateData)))))

(define (tc-macro-import-index-state-data-set!
  [state : TcMacroState]
  [data : TcMacroImportIndexStateData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr
        (cast (tc-macro-import-index-state-address state) : u64)
        : (MutPtr TcMacroImportIndexStateData))
      data)))

(defmacro (tc-macro-import-index-control [state : Expr] [index : Expr]) : Expr
  `(array-ref
    (unsafe
      (ptr-read
        (ptr-offset
          (int->ptr
            (cast (tc-macro-import-index-state-address ,state) : u64)
            : (Ptr (__tl_dyn-array i64)))
          8)))
    ,index))

(define (tc-macro-import-index-control-set!
  [state : TcMacroState]
  [index : i64]
  [value : i64]) : unit
  (set!
    (array-ref
      (unsafe
        (ptr-read
          (ptr-offset
            (int->ptr
              (cast (tc-macro-import-index-state-address state) : u64)
              : (Ptr (__tl_dyn-array i64)))
            8)))
      index)
    value))

(defmacro (tc-macro-import-index-array [state : Expr] [field : Expr]) : Expr
  (match field
    [(comptime.Expr.Var name)
      (let
        [index : i64
          (match name
            ["alias-module-keys" 0]
            ["alias-qualifier-keys" 1]
            ["alias-values" 2]
            ["unqualified-module-keys" 3]
            ["unqualified-name-keys" 4]
            ["unqualified-values" 5]
            ["flat-module-keys" 6]
            ["flat-values" 7]
            [_ -1])]
        (if (< index 0)
          (if (string.eq name "field")
            `(unsafe
              (ptr-read
                (int->ptr
                  (cast (tc-macro-import-index-state-address ,state) : u64)
                  : (Ptr (__tl_dyn-array i64)))))
            (comptime.comptime-error
              (comptime.string-append "unknown macro import index array: " name)))
          (if (string.eq name "flat-values")
            `(unsafe
              (ptr-read
                (ptr-offset
                  (int->ptr
                    (cast (tc-macro-import-index-state-address ,state) : u64)
                    : (Ptr (__tl_dyn-array MacroFlatImportTargetList)))
                  7)))
            `(unsafe
              (ptr-read
                (ptr-offset
                  (int->ptr
                    (cast (tc-macro-import-index-state-address ,state) : u64)
                    : (Ptr (__tl_dyn-array i64)))
                  ,(comptime.expr-int index)))))))]
    [_ (comptime.comptime-error "macro import index expects a field name")]))

(define (macro-unqualified-import-cache-storage-ensure! [state : TcMacroState]) : unit
  (let
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    (if (= (array-length data.unqualified-module-keys) 65536)
      unit
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (begin
            (set! data.unqualified-module-keys (array.make-array i64 65536))
            (set! data.unqualified-name-keys (array.make-array i64 65536))
            (set! data.unqualified-values (array.make-array i64 65536))
            (tc-macro-import-index-state-data-set! state data)))))))

(define (tc-unused-unsafe-storage-lifetime-fill!
  [state : TcUnusedUnsafeState]
  [index : i64]) : unit
  (if (>= index 129)
    unit
    (let
      [line : i64 (+ 100 index)]
      [col : i64 (+ 200 index)]
      [span : ast.AstSourceSpan (ast.ast-source-span line col line (+ col 1))]
      [previous : i64
        (tc-unused-unsafe-enter-block state (TcMaybeAstSourceSpan.Some span))]
      (begin
        (if (= index 128)
          (tc-unused-unsafe-mark-current-used! state)
          unit)
        (tc-unused-unsafe-restore-block! state previous)
        (tc-unused-unsafe-storage-lifetime-fill! state (+ index 1))))))

(define (tc-unused-unsafe-storage-lifetime-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [job : TcJobState (tc-job-state-new)]
    [state : TcUnusedUnsafeState (tc-job-state-unused-unsafe job)]
    [scratch : arena.Arena (arena.make)]
    [path : String "tc-unused-unsafe-lifetime"]
    (begin
      ;; First allocation runs while an unrelated disposable arena is current.
      ;; The buffers must still be retained by the state owner's arena.
      (unsafe
        (arena.set! scratch))
      (tc-unused-unsafe-tracking-reset! state path)
      (unsafe
        (arena.set! caller))
      (unsafe
        (arena.destroy scratch))
      (tc-unused-unsafe-set-current-path! state path)
      (tc-unused-unsafe-storage-lifetime-fill! state 0)
      (let
        [first-span : ast.AstSourceSpan (tc-unused-unsafe-block-span state 0)]
        [last-span : ast.AstSourceSpan (tc-unused-unsafe-block-span state 128)]
        [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
        [survived? : bool
          (and
            (= (tc-unused-unsafe-block-count state) 129)
            (string.eq (tc-unused-unsafe-block-path state 0) path)
            (string.eq (tc-unused-unsafe-block-path state 128) path)
            (= (ast.ast-source-span-start-line first-span) 100)
            (= (ast.ast-source-span-start-col first-span) 200)
            (= (ast.ast-source-span-end-line first-span) 100)
            (= (ast.ast-source-span-end-col first-span) 201)
            (= (ast.ast-source-span-start-line last-span) 228)
            (= (ast.ast-source-span-start-col last-span) 328)
            (= (ast.ast-source-span-end-line last-span) 228)
            (= (ast.ast-source-span-end-col last-span) 329)
            (not (tc-unused-unsafe-block-used? state 0))
            (tc-unused-unsafe-block-used? state 128)
            (= data.current-block -1))]
        (begin
          (tc-unused-unsafe-tracking-clear! state)
          (let
            [cleared : TcUnusedUnsafeStateData
              (tc-unused-unsafe-state-data state)]
            (and
              survived?
              (= (tc-unused-unsafe-block-count state) 0)
              (not cleared.enabled)
              (= cleared.current-block -1)
              (string.eq cleared.current-path "")
              (string.eq cleared.target-path ""))))))))

(define (tc-unused-unsafe-state-isolation-ok?) : bool
  (let
    [job-a : TcJobState (tc-job-state-new)]
    [job-b : TcJobState (tc-job-state-new)]
    [state-a : TcUnusedUnsafeState (tc-job-state-unused-unsafe job-a)]
    [state-b : TcUnusedUnsafeState (tc-job-state-unused-unsafe job-b)]
    [path-a : String "tc-unused-unsafe-a"]
    [path-b : String "tc-unused-unsafe-b"]
    [span-b : ast.AstSourceSpan (ast.ast-source-span 7 8 9 10)]
    (begin
      (tc-unused-unsafe-tracking-reset! state-a path-a)
      (tc-unused-unsafe-set-current-path! state-a path-a)
      (tc-unused-unsafe-storage-lifetime-fill! state-a 0)
      (tc-unused-unsafe-tracking-reset! state-b path-b)
      (tc-unused-unsafe-set-current-path! state-b path-b)
      (let
        [previous-b : i64
          (tc-unused-unsafe-enter-block
            state-b
            (TcMaybeAstSourceSpan.Some span-b))]
        (begin
          (tc-unused-unsafe-mark-current-used! state-b)
          (tc-unused-unsafe-restore-block! state-b previous-b)
          ;; A reset must not alter B's selectors, records, or result bits.
          (tc-job-state-reset-file-state! job-a)
          (let
            [data-b : TcUnusedUnsafeStateData
              (tc-unused-unsafe-state-data state-b)]
            (and
              (= (tc-unused-unsafe-block-count state-a) 0)
              (= (tc-unused-unsafe-block-count state-b) 1)
              (string.eq (tc-unused-unsafe-block-path state-b 0) path-b)
              (tc-unused-unsafe-span-eq?
                (tc-unused-unsafe-block-span state-b 0)
                span-b)
              (tc-unused-unsafe-block-used? state-b 0)
              data-b.enabled
              (= data-b.current-block -1)
              (string.eq data-b.current-path path-b)
              (string.eq data-b.target-path path-b))))))))

(define (tc-unused-unsafe-state-isolation-self-test) : bool
  (and
    (tc-unused-unsafe-storage-lifetime-ok?)
    (tc-unused-unsafe-state-isolation-ok?)))

(define (tc-inlay-hint-string-lifetime-record-in-arena!
  [state : TcInlayHintState]
  [producer : arena.Arena]) : unit
  (begin
    (unsafe
      (arena.set! producer))
    (let
      [ty : String (str_cat.str-cat "lifetime-hint-" (string.int->string 42))]
      (tc-inlay-hint-record-for-state! state 7 11 ty))))

;; Exercise every retained no-state adapter against the one serial state. The
;; fixed arrays are retained after reset, so this adds no second capacity-sized
;; allocation while still covering read-after-disable and generation cleanup.
(define (tc-inlay-hint-serial-adapters-ok?) : bool
  (let
    [state : TcInlayHintState (tc-job-state-inlay-hints (tc-serial-job-state))]
    [readable? : bool false]
    [clean? : bool false]
    (begin
      (tc-inlay-hints-reset-for-state! state)
      (tc-inlay-hints-enable!)
      (tc-inlay-hint-record! 17 23 "serial-adapter")
      (tc-inlay-hints-disable!)
      (set!
        readable?
        (and
          (= (tc-inlay-hints-size) 1)
          (= (tc-inlay-hint-line-at 0) 17)
          (= (tc-inlay-hint-col-at 0) 23)
          (string.eq (tc-inlay-hint-type-at 0) "serial-adapter")))
      (tc-inlay-hints-reset-for-state! state)
      (set!
        clean?
        (and
          (not (tc-inlay-hint-state-enabled? state))
          (= (tc-inlay-hints-size) 0)
          (= (__tl-project-field (tc-inlay-hint-state-data state) count) 0)
          (=
            (__tl-project-field (tc-inlay-hint-state-data state) string-arena)
            0)))
      (and readable? clean?))))

(define (tc-inlay-hint-state-isolation-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [producer : arena.Arena (arena.make)]
    [job-a : TcJobState (tc-job-state-new)]
    [job-b : TcJobState (tc-job-state-new)]
    [state-a : TcInlayHintState (tc-job-state-inlay-hints job-a)]
    [state-b : TcInlayHintState (tc-job-state-inlay-hints job-b)]
    [initially-lazy? : bool
      (and
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-a) lines))
          0)
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-b) lines))
          0)
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-a) cols))
          0)
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-b) cols))
          0)
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-a) types))
          0)
        (=
          (array-length
            (__tl-project-field (tc-inlay-hint-state-data state-b) types))
          0))]
    [restored-after-enable? : bool false]
    [a-survived? : bool false]
    [b-survived? : bool false]
    [a-reset? : bool false]
    [b-after-a-reset? : bool false]
    [reuse-isolated? : bool false]
    [fixed-capacities? : bool false]
    (begin
      ;; Fixed storage is owned by the state creation arena even when first
      ;; use occurs under a disposable producer arena.
      (unsafe
        (arena.set! producer))
      (tc-inlay-hints-enable-for-state! state-a)
      (set! restored-after-enable? (arena.eq? (arena.current) producer))
      (tc-inlay-hint-string-lifetime-record-in-arena! state-a producer)
      (unsafe
        (arena.set! caller))
      (unsafe
        (arena.destroy producer))
      (tc-inlay-hints-disable-for-state! state-a)
      (tc-inlay-hints-enable-for-state! state-b)
      (tc-inlay-hint-record-for-state! state-b 21 31 "state-b")
      (set!
        fixed-capacities?
        (and
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-a) lines))
            tc-inlay-hint-capacity)
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-a) cols))
            tc-inlay-hint-capacity)
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-a) types))
            tc-inlay-hint-capacity)
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-b) lines))
            tc-inlay-hint-capacity)
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-b) cols))
            tc-inlay-hint-capacity)
          (=
            (array-length
              (__tl-project-field (tc-inlay-hint-state-data state-b) types))
            tc-inlay-hint-capacity)))
      (set!
        a-survived?
        (and
          (= (tc-inlay-hints-size-for-state state-a) 1)
          (= (tc-inlay-hint-line-at-for-state state-a 0) 7)
          (= (tc-inlay-hint-col-at-for-state state-a 0) 11)
          (string.eq
            (tc-inlay-hint-type-at-for-state state-a 0)
            "lifetime-hint-42")))
      (set!
        b-survived?
        (and
          (= (tc-inlay-hints-size-for-state state-b) 1)
          (= (tc-inlay-hint-line-at-for-state state-b 0) 21)
          (= (tc-inlay-hint-col-at-for-state state-b 0) 31)
          (string.eq (tc-inlay-hint-type-at-for-state state-b 0) "state-b")))
      (tc-job-state-reset-file-state! job-a)
      (set!
        a-reset?
        (and
          (not (tc-inlay-hint-state-enabled? state-a))
          (= (tc-inlay-hints-size-for-state state-a) 0)
          (=
            (__tl-project-field (tc-inlay-hint-state-data state-a) string-arena)
            0)))
      (set!
        b-after-a-reset?
        (and
          (tc-inlay-hint-state-enabled? state-b)
          (= (tc-inlay-hints-size-for-state state-b) 1)
          (= (tc-inlay-hint-line-at-for-state state-b 0) 21)
          (= (tc-inlay-hint-col-at-for-state state-b 0) 31)
          (string.eq (tc-inlay-hint-type-at-for-state state-b 0) "state-b")))
      (tc-inlay-hints-enable-for-state! state-a)
      (tc-inlay-hint-record-for-state! state-a 41 51 "state-a-reused")
      (tc-inlay-hints-disable-for-state! state-a)
      (set!
        reuse-isolated?
        (and
          (= (tc-inlay-hints-size-for-state state-a) 1)
          (= (tc-inlay-hint-line-at-for-state state-a 0) 41)
          (= (tc-inlay-hint-col-at-for-state state-a 0) 51)
          (string.eq
            (tc-inlay-hint-type-at-for-state state-a 0)
            "state-a-reused")
          (= (tc-inlay-hints-size-for-state state-b) 1)
          (string.eq (tc-inlay-hint-type-at-for-state state-b 0) "state-b")))
      (tc-inlay-hints-reset-for-state! state-a)
      (tc-inlay-hints-reset-for-state! state-b)
      (and
        initially-lazy?
        restored-after-enable?
        a-survived?
        b-survived?
        fixed-capacities?
        a-reset?
        b-after-a-reset?
        reuse-isolated?
        (=
          (__tl-project-field (tc-inlay-hint-state-data state-a) string-arena)
          0)
        (=
          (__tl-project-field (tc-inlay-hint-state-data state-b) string-arena)
          0)))))

(define (tc-lazy-table-storage-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [scratch : arena.Arena (arena.make)]
    [job-state : TcJobState (tc-serial-job-state)]
    [proof-state : TcMacroState (tc-job-state-macro-state job-state)]
    [scalar-state : TcAggScalarCacheState
      (tc-job-state-agg-scalar-caches job-state)]
    [initially-lazy? : bool
      (and
        (=
          (arena.raw-handle
            (__tl-project-field tc-lazy-global-table-state owner))
          0)
        (=
          (array-length
            (__tl-project-field
              tc-lazy-global-table-state
              type-needs-resolution-slots))
          0)
        (=
          (array-length
            (__tl-project-field
              (tc-agg-scalar-cache-state-data scalar-state)
              size-cache))
          0)
        (=
          (array-length
            (__tl-project-field
              (tc-agg-scalar-cache-state-data scalar-state)
              align-cache))
          0)
        (=
          (array-length
            (__tl-project-field
              (tc-agg-scalar-cache-state-data scalar-state)
              regwords-cache))
          0)
        (=
          (array-length
            (__tl-project-field tc-lazy-global-table-state agg-layout-cache))
          0)
        (= (array-length (tc-macro-proof-field proof-state qualified-keys)) 0))]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [_resolution : unit (tc-type-needs-resolution-storage-ensure!)]
    [_size : unit (tc-agg-size-cache-storage-ensure!)]
    [_align : unit (tc-agg-align-cache-storage-ensure!)]
    [_regwords : unit (tc-agg-regwords-cache-storage-ensure!)]
    [scalar-data : TcAggScalarCacheStateData
      (tc-agg-scalar-cache-state-data scalar-state)]
    [_layout : unit (tc-agg-layout-cache-table-storage-ensure!)]
    [_macro-proof : unit
      (tc-macro-abstract-proof-qualified-key-storage-ensure! proof-state)]
    [restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [exact-capacities? : bool
      (and
        (=
          (array-length
            (__tl-project-field
              tc-lazy-global-table-state
              type-needs-resolution-slots))
          131072)
        (= (array-length scalar-data.size-cache) tc-agg-scalar-cache-capacity)
        (= (array-length scalar-data.align-cache) tc-agg-scalar-cache-capacity)
        (=
          (array-length scalar-data.regwords-cache)
          tc-agg-scalar-cache-capacity)
        (=
          (array-length
            (__tl-project-field tc-lazy-global-table-state agg-layout-cache))
          tc-agg-layout-cache-capacity)
        (=
          (array-length (tc-macro-proof-field proof-state qualified-keys))
          requested-capacity))]
    (begin
      (unsafe
        (arena.set! caller))
      (unsafe
        (arena.destroy scratch))
      (set!
        (array-ref
          (__tl-project-field
            tc-lazy-global-table-state
            type-needs-resolution-slots)
          0)
        17)
      (set! (array-ref scalar-data.size-cache 0) 29)
      (set! (array-ref scalar-data.align-cache 0) 31)
      (set! (array-ref scalar-data.regwords-cache 0) 37)
      (set!
        (array-ref
          (__tl-project-field tc-lazy-global-table-state agg-layout-cache)
          0)
        (TcAggLayoutCacheSlot.Empty))
      (set!
        (array-ref (tc-macro-proof-field proof-state qualified-keys) 0)
        "tc-lazy-table-storage")
      (let
        [survived? : bool
          (and
            (=
              (array-ref
                (__tl-project-field
                  tc-lazy-global-table-state
                  type-needs-resolution-slots)
                0)
              17)
            (= (array-ref scalar-data.size-cache 0) 29)
            (= (array-ref scalar-data.align-cache 0) 31)
            (= (array-ref scalar-data.regwords-cache 0) 37)
            (match (tc-global-array-element-shared-view
              (__tl-project-field tc-lazy-global-table-state agg-layout-cache)
              0)
              [(TcAggLayoutCacheSlot.Empty) true]
              [_ false])
            (string.eq
              (array-ref (tc-macro-proof-field proof-state qualified-keys) 0)
              "tc-lazy-table-storage"))]
        (begin
          (set!
            (array-ref
              (__tl-project-field
                tc-lazy-global-table-state
                type-needs-resolution-slots)
              0)
            0)
          (set! (array-ref scalar-data.size-cache 0) 0)
          (set! (array-ref scalar-data.align-cache 0) 0)
          (set! (array-ref scalar-data.regwords-cache 0) 0)
          (set!
            (array-ref (tc-macro-proof-field proof-state qualified-keys) 0)
            "")
          (let
            [unused-unsafe-lifetime? : bool
              (tc-unused-unsafe-storage-lifetime-ok?)]
            [unused-unsafe-isolation? : bool
              (tc-unused-unsafe-state-isolation-ok?)]
            (and
              initially-lazy?
              restored-caller?
              exact-capacities?
              survived?
              unused-unsafe-lifetime?
              unused-unsafe-isolation?)))))))

(cfg
  test
  (test
    agg-scalar-cache-state-isolation
    (let
      [caller : arena.Arena (arena.current)]
      [owner-a : arena.Arena (arena.make)]
      [owner-b : arena.Arena (arena.make)]
      [job-a-address : i64
        (in-arena owner-a (__tl-project-field (tc-job-state-new) address))]
      [job-b-address : i64
        (in-arena owner-b (__tl-project-field (tc-job-state-new) address))]
      [job-a : TcJobState (TcJobState job-a-address)]
      [job-b : TcJobState (TcJobState job-b-address)]
      [state-a : TcAggScalarCacheState (tc-job-state-agg-scalar-caches job-a)]
      [state-b : TcAggScalarCacheState (tc-job-state-agg-scalar-caches job-b)]
      [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
      [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
      [decoy : ci.InternCompatState (ci.intern-compat-state-new)]
      [installed : ci.InternCompatState (ci.intern-compat-state-capture-active)]
      [table-a : i64 (ci.intern-compat-state-table-id intern-a)]
      [table-b : i64 (ci.intern-compat-state-table-id intern-b)]
      [generation-a : i64 (ci.intern-compat-state-generation intern-a)]
      [generation-b : i64 (ci.intern-compat-state-generation intern-b)]
      [initially-lazy? : bool
        (and
          (=
            (array-length (tc-agg-scalar-cache-state-data state-a).size-cache)
            0)
          (=
            (array-length (tc-agg-scalar-cache-state-data state-a).align-cache)
            0)
          (=
            (array-length
              (tc-agg-scalar-cache-state-data state-a).regwords-cache)
            0)
          (=
            (array-length (tc-agg-scalar-cache-state-data state-b).size-cache)
            0)
          (=
            (array-length (tc-agg-scalar-cache-state-data state-b).align-cache)
            0)
          (=
            (array-length
              (tc-agg-scalar-cache-state-data state-b).regwords-cache)
            0))]
      [scratch : arena.Arena (arena.make)]
      (begin
        (unsafe
          (arena.set! scratch))
        (tc-agg-size-cache-storage-ensure-for-job! job-a)
        (tc-agg-align-cache-storage-ensure-for-job! job-a)
        (tc-agg-regwords-cache-storage-ensure-for-job! job-a)
        (tc-agg-size-cache-storage-ensure-for-job! job-b)
        (tc-agg-align-cache-storage-ensure-for-job! job-b)
        (tc-agg-regwords-cache-storage-ensure-for-job! job-b)
        (let
          [restored-scratch? : bool (arena.eq? (arena.current) scratch)]
          (begin
            (unsafe
              (arena.set! caller))
            (unsafe
              (arena.destroy scratch))
            (tc-agg-size-cache-ensure-for-state! state-a table-a generation-a)
            (tc-agg-align-cache-ensure-for-state! state-a table-a generation-a)
            (tc-agg-regwords-cache-ensure-for-state!
              state-a
              table-a
              generation-a)
            (tc-agg-size-cache-ensure-for-state! state-b table-b generation-b)
            (tc-agg-align-cache-ensure-for-state! state-b table-b generation-b)
            (tc-agg-regwords-cache-ensure-for-state!
              state-b
              table-b
              generation-b)
            (let
              [data-a : TcAggScalarCacheStateData
                (tc-agg-scalar-cache-state-data state-a)]
              [data-b : TcAggScalarCacheStateData
                (tc-agg-scalar-cache-state-data state-b)]
              (begin
                (set! (array-ref data-a.size-cache 17) 9)
                (set! (array-ref data-a.align-cache 17) 5)
                (set! (array-ref data-a.regwords-cache 17) 3)
                (set! (array-ref data-b.size-cache 17) 33)
                (set! (array-ref data-b.align-cache 17) 17)
                (set! (array-ref data-b.regwords-cache 17) 2)
                (ci.intern-compat-state-install! decoy)
                (tc-agg-caches-reset-for-job! job-a)
                (tc-agg-size-cache-ensure-for-state!
                  state-a
                  table-a
                  generation-a)
                (tc-agg-align-cache-ensure-for-state!
                  state-a
                  table-a
                  generation-a)
                (tc-agg-regwords-cache-ensure-for-state!
                  state-a
                  table-a
                  generation-a)
                (let
                  [reset-a : TcAggScalarCacheStateData
                    (tc-agg-scalar-cache-state-data state-a)]
                  [intact-b : TcAggScalarCacheStateData
                    (tc-agg-scalar-cache-state-data state-b)]
                  [isolated? : bool
                    (and
                      (= (array-ref reset-a.size-cache 17) 0)
                      (= (array-ref reset-a.align-cache 17) 0)
                      (= (array-ref reset-a.regwords-cache 17) 0)
                      (= (array-ref intact-b.size-cache 17) 33)
                      (= (array-ref intact-b.align-cache 17) 17)
                      (= (array-ref intact-b.regwords-cache 17) 2)
                      (= intact-b.size-intern-table-id table-b)
                      (= intact-b.size-intern-generation generation-b)
                      (= intact-b.align-intern-table-id table-b)
                      (= intact-b.align-intern-generation generation-b)
                      (= intact-b.regwords-intern-table-id table-b)
                      (= intact-b.regwords-intern-generation generation-b))]
                  (begin
                    (unsafe
                      (arena.destroy owner-a))
                    (let
                      [after-a-destroy : TcAggScalarCacheStateData
                        (tc-agg-scalar-cache-state-data state-b)]
                      [b-survived? : bool
                        (and
                          (= (array-ref after-a-destroy.size-cache 17) 33)
                          (= (array-ref after-a-destroy.align-cache 17) 17)
                          (= (array-ref after-a-destroy.regwords-cache 17) 2))]
                      (begin
                        (ci.intern-compat-state-install! installed)
                        (unsafe
                          (arena.destroy owner-b))
                        (if (and
                          initially-lazy?
                          restored-scratch?
                          isolated?
                          b-survived?
                          (not (= table-a table-b)))
                          unit
                          (io.panic
                            "typecheck: aggregate scalar cache state isolation failed"))))))))))))))

;; Same numeric importer/alias IDs belong to different intern owners here.
;; Allocate both tables while an unrelated scratch arena is active, then prove
;; that A-only reset and generation invalidation leave B's lookup and counters
;; intact after that scratch arena has been destroyed.
(cfg
  test
  (test
    lazy-import-state-isolation
    (let
      [caller : arena.Arena (arena.current)]
      [installed-table-id : i64 (ci.intern-active-table-id)]
      [installed-generation : i64 (ci.intern-generation)]
      [job-a : TcJobState (tc-job-state-new)]
      [job-b : TcJobState (tc-job-state-new)]
      [state-a : TcMacroState (tc-job-state-macro-state job-a)]
      [state-b : TcMacroState (tc-job-state-macro-state job-b)]
      [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
      [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
      [importer-a : i64 (ci.intern-compat-state-intern intern-a "importer")]
      [alias-a : i64 (ci.intern-compat-state-intern intern-a "alias")]
      [target-a : i64 (ci.intern-compat-state-intern intern-a "target-a")]
      [importer-b : i64 (ci.intern-compat-state-intern intern-b "importer")]
      [alias-b : i64 (ci.intern-compat-state-intern intern-b "alias")]
      [_filler-b : i64 (ci.intern-compat-state-intern intern-b "filler")]
      [target-b : i64 (ci.intern-compat-state-intern intern-b "target-b")]
      [_bind-a : unit
        (tc-macro-state-bind-source-names!
          state-a
          (ci.intern-source-name-session-handle-from-state intern-a))]
      [_bind-b : unit
        (tc-macro-state-bind-source-names!
          state-b
          (ci.intern-source-name-session-handle-from-state intern-b))]
      [initially-lazy? : bool
        (and
          (=
            (tc-macro-state-slot-address
              state-a
              tc-macro-state-slot-lazy-import)
            0)
          (=
            (tc-macro-state-slot-address
              state-b
              tc-macro-state-slot-lazy-import)
            0))]
      [scratch : arena.Arena (arena.make)]
      (begin
        (unsafe
          (arena.set! scratch))
        (tc-lazy-import-stub-record-for-job!
          job-a
          importer-a
          alias-a
          target-a
          true)
        (tc-lazy-import-summary-macro-force-record-for-state! state-a)
        (tc-lazy-import-summary-macro-force-record-for-state! state-a)
        (tc-lazy-import-stub-record-for-job!
          job-b
          importer-b
          alias-b
          target-b
          false)
        (tc-lazy-import-summary-macro-force-record-for-state! state-b)
        (unsafe
          (arena.set! caller))
        (unsafe
          (arena.destroy scratch))
        (let
          [lazy-a : TcLazyImportState (tc-job-state-lazy-import job-a)]
          [lazy-b : TcLazyImportState (tc-job-state-lazy-import job-b)]
          [data-a : TcLazyImportStateData (tc-lazy-import-state-data lazy-a)]
          [data-b : TcLazyImportStateData (tc-lazy-import-state-data lazy-b)]
          [before-reset? : bool
            (and
              initially-lazy?
              (not (= lazy-a.address lazy-b.address))
              (= (array-length data-a.index-slots) tc-lazy-import-stub-capacity)
              (= (array-length data-b.index-slots) tc-lazy-import-stub-capacity)
              (= importer-a importer-b)
              (= alias-a alias-b)
              (not (= target-a target-b))
              (= (tc-lazy-import-stub-count-for-state state-a) 1)
              (= (tc-lazy-import-stub-count-for-state state-b) 1)
              (= (tc-lazy-import-summary-backed-stub-count-for-state state-a) 1)
              (= (tc-lazy-import-summary-backed-stub-count-for-state state-b) 0)
              (= (tc-lazy-import-summary-macro-force-count-for-state state-a) 2)
              (= (tc-lazy-import-summary-macro-force-count-for-state state-b) 1)
              (match (tc-lazy-import-stub-target-id-for-state
                state-a
                importer-a
                alias-a)
                [(TcMaybeNameId.Some target) (= target target-a)]
                [(TcMaybeNameId.No) false])
              (match (tc-lazy-import-stub-target-id-for-state
                state-b
                importer-b
                alias-b)
                [(TcMaybeNameId.Some target) (= target target-b)]
                [(TcMaybeNameId.No) false]))]
          (begin
            (tc-lazy-import-stubs-reset-for-job! job-a)
            (let
              [a-reset-b-intact? : bool
                (and
                  (= (tc-lazy-import-stub-count-for-state state-a) 0)
                  (=
                    (tc-lazy-import-summary-backed-stub-count-for-state state-a)
                    0)
                  (=
                    (tc-lazy-import-summary-macro-force-count-for-state state-a)
                    0)
                  (match (tc-lazy-import-stub-target-id-for-state
                    state-a
                    importer-a
                    alias-a)
                    [(TcMaybeNameId.Some _) false]
                    [(TcMaybeNameId.No) true])
                  (= (tc-lazy-import-stub-count-for-state state-b) 1)
                  (=
                    (tc-lazy-import-summary-macro-force-count-for-state state-b)
                    1)
                  (match (tc-lazy-import-stub-target-id-for-state
                    state-b
                    importer-b
                    alias-b)
                    [(TcMaybeNameId.Some target) (= target target-b)]
                    [(TcMaybeNameId.No) false]))]
              (begin
                (tc-lazy-import-stub-record-for-job!
                  job-a
                  importer-a
                  alias-a
                  target-a
                  false)
                (ci.intern-compat-state-reset! intern-a)
                (tc-macro-state-bind-source-names!
                  state-a
                  (ci.intern-source-name-session-handle-from-state intern-a))
                (if (and
                  before-reset?
                  a-reset-b-intact?
                  (= (tc-lazy-import-stub-count-for-state state-a) 0)
                  (= (tc-lazy-import-stub-count-for-state state-b) 1)
                  (= (ci.intern-active-table-id) installed-table-id)
                  (= (ci.intern-generation) installed-generation))
                  unit
                  (io.panic "typecheck: lazy import state isolation failed"))))))))))

(define (macro-decl-list-slots-data-addr [decls : ast.AstDeclList]) : i64
  (cast
    (unsafe
      (ptr->int (ptr-cast (__tl_array-data decls.slots) : (Ptr u8))))
    : i64))

;; The mapping is program-derived, so the cache must not survive into the next
;; program of a multi-program process (smoke batteries, REPL, LSP, package
;; builds). macro-expand-program and the REPL typecheck entry reset it at the
;; same per-program boundary that resets the CTFE-env and clone-able caches;
;; the intern generation gate additionally covers intern-reset! boundaries.
(define (macro-alias-derived-cache-reset-for-state! [state : TcMacroState]) : unit
  (begin
    (tc-module-decl-index-reset!)
    (tc-program-enum-index-reset!)
    (tc-macro-import-index-control-set! state 3 0)
    (tc-macro-import-index-control-set! state 14 0)
    (tc-macro-import-index-control-set! state 18 0)
    (macro-surface-call-decl-cache-reset! state)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)
    (tc-imported-module-identity-cache-reset!)))

;; Standalone callers and focused smoke tests use the serial compatibility job.
(define (macro-alias-derived-cache-reset!) : unit
  (macro-alias-derived-cache-reset-for-state!
    (tc-job-state-macro-state (tc-serial-job-state))))

(define (macro-alias-cache-reset!) : unit
  (macro-alias-derived-cache-reset!))

;; Deterministic A/B interleaving probe for the job-owned macro and CTFE state.
;; It exercises independent writes, A-only resets, and lazy table allocation
;; without relying on an active-state selector.
(cfg
  test
  (define (tc-macro-state-isolation-ok?) : bool
    (let
      [_installed-ready : unit
        (if (= (ci.intern-generation) 0)
          (ci.intern-reset!)
          unit)]
      [job-a : TcJobState (tc-job-state-new)]
      [job-b : TcJobState (tc-job-state-new)]
      [state-a : TcMacroState (tc-job-state-macro-state job-a)]
      [state-b : TcMacroState (tc-job-state-macro-state job-b)]
      [installed-table-id : i64 (ci.intern-active-table-id)]
      [installed-generation : i64 (ci.intern-generation)]
      [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
      [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
      [module-id-a : i64 (ci.intern-compat-state-intern intern-a "same-module")]
      [name-id-a : i64 (ci.intern-compat-state-intern intern-a "same-name")]
      [module-id-b : i64 (ci.intern-compat-state-intern intern-b "same-module")]
      [name-id-b : i64 (ci.intern-compat-state-intern intern-b "same-name")]
      [source-names-a : ci.InternSourceNameSessionHandle
        (ci.intern-source-name-session-handle-from-state intern-a)]
      [source-names-b : ci.InternSourceNameSessionHandle
        (ci.intern-source-name-session-handle-from-state intern-b)]
      [installed-generated-identity-before : i64
        (match (ci.intern-generated-canonical-lookup
          "tc-macro-state-isolation-owner-only")
          [(InternLookupFound id) (+ id 1)]
          [(InternLookupMissing) 0])]
      [initially-lazy? : bool
        (and
          (= (tc-macro-state-slot-address state-a tc-macro-state-slot-walk) 0)
          (=
            (tc-macro-state-slot-address state-a tc-macro-state-slot-abstract)
            0)
          (=
            (tc-macro-state-slot-address
              state-a
              tc-macro-state-slot-proof-reuse)
            0)
          (=
            (tc-macro-state-slot-address state-a tc-macro-state-slot-identity)
            0)
          (=
            (tc-macro-state-slot-address
              state-a
              tc-macro-state-slot-generated-decls)
            0)
          (=
            (tc-macro-state-slot-address
              state-a
              tc-macro-state-slot-surface-call)
            0)
          (=
            (tc-macro-state-slot-address
              state-a
              tc-macro-state-slot-import-index)
            0)
          (= (tc-macro-state-slot-address state-b tc-macro-state-slot-walk) 0)
          (=
            (tc-macro-state-slot-address state-b tc-macro-state-slot-abstract)
            0)
          (=
            (tc-macro-state-slot-address
              state-b
              tc-macro-state-slot-proof-reuse)
            0)
          (=
            (tc-macro-state-slot-address state-b tc-macro-state-slot-identity)
            0)
          (=
            (tc-macro-state-slot-address
              state-b
              tc-macro-state-slot-generated-decls)
            0)
          (=
            (tc-macro-state-slot-address
              state-b
              tc-macro-state-slot-surface-call)
            0)
          (=
            (tc-macro-state-slot-address
              state-b
              tc-macro-state-slot-import-index)
            0))]
      [ok : bool initially-lazy?]
      (begin
        (tc-macro-state-bind-source-names! state-a source-names-a)
        (tc-macro-state-bind-source-names! state-b source-names-b)
        (let
          [journal-mark-a : i64 (tc-dotted-macro-journal-start! state-a)]
          [journal-mark-b : i64 (tc-dotted-macro-journal-start! state-b)]
          (begin
            (tc-dotted-macro-journal-restore-to! state-a journal-mark-a)
            (set!
              ok
              (and
                ok
                (= journal-mark-a 0)
                (= journal-mark-b 0)
                (= (tc-macro-walk-field state-a dotted-macro-journal-depth) 0)
                (= (tc-macro-walk-field state-b dotted-macro-journal-depth) 1)))
            (tc-dotted-macro-journal-restore-to! state-b journal-mark-b)))
        (set!
          ok
          (and
            ok
            (= module-id-a module-id-b)
            (= name-id-a name-id-b)
            (not
              (=
                (ci.intern-compat-state-table-id intern-a)
                (ci.intern-compat-state-table-id intern-b)))))
        ;; Interleave live-walk state and dense hygiene environments.
        (tc-macro-walk-set! state-a macro-expand-active-module "isolation-a")
        (tc-macro-walk-set! state-b macro-expand-active-module "isolation-b")
        (macro-hygiene-env-root-begin! state-a)
        (macro-hygiene-env-root-begin! state-b)
        (let
          [env-a : MacroHygieneEnv
            (macro-hygiene-env-bind-raw
              (macro-hygiene-env-empty
                state-a
                (ast.ast-node-pool-compat-context-current))
              71
              81)]
          [env-b : MacroHygieneEnv
            (macro-hygiene-env-bind-raw
              (macro-hygiene-env-empty
                state-b
                (ast.ast-node-pool-compat-context-current))
              71
              91)]
          (begin
            (set!
              ok
              (and
                ok
                (match (macro-hygiene-env-lookup env-a 71)
                  [(MacroMaybeHygieneName.Some value) (= value 81)]
                  [_ false])
                (match (macro-hygiene-env-lookup env-b 71)
                  [(MacroMaybeHygieneName.Some value) (= value 91)]
                  [_ false])))
            (macro-hygiene-env-root-finish! state-a)
            (macro-hygiene-env-root-finish! state-b)))
        ;; Interleave the large lazy import and surface memo tables.
        (macro-unqualified-import-cache-ensure! state-a)
        (macro-unqualified-import-cache-put! state-a module-id-a name-id-a 301)
        (macro-unqualified-import-cache-ensure! state-b)
        (macro-unqualified-import-cache-put! state-b module-id-b name-id-b 401)
        (macro-alias-cache-ensure! state-a)
        (macro-alias-cache-put! state-a module-id-a name-id-a 302)
        (macro-alias-cache-ensure! state-b)
        (macro-alias-cache-put! state-b module-id-b name-id-b 402)
        (macro-flat-import-target-cache-ensure! state-a)
        (macro-flat-import-target-cache-put!
          state-a
          module-id-a
          (macro-flat-import-target-list-add
            (macro-flat-import-target-list-empty)
            303))
        (macro-flat-import-target-cache-ensure! state-b)
        (macro-flat-import-target-cache-put!
          state-b
          module-id-b
          (macro-flat-import-target-list-add
            (macro-flat-import-target-list-empty)
            403))
        (macro-surface-call-decl-cache-ensure! state-a)
        (macro-surface-call-decl-cache-put! state-a 501 601 (MacroMaybeDecl.No))
        (macro-surface-call-decl-cache-ensure! state-b)
        (macro-surface-call-decl-cache-put! state-b 501 601 (MacroMaybeDecl.No))
        (set!
          ok
          (and
            ok
            (=
              (macro-unqualified-import-cache-get state-a module-id-a name-id-a)
              301)
            (=
              (macro-unqualified-import-cache-get state-b module-id-b name-id-b)
              401)
            (= (macro-alias-cache-get state-a module-id-a name-id-a) 302)
            (= (macro-alias-cache-get state-b module-id-b name-id-b) 402)
            (match (macro-flat-import-target-cache-get state-a module-id-a)
              [(MacroFlatImportTargetCacheLookup.Hit targets)
                (and (= targets.len 1) (= (array-ref targets.slots 0) 303))]
              [_ false])
            (match (macro-flat-import-target-cache-get state-b module-id-b)
              [(MacroFlatImportTargetCacheLookup.Hit targets)
                (and (= targets.len 1) (= (array-ref targets.slots 0) 403))]
              [_ false])
            (match (macro-surface-call-decl-cache-get state-a 501 601)
              [(MacroSurfaceCallDeclCacheLookup.Hit (MacroMaybeDecl.No)) true]
              [_ false])
            (match (macro-surface-call-decl-cache-get state-b 501 601)
              [(MacroSurfaceCallDeclCacheLookup.Hit (MacroMaybeDecl.No)) true]
              [_ false])))
        ;; Interleave generated-declaration and abstract-proof memos.
        (macro-generated-decls-memo-put!
          state-a
          "tc-macro-state-isolation"
          (ast.ast-decl-list-new))
        (macro-generated-decls-memo-put!
          state-b
          "tc-macro-state-isolation"
          (ast.ast-decl-list-new))
        (macro-generated-module-memo-put!
          state-a
          "tc-macro-state-isolation-module"
          901
          (ast.ast-decl-list-new)
          (ast.ast-decl-list-new)
          "isolation-generator-a"
          "isolation-a.tl")
        (macro-generated-module-memo-put!
          state-b
          "tc-macro-state-isolation-module"
          902
          (ast.ast-decl-list-new)
          (ast.ast-decl-list-new)
          "isolation-generator-b"
          "isolation-b.tl")
        (tc-macro-identity-intern-for-state
          state-a
          "tc-macro-state-isolation-owner-only")
        (set!
          ok
          (and
            ok
            (>=
              (tc-macro-identity-lookup-for-state
                state-a
                "tc-macro-state-isolation-owner-only")
              0)
            (<
              (tc-macro-identity-lookup-for-state
                state-b
                "tc-macro-state-isolation-owner-only")
              0)
            (=
              (tc-macro-identity-lookup-for-state
                state-a
                "tc-macro-state-isolation")
              (tc-macro-identity-lookup-for-state
                state-b
                "tc-macro-state-isolation"))))
        (tc-macro-abstract-proof-note! state-a "isolation-macro" "T" 1)
        (tc-macro-abstract-proof-note! state-b "isolation-macro" "T" 2)
        ;; The complete-proof registry, generated family rows, identity metadata,
        ;; and exact-comparison scratch share equal numeric IDs across distinct
        ;; source-name owners without consulting or replacing the installed
        ;; compatibility state.
        (record-count-for-state state-a "isolation-complete-a")
        (record-count-for-state state-b "isolation-complete-b")
        (running-identity-for-state state-a)
        (running-identity-for-state state-b)
        (let
          [identity-a-first : i64 (index-key module-id-a)]
          [identity-a-next : i64 (index-key name-id-a)]
          [identity-b-first : i64 (index-key module-id-b)]
          [identity-b-next : i64 (index-key name-id-b)]
          [family-a : i64 (bucket-name "isolation-generator" "item")]
          [family-b : i64 (bucket-name "isolation-generator" "item")]
          (begin
            (set!
              (array-ref
                (tc-macro-proof-field state-a identity-bytes)
                identity-a-first)
              (+ module-id-a 1))
            (set!
              (array-ref
                (tc-macro-proof-field state-a identity-bytes)
                identity-a-next)
              (+ name-id-a 1))
            (set!
              (array-ref
                (tc-macro-proof-field state-b identity-bytes)
                identity-b-first)
              (+ module-id-b 1))
            (set!
              (array-ref
                (tc-macro-proof-field state-b identity-bytes)
                identity-b-next)
              (+ name-id-b 1))
            (set!
              (array-ref
                (tc-macro-proof-field state-a operand-count)
                identity-a-first)
              1)
            (set!
              (array-ref
                (tc-macro-proof-field state-a operand-count)
                identity-a-next)
              1)
            (set!
              (array-ref
                (tc-macro-proof-field state-b operand-count)
                identity-b-first)
              1)
            (set!
              (array-ref
                (tc-macro-proof-field state-b operand-count)
                identity-b-next)
              1)
            (set!
              (array-ref
                (tc-macro-proof-field state-a declared-types)
                (* identity-a-first expected-count))
              "i64")
            (set!
              (array-ref
                (tc-macro-proof-field state-a declared-types)
                (* identity-a-next expected-count))
              "u8")
            (set!
              (array-ref
                (tc-macro-proof-field state-a macro-type-kinds)
                (* identity-a-first expected-count))
              "i64")
            (set!
              (array-ref
                (tc-macro-proof-field state-a macro-type-kinds)
                (* identity-a-next expected-count))
              "u8")
            (set!
              (array-ref
                (tc-macro-proof-field state-b declared-types)
                (* identity-b-first expected-count))
              "bool")
            (set!
              (array-ref
                (tc-macro-proof-field state-b declared-types)
                (* identity-b-next expected-count))
              "String")
            (set!
              (array-ref
                (tc-macro-proof-field state-b macro-type-kinds)
                (* identity-b-first expected-count))
              "bool")
            (set!
              (array-ref
                (tc-macro-proof-field state-b macro-type-kinds)
                (* identity-b-next expected-count))
              "string")
            (scratch-reset-functions-for-state state-a)
            (scratch-reset-functions-for-state state-b)
            (map-ready-cell-for-state state-a)
            (map-ready-cell-for-state state-b)
            (set!
              (array-ref (tc-macro-proof-field state-a function-names) family-a)
              "isolation-generator")
            (set!
              (array-ref (tc-macro-proof-field state-a local-names) family-a)
              "item")
            (set!
              (array-ref
                (tc-macro-proof-field state-a storage-identity-vars)
                family-a)
              111)
            (set!
              (array-ref (tc-macro-proof-field state-b function-names) family-b)
              "isolation-generator")
            (set!
              (array-ref (tc-macro-proof-field state-b local-names) family-b)
              "item")
            (set!
              (array-ref
                (tc-macro-proof-field state-b storage-identity-vars)
                family-b)
              222)
            (set!
              ok
              (and
                ok
                (tc-proof-reuse-session-identity-preflight-ids-for-state?
                  state-a
                  module-id-a
                  name-id-a)
                (tc-proof-reuse-session-identity-preflight-ids-for-state?
                  state-b
                  module-id-b
                  name-id-b)
                (complete-key-for-state state-a "isolation-complete-a")
                (not (complete-key-for-state state-a "isolation-complete-b"))
                (complete-key-for-state state-b "isolation-complete-b")
                (not (complete-key-for-state state-b "isolation-complete-a"))
                (=
                  (array-ref
                    (tc-macro-proof-field state-a storage-identity-vars)
                    family-a)
                  111)
                (=
                  (array-ref
                    (tc-macro-proof-field state-b storage-identity-vars)
                    family-b)
                  222)
                (= (tc-macro-proof-field state-a first-slot) identity-a-first)
                (= (tc-macro-proof-field state-b first-slot) identity-b-first)))))
        (set!
          ok
          (and
            ok
            (match (macro-generated-decls-memo-get
              state-a
              "tc-macro-state-isolation")
              [(MacroMaybeSpliceDecls.Some decls)
                (= (ast.ast-decl-list-len (& decls)) 0)]
              [_ false])
            (match (macro-generated-decls-memo-get
              state-b
              "tc-macro-state-isolation")
              [(MacroMaybeSpliceDecls.Some decls)
                (= (ast.ast-decl-list-len (& decls)) 0)]
              [_ false])
            (match (macro-generated-module-memo-get-catalog
              state-a
              "tc-macro-state-isolation-module")
              [(MacroGeneratedModuleCatalogEntry.Catalog target _ _ _ _ _)
                (= target 901)]
              [_ false])
            (match (macro-generated-module-memo-get-catalog
              state-b
              "tc-macro-state-isolation-module")
              [(MacroGeneratedModuleCatalogEntry.Catalog target _ _ _ _ _)
                (= target 902)]
              [_ false])
            (= (tc-macro-abstract-proof-lookup state-a "isolation-macro" "T") 1)
            (= (tc-macro-abstract-proof-lookup state-b "isolation-macro" "T") 2)))
        ;; Independent live-symbol generations and declaration/splice rings must
        ;; survive another job's reset and destroy cadence.
        (let
          [empty-program : ast.AstProgram
            (ast.ast-program (ast.ast-decl-list-new))]
          [empty-paths : ast.AstDeclPathList (ast.ast-decl-path-list-new)]
          [symbols-a : csym.ResultCompilerSymbols
            (macro-live-symbols-build-fresh state-a empty-program empty-paths)]
          [symbols-b : csym.ResultCompilerSymbols
            (macro-live-symbols-build-fresh state-b empty-program empty-paths)]
          [decl-arena-a : i64 (macro-decl-generation-enter! state-a)]
          [decl-arena-b : i64 (macro-decl-generation-enter! state-b)]
          [splice-arena-a : i64 (macro-splice-generation-enter! state-a)]
          [splice-arena-b : i64 (macro-splice-generation-enter! state-b)]
          [enclosing : i64 (arena.tl_arena_current)]
          [_switch-b : unit
            (unsafe
              (arena.tl_arena_set decl-arena-b))]
          [job-b-generation-text : String "job-b-generation"]
          [owned-by-b : String (string.copy (& job-b-generation-text))]
          [_restore : unit
            (unsafe
              (arena.tl_arena_set enclosing))]
          (begin
            (macro-live-symbols-clear! state-a)
            (macro-decl-generations-release! state-a)
            (set!
              ok
              (and
                ok
                (match symbols-a
                  [(csym.ResultCompilerSymbols.Ok _) true]
                  [_ false])
                (match symbols-b
                  [(csym.ResultCompilerSymbols.Ok _) true]
                  [_ false])
                (not (= decl-arena-a decl-arena-b))
                (not (= splice-arena-a splice-arena-b))
                (=
                  (tc-macro-walk-field state-b macro-decl-generation-arena)
                  decl-arena-b)
                (=
                  (tc-macro-walk-field state-b macro-splice-generation-arena)
                  splice-arena-b)
                (tc-macro-walk-field state-b macro-live-symbols-ready)
                (string.eq owned-by-b "job-b-generation")))))
        ;; CTFE result markers and export maps share the same job capability.
        (ctfe_support.ctfe-module-macro-export-reset-for-state!
          (tc-macro-ctfe-state state-a))
        (ctfe_support.ctfe-module-macro-export-reset-for-state!
          (tc-macro-ctfe-state state-b))
        (ctfe_support.ctfe-module-macro-export-add-id-for-state!
          (tc-macro-ctfe-state state-a)
          701
          801)
        (ctfe_support.ctfe-module-macro-export-add-id-for-state!
          (tc-macro-ctfe-state state-b)
          702
          802)
        (ctfe_support.ctfe-result-hygiene-free-note-for-state!
          (tc-macro-ctfe-state state-a)
          17)
        (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
          (tc-macro-ctfe-state state-b))
        (let
          [failed : ctfe_support.ResultCtfe
            (ctfe_support.compiler-ctfe-eval
              (ast.AstExpr.Literal (ast.AstLiteral.Float "not-a-float"))
              (ctfe_support.ctfe-env-empty-with-pools-and-source-names-and-macro-state
                (ast.ast-node-pool-context-capture-active)
                source-names-a
                (tc-macro-ctfe-state state-a))
              8)]
          (set!
            ok
            (and
              ok
              (match failed
                [(ctfe_support.ResultCtfe.Err _) true]
                [_ false]))))
        (set!
          ok
          (and
            ok
            (ctfe_support.ctfe-module-macro-export-id-for-state?
              (tc-macro-ctfe-state state-a)
              701
              801)
            (not
              (ctfe_support.ctfe-module-macro-export-id-for-state?
                (tc-macro-ctfe-state state-b)
                701
                801))
            (=
              (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                (tc-macro-ctfe-state state-a))
              17)
            (=
              (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                (tc-macro-ctfe-state state-b))
              -1)))
        ;; Reset only A. B's import, surface, proof, generated memo, live walk,
        ;; and CTFE export must all remain intact.
        (macro-alias-derived-cache-reset-for-state! state-a)
        (macro-generated-module-memo-reset! state-a)
        (macro-generated-decls-memo-reset! state-a)
        (tc-macro-identity-reset-for-state! state-a)
        (tc-macro-abstract-proof-reset-for-state! state-a)
        (ctfe_support.ctfe-module-macro-export-reset-for-state!
          (tc-macro-ctfe-state state-a))
        (macro-unqualified-import-cache-ensure! state-a)
        (macro-alias-cache-ensure! state-a)
        (macro-flat-import-target-cache-ensure! state-a)
        (macro-surface-call-decl-cache-ensure! state-a)
        (set!
          ok
          (and
            ok
            (=
              (macro-unqualified-import-cache-get state-a module-id-a name-id-a)
              -2)
            (=
              (macro-unqualified-import-cache-get state-b module-id-b name-id-b)
              401)
            (= (macro-alias-cache-get state-a module-id-a name-id-a) -2)
            (= (macro-alias-cache-get state-b module-id-b name-id-b) 402)
            (match (macro-flat-import-target-cache-get state-a module-id-a)
              [(MacroFlatImportTargetCacheLookup.Missing) true]
              [_ false])
            (match (macro-flat-import-target-cache-get state-b module-id-b)
              [(MacroFlatImportTargetCacheLookup.Hit targets)
                (and (= targets.len 1) (= (array-ref targets.slots 0) 403))]
              [_ false])
            (match (macro-surface-call-decl-cache-get state-a 501 601)
              [(MacroSurfaceCallDeclCacheLookup.Miss) true]
              [_ false])
            (match (macro-surface-call-decl-cache-get state-b 501 601)
              [(MacroSurfaceCallDeclCacheLookup.Hit (MacroMaybeDecl.No)) true]
              [_ false])
            (=
              (tc-macro-abstract-proof-lookup state-a "isolation-macro" "T")
              -1)
            (= (tc-macro-abstract-proof-lookup state-b "isolation-macro" "T") 2)
            (not (complete-key-for-state state-a "isolation-complete-a"))
            (complete-key-for-state state-b "isolation-complete-b")
            (not (tc-macro-proof-field state-a has-generated-decls))
            (=
              (array-ref
                (tc-macro-proof-field state-b storage-identity-vars)
                (bucket-name "isolation-generator" "item"))
              222)
            (= (slot-id-for-state state-b module-id-b) (index-key module-id-b))
            (=
              (tc-macro-proof-field state-b first-slot)
              (index-key module-id-b))
            (match (macro-generated-decls-memo-get
              state-b
              "tc-macro-state-isolation")
              [(MacroMaybeSpliceDecls.Some decls)
                (= (ast.ast-decl-list-len (& decls)) 0)]
              [_ false])
            (match (macro-generated-module-memo-get-catalog
              state-a
              "tc-macro-state-isolation-module")
              [(MacroGeneratedModuleCatalogEntry.Empty) true]
              [_ false])
            (match (macro-generated-module-memo-get-catalog
              state-b
              "tc-macro-state-isolation-module")
              [(MacroGeneratedModuleCatalogEntry.Catalog target _ _ _ _ _)
                (= target 902)]
              [_ false])
            (string.eq
              (tc-macro-walk-field state-a macro-expand-active-module)
              "isolation-a")
            (string.eq
              (tc-macro-walk-field state-b macro-expand-active-module)
              "isolation-b")
            (ctfe_support.ctfe-module-macro-export-id-for-state?
              (tc-macro-ctfe-state state-b)
              702
              802)
            (not
              (ctfe_support.ctfe-module-macro-export-id-for-state?
                (tc-macro-ctfe-state state-a)
                701
                801))
            (<
              (tc-macro-identity-lookup-for-state
                state-a
                "tc-macro-state-isolation-owner-only")
              0)
            (>=
              (tc-macro-identity-lookup-for-state
                state-b
                "tc-macro-state-isolation")
              0)
            (=
              (match (ci.intern-generated-canonical-lookup
                "tc-macro-state-isolation-owner-only")
                [(InternLookupFound id) (+ id 1)]
                [(InternLookupMissing) 0])
              installed-generated-identity-before)
            (= (ci.intern-active-table-id) installed-table-id)
            (= (ci.intern-generation) installed-generation)))
        (macro-live-symbols-clear! state-b)
        (macro-decl-generations-release! state-b)
        ok))))

(define (macro-unqualified-import-cache-initialize! [state : TcMacroState]) : unit
  (begin
    (macro-unqualified-import-cache-storage-ensure! state)
    (let
      [table-id : i64 (tc-macro-state-source-name-table-id state)]
      [reset-generation : i64
        (tc-macro-state-source-name-reset-generation state)]
      (if (and
        (= (tc-macro-import-index-control state 14) 1)
        (= (tc-macro-import-index-control state 12) table-id)
        (= (tc-macro-import-index-control state 13) reset-generation))
        unit
        (let
          [i : i64 0]
          (begin
            (while (< i 65536)
              (begin
                (set!
                  (array-ref
                    (tc-macro-import-index-array state unqualified-module-keys)
                    i)
                  0)
                (set! i (+ i 1))))
            (tc-macro-import-index-control-set! state 11 0)
            (tc-macro-import-index-control-set! state 12 table-id)
            (tc-macro-import-index-control-set! state 13 reset-generation)
            (tc-macro-import-index-control-set! state 14 1)))))))

(define (macro-unqualified-import-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (if (and
      (= (array-ref data.control 14) 1)
      (= (array-ref data.control 12) table-id)
      (= (array-ref data.control 13) reset-generation))
      unit
      (macro-unqualified-import-cache-initialize! state))))

(define (macro-unqualified-import-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) (* name-id 40503)) 65535))

;; Returns the cached target module id, -1 for "no imported macro", or -2 when
;; absent.
(define (macro-unqualified-import-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]) : i64
  (let
    [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps 65536))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state unqualified-module-keys)
              cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref
                  (tc-macro-import-index-array state unqualified-name-keys)
                  cursor)
                name-key))
              (begin
                (set!
                  out
                  (array-ref
                    (tc-macro-import-index-array state unqualified-values)
                    cursor))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) 65535))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-unqualified-import-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (if (>= (* (tc-macro-import-index-control state 11) 2) 65536)
    unit
    (let
      [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps 65536))
          (let
            [slot : i64
              (array-ref
                (tc-macro-import-index-array state unqualified-module-keys)
                cursor)]
            (if (= slot 0)
              (begin
                (set!
                  (array-ref
                    (tc-macro-import-index-array state unqualified-module-keys)
                    cursor)
                  module-key)
                (set!
                  (array-ref
                    (tc-macro-import-index-array state unqualified-name-keys)
                    cursor)
                  name-key)
                (set!
                  (array-ref
                    (tc-macro-import-index-array state unqualified-values)
                    cursor)
                  value)
                (tc-macro-import-index-control-set!
                  state
                  11
                  (+ (tc-macro-import-index-control state 11) 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref
                    (tc-macro-import-index-array state unqualified-name-keys)
                    cursor)
                  name-key))
                (set! done true)
                (begin
                  (set! cursor (bit-and (+ cursor 1) 65535))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-cache-initialize! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    (if (and
      (= (array-ref data.control 18) 1)
      (= (array-ref data.control 16) table-id)
      (= (array-ref data.control 17) reset-generation))
      unit
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        [i : i64 0]
        (in-arena
          (arena.Arena owner)
          (begin
            (if (= (array-length data.flat-module-keys) 0)
              (begin
                (set! data.flat-module-keys (array.make-array i64 1024))
                (set!
                  data.flat-values
                  (array.make-array MacroFlatImportTargetList 1024)))
              unit)
            (while (< i 1024)
              (begin
                (set! (array-ref data.flat-module-keys i) 0)
                (set! i (+ i 1))))
            (set! (array-ref data.control 15) 0)
            (set! (array-ref data.control 16) table-id)
            (set! (array-ref data.control 17) reset-generation)
            (set! (array-ref data.control 18) 1)
            (set! (array-ref data.control 19) 0)
            (set! (array-ref data.control 20) 0)
            (tc-macro-import-index-state-data-set! state data)))))))

(define (macro-flat-import-target-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (if (and
      (= (array-ref data.control 18) 1)
      (= (array-ref data.control 16) table-id)
      (= (array-ref data.control 17) reset-generation))
      unit
      (macro-flat-import-target-cache-initialize! state))))

(define (macro-flat-import-target-cache-bucket [module-id : i64]) : i64
  (bit-and (* module-id 2654435761) 1023))

(define (macro-flat-import-target-cache-get
  [state : TcMacroState]
  [module-id : i64]) : MacroFlatImportTargetCacheLookup
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [out : MacroFlatImportTargetCacheLookup
      (MacroFlatImportTargetCacheLookup.Missing)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps 1024))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state flat-module-keys)
              cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot module-key)
              (begin
                (set!
                  out
                  (MacroFlatImportTargetCacheLookup.Hit
                    (tc-global-array-element-shared-view
                      (tc-macro-import-index-array state flat-values)
                      cursor)))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) 1023))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-flat-import-target-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (if (>= (* (tc-macro-import-index-control state 15) 2) 1024)
    unit
    (let
      [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
      [module-key : i64 (+ module-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps 1024))
          (let
            [slot : i64
              (array-ref
                (tc-macro-import-index-array state flat-module-keys)
                cursor)]
            (if (= slot 0)
              (begin
                (set!
                  (array-ref
                    (tc-macro-import-index-array state flat-module-keys)
                    cursor)
                  module-key)
                (set!
                  (array-ref
                    (tc-macro-import-index-array state flat-values)
                    cursor)
                  targets)
                (tc-macro-import-index-control-set!
                  state
                  15
                  (+ (tc-macro-import-index-control state 15) 1))
                (set! done true))
              (if (= slot module-key)
                (set! done true)
                (begin
                  (set! cursor (bit-and (+ cursor 1) 1023))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-list-empty) : MacroFlatImportTargetList
  (MacroFlatImportTargetList (array.make-array i64 0) 0))

;; Appends in program order, so no reversal pass is needed on store. The
;; per-module lists are a handful of entries, so the dedup scan and the
;; append-copy both stay well inside a cache line's worth of work.
(define (macro-flat-import-target-list-add
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : MacroFlatImportTargetList
  (let
    [slots : (__tl_dyn-array i64) targets.slots]
    [len : i64 targets.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (if found
        false
        (< index len))
        (begin
          (if (= (array-ref slots index) target-id)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      (if found
        (MacroFlatImportTargetList slots len)
        (begin
          (__tl_array-push! slots target-id)
          (MacroFlatImportTargetList slots (+ len 1)))))))

(define (macro-flat-import-targets-from-list
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (let
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [cur-module-id : i64 module-id]
    [cur-targets : MacroFlatImportTargetList targets]
    (begin
      (while (< index count)
        (let
          [decl : ast.AstDecl (array-ref decls.slots (+ decl-offset index))]
          (begin
            (match (ast.ast-decl-unwrapped decl)
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [(ast.AstDecl.Import
                  decl-meta
                  (ast.AstImportSpec.Spec _ _ expected maybe-alias _))
                (match maybe-alias
                  [(ast.AstMaybeImportAlias.Some alias)
                    (if (and
                      (= cur-module-id current-module-id)
                      (= alias cbi.compiler-builtin-id-fix-empty))
                      (match expected
                        [(ast.AstMaybeModuleName.Some target-module)
                          (if (= target-module current-module-id)
                            unit
                            (set!
                              cur-targets
                              (macro-flat-import-target-list-add
                                cur-targets
                                target-module)))]
                        [(ast.AstMaybeModuleName.No) unit])
                      unit)]
                  [(ast.AstMaybeImportAlias.No) unit])]
              [_ unit])
            (set! index (+ index 1)))))
      cur-targets)))

;; Overwrite the stored list for a module id already present in the table
;; (macro-flat-import-target-cache-put! keeps existing entries untouched).
(define (macro-flat-import-target-cache-overwrite!
  [state : TcMacroState]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps 1024))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state flat-module-keys)
              cursor)]
          (if (= slot module-key)
            (begin
              (set!
                (array-ref
                  (tc-macro-import-index-array state flat-values)
                  cursor)
                targets)
              (set! done true))
            (if (= slot 0)
              (set! done true)
              (begin
                (set! cursor (bit-and (+ cursor 1) 1023))
                (set! steps (+ steps 1)))))))
      unit)))

;; One-pass eager build of every module's flat-import target list. Each
;; per-module cache miss used to rescan the ENTIRE declaration list (with a
;; ~100B AstDecl unwrap copy per declaration), and the cache resets at every
;; in-pass splice rebuild, so a self-compile re-paid those whole-program scans
;; per module per epoch. Lists are appended in program order, matching
;; macro-flat-import-targets-from-list exactly. If the table's half-load insert
;; cap is hit, complete stays false and misses fall back to the exact scan, so
;; only memoization -- never correctness -- degrades.
(define (macro-flat-import-target-cache-build!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [truncated : bool false]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          ;; Classify through a borrow first: only module markers and imports
          ;; carry a payload this index reads, so every other declaration is
          ;; skipped without the two 104 B rows `ast-decl-unwrapped` copies.
          (if (ast.ast-decl-list-unwrapped-module-or-import-at? (& decls) i)
            (match (ast.ast-decl-unwrapped
              (array-ref decl-slots (+ decl-offset i)))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [(ast.AstDecl.Import
                  decl-meta
                  (ast.AstImportSpec.Spec _ _ expected maybe-alias _))
                (match maybe-alias
                  [(ast.AstMaybeImportAlias.Some alias)
                    (if (= alias cbi.compiler-builtin-id-fix-empty)
                      (match expected
                        [(ast.AstMaybeModuleName.Some target-module)
                          (if (= target-module cur-module-id)
                            unit
                            (match (macro-flat-import-target-cache-get
                              state
                              cur-module-id)
                              [(MacroFlatImportTargetCacheLookup.Hit existing)
                                (macro-flat-import-target-cache-overwrite!
                                  state
                                  cur-module-id
                                  (macro-flat-import-target-list-add
                                    existing
                                    target-module))]
                              [(MacroFlatImportTargetCacheLookup.Missing)
                                (if (>=
                                  (* (tc-macro-import-index-control state 15) 2)
                                  1024)
                                  (set! truncated true)
                                  (macro-flat-import-target-cache-put!
                                    state
                                    cur-module-id
                                    (macro-flat-import-target-list-add
                                      (macro-flat-import-target-list-empty)
                                      target-module)))]))]
                        [(ast.AstMaybeModuleName.No) unit])
                      unit)]
                  [(ast.AstMaybeImportAlias.No) unit])]
              [_ unit])
            unit)
          (set! i (+ i 1))))
      (tc-macro-import-index-control-set! state 19 1)
      (tc-macro-import-index-control-set!
        state
        21
        (ast.ast-decl-list-len (& decls)))
      (tc-macro-import-index-control-set! state 22 decls.offset)
      (tc-macro-import-index-control-set!
        state
        20
        (if truncated
          0
          1)))))

;; R3-P1: this cache outlives the declaration whose expansion first populated
;; it, but its per-module lists are built from whatever arena happens to be
;; current -- during a firing declaration's expansion that is that
;; declaration's generation, which is destroyed a declaration later. Build them
;; in the macro-expansion scratch arena instead. That owner's lifetime is
;; exactly the cache's: `macro-expand-scratch-clear-owned-caches!` runs
;; `macro-alias-derived-cache-reset!` immediately before the scratch is
;; destroyed. Only redirected while a generation is live, so every non-
;; generational caller keeps its existing owner.
(define (macro-flat-import-targets
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (if (not (macro-generation-any-live? state))
    (macro-flat-import-targets-into-current state decls current-module-id)
    (in-arena
      (arena.Arena (macro-expand-scratch-arena-get state))
      (macro-flat-import-targets-into-current state decls current-module-id))))

(define (macro-flat-import-targets-into-current
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (begin
    (macro-flat-import-target-cache-ensure! state)
    (if (= (tc-macro-import-index-control state 19) 1)
      unit
      (macro-flat-import-target-cache-build! state decls))
    (match (macro-flat-import-target-cache-get state current-module-id)
      [(MacroFlatImportTargetCacheLookup.Hit targets) targets]
      [(MacroFlatImportTargetCacheLookup.Missing)
        (if (and
          (= (tc-macro-import-index-control state 20) 1)
          (=
            (tc-macro-import-index-control state 21)
            (ast.ast-decl-list-len (& decls)))
          (= (tc-macro-import-index-control state 22) decls.offset))
          (macro-flat-import-target-list-empty)
          (let
            [targets : MacroFlatImportTargetList
              (macro-flat-import-targets-from-list
                decls
                current-module-id
                cbi.compiler-builtin-id-fix-empty
                (macro-flat-import-target-list-empty))]
            (begin
              (macro-flat-import-target-cache-put!
                state
                current-module-id
                targets)
              targets)))])))

(define (macro-alias-cache-initialize! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    (if (and
      (= (array-ref data.control 3) 1)
      (= (array-ref data.control 1) table-id)
      (= (array-ref data.control 2) reset-generation))
      unit
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        [i : i64 0]
        (in-arena
          (arena.Arena owner)
          (begin
            (if (= (array-length data.alias-module-keys) 0)
              (begin
                (set! data.alias-module-keys (array.make-array i64 16384))
                (set! data.alias-qualifier-keys (array.make-array i64 16384))
                (set! data.alias-values (array.make-array i64 16384)))
              unit)
            (while (< i 16384)
              (begin
                (set! (array-ref data.alias-module-keys i) 0)
                (set! i (+ i 1))))
            (set! (array-ref data.control 0) 0)
            (set! (array-ref data.control 1) table-id)
            (set! (array-ref data.control 2) reset-generation)
            (set! (array-ref data.control 3) 1)
            (set! (array-ref data.control 4) 0)
            (set! (array-ref data.control 5) 0)
            (set! (array-ref data.control 6) 0)
            (tc-macro-import-index-state-data-set! state data)))))))

(define (macro-alias-cache-ensure! [state : TcMacroState]) : unit
  (let
    [data : TcMacroImportIndexStateData
      (tc-macro-import-index-state-data state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (if (and
      (= (array-ref data.control 3) 1)
      (= (array-ref data.control 1) table-id)
      (= (array-ref data.control 2) reset-generation))
      unit
      (macro-alias-cache-initialize! state))))

(define (macro-alias-cache-bucket [module-id : i64] [qualifier-id : i64]) : i64
  (bit-and (+ (* module-id 2654435761) qualifier-id) 16383))

;; Returns the cached value for `(module-id, qualifier-id)`, or -2 when absent.
(define (macro-alias-cache-get
  [state : TcMacroState]
  [module-id : i64]
  [qualifier-id : i64]) : i64
  (let
    [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
    [module-key : i64 (+ module-id 1)]
    [qualifier-key : i64 (+ qualifier-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps 16384))
        (let
          [slot : i64
            (array-ref
              (tc-macro-import-index-array state alias-module-keys)
              cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref
                  (tc-macro-import-index-array state alias-qualifier-keys)
                  cursor)
                qualifier-key))
              (begin
                (set!
                  out
                  (array-ref
                    (tc-macro-import-index-array state alias-values)
                    cursor))
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) 16383))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-alias-cache-put!
  [state : TcMacroState]
  [module-id : i64]
  [qualifier-id : i64]
  [value : i64]) : unit
  (if (>= (* (tc-macro-import-index-control state 0) 2) 16384)
    unit
    (let
      [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
      [module-key : i64 (+ module-id 1)]
      [qualifier-key : i64 (+ qualifier-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps 16384))
          (let
            [slot : i64
              (array-ref
                (tc-macro-import-index-array state alias-module-keys)
                cursor)]
            (if (= slot 0)
              (begin
                (set!
                  (array-ref
                    (tc-macro-import-index-array state alias-module-keys)
                    cursor)
                  module-key)
                (set!
                  (array-ref
                    (tc-macro-import-index-array state alias-qualifier-keys)
                    cursor)
                  qualifier-key)
                (set!
                  (array-ref
                    (tc-macro-import-index-array state alias-values)
                    cursor)
                  value)
                (tc-macro-import-index-control-set!
                  state
                  0
                  (+ (tc-macro-import-index-control state 0) 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref
                    (tc-macro-import-index-array state alias-qualifier-keys)
                    cursor)
                  qualifier-key))
                (begin
                  (let
                    [existing : i64
                      (array-ref
                        (tc-macro-import-index-array state alias-values)
                        cursor)]
                    (if (and
                      (or (= value -3) (>= value 0))
                      (or (< existing 0) (= existing qualifier-id))
                      (not (= value existing)))
                      (set!
                        (array-ref
                          (tc-macro-import-index-array state alias-values)
                          cursor)
                        value)
                      unit))
                  (set! done true))
                (begin
                  (set! cursor (bit-and (+ cursor 1) 16383))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-alias-cache-index-range!
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [start : i64]
  [count : i64]
  [start-module-id : i64]) : i64
  (let
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [cur-module-id : i64 start-module-id]
    [i : i64 start]
    (begin
      (while (< i count)
        (begin
          ;; Classify through a borrow first: only module markers and imports
          ;; carry a payload this index reads, so every other declaration is
          ;; skipped without the two 104 B rows `ast-decl-unwrapped` copies.
          (if (ast.ast-decl-list-unwrapped-module-or-import-at? (& decls) i)
            (match (ast.ast-decl-unwrapped
              (array-ref decl-slots (+ decl-offset i)))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [(ast.AstDecl.Import
                  decl-meta
                  (ast.AstImportSpec.Spec kind _ expected maybe-alias _))
                (if (macro-import-kind-module-alias? kind)
                  (match maybe-alias
                    [(ast.AstMaybeImportAlias.Some alias)
                      (let
                        [target-id : i64
                          (match expected
                            [(ast.AstMaybeModuleName.Some target) target]
                            [(ast.AstMaybeModuleName.No) alias])]
                        (if (>=
                          (* (tc-macro-import-index-control state 0) 2)
                          16384)
                          (tc-macro-import-index-control-set! state 6 0)
                          (macro-alias-cache-put!
                            state
                            cur-module-id
                            alias
                            target-id)))]
                    [(ast.AstMaybeImportAlias.No) unit])
                  unit)]
              [_ unit])
            unit)
          (set! i (+ i 1))))
      cur-module-id)))

;; The expansion prefix is a prepend builder and therefore stored in reverse
;; program order. Index it back-to-front without constructing the large
;; generic segmented iterator result for every declaration.
(define (macro-alias-cache-index-reverse-range!
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [start : i64]
  [start-module-id : i64]) : i64
  (let
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [cur-module-id : i64 start-module-id]
    [i : i64 start]
    (begin
      (while (>= i 0)
        (begin
          (if (ast.ast-decl-list-unwrapped-module-or-import-at? (& decls) i)
            (match (ast.ast-decl-unwrapped
              (array-ref decl-slots (+ decl-offset i)))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [(ast.AstDecl.Import
                  _decl-meta
                  (ast.AstImportSpec.Spec kind _ expected maybe-alias _))
                (if (macro-import-kind-module-alias? kind)
                  (match maybe-alias
                    [(ast.AstMaybeImportAlias.Some alias)
                      (let
                        [target-id : i64
                          (match expected
                            [(ast.AstMaybeModuleName.Some target) target]
                            [(ast.AstMaybeModuleName.No) alias])]
                        (if (>=
                          (* (tc-macro-import-index-control state 0) 2)
                          16384)
                          (tc-macro-import-index-control-set! state 6 0)
                          (macro-alias-cache-put!
                            state
                            cur-module-id
                            alias
                            target-id)))]
                    [(ast.AstMaybeImportAlias.No) unit])
                  unit)]
              [_ unit])
            unit)
          (set! i (- i 1))))
      cur-module-id)))

;; One-pass eager index over the program's aliased imports: record every
;; (module, alias) -> target mapping in program order (first import wins,
;; matching macro-import-alias-target-ids' first-match scan). Each per-pair
;; cache miss used to rescan the ENTIRE declaration list -- and the cache is
;; reset at every in-pass splice rebuild, so a self-compile re-paid those
;; whole-program scans (with a ~100B AstDecl unwrap copy per declaration)
;; hundreds of times. One pass makes every later query O(1); if the table's
;; half-load insert cap is ever hit, complete stays false and misses fall back
;; to the exact scan, so only memoization -- never correctness -- degrades.
(define (macro-alias-cache-build!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    (begin
      (tc-macro-import-index-control-set! state 6 1)
      (tc-macro-import-index-control-set!
        state
        10
        (macro-alias-cache-index-range!
          state
          decls
          0
          count
          cbi.compiler-builtin-id-fix-empty))
      (tc-macro-import-index-control-set! state 4 1)
      (tc-macro-import-index-control-set! state 5 0)
      (tc-macro-import-index-control-set! state 7 count)
      (tc-macro-import-index-control-set! state 8 decls.offset)
      (tc-macro-import-index-control-set!
        state
        9
        (macro-decl-list-slots-data-addr decls)))))

(define (macro-alias-cache-build-segmented! [job-state : TcJobState]) : unit
  (let
    [state : TcMacroState (tc-job-state-macro-state job-state)]
    [count : i64 (macro-segmented-program-decl-count job-state)]
    [data : MacroSegmentedProgramViewData
      (macro-segmented-program-view-data
        (tc-job-state-macro-program-view-address job-state))]
    [prefix : ast.AstDeclList data.prefix-rev]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [node-address : i64 data.head]
    [node-index : i64 data.cursor]
    (begin
      (tc-macro-import-index-control-set! state 6 1)
      (set!
        cur-module-id
        (macro-alias-cache-index-reverse-range!
          state
          prefix
          (- (ast.ast-decl-list-len (& prefix)) 1)
          cur-module-id))
      (while (> node-address 0)
        (let
          [node : MacroProgramSegmentNodeData
            (macro-program-segment-node-data node-address)]
          [decls : ast.AstDeclList node.decls]
          (begin
            (set!
              cur-module-id
              (macro-alias-cache-index-range!
                state
                decls
                node-index
                (ast.ast-decl-list-len (& decls))
                cur-module-id))
            (set! node-address node.next)
            (set! node-index 0))))
      (tc-macro-import-index-control-set! state 10 cur-module-id)
      (tc-macro-import-index-control-set! state 4 1)
      (tc-macro-import-index-control-set! state 5 1)
      (tc-macro-import-index-control-set! state 7 count)
      (tc-macro-import-index-control-set! state 8 -1)
      (tc-macro-import-index-control-set! state 9 0))))

;; Macro expansion appends generated declarations to the active program view.
;; Keep the eager index synchronized once per larger view. When the backing
;; array is stable, consume only the new tail. Growth may reallocate the list;
;; in that case rebuild the index once over the replacement view rather than
;; making every later miss rescan it. Smaller/offset views remain transient and
;; retain the exact fallback below.
(define (macro-alias-cache-adopt-larger-view!
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : unit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    (if (and
      (= (tc-macro-import-index-control state 8) decls.offset)
      (> count (tc-macro-import-index-control state 7)))
      (if (=
        (tc-macro-import-index-control state 9)
        (macro-decl-list-slots-data-addr decls))
        (begin
          (tc-macro-import-index-control-set!
            state
            10
            (macro-alias-cache-index-range!
              state
              decls
              (tc-macro-import-index-control state 7)
              count
              (tc-macro-import-index-control state 10)))
          (tc-macro-import-index-control-set! state 7 count))
        (begin
          (tc-macro-import-index-control-set! state 3 0)
          (macro-alias-cache-ensure! state)
          (macro-alias-cache-build! state decls)))
      unit)))

(define (macro-import-alias-target-cached-id
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeNameId
  (begin
    (macro-alias-cache-ensure! state)
    (if (= (tc-macro-import-index-control state 4) 1)
      unit
      (macro-alias-cache-build! state decls))
    (macro-alias-cache-adopt-larger-view! state decls)
    (let
      [cached : i64
        (macro-alias-cache-get state current-module-id qualifier-id)]
      (cond
        [(= cached -3)
          (match (tc-lazy-import-stub-target-indexed-for-state
            state
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  state
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No) (TcMaybeNameId.Some qualifier-id)])]
        [(= cached -2)
          (match (tc-lazy-import-stub-target-indexed-for-state
            state
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  state
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No)
              (match (macro-import-alias-target-ids
                decls
                current-module-id
                qualifier-id
                cbi.compiler-builtin-id-fix-empty)
                [(TcMaybeNameId.Some target-id)
                  (begin
                    (macro-alias-cache-put!
                      state
                      current-module-id
                      qualifier-id
                      (if (= target-id qualifier-id)
                        -3
                        target-id))
                    (TcMaybeNameId.Some target-id))]
                [(TcMaybeNameId.No)
                  (begin
                    (macro-alias-cache-put!
                      state
                      current-module-id
                      qualifier-id
                      -1)
                    (TcMaybeNameId.No))])])]
        [(< cached 0) (TcMaybeNameId.No)]
        [(= cached qualifier-id)
          (match (tc-lazy-import-stub-target-indexed-for-state
            state
            current-module-id
            qualifier-id)
            [(TcMaybeNameId.Some target-id)
              (begin
                (macro-alias-cache-put!
                  state
                  current-module-id
                  qualifier-id
                  (if (= target-id qualifier-id)
                    -3
                    target-id))
                (TcMaybeNameId.Some target-id))]
            [(TcMaybeNameId.No)
              (match (macro-import-alias-target-ids
                decls
                current-module-id
                qualifier-id
                cbi.compiler-builtin-id-fix-empty)
                [(TcMaybeNameId.Some target-id)
                  (begin
                    (macro-alias-cache-put!
                      state
                      current-module-id
                      qualifier-id
                      (if (= target-id qualifier-id)
                        -3
                        target-id))
                    (TcMaybeNameId.Some target-id))]
                [(TcMaybeNameId.No)
                  (begin
                    (macro-alias-cache-put!
                      state
                      current-module-id
                      qualifier-id
                      -3)
                    (TcMaybeNameId.Some cached))])])]
        [else (TcMaybeNameId.Some cached)]))))

(define (macro-import-alias-target-cached-id-in-context
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeNameId
  (let
    [job-state : TcJobState (tc-context-job-state ctx)]
    [state : TcMacroState (tc-context-macro-state ctx)]
    (begin
      (if (macro-segmented-program-active? job-state)
        (begin
          (macro-alias-cache-ensure! state)
          (if (and
            (= (tc-macro-import-index-control state 4) 1)
            (= (tc-macro-import-index-control state 5) 1))
            unit
            (begin
              (tc-macro-import-index-control-set! state 3 0)
              (macro-alias-cache-ensure! state)
              (macro-alias-cache-build-segmented! job-state))))
        unit)
      (macro-import-alias-target-cached-id
        state
        decls
        current-module-id
        qualifier-id))))

(define (macro-resolve-qualified-module-id
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : i64
  (match (macro-import-alias-target-cached-id-in-context
    ctx
    decls
    current-module-id
    qualifier-id)
    [(TcMaybeNameId.Some target-id) target-id]
    [(TcMaybeNameId.No) qualifier-id]))

(define (macro-missing-macro-message [name : String]) : String
  (str_cat.str-cat "typecheck: missing macro " name))

(define (macro-source-module-id [module-id : i64]) : i64
  (if (csym.compiler-symbol-root-module-id? module-id)
    cbi.compiler-builtin-id-fix-empty
    module-id))

(define (macro-decl-module-display [module-id : i64]) : String
  (if (csym.compiler-symbol-root-module-id? module-id)
    ""
    (tc-env-key-name-text module-id)))

(define (macro-decl-name-display [name-id : i64] [module-id : i64]) : String
  (csym.compiler-symbol-module-key
    (macro-decl-module-display module-id)
    (tc-env-key-name-text name-id)))

(define (macro-qualified-call-decl-in-module
  [ctx : TcContext]
  [target-module-id : i64]
  [base-id : i64]
  [name : String]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [macro-handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        base-id
        (csym.compiler-symbols-missing-handle))]
    ;; A macro that exists in the target module resolves directly from the
    ;; symbol table.
    (if (csym.compiler-symbols-handle-found? macro-handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index macro-handle)
        target-module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (ResultMacroCallDecl.Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                call-expr
                (macro-missing-macro-message name))))])
      (match (macro-surface-call-decl-in-module
        (tc-context-macro-state ctx)
        target-module-id
        base-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (if (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              target-module-id
              base-id
              (csym.compiler-symbols-missing-handle)))
            (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))
            (ResultMacroCallDecl.Err
              (box
                (ctfe_support.ctfe-diagnostic-at-expr
                  call-expr
                  (macro-missing-macro-message name)))))]))))

(define (macro-qualified-call-decl
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [hygiene-source-id : i64
      (macro-hygiene-global-source-name-id-or source-name-id source-name-id)]
    [source-id : i64 hygiene-source-id]
    [lookup-qualifier-id : i64 (tc-qualified-name-module-id lookup-name-id)]
    [source-qualifier-id : i64 (tc-qualified-name-module-id source-id)]
    [qualifier-id : i64
      (if (>= lookup-qualifier-id 0)
        lookup-qualifier-id
        (if (>= source-qualifier-id 0)
          source-qualifier-id
          definition-module-id))]
    [base-id : i64 (tc-qualified-name-base-id lookup-name-id)]
    (if (and (>= qualifier-id 0) (>= base-id 0))
      (let
        [target-module-id : i64
          (macro-resolve-qualified-module-id
            ctx
            decls
            (tc-context-module-id ctx)
            qualifier-id)]
        (macro-qualified-call-decl-in-module
          ctx
          target-module-id
          base-id
          name
          call-expr))
      (ResultMacroCallDecl.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            (str_cat.str-cat
              "typecheck: qualified macro has no source id: "
              name)))))))

;; The implicit core macro prelude module (stdlib/core_macros.tl). A bare name
;; that is not bound as a macro in the current module falls back to this module's
;; available macros, so `and`/`or`/`when`/`unless`/`cond` resolve without an
;; explicit import. Local macros and explicit imports therefore take
;; precedence over the prelude. Returns MacroMaybeDecl.No (an ordinary call, not an
;; error) when the name is not a prelude macro, leaving plain calls unaffected.
(define (macro-prelude-resolve-module
  [ctx : TcContext]
  [symbols : csym.CompilerSymbols]
  [module-id : i64]
  [lookup-id : i64]) : ResultMacroCallDecl
  ;; The implicit core_macros prelude resolves its macros straight from the
  ;; module's symbol table. core_macros declares exactly the prelude macros, so
  ;; this resolves the same set (`and`, `or`, `when`, `unless`, `cond`).
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        symbols
        module-id
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        symbols
        (csym.compiler-symbol-handle-index handle)
        module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (ResultMacroCallDecl.Ok (MacroMaybeDecl.No)))))

(define (macro-prelude-resolve
  [ctx : TcContext]
  [symbols : csym.CompilerSymbols]
  [lookup-id : i64]) : ResultMacroCallDecl
  (match (macro-prelude-resolve-module
    ctx
    symbols
    cbi.compiler-builtin-id-core-macros-module
    lookup-id)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          ;; Compatibility fallback for sources loaded with the old module
          ;; identity before the core_macros spelling migration.
          (macro-prelude-resolve-module
            ctx
            symbols
            cbi.compiler-builtin-id-core-macros-legacy-module
            lookup-id)]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-prelude-call-decl
  [ctx : TcContext]
  [_decls : ast.AstDeclList]
  [lookup-name-id : i64]
  [_call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (macro-prelude-resolve ctx (tc-context-symbols ctx) lookup-name-id))

(defstruct TcMacroResultIdentityStateData
  (table-id i64)
  (reset-generation i64)
  (source-count i64)
  (module-id i64)
  (macro-id i64))

(define (tc-macro-result-identity-state-address-initialize
  [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-result-identity)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcMacroResultIdentityStateData)
              (array.make-array TcMacroResultIdentityStateData 1)]
            [_init : unit
              (set!
                (array-ref cell 0)
                (TcMacroResultIdentityStateData -1 -1 -1 -1 -1))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcMacroResultIdentityStateData))))
                : i64)]
            (begin
              (tc-macro-state-slot-address-set!
                state
                tc-macro-state-slot-result-identity
                next)
              next)))))))

(define (tc-macro-result-identity-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    9
    tc-macro-result-identity-state-address-initialize))

(define (tc-macro-result-identity-state-data [state : TcMacroState]) : TcMacroResultIdentityStateData
  (unsafe
    (ptr-read
      (int->ptr
        (cast (tc-macro-result-identity-state-address state) : u64)
        : (Ptr TcMacroResultIdentityStateData)))))

(define (tc-macro-result-identity-state-data-set!
  [state : TcMacroState]
  [data : TcMacroResultIdentityStateData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr
        (cast (tc-macro-result-identity-state-address state) : u64)
        : (MutPtr TcMacroResultIdentityStateData))
      data)))

(define (macro-stdlib-result-identity-ensure! [state : TcMacroState]) : unit
  (let
    [session : ci.InternSourceNameSession
      (tc-macro-state-source-name-session state)]
    [identity : TcMacroResultIdentityStateData
      (tc-macro-result-identity-state-data state)]
    (if (and
      (= identity.table-id session.table-id)
      (= identity.reset-generation session.reset-generation)
      (= identity.source-count session.source-count))
      unit
      (begin
        (set!
          identity.module-id
          (match (ci.intern-source-name-session-lookup session "stdlib.result")
            [(ci.InternLookupFound module-id) module-id]
            [(ci.InternLookupMissing) -1]))
        (set!
          identity.macro-id
          (match (ci.intern-source-name-session-lookup session "result")
            [(ci.InternLookupFound macro-id) macro-id]
            [(ci.InternLookupMissing) -1]))
        (set! identity.table-id session.table-id)
        (set! identity.reset-generation session.reset-generation)
        (set! identity.source-count session.source-count)
        (tc-macro-result-identity-state-data-set! state identity)))))

(define (macro-refresh-stdlib-result-surface-if-needed!
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : unit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [_ensure : unit (macro-stdlib-result-identity-ensure! state)]
    [identity : TcMacroResultIdentityStateData
      (tc-macro-result-identity-state-data state)]
    (if (and
      (= target-module-id identity.module-id)
      (= lookup-name-id identity.macro-id))
      (match (cload.compiler-load-surface-summary-find-module target-module-id)
        [(CompilerLoadSomeSurfaceSummary summary)
          (begin
            (cload.compiler-load-surface-summary-refresh-with-pools
              summary.source-path
              summary.source-path-id
              (svec.new)
              (ast.AstMaybeModuleName.Some target-module-id)
              "stdlib"
              (parser.compiler-cfg-empty)
              (tc-context-pools ctx))
            ;; The surface parser pushes through the explicit context. The retry below
            ;; reads the retained body through ast-node-get, so publish that updated
            ;; context before materializing the macro declaration.
            (tc-context-install-pools! ctx)
            (macro-surface-call-decl-cache-reset! (tc-context-macro-state ctx)))]
        [(CompilerLoadNoSurfaceSummary) unit])
      unit)))

(define (macro-unqualified-imported-target-call-decl
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]
  [_call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        lookup-name-id
        (csym.compiler-symbols-missing-handle))]
    ;; Resolve an imported macro that exists in the target module directly from
    ;; the symbol table.
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        target-module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module
        (tc-context-macro-state ctx)
        target-module-id
        lookup-name-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (begin
            (macro-refresh-stdlib-result-surface-if-needed!
              ctx
              target-module-id
              lookup-name-id)
            (match (macro-surface-call-decl-in-module
              (tc-context-macro-state ctx)
              target-module-id
              lookup-name-id)
              [(MacroMaybeDecl.Some
                  retry-name
                  retry-module
                  retry-declaration-id
                  retry-params
                  retry-ret
                  retry-body)
                (ResultMacroCallDecl.Ok
                  (MacroMaybeDecl.Some
                    retry-name
                    retry-module
                    retry-declaration-id
                    retry-params
                    retry-ret
                    retry-body))]
              [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))]))))

(define (macro-unqualified-imported-call-target
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : i64
  ;; Any macro present in the target module is a resolution candidate.
  (if (csym.compiler-symbols-handle-found?
    (csym.compiler-symbols-lookup-macro-in-module-id-or
      (tc-context-symbols ctx)
      target-module-id
      lookup-name-id
      (csym.compiler-symbols-missing-handle)))
    target-module-id
    (if (macro-surface-macro-in-module? target-module-id lookup-name-id)
      target-module-id
      -1)))

(define (macro-unqualified-imported-call-target-from-imports
  [ctx : TcContext]
  [targets : MacroFlatImportTargetList]
  [lookup-name-id : i64]) : i64
  (let
    [slots : (__tl_dyn-array i64) targets.slots]
    [len : i64 targets.len]
    [index : i64 0]
    [target : i64 -1]
    (begin
      (while (if (= target -1)
        (< index len)
        false)
        (begin
          (set!
            target
            (macro-unqualified-imported-call-target
              ctx
              (array-ref slots index)
              lookup-name-id))
          (set! index (+ index 1))))
      target)))

(define (macro-unqualified-imported-call-decl-from-target
  [ctx : TcContext]
  [target : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (>= target 0)
    (macro-unqualified-imported-target-call-decl
      ctx
      target
      lookup-name-id
      call-expr)
    (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))))

(define (macro-unqualified-imported-call-decl-cached
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (begin
    (macro-unqualified-import-cache-ensure! (tc-context-macro-state ctx))
    (let
      [cached : i64
        (macro-unqualified-import-cache-get
          (tc-context-macro-state ctx)
          module-id
          lookup-name-id)]
      [target : i64
        (if (= cached -2)
          (let
            [resolved : i64
              (macro-unqualified-imported-call-target-from-imports
                ctx
                (macro-flat-import-targets
                  (tc-context-macro-state ctx)
                  decls
                  module-id)
                lookup-name-id)]
            (begin
              (macro-unqualified-import-cache-put!
                (tc-context-macro-state ctx)
                module-id
                lookup-name-id
                resolved)
              resolved))
          cached)]
      (macro-unqualified-imported-call-decl-from-target
        ctx
        target
        lookup-name-id
        call-expr))))

(define (macro-unqualified-imported-call-decl
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-imported-call-decl-cached
    ctx
    decls
    module-id
    lookup-name-id
    call-expr))

(define (macro-unqualified-call-decl-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [_ : String]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        module-id
        lookup-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        ctx
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        module-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module
        (tc-context-macro-state ctx)
        module-id
        lookup-name-id)
        [(MacroMaybeDecl.Some
            macro-name
            def-module
            declaration-id
            params
            ret
            body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some
              macro-name
              def-module
              declaration-id
              params
              ret
              body))]
        [(MacroMaybeDecl.No)
          (match (macro-unqualified-imported-call-decl
            ctx
            decls
            module-id
            lookup-name-id
            call-expr)
            [(ResultMacroCallDecl.Ok imported-decl)
              (match imported-decl
                [(MacroMaybeDecl.No)
                  (macro-prelude-call-decl
                    (tc-context-with-module-id ctx module module-id)
                    decls
                    lookup-name-id
                    call-expr)]
                [_ (ResultMacroCallDecl.Ok imported-decl)])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)])]))))

(define (macro-call-decl-from-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [source-name-id : i64]
  [definition-module-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (let
    [slash : i64 (tc-qualified-name-last-slash lookup-name)]
    (if (and (> slash 0) (< slash (- (string.string-length lookup-name) 1)))
      (macro-qualified-call-decl
        (tc-context-with-module-id ctx module module-id)
        decls
        lookup-name
        lookup-name-id
        source-name-id
        definition-module-id
        call-expr)
      (macro-unqualified-call-decl-in-module
        ctx
        decls
        module
        module-id
        lookup-name
        lookup-name-id
        call-expr))))

(define (macro-call-decl-from-source-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (tc-source-legacy-core-macro-compat? lookup-name)
    (macro-call-decl-from-name
      ctx
      decls
      module
      module-id
      lookup-name
      lookup-name-id
      lookup-name-id
      -1
      call-expr)
    (let
      [source-ctx : TcContext
        (tc-context-with-program
          (tc-context-with-module-id ctx module module-id)
          (ast.ast-program decls))]
      (match (tc-source-type-name-lookup-from-id
        source-ctx
        lookup-name
        lookup-name-id)
        [(TcNameLookup.Ok resolved-name resolved-id)
          (macro-call-decl-from-name
            ctx
            decls
            module
            module-id
            resolved-name
            resolved-id
            lookup-name-id
            -1
            call-expr)]
        [(TcNameLookup.Err message)
          (ResultMacroCallDecl.Err
            (box (ctfe_support.ctfe-diagnostic-at-expr call-expr message)))]))))

(define (macro-call-decl-from-hygiene-name
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [definition-module : String]
  [definition-module-id : i64]
  [lookup-name : String]
  [lookup-id : i64]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (if (< lookup-id 0)
    (ResultMacroCallDecl.Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          (str_cat.str-cat
            "typecheck: macro hygiene source id unavailable: "
            lookup-name))))
    (if (and
      (>= (tc-name-first-dot-id lookup-id) 0)
      (not (tc-name-qualified-id? lookup-id))
      (< (tc-qualified-name-last-slash lookup-name) 0))
      (macro-call-decl-from-source-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        call-expr)
      (macro-call-decl-from-name
        ctx
        decls
        definition-module
        definition-module-id
        lookup-name
        lookup-id
        lookup-id
        definition-module-id
        call-expr))))

;; If `func` names a visible macro, return that macro's decl. Bare local macros
;; are module-scope visible regardless of source order; qualified macro calls
;; must pass the export table. A bare name not bound locally falls back to the
;; implicit core macro prelude.
(define (macro-call-decl
  [ctx : TcContext]
  [func : ast.AstExpr]
  [decls : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroCallDecl
  (match func
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(ast.AstExpr.Var name)
      (if (or
        (csym.compiler-composite-pair-key-id? name)
        (csym.compiler-composite-triple-key-id? name))
        (macro-call-decl-from-name
          ctx
          decls
          (tc-context-module ctx)
          (macro-source-module-id (tc-context-module-id ctx))
          (tc-nominal-name-id-display name)
          name
          name
          -1
          call-expr)
        (if (tc-hygiene-global-name-id? name)
          (if (macro-hygiene-global-id? name)
            (let
              [module-id : i64 (macro-hygiene-global-module-id name)]
              [lookup-name-id : i64
                (macro-hygiene-global-source-name-id-or name -1)]
              (macro-call-decl-from-hygiene-name
                ctx
                decls
                (macro-decl-module-display module-id)
                (macro-source-module-id module-id)
                (ci.intern-str lookup-name-id)
                lookup-name-id
                call-expr))
            (match (tc-hygiene-global-decode (tc-env-key-name-text name))
              [(TcHygieneGlobalName.Legacy lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  (tc-context-module ctx)
                  (macro-source-module-id (ci.intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or name -1)
                  call-expr)]
              [(TcHygieneGlobalName.Context module lookup-name)
                (macro-call-decl-from-hygiene-name
                  ctx
                  decls
                  module
                  (macro-source-module-id (ci.intern-qualified-module-id name))
                  lookup-name
                  (macro-hygiene-global-source-name-id-or name -1)
                  call-expr)]))
          (macro-call-decl-from-source-name
            ctx
            decls
            (tc-context-module ctx)
            (macro-source-module-id (tc-context-module-id ctx))
            (tc-hygiene-name-text-id name)
            name
            call-expr)))]
    [_ (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-call-decl-with-context
  [ctx : TcContext]
  [func : ast.AstExpr]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [context : ast.AstMaybeModuleName]
  [call-expr : ast.AstExpr]) : ResultMacroCallDeclModule
  (match (macro-call-decl
    (tc-context-with-module-id ctx module module-id)
    func
    decls
    call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match context
            [(ast.AstMaybeModuleName.Some context-module-id)
              (let
                [context-module : String (ci.intern-str context-module-id)]
                (if (= context-module-id module-id)
                  (ResultMacroCallDeclModule.Ok maybe-decl module module-id)
                  (match (macro-call-decl
                    (tc-context-with-module-id
                      ctx
                      context-module
                      context-module-id)
                    func
                    decls
                    call-expr)
                    [(ResultMacroCallDecl.Ok context-decl)
                      (match context-decl
                        [(MacroMaybeDecl.No)
                          (ResultMacroCallDeclModule.Ok
                            maybe-decl
                            module
                            module-id)]
                        [_
                          (ResultMacroCallDeclModule.Ok
                            context-decl
                            context-module
                            context-module-id)])]
                    [(ResultMacroCallDecl.Err diag)
                      (ResultMacroCallDeclModule.Err diag)])))]
            [(ast.AstMaybeModuleName.No)
              (ResultMacroCallDeclModule.Ok maybe-decl module module-id)])]
        [_ (ResultMacroCallDeclModule.Ok maybe-decl module module-id)])]
    [(ResultMacroCallDecl.Err primary-diag)
      (match context
        [(ast.AstMaybeModuleName.Some context-module-id)
          (let
            [context-module : String (ci.intern-str context-module-id)]
            (if (= context-module-id module-id)
              (ResultMacroCallDeclModule.Err primary-diag)
              (match (macro-call-decl
                (tc-context-with-module-id ctx context-module context-module-id)
                func
                decls
                call-expr)
                [(ResultMacroCallDecl.Ok context-decl)
                  (match context-decl
                    [(MacroMaybeDecl.No)
                      (ResultMacroCallDeclModule.Err primary-diag)]
                    [_
                      (ResultMacroCallDeclModule.Ok
                        context-decl
                        context-module
                        context-module-id)])]
                [(ResultMacroCallDecl.Err _)
                  (ResultMacroCallDeclModule.Err primary-diag)])))]
        [(ast.AstMaybeModuleName.No)
          (ResultMacroCallDeclModule.Err primary-diag)])]))

(define (macro-operand-mismatch-message
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got "
    (tc-type-render actual)))

(define (macro-clause-shape-message) : String
  "typecheck: ExprClause macro operand expects bracket clause [expr expr]")

(define (macro-binding-clause-shape-message) : String
  "typecheck: ExprBindingClause macro operand expects bracket clause [name expr] or [name : Type expr]")

(define (macro-clause-operand-mismatch-message [expected : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got bracket clause"))

(define (macro-type-arg-module-qualify-id [ctx : TcContext] [name : i64]) : i64
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (macro-hygiene-global-id? name))
      (not (tc-structural-local-name-id? name))
      (not (csym.compiler-composite-pair-key-id? name))
      (not (csym.compiler-composite-triple-key-id? name))
      (not (tc-name-qualified-id? name))
      (not (tc-source-slash-qualified-id? (tc-env-key-name-text name) name)))
      (tc-module-name-id-by-id (tc-context-module-id ctx) name)
      name)))

(define (macro-type-arg-module-qualify-list
  [ctx : TcContext]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (macro-type-arg-module-qualify-list-at ctx (& types) 0))

(define (macro-type-arg-module-qualify-list-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (macro-type-arg-module-qualify
        ctx
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (macro-type-arg-module-qualify-list-at ctx types (+ index 1)))))

(define (macro-type-arg-module-qualify [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match ty
    [(ast.AstType.Func args ret)
      (ast.ast-ty-func
        (macro-type-arg-module-qualify-list ctx (__tl-box-place args))
        (macro-type-arg-module-qualify ctx (ast.ty-node-get ret)))]
    [(ast.AstType.Tuple elems)
      (ast.ast-ty-tuple
        (macro-type-arg-module-qualify-list ctx (__tl-box-place elems)))]
    [(ast.AstType.Array elem len)
      (ast.ast-ty-array
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem))
        len)]
    [(ast.AstType.DynArray elem)
      (ast.ast-ty-dyn-array
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))]
    [(ast.AstType.Slice elem)
      (ast.ast-ty-slice
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))]
    [(ast.AstType.Box elem)
      (ast.ast-ty-box
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))]
    [(ast.AstType.Ptr elem)
      (ast.ast-ty-ptr
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))]
    [(ast.AstType.MutPtr elem)
      (ast.ast-ty-mut-ptr
        (macro-type-arg-module-qualify ctx (ast.ty-node-get elem)))]
    [(ast.AstType.Ref region inner)
      (ast.ast-ty-ref
        region
        (macro-type-arg-module-qualify ctx (ast.ty-node-get inner)))]
    [(ast.AstType.MutRef region inner)
      (ast.ast-ty-mut-ref
        region
        (macro-type-arg-module-qualify ctx (ast.ty-node-get inner)))]
    [(ast.AstType.Region region inner)
      (ast.ast-ty-region
        region
        (macro-type-arg-module-qualify ctx (ast.ty-node-get inner)))]
    [(ast.AstType.Var name)
      (ast.AstType.Var (macro-type-arg-module-qualify-id ctx name))]
    [(ast.AstType.VarArgs name lifetimes)
      (ast.ast-ty-var-args
        (macro-type-arg-module-qualify-id ctx name)
        (__tl-box-place lifetimes))]
    [_ ty]))

(define (macro-type-arg-reflections-from-decls [decls : ast.AstDeclList]) : ctfe_support.CtfeReflectInfoList
  (begin
    (ctfe_support.ctfe-build-seen-reset!)
    (ctfe_support.ctfe-reflections-from-decls
      decls
      ""
      cbi.compiler-builtin-id-fix-empty
      (ctfe_support.ctfe-reflect-info-list-with-capacity
        (ctfe_support.ctfe-metadata-decl-capacity decls)))))

(define (macro-type-arg-reflect-resolve
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [ty : ast.AstType]) : ast.AstType
  (let
    [infos : ctfe_support.CtfeReflectInfoList
      (macro-type-arg-reflections-from-decls decls)]
    [reflected : ast.AstType
      (ctfe_support.ctfe-reflect-resolve-type-with-pools
        (tc-context-pools ctx)
        infos
        ty)]
    (if (tc-type-needs-resolution? reflected)
      (let
        [qualified-reflected : ast.AstType
          (ctfe_support.ctfe-reflect-resolve-type-with-pools
            (tc-context-pools ctx)
            infos
            (macro-type-arg-module-qualify ctx reflected))]
        (if (tc-type-needs-resolution? qualified-reflected)
          reflected
          qualified-reflected))
      reflected)))

(define (macro-type-arg-resolve
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (if (tc-type-needs-resolution? resolved)
      (let
        [reflected : ast.AstType
          (macro-type-arg-reflect-resolve ctx decls resolved)]
        (if (tc-type-needs-resolution? reflected)
          (macro-type-arg-module-qualify ctx reflected)
          reflected))
      resolved)))

(define (macro-type-arg-source-policy-ok [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (match (tc-resolve-type ctx ty)
    [(ast.AstType.Slice elem)
      ;; A top-level Slice is a compile-time type operand, not a runtime
      ;; storage declaration.  Keep the runtime policy for every nested shape
      ;; while validating the element recursively.
      (tc-source-type-policy-ok ctx (ast.ty-node-get elem))]
    [_ (tc-source-type-policy-ok ctx ty)]))

(define (macro-type-arg
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [arg : ast.AstExpr]) : ResultMacroTypeArg
  (begin
    (tc-context-capture-active-pools! ctx)
    (match (ctfe_support.ctfe-expr-to-type
      arg
      arg
      (ctfe_support.ctfe-env-empty-with-pools (tc-context-pools ctx))
      (ctfe_support.ctfe-fuel-limit))
      [(ctfe_support.ResultCtfeQuoteType.Ok ty _)
        (match (macro-type-arg-source-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (ResultMacroTypeArg.Ok (macro-type-arg-resolve ctx decls ty))]
          [(ResultTcUnit.Err message)
            (ResultMacroTypeArg.Err
              (box (ctfe_support.ctfe-diagnostic-at-expr arg message)))])]
      [(ctfe_support.ResultCtfeQuoteType.Err diag)
        (ResultMacroTypeArg.Err diag)])))

(define (macro-type-arg-with-fallback
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : ast.AstExpr]) : ResultMacroTypeArg
  (match (macro-type-arg ctx decls arg)
    [(ResultMacroTypeArg.Ok resolved-ty) (ResultMacroTypeArg.Ok resolved-ty)]
    [(ResultMacroTypeArg.Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (ResultMacroTypeArg.Err primary-diag)
        (match (macro-type-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          decls
          arg)
          [(ResultMacroTypeArg.Ok resolved-ty)
            (ResultMacroTypeArg.Ok resolved-ty)]
          [(ResultMacroTypeArg.Err _) (ResultMacroTypeArg.Err primary-diag)]))]))

(define (macro-type-kind-list-render-from
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [index : i64]) : String
  (if (>= index (ast.ast-macro-type-kind-list-len kinds))
    ""
    (str_cat.str-cat
      (if (= index 0)
        ""
        ", ")
      (ci.intern-str (ast.ast-macro-type-kind-list-get kinds index 0))
      (macro-type-kind-list-render-from kinds (+ index 1)))))

(define (macro-type-kind-list-render
  [kinds : (& kinds ast.AstMacroTypeKindList)]) : String
  (macro-type-kind-list-render-from kinds 0))

(define (macro-type-kind-list-contains-text-from?
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [index : i64]
  [kind : String]) : bool
  (if (>= index (ast.ast-macro-type-kind-list-len kinds))
    false
    (if (string.eq
      (ci.intern-str (ast.ast-macro-type-kind-list-get kinds index 0))
      kind)
      true
      (macro-type-kind-list-contains-text-from? kinds (+ index 1) kind))))

(define (macro-type-kind-list-contains-text?
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [kind : String]) : bool
  (macro-type-kind-list-contains-text-from? kinds 0 kind))

(define (macro-type-kind-constraint-message
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : ast.AstType]
  [type-kinds : (& type-kinds ast.AstMacroTypeKindList)]) : String
  (str_cat.str-cat
    "typecheck: macro "
    (tc-name-slashes-to-dots macro-name)
    " type operand "
    (ci.intern-str param-name)
    " rejects "
    (tc-type-render resolved-ty)
    ": expected one of :kind "
    (macro-type-kind-list-render type-kinds)))

(define (macro-validate-type-kind-constraint
  [ctx : TcContext]
  [macro-name : String]
  [param-name : i64]
  [resolved-ty : ast.AstType]
  [type-kinds : (& type-kinds ast.AstMacroTypeKindList)]
  [arg-expr : ast.AstExpr]) : ResultMacroCheck
  (if (ast.ast-macro-type-kind-list-empty? type-kinds)
    ResultMacroCheck.Ok
    (let
      [actual-kind : String
        (ctfe_support.ctfe-type-kind-with-reflections-and-pools
          (tc-context-pools ctx)
          (ctfe_support.ctfe-reflect-info-list-empty)
          resolved-ty)]
      (if (macro-type-kind-list-contains-text? type-kinds actual-kind)
        ResultMacroCheck.Ok
        (ResultMacroCheck.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              arg-expr
              (macro-type-kind-constraint-message
                macro-name
                param-name
                resolved-ty
                type-kinds))))))))

(define (macro-module-strategy-unknown-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown module strategy "
    name
    "; import the module or use a visible dotted module alias"))

(define (macro-module-strategy-arg [ctx : TcContext] [arg : ast.AstExpr]) : ResultMacroModuleArg
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Var name-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or name-id name-id)]
        [name : String (ci.intern-str source-id)]
        (if (tc-source-slash-qualified-id? name source-id)
          (ResultMacroModuleArg.Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                arg
                (tc-source-slash-qualified-message name))))
          (match ctx
            [(TcContext program _ _ current-module current-module-id _ _ _ _)
              (match program
                [(ast.AstProgram.Program decls-box)
                  (match (macro-import-alias-target-cached-id-in-context
                    ctx
                    (__tl-box-place decls-box)
                    current-module-id
                    name-id)
                    [(TcMaybeNameId.Some target-id)
                      (ResultMacroModuleArg.Ok
                        (tc-env-key-name-text target-id)
                        target-id)]
                    [(TcMaybeNameId.No)
                      (if (or
                        (string.eq name current-module)
                        (tc-imported-module-identity-id? ctx name-id))
                        (ResultMacroModuleArg.Ok name source-id)
                        (ResultMacroModuleArg.Err
                          (box
                            (ctfe_support.ctfe-diagnostic-at-expr
                              arg
                              (macro-module-strategy-unknown-message name)))))])])])))]
    [_
      (ResultMacroModuleArg.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: Module macro operand expects a module name")))]))

(define (macro-module-strategy-arg-with-fallback
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [arg : ast.AstExpr]) : ResultMacroModuleArg
  (match (macro-module-strategy-arg ctx arg)
    [(ResultMacroModuleArg.Ok module module-id)
      (ResultMacroModuleArg.Ok module module-id)]
    [(ResultMacroModuleArg.Err primary-diag)
      (if (= fallback-module-id (tc-context-module-id ctx))
        (ResultMacroModuleArg.Err primary-diag)
        (match (macro-module-strategy-arg
          (tc-context-with-module-id ctx fallback-module fallback-module-id)
          arg)
          [(ResultMacroModuleArg.Ok module module-id)
            (ResultMacroModuleArg.Ok module module-id)]
          [(ResultMacroModuleArg.Err _) (ResultMacroModuleArg.Err primary-diag)]))]))

(define (macro-expr-clause-from-items
  [arg : ast.AstExpr]
  [items : ast.AstExprList]) : ResultMacroClause
  (if (= items.len 2)
    (ResultMacroClause.Ok
      (ast.ast-expr-clause
        (ast.ast-expr-list-get (& items) 0 0)
        (ast.ast-expr-list-get (& items) 1 0)))
    (ResultMacroClause.Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))))

(define (macro-expr-clause-from-arg [arg : ast.AstExpr]) : ResultMacroClause
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.BracketClause items) (macro-expr-clause-from-items arg items)]
    [_
      (ResultMacroClause.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprClause macro operand expects bracket syntax")))]))

(define (macro-expr-clause-list-from-args [args : ast.AstExprList]) : ResultMacroClauseList
  (let
    [out : ast.AstExprClauseList
      (ast.ast-expr-clause-list-with-capacity args.len)]
    (match (macro-expr-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroClauseList.Err diag)])))

(define (macro-expr-clause-list-from-args-into
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-node-get (ast.ast-expr-list-get args index 0))]
      (match (macro-expr-clause-from-arg head-expr)
        [(ResultMacroClause.Ok clause)
          (begin
            (ast.ast-expr-clause-list-push out clause)
            (macro-expr-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expr-span-or-zero [arg : ast.AstExpr]) : ast.AstSourceSpan
  (match arg
    [(ast.AstExpr.Spanned _ span) span]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (macro-expr-span-or-zero (ast.ast-node-get inner-box))]
    [_ (ast.ast-source-span 0 0 0 0)]))

(define (macro-expr-colon? [expr-id : i64]) : bool
  (match (ast.ast-expr-unspan (ast.ast-node-get expr-id))
    [(ast.AstExpr.Var name) (= name cbi.compiler-builtin-id-fix-colon)]
    [_ false]))

(define (macro-expr-binding-clause-shape-error [arg : ast.AstExpr]) : ResultMacroBindingClause
  (ResultMacroBindingClause.Err
    (box
      (ctfe_support.ctfe-diagnostic-at-expr
        arg
        (macro-binding-clause-shape-message)))))

(define (macro-expr-binding-clause-from-name
  [arg : ast.AstExpr]
  [name : i64]
  [rest : ast.AstExprList]) : ResultMacroBindingClause
  (let
    [len : i64 rest.len]
    (if (<= len 0)
      (macro-expr-binding-clause-shape-error arg)
      (let
        [first : i64 (ast.ast-expr-list-get (& rest) 0 0)]
        (if (macro-expr-colon? first)
          (if (= len 3)
            (ResultMacroBindingClause.Ok
              (ast.ast-expr-binding-clause-id
                name
                true
                (ast.ast-expr-list-get (& rest) 1 0)
                (ast.ast-expr-list-get (& rest) 2 0)
                (ctfe_support.ctfe-untyped-expr-type)
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg))
          (if (= len 1)
            (ResultMacroBindingClause.Ok
              (ast.ast-expr-binding-clause-id
                name
                false
                (ast.ast-node-push (ast.AstExpr.Literal (ast.AstLiteral.Unit)))
                first
                (ctfe_support.ctfe-untyped-expr-type)
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg)))))))

(define (macro-expr-binding-clause-from-items
  [arg : ast.AstExpr]
  [items : ast.AstExprList]) : ResultMacroBindingClause
  (if (ast.ast-expr-list-empty? (& items))
    (macro-expr-binding-clause-shape-error arg)
    (let
      [name-expr : i64 (ast.ast-expr-list-get (& items) 0 0)]
      (match (ast.ast-expr-unspan (ast.ast-node-get name-expr))
        [(ast.AstExpr.Var name)
          (macro-expr-binding-clause-from-name
            arg
            name
            (ast.ast-expr-list-tail-from-ref (& items) 1))]
        [_ (macro-expr-binding-clause-shape-error arg)]))))

(define (macro-expr-binding-clause-from-arg [arg : ast.AstExpr]) : ResultMacroBindingClause
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.BracketClause items)
      (macro-expr-binding-clause-from-items arg items)]
    [_
      (ResultMacroBindingClause.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprBindingClause macro operand expects bracket syntax")))]))

(define (macro-expr-binding-clause-list-from-args [args : ast.AstExprList]) : ResultMacroBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity args.len)]
    (match (macro-expr-binding-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroBindingClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroBindingClauseList.Err diag)])))

(define (macro-expr-binding-clause-list-from-args-into
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-node-get (ast.ast-expr-list-get args index 0))]
      (match (macro-expr-binding-clause-from-arg head-expr)
        [(ResultMacroBindingClause.Ok clause)
          (begin
            (ast.ast-expr-binding-clause-list-push out clause)
            (macro-expr-binding-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expr-binding-clause-prefix-from-args
  [args : (& args ast.AstExprList)]
  [start : i64]) : ResultMacroBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity (- args.len start))]
    (match (macro-expr-binding-clause-prefix-from-args-into
      args
      start
      (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroBindingClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroBindingClauseList.Err diag)])))

(define (macro-expr-binding-clause-prefix-from-args-into
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head-expr : ast.AstExpr
        (ast.ast-node-get (ast.ast-expr-list-get args index 0))]
      (match (ast.ast-expr-unspan head-expr)
        [(ast.AstExpr.BracketClause _)
          (match (macro-expr-binding-clause-from-arg head-expr)
            [(ResultMacroBindingClause.Ok clause)
              (begin
                (ast.ast-expr-binding-clause-list-push out clause)
                (macro-expr-binding-clause-prefix-from-args-into
                  args
                  (+ index 1)
                  out))]
            [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)])]
        [_ ResultMacroCheck.Ok]))))

(define (macro-signature-resolution-context-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]) : TcContext
  (if (> (string.string-length fallback-module) 0)
    (tc-context-with-module-id ctx fallback-module fallback-module-id)
    ctx))

(define (macro-normalize-signature-syntax-type [ty : ast.AstType]) : ast.AstType
  (match ty
    [(ast.AstType.Var name)
      (match (tc-stdlib-comptime-syntax-type-id name)
        [(ast.AstMaybeType.Some syntax-ty) syntax-ty]
        [(ast.AstMaybeType.No) ty])]
    [_ ty]))

(define (macro-diagnostic-with-active-path
  [ctx : TcContext]
  [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (cdiag.compiler-diagnostic-with-fallback-path
    diag
    (macro-active-decl-path ctx)))

(define (macro-resolve-signature-type-id
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : ast.AstType
  (macro-normalize-signature-syntax-type
    (tc-resolve-type
      (macro-signature-resolution-context-id
        ctx
        fallback-module
        fallback-module-id)
      (tc-macro-signature-type ty))))

(define (macro-check-ordinary-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (if (tc-type-eq resolved-expected (ast.AstType.Expr))
    ResultMacroCheck.Ok
    (let
      [macro-state : TcMacroState (tc-context-macro-state ctx)]
      [journal-mark : i64 (tc-dotted-macro-journal-start! macro-state)]
      [result : ResultMacroCheck
        (match (tc-expr-with-expected-or-actual ctx env arg resolved-expected)
          [(ResultTcType.Ok actual)
            (if (tc-type-compatible? resolved-expected actual)
              ResultMacroCheck.Ok
              (ResultMacroCheck.Err
                (box
                  (macro-diagnostic-with-active-path
                    ctx
                    (tc-expr-diag
                      arg
                      (macro-operand-mismatch-message resolved-expected actual))))))]
          [(ResultTcType.Err message)
            (ResultMacroCheck.Err
              (box
                (macro-diagnostic-with-active-path
                  ctx
                  (tc-expr-diag
                    arg
                    (if (tc-encoded-error? message)
                      message
                      (str_cat.str-cat
                        "typecheck: macro operand typecheck failed: "
                        message))))))])]
      (begin
        (tc-dotted-macro-journal-restore-to! macro-state journal-mark)
        result))))

(define (macro-operand-bracket-clause? [arg : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.BracketClause _) true]
    [_ false]))

(define (macro-check-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? expected)
    (match (macro-type-arg
      ctx
      (match (tc-context-program ctx)
        [(ast.AstProgram.Program decls-box) (__tl-box-place decls-box)])
      arg)
      [(ResultMacroTypeArg.Ok _) ResultMacroCheck.Ok]
      [(ResultMacroTypeArg.Err diag) (ResultMacroCheck.Err diag)])
    (macro-check-operand-with-resolved
      ctx
      env
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        expected)
      arg)))

;; Operand check for a param whose signature type is already resolved;
;; callers that resolve once for several checks use this entry directly.
(define (macro-check-operand-with-resolved
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [arg : ast.AstExpr]) : ResultMacroCheck
  (cond
    [(tc-macro-expr-clause-type? resolved-expected)
      (match (macro-expr-clause-from-arg arg)
        [(ResultMacroClause.Ok _) ResultMacroCheck.Ok]
        [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)])]
    [(tc-macro-expr-binding-clause-type? resolved-expected)
      (match (macro-expr-binding-clause-from-arg arg)
        [(ResultMacroBindingClause.Ok _) ResultMacroCheck.Ok]
        [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)])]
    [(macro-operand-bracket-clause? arg)
      (ResultMacroCheck.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            arg
            (macro-clause-operand-mismatch-message resolved-expected))))]
    [else (macro-check-ordinary-operand ctx env resolved-expected arg)]))

(define (macro-check-variadic-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [args : ast.AstExprList]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? expected)
    (macro-check-variadic-operands-at
      ctx
      env
      fallback-module
      fallback-module-id
      expected
      (& args)
      0)
    ;; Resolve the shared signature type once for the whole operand list
    ;; instead of once per operand.
    (macro-check-variadic-operands-resolved-at
      ctx
      env
      (macro-resolve-signature-type-id
        ctx
        fallback-module
        fallback-module-id
        expected)
      (& args)
      0)))

(define (macro-check-variadic-operands-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [expected : ast.AstType]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      (match (macro-check-operand
        ctx
        env
        fallback-module
        fallback-module-id
        expected
        head)
        [(ResultMacroCheck.Ok)
          (macro-check-variadic-operands-at
            ctx
            env
            fallback-module
            fallback-module-id
            expected
            args
            (+ index 1))]
        [(ResultMacroCheck.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-check-variadic-operands-resolved-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      (match (macro-check-operand-with-resolved ctx env resolved-expected head)
        [(ResultMacroCheck.Ok)
          (macro-check-variadic-operands-resolved-at
            ctx
            env
            resolved-expected
            args
            (+ index 1))]
        [(ResultMacroCheck.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-param-expr-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : bool
  (tc-macro-expr-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-param-expr-binding-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [ty : ast.AstType]) : bool
  (tc-macro-expr-binding-clause-type?
    (macro-resolve-signature-type-id ctx fallback-module fallback-module-id ty)))

(define (macro-captured-expr-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : ast.AstType]
  [capture-expr-types : bool]
  [arg : ast.AstExpr]) : ast.AstType
  (if (tc-type-eq resolved-expected (ast.AstType.Expr))
    (if capture-expr-types
      (begin
        ;; Capturing the operand can append caller-origin expression wrappers
        ;; through the owned context before speculative typechecking starts.
        ;; Publish those nodes first, then retain any expression/type children
        ;; appended by `tc-expr` before allocating the captured-type wrapper.
        (tc-context-install-pools! ctx)
        (match (tc-expr ctx env arg)
          [(ResultTcType.Ok actual)
            (begin
              (tc-context-capture-active-pools! ctx)
              (let
                [captured : ast.AstType
                  (ctfe_support.ctfe-captured-expr-type-with-pools
                    (tc-context-pools ctx)
                    (tc-resolve-type ctx actual))]
                (begin
                  (tc-context-install-pools! ctx)
                  captured)))]
          [(ResultTcType.Err _) (ctfe_support.ctfe-untyped-expr-type)]))
      (ctfe_support.ctfe-untyped-expr-type))
    resolved-expected))

(define (macro-captured-binding-init-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ast.AstType
  (match (tc-expr ctx env arg)
    [(ResultTcType.Ok actual)
      (begin
        ;; Binding-clause initializers can append structural referent types
        ;; after the context snapshot used to begin macro expansion. Refresh
        ;; before pushing the wrapper so those type IDs cannot alias.
        (tc-context-capture-active-pools! ctx)
        (let
          [captured : ast.AstType
            (ctfe_support.ctfe-captured-expr-type-with-pools
              (tc-context-pools ctx)
              (tc-resolve-type ctx actual))]
          (begin
            (tc-context-install-pools! ctx)
            captured)))]
    [(ResultTcType.Err _) (ctfe_support.ctfe-untyped-expr-type)]))

(define (macro-captured-binding-clause
  [ctx : TcContext]
  [env : TcTypeEnv]
  [capture-expr-types : bool]
  [clause : ast.AstExprBindingClause]) : ast.AstExprBindingClause
  (let
    [init-id : i64 clause.init]
    [init : ast.AstExpr (tc-context-expr-get ctx init-id)]
    [raw-init-produced : ast.AstType
      (if capture-expr-types
        (macro-captured-binding-init-produced-type ctx env init)
        clause.init-produced)]
    [init-produced : ast.AstType
      (ctfe_support.ctfe-caller-origin-expr-type-with-pools
        (tc-context-pools ctx)
        raw-init-produced
        (macro-active-decl-path-id ctx))]
    ;; The origin/type payload is appended through the explicit context while
    ;; the variadic environment still observes the previously installed pool.
    ;; Publish it before another clause is checked or the transformer projects
    ;; this initializer and materializes its caller-origin expression marker.
    [_publish-captured : unit (tc-context-install-pools! ctx)]
    (ast.AstExprBindingClause
      clause.name
      clause.has-type
      clause.ty
      init-id
      init-produced
      clause.span)))

(define (macro-captured-binding-clause-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [capture-expr-types : bool]
  [clauses : ast.AstExprBindingClauseList]) : ast.AstExprBindingClauseList
  (let
    [out : ast.AstExprBindingClauseList
      (ast.ast-expr-binding-clause-list-with-capacity clauses.len)]
    [index : i64 0]
    (begin
      (while (< index clauses.len)
        (begin
          (ast.ast-expr-binding-clause-list-push
            (&mut out)
            (macro-captured-binding-clause
              ctx
              env
              capture-expr-types
              (ast.ast-expr-binding-clause-list-get
                (& clauses)
                index
                (ast.ast-expr-binding-clause-fallback))))
          (set! index (+ index 1))))
      out)))

;; Concrete variadic operands are checked before their transformer runs. That
;; check can advance the active caller pool beyond the definition pool held by
;; the CTFE environment. Preserve the newer pool on the bound syntax list so
;; CTFE constructors do not allocate over the checked operands.
(define (macro-captured-syntax-pools [env : ctfe_support.CtfeEnv]) : ctfe_support.CtfeMaybeSyntaxPools
  (let
    [definition-pools : ast.AstNodePoolContext
      (ctfe_support.ctfe-env-pools env)]
    [caller-pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-capture-active)]
    (if (>
      (ast.ast-node-pool-context-expr-len caller-pools)
      (ast.ast-node-pool-context-expr-len definition-pools))
      (ctfe_support.CtfeMaybeSyntaxPools.Some caller-pools)
      (ctfe_support.CtfeMaybeSyntaxPools.None))))

(define (macro-caller-origin-expr-list
  [ctx : TcContext]
  [pools : ast.AstNodePoolContext]
  [args : ast.AstExprList]) : ast.AstExprList
  (let
    [count : i64 args.len]
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [arg-id : i64 (ast.ast-expr-list-get (& args) index 0)]
          [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
          (begin
            (ast.ast-expr-list-push
              (&mut out)
              (macro-captured-expr-node ctx pools arg-id arg true))
            (set! index (+ index 1)))))
      out)))

(define (macro-captured-expr-list-value
  [ctx : TcContext]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [args : ast.AstExprList]) : ctfe_support.CompilerCtfeValue
  (match syntax-pools
    [(ctfe_support.CtfeMaybeSyntaxPools.Some pools)
      (ctfe_support.CompilerCtfeValue.CapturedExprList
        (macro-caller-origin-expr-list ctx pools args)
        pools)]
    [(ctfe_support.CtfeMaybeSyntaxPools.None)
      (ctfe_support.CompilerCtfeValue.ExprList args)]))

(define (macro-caller-origin-expr-clause
  [ctx : TcContext]
  [pools : ast.AstNodePoolContext]
  [clause : ast.AstExprClause]) : ast.AstExprClause
  (let
    [first-id : i64 clause.first]
    [second-id : i64 clause.second]
    (ast.AstExprClause
      (macro-captured-expr-node
        ctx
        pools
        first-id
        (tc-context-expr-get ctx first-id)
        true)
      (macro-captured-expr-node
        ctx
        pools
        second-id
        (tc-context-expr-get ctx second-id)
        true))))

(define (macro-caller-origin-expr-clause-list
  [ctx : TcContext]
  [pools : ast.AstNodePoolContext]
  [clauses : ast.AstExprClauseList]) : ast.AstExprClauseList
  (let
    [count : i64 clauses.len]
    [out : ast.AstExprClauseList (ast.ast-expr-clause-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (ast.ast-expr-clause-list-push
            (&mut out)
            (macro-caller-origin-expr-clause
              ctx
              pools
              (ast.ast-expr-clause-list-get
                (& clauses)
                index
                (ast.ast-expr-clause-fallback))))
          (set! index (+ index 1))))
      out)))

(define (macro-captured-expr-clause-list-value
  [ctx : TcContext]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [clauses : ast.AstExprClauseList]) : ctfe_support.CompilerCtfeValue
  (match syntax-pools
    [(ctfe_support.CtfeMaybeSyntaxPools.Some pools)
      (ctfe_support.CompilerCtfeValue.CapturedExprClauseList
        (macro-caller-origin-expr-clause-list ctx pools clauses)
        pools)]
    [(ctfe_support.CtfeMaybeSyntaxPools.None)
      (ctfe_support.CompilerCtfeValue.ExprClauseList clauses)]))

(define (macro-captured-binding-clause-list-value
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [capture-expr-types : bool]
  [clauses : ast.AstExprBindingClauseList]) : ctfe_support.CompilerCtfeValue
  (ctfe_support.CompilerCtfeValue.ExprBindingClauseList
    (macro-captured-binding-clause-list ctx type-env capture-expr-types clauses)))

;; Operand checking can append typed proxy nodes to the active caller pool.
;; Select the capture pool only after that check, retaining an already selected
;; pool when it is newer still.
(define (macro-variadic-syntax-pools-after-check
  [env : ctfe_support.CtfeEnv]
  [current : ctfe_support.CtfeMaybeSyntaxPools]) : ctfe_support.CtfeMaybeSyntaxPools
  (match (macro-captured-syntax-pools env)
    [(ctfe_support.CtfeMaybeSyntaxPools.Some active-pools)
      (match current
        [(ctfe_support.CtfeMaybeSyntaxPools.Some current-pools)
          (if (>
            (ast.ast-node-pool-context-expr-len current-pools)
            (ast.ast-node-pool-context-expr-len active-pools))
            current
            (ctfe_support.CtfeMaybeSyntaxPools.Some active-pools))]
        [(ctfe_support.CtfeMaybeSyntaxPools.None)
          (ctfe_support.CtfeMaybeSyntaxPools.Some active-pools)])]
    [(ctfe_support.CtfeMaybeSyntaxPools.None) current]))

;; Binding-clause-list values carry child expression IDs but no pool-bearing
;; value variant. The scalar `for` shape needs the caller pool after checking
;; its prefix, while unrelated definition-owned suffixes must retain the
;; definition pool. Other captured values select their owner normally.
(define (macro-captured-param-syntax-pools-after-check
  [current : ctfe_support.CtfeMaybeSyntaxPools]
  [value : ctfe_support.CompilerCtfeValue]
  [rebase-binding-clauses? : bool]) : ctfe_support.CtfeMaybeSyntaxPools
  (match value
    [(ctfe_support.CompilerCtfeValue.ExprBindingClauseList _)
      (if rebase-binding-clauses?
        (ctfe_support.CtfeMaybeSyntaxPools.Some
          (ast.ast-node-pool-context-capture-active))
        current)]
    [_ (ctfe_support.ctfe-syntax-pools-for-value current value)]))

(define (macro-capture-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [name : i64]
  [ty : ast.AstType]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [capture-expr-types : bool]) : ResultMacroCapturedValue
  (cond
    [(tc-macro-type-param-kind? ty)
      (ResultMacroCapturedValue.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            (ast.AstExpr.Var name)
            "typecheck: type macro operand cannot be variadic")))]
    [(tc-macro-module-param-kind? ty)
      (ResultMacroCapturedValue.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            (ast.AstExpr.Var name)
            "typecheck: Module macro operand cannot be variadic")))]
    [(macro-param-expr-clause? ctx fallback-module fallback-module-id ty)
      (match (macro-expr-clause-list-from-args args)
        [(ResultMacroClauseList.Ok clauses)
          (ResultMacroCapturedValue.Ok
            (macro-captured-expr-clause-list-value
              ctx
              (macro-variadic-syntax-pools-after-check env syntax-pools)
              clauses))]
        [(ResultMacroClauseList.Err diag) (ResultMacroCapturedValue.Err diag)])]
    [(macro-param-expr-binding-clause?
        ctx
        fallback-module
        fallback-module-id
        ty)
      (match (macro-expr-binding-clause-list-from-args args)
        [(ResultMacroBindingClauseList.Ok clauses)
          (ResultMacroCapturedValue.Ok
            (macro-captured-binding-clause-list-value
              ctx
              type-env
              capture-expr-types
              clauses))]
        [(ResultMacroBindingClauseList.Err diag)
          (ResultMacroCapturedValue.Err diag)])]
    [else
      (match (macro-check-variadic-operands
        ctx
        type-env
        fallback-module
        fallback-module-id
        ty
        args)
        [(ResultMacroCheck.Ok)
          (ResultMacroCapturedValue.Ok
            (macro-captured-expr-list-value
              ctx
              (macro-variadic-syntax-pools-after-check env syntax-pools)
              args))]
        [(ResultMacroCheck.Err diag) (ResultMacroCapturedValue.Err diag)])]))

(define (macro-bind-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [fallback-module-id : i64]
  [name : i64]
  [ty : ast.AstType]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]) : ResultMacroEnv
  (match (macro-capture-variadic-param
    ctx
    type-env
    fallback-module
    fallback-module-id
    name
    ty
    args
    env
    (ctfe_support.ctfe-env-syntax-pools env)
    capture-expr-types)
    [(ResultMacroCapturedValue.Ok value)
      (let
        ;; Binding-clause values carry child expression IDs but no pool-bearing
        ;; value variant. Rebase after operand typing so CTFE builders cannot
        ;; allocate over a newly appended borrow/place child and form a cycle.
        [captured-env : ctfe_support.CtfeEnv
          (match value
            [(ctfe_support.CompilerCtfeValue.ExprBindingClauseList _)
              (ctfe_support.ctfe-env-rebase-syntax-pools
                env
                (ast.ast-node-pool-context-capture-active))]
            [_ env])]
        (ResultMacroEnv.Ok
          (ctfe_support.ctfe-env-extend-id captured-env name value)))]
    [(ResultMacroCapturedValue.Err diag) (ResultMacroEnv.Err diag)]))

;; A direct caller string literal is the one `Expr` shape that public macro
;; code can inspect without evaluating. Keep its literal node in the active
;; CTFE pool instead of passing a transient macro-expansion proxy variable.
;; Other expressions retain their original node and hygiene unchanged.
(define (macro-private-place-bridge-name? [macro-name : String]) : bool
  (or
    (string.eq macro-name "stdlib.core_macros/__tl-project-field")
    (string.eq macro-name "stdlib.core_macros/__tl-project-set-field")
    (string.eq macro-name "stdlib.core_macros/__tl-project-field-name")
    (string.eq macro-name "stdlib.core_macros/__tl-project-set-field-name")
    (string.eq macro-name "stdlib.core_macros/__tl-box-place")))

(define (macro-captured-expr-node
  [ctx : TcContext]
  [pools : ast.AstNodePoolContext]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [record-caller-origin : bool]) : i64
  (let
    [captured : i64
      (match arg-expr
        [(ast.AstExpr.Spanned inner span)
          (match (tc-context-expr-get ctx inner)
            [(ast.AstExpr.Literal (ast.AstLiteral.String string-id))
              (ast.ast-expr-spanned-with-pools
                pools
                (ast.ast-node-pool-context-expr-push
                  pools
                  (ast.AstExpr.Literal (ast.AstLiteral.String string-id)))
                span)]
            [_ arg-id])]
        [(ast.AstExpr.Literal (ast.AstLiteral.String string-id))
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Literal (ast.AstLiteral.String string-id)))]
        [_ arg-id])]
    [path-id : i64 (macro-active-decl-path-id ctx)]
    (if record-caller-origin
      (match (tc-expr-maybe-span arg-expr)
        [(TcMaybeAstSourceSpan.Some span)
          (ast.ast-expr-spanned-with-pools
            pools
            (ast.ast-node-pool-context-expr-push
              pools
              (ast.AstExpr.MacroExpansion
                captured
                (macro-expansion-provenance-id -1 path-id)
                -1))
            span)]
        [(TcMaybeAstSourceSpan.No) captured])
      captured)))

(define (macro-env-extend-captured-param
  [env : ctfe_support.CtfeEnv]
  [name : i64]
  [ty : ast.AstType]
  [value : ctfe_support.CompilerCtfeValue]) : ctfe_support.CtfeEnv
  (if (tc-macro-module-param-kind? ty)
    (ctfe_support.ctfe-env-extend-typed-id env name value (ast.AstType.String))
    (ctfe_support.ctfe-env-extend-id env name value)))

(define (macro-capture-fixed-param
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [name : i64]
  [ty : ast.AstType]
  [type-kinds : ast.AstMacroTypeKindList]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [capture-expr-types : bool]) : ResultMacroCapturedValue
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback
        ctx
        decls
        fallback-module
        fallback-module-id
        arg-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (match (macro-validate-type-kind-constraint
            ctx
            macro-name
            name
            resolved-ty
            (& type-kinds)
            arg-expr)
            [(ResultMacroCheck.Ok)
              (ResultMacroCapturedValue.Ok
                (ctfe_support.CompilerCtfeValue.Type resolved-ty))]
            [(ResultMacroCheck.Err diag) (ResultMacroCapturedValue.Err diag)])]
        [(ResultMacroTypeArg.Err diag) (ResultMacroCapturedValue.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        fallback-module-id
        arg-expr)
        [(ResultMacroModuleArg.Ok module module-id)
          (ResultMacroCapturedValue.Ok
            (ctfe_support.CompilerCtfeValue.String module module-id))]
        [(ResultMacroModuleArg.Err diag) (ResultMacroCapturedValue.Err diag)])]
    [else
      ;; Every remaining param kind needs the resolved signature type;
      ;; resolve it once instead of once per kind predicate plus once per
      ;; operand check.
      (let
        [resolved-expected : ast.AstType
          (macro-resolve-signature-type-id
            ctx
            fallback-module
            fallback-module-id
            ty)]
        (cond
          [(tc-macro-expr-clause-type? resolved-expected)
            (match (macro-expr-clause-from-arg arg-expr)
              [(ResultMacroClause.Ok clause)
                (ResultMacroCapturedValue.Ok
                  (ctfe_support.CompilerCtfeValue.ExprClause
                    (macro-caller-origin-expr-clause
                      ctx
                      (tc-context-pools ctx)
                      clause)))]
              [(ResultMacroClause.Err diag) (ResultMacroCapturedValue.Err diag)])]
          [(tc-macro-expr-binding-clause-type? resolved-expected)
            (match (macro-expr-binding-clause-from-arg arg-expr)
              [(ResultMacroBindingClause.Ok clause)
                (ResultMacroCapturedValue.Ok
                  (ctfe_support.CompilerCtfeValue.ExprBindingClause
                    (macro-captured-binding-clause
                      ctx
                      type-env
                      capture-expr-types
                      clause)))]
              [(ResultMacroBindingClause.Err diag)
                (ResultMacroCapturedValue.Err diag)])]
          [else
            (match (macro-check-operand-with-resolved
              ctx
              type-env
              resolved-expected
              arg-expr)
              [(ResultMacroCheck.Ok)
                (ResultMacroCapturedValue.Ok
                  (ctfe_support.CompilerCtfeValue.Expr
                    (macro-captured-expr-node
                      ctx
                      (tc-context-pools ctx)
                      arg-id
                      arg-expr
                      (not (macro-private-place-bridge-name? macro-name)))
                    (macro-captured-expr-produced-type
                      ctx
                      type-env
                      resolved-expected
                      capture-expr-types
                      arg-expr)))]
              [(ResultMacroCheck.Err diag) (ResultMacroCapturedValue.Err diag)])]))]))

(define (macro-bind-fixed-param
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [name : i64]
  [ty : ast.AstType]
  [type-kinds : ast.AstMacroTypeKindList]
  [arg-id : i64]
  [arg-expr : ast.AstExpr]
  [capture-expr-types : bool]
  [env : ctfe_support.CtfeEnv]) : ResultMacroEnv
  (match (macro-capture-fixed-param
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name
    name
    ty
    type-kinds
    arg-id
    arg-expr
    capture-expr-types)
    [(ResultMacroCapturedValue.Ok value)
      (let
        ;; Caller-origin wrappers are appended after the transformer environment
        ;; snapshot was captured. Fixed syntax values do not carry their own
        ;; pool context, so advance the evaluator's read/write view before CTFE
        ;; can allocate a quoted parent over one of those newly appended nodes.
        ;; Otherwise a dotted-field template over `state` can reuse the
        ;; wrapper slot and create a Spanned <-> StructGet cycle.
        [captured-env : ctfe_support.CtfeEnv
          (begin
            ;; Explicit context pushes advance `ctx` but not the compatibility
            ;; allocator used by a few legacy CTFE constructors. Publish the
            ;; same advanced snapshot before binding the next operand.
            (tc-context-install-pools! ctx)
            (ctfe_support.ctfe-env-rebase-pools env (tc-context-pools ctx)))]
        (ResultMacroEnv.Ok
          (macro-env-extend-captured-param captured-env name ty value)))]
    [(ResultMacroCapturedValue.Err diag) (ResultMacroEnv.Err diag)]))

;; Bind the unevaluated operand forms to the macro parameters as `Expr` values.
;; A trailing variadic parameter collects the remaining operands. A non-final
;; ExprBindingClause variadic instead collects the maximal bracket-clause
;; prefix, then binding continues with the first ordinary operand.
(define (macro-bind-params
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (macro-bind-params-at
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name
    (& params)
    (& args)
    0
    0
    env
    capture-expr-types
    call-expr))

(define (macro-bind-params-at
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (cond
    [(>= param-index (ast.ast-macro-param-list-len params))
      (if (>= arg-index args.len)
        (ResultMacroEnv.Ok env)
        (ResultMacroEnv.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast.ast-macro-param-list-get
        params
        param-index
        (ast.ast-macro-param-fallback))
        [(ast.AstMacroParam.Param pname pty variadic type-kinds)
          (if variadic
            (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
              (macro-bind-variadic-param
                ctx
                type-env
                fallback-module
                fallback-module-id
                pname
                pty
                (ast.ast-expr-list-tail-from-ref args arg-index)
                env
                capture-expr-types)
              (if (macro-param-expr-binding-clause?
                ctx
                fallback-module
                fallback-module-id
                pty)
                (match (macro-expr-binding-clause-prefix-from-args
                  args
                  arg-index)
                  [(ResultMacroBindingClauseList.Ok clauses)
                    (let
                      ;; Capture this definition-owned flag before typing a
                      ;; caller clause can install a newer active syntax pool.
                      [rebase-captured-env? : bool
                        (match (ast.ast-macro-param-list-get
                          params
                          (+ param-index 1)
                          (ast.ast-macro-param-fallback))
                          [(ast.AstMacroParam.Param _ _ next-variadic _)
                            next-variadic])]
                      [value : ctfe_support.CompilerCtfeValue
                        (macro-captured-binding-clause-list-value
                          ctx
                          type-env
                          capture-expr-types
                          clauses)]
                      [captured-env : ctfe_support.CtfeEnv
                        (if rebase-captured-env?
                          (ctfe_support.ctfe-env-rebase-syntax-pools
                            env
                            (ast.ast-node-pool-context-capture-active))
                          env)]
                      (macro-bind-params-at
                        ctx
                        decls
                        fallback-module
                        fallback-module-id
                        type-env
                        macro-name
                        params
                        args
                        (+ param-index 1)
                        (+ arg-index clauses.len)
                        (ctfe_support.ctfe-env-extend-id
                          captured-env
                          pname
                          value)
                        capture-expr-types
                        call-expr))]
                  [(ResultMacroBindingClauseList.Err diag)
                    (ResultMacroEnv.Err diag)])
                (ResultMacroEnv.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")))))
            (if (>= arg-index args.len)
              (ResultMacroEnv.Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast.ast-expr-list-get args arg-index 0)]
                [arg-expr : ast.AstExpr (tc-context-expr-get ctx arg)]
                (match (macro-bind-fixed-param
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  pname
                  pty
                  type-kinds
                  arg
                  arg-expr
                  capture-expr-types
                  env)
                  [(ResultMacroEnv.Ok next-env)
                    (macro-bind-params-at
                      ctx
                      decls
                      fallback-module
                      fallback-module-id
                      type-env
                      macro-name
                      params
                      args
                      (+ param-index 1)
                      (+ arg-index 1)
                      next-env
                      capture-expr-types
                      call-expr)]
                  [(ResultMacroEnv.Err diag) (ResultMacroEnv.Err diag)]))))])]))

;; Capture checked operands directly into an exact native ABI array. This
;; walker deliberately mirrors `macro-bind-params-at`; the shared capture
;; helpers above own all validation and value construction, while this layer
;; owns only arity, mixed-prefix traversal, and syntax-pool selection. The
;; caller has already enforced the eight-operand ABI limit, so the declared
;; parameter count is both the required live prefix and the exact capacity.
(define (macro-capture-params-direct
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCapturedOperands
  (let
    [operand-count : i64 params.len]
    (macro-capture-params-direct-at
      ctx
      decls
      fallback-module
      fallback-module-id
      type-env
      macro-name
      (& params)
      (& args)
      0
      0
      env
      (ctfe_support.ctfe-env-syntax-pools env)
      (array.make-array ctfe_support.CompilerCtfeValue operand-count)
      capture-expr-types
      call-expr)))

(define (macro-capture-params-direct-at
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]
  [syntax-pools : ctfe_support.CtfeMaybeSyntaxPools]
  [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
  [capture-expr-types : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCapturedOperands
  (cond
    [(>= param-index (ast.ast-macro-param-list-len params))
      (if (>= arg-index args.len)
        (ResultMacroCapturedOperands.Ok
          operands
          param-index
          env
          (match syntax-pools
            [(ctfe_support.CtfeMaybeSyntaxPools.Some pools) pools]
            [(ctfe_support.CtfeMaybeSyntaxPools.None)
              (ctfe_support.ctfe-env-pools env)]))
        (ResultMacroCapturedOperands.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast.ast-macro-param-list-get
        params
        param-index
        (ast.ast-macro-param-fallback))
        [(ast.AstMacroParam.Param pname pty variadic type-kinds)
          (if variadic
            (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
              (match (macro-capture-variadic-param
                ctx
                type-env
                fallback-module
                fallback-module-id
                pname
                pty
                (ast.ast-expr-list-tail-from-ref args arg-index)
                env
                syntax-pools
                capture-expr-types)
                [(ResultMacroCapturedValue.Ok value)
                  (begin
                    (set! (array-ref operands param-index) value)
                    (macro-capture-params-direct-at
                      ctx
                      decls
                      fallback-module
                      fallback-module-id
                      type-env
                      macro-name
                      params
                      args
                      (+ param-index 1)
                      args.len
                      env
                      (macro-captured-param-syntax-pools-after-check
                        syntax-pools
                        value
                        true)
                      operands
                      capture-expr-types
                      call-expr))]
                [(ResultMacroCapturedValue.Err diag)
                  (ResultMacroCapturedOperands.Err diag)])
              (if (macro-param-expr-binding-clause?
                ctx
                fallback-module
                fallback-module-id
                pty)
                (match (macro-expr-binding-clause-prefix-from-args
                  args
                  arg-index)
                  [(ResultMacroBindingClauseList.Ok clauses)
                    (let
                      ;; Capture this definition-owned flag before typing a
                      ;; caller clause can install a newer active syntax pool.
                      [rebase-captured-pools? : bool
                        (match (ast.ast-macro-param-list-get
                          params
                          (+ param-index 1)
                          (ast.ast-macro-param-fallback))
                          [(ast.AstMacroParam.Param _ _ next-variadic _)
                            next-variadic])]
                      [value : ctfe_support.CompilerCtfeValue
                        (macro-captured-binding-clause-list-value
                          ctx
                          type-env
                          capture-expr-types
                          clauses)]
                      (begin
                        (set! (array-ref operands param-index) value)
                        (macro-capture-params-direct-at
                          ctx
                          decls
                          fallback-module
                          fallback-module-id
                          type-env
                          macro-name
                          params
                          args
                          (+ param-index 1)
                          (+ arg-index clauses.len)
                          env
                          (macro-captured-param-syntax-pools-after-check
                            syntax-pools
                            value
                            rebase-captured-pools?)
                          operands
                          capture-expr-types
                          call-expr)))]
                  [(ResultMacroBindingClauseList.Err diag)
                    (ResultMacroCapturedOperands.Err diag)])
                (ResultMacroCapturedOperands.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")))))
            (if (>= arg-index args.len)
              (ResultMacroCapturedOperands.Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast.ast-expr-list-get args arg-index 0)]
                [arg-expr : ast.AstExpr (tc-context-expr-get ctx arg)]
                (match (macro-capture-fixed-param
                  ctx
                  decls
                  fallback-module
                  fallback-module-id
                  type-env
                  macro-name
                  pname
                  pty
                  type-kinds
                  arg
                  arg-expr
                  capture-expr-types)
                  [(ResultMacroCapturedValue.Ok value)
                    (begin
                      ;; Fixed captures append caller-origin wrappers through
                      ;; `ctx`, just as the interpreted binder does. Publish
                      ;; that advanced pool and hand it to the native host;
                      ;; the definition snapshot can share the old argument
                      ;; ids but cannot address the newly appended wrapper.
                      (tc-context-install-pools! ctx)
                      (set! (array-ref operands param-index) value)
                      (macro-capture-params-direct-at
                        ctx
                        decls
                        fallback-module
                        fallback-module-id
                        type-env
                        macro-name
                        params
                        args
                        (+ param-index 1)
                        (+ arg-index 1)
                        env
                        (ctfe_support.CtfeMaybeSyntaxPools.Some
                          (tc-context-pools ctx))
                        operands
                        capture-expr-types
                        call-expr))]
                  [(ResultMacroCapturedValue.Err diag)
                    (ResultMacroCapturedOperands.Err diag)]))))])]))

(define (macro-fold-captured-operands-env
  [params : ast.AstMacroParamList]
  [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
  [count : i64]
  [base-env : ctfe_support.CtfeEnv]) : ctfe_support.CtfeEnv
  (let
    [env : ctfe_support.CtfeEnv base-env]
    [index : i64 0]
    (begin
      (while (< index count)
        (match (ast.ast-macro-param-list-get
          (& params)
          index
          (ast.ast-macro-param-fallback))
          [(ast.AstMacroParam.Param pname pty _ _)
            (begin
              (set!
                env
                (macro-env-extend-captured-param
                  env
                  pname
                  pty
                  (array-ref operands index)))
              (set! index (+ index 1)))]))
      env)))

;; Route trusted embedded-stdlib macro calls through the TLCI catalog before
;; the semantic CTFE fallback. The mapped catalog owns its package-agnostic
;; index and terminal shell state for the mapping lifetime. Loader provenance
;; is per compilation session: embedded source and byte-identical disk source
;; may enter this branch, while modified or otherwise untrusted roots cannot.
(cfg
  embedded-stdlib-tlci
  (define (macro-expand-stdlib-tlci-catalog-lookup-cached [name : String]) : embedded_tlci.CompilerEmbeddedStdlibTlciLookup
    (begin
      (cfg compile-profile (compiler-tc-stdlib-tlci-entry-resolution-start!))
      (let
        [lookup : embedded_tlci.CompilerEmbeddedStdlibTlciLookup
          (embedded_tlci.compiler-embedded-stdlib-tlci-catalog-lookup name)]
        (begin
          (cfg
            compile-profile
            (compiler-tc-stdlib-tlci-entry-resolution-finish!))
          lookup)))))

(define (macro-dependency-tlci-catalog-lookup
  [ctx : TcContext]
  [slot : i64]
  [identity : String]) : cload.CompilerLoadDependencyCatalogLookup
  (cload.compiler-load-dependency-catalog-handle-lookup-macro
    (tc-macro-walk-field
      (tc-context-macro-state ctx)
      macro-dependency-catalog-handle)
    slot
    identity))

(define (macro-dependency-tlci-catalog-slot-for-declaration
  [ctx : TcContext]
  [declaration-id : i64]) : i64
  (if (< declaration-id 0)
    -1
    (cload.compiler-load-dependency-catalog-handle-slot-for-provenance-id
      (tc-macro-walk-field
        (tc-context-macro-state ctx)
        macro-dependency-catalog-handle)
      (csym.compiler-symbols-provenance-id-at-index-or
        (tc-context-symbols ctx)
        declaration-id
        cbi.compiler-builtin-id-fix-empty))))

;; Both embedded stdlib and dependency catalogs enter through this selection
;; contract after ordinary macro lookup has chosen the defining declaration.
;; The dependency payload is a registry-generation-bound capability, never a
;; free-standing mapped-image index.
(cfg
  embedded-stdlib-tlci
  (defenum MacroTlciResolvedCatalog
    (Dependency cload.CompilerLoadDependencyCatalogCapability)
    (Embedded tlci_loader_support.TlciResolvedMacroEntry)))

(cfg
  embedded-stdlib-tlci
  (defenum MacroTlciCatalogSelection
    (None)
    (Resolved MacroTlciResolvedCatalog)
    (Shell MacroTlciResolvedCatalog)
    (MetadataOnly)
    (Missing)
    (Unavailable)))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-catalog-select
    [ctx : TcContext]
    [definition-module : String]
    [identity : String]
    [declaration-id : i64]) : MacroTlciCatalogSelection
    (match (macro-dependency-tlci-catalog-lookup
      ctx
      (macro-dependency-tlci-catalog-slot-for-declaration ctx declaration-id)
      identity)
      [(cload.CompilerLoadDependencyCatalogLookup.NoCatalog)
        (if (and
          (tc-macro-walk-field
            (tc-context-macro-state ctx)
            macro-expand-stdlib-tlci-route-active)
          (cload.compiler-load-embedded-stdlib-module-id? definition-module))
          (match (macro-expand-stdlib-tlci-catalog-lookup-cached identity)
            [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Resolved resolved)
              (MacroTlciCatalogSelection.Resolved
                (MacroTlciResolvedCatalog.Embedded resolved))]
            [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Shell resolved)
              (MacroTlciCatalogSelection.Shell
                (MacroTlciResolvedCatalog.Embedded resolved))]
            [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Missing)
              MacroTlciCatalogSelection.Missing]
            [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Unavailable _)
              MacroTlciCatalogSelection.Unavailable])
          MacroTlciCatalogSelection.None)]
      [(cload.CompilerLoadDependencyCatalogLookup.Resolved capability)
        (begin
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-catalog-hits
            1)
          (MacroTlciCatalogSelection.Resolved
            (MacroTlciResolvedCatalog.Dependency capability)))]
      [(cload.CompilerLoadDependencyCatalogLookup.Shell capability)
        (begin
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-catalog-hits
            1)
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-shell-cache-hits
            1)
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-interpreted-fallbacks
            1)
          (MacroTlciCatalogSelection.Shell
            (MacroTlciResolvedCatalog.Dependency capability)))]
      [(cload.CompilerLoadDependencyCatalogLookup.MetadataOnly)
        (begin
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-catalog-misses
            1)
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-interpreted-fallbacks
            1)
          MacroTlciCatalogSelection.MetadataOnly)]
      [(cload.CompilerLoadDependencyCatalogLookup.Missing)
        (begin
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-catalog-misses
            1)
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-interpreted-fallbacks
            1)
          MacroTlciCatalogSelection.Missing)]
      [(cload.CompilerLoadDependencyCatalogLookup.Unavailable _)
        (begin
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-load-failures
            1)
          (tc-dependency-tlci-route-counter-add!
            (tc-context-macro-state ctx)
            tc-dependency-tlci-interpreted-fallbacks
            1)
          MacroTlciCatalogSelection.Unavailable)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-open?
    [catalog : MacroTlciResolvedCatalog]) : bool
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency _) true]
      [(MacroTlciResolvedCatalog.Embedded _)
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-open!)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-dependency?
    [catalog : MacroTlciResolvedCatalog]) : bool
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency _) true]
      [(MacroTlciResolvedCatalog.Embedded _) false])))

(cfg
  embedded-stdlib-tlci
  (define (macro-dependency-tlci-note-if!
    [state : TcMacroState]
    [catalog : MacroTlciResolvedCatalog]
    [counter : i64]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      (tc-dependency-tlci-route-counter-add! state counter 1)
      unit)))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-dispatch
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]
    [session-cookie : i64]) : tlci_loader_support.ResultTlciMacroDispatch
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-dispatch
          capability
          identity
          session-cookie)]
      [(MacroTlciResolvedCatalog.Embedded resolved)
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-dispatch
          resolved
          session-cookie)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-mark-shell!
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]) : tlci_loader_support.ResultTlciLoaderUnit
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-mark-shell!
          capability
          identity)]
      [(MacroTlciResolvedCatalog.Embedded resolved)
        (embedded_tlci.compiler-embedded-stdlib-tlci-session-mark-shell!
          resolved)])))

(cfg
  embedded-stdlib-tlci
  (define (macro-tlci-resolved-catalog-status-diagnostic
    [catalog : MacroTlciResolvedCatalog]
    [identity : String]
    [message : String]) : String
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency capability)
        (cload.compiler-load-dependency-catalog-capability-error
          capability
          identity
          message)]
      [(MacroTlciResolvedCatalog.Embedded _) message])))

(cfg
  tlci-bootstrap-mutation-witness
  (define (macro-tlci-bootstrap-mutation-witness-requested?) : bool
    (let
      [name : String "TYPELISP_TLCI_MUTATION_WITNESS"]
      (match (mutation_witness_env.get (& name))
        [(mutation_witness_env.EnvSomeString value) (string.eq value "1")]
        [(mutation_witness_env.EnvNoString) false]))))

(cfg
  tlci-bootstrap-mutation-witness
  (define (macro-tlci-bootstrap-mutation-witness-emit!
    [identity : String]
    [route : String]
    [result : String]) : unit
    (if (and
      (string.eq identity "stdlib.core_macros/when")
      (macro-tlci-bootstrap-mutation-witness-requested?))
      (io.print-error
        (str_cat.str-cat
          "tlci-bootstrap-mutation-route|identity="
          identity
          "|route="
          route
          "|result="
          result
          "\n"))
      unit)))

(define (macro-tlci-catalog-identity
  [definition-module : String]
  [macro-name : String]) : String
  ;; Symbol lookup hands the executor either a local declaration name or its
  ;; already canonical `module/name` display. Package catalogs are produced
  ;; from the latter, so never qualify an identity a second time.
  (if (>= (tc-qualified-name-last-slash macro-name) 0)
    macro-name
    (csym.compiler-symbol-module-key definition-module macro-name)))

(define (macro-note-stdlib-tlci-route
  [state : TcMacroState]
  [definition-module : String]
  ;; lint-allow: unused-variable -- used by embedded-stdlib-tlci builds.
  [macro-name : String]) : unit
  (if (or
    (ctfe_support.ctfe-string-prefix? definition-module "stdlib.")
    (ctfe_support.ctfe-string-prefix? macro-name "stdlib."))
    (begin
      (cfg
        tlci-bootstrap-mutation-witness
        (macro-tlci-bootstrap-mutation-witness-emit!
          (macro-tlci-catalog-identity definition-module macro-name)
          "source"
          "interpreted"))
      (if (and
        (tc-macro-walk-field state macro-expand-stdlib-tlci-route-active)
        (cload.compiler-load-embedded-stdlib-module-id? definition-module))
        (begin
          (cfg
            embedded-stdlib-tlci
            (match (macro-expand-stdlib-tlci-catalog-lookup-cached
              (macro-tlci-catalog-identity definition-module macro-name))
              [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Resolved _)
                (cfg
                  compile-profile
                  (set!
                    compiler-tc-macro-stdlib-tlci-catalog-hits
                    (+ compiler-tc-macro-stdlib-tlci-catalog-hits 1)))]
              [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Shell _)
                (cfg
                  compile-profile
                  (set!
                    compiler-tc-macro-stdlib-tlci-catalog-hits
                    (+ compiler-tc-macro-stdlib-tlci-catalog-hits 1)))]
              [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Missing)
                (cfg
                  compile-profile
                  (set!
                    compiler-tc-macro-stdlib-tlci-catalog-misses
                    (+ compiler-tc-macro-stdlib-tlci-catalog-misses 1)))]
              [(embedded_tlci.CompilerEmbeddedStdlibTlciLookup.Unavailable _)
                (cfg
                  compile-profile
                  (set!
                    compiler-tc-macro-stdlib-tlci-load-failures
                    (+ compiler-tc-macro-stdlib-tlci-load-failures 1)))]))
          (cfg
            (not embedded-stdlib-tlci)
            (cfg
              compile-profile
              (set!
                compiler-tc-macro-stdlib-tlci-load-failures
                (+ compiler-tc-macro-stdlib-tlci-load-failures 1))))
          (cfg
            compile-profile
            (set!
              compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
              (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1))))
        (cfg
          compile-profile
          (set!
            compiler-tc-macro-stdlib-source-interpreted
            (+ compiler-tc-macro-stdlib-source-interpreted 1)))))
    unit))

(defenum MacroNativeStdlibTlciResult
  (No)
  (Shell)
  (Value ctfe_support.CompilerCtfeValue)
  (Err cdiag.CompilerDiagnostic))

;; A cataloged entry is attempted natively; the image is self-describing, so
;; an entry that commits a result was a compiled native body and an entry
;; that commits nothing (a registration shell) falls back to interpretation.
;; No per-identity list is needed. Refs #5212, #5213.
(define (macro-stdlib-tlci-native-cookie) : i64
  0x1cf1)

;; #5926: production-route sustained stress telemetry. The declarations only
;; exist in the focused profile compiler, and a runtime environment key gates
;; record emission without changing the production routing policy. A
;; fixed-width stderr record is emitted at pass boundaries, lifecycle/result
;; transitions, dispatch one, every 256 dispatches, and the historical
;; 13,552-dispatch boundary. The redirected record survives a later allocator
;; or mapping crash and names the last completed production macro dispatch
;; without retaining an unbounded log.
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-active : bool
    false))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-route-status : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-pass : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-pass-dispatch : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-total-dispatch : i64
    0))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-canary-a : i64
    1597463007))
(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define compiler-tc-tlci-native-stress-canary-b : i64
    324508639))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pad [text : String] [width : i64]) : String
    (if (>= (string.string-length text) width)
      text
      (compiler-tc-tlci-native-stress-pad (str_cat.str-cat "0" text) width))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-requested?) : bool
    (let
      [name : String "TYPELISP_TLCI_NATIVE_ROUTE_STRESS"]
      (match (stress_env.get (& name))
        [(stress_env.EnvSomeString value) (string.eq value "1")]
        [(stress_env.EnvNoString) false]))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-canaries-ok?) : bool
    (and
      (= compiler-tc-tlci-native-stress-canary-a 1597463007)
      (= compiler-tc-tlci-native-stress-canary-b 324508639)
      (embedded_tlci.compiler-embedded-stdlib-tlci-stress-canaries-ok?))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-record!
    [pools : ast.AstNodePoolContext]
    [catalog-generation : i64]
    [identity-index : i64]
    [route-status : i64]
    [result-kind : i64]
    [status : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "tlci-native-stress|pass="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-pass)
          6)
        "|dispatch="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-pass-dispatch)
          12)
        "|total="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string compiler-tc-tlci-native-stress-total-dispatch)
          12)
        "|catalog="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string catalog-generation)
          8)
        "|identity="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string identity-index)
          6)
        "|route="
        (compiler-tc-tlci-native-stress-pad (string.int->string route-status) 3)
        "|result="
        (compiler-tc-tlci-native-stress-pad (string.int->string result-kind) 3)
        "|status="
        (compiler-tc-tlci-native-stress-pad (string.int->string status) 3)
        "|expr="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ast-node-pool-context-expr-len pools))
          12)
        "|type="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ast-node-pool-context-type-len pools))
          12)
        "|poolgen="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string (ast.ty-node-pool-generation-value))
          12)
        "|image="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-image-generation))
          8)
        "|release="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-release-generation))
          8)
        "|session="
        (compiler-tc-tlci-native-stress-pad
          (string.int->string
            (embedded_tlci.compiler-embedded-stdlib-tlci-stress-session-generation))
          12)
        "|canary="
        (if (compiler-tc-tlci-native-stress-canaries-ok?)
          "11"
          "00")
        "\n"))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pass-start!
    [pools : ast.AstNodePoolContext]
    [route-active : bool]) : unit
    (begin
      (set!
        compiler-tc-tlci-native-stress-active
        (compiler-tc-tlci-native-stress-requested?))
      (set!
        compiler-tc-tlci-native-stress-route-status
        (if route-active
          1
          0))
      (if compiler-tc-tlci-native-stress-active
        (begin
          (set!
            compiler-tc-tlci-native-stress-pass
            (+ compiler-tc-tlci-native-stress-pass 1))
          (set! compiler-tc-tlci-native-stress-pass-dispatch 0)
          (compiler-tc-tlci-native-stress-record!
            pools
            0
            999999
            compiler-tc-tlci-native-stress-route-status
            0
            0))
        unit))))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-dispatch!
    [pools : ast.AstNodePoolContext]
    [resolved : tlci_loader_support.TlciResolvedMacroEntry]
    [result-kind : i64]
    [status : i64]) : unit
    (if compiler-tc-tlci-native-stress-active
      (begin
        (set!
          compiler-tc-tlci-native-stress-pass-dispatch
          (+ compiler-tc-tlci-native-stress-pass-dispatch 1))
        (set!
          compiler-tc-tlci-native-stress-total-dispatch
          (+ compiler-tc-tlci-native-stress-total-dispatch 1))
        (if (or
          (= compiler-tc-tlci-native-stress-pass-dispatch 1)
          (= (% compiler-tc-tlci-native-stress-pass-dispatch 256) 0)
          (= compiler-tc-tlci-native-stress-pass-dispatch 13552)
          (not (= result-kind 1)))
          (compiler-tc-tlci-native-stress-record!
            pools
            resolved.catalog-generation
            resolved.entry-index
            1
            result-kind
            status)
          unit))
      unit)))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-catalog-dispatch!
    [pools : ast.AstNodePoolContext]
    [catalog : MacroTlciResolvedCatalog]
    [result-kind : i64]
    [status : i64]) : unit
    (match catalog
      [(MacroTlciResolvedCatalog.Dependency _) unit]
      [(MacroTlciResolvedCatalog.Embedded resolved)
        (compiler-tc-tlci-native-stress-dispatch!
          pools
          resolved
          result-kind
          status)])))

(cfg
  (all embedded-stdlib-tlci tlci-native-route-stress)
  (define (compiler-tc-tlci-native-stress-pass-finish!
    [pools : ast.AstNodePoolContext]
    [status : i64]) : unit
    (if compiler-tc-tlci-native-stress-active
      (begin
        (compiler-tc-tlci-native-stress-record!
          pools
          0
          999999
          compiler-tc-tlci-native-stress-route-status
          6
          status)
        (set! compiler-tc-tlci-native-stress-active false))
      unit)))

;; Execute a resolved native entry with either directly prepared operands or
;; the exact values in an interpreted binding. The direct mode starts at
;; `index = count`, so it performs no parameter-name lookup. A successful call
;; that commits no result permanently marks this catalog entry as a shell for
;; the mapping generation. Any nonzero status remains retryable and surfaces
;; as the same diagnostic contract the interpreter uses.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-native-resolved
    [host-pools : ast.AstNodePoolContext]
    [route-state : TcMacroState]
    [identity : String]
    [catalog : MacroTlciResolvedCatalog]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [env : ctfe_support.CtfeEnv]
    [call-expr : ast.AstExpr]
    [prepared-operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)]
    [prepared-count : i64]
    [prepared : bool]) : MacroNativeStdlibTlciResult
    (if (not (macro-tlci-resolved-catalog-open? catalog))
      MacroNativeStdlibTlciResult.No
      (let
        [count : i64
          (if prepared
            prepared-count
            params.len)]
        [operands : (__tl_dyn-array ctfe_support.CompilerCtfeValue)
          prepared-operands]
        [index : i64
          (if prepared
            count
            0)]
        [ok : bool (<= count 8)]
        (begin
          (while (and (not prepared) ok (< index count))
            (match (array-ref params.slots index)
              [(ast.AstMacroParam.Param pname _ _ _)
                (begin
                  (macro-dependency-tlci-note-if!
                    route-state
                    catalog
                    tc-dependency-tlci-parameter-name-lookups)
                  (match (ctfe_support.ctfe-env-lookup-id env pname)
                    [(ctfe_support.CtfeMaybeValue.Some value)
                      (begin
                        (set! (array-ref operands index) value)
                        (set! index (+ index 1)))]
                    [(ctfe_support.CtfeMaybeValue.None) (set! ok false)]))]))
          (if (not ok)
            (begin
              (macro-dependency-tlci-note-if!
                route-state
                catalog
                tc-dependency-tlci-interpreted-fallbacks)
              MacroNativeStdlibTlciResult.No)
            (begin
              (embedded_tlci.compiler-comptime-host-session-open-with-macro-state!
                host-pools
                operands
                count
                (ctfe_support.ctfe-fuel-limit)
                (macro-stdlib-tlci-native-cookie)
                (ctfe_support.ctfe-env-reflections env)
                (ctfe_support.ctfe-env-source-names env)
                (ctfe_support.ctfe-env-macro-state env))
              (cfg
                compile-profile
                (if (macro-tlci-resolved-catalog-dependency? catalog)
                  unit
                  (compiler-tc-stdlib-tlci-entry-invoke-start!)))
              (macro-dependency-tlci-note-if!
                route-state
                catalog
                tc-dependency-tlci-native-dispatches)
              (let
                [dispatch-result : tlci_loader_support.ResultTlciMacroDispatch
                  (macro-tlci-resolved-catalog-dispatch
                    catalog
                    identity
                    (macro-stdlib-tlci-native-cookie))]
                (begin
                  (cfg
                    compile-profile
                    (if (macro-tlci-resolved-catalog-dependency? catalog)
                      unit
                      (compiler-tc-stdlib-tlci-entry-invoke-finish!)))
                  (match dispatch-result
                    [(tlci_loader_support.ResultTlciMacroDispatch.Err message)
                      (begin
                        (cfg
                          (all embedded-stdlib-tlci tlci-native-route-stress)
                          (compiler-tc-tlci-native-stress-catalog-dispatch!
                            host-pools
                            catalog
                            5
                            9))
                        (embedded_tlci.compiler-comptime-host-session-close!)
                        (MacroNativeStdlibTlciResult.Err
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            message)))]
                    [(tlci_loader_support.ResultTlciMacroDispatch.Ok dispatch)
                      (let
                        [status : i64 dispatch.status]
                        (cond
                          [(and
                              (= status 0)
                              (embedded_tlci.compiler-comptime-host-result-ready?))
                            (let
                              [value : ctfe_support.CompilerCtfeValue
                                (embedded_tlci.compiler-comptime-host-result-value)]
                              (begin
                                (cfg
                                  tlci-bootstrap-mutation-witness
                                  (macro-tlci-bootstrap-mutation-witness-emit!
                                    identity
                                    "native"
                                    "value"))
                                (cfg
                                  (all
                                    embedded-stdlib-tlci
                                    tlci-native-route-stress)
                                  (compiler-tc-tlci-native-stress-catalog-dispatch!
                                    host-pools
                                    catalog
                                    (if (tc-macro-result-module? ret)
                                      2
                                      (if (tc-macro-result-decls? ret)
                                        3
                                        1))
                                    0))
                                (embedded_tlci.compiler-comptime-host-session-close!)
                                (cfg
                                  compile-profile
                                  (if (macro-tlci-resolved-catalog-dependency?
                                    catalog)
                                    unit
                                    (begin
                                      (set!
                                        compiler-tc-macro-stdlib-tlci-catalog-hits
                                        (+
                                          compiler-tc-macro-stdlib-tlci-catalog-hits
                                          1))
                                      (set!
                                        compiler-tc-macro-stdlib-tlci-native-dispatches
                                        (+
                                          compiler-tc-macro-stdlib-tlci-native-dispatches
                                          1))
                                      (if (tc-macro-result-module? ret)
                                        (set!
                                          compiler-tc-macro-stdlib-tlci-native-module-results
                                          (+
                                            compiler-tc-macro-stdlib-tlci-native-module-results
                                            1))
                                        (if (tc-macro-result-decls? ret)
                                          (set!
                                            compiler-tc-macro-stdlib-tlci-native-decls-results
                                            (+
                                              compiler-tc-macro-stdlib-tlci-native-decls-results
                                              1))
                                          (set!
                                            compiler-tc-macro-stdlib-tlci-native-expr-results
                                            (+
                                              compiler-tc-macro-stdlib-tlci-native-expr-results
                                              1)))))))
                                (if (tc-macro-result-module? ret)
                                  (macro-dependency-tlci-note-if!
                                    route-state
                                    catalog
                                    tc-dependency-tlci-native-module-results)
                                  (if (tc-macro-result-decls? ret)
                                    (macro-dependency-tlci-note-if!
                                      route-state
                                      catalog
                                      tc-dependency-tlci-native-decls-results)
                                    (begin
                                      (macro-dependency-tlci-note-if!
                                        route-state
                                        catalog
                                        tc-dependency-tlci-native-expr-results)
                                      (if prepared
                                        (macro-dependency-tlci-note-if!
                                          route-state
                                          catalog
                                          tc-dependency-tlci-direct-expr-results)
                                        unit))))
                                (MacroNativeStdlibTlciResult.Value value)))]
                          [(= status 0)
                            (match (macro-tlci-resolved-catalog-mark-shell!
                              catalog
                              identity)
                              [(tlci_loader_support.ResultTlciLoaderUnit.Ok)
                                (begin
                                  (cfg
                                    (all
                                      embedded-stdlib-tlci
                                      tlci-native-route-stress)
                                    (compiler-tc-tlci-native-stress-catalog-dispatch!
                                      host-pools
                                      catalog
                                      4
                                      0))
                                  (embedded_tlci.compiler-comptime-host-session-close!)
                                  (cfg
                                    compile-profile
                                    (if (macro-tlci-resolved-catalog-dependency?
                                      catalog)
                                      unit
                                      (set!
                                        compiler-tc-macro-stdlib-tlci-shell-learns
                                        (+
                                          compiler-tc-macro-stdlib-tlci-shell-learns
                                          1))))
                                  (macro-dependency-tlci-note-if!
                                    route-state
                                    catalog
                                    tc-dependency-tlci-shell-learns)
                                  (macro-dependency-tlci-note-if!
                                    route-state
                                    catalog
                                    tc-dependency-tlci-interpreted-fallbacks)
                                  MacroNativeStdlibTlciResult.Shell)]
                              [(tlci_loader_support.ResultTlciLoaderUnit.Err
                                  message)
                                (begin
                                  (cfg
                                    (all
                                      embedded-stdlib-tlci
                                      tlci-native-route-stress)
                                    (compiler-tc-tlci-native-stress-catalog-dispatch!
                                      host-pools
                                      catalog
                                      5
                                      9))
                                  (embedded_tlci.compiler-comptime-host-session-close!)
                                  (MacroNativeStdlibTlciResult.Err
                                    (ctfe_support.ctfe-diagnostic-at-expr
                                      call-expr
                                      message)))])]
                          ;; A transformer that called `comptime-error` left
                          ;; its own message in the session diagnostic slot;
                          ;; that message is the author's, and reporting the
                          ;; raw status instead would make a macro's own
                          ;; rejection unreadable and route-dependent. The
                          ;; generic status text stays for statuses with no
                          ;; recorded message (bad request, panic). Refs #5701.
                          [else
                            (let
                              [recorded : String
                                (embedded_tlci.compiler-comptime-host-diagnostic-text)]
                              [message : String
                                (macro-tlci-resolved-catalog-status-diagnostic
                                  catalog
                                  identity
                                  (if (and
                                    (=
                                      status
                                      tlci.tlci-host-callback-status-diagnostic)
                                    (> (string.string-length recorded) 0))
                                    recorded
                                    (tlci_loader_support.tlci-loader-macro-status-diagnostic
                                      identity
                                      status)))]
                              (begin
                                (cfg
                                  (all
                                    embedded-stdlib-tlci
                                    tlci-native-route-stress)
                                  (compiler-tc-tlci-native-stress-catalog-dispatch!
                                    host-pools
                                    catalog
                                    5
                                    status))
                                (embedded_tlci.compiler-comptime-host-session-close!)
                                (MacroNativeStdlibTlciResult.Err
                                  (ctfe_support.ctfe-diagnostic-at-expr
                                    call-expr
                                    message))))]))]))))))))))

;; The provenance gate comes before identity construction and catalog access,
;; so source stdlib macros and unrelated packages pay neither cost.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-native
    [ctx : TcContext]
    [definition-module : String]
    [declaration-id : i64]
    [macro-name : String]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [env : ctfe_support.CtfeEnv]
    [call-expr : ast.AstExpr]) : MacroNativeStdlibTlciResult
    (let
      [identity : String
        (macro-tlci-catalog-identity definition-module macro-name)]
      (match (macro-tlci-catalog-select
        ctx
        definition-module
        identity
        declaration-id)
        [(MacroTlciCatalogSelection.None) MacroNativeStdlibTlciResult.No]
        [(MacroTlciCatalogSelection.Resolved catalog)
          (macro-try-stdlib-tlci-native-resolved
            (tc-context-pools ctx)
            (tc-context-macro-state ctx)
            identity
            catalog
            params
            ret
            env
            call-expr
            (array.make-array ctfe_support.CompilerCtfeValue 8)
            params.len
            false)]
        [(MacroTlciCatalogSelection.Shell catalog)
          (begin
            (cfg
              compile-profile
              (if (macro-tlci-resolved-catalog-dependency? catalog)
                unit
                (set!
                  compiler-tc-macro-stdlib-tlci-shell-cache-hits
                  (+ compiler-tc-macro-stdlib-tlci-shell-cache-hits 1))))
            MacroNativeStdlibTlciResult.No)]
        [(MacroTlciCatalogSelection.MetadataOnly)
          MacroNativeStdlibTlciResult.No]
        [(MacroTlciCatalogSelection.Missing) MacroNativeStdlibTlciResult.No]
        [(MacroTlciCatalogSelection.Unavailable) MacroNativeStdlibTlciResult.No]))))

(cfg
  (not embedded-stdlib-tlci)
  (define (macro-try-stdlib-tlci-native
    [_ctx : TcContext]
    [_definition-module : String]
    [_declaration-id : i64]
    [_macro-name : String]
    [_params : ast.AstMacroParamList]
    [_ret : ast.AstType]
    [_env : ctfe_support.CtfeEnv]
    [_call-expr : ast.AstExpr]) : MacroNativeStdlibTlciResult
    MacroNativeStdlibTlciResult.No))

(define (macro-result-provenance-reset-with-captured-body!
  [state : ctfe_support.CompilerCtfeMacroState]
  [captured-body? : bool]) : unit
  (begin
    (ctfe_support.ctfe-result-macro-provenance-reset-for-state! state)
    ;; A transformer can splice a captured operand without reconstructing its
    ;; call nodes. Preserve that input provenance so a nested macro is rewalked
    ;; in the lexical environment introduced by the generated syntax.
    (if captured-body?
      (ctfe_support.ctfe-result-may-contain-macro-note-for-state! state)
      unit)))

(defenum MacroDirectStdlibTlciResult
  (No)
  (BoundFallback)
  (Value ctfe_support.CompilerCtfeValue)
  (PreparedEnv ctfe_support.CtfeEnv)
  (Err (Box cdiag.CompilerDiagnostic)))

(cfg
  embedded-stdlib-tlci
  (define (macro-note-embedded-tlci-resolved-fallback!
    [catalog : MacroTlciResolvedCatalog]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      unit
      (cfg
        compile-profile
        (begin
          (set!
            compiler-tc-macro-stdlib-tlci-catalog-hits
            (+ compiler-tc-macro-stdlib-tlci-catalog-hits 1))
          (set!
            compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
            (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1)))
        unit))))

(cfg
  embedded-stdlib-tlci
  (define (macro-note-embedded-tlci-shell-fallback!
    [catalog : MacroTlciResolvedCatalog]) : unit
    (if (macro-tlci-resolved-catalog-dependency? catalog)
      unit
      (cfg
        compile-profile
        (begin
          (set!
            compiler-tc-macro-stdlib-tlci-catalog-hits
            (+ compiler-tc-macro-stdlib-tlci-catalog-hits 1))
          (set!
            compiler-tc-macro-stdlib-tlci-shell-cache-hits
            (+ compiler-tc-macro-stdlib-tlci-shell-cache-hits 1))
          (set!
            compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
            (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1)))
        unit))))

(define (macro-note-embedded-tlci-missing-fallback! [dependency-slot : i64]) : unit
  (if (>= dependency-slot 0)
    unit
    (cfg
      compile-profile
      (begin
        (set!
          compiler-tc-macro-stdlib-tlci-catalog-misses
          (+ compiler-tc-macro-stdlib-tlci-catalog-misses 1))
        (set!
          compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
          (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1)))
      unit)))

(define (macro-note-embedded-tlci-unavailable-fallback! [dependency-slot : i64]) : unit
  (if (>= dependency-slot 0)
    unit
    (cfg
      compile-profile
      (begin
        (set!
          compiler-tc-macro-stdlib-tlci-load-failures
          (+ compiler-tc-macro-stdlib-tlci-load-failures 1))
        (set!
          compiler-tc-macro-stdlib-tlci-interpreted-fallbacks
          (+ compiler-tc-macro-stdlib-tlci-interpreted-fallbacks 1)))
      unit)))

;; Expression position can resolve the catalog before binding. A native
;; commit consumes the shared capture values directly. If the first dispatch
;; learns a registration shell, fold those same values into the semantic
;; fallback environment once rather than checking the operands again.
(cfg
  embedded-stdlib-tlci
  (define (macro-try-stdlib-tlci-direct-expression
    [ctx : TcContext]
    [decls : ast.AstDeclList]
    [fallback-module : String]
    [fallback-module-id : i64]
    [type-env : TcTypeEnv]
    [macro-name-id : i64]
    [declaration-id : i64]
    [macro-name : String]
    [params : ast.AstMacroParamList]
    [ret : ast.AstType]
    [expanded-args : ast.AstExprList]
    [call-expr : ast.AstExpr]) : MacroDirectStdlibTlciResult
    (if (> params.len 8)
      MacroDirectStdlibTlciResult.No
      (let
        [dependency-slot : i64
          (macro-dependency-tlci-catalog-slot-for-declaration
            ctx
            declaration-id)]
        [identity : String
          (macro-tlci-catalog-identity fallback-module macro-name)]
        (match (macro-tlci-catalog-select
          ctx
          fallback-module
          identity
          declaration-id)
          [(MacroTlciCatalogSelection.None) MacroDirectStdlibTlciResult.No]
          [(MacroTlciCatalogSelection.Resolved catalog)
            (begin
              (cfg compile-profile (compiler-tc-walk-direct-marshal-start!))
              (match (let
                [capture-result : ResultMacroCapturedOperands
                  (macro-capture-params-direct
                    ctx
                    decls
                    fallback-module
                    fallback-module-id
                    type-env
                    macro-name
                    params
                    expanded-args
                    (tc-ctfe-env ctx)
                    (macro-expand-expr-type-macro?
                      (tc-context-macro-state ctx)
                      fallback-module-id
                      macro-name-id)
                    call-expr)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-tc-walk-direct-marshal-finish!))
                  capture-result))
                [(ResultMacroCapturedOperands.Err diag)
                  (MacroDirectStdlibTlciResult.Err diag)]
                [(ResultMacroCapturedOperands.Ok
                    operands
                    count
                    base-env
                    syntax-pools)
                  (begin
                    (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
                      (tc-context-ctfe-macro-state ctx))
                    (macro-result-provenance-reset-with-captured-body!
                      (tc-context-ctfe-macro-state ctx)
                      (macro-binding-prefix-transformer?
                        ctx
                        fallback-module
                        fallback-module-id
                        macro-name-id
                        params))
                    (macro-hygiene-produced-eval-start-with-pools!
                      (tc-context-macro-state ctx)
                      syntax-pools)
                    (cfg
                      compile-profile
                      (compiler-tc-walk-native-dispatch-start!))
                    (cfg compile-profile (compiler-tc-macro-profile-start))
                    (match (let
                      [native-result : MacroNativeStdlibTlciResult
                        (macro-try-stdlib-tlci-native-resolved
                          syntax-pools
                          (tc-context-macro-state ctx)
                          identity
                          catalog
                          params
                          ret
                          base-env
                          call-expr
                          operands
                          count
                          true)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-walk-native-dispatch-finish!))
                        native-result))
                      [(MacroNativeStdlibTlciResult.Value value)
                        (begin
                          (tc-context-install-pools! ctx)
                          (cfg
                            compile-profile
                            (begin
                              (if (macro-tlci-resolved-catalog-dependency?
                                catalog)
                                unit
                                (set!
                                  compiler-tc-macro-stdlib-tlci-direct-expr-results
                                  (+
                                    compiler-tc-macro-stdlib-tlci-direct-expr-results
                                    1)))
                              (compiler-tc-macro-profile-finish
                                (tc-context-macro-state ctx)
                                (ci.intern-composite-pair-id
                                  fallback-module-id
                                  macro-name-id)
                                macro-name
                                expanded-args)))
                          (MacroDirectStdlibTlciResult.Value
                            (ctfe_support.ctfe-capture-syntax-value-with-pools
                              value
                              syntax-pools)))]
                      [(MacroNativeStdlibTlciResult.Err diag)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-macro-profile-finish
                              (tc-context-macro-state ctx)
                              (ci.intern-composite-pair-id
                                fallback-module-id
                                macro-name-id)
                              macro-name
                              expanded-args))
                          (MacroDirectStdlibTlciResult.Err (box diag)))]
                      [(MacroNativeStdlibTlciResult.Shell)
                        (begin
                          (macro-note-embedded-tlci-resolved-fallback! catalog)
                          (macro-dependency-tlci-note-if!
                            (tc-context-macro-state ctx)
                            catalog
                            tc-dependency-tlci-direct-shell-env-folds)
                          (cfg
                            compile-profile
                            (set!
                              compiler-tc-macro-stdlib-tlci-direct-shell-env-folds
                              (+
                                compiler-tc-macro-stdlib-tlci-direct-shell-env-folds
                                1)))
                          (MacroDirectStdlibTlciResult.PreparedEnv
                            (macro-fold-captured-operands-env
                              params
                              operands
                              count
                              (ctfe_support.ctfe-env-rebase-syntax-pools
                                base-env
                                syntax-pools))))]
                      [(MacroNativeStdlibTlciResult.No)
                        (begin
                          (macro-note-embedded-tlci-resolved-fallback! catalog)
                          MacroDirectStdlibTlciResult.BoundFallback)]))]))]
          [(MacroTlciCatalogSelection.Shell catalog)
            (begin
              (macro-note-embedded-tlci-shell-fallback! catalog)
              MacroDirectStdlibTlciResult.BoundFallback)]
          [(MacroTlciCatalogSelection.MetadataOnly)
            (begin
              (macro-note-embedded-tlci-missing-fallback! dependency-slot)
              MacroDirectStdlibTlciResult.BoundFallback)]
          [(MacroTlciCatalogSelection.Missing)
            (begin
              (macro-note-embedded-tlci-missing-fallback! dependency-slot)
              MacroDirectStdlibTlciResult.BoundFallback)]
          [(MacroTlciCatalogSelection.Unavailable)
            (begin
              (macro-note-embedded-tlci-unavailable-fallback! dependency-slot)
              MacroDirectStdlibTlciResult.BoundFallback)])))))

(cfg
  (not embedded-stdlib-tlci)
  (define (macro-try-stdlib-tlci-direct-expression
    [ctx : TcContext]
    [_decls : ast.AstDeclList]
    [fallback-module : String]
    [_fallback-module-id : i64]
    [_type-env : TcTypeEnv]
    [_macro-name-id : i64]
    [declaration-id : i64]
    [macro-name : String]
    [_params : ast.AstMacroParamList]
    [_ret : ast.AstType]
    [_expanded-args : ast.AstExprList]
    [_call-expr : ast.AstExpr]) : MacroDirectStdlibTlciResult
    (match (macro-dependency-tlci-catalog-lookup
      ctx
      (macro-dependency-tlci-catalog-slot-for-declaration ctx declaration-id)
      (macro-tlci-catalog-identity fallback-module macro-name))
      [(cload.CompilerLoadDependencyCatalogLookup.NoCatalog)
        MacroDirectStdlibTlciResult.No]
      [_ MacroDirectStdlibTlciResult.BoundFallback])))

(define (macro-prepare-transformer-pools! [ctx : TcContext]) : unit
  ;; Argument normalization may extend the owned context while the global
  ;; active pool still points at an older caller snapshot.
  (if (ast.ast-node-pool-compat-context-active?)
    unit
    (let
      [owned-pools : ast.AstNodePoolContext (tc-context-pools ctx)]
      [active-pools : ast.AstNodePoolContext
        (ast.ast-node-pool-context-capture-active)]
      (if (or
        (>
          (ast.ast-node-pool-context-expr-len owned-pools)
          (ast.ast-node-pool-context-expr-len active-pools))
        (>
          (ast.ast-node-pool-context-type-len owned-pools)
          (ast.ast-node-pool-context-type-len active-pools)))
        (tc-context-install-pools! ctx)
        (tc-context-capture-active-pools! ctx)))))

(define (macro-eval-transformer-interpreted-with-env
  [ctx : TcContext]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [fallback-module-id : i64]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [macro-name-id : i64]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [macro-name : String]
  [body : ast.AstExpr]
  [captured-body? : bool]
  ;; lint-allow: unused-variable -- used by compile-profile builds.
  [expanded-args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]) : ResultMacroValueEnv
  (begin
    (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
      (tc-context-ctfe-macro-state ctx))
    (macro-result-provenance-reset-with-captured-body!
      (tc-context-ctfe-macro-state ctx)
      captured-body?)
    (macro-hygiene-produced-eval-start! (tc-context-macro-state ctx) env)
    (cfg compile-profile (compiler-tc-macro-profile-start))
    (match (ctfe_support.ctfe-eval-node
      body
      (ctfe_support.ctfe-env-extend-id
        env
        (ctfe_support.ctfe-hygiene-enabled-id)
        (ctfe_support.CompilerCtfeValue.Bool true))
      (ctfe_support.ctfe-fuel-limit))
      [(ctfe_support.ResultCtfe.Ok value _)
        (begin
          (tc-context-install-pools! ctx)
          (cfg
            compile-profile
            (compiler-tc-macro-profile-finish
              (tc-context-macro-state ctx)
              (ci.intern-composite-pair-id fallback-module-id macro-name-id)
              macro-name
              expanded-args))
          (ResultMacroValueEnv.Ok value env))]
      [(ctfe_support.ResultCtfe.Err diag)
        (begin
          (cfg
            compile-profile
            (compiler-tc-macro-profile-finish
              (tc-context-macro-state ctx)
              (ci.intern-composite-pair-id fallback-module-id macro-name-id)
              macro-name
              expanded-args))
          (ResultMacroValueEnv.Err diag))])))

(define (macro-bind-transformer-expanded-profiled
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroEnv
  (begin
    (macro-prepare-transformer-pools! ctx)
    (cfg compile-profile (compiler-tc-walk-bind-params-start!))
    (let
      [bind-result : ResultMacroEnv
        (macro-bind-params
          ctx
          decls
          fallback-module
          fallback-module-id
          type-env
          macro-name
          params
          expanded-args
          (tc-ctfe-env ctx)
          (macro-expand-expr-type-macro?
            (tc-context-macro-state ctx)
            fallback-module-id
            macro-name-id)
          call-expr)]
      (begin
        (cfg compile-profile (compiler-tc-walk-bind-params-finish!))
        bind-result))))

;; Run a macro transformer via CTFE. Module/declaration macro expansion also
;; needs the bound CTFE environment while normalizing generated import operands.
(define (macro-eval-transformer-expanded-with-env
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroValueEnv
  (match (macro-bind-transformer-expanded-profiled
    ctx
    decls
    fallback-module
    fallback-module-id
    type-env
    macro-name-id
    macro-name
    params
    expanded-args
    call-expr)
    [(ResultMacroEnv.Ok env)
      (begin
        ;; Both routes publish per-transformer syntax metadata. Reset before
        ;; native dispatch as well as before an interpreted fallback so an
        ;; earlier expansion cannot leak either marker into this result.
        (ctfe_support.ctfe-result-hygiene-free-reset-for-state!
          (tc-context-ctfe-macro-state ctx))
        (macro-result-provenance-reset-with-captured-body!
          (tc-context-ctfe-macro-state ctx)
          (macro-binding-prefix-transformer?
            ctx
            fallback-module
            fallback-module-id
            macro-name-id
            params))
        (macro-hygiene-produced-eval-start! (tc-context-macro-state ctx) env)
        (cfg compile-profile (compiler-tc-walk-native-dispatch-start!))
        (cfg compile-profile (compiler-tc-macro-profile-start))
        (match (let
          [native-result : MacroNativeStdlibTlciResult
            (macro-try-stdlib-tlci-native
              ctx
              fallback-module
              declaration-id
              macro-name
              params
              ret
              env
              call-expr)]
          (begin
            (cfg compile-profile (compiler-tc-walk-native-dispatch-finish!))
            native-result))
          [(MacroNativeStdlibTlciResult.Value value)
            (begin
              (tc-context-install-pools! ctx)
              (cfg
                compile-profile
                (compiler-tc-macro-profile-finish
                  (tc-context-macro-state ctx)
                  (ci.intern-composite-pair-id fallback-module-id macro-name-id)
                  macro-name
                  expanded-args))
              (ResultMacroValueEnv.Ok value env))]
          [(MacroNativeStdlibTlciResult.Err diag)
            (begin
              (cfg
                compile-profile
                (compiler-tc-macro-profile-finish
                  (tc-context-macro-state ctx)
                  (ci.intern-composite-pair-id fallback-module-id macro-name-id)
                  macro-name
                  expanded-args))
              (ResultMacroValueEnv.Err (box diag)))]
          [(MacroNativeStdlibTlciResult.No)
            (begin
              (macro-note-stdlib-tlci-route
                (tc-context-macro-state ctx)
                fallback-module
                macro-name)
              (macro-eval-transformer-interpreted-with-env
                ctx
                fallback-module-id
                macro-name-id
                macro-name
                body
                (macro-binding-prefix-transformer?
                  ctx
                  fallback-module
                  fallback-module-id
                  macro-name-id
                  params)
                expanded-args
                env))]
          [(MacroNativeStdlibTlciResult.Shell)
            (begin
              (macro-note-stdlib-tlci-route
                (tc-context-macro-state ctx)
                fallback-module
                macro-name)
              (macro-eval-transformer-interpreted-with-env
                ctx
                fallback-module-id
                macro-name-id
                macro-name
                body
                (macro-binding-prefix-transformer?
                  ctx
                  fallback-module
                  fallback-module-id
                  macro-name-id
                  params)
                expanded-args
                env))]))]
    [(ResultMacroEnv.Err diag) (ResultMacroValueEnv.Err diag)]))

;; Run a macro transformer via CTFE. Callers decide how to interpret the
;; returned syntax value for expression, module, or declaration positions.
(define (macro-eval-transformer-expanded
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [type-env : TcTypeEnv]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [expanded-args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroValue
  (begin
    (macro-prepare-transformer-pools! ctx)
    (match (macro-try-stdlib-tlci-direct-expression
      ctx
      decls
      fallback-module
      fallback-module-id
      type-env
      macro-name-id
      declaration-id
      macro-name
      params
      ret
      expanded-args
      call-expr)
      [(MacroDirectStdlibTlciResult.Value value) (ResultMacroValue.Ok value)]
      [(MacroDirectStdlibTlciResult.Err diag) (ResultMacroValue.Err diag)]
      [(MacroDirectStdlibTlciResult.PreparedEnv env)
        (match (macro-eval-transformer-interpreted-with-env
          ctx
          fallback-module-id
          macro-name-id
          macro-name
          body
          (macro-binding-prefix-transformer?
            ctx
            fallback-module
            fallback-module-id
            macro-name-id
            params)
          expanded-args
          env)
          [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
          [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)])]
      [(MacroDirectStdlibTlciResult.BoundFallback)
        (match (macro-bind-transformer-expanded-profiled
          ctx
          decls
          fallback-module
          fallback-module-id
          type-env
          macro-name-id
          macro-name
          params
          expanded-args
          call-expr)
          [(ResultMacroEnv.Ok env)
            (match (macro-eval-transformer-interpreted-with-env
              ctx
              fallback-module-id
              macro-name-id
              macro-name
              body
              (macro-binding-prefix-transformer?
                ctx
                fallback-module
                fallback-module-id
                macro-name-id
                params)
              expanded-args
              env)
              [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
              [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)])]
          [(ResultMacroEnv.Err diag) (ResultMacroValue.Err diag)])]
      [(MacroDirectStdlibTlciResult.No)
        (match (macro-eval-transformer-expanded-with-env
          ctx
          decls
          fallback-module
          fallback-module-id
          type-env
          macro-name-id
          declaration-id
          macro-name
          params
          ret
          body
          expanded-args
          call-expr)
          [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
          [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)])])))

(define (macro-binding-prefix-form? [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.BracketClause _) true]
    [_ false]))

(define (macro-expand-binding-prefix-items
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [items : ast.AstExprList]) : ResultMacroExpr
  (let
    [len : i64 items.len]
    (if (<= len 1)
      (ResultMacroExpr.Ok (ast.ast-expr-bracket-clause items))
      (match (macro-expand-node
        ctx
        type-env
        decls
        depth
        (ast.ast-expr-list-get (& items) (- len 1) 0))
        [(ResultMacroExpr.Ok ninit)
          (let
            [out : ast.AstExprList (ast.ast-expr-list-with-capacity len)]
            [index : i64 0]
            (begin
              (while (< index (- len 1))
                (begin
                  (ast.ast-expr-list-push
                    (&mut out)
                    (ast.ast-expr-list-get (& items) index 0))
                  (set! index (+ index 1))))
              (ast.ast-expr-list-push (&mut out) ninit)
              (ResultMacroExpr.Ok (ast.ast-expr-bracket-clause out))))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))))

(define (macro-expand-binding-prefix-form
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  (match expr
    [(ast.AstExpr.Spanned inner span)
      (match (macro-expand-binding-prefix-form
        ctx
        type-env
        decls
        depth
        (tc-context-expr-get ctx inner))
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-spanned ninner span))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.MacroExpansion inner provenance-id macro-name-id)
      (match (macro-expand-binding-prefix-form
        ctx
        type-env
        decls
        depth
        (tc-context-expr-get ctx inner))
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok
            (ast.ast-expr-macro-expansion ninner provenance-id macro-name-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.BracketClause items)
      (macro-expand-binding-prefix-items ctx type-env decls depth items)]
    [_
      (ResultMacroExpr.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            expr
            "typecheck: expected binding clause")))]))

(define (macro-expand-binding-prefix-args-into
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : ResultMacroCheck
  (if (>= index args.len)
    ResultMacroCheck.Ok
    (let
      [head-id : i64 (ast.ast-expr-list-get args index 0)]
      [head : ast.AstExpr (tc-context-expr-get ctx head-id)]
      (if (macro-binding-prefix-form? head)
        (match (macro-expand-binding-prefix-form ctx type-env decls depth head)
          [(ResultMacroExpr.Ok nhead)
            (begin
              (ast.ast-expr-list-push out nhead)
              (macro-expand-binding-prefix-args-into
                ctx
                type-env
                decls
                depth
                args
                (+ index 1)
                out))]
          [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)])
        (begin
          ;; The remaining Expr operands are captured syntax. They must be
          ;; expanded after the binding transformer introduces their lexical
          ;; scope, not as arguments to the transformer itself.
          (ast.ast-expr-list-append-from out args index)
          ResultMacroCheck.Ok)))))

(define (macro-expand-binding-prefix-args
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [args : ast.AstExprList]) : ResultMacroExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity args.len)]
    (match (macro-expand-binding-prefix-args-into
      ctx
      type-env
      decls
      depth
      (& args)
      0
      (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroExprList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroExprList.Err diag)])))

(define (macro-binding-prefix-transformer?
  [ctx : TcContext]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name-id : i64]
  [params : ast.AstMacroParamList]) : bool
  (if (or
    (not (string.eq (ci.intern-str macro-name-id) "for"))
    (not (= (ast.ast-macro-param-list-len (& params)) 2)))
    false
    (match (ast.ast-macro-param-list-get
      (& params)
      0
      (ast.ast-macro-param-fallback))
      [(ast.AstMacroParam.Param _ binding-ty binding-variadic _)
        (match (ast.ast-macro-param-list-get
          (& params)
          1
          (ast.ast-macro-param-fallback))
          [(ast.AstMacroParam.Param _ body-ty body-variadic _)
            (and
              binding-variadic
              body-variadic
              (macro-param-expr-binding-clause?
                ctx
                fallback-module
                fallback-module-id
                binding-ty)
              (tc-type-eq
                (macro-resolve-signature-type-id
                  ctx
                  fallback-module
                  fallback-module-id
                  body-ty)
                (ast.AstType.Expr)))])])))

(define (macro-eval-transformer
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [fallback-module : String]
  [fallback-module-id : i64]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroValue
  ;; Expand ordinary operands first so a macro call passed as an argument (e.g.
  ;; a nested `str_cat.str-cat`) is reduced before it is typechecked. A
  ;; binding-prefix transformer is different: only its clause initializers are
  ;; in the caller's current scope; captured Expr bodies are expanded after the
  ;; transformer introduces their binders.
  (match (if (macro-binding-prefix-transformer?
    ctx
    fallback-module
    fallback-module-id
    macro-name-id
    params)
    (macro-expand-binding-prefix-args ctx type-env decls depth args)
    (macro-expand-exprs ctx type-env decls depth args))
    [(ResultMacroExprList.Ok expanded-args)
      (macro-eval-transformer-expanded
        ctx
        decls
        fallback-module
        fallback-module-id
        type-env
        macro-name-id
        declaration-id
        macro-name
        params
        ret
        body
        expanded-args
        call-expr)]
    [(ResultMacroExprList.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-generated-type-param-expr-list
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [exprs : ast.AstExprList]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    (begin
      (macro-generated-type-param-expr-list-into
        pools
        env
        (& exprs)
        0
        (&mut out))
      out)))

(define (macro-generated-type-param-expr-list-into
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : unit
  (if (>= index exprs.len)
    unit
    (begin
      (ast.ast-expr-list-push
        out
        (macro-generated-type-param-expr
          pools
          env
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-expr-list-get exprs index 0))))
      (macro-generated-type-param-expr-list-into
        pools
        env
        exprs
        (+ index 1)
        out))))

;; Generated import operands and their existing child ids belong to the
;; typechecker's syntax pool. Pass that pool explicitly so rewriting cannot
;; consult or mutate whichever compatibility pool another compile job installed.
(define (macro-generated-type-param-expr
  [pools : ast.AstNodePoolContext]
  [env : ctfe_support.CtfeEnv]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Spanned
            (macro-generated-type-param-expr pools env inner)
            span)))]
    [(ast.AstExpr.MacroExpansion inner-box provenance-id macro-name-id)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.MacroExpansion
            (macro-generated-type-param-expr pools env inner)
            provenance-id
            macro-name-id)))]
    [(ast.AstExpr.Var name)
      (let
        [lookup-id : i64
          (macro-output-source-identity-id-at name "generated-type-param")]
        (match (if (>= lookup-id 0)
          (ctfe_support.ctfe-env-lookup-id env lookup-id)
          (ctfe_support.CtfeMaybeValue.None))
          [(ctfe_support.CtfeMaybeValue.Some value)
            (match value
              [(ctfe_support.CompilerCtfeValue.Type ty)
                (ast.ast-node-pool-context-expr-push
                  pools
                  (ast.AstExpr.TypeLiteral
                    (ast.ast-node-pool-context-type-push pools ty)))]
              [_ (ast.ast-node-pool-context-expr-push pools expr)])]
          [(ctfe_support.CtfeMaybeValue.None)
            (ast.ast-node-pool-context-expr-push pools expr)]))]
    [(ast.AstExpr.Call func-box args)
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Call
          func-box
          (macro-generated-type-param-expr-list pools env args)))]
    [_ (ast.ast-node-pool-context-expr-push pools expr)]))

(define (macro-generated-call-func-for-lookup
  [pools : ast.AstNodePoolContext]
  [expr : ast.AstExpr]) : ast.AstExpr
  (match (ast.ast-expr-unspan-with-pools pools expr)
    [(ast.AstExpr.Var name)
      (ast.AstExpr.Var
        (macro-output-source-identity-id-at name "generated-call-func"))]
    [_ expr]))

(define (macro-generated-import-type-arg
  [pools : ast.AstNodePoolContext]
  [ty : ast.AstType]
  [arg : i64]
  [env : ctfe_support.CtfeEnv]) : i64
  (if (tc-macro-type-param-kind? ty)
    (macro-generated-type-param-expr
      pools
      env
      (ast.ast-node-pool-context-expr-get pools arg))
    arg))

(define (macro-generated-import-bracket-prefix-count
  [pools : ast.AstNodePoolContext]
  [args : (& args ast.AstExprList)]
  [index : i64]) : i64
  (if (>= index args.len)
    0
    (match (ast.ast-expr-unspan-with-pools
      pools
      (ast.ast-node-pool-context-expr-get
        pools
        (ast.ast-expr-list-get args index 0)))
      [(ast.AstExpr.BracketClause _)
        (+
          1
          (macro-generated-import-bracket-prefix-count pools args (+ index 1)))]
      [_ 0])))

(define (macro-generated-import-prepend-range
  [args : (& args ast.AstExprList)]
  [index : i64]
  [end : i64]
  [tail : ast.AstExprList]) : ast.AstExprList
  (if (>= index end)
    tail
    (ast.ast-expr-cons
      (ast.ast-expr-list-get args index 0)
      (macro-generated-import-prepend-range args (+ index 1) end tail))))

(define (macro-generated-import-type-args-for-param
  [pools : ast.AstNodePoolContext]
  [param : ast.AstMacroParam]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (match param
    [(ast.AstMacroParam.Param _ ty variadic _)
      (if variadic
        (if (>= (+ param-index 1) (ast.ast-macro-param-list-len params))
          (let
            [remaining : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref args arg-index)]
            (if (tc-macro-type-param-kind? ty)
              (macro-generated-type-param-expr-list pools env remaining)
              remaining))
          (let
            [prefix-count : i64
              (macro-generated-import-bracket-prefix-count pools args arg-index)]
            [next-arg-index : i64 (+ arg-index prefix-count)]
            (macro-generated-import-prepend-range
              args
              arg-index
              next-arg-index
              (macro-generated-import-type-args-at
                pools
                params
                args
                (+ param-index 1)
                next-arg-index
                env))))
        (ast.ast-expr-cons
          (macro-generated-import-type-arg
            pools
            ty
            (ast.ast-expr-list-get args arg-index 0)
            env)
          (macro-generated-import-type-args-at
            pools
            params
            args
            (+ param-index 1)
            (+ arg-index 1)
            env)))]))

(define (macro-generated-import-type-args
  [pools : ast.AstNodePoolContext]
  [params : ast.AstMacroParamList]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (macro-generated-import-type-args-at pools (& params) (& args) 0 0 env))

(define (macro-generated-import-type-args-at
  [pools : ast.AstNodePoolContext]
  [params : (& params ast.AstMacroParamList)]
  [args : (& args ast.AstExprList)]
  [param-index : i64]
  [arg-index : i64]
  [env : ctfe_support.CtfeEnv]) : ast.AstExprList
  (if (>= param-index (ast.ast-macro-param-list-len params))
    (ast.ast-expr-list-tail-from-ref args arg-index)
    (if (>= arg-index args.len)
      (ast.ast-expr-list-new)
      (macro-generated-import-type-args-for-param
        pools
        (ast.ast-macro-param-list-get
          params
          param-index
          (ast.ast-macro-param-fallback))
        params
        args
        param-index
        arg-index
        env))))

(define (macro-rewrite-generated-import-call-with-decl
  [pools : ast.AstNodePoolContext]
  [func-box : i64]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [fallback : i64]
  [maybe-decl : MacroMaybeDecl]) : i64
  (match maybe-decl
    [(MacroMaybeDecl.Some _ _ _ params _ _)
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Call
          func-box
          (macro-generated-import-type-args pools params args env)))]
    [(MacroMaybeDecl.No) fallback]))

(define (macro-rewrite-generated-import-direct-call
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [_ : String]
  [module-id : i64]
  [func : ast.AstExpr]
  [call-expr : ast.AstExpr]
  [func-box : i64]
  [args : ast.AstExprList]
  [env : ctfe_support.CtfeEnv]
  [fallback : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (ctfe_support.ctfe-env-pools env)]
    (match (ast.ast-expr-unspan-with-pools pools func)
      [(ast.AstExpr.Var name)
        (let
          [lookup-name : String
            (macro-output-source-name-id-at name "generated-import-call")]
          [source-id : i64
            (macro-output-syntax-id-at name "generated-import-call")]
          (if (or
            (tc-name-qualified-id? source-id)
            (tc-source-slash-qualified-id? lookup-name source-id)
            (>= (tc-name-first-dot-id source-id) 0))
            fallback
            (match (macro-import-alias-target-cached-id-in-context
              ctx
              decls
              module-id
              source-id)
              [(TcMaybeNameId.Some target-id)
                (match (macro-unqualified-imported-target-call-decl
                  ctx
                  target-id
                  source-id
                  call-expr)
                  [(ResultMacroCallDecl.Ok maybe-decl)
                    (match maybe-decl
                      [(MacroMaybeDecl.Some _ _ _ _ _ _)
                        (macro-rewrite-generated-import-call-with-decl
                          pools
                          func-box
                          args
                          env
                          fallback
                          maybe-decl)]
                      [(MacroMaybeDecl.No)
                        (ast.ast-node-pool-context-expr-push
                          pools
                          (ast.AstExpr.Call
                            func-box
                            (macro-generated-type-param-expr-list
                              pools
                              env
                              args)))])]
                  [(ResultMacroCallDecl.Err _) fallback])]
              [(TcMaybeNameId.No) fallback])))]
      [_ fallback])))

(define (macro-rewrite-generated-import-call-id
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [call-id : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (ctfe_support.ctfe-env-pools env)]
    [call-expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools call-id)]
    [rewritten : i64
      (match (ast.ast-expr-unspan-with-pools pools call-expr)
        [(ast.AstExpr.Call func-box args)
          (let
            [func : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools func-box)]
            [lookup-func : ast.AstExpr
              (macro-generated-call-func-for-lookup pools func)]
            (match (macro-call-decl-with-context
              ctx
              lookup-func
              orig-decls
              module
              module-id
              (ast.AstMaybeModuleName.Some definition-module-id)
              call-expr)
              [(ResultMacroCallDeclModule.Ok maybe-decl _ _)
                (match maybe-decl
                  [(MacroMaybeDecl.Some _ _ _ _ _ _)
                    (macro-rewrite-generated-import-call-with-decl
                      pools
                      func-box
                      args
                      env
                      call-id
                      maybe-decl)]
                  [(MacroMaybeDecl.No)
                    (macro-rewrite-generated-import-direct-call
                      ctx
                      orig-decls
                      module
                      module-id
                      lookup-func
                      call-expr
                      func-box
                      args
                      env
                      call-id)])]
              [(ResultMacroCallDeclModule.Err _)
                (macro-rewrite-generated-import-direct-call
                  ctx
                  orig-decls
                  module
                  module-id
                  lookup-func
                  call-expr
                  func-box
                  args
                  env
                  call-id)]))]
        [_ call-id])]
    (begin
      ;; Explicit pushes update the context cell, while compatibility pushers
      ;; still read the installed scalar state. Publish the rewritten context
      ;; before the next declaration can append through that legacy surface.
      (tc-install-pools! pools)
      rewritten)))

(define (macro-rewrite-generated-import-kind
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [kind : ast.AstImportKind]) : ast.AstImportKind
  (match kind
    [(ast.AstImportKind.Macro call-id context)
      (ast.AstImportKind.Macro
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [(ast.AstImportKind.MacroDecls call-id context)
      (ast.AstImportKind.MacroDecls
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          call-id)
        context)]
    [_ kind]))

(define (macro-rewrite-generated-import-decl
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decl : ast.AstDecl]) : ast.AstDecl
  (match decl
    [(ast.AstDecl.Import
        decl-meta
        (ast.AstImportSpec.Spec kind path expected alias span))
      (ast.AstDecl.Import
        decl-meta
        (ast.AstImportSpec.Spec
          (macro-rewrite-generated-import-kind
            ctx
            orig-decls
            module
            module-id
            definition-module-id
            env
            kind)
          path
          expected
          alias
          span))]
    [(ast.AstDecl.Unsafe inner-box)
      (ast.ast-decl-unsafe
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          module-id
          definition-module-id
          env
          (__tl-box-place inner-box)))]
    [(ast.AstDecl.ModuleBody name body-box)
      (ast.ast-decl-module-body-id
        name
        (macro-rewrite-generated-import-decls-with-env
          ctx
          orig-decls
          (tc-env-key-name-text name)
          name
          definition-module-id
          env
          (__tl-box-place body-box)))]
    [_ decl]))

(define (macro-rewrite-generated-import-decls-with-env
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decls : ast.AstDeclList]) : ast.AstDeclList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [cursor : ast.AstDeclList decls]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast.ast-decl-list-step cursor)
          [(ast.AstDeclListStep.Nil) (set! done true)]
          [(ast.AstDeclListStep.Cons decl rest)
            (begin
              (ast.ast-decl-list-push
                (&mut out)
                (macro-rewrite-generated-import-decl
                  ctx
                  orig-decls
                  module
                  module-id
                  definition-module-id
                  env
                  decl))
              (set! cursor rest))]))
      out)))

(define (macro-rewrite-generated-import-decls
  [ctx : TcContext]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [definition-module-id : i64]
  [env : ctfe_support.CtfeEnv]
  [decls : ast.AstDeclList]) : ast.AstDeclList
  (let
    ;; Parsing and hygiene may have appended generated syntax after `ctx` was
    ;; captured. The installed live context owns those ids and shares its cells
    ;; with compatibility pushers, so select it once at this migration
    ;; boundary and keep every rewrite below explicit.
    [rewrite-pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-active-live)]
    [rewrite-env : ctfe_support.CtfeEnv
      (ctfe_support.ctfe-env-extend-id
        (ctfe_support.ctfe-env-rebase-pools env rewrite-pools)
        (ctfe_support.ctfe-hygiene-enabled-id)
        (ctfe_support.CompilerCtfeValue.Bool true))]
    (macro-rewrite-generated-import-decls-with-env
      ctx
      orig-decls
      module
      module-id
      definition-module-id
      rewrite-env
      decls)))

;; Run an expression-position macro transformer via CTFE and re-expand its
;; produced form to a fixpoint.
(define (macro-expand-produced-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr-id : i64]) : ResultMacroExpr
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    ;; A transformer result may live in its scratch pool rather than `ctx`.
    ;; Capture the installed table after evaluation and keep it for this
    ;; read-only fire scan.
    [expr-bases : i64 (ast.ast-node-pool-active-expr-segment-bases)]
    [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
    (if (not
      (ctfe_support.ctfe-result-may-contain-macro-for-state?
        (tc-macro-ctfe-state state)))
      (begin
        (cfg compile-profile (compiler-tc-walk-note-expand-visit!))
        (cfg compile-profile (compiler-tc-walk-note-rewalk-provenance-skip!))
        ;; Produced roots can belong to a transformer scratch pool. Match the
        ;; old value-entry no-fire path by copying the root into the active AST
        ;; pool before that scratch storage is released.
        (ResultMacroExpr.Ok (ast.ast-node-push expr)))
      (let
        [fires : bool (macro-expr-might-fire? state expr-bases expr)]
        (begin
          (cfg
            compile-profile
            (compiler-tc-walk-note-rewalk-fire-decision! fires))
          (if (or (not fires) (< (macro-expand-depth-limit) depth))
            (begin
              (cfg compile-profile (compiler-tc-walk-note-expand-visit!))
              (if (not fires)
                (ResultMacroExpr.Ok (ast.ast-node-push expr))
                (ResultMacroExpr.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      expr
                      "macro expansion exceeded depth limit")))))
            (begin
              (cfg compile-profile (compiler-tc-walk-note-expand-visit!))
              (macro-expand-expr-fire ctx env decls depth expr))))))))

(define (macro-expand-call-unframed
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [definition-module : String]
  [definition-module-id : i64]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroExpr
  (if (tc-macro-result-module? ret)
    (ResultMacroExpr.Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          "typecheck: Module macro can only be used in import position")))
    (if (tc-macro-result-decls? ret)
      (ResultMacroExpr.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Decls macro can only be used at module scope")))
      (match (macro-eval-transformer
        ctx
        type-env
        decls
        definition-module
        definition-module-id
        macro-name-id
        declaration-id
        macro-name
        params
        ret
        body
        args
        depth
        call-expr)
        [(ResultMacroValue.Ok value)
          (match value
            [(ctfe_support.CompilerCtfeValue.Expr expanded produced)
              (if (tc-macro-produced-type-compatible? ctx ret produced)
                (begin
                  (cfg compile-profile (compiler-tc-walk-rewalk-start!))
                  (let
                    [rewalk-result : ResultMacroExpr
                      (macro-expand-produced-node
                        ctx
                        type-env
                        decls
                        (+ depth 1)
                        (if (=
                          expanded
                          (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                            (tc-context-ctfe-macro-state ctx)))
                          expanded
                          (begin
                            (macro-hygiene-env-root-begin!
                              (tc-context-macro-state ctx))
                            (let
                              [out : i64
                                (macro-hygiene-produced-expr
                                  expanded
                                  (macro-hygiene-env-empty
                                    (tc-context-macro-state ctx)
                                    (tc-context-type-pools ctx))
                                  (MacroHygieneContext
                                    macro-name-id
                                    definition-module-id
                                    declaration-id
                                    (tc-context-symbols ctx))
                                  (+ depth 1))]
                              (begin
                                (macro-hygiene-env-root-finish!
                                  (tc-context-macro-state ctx))
                                out)))))]
                    (begin
                      (cfg compile-profile (compiler-tc-walk-rewalk-finish!))
                      rewalk-result)))
                (ResultMacroExpr.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: macro expansion produced type does not match declaration"))))]
            [(ctfe_support.CompilerCtfeValue.CapturedExpr
                expanded
                produced
                pools)
              (if (tc-macro-produced-type-compatible? ctx ret produced)
                (begin
                  ;; CTFE built this syntax beside the checked caller
                  ;; operands. Install that pool before applying hygiene.
                  (tc-install-pools! pools)
                  (tc-context-capture-active-pools! ctx)
                  (cfg compile-profile (compiler-tc-walk-rewalk-start!))
                  (let
                    [rewalk-result : ResultMacroExpr
                      (macro-expand-produced-node
                        ctx
                        type-env
                        decls
                        (+ depth 1)
                        (if (=
                          expanded
                          (ctfe_support.ctfe-result-hygiene-free-node-id-for-state
                            (tc-context-ctfe-macro-state ctx)))
                          expanded
                          (begin
                            (macro-hygiene-env-root-begin!
                              (tc-context-macro-state ctx))
                            (let
                              [out : i64
                                (macro-hygiene-produced-expr
                                  expanded
                                  (macro-hygiene-env-empty
                                    (tc-context-macro-state ctx)
                                    pools)
                                  (MacroHygieneContext
                                    macro-name-id
                                    definition-module-id
                                    declaration-id
                                    (tc-context-symbols ctx))
                                  (+ depth 1))]
                              (begin
                                (macro-hygiene-env-root-finish!
                                  (tc-context-macro-state ctx))
                                out)))))]
                    (begin
                      (cfg compile-profile (compiler-tc-walk-rewalk-finish!))
                      rewalk-result)))
                (ResultMacroExpr.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: macro expansion produced type does not match declaration"))))]
            [_
              (ResultMacroExpr.Err
                (box
                  (ctfe_support.ctfe-diagnostic-at-expr
                    call-expr
                    "macro transformer did not produce an Expr")))])]
        [(ResultMacroValue.Err diag) (ResultMacroExpr.Err diag)]))))

(define (macro-expand-call
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [macro-name-id : i64]
  [declaration-id : i64]
  [macro-name : String]
  [definition-module : String]
  [definition-module-id : i64]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [args : ast.AstExprList]
  [depth : i64]
  [call-expr : ast.AstExpr]) : ResultMacroExpr
  (match (macro-expand-call-unframed
    ctx
    type-env
    decls
    macro-name-id
    declaration-id
    macro-name
    definition-module
    definition-module-id
    params
    ret
    body
    args
    depth
    call-expr)
    [(ResultMacroExpr.Ok expanded)
      (ResultMacroExpr.Ok
        (if (macro-private-place-bridge-name? macro-name)
          ;; These private one-epoch source bridges only materialize parser AST
          ;; operations. Keeping their expansion transparent avoids treating an
          ;; implementation spelling as a user-facing diagnostic frame and
          ;; preserves nested place operands in the caller pool.
          expanded
          (ast.ast-expr-macro-expansion
            expanded
            (macro-expansion-provenance-id
              (macro-active-decl-path-id ctx)
              (macro-definition-path-id ctx (ci.intern macro-name)))
            (ci.intern macro-name))))]
    [(ResultMacroExpr.Err diag)
      (ResultMacroExpr.Err
        (box
          (macro-diagnostic-with-expansion-site
            ctx
            (macro-active-decl-path ctx)
            call-expr
            macro-name
            (__tl-box-place diag))))]))

(define (macro-expand-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [exprs : ast.AstExprList]) : ResultMacroExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    (match (macro-expand-exprs-into ctx env decls depth (& exprs) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroExprList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroExprList.Err diag)])))

(define (macro-expand-exprs-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstExprList)]) : ResultMacroCheck
  (if (>= index exprs.len)
    (ResultMacroCheck.Ok)
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      (match (macro-expand-node ctx env decls depth head-id)
        [(ResultMacroExpr.Ok nhead)
          (begin
            (ast.ast-expr-list-push out nhead)
            (macro-expand-exprs-into ctx env decls depth exprs (+ index 1) out))]
        [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)]))))

;; Expand a node after its might-fire result is already known. Match arms use
;; this entry so deciding whether an arm needs a type environment does not make
;; the firing arm pay for the same recursive predicate walk a second time.
(define (macro-expand-node-with-fire-decision
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr-id : i64]
  [expr : ast.AstExpr]
  [fires : bool]) : ResultMacroExpr
  (begin
    (cfg compile-profile (compiler-tc-walk-note-expand-visit!))
    (if (or (not fires) (< (macro-expand-depth-limit) depth))
      (if (not fires)
        (ResultMacroExpr.Ok expr-id)
        (ResultMacroExpr.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              expr
              "macro expansion exceeded depth limit"))))
      (macro-expand-expr-fire ctx env decls depth expr))))

(define (macro-expand-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [scrut-ty : ast.AstType]
  [first-fire-index : i64]
  [arms : ast.AstMatchArmList]) : ResultMacroArms
  (let
    [out : ast.AstMatchArmList (ast.ast-match-arm-list-with-capacity arms.len)]
    (match (macro-expand-arms-into
      ctx
      env
      decls
      depth
      scrut-ty
      first-fire-index
      (& arms)
      0
      (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroArms.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroArms.Err diag)])))

(define (macro-expand-arms-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [scrut-ty : ast.AstType]
  [first-fire-index : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [out : (&mut out ast.AstMatchArmList)]) : ResultMacroCheck
  (if (>= index arms.len)
    (ResultMacroCheck.Ok)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
          [body-fires : bool
            (if (<= index first-fire-index)
              (= index first-fire-index)
              (macro-expr-might-fire?
                (tc-context-macro-state ctx)
                (tc-context-expr-bases ctx)
                body))]
          (if (not body-fires)
            (match (macro-expand-node-with-fire-decision
              ctx
              env
              decls
              depth
              body-box
              body
              false)
              [(ResultMacroExpr.Ok nbody)
                (begin
                  (ast.ast-match-arm-list-push
                    out
                    (ast.ast-match-arm pattern nbody))
                  (macro-expand-arms-into
                    ctx
                    env
                    decls
                    depth
                    scrut-ty
                    first-fire-index
                    arms
                    (+ index 1)
                    out))]
              [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)])
            (begin
              (cfg compile-profile (compiler-tc-walk-arm-bind-start!))
              (let
                [arm-env-result : ResultTcEnv
                  (tc-bind-match-pattern ctx env scrut-ty pattern)]
                (begin
                  (cfg compile-profile (compiler-tc-walk-arm-bind-finish!))
                  (match arm-env-result
                    [(ResultTcEnv.Ok arm-env)
                      (match (macro-expand-node-with-fire-decision
                        ctx
                        arm-env
                        decls
                        depth
                        body-box
                        body
                        true)
                        [(ResultMacroExpr.Ok nbody)
                          (begin
                            (ast.ast-match-arm-list-push
                              out
                              (ast.ast-match-arm pattern nbody))
                            (macro-expand-arms-into
                              ctx
                              env
                              decls
                              depth
                              scrut-ty
                              first-fire-index
                              arms
                              (+ index 1)
                              out))]
                        [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)])]
                    [(ResultTcEnv.Err message)
                      (ResultMacroCheck.Err (box (tc-expr-diag body message)))]))))))])))

(define (macro-expand-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : ast.AstLetBindingList]) : ResultMacroLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    (match (macro-expand-bindings-into
      ctx
      env
      decls
      depth
      (& bindings)
      0
      (&mut out))
      [(ResultMacroLetBindingsBuild.Ok final-env)
        (ResultMacroLetBindings.Ok out final-env)]
      [(ResultMacroLetBindingsBuild.Err diag) (ResultMacroLetBindings.Err diag)])))

(define (macro-expand-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : ResultMacroLetBindingsBuild
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultMacroLetBindingsBuild.Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (match (macro-expand-node ctx env decls depth init-box)
          [(ResultMacroExpr.Ok ninit)
            (match (begin
              (cfg compile-profile (compiler-tc-walk-let-bind-start!))
              (let
                [let-bind-result : ResultTcEnv
                  (tc-let-bindings
                    ctx
                    env
                    (ast.ast-let-binding-cons
                      (ast.ast-let-binding-id name maybe-ty ninit)
                      (ast.ast-let-binding-list-new)))]
                (begin
                  (cfg compile-profile (compiler-tc-walk-let-bind-finish!))
                  let-bind-result)))
              [(ResultTcEnv.Ok next-env)
                (begin
                  (ast.ast-let-binding-list-push
                    out
                    (ast.ast-let-binding-id name maybe-ty ninit))
                  (macro-expand-bindings-into
                    ctx
                    next-env
                    decls
                    depth
                    bindings
                    (+ index 1)
                    out))]
              [(ResultTcEnv.Err message)
                (ResultMacroLetBindingsBuild.Err
                  (box (tc-expr-diag (tc-context-expr-get ctx ninit) message)))])]
          [(ResultMacroExpr.Err diag) (ResultMacroLetBindingsBuild.Err diag)])])))

(define (macro-expand-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : ast.AstResourceBindingList]) : ResultMacroResourceBindings
  (let
    [out : ast.AstResourceBindingList
      (ast.ast-resource-binding-list-with-capacity
        (ast.ast-resource-binding-list-len (& bindings)))]
    (match (macro-expand-resource-bindings-into
      ctx
      env
      decls
      depth
      (& bindings)
      0
      (&mut out))
      [(ResultMacroResourceBindingsBuild.Ok final-env)
        (ResultMacroResourceBindings.Ok out final-env)]
      [(ResultMacroResourceBindingsBuild.Err diag)
        (ResultMacroResourceBindings.Err diag)])))

(define (macro-expand-resource-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]
  [out : (&mut out ast.AstResourceBindingList)]) : ResultMacroResourceBindingsBuild
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (ResultMacroResourceBindingsBuild.Ok env)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name init-box cleanup-box move-aware?)
        (match (macro-expand-node ctx env decls depth init-box)
          [(ResultMacroExpr.Ok ninit)
            (match (macro-expand-node ctx env decls depth cleanup-box)
              [(ResultMacroExpr.Ok ncleanup)
                (let
                  [binding : ast.AstResourceBinding
                    (ast.AstResourceBinding.Binding
                      name
                      ninit
                      ncleanup
                      move-aware?)]
                  [single : ast.AstResourceBindingList
                    (ast.ast-resource-binding-cons
                      binding
                      (ast.ast-resource-binding-list-new))]
                  (match (tc-resource-bindings ctx env single)
                    [(ResultTcEnv.Ok next-env)
                      (begin
                        (ast.ast-resource-binding-list-push out binding)
                        (macro-expand-resource-bindings-into
                          ctx
                          next-env
                          decls
                          depth
                          bindings
                          (+ index 1)
                          out))]
                    [(ResultTcEnv.Err message)
                      (ResultMacroResourceBindingsBuild.Err
                        (box
                          (tc-expr-diag (tc-context-expr-get ctx ninit) message)))]))]
              [(ResultMacroExpr.Err diag)
                (ResultMacroResourceBindingsBuild.Err diag)])]
          [(ResultMacroExpr.Err diag)
            (ResultMacroResourceBindingsBuild.Err diag)])])))

(define (macro-compat-unit-expr) : i64
  (ast.ast-node-push (ast.AstExpr.Literal ast.AstLiteral.Unit)))

(define (macro-compat-append-unit [exprs : ast.AstExprList]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity (+ exprs.len 1))]
    (begin
      (ast.ast-expr-list-append-from (&mut out) (& exprs) 0)
      (ast.ast-expr-list-push (&mut out) (macro-compat-unit-expr))
      out)))

(define (macro-compat-call-name [func : ast.AstExpr]) : TcMaybeString
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var name)
      (if (or
        (macro-hygiene-global-id? name)
        (tc-structural-local-name-id? name)
        (csym.compiler-composite-pair-key-id? name)
        (csym.compiler-composite-triple-key-id? name))
        (TcMaybeString.No)
        (TcMaybeString.Some (tc-env-key-name-text name)))]
    [_ (TcMaybeString.No)]))

(define (macro-compat-guard-message [name : String]) : String
  (if (string.eq name "unless")
    "parse: unless expects a condition and at least one body expression"
    "parse: when expects a condition and at least one body expression"))

(define (macro-expand-compat-guard-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [cond : ast.AstExpr]
  [body : ast.AstExprList]
  [is-unless : bool]) : ResultMacroCompatCall
  (match (macro-expand-expr ctx env decls depth cond)
    [(ResultMacroExpr.Ok ncond)
      (match (macro-expand-exprs ctx env decls depth body)
        [(ResultMacroExprList.Ok nbody)
          (let
            [unit-expr : i64 (macro-compat-unit-expr)]
            [body-expr : i64
              (ast.ast-node-push
                (ast.AstExpr.Begin (macro-compat-append-unit nbody)))]
            (if is-unless
              (ResultMacroCompatCall.Ok
                (ast.ast-expr-if ncond unit-expr body-expr))
              (ResultMacroCompatCall.Ok
                (ast.ast-expr-if ncond body-expr unit-expr))))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-expand-compat-guard-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [name : String]
  [args : ast.AstExprList]
  [is-unless : bool]
  [call-expr : ast.AstExpr]) : ResultMacroCompatCall
  (if (< args.len 2)
    (ResultMacroCompatCall.Err
      (box
        (ctfe_support.ctfe-diagnostic-at-expr
          call-expr
          (macro-compat-guard-message name))))
    (macro-expand-compat-guard-body
      ctx
      env
      decls
      depth
      (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))
      (ast.ast-expr-list-tail-from-ref (& args) 1)
      is-unless)))

(define (macro-expand-compat-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [call-expr : ast.AstExpr]) : ResultMacroCompatCall
  (match (macro-compat-call-name func)
    [(TcMaybeString.Some name)
      (if (string.eq name "when")
        (macro-expand-compat-guard-call
          ctx
          env
          decls
          depth
          name
          args
          false
          call-expr)
        (if (string.eq name "unless")
          (macro-expand-compat-guard-call
            ctx
            env
            decls
            depth
            name
            args
            true
            call-expr)
          (ResultMacroCompatCall.No)))]
    [(TcMaybeString.No) (ResultMacroCompatCall.No)]))

(define (macro-expand-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  ;; Value entry: for callers that hold only an expression value (synthesized
  ;; or unspanned forms). The no-fire arm must allocate a node for the value.
  (begin
    (cfg compile-profile (compiler-tc-walk-note-expand-visit!))
    (let
      [fires : bool
        (macro-expr-might-fire?
          (tc-context-macro-state ctx)
          (tc-context-expr-bases ctx)
          expr)]
      (if (or (not fires) (< (macro-expand-depth-limit) depth))
        (if (not fires)
          (ResultMacroExpr.Ok (ast.ast-node-push expr))
          (ResultMacroExpr.Err
            (box
              (ctfe_support.ctfe-diagnostic-at-expr
                expr
                "macro expansion exceeded depth limit"))))
        (macro-expand-expr-fire ctx env decls depth expr)))))

;; Node entry: walk recursion goes through here so a subtree in which no
;; macro can fire is shared into the output by its original node id instead
;; of being re-pushed. The original program is a strict tree, and the
;; existing no-fire push was already shallow (children stayed shared), so
;; identity-sharing the top node keeps the same output structure without
;; the copy.
(define (macro-expand-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr-id : i64]) : ResultMacroExpr
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    [fires : bool
      (macro-expr-might-fire?
        (tc-context-macro-state ctx)
        (tc-context-expr-bases ctx)
        expr)]
    (macro-expand-node-with-fire-decision
      ctx
      env
      decls
      depth
      expr-id
      expr
      fires)))

;; One subtree scan per visit: the no-fire majority used to pay the scan
;; twice (once in the branch condition, once to pick the no-fire arm).
(define (macro-expand-expr-fire
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [depth : i64]
  [expr : ast.AstExpr]) : ResultMacroExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-spanned ninner span))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.MacroExpansion inner-box provenance-id macro-name-id)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok
            (ast.ast-expr-macro-expansion ninner provenance-id macro-name-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
        [callee-maybe-macro : bool
          (macro-call-callee-maybe-macro? (tc-context-macro-state ctx) func)]
        (if callee-maybe-macro
          (match (macro-call-decl ctx func decls expr)
            [(ResultMacroCallDecl.Ok maybe-decl)
              (match maybe-decl
                [(MacroMaybeDecl.Some
                    macro-name
                    definition-module
                    declaration-id
                    params
                    ret
                    body)
                  (begin
                    (tc-macro-call-site-note!
                      ctx
                      func
                      macro-name
                      definition-module
                      declaration-id)
                    (macro-expand-call
                      ctx
                      env
                      decls
                      macro-name
                      declaration-id
                      (macro-decl-name-display macro-name definition-module)
                      (macro-decl-module-display definition-module)
                      definition-module
                      params
                      ret
                      body
                      args
                      depth
                      expr))]
                [(MacroMaybeDecl.No)
                  (match (macro-expand-compat-call
                    ctx
                    env
                    decls
                    depth
                    func
                    args
                    expr)
                    [(ResultMacroCompatCall.Ok expanded)
                      (ResultMacroExpr.Ok expanded)]
                    [(ResultMacroCompatCall.No)
                      (match (macro-expand-node ctx env decls depth func-box)
                        [(ResultMacroExpr.Ok nfunc)
                          (match (macro-expand-exprs ctx env decls depth args)
                            [(ResultMacroExprList.Ok nargs)
                              (ResultMacroExpr.Ok
                                (ast.ast-expr-call nfunc nargs))]
                            [(ResultMacroExprList.Err diag)
                              (ResultMacroExpr.Err diag)])]
                        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultMacroCompatCall.Err diag)
                      (ResultMacroExpr.Err diag)])])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroExpr.Err diag)])
          (match (macro-expand-node ctx env decls depth func-box)
            [(ResultMacroExpr.Ok nfunc)
              (match (macro-expand-exprs ctx env decls depth args)
                [(ResultMacroExprList.Ok nargs)
                  (ResultMacroExpr.Ok (ast.ast-expr-call nfunc nargs))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])))]
    [(ast.AstExpr.BracketClause items)
      (match (macro-expand-exprs ctx env decls depth items)
        [(ResultMacroExprList.Ok nitems)
          (ResultMacroExpr.Ok (ast.ast-expr-bracket-clause nitems))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Binary op left-box right-box)
      (match (macro-expand-node ctx env decls depth left-box)
        [(ResultMacroExpr.Ok nleft)
          (match (macro-expand-node ctx env decls depth right-box)
            [(ResultMacroExpr.Ok nright)
              (ResultMacroExpr.Ok (ast.ast-expr-binary op nleft nright))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Unary op inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-unary op ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (match (macro-expand-node ctx env decls depth cond-box)
        [(ResultMacroExpr.Ok ncond)
          (match (macro-expand-node ctx env decls depth then-branch-box)
            [(ResultMacroExpr.Ok nthen)
              (match (macro-expand-node ctx env decls depth else-branch-box)
                [(ResultMacroExpr.Ok nelse)
                  (ResultMacroExpr.Ok (ast.ast-expr-if ncond nthen nelse))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (match (macro-expand-bindings ctx env decls depth bindings)
            [(ResultMacroLetBindings.Ok nbindings body-env)
              (match (macro-expand-node ctx body-env decls depth body-box)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast.ast-expr-let nbindings nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroLetBindings.Err diag) (ResultMacroExpr.Err diag)])])]
    [(ast.AstExpr.Begin exprs)
      (match (macro-expand-exprs ctx env decls depth exprs)
        [(ResultMacroExprList.Ok nexprs)
          (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.Begin nexprs)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Unsafe exprs)
      ;; Expansion typechecks some sub-expressions (e.g. `match` scrutinees) via
      ;; `tc-expr`; descend with the unsafe marker set so those checks see the
      ;; enclosing `unsafe` context, matching the real typecheck pass. Without
      ;; this, an `unsafe`-only primitive under an `(unsafe ...)` reachable here
      ;; is wrongly rejected once the program defines a macro.
      (match (macro-expand-exprs ctx (tc-enter-unsafe env) decls depth exprs)
        [(ResultMacroExprList.Ok nexprs)
          (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.Unsafe nexprs)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Tuple exprs)
      (match (macro-expand-exprs ctx env decls depth exprs)
        [(ResultMacroExprList.Ok nexprs)
          (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.Tuple nexprs)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Array exprs)
      (match (macro-expand-exprs ctx env decls depth exprs)
        [(ResultMacroExprList.Ok nexprs)
          (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.Array nexprs)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.DynArray exprs)
      (match (macro-expand-exprs ctx env decls depth exprs)
        [(ResultMacroExprList.Ok nexprs)
          (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.DynArray nexprs)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.MakeArray ty-id len-box)
      (match (macro-expand-node ctx env decls depth len-box)
        [(ResultMacroExpr.Ok nlen)
          (ResultMacroExpr.Ok (ast.ast-expr-make-array-id ty-id nlen))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (let
            [first-fire-index : i64
              (macro-match-arms-first-fire-index
                (tc-context-macro-state ctx)
                (tc-context-expr-bases ctx)
                arms)]
            (match (macro-expand-node ctx env decls depth scrut-box)
              [(ResultMacroExpr.Ok nscrut)
                (if (< first-fire-index 0)
                  (ResultMacroExpr.Ok (ast.ast-expr-match nscrut arms))
                  (begin
                    (cfg compile-profile (compiler-tc-walk-scrut-tc-start!))
                    (let
                      [scrut-ty-result : ResultTcType
                        (tc-expr ctx env (tc-context-expr-get ctx nscrut))]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-walk-scrut-tc-finish!))
                        (match scrut-ty-result
                          [(ResultTcType.Ok scrut-ty)
                            (match (macro-expand-arms
                              ctx
                              env
                              decls
                              depth
                              scrut-ty
                              first-fire-index
                              arms)
                              [(ResultMacroArms.Ok narms)
                                (ResultMacroExpr.Ok
                                  (ast.ast-expr-match nscrut narms))]
                              [(ResultMacroArms.Err diag)
                                (ResultMacroExpr.Err diag)])]
                          [(ResultTcType.Err message)
                            (ResultMacroExpr.Err
                              (box
                                (tc-expr-diag
                                  (tc-context-expr-get ctx nscrut)
                                  message)))])))))]
              [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
    [(ast.AstExpr.While cond-box body-box)
      (match (macro-expand-node ctx env decls depth cond-box)
        [(ResultMacroExpr.Ok ncond)
          (match (macro-expand-node ctx env decls depth body-box)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroExpr.Ok (ast.ast-expr-while ncond nbody))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source : i64 (ast.ast-for-owned-state-source (& payload))]
        [body : i64 (ast.ast-for-owned-state-body (& payload))]
        (match (macro-expand-node ctx env decls depth source)
          [(ResultMacroExpr.Ok nsource)
            (match (tc-expr-id ctx env nsource)
              [(ResultTcType.Ok source-ty)
                (let
                  [source-name-id : i64
                    (tc-for-owned-name-id
                      (tc-context-expr-bases ctx)
                      source-name)]
                  [index-name-id : i64
                    (tc-for-owned-name-id
                      (tc-context-expr-bases ctx)
                      index-name)]
                  [body-env : TcTypeEnv
                    (if (or (< source-name-id 0) (< index-name-id 0))
                      env
                      (tc-bind-id
                        (tc-bind-id env source-name-id source-ty)
                        index-name-id
                        (ast.AstType.I64)))]
                  (match (macro-expand-node ctx body-env decls depth body)
                    [(ResultMacroExpr.Ok nbody)
                      (ResultMacroExpr.Ok
                        (ast.ast-expr-for-owned-state
                          source-name
                          index-name
                          nsource
                          nbody))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
              [(ResultTcType.Err message)
                (ResultMacroExpr.Err
                  (box (tc-expr-diag (tc-context-expr-get ctx nsource) message)))])]
          [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name-id : i64
          (tc-for-owned-name-id (tc-context-expr-bases ctx) binding-name)]
        (match (tc-expr-id ctx env source-name)
          [(ResultTcType.Ok source-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
              [(ast.AstType.Array elem-id _)
                (let
                  [body-env : TcTypeEnv
                    (if (< binding-name-id 0)
                      env
                      (tc-bind-id
                        env
                        binding-name-id
                        (tc-context-type-get ctx elem-id)))]
                  (match (if (>= expected-type 0)
                    (macro-expand-node ctx env decls depth expected-type)
                    (ResultMacroExpr.Ok -1))
                    [(ResultMacroExpr.Ok nexpected)
                      (match (macro-expand-node ctx body-env decls depth body)
                        [(ResultMacroExpr.Ok nbody)
                          (ResultMacroExpr.Ok
                            (ast.ast-expr-for-owned-step
                              source-name
                              index-name
                              binding-name
                              nexpected
                              done-name
                              nbody))]
                        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
              [_
                (ResultMacroExpr.Err
                  (box
                    (tc-expr-diag
                      (tc-context-expr-get ctx source-name)
                      "typecheck: scalar for owned step requires fixed-array state")))])]
          [(ResultTcType.Err message)
            (ResultMacroExpr.Err
              (box (tc-expr-diag (tc-context-expr-get ctx source-name) message)))]))]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach index index-ty start-box end-box body-box)
          (match (macro-expand-node ctx env decls depth start-box)
            [(ResultMacroExpr.Ok nstart)
              (match (macro-expand-node ctx env decls depth end-box)
                [(ResultMacroExpr.Ok nend)
                  (match (macro-expand-node
                    ctx
                    (tc-bind-id env index (tc-resolve-type ctx index-ty))
                    decls
                    depth
                    body-box)
                    [(ResultMacroExpr.Ok nbody)
                      (ResultMacroExpr.Ok
                        (ast.ast-expr-foreach-id
                          index
                          index-ty
                          nstart
                          nend
                          nbody))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (match (macro-expand-node
            ctx
            (match maybe-ret
              [(ast.AstMaybeType.Some ret)
                (tc-bind-return-type
                  (tc-bind-params ctx env params)
                  (tc-resolve-type ctx ret))]
              [(ast.AstMaybeType.No)
                (tc-bind-return-type
                  (tc-bind-params ctx env params)
                  (ast.AstType.Never))])
            decls
            depth
            body-box)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroExpr.Ok (ast.ast-expr-lambda params maybe-ret nbody))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])])]
    [(ast.AstExpr.Ann inner-box ty-id)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-ann-id ninner ty-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Cast inner-box ty-id)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-cast-id ninner ty-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Borrow mutable lifetime-id place-box)
      (match (macro-expand-node ctx env decls depth place-box)
        [(ResultMacroExpr.Ok nplace)
          (ResultMacroExpr.Ok
            (ast.ast-expr-borrow-id mutable lifetime-id nplace))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.StructGet inner-box field)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-struct-get-id ninner field))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.StructSet inner-box field value-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (match (macro-expand-node ctx env decls depth value-box)
            [(ResultMacroExpr.Ok nvalue)
              (ResultMacroExpr.Ok
                (ast.ast-expr-struct-set-id ninner field nvalue))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.WithRegion region body)
      (match (macro-expand-exprs
        ctx
        (tc-push-region env region)
        decls
        depth
        body)
        [(ResultMacroExprList.Ok nbody)
          (ResultMacroExpr.Ok
            (ast.ast-node-push (ast.AstExpr.WithRegion region nbody)))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.WithEscape scratch-box body)
      (match (macro-expand-node ctx env decls depth scratch-box)
        [(ResultMacroExpr.Ok nscratch)
          (match (macro-expand-exprs ctx env decls depth body)
            [(ResultMacroExprList.Ok nbody)
              (ResultMacroExpr.Ok (ast.ast-expr-with-escape nscratch nbody))]
            [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.WithScratch body)
      (match (macro-expand-exprs ctx env decls depth body)
        [(ResultMacroExprList.Ok nbody)
          (ResultMacroExpr.Ok (ast.ast-expr-with-scratch nbody))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.InArena arena-box body)
      (match (macro-expand-node ctx env decls depth arena-box)
        [(ResultMacroExpr.Ok narena)
          (match (macro-expand-exprs ctx env decls depth body)
            [(ResultMacroExprList.Ok nbody)
              (ResultMacroExpr.Ok (ast.ast-expr-in-arena narena nbody))]
            [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (match (macro-expand-node ctx env decls depth array-box)
        [(ResultMacroExpr.Ok narray)
          (match (macro-expand-node ctx env decls depth index-box)
            [(ResultMacroExpr.Ok nindex)
              (ResultMacroExpr.Ok (ast.ast-expr-array-ref narray nindex))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (match (macro-expand-node ctx env decls depth array-box)
        [(ResultMacroExpr.Ok narray)
          (match (macro-expand-node ctx env decls depth index-box)
            [(ResultMacroExpr.Ok nindex)
              (match (macro-expand-node ctx env decls depth value-box)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok
                    (ast.ast-expr-array-set narray nindex nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (match (macro-expand-node ctx env decls depth array-box)
        [(ResultMacroExpr.Ok narray)
          (match (macro-expand-node ctx env decls depth live-box)
            [(ResultMacroExpr.Ok nlive)
              (match (macro-expand-node ctx env decls depth index-box)
                [(ResultMacroExpr.Ok nindex)
                  (ResultMacroExpr.Ok
                    (ast.ast-expr-array-take narray nlive nindex))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (match (macro-expand-node ctx env decls depth array-box)
        [(ResultMacroExpr.Ok narray)
          (match (macro-expand-node ctx env decls depth index-box)
            [(ResultMacroExpr.Ok nindex)
              (ResultMacroExpr.Ok (ast.ast-expr-fixed-array-take narray nindex))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Replace place-box replacement-box)
      (match (macro-expand-node ctx env decls depth place-box)
        [(ResultMacroExpr.Ok nplace)
          (match (macro-expand-node ctx env decls depth replacement-box)
            [(ResultMacroExpr.Ok nreplacement)
              (ResultMacroExpr.Ok (ast.ast-expr-replace nplace nreplacement))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (match (macro-expand-resource-bindings ctx env decls depth bindings)
            [(ResultMacroResourceBindings.Ok nbindings body-env)
              (match (macro-expand-exprs ctx body-env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok
                    (ast.ast-node-push
                      (ast.AstExpr.WithResource
                        (box (ast.AstWithResource.WithResource nbindings nbody)))))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroResourceBindings.Err diag) (ResultMacroExpr.Err diag)])])]
    [(ast.AstExpr.Box inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-box ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.BoxGet inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-box-get ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.BoxTake inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-box-take ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (match (macro-expand-node ctx env decls depth value-box)
            [(ResultMacroExpr.Ok nvalue)
              (ResultMacroExpr.Ok (ast.ast-expr-box-set ninner nvalue))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Comptime inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-comptime ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Return inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-return ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Set name rhs-box)
      (match (macro-expand-node ctx env decls depth rhs-box)
        [(ResultMacroExpr.Ok nrhs)
          (ResultMacroExpr.Ok (ast.ast-expr-set-id name nrhs))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.StringData inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-string-data ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (match (macro-expand-node ctx env decls depth len-box)
            [(ResultMacroExpr.Ok nlen)
              (ResultMacroExpr.Ok (ast.ast-expr-string-from-bytes nptr nlen))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.ArrayData inner-box)
      (match (macro-expand-node ctx env decls depth inner-box)
        [(ResultMacroExpr.Ok ninner)
          (ResultMacroExpr.Ok (ast.ast-expr-array-data ninner))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrNullCheck ptr-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (ResultMacroExpr.Ok (ast.ast-expr-ptr-null-check nptr))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrAddrOf place-box)
      (match (macro-expand-node ctx env decls depth place-box)
        [(ResultMacroExpr.Ok nplace)
          (ResultMacroExpr.Ok (ast.ast-expr-ptr-addr-of-id nplace))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrRead ptr-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (ResultMacroExpr.Ok (ast.ast-expr-ptr-read nptr))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (match (macro-expand-node ctx env decls depth value-box)
            [(ResultMacroExpr.Ok nvalue)
              (ResultMacroExpr.Ok (ast.ast-expr-ptr-write nptr nvalue))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (match (macro-expand-node ctx env decls depth offset-box)
            [(ResultMacroExpr.Ok noffset)
              (ResultMacroExpr.Ok (ast.ast-expr-ptr-offset nptr noffset))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrCast ptr-box ty-id)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (ResultMacroExpr.Ok (ast.ast-expr-ptr-cast-id nptr ty-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.PtrToInt ptr-box)
      (match (macro-expand-node ctx env decls depth ptr-box)
        [(ResultMacroExpr.Ok nptr)
          (ResultMacroExpr.Ok (ast.ast-expr-ptr-to-int nptr))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.IntToPtr value-box ty-id)
      (match (macro-expand-node ctx env decls depth value-box)
        [(ResultMacroExpr.Ok nvalue)
          (ResultMacroExpr.Ok (ast.ast-expr-int-to-ptr-id nvalue ty-id))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.BinaryData bytes)
      (ResultMacroExpr.Ok (ast.ast-node-push (ast.AstExpr.BinaryData bytes)))]
    [(ast.AstExpr.SpmdProgramIndex)
      (ResultMacroExpr.Ok (ast.ast-expr-spmd-program-index))]
    [(ast.AstExpr.SpmdProgramCount)
      (ResultMacroExpr.Ok (ast.ast-expr-spmd-program-count))]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (match (macro-expand-node ctx env decls depth leaf-box)
        [(ResultMacroExpr.Ok nleaf)
          (match (macro-expand-node ctx env decls depth subleaf-box)
            [(ResultMacroExpr.Ok nsubleaf)
              (ResultMacroExpr.Ok (ast.ast-expr-cpuid-eax nleaf nsubleaf))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (match (macro-expand-node ctx env decls depth leaf-box)
        [(ResultMacroExpr.Ok nleaf)
          (match (macro-expand-node ctx env decls depth subleaf-box)
            [(ResultMacroExpr.Ok nsubleaf)
              (ResultMacroExpr.Ok (ast.ast-expr-cpuid-ebx nleaf nsubleaf))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (match (macro-expand-node ctx env decls depth leaf-box)
        [(ResultMacroExpr.Ok nleaf)
          (match (macro-expand-node ctx env decls depth subleaf-box)
            [(ResultMacroExpr.Ok nsubleaf)
              (ResultMacroExpr.Ok (ast.ast-expr-cpuid-ecx nleaf nsubleaf))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (match (macro-expand-node ctx env decls depth leaf-box)
        [(ResultMacroExpr.Ok nleaf)
          (match (macro-expand-node ctx env decls depth subleaf-box)
            [(ResultMacroExpr.Ok nsubleaf)
              (ResultMacroExpr.Ok (ast.ast-expr-cpuid-edx nleaf nsubleaf))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Xgetbv index-box)
      (match (macro-expand-node ctx env decls depth index-box)
        [(ResultMacroExpr.Ok nindex)
          (ResultMacroExpr.Ok (ast.ast-expr-xgetbv nindex))]
        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
    [(ast.AstExpr.Syscall args)
      (match (macro-expand-exprs ctx env decls depth args)
        [(ResultMacroExprList.Ok nargs)
          (ResultMacroExpr.Ok (ast.ast-expr-syscall nargs))]
        [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
    [_ (ResultMacroExpr.Ok (ast.ast-node-push expr))]))

(define (macro-expand-module-call-position
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [call-id : i64]
  [import-position : bool]) : ResultMacroDecl
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast.ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(ast.AstExpr.Call func-box _)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          (match (macro-call-decl ctx func decls call-expr)
            [(ResultMacroCallDecl.Ok maybe-decl)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ _ ret _)
                  (cond
                    [(and import-position (tc-macro-result-module? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro expansion is not implemented yet")))]
                    [(and import-position (tc-macro-result-decls? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro cannot be used in import position")))]
                    [import-position
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used as module import")))]
                    [(tc-macro-result-decls? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro expansion is not implemented yet")))]
                    [(tc-macro-result-module? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro can only be used in import position")))]
                    [else
                      (ResultMacroDecl.Err
                        (box
                          (ctfe_support.ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used at module scope")))])]
                [(MacroMaybeDecl.No)
                  (ResultMacroDecl.Err
                    (box
                      (ctfe_support.ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: module-scope macro call must resolve to defmacro")))])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_
        (ResultMacroDecl.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [decl : ast.AstDecl]) : ResultMacroDecl
  (let
    [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
    (match decl
      [(ast.AstDecl.Def decl-meta name maybe-ty expr-box)
        (match (macro-expand-node ctx global-env decls 0 expr-box)
          [(ResultMacroExpr.Ok nexpr)
            (ResultMacroDecl.Ok (ast.ast-decl-def-id name maybe-ty nexpr))]
          [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)])]
      [(ast.AstDecl.DefFn decl-meta name params ret body-box metadata)
        (let
          [params-env : TcTypeEnv (tc-bind-params ctx global-env params)]
          [resolved-ret : ast.AstType (tc-resolve-type ctx ret)]
          [body-env : TcTypeEnv (tc-bind-return-type params-env resolved-ret)]
          (match (macro-expand-node ctx body-env decls 0 body-box)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroDecl.Ok
                (ast.ast-decl-def-fn-metadata-id name params ret nbody metadata))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(ast.AstDecl.Test _ _ _) (ResultMacroDecl.Ok decl)]
      [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind _ _ _ _))
        (match kind
          [(ast.AstImportKind.Macro call-id _)
            (macro-expand-module-call-position ctx decls call-id true)]
          [(ast.AstImportKind.MacroDecls call-id _)
            (macro-expand-module-call-position ctx decls call-id false)]
          [_ (ResultMacroDecl.Ok decl)])]
      [(ast.AstDecl.Unsafe inner-box)
        (let
          [inner : ast.AstDecl (__tl-box-place inner-box)]
          (match (macro-expand-decl ctx top-env decls inner)
            [(ResultMacroDecl.Ok ninner)
              (ResultMacroDecl.Ok (ast.ast-decl-unsafe ninner))]
            [(ResultMacroDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_ (ResultMacroDecl.Ok decl)])))

(define (macro-single-decl-expansion
  [state : TcMacroState]
  [decl : ast.AstDecl]
  [path : String]) : ResultMacroDeclExpansion
  (ResultMacroDeclExpansion.Ok
    (ast.ast-decl-cons decl (ast.ast-decl-list-new))
    (macro-paths-for-decls
      state
      (ast.ast-decl-cons decl (ast.ast-decl-list-new))
      path)))

(define (tc-macro-module-env-cache-storage-ensure! [state : TcMacroState]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (if (= (array-length data.macro-cache-module-ids) data.macro-cache-capacity)
      unit
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (begin
            (set!
              data.macro-cache-module-ids
              (array.make-array i64 data.macro-cache-capacity))
            (set!
              data.macro-cache-values
              (array.make-array TcTypeEnv data.macro-cache-capacity))
            (tc-macro-module-env-state-data-set! state data)))))))

(define (tc-macro-module-env-cache-lookup
  [state : TcMacroState]
  [module-id : i64]
  [index : i64]) : TcMaybeTypeEnv
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (if (>= index data.macro-cache-len)
      (TcMaybeTypeEnv.No)
      (if (= (array-ref data.macro-cache-module-ids index) module-id)
        (TcMaybeTypeEnv.Some (array-ref data.macro-cache-values index))
        (tc-macro-module-env-cache-lookup state module-id (+ index 1))))))

(define (tc-macro-module-env-cache-insert!
  [state : TcMacroState]
  [module-id : i64]
  [env : TcTypeEnv]) : unit
  (let
    [_ensure : unit (tc-macro-module-env-cache-storage-ensure! state)]
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (if (< data.macro-cache-len data.macro-cache-capacity)
      (begin
        (set!
          (array-ref data.macro-cache-module-ids data.macro-cache-len)
          module-id)
        (set! (array-ref data.macro-cache-values data.macro-cache-len) env)
        (set! data.macro-cache-len (+ data.macro-cache-len 1))
        (tc-macro-module-env-state-data-set! state data))
      unit)))

(define (tc-macro-module-local-env-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [store-handle : i64 top-env.store]
    [head : i64 top-env.head]
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (if (and
        (= data.macro-cache-store store-handle)
        (= data.macro-cache-head head))
        unit
        (begin
          (set! data.macro-cache-store store-handle)
          (set! data.macro-cache-head head)
          (set! data.macro-cache-len 0)
          (tc-macro-module-env-state-data-set! state data)))
      (match (tc-macro-module-env-cache-lookup state module-id 0)
        [(TcMaybeTypeEnv.Some env) (ResultTcEnv.Ok env)]
        [(TcMaybeTypeEnv.No)
          ;; The persistent environment store allocates appended nodes in the
          ;; top environment's owner arena. Do not switch the ambient
          ;; macro-generation arena here: doing so breaks the generation's
          ;; allocator bookkeeping.
          (match (tc-module-local-env-id ctx top-env module module-id)
            [(ResultTcEnv.Ok env)
              (begin
                (tc-macro-module-env-cache-insert! state module-id env)
                (ResultTcEnv.Ok env))]
            [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]))))

(define (macro-env-for-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (ResultTcEnv.Ok top-env)
    (tc-macro-module-local-env-id ctx top-env module module-id)))

(define (macro-module-import-marker-decls
  [target-module : String]
  [target-module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]) : ast.AstDeclList
  (let
    [binding-alias : ast.AstMaybeImportAlias
      (match alias
        [(ast.AstMaybeImportAlias.No)
          (ast.AstMaybeImportAlias.Some cbi.compiler-builtin-id-fix-empty)]
        [_ alias])]
    (ast.ast-decl-cons
      (ast.AstDecl.Import
        (ast.ast-decl-meta-runtime-shared-view)
        (ast.AstImportSpec.Spec
          (ast.AstImportKind.Module)
          target-module
          (ast.AstMaybeModuleName.Some target-module-id)
          binding-alias
          (box span)))
      (ast.ast-decl-list-new))))

(define (macro-module-import-marker-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(ast.AstImportKind.Module) true]
        [_ false])]
    [_ false]))

(define (macro-module-import-marker-only? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Cons decl rest)
      (if (macro-module-import-marker-decl? decl)
        (match (ast.ast-decl-list-step rest)
          [(ast.AstDeclListStep.Nil) true]
          [_ false])
        false)]
    [(ast.AstDeclListStep.Nil) false]))

(define (macro-extend-top-env-with-module-marker
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [_module : String]
  [module-id : i64]) : ResultTcEnv
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Cons decl _)
      (match decl
        [(ast.AstDecl.Import
            decl-meta
            (ast.AstImportSpec.Spec
              _
              _
              (ast.AstMaybeModuleName.Some target-module)
              (ast.AstMaybeImportAlias.Some alias)
              _))
          (if (= alias cbi.compiler-builtin-id-fix-empty)
            (if (macro-segmented-program-active? (tc-context-job-state ctx))
              (macro-segmented-bind-import-alias-module
                ctx
                top-env
                target-module
                cbi.compiler-builtin-id-fix-empty
                module-id
                true)
              (tc-bind-import-alias-module
                ctx
                all-decls
                top-env
                target-module
                cbi.compiler-builtin-id-fix-empty
                module-id
                true))
            (begin
              (tc-lazy-import-stub-record-for-job!
                (tc-context-job-state ctx)
                module-id
                (csym.compiler-symbols-import-alias-key-id module-id alias)
                target-module
                false)
              (ResultTcEnv.Ok top-env)))]
        [_ (ResultTcEnv.Ok top-env)])]
    [(ast.AstDeclListStep.Nil) (ResultTcEnv.Ok top-env)]))

(define (macro-existing-module-import-target
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]) : TcMaybeNameId
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast.ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(ast.AstExpr.Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok
                maybe-decl
                call-module
                call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      _)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-module? ret)
                        (match (macro-expand-exprs
                          call-ctx
                          global-env
                          orig-decls
                          0
                          args)
                          [(ResultMacroExprList.Ok expanded-args)
                            (match (macro-module-identity
                              call-ctx
                              orig-decls
                              call-module
                              call-module-id
                              (macro-decl-name-display
                                macro-name
                                definition-module)
                              (macro-decl-module-display definition-module)
                              params
                              expanded-args
                              (tc-ctfe-env call-ctx)
                              call-expr)
                              [(spec.ResultGenKey.Ok identity _)
                                (macro-find-generated-identity-module
                                  orig-decls
                                  identity)]
                              [(spec.ResultGenKey.Err _) (TcMaybeNameId.No)])]
                          [(ResultMacroExprList.Err _) (TcMaybeNameId.No)])
                        (TcMaybeNameId.No)))]
                  [(MacroMaybeDecl.No) (TcMaybeNameId.No)]))]
            [(ResultMacroCallDeclModule.Err _) (TcMaybeNameId.No)]))]
      [_ (TcMaybeNameId.No)])))

(define (macro-collapse-existing-module-import-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [site-state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [previous-active : TcMacroCallSiteActiveDecl
      (tc-macro-call-site-state-active-decl site-state)]
    [_set-active : unit
      (tc-macro-call-site-state-set-active-decl!
        site-state
        decl-path
        (ast.ast-decl-generated-meta decl))]
    [_definition-path : unit
      (macro-definition-path-note-decl! ctx module-id decl decl-path)]
    [result : ResultMacroDeclExpansion
      (match decl
        [(ast.AstDecl.Import
            decl-meta
            (ast.AstImportSpec.Spec kind _ _ alias span))
          (match kind
            [(ast.AstImportKind.Macro call-id context)
              (match (macro-existing-module-import-target
                ctx
                top-env
                orig-decls
                module
                module-id
                call-id
                context)
                [(TcMaybeNameId.Some target-module-id)
                  (let
                    [target-module : String
                      (tc-env-key-name-text target-module-id)]
                    [expanded : ast.AstDeclList
                      (macro-module-import-marker-decls
                        target-module
                        target-module-id
                        alias
                        (__tl-box-place span))]
                    (ResultMacroDeclExpansion.Ok
                      expanded
                      (macro-paths-for-decls
                        (tc-context-macro-state ctx)
                        expanded
                        decl-path)))]
                [(TcMaybeNameId.No)
                  (macro-single-decl-expansion
                    (tc-context-macro-state ctx)
                    decl
                    decl-path)])]
            [_
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)])]
        [_
          (macro-single-decl-expansion
            (tc-context-macro-state ctx)
            decl
            decl-path)])]
    (begin
      (tc-macro-call-site-state-restore-active-decl! site-state previous-active)
      result)))

(define (macro-collapse-existing-module-imports
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : ast.AstDeclList]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil)
      (ResultMacroDeclExpansion.Ok
        (ast.ast-decl-list-new)
        (ast.ast-decl-path-list-new))]
    [(ast.AstDeclListStep.Cons decl rest-box)
      (match (macro-collapse-existing-module-import-decl
        ctx
        top-env
        orig-decls
        module
        module-id
        decl
        decl-path)
        [(ResultMacroDeclExpansion.Ok head-decls head-paths)
          (match (macro-collapse-existing-module-imports
            ctx
            top-env
            orig-decls
            module
            module-id
            rest-box
            decl-path)
            [(ResultMacroDeclExpansion.Ok rest-decls rest-paths)
              (ResultMacroDeclExpansion.Ok
                (macro-decl-list-append head-decls rest-decls)
                (macro-decl-path-list-append head-paths rest-paths))]
            [(ResultMacroDeclExpansion.Err diag)
              (ResultMacroDeclExpansion.Err diag)])]
        [(ResultMacroDeclExpansion.Err diag)
          (ResultMacroDeclExpansion.Err diag)])]))

(define (macro-collapse-existing-module-imports-or-original
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decls : ast.AstDeclList]
  [decl-path : String]) : ast.AstDeclList
  (match (macro-collapse-existing-module-imports
    ctx
    top-env
    orig-decls
    module
    module-id
    decls
    decl-path)
    [(ResultMacroDeclExpansion.Ok collapsed _) collapsed]
    [(ResultMacroDeclExpansion.Err _) decls]))

(define (macro-call-not-macro-message
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [name-id : i64]) : String
  (let
    [name : String (ci.intern-str name-id)]
    [default-message : String
      (str_cat.str-cat
        "typecheck: module-scope macro call does not name a macro: "
        name)]
    (match (tc-source-dotted-alias-target-id
      (tc-context-macro-state ctx)
      decls
      module-id
      name-id)
      [(TcMaybeNameId.Some target-module-id)
        (let
          [macro-name : String
            (parser.parse-ast-dotted-import-default-alias
              (tc-env-key-name-text target-module-id))]
          (str_cat.str-cat
            "typecheck: imported macro `"
            macro-name
            "` requires provider qualification; use `"
            name
            "."
            macro-name
            "`"))]
      [(TcMaybeNameId.No) default-message])))

(define (macro-call-not-macro-diag
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [call-expr : ast.AstExpr]) : cdiag.CompilerDiagnostic
  (ctfe_support.ctfe-diagnostic-at-expr
    call-expr
    (match (ast.ast-expr-unspan call-expr)
      [(ast.AstExpr.Call head-id _)
        (match (ast.ast-expr-unspan (tc-context-expr-get ctx head-id))
          [(ast.AstExpr.Var name-id)
            (macro-call-not-macro-message ctx decls module-id name-id)]
          [_ "typecheck: module-scope macro call has a non-symbol head"])]
      [_ "typecheck: module-scope macro placeholder is not a call"])))

(define (macro-module-incompatible-output-diag
  [call-expr : ast.AstExpr]
  [identity : String]) : cdiag.CompilerDiagnostic
  (ctfe_support.ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output for generated identity "
      identity
      " has incompatible payload")))

(define (macro-materialized-record-result
  [state : TcMacroState]
  [identity : String]
  [target-module-id : i64]
  [summary : ast.AstDeclList]
  [catalog : ast.AstDeclList]
  [generator : String]
  [import-path : String]
  [memoize? : bool]
  [result : ResultMacroDeclExpansion]) : ResultMacroDeclExpansion
  (begin
    (match result
      [(ResultMacroDeclExpansion.Ok _ _)
        (begin
          (if memoize?
            (begin
              ;; This full materialization is the behavior-preserving
              ;; validation lane for #4830: every catalog declaration remains
              ;; in the ordinary parent walk exactly once. Record the complete
              ;; module list separately from the mutable materialized summary.
              (macro-generated-module-memo-put!
                state
                identity
                target-module-id
                summary
                catalog
                generator
                import-path)
              (cfg
                compile-profile
                (compiler-tc-macro-profile-note-generated-module-catalog-build)))
            unit)
          (cfg
            compile-profile
            (compiler-tc-macro-profile-note-generated-module-materialization)))]
      [(ResultMacroDeclExpansion.Err _) unit])
    result))

(define (macro-expand-module-materialized
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [target-module : String]
  [target-module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [origin-path-id : i64]
  [identity : String]
  [memoize? : bool]
  [body-rest : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroDeclExpansion
  (let
    ;; A generated module always emits its FULL body. There is no surface
    ;; filter (closure filter + env/fs allow-list + whole-body drop);
    ;; the reachability gate (run after typecheck) keeps unused parts out of
    ;; codegen while every declaration is still fully typechecked.
    [generated-body-raw : ast.AstDeclList
      (macro-wrap-generated-decls
        body-rest
        macro-name
        identity
        decl-path
        origin-path-id
        span)]
    [generated-body : ast.AstDeclList
      (macro-collapse-existing-module-imports-or-original
        ctx
        top-env
        orig-decls
        target-module
        target-module-id
        generated-body-raw
        decl-path)]
    [materialized : ast.AstDeclList
      (ast.ast-decl-list-prepend-builder
        (ast.ast-decl-module-id target-module-id)
        generated-body)]
    (macro-materialized-record-result
      (tc-context-macro-state ctx)
      identity
      target-module-id
      materialized
      generated-body
      macro-name
      decl-path
      memoize?
      (match (macro-find-module-body-decls-in-context
        ctx
        orig-decls
        target-module)
        [(MacroMaybeDeclList.Some existing-body)
          (if (macro-decls-contain-generated-key? existing-body identity)
            ;: The module for this identity is already materialized and recorded in
            ;: the content-addressed memo. Compatible repeats are deduped without
            ;: re-expansion via the memo shortcut (plan P1). A syntax-param macro
            ;: (an `Expr`/clause parameter) can still reach here having produced a
            ;: body that differs from the recorded one even though the canonical
            ;: identity matches -- it switches on the argument's syntactic shape,
            ;: not its value, so `(gen "i64")` and `(gen (type-key (type i64)))`
            ;: collide on one identity with different payloads. Detect that
            ;: same-identity collision instead of silently reusing the recorded
            ;: body; a compatible re-materialization still binds via the replay
            ;: marker/alias import.
            (match (macro-generated-target-replay
              existing-body
              (macro-decls-filter-generated-key generated-body identity))
              [(MacroGeneratedTargetReplay.ReplayIncompatible)
                (ResultMacroDeclExpansion.Err
                  (box
                    (macro-module-incompatible-output-diag call-expr identity)))]
              [_
                (match (macro-check-generated-import-collisions
                  orig-decls
                  generated-body
                  module
                  alias
                  identity)
                  [CompilerNoString
                    (let
                      [expanded : ast.AstDeclList
                        (macro-module-replay-marker-decls
                          target-module
                          target-module-id
                          module-id
                          alias
                          span
                          generated-body
                          existing-body)]
                      (ResultMacroDeclExpansion.Ok
                        expanded
                        (macro-paths-for-decls
                          (tc-context-macro-state ctx)
                          expanded
                          decl-path)))]
                  [(CompilerSomeString message)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-generated-import-diag span message)))])])
            (let
              [generated-key-body : ast.AstDeclList
                (macro-decls-filter-generated-key generated-body identity)]
              (match (macro-generated-target-replay
                existing-body
                generated-key-body)
                [(MacroGeneratedTargetReplay.ReplayCompatible)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : ast.AstDeclList
                          (macro-module-replay-marker-decls
                            target-module
                            target-module-id
                            module-id
                            alias
                            span
                            generated-body
                            existing-body)]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls
                            (tc-context-macro-state ctx)
                            expanded
                            decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])]
                [(MacroGeneratedTargetReplay.ReplayAppendMissing)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : ast.AstDeclList
                          (macro-module-replay-marker-decls
                            target-module
                            target-module-id
                            module-id
                            alias
                            span
                            generated-body
                            existing-body)]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls
                            (tc-context-macro-state ctx)
                            expanded
                            decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])]
                [(MacroGeneratedTargetReplay.ReplayIncompatible)
                  (ResultMacroDeclExpansion.Err
                    (box
                      (macro-module-incompatible-output-diag call-expr identity)))]
                [(MacroGeneratedTargetReplay.NoReplay)
                  (match (macro-check-generated-import-collisions
                    orig-decls
                    generated-body
                    module
                    alias
                    identity)
                    [CompilerNoString
                      (let
                        [expanded : ast.AstDeclList
                          (macro-decl-list-append
                            materialized
                            (ast.ast-decl-list-prepend-builder
                              (ast.ast-decl-module-id module-id)
                              (macro-module-import-marker-decls
                                target-module
                                target-module-id
                                alias
                                span)))]
                        (ResultMacroDeclExpansion.Ok
                          expanded
                          (macro-paths-for-decls
                            (tc-context-macro-state ctx)
                            expanded
                            decl-path)))]
                    [(CompilerSomeString message)
                      (ResultMacroDeclExpansion.Err
                        (box (macro-generated-import-diag span message)))])])))]
        [(MacroMaybeDeclList.No)
          (match (macro-check-generated-import-collisions
            orig-decls
            generated-body
            module
            alias
            identity)
            [CompilerNoString
              (let
                [expanded : ast.AstDeclList
                  (macro-decl-list-append
                    materialized
                    (ast.ast-decl-list-prepend-builder
                      (ast.ast-decl-module-id module-id)
                      (macro-module-import-marker-decls
                        target-module
                        target-module-id
                        alias
                        span)))]
                (ResultMacroDeclExpansion.Ok
                  expanded
                  (macro-paths-for-decls
                    (tc-context-macro-state ctx)
                    expanded
                    decl-path)))]
            [(CompilerSomeString message)
              (ResultMacroDeclExpansion.Err
                (box (macro-generated-import-diag span message)))])]))))

(define (macro-expand-module-generated-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [origin-path-id : i64]
  [identity : String]
  [definition-module-id : i64]
  [macro-env : ctfe_support.CtfeEnv]
  [rewrite-imports? : bool]
  [memoize? : bool]
  [generated : ast.AstDeclList]
  [call-expr : ast.AstExpr]) : ResultMacroDeclExpansion
  (let
    [module-count : i64 (macro-decls-module-count generated)]
    (if (= module-count 0)
      (ResultMacroDeclExpansion.Err
        (box
          (ctfe_support.ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Module macro output must include a module declaration")))
      (if (> module-count 1)
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: Module macro output must include exactly one module declaration")))
        (match (ast.ast-decl-list-step generated)
          [(ast.AstDeclListStep.Cons first body-rest-box)
            (match first
              [(ast.AstDecl.ModuleBody target-module-id body-box)
                (match (ast.ast-decl-list-step body-rest-box)
                  [(ast.AstDeclListStep.Nil)
                    (let
                      [target-module : String
                        (tc-env-key-name-text target-module-id)]
                      [body-rest : ast.AstDeclList
                        (macro-flatten-module-body-decls-in-module
                          (__tl-box-place body-box)
                          target-module-id)]
                      [contextual-body : ast.AstDeclList
                        (macro-generated-context-decls
                          body-rest
                          definition-module-id)]
                      [final-body : ast.AstDeclList
                        (if rewrite-imports?
                          (let
                            [rewrite-decls : ast.AstDeclList
                              (ast.ast-decl-list-prepend-builder
                                (ast.ast-decl-module-id target-module-id)
                                contextual-body)]
                            [lookup-decls : ast.AstDeclList
                              (macro-decl-list-append orig-decls rewrite-decls)]
                            (macro-rewrite-generated-import-decls
                              (tc-context-with-module-id
                                ctx
                                target-module
                                target-module-id)
                              lookup-decls
                              target-module
                              target-module-id
                              definition-module-id
                              macro-env
                              contextual-body))
                          contextual-body)]
                      (macro-expand-module-materialized
                        ctx
                        top-env
                        orig-decls
                        module
                        module-id
                        target-module
                        target-module-id
                        alias
                        span
                        decl-path
                        macro-name
                        origin-path-id
                        identity
                        memoize?
                        final-body
                        call-expr))]
                  [_
                    (ResultMacroDeclExpansion.Err
                      (box
                        (ctfe_support.ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: Module macro output must include exactly one module declaration")))])]
              [(ast.AstDecl.Module target-module-id)
                (let
                  [target-module : String
                    (tc-env-key-name-text target-module-id)]
                  [body-rest : ast.AstDeclList
                    (macro-flatten-module-body-decls-in-module
                      body-rest-box
                      target-module-id)]
                  [contextual-body : ast.AstDeclList
                    (macro-generated-context-decls
                      body-rest
                      definition-module-id)]
                  [final-body : ast.AstDeclList
                    (if rewrite-imports?
                      (let
                        [rewrite-decls : ast.AstDeclList
                          (ast.ast-decl-list-prepend-builder
                            (ast.ast-decl-module-id target-module-id)
                            contextual-body)]
                        [lookup-decls : ast.AstDeclList
                          (macro-decl-list-append orig-decls rewrite-decls)]
                        (macro-rewrite-generated-import-decls
                          (tc-context-with-module-id
                            ctx
                            target-module
                            target-module-id)
                          lookup-decls
                          target-module
                          target-module-id
                          definition-module-id
                          macro-env
                          contextual-body))
                      contextual-body)]
                  (macro-expand-module-materialized
                    ctx
                    top-env
                    orig-decls
                    module
                    module-id
                    target-module
                    target-module-id
                    alias
                    span
                    decl-path
                    macro-name
                    origin-path-id
                    identity
                    memoize?
                    final-body
                    call-expr))]
              [_
                (ResultMacroDeclExpansion.Err
                  (box
                    (ctfe_support.ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro output must start with a module declaration")))])]
          [(ast.AstDeclListStep.Nil)
            (ResultMacroDeclExpansion.Err
              (box
                (ctfe_support.ctfe-diagnostic-at-expr
                  call-expr
                  "typecheck: Module macro output must include a module declaration")))])))))

(define (macro-expand-decls-splice
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast.ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(ast.AstExpr.Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok
                maybe-decl
                call-module
                call-module-id)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-decls? ret)
                        (match (macro-expand-exprs
                          call-ctx
                          global-env
                          orig-decls
                          0
                          args)
                          [(ResultMacroExprList.Ok expanded-args)
                            (match (macro-module-identity
                              call-ctx
                              orig-decls
                              call-module
                              call-module-id
                              (macro-decl-name-display
                                macro-name
                                definition-module)
                              (macro-decl-module-display definition-module)
                              params
                              expanded-args
                              (tc-ctfe-env call-ctx)
                              call-expr)
                              [(spec.ResultGenKey.Ok identity _)
                                (macro-decl-expansion-with-frame
                                  call-ctx
                                  decl-path
                                  call-expr
                                  (macro-decl-name-display
                                    macro-name
                                    definition-module)
                                  (match (macro-eval-transformer-expanded-with-env
                                    call-ctx
                                    orig-decls
                                    (macro-decl-module-display
                                      definition-module)
                                    definition-module
                                    global-env
                                    macro-name
                                    declaration-id
                                    (macro-decl-name-display
                                      macro-name
                                      definition-module)
                                    params
                                    ret
                                    body
                                    expanded-args
                                    call-expr)
                                    [(ResultMacroValueEnv.Ok value macro-env)
                                      (let
                                        [parse-dispatch : sym_i64_env.SymI64Env
                                          (parser.compiler-parse-dispatch-env)]
                                        (match (macro-decls-from-ctfe-value
                                          (macro-hygiene-ctfe-output
                                            (tc-context-macro-state call-ctx)
                                            (ctfe_support.ctfe-env-syntax-pool-context
                                              macro-env)
                                            value
                                            (MacroHygieneContext
                                              macro-name
                                              definition-module
                                              declaration-id
                                              (tc-context-symbols call-ctx))
                                            params
                                            1)
                                          call-expr
                                          parse-dispatch)
                                          [(ResultMacroParsedDecls.Ok generated)
                                            (let
                                              [generated : ast.AstDeclList
                                                (if (tc-macro-param-list-needs-call-context?
                                                  params)
                                                  (macro-rewrite-generated-import-decls
                                                    call-ctx
                                                    orig-decls
                                                    module
                                                    (tc-context-module-id
                                                      call-ctx)
                                                    definition-module
                                                    macro-env
                                                    generated)
                                                  generated)]
                                              [contextual-generated : ast.AstDeclList
                                                (macro-generated-context-decls
                                                  generated
                                                  definition-module)]
                                              [flattened-generated : ast.AstDeclList
                                                (macro-flatten-module-body-decls-in-module
                                                  contextual-generated
                                                  module-id)]
                                              [wrapped : ast.AstDeclList
                                                (macro-wrap-generated-decls-decls
                                                  flattened-generated
                                                  (macro-decl-name-display
                                                    macro-name
                                                    definition-module)
                                                  (macro-decls-generated-key
                                                    identity)
                                                  decl-path
                                                  (macro-definition-path-id
                                                    call-ctx
                                                    (ci.intern
                                                      (macro-decl-name-display
                                                        macro-name
                                                        definition-module)))
                                                  (macro-expr-span-or-zero
                                                    call-expr))]
                                              (macro-decls-splice-with-memo
                                                (tc-context-macro-state
                                                  call-ctx)
                                                identity
                                                wrapped
                                                decl-path
                                                call-expr))]
                                          [(ResultMacroParsedDecls.Err diag)
                                            (ResultMacroDeclExpansion.Err diag)]))]
                                    [(ResultMacroValueEnv.Err diag)
                                      (ResultMacroDeclExpansion.Err diag)]))]
                              [(spec.ResultGenKey.Err diag)
                                (ResultMacroDeclExpansion.Err diag)])]
                          [(ResultMacroExprList.Err diag)
                            (ResultMacroDeclExpansion.Err diag)])
                        (if (tc-macro-result-module? ret)
                          (ResultMacroDeclExpansion.Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: Module macro can only be used in import position")))
                          (ResultMacroDeclExpansion.Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: expression macro cannot be used at module scope"))))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box
                        (macro-call-not-macro-diag
                          ctx
                          orig-decls
                          module-id
                          call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-module-import
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [call-id : i64]
  [context : ast.AstMaybeModuleName]
  [alias : ast.AstMaybeImportAlias]
  [span : ast.AstSourceSpan]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : ast.AstExpr (tc-context-expr-get ctx call-id)]
    (match (ast.ast-expr-unspan-with-pools (tc-context-pools ctx) call-expr)
      [(ast.AstExpr.Call func-box args)
        (let
          [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            module-id
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module _)
              (let
                [call-ctx : TcContext
                  (tc-context-with-module-id ctx module module-id)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      declaration-id
                      params
                      ret
                      body)
                    (let
                      [_semantic-use : unit
                        (tc-macro-call-site-note!
                          call-ctx
                          func
                          macro-name
                          definition-module
                          declaration-id)]
                      (if (tc-macro-result-module? ret)
                        ;; Always expand + materialize the module. There is no
                        ;; "skip the import when the alias is textually
                        ;; unreferenced" fast path: a declared
                        ;; instantiation must be typechecked whether or not anything
                        ;; references it (typecheck-completeness invariant).
                        (match (macro-expand-exprs
                          call-ctx
                          global-env
                          orig-decls
                          0
                          args)
                          [(ResultMacroExprList.Ok expanded-args)
                            (match (macro-module-identity
                              call-ctx
                              orig-decls
                              (macro-decl-module-display definition-module)
                              definition-module
                              (macro-decl-name-display
                                macro-name
                                definition-module)
                              (macro-decl-module-display definition-module)
                              params
                              expanded-args
                              (tc-ctfe-env call-ctx)
                              call-expr)
                              [(spec.ResultGenKey.Ok identity _)
                                (let
                                  [shortcut-safe? : bool
                                    (macro-generated-identity-shortcut-safe-params?
                                      call-ctx
                                      (macro-decl-module-display
                                        definition-module)
                                      definition-module
                                      params
                                      expanded-args)]
                                  [shortcut-catalog : MacroGeneratedModuleCatalogEntry
                                    (if shortcut-safe?
                                      (macro-generated-module-memo-get-catalog
                                        (tc-context-macro-state call-ctx)
                                        identity)
                                      (MacroGeneratedModuleCatalogEntry.Empty))]
                                  (match shortcut-catalog
                                    [(MacroGeneratedModuleCatalogEntry.Catalog
                                        target-id
                                        catalog
                                        _
                                        _
                                        _
                                        _)
                                      (begin
                                        (cfg
                                          compile-profile
                                          (compiler-tc-macro-profile-note-generated-module-memo-hit))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-macro-profile-note-generated-module-catalog-hit))
                                        (let
                                          [target-module : String
                                            (tc-env-key-name-text target-id)]
                                          [marker : ast.AstDeclList
                                            (macro-module-import-marker-decls
                                              target-module
                                              target-id
                                              alias
                                              span)]
                                          [expanded : ast.AstDeclList
                                            (match (macro-find-module-body-decls-in-context
                                              ctx
                                              orig-decls
                                              target-module)
                                              [(MacroMaybeDeclList.Some _)
                                                marker]
                                              [(MacroMaybeDeclList.No)
                                                (macro-decl-list-append
                                                  (ast.ast-decl-list-prepend-builder
                                                    (ast.ast-decl-module-id
                                                      target-id)
                                                    catalog)
                                                  (ast.ast-decl-list-prepend-builder
                                                    (ast.ast-decl-module-id
                                                      module-id)
                                                    marker))])]
                                          (ResultMacroDeclExpansion.Ok
                                            expanded
                                            (macro-paths-for-decls
                                              (tc-context-macro-state call-ctx)
                                              expanded
                                              decl-path))))]
                                    [(MacroGeneratedModuleCatalogEntry.Empty)
                                      (macro-decl-expansion-with-frame
                                        call-ctx
                                        decl-path
                                        call-expr
                                        (macro-decl-name-display
                                          macro-name
                                          definition-module)
                                        (match (macro-eval-transformer-expanded-with-env
                                          call-ctx
                                          orig-decls
                                          (macro-decl-module-display
                                            definition-module)
                                          definition-module
                                          global-env
                                          macro-name
                                          declaration-id
                                          (macro-decl-name-display
                                            macro-name
                                            definition-module)
                                          params
                                          ret
                                          body
                                          expanded-args
                                          call-expr)
                                          [(ResultMacroValueEnv.Ok
                                              value
                                              macro-env)
                                            (let
                                              [parse-dispatch : sym_i64_env.SymI64Env
                                                (parser.compiler-parse-dispatch-env)]
                                              (match (macro-module-decls-from-ctfe-value
                                                (macro-hygiene-ctfe-output
                                                  (tc-context-macro-state
                                                    call-ctx)
                                                  (ctfe_support.ctfe-env-syntax-pool-context
                                                    macro-env)
                                                  value
                                                  (MacroHygieneContext
                                                    macro-name
                                                    definition-module
                                                    declaration-id
                                                    (tc-context-symbols
                                                      call-ctx))
                                                  params
                                                  1)
                                                call-expr
                                                parse-dispatch)
                                                [(ResultMacroParsedDecls.Ok
                                                    generated)
                                                  (macro-expand-module-generated-decls
                                                    ctx
                                                    top-env
                                                    orig-decls
                                                    module
                                                    module-id
                                                    alias
                                                    span
                                                    decl-path
                                                    (macro-decl-name-display
                                                      macro-name
                                                      definition-module)
                                                    (macro-definition-path-id
                                                      call-ctx
                                                      (ci.intern
                                                        (macro-decl-name-display
                                                          macro-name
                                                          definition-module)))
                                                    identity
                                                    definition-module
                                                    macro-env
                                                    (tc-macro-param-list-needs-call-context?
                                                      params)
                                                    true
                                                    generated
                                                    call-expr)]
                                                [(ResultMacroParsedDecls.Err
                                                    diag)
                                                  (ResultMacroDeclExpansion.Err
                                                    diag)]))]
                                          [(ResultMacroValueEnv.Err diag)
                                            (ResultMacroDeclExpansion.Err diag)]))]))]
                              [(spec.ResultGenKey.Err diag)
                                (ResultMacroDeclExpansion.Err diag)])]
                          [(ResultMacroExprList.Err diag)
                            (ResultMacroDeclExpansion.Err diag)])
                        (if (tc-macro-result-decls? ret)
                          (ResultMacroDeclExpansion.Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: Decls macro cannot be used in import position")))
                          (ResultMacroDeclExpansion.Err
                            (box
                              (ctfe_support.ctfe-diagnostic-at-expr
                                call-expr
                                "typecheck: expression macro cannot be used as module import"))))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box
                        (macro-call-not-macro-diag
                          ctx
                          orig-decls
                          module-id
                          call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe_support.ctfe-diagnostic-at-expr
              call-expr
              "typecheck: import macro placeholder must contain a call")))])))

(define (macro-expand-decl-with-path
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [site-state : TcMacroCallSiteState
      (tc-job-state-macro-call-sites (tc-context-job-state ctx))]
    [previous-active : TcMacroCallSiteActiveDecl
      (tc-macro-call-site-state-active-decl site-state)]
    [_set-active : unit
      (tc-macro-call-site-state-set-active-decl!
        site-state
        decl-path
        (ast.ast-decl-generated-meta decl))]
    [result : ResultMacroDeclExpansion
      (match decl
        [(ast.AstDecl.Import
            decl-meta
            (ast.AstImportSpec.Spec kind _ _ alias span))
          (match kind
            [(ast.AstImportKind.Macro call-id context)
              (begin
                (macro-expand-program-structural-change-note!
                  (tc-context-macro-state ctx)
                  2)
                (macro-expand-module-import
                  ctx
                  top-env
                  orig-decls
                  module
                  module-id
                  call-id
                  context
                  alias
                  (__tl-box-place span)
                  decl-path))]
            [(ast.AstImportKind.MacroDecls call-id context)
              (begin
                (macro-expand-program-structural-change-note!
                  (tc-context-macro-state ctx)
                  2)
                (macro-expand-decls-splice
                  ctx
                  top-env
                  orig-decls
                  module
                  module-id
                  call-id
                  context
                  decl-path))]
            [_
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)])]
        [_
          (let
            [decl-ctx : TcContext
              (tc-context-with-module-id ctx module module-id)]
            [template : ast.AstDecl
              (ast.ast-decl-with-meta
                (ast.ast-decl-meta-runtime-shared-view)
                decl)]
            [uses-macro : bool
              (macro-decl-uses-macro? decl-ctx orig-decls template)]
            (if (not uses-macro)
              (macro-single-decl-expansion
                (tc-context-macro-state ctx)
                decl
                decl-path)
              (begin
                (if (macro-decl-expansion-can-change-program? decl)
                  (macro-expand-program-structural-change-note!
                    (tc-context-macro-state ctx)
                    1)
                  unit)
                (match (macro-expand-decl
                  decl-ctx
                  local-env
                  orig-decls
                  template)
                  [(ResultMacroDecl.Ok expanded)
                    (macro-single-decl-expansion
                      (tc-context-macro-state ctx)
                      (ast.ast-decl-with-meta (ast.ast-decl-meta decl) expanded)
                      decl-path)]
                  [(ResultMacroDecl.Err diag)
                    (ResultMacroDeclExpansion.Err
                      (box
                        (cdiag.compiler-diagnostic-with-fallback-path
                          (__tl-box-place diag)
                          decl-path)))]))))])]
    (begin
      (tc-macro-call-site-state-restore-active-decl! site-state previous-active)
      result)))

;; R3-P1 copy-out. Rebuild the declaration paths in the arena that is current on
;; entry; the path strings themselves can be generation-resident.
(define (macro-decl-generation-copy-paths [paths : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [count : i64 (ast.ast-decl-path-list-len (& paths))]
    [out : ast.AstDeclPathList (ast.ast-decl-path-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [path : String (ast.ast-decl-path-list-get (& paths) index "")]
          [owned-path : String (string.copy (& path))]
          (begin
            (ast.ast-decl-path-list-push-with-owner-and-provenance-id
              (&mut out)
              owned-path
              (ast.ast-decl-path-list-owner-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty)
              (ast.ast-decl-path-list-provenance-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty))
            (set! index (+ index 1)))))
      out)))

;; Move one expansion result out of its generation and into the committed pool.
;; Everything the survivor still owns in the generation is rebuilt in the pool's
;; base arena; every node id below the shared bases is left alone. Leaves the
;; pool's stable base root current for the caller.
;;
;; PERSIST IN PLACE, not copy-append: the expression rows this expansion created
;; are rewritten where they already are, so the pool does not grow and the
;; survivor keeps its ids. It is the expansion's own transient scope that
;; created every id at or above `shared-expr-base`, and the walk has not
;; committed any of them yet, so rewriting one with an equal-valued,
;; base-arena-owned copy is unobservable. The declaration shells and the path
;; list are still rebuilt -- those live in the generation's slot arrays, not in
;; the pool, so there is nothing to rewrite in place.
(define (macro-decl-generation-copy-out
  [pools : ast.AstNodePoolContext]
  [raw : ResultMacroDeclExpansion]
  [shared-expr-base : i64]
  [shared-type-base : i64]
  [expr-map : (__tl_dyn-array i32)]
  [type-map : (__tl_dyn-array i32)]) : ResultMacroDeclExpansion
  (match raw
    [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
      (match (ast.ast-program-copy-append-above-with-maps
        pools
        pools
        (ast.ast-program expanded)
        shared-expr-base
        shared-type-base
        expr-map
        type-map
        true)
        [(ast.AstProgramCompaction copied _)
          (let
            ;; The program copy restores the arena it was called with, which can
            ;; be a segment the copy itself filled. Resume from the head the
            ;; copy synced into the pool before allocating the paths.
            [_resume : unit
              (unsafe
                (arena.tl_arena_set
                  (ast.ast-node-pool-context-base-arena pools)))]
            [paths : ast.AstDeclPathList
              (macro-decl-generation-copy-paths expanded-paths)]
            (match copied
              [(ast.AstProgram.Program decls-box)
                (ResultMacroDeclExpansion.Ok (__tl-box-place decls-box) paths)]))])]
    [(ResultMacroDeclExpansion.Err diag)
      (let
        [_resume : unit
          (unsafe
            (arena.tl_arena_set (ast.ast-node-pool-context-base-arena pools)))]
        [owned : cdiag.CompilerDiagnostic
          (cdiag.compiler-diagnostic-copy (__tl-box-place diag))]
        [boxed : (Box cdiag.CompilerDiagnostic) (box owned)]
        (ResultMacroDeclExpansion.Err boxed))]))

;; R3-P1: run one firing declaration's expansion inside its own arena generation
;; and copy the surviving declaration back into the committed pool.
;;
;; Only the ambient arena changes. The node pools stay installed and shared, so
;; the type pool's hash-consing table keeps seeing every declaration -- and
;; because `ast-type-node-pool-state-push-raw` persists a type node's payload
;; into the pool's base arena BEFORE writing the row, a type node pushed while
;; the generation is current is already committed. The copy-out therefore shares
;; every type id and pushes no new type node at all; only expression rows, whose
;; 32-byte row copy does not persist boxed children, have to be re-pushed.
;;
;; The shared expression base is the pool length taken before the expansion:
;; ids below it are pre-existing committed nodes that must not be copied (that
;; is what keeps the id map per-declaration sized instead of whole-pool sized),
;; and every node the expansion creates is at or above it. The in-place hygiene
;; rewrite in `macro-hygiene-expr` only touches ids at or above
;; `macro-hygiene-produced-floor`, which is itself taken during the expansion,
;; so it can never mutate a shared node into the generation.
;;
;; The pool's base arena IS the enclosing arena here. Arena handles are stable
;; roots, so a type push can grow its physical chain without changing the
;; enclosing handle restored after the generation.
(define (macro-expand-decl-with-path-generational
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (macro-expand-decl-with-path-in-generation
    ctx
    top-env
    local-env
    orig-decls
    module
    module-id
    decl
    decl-path
    false))

;: R3-P2b: the same mechanism on the splice ring. `splice?` selects which of the
;: two rings owns this expansion's generation; everything else -- the shared
;: bases, the persist-in-place copy-out, the arena-head discipline -- is
;: identical.
(define (macro-expand-decl-with-path-splice-generational
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (macro-expand-decl-with-path-in-generation
    ctx
    top-env
    local-env
    orig-decls
    module
    module-id
    decl
    decl-path
    true))

(define (macro-expand-decl-with-path-in-generation
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [decl-path : String]
  [splice? : bool]) : ResultMacroDeclExpansion
  (if (not
    (and
      (tc-macro-walk-field
        (tc-context-macro-state ctx)
        macro-expand-scratch-enabled)
      (ast.ast-node-pool-has-active-context?)))
    (begin
      (cfg compile-profile (compiler-tc-walk-decl-generation-skip!))
      (macro-expand-decl-with-path
        ctx
        top-env
        local-env
        orig-decls
        module
        module-id
        decl
        decl-path))
    (let
      [macro-state : TcMacroState (tc-context-macro-state ctx)]
      [enclosing : i64 (arena.tl_arena_current)]
      [entry-expr-len : i64 (ast.ast-node-pool-len)]
      [_profile-entry-type-len : i64 (ast.ty-node-pool-len)]
      [_profile-live-before-enter : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-captures-before : i64
        (cfg
          compile-profile
          (+
            compiler-tc-macro-walk-bind-params-calls
            compiler-tc-macro-walk-direct-marshal-calls)
          0)]
      [generation : i64
        (if splice?
          (macro-splice-generation-enter! macro-state)
          (macro-decl-generation-enter! macro-state))]
      [_profile-live-after-enter : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      ;; R3-P2b: whatever this expansion records in a splice memo is noted and
      ;; re-persisted below. The window is exactly the expansion call -- a memo
      ;; put from anywhere else already lands in a long-lived arena and must not
      ;; be re-persisted with these maps.
      [_escape-reset : unit (macro-decl-generation-escape-reset! macro-state)]
      [_enter : unit
        (unsafe
          (arena.tl_arena_set generation))]
      [_profile-generation-mark : i64
        (cfg compile-profile (arena.tl_region_mark) 0)]
      [_profile-raw-start-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_escape-open : unit
        (tc-macro-walk-set! macro-state macro-decl-generation-active true)]
      ;; R3-P2c: publish which generation is live, so anything that installs a
      ;; pool context from inside this expansion is repaired at the destroy.
      [_witness-on : unit
        (ast.ast-node-pool-context-transient-witness! generation)]
      [raw : ResultMacroDeclExpansion
        (macro-expand-decl-with-path
          ctx
          top-env
          local-env
          orig-decls
          module
          module-id
          decl
          decl-path)]
      [_profile-fired : bool
        (cfg
          compile-profile
          (>
            (+
              compiler-tc-macro-walk-bind-params-calls
              compiler-tc-macro-walk-direct-marshal-calls)
            _profile-captures-before)
          false)]
      [_profile-raw-end-live : i64 (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-generation-raw-bytes : i64
        (cfg
          compile-profile
          (if _profile-fired
            (compiler-tc-profile-arena-bytes-since
              generation
              _profile-generation-mark)
            0)
          0)]
      [_escape-close : unit
        (tc-macro-walk-set! macro-state macro-decl-generation-active false)]
      [_witness-off : unit (ast.ast-node-pool-context-transient-witness! 0)]
      ;; Clamped: the walk never truncates the pool below the length it entered
      ;; with, but a base above the live length would make the id map read out
      ;; of range, and a shorter pool has nothing above the base to copy anyway.
      [shared-expr-base : i64
        (if (< (ast.ast-node-pool-len) entry-expr-len)
          (ast.ast-node-pool-len)
          entry-expr-len)]
      ;; Built while the generation is still current: the maps are dead the
      ;; moment the copy-out returns, and putting them here saves the private
      ;; map arena's reserve/release pair on every firing declaration.
      [expr-map : (__tl_dyn-array i32)
        (ast.ast-compaction-id-map-create
          (- (ast.ast-node-pool-len) shared-expr-base))]
      [type-map : (__tl_dyn-array i32)
        (ast.ast-compaction-id-map-create
          (cfg
            compile-profile
            (- (ast.ty-node-pool-len) _profile-entry-type-len)
            0))]
      [_profile-generation-used-end : i64
        (cfg
          compile-profile
          (if _profile-fired
            (compiler-tc-profile-arena-bytes-since
              generation
              _profile-generation-mark)
            0)
          0)]
      ;; The expansion can install a different pool context -- captured CTFE
      ;; syntax pools rebase the active pools -- so the context to append into
      ;; must be re-read HERE. Carrying a context across the call and installing
      ;; it afterwards re-points the pool globals at the pre-expansion cells and
      ;; silently corrupts the walk.
      [pools : ast.AstNodePoolContext (ast.ast-node-pool-context-active-live)]
      [_capture-expanded : unit
        (ast.ast-node-pool-context-capture-active! pools)]
      [_leave : unit
        (unsafe
          (arena.tl_arena_set enclosing))]
      [_profile-copy-start-total : i64
        (cfg compile-profile (profile.alloc-total) 0)]
      [_profile-copy-start-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-census-start : unit
        (cfg
          compile-profile
          (if (and (not splice?) _profile-fired)
            (ast.ast-compaction-profile-start! _profile-entry-type-len type-map)
            unit)
          unit)]
      [_copy-start-len : i64 (ast.ast-node-pool-context-expr-len pools)]
      ;; Every existing type id is shared, so the copy-out and the escape pass
      ;; push no type node at all. Read once so both passes see the same base.
      [shared-type-base : i64 (ast.ast-node-pool-context-type-len pools)]
      [escaped : ResultMacroDeclExpansion
        (macro-decl-generation-copy-out
          pools
          raw
          shared-expr-base
          shared-type-base
          expr-map
          type-map)]
      [_escapes : unit
        (macro-decl-generation-escapes-persist!
          macro-state
          pools
          shared-expr-base
          shared-type-base
          expr-map
          type-map
          splice?)]
      [_profile-copy-end-total : i64
        (cfg compile-profile (profile.alloc-total) 0)]
      [_profile-copy-end-live : i64
        (cfg compile-profile (profile.alloc-live) 0)]
      [_profile-attribution : unit
        (cfg
          compile-profile
          (if (and (not splice?) _profile-fired)
            (let
              [committed-live : i64
                (-
                  (- _profile-raw-end-live _profile-raw-start-live)
                  _profile-generation-raw-bytes)]
              [released : i64
                (- _profile-live-before-enter _profile-live-after-enter)]
              (begin
                (ast.ast-compaction-profile-finish!)
                (compiler-tc-walk-decl-fire-attribution-note!
                  (- _profile-copy-end-total _profile-copy-start-total)
                  (- _profile-copy-end-live _profile-copy-start-live)
                  _profile-generation-used-end
                  (if (> released 0)
                    released
                    0)
                  committed-live
                  _profile-copy-end-live
                  (ast.ast-compaction-profile-source-shared-expr-ref-count)
                  (ast.ast-compaction-profile-source-shared-type-ref-count)
                  (ast.ast-compaction-profile-survivor-expr-node-count)
                  (ast.ast-compaction-profile-survivor-type-node-count))))
            unit)
          unit)]
      (begin
        (cfg
          compile-profile
          (compiler-tc-walk-decl-generation-note!
            (- (ast.ast-node-pool-context-expr-len pools) _copy-start-len)))
        (unsafe
          (arena.tl_arena_set enclosing))
        (ast.ast-node-pool-context-install! pools)
        escaped))))

(define (macro-module-generated-key? [key : String]) : bool
  (and
    (> (string.string-length key) 0)
    (not (tc-string-prefix? key "generated:"))))

(define (macro-decl-generated-identity [decl : ast.AstDecl]) : csym.CompilerMaybeString
  (match (ast.ast-decl-generated-meta decl)
    [(ast.AstGeneratedDeclMeta.Some _ _ _ key)
      (if (macro-module-generated-key? key)
        (CompilerSomeString key)
        CompilerNoString)]
    [(ast.AstGeneratedDeclMeta.No) CompilerNoString]))

(define (macro-module-generated-identity-in
  [decls : ast.AstDeclList]
  [target-module-id : i64]
  [module-id : i64]) : csym.CompilerMaybeString
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) CompilerNoString]
    [(ast.AstDeclListStep.Cons decl rest-box)
      (match decl
        [(ast.AstDecl.Module next-module)
          (macro-module-generated-identity-in
            rest-box
            target-module-id
            next-module)]
        [_
          (if (= module-id target-module-id)
            (match (macro-decl-generated-identity decl)
              [(CompilerSomeString identity) (CompilerSomeString identity)]
              [CompilerNoString
                (macro-module-generated-identity-in
                  rest-box
                  target-module-id
                  module-id)])
            (macro-module-generated-identity-in
              rest-box
              target-module-id
              module-id))])]))

(define (macro-module-generated-identity
  [decls : ast.AstDeclList]
  [target-module-id : i64]) : csym.CompilerMaybeString
  (macro-module-generated-identity-in
    decls
    target-module-id
    cbi.compiler-builtin-id-fix-empty))

(define (macro-generated-module-marker-in
  [decls : ast.AstDeclList]
  [target-module-id : i64]
  [importer-module-id : i64]
  [module-id : i64]) : ast.AstDeclList
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) (ast.ast-decl-list-new)]
    [(ast.AstDeclListStep.Cons decl rest)
      (match decl
        [(ast.AstDecl.Module next-module)
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            next-module)]
        [(ast.AstDecl.Import
            decl-meta
            (ast.AstImportSpec.Spec
              kind
              _
              (ast.AstMaybeModuleName.Some imported-module)
              _
              _))
          (match kind
            [(ast.AstImportKind.Module)
              (if (and
                (= module-id importer-module-id)
                (= imported-module target-module-id))
                (ast.ast-decl-cons decl (ast.ast-decl-list-new))
                (macro-generated-module-marker-in
                  rest
                  target-module-id
                  importer-module-id
                  module-id))]
            [_
              (macro-generated-module-marker-in
                rest
                target-module-id
                importer-module-id
                module-id)])]
        [_
          (macro-generated-module-marker-in
            rest
            target-module-id
            importer-module-id
            module-id)])]))

;; A memoized module expansion has exactly the two pieces needed by the
;; incremental top-env path: its canonical module summary and the import marker
;; emitted in the caller's module. Decls macros use `generated:` keys and never
;; satisfy macro-module-generated-key?, so they stay on the full-rebuild path.
(define (macro-generated-module-extension
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [importer-module-id : i64]) : MacroMaybeGeneratedModuleExtension
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) MacroMaybeGeneratedModuleExtension.No]
    [(ast.AstDeclListStep.Cons first _)
      (match first
        [(ast.AstDecl.Module target-module-id)
          (match (macro-module-generated-identity decls target-module-id)
            [(CompilerSomeString identity)
              (let
                [summary : ast.AstDeclList
                  (macro-generated-module-memo-get-summary state identity)]
                [marker : ast.AstDeclList
                  (macro-generated-module-marker-in
                    decls
                    target-module-id
                    importer-module-id
                    cbi.compiler-builtin-id-fix-empty)]
                (match (ast.ast-decl-list-step summary)
                  [(ast.AstDeclListStep.Nil)
                    MacroMaybeGeneratedModuleExtension.No]
                  [_
                    (match (ast.ast-decl-list-step marker)
                      [(ast.AstDeclListStep.Nil)
                        MacroMaybeGeneratedModuleExtension.No]
                      [_
                        (MacroMaybeGeneratedModuleExtension.Some summary marker)])]))]
            [CompilerNoString MacroMaybeGeneratedModuleExtension.No])]
        [_ MacroMaybeGeneratedModuleExtension.No])]))

(define (macro-generated-import-diag
  [span : ast.AstSourceSpan]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-canonical-diagnostic
    (cdiag.compiler-diagnostic-from-ast-span "" span message)))

(define (macro-check-generated-import-collisions
  [_all-decls : ast.AstDeclList]
  [_generated-body : ast.AstDeclList]
  [_import-module : String]
  [_alias : ast.AstMaybeImportAlias]
  [_identity : String]) : csym.CompilerMaybeString
  CompilerNoString)

;; Macro-expansion skip analysis. Once any module defines
;; a macro, `has-defmacro` forces the full macro-expand walk over EVERY decl in
;; the program (all imported modules), which redundantly re-typechecks match
;; scrutinees / let bindings and rebuilds the entire AST -- ~1.7GB and >1s on a
;; self-compile. The vast majority of decls call no macro at all, so this work is
;; pure waste. These predicates detect whether a decl actually contains a macro
;; (or `when`/`unless` compat) call using the SAME resolution as the expander
;; (`macro-call-decl`), so a decl with none can be shared unchanged. They are
;; conservative: any unrecognized expression variant returns `true` (expand), so
;; a future AST node that could host a macro call is never silently skipped.
;; The callee name of a call after hygiene-stripping (but keeping any module
;; qualifier), mirroring `macro-call-decl`'s name resolution. Returns nothing for
;; non-variable callees (which `macro-call-decl` also treats as non-macro).
;; Allocation-free for plain unqualified names -- the hot path for the pre-filter.
(define (macro-call-callee-name [func : ast.AstExpr]) : TcMaybeString
  (match func
    [(ast.AstExpr.Spanned inner-box _)
      (macro-call-callee-name (ast.ast-node-get inner-box))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (macro-call-callee-name (ast.ast-node-get inner-box))]
    [(ast.AstExpr.Var name)
      (let
        [name-text : String (tc-env-key-display name)]
        (TcMaybeString.Some
          (if (tc-hygiene-global-name? name-text)
            (match (tc-hygiene-global-decode name-text)
              [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
              [(TcHygieneGlobalName.Context _ lookup-name) lookup-name])
            name-text)))]
    [_ (TcMaybeString.No)]))

(define (macro-call-callee-last-dot [name : String]) : i64
  (let
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (begin
          (if (or
            (string.char-eq (string.string-ref name i) '.')
            (string.char-eq (string.string-ref name i) '/'))
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      last-dot)))

(define (macro-call-callee-base-name [name : String]) : String
  (let
    [lookup : String
      (if (tc-hygiene-global-name? name)
        (tc-hygiene-global-call-name name)
        name)]
    [source : String lookup]
    [last-dot : i64 (macro-call-callee-last-dot source)]
    [n : i64 (string.string-length source)]
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (macro-call-name-maybe-macro? [name : String]) : bool
  (let
    [base : String (macro-call-callee-base-name name)]
    (or (string.eq base "when") (string.eq base "unless"))))

(define (macro-call-callee-base-name-id [func : ast.AstExpr]) : TcMaybeNameId
  (match func
    [(ast.AstExpr.Spanned inner-box _)
      (macro-call-callee-base-name-id (ast.ast-node-get inner-box))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (macro-call-callee-base-name-id (ast.ast-node-get inner-box))]
    [(ast.AstExpr.Var name-id)
      (cond
        [(csym.compiler-composite-triple-key-id? name-id)
          (TcMaybeNameId.Some (csym.compiler-composite-triple-right-id name-id))]
        [(csym.compiler-composite-pair-key-id? name-id)
          (TcMaybeNameId.Some (csym.compiler-composite-pair-right-id name-id))]
        [else
          (let
            [source-id : i64
              (macro-hygiene-global-source-name-id-or name-id name-id)]
            [base-id : i64
              (if (and
                (>= source-id 0)
                (< source-id (ci.intern-capacity))
                (ci.intern-qualified? source-id))
                (ci.intern-qualified-base-id source-id)
                source-id)]
            (if (< base-id 0)
              TcMaybeNameId.No
              (TcMaybeNameId.Some
                (if (and
                  (< base-id (ci.intern-capacity))
                  (ci.intern-dotted? base-id))
                  (ci.intern-dotted-final-id base-id)
                  base-id))))])]
    [_ TcMaybeNameId.No]))

(define (macro-call-callee-maybe-macro?
  [state : TcMacroState]
  [func : ast.AstExpr]) : bool
  (match (macro-call-callee-base-name-id func)
    [(TcMaybeNameId.Some base-id)
      (let
        [names : tc_i64_i64_map.Map
          (tc-macro-walk-field state macro-expand-macro-name-set)]
        (or
          (tc_i64_i64_map.contains? (& names) base-id)
          (= base-id cbi.compiler-builtin-id-fix-when)
          (= base-id cbi.compiler-builtin-id-fix-unless)))]
    [TcMaybeNameId.No
      (match (macro-call-callee-name func)
        [(TcMaybeString.Some name) (macro-call-name-maybe-macro? name)]
        [(TcMaybeString.No) false])]))

(define (macro-call-is-expandable?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [func : ast.AstExpr]
  [call-expr : ast.AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcMaybeString.Some name)
      ;; Only callees whose base name matches a declared macro need precise
      ;; alias/module resolution. This keeps value-heavy dotted imports such as
      ;; `string.length` on the cheap path while still resolving qualified macro
      ;; calls through `macro-call-decl`.
      (if (macro-call-callee-maybe-macro? (tc-context-macro-state ctx) func)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe)
            (match maybe
              [(MacroMaybeDecl.Some _ _ _ _ _ _) true]
              [(MacroMaybeDecl.No)
                (or (string.eq name "when") (string.eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) true])
        false)]
    [(TcMaybeString.No) false]))

(define (macro-node-uses-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [id : i64]) : bool
  (macro-expr-uses-macro? ctx decls (ast.ast-node-get id)))

(define (macro-exprs-use-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [exprs : ast.AstExprList]) : bool
  (macro-exprs-use-macro-at? ctx decls (& exprs) 0))

(define (macro-exprs-use-macro-at?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (macro-node-uses-macro? ctx decls (ast.ast-expr-list-get exprs index 0))
      (macro-exprs-use-macro-at? ctx decls exprs (+ index 1)))))

(define (macro-arms-use-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [arms : ast.AstMatchArmList]) : bool
  (macro-arms-use-macro-at? ctx decls (& arms) 0))

(define (macro-arms-use-macro-at?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (or
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(ast.AstMatchArm.Arm _ body-box)
          (macro-node-uses-macro? ctx decls body-box)])
      (macro-arms-use-macro-at? ctx decls arms (+ index 1)))))

(define (macro-bindings-use-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [bindings : ast.AstLetBindingList]) : bool
  (macro-bindings-use-macro-at? ctx decls (& bindings) 0))

(define (macro-bindings-use-macro-at?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (macro-node-uses-macro? ctx decls init-box)])
      (macro-bindings-use-macro-at? ctx decls bindings (+ index 1)))))

(define (macro-expr-uses-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (macro-node-uses-macro? ctx decls inner-box)]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (macro-node-uses-macro? ctx decls inner-box)]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var _) false]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (ast.ast-node-get func-box)]
        (or
          (macro-call-is-expandable? ctx decls func expr)
          (macro-expr-uses-macro? ctx decls func)
          (macro-exprs-use-macro? ctx decls args)))]
    [(ast.AstExpr.BracketClause items) (macro-exprs-use-macro? ctx decls items)]
    [(ast.AstExpr.Binary _ l r)
      (or
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls r))]
    [(ast.AstExpr.Unary _ i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.If c t e)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls t)
        (macro-node-uses-macro? ctx decls e))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body)
          (or
            (macro-bindings-use-macro? ctx decls bindings)
            (macro-node-uses-macro? ctx decls body))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda _ _ body)
          (macro-node-uses-macro? ctx decls body)])]
    [(ast.AstExpr.Tuple exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.TupleRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.Array exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.DynArray exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.MakeArray _ len) (macro-node-uses-macro? ctx decls len)]
    [(ast.AstExpr.ArrayRef a i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i))]
    [(ast.AstExpr.ArraySet a i v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(ast.AstExpr.ArrayTake a l i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls i))]
    [(ast.AstExpr.FixedArrayTake a i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i))]
    [(ast.AstExpr.Replace place replacement)
      (or
        (macro-node-uses-macro? ctx decls place)
        (macro-node-uses-macro? ctx decls replacement))]
    [(ast.AstExpr.ArrayPush a v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls v))]
    [(ast.AstExpr.StringRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.While c b)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.Begin exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.Unsafe exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.Set _ rhs) (macro-node-uses-macro? ctx decls rhs)]
    [(ast.AstExpr.Ann i _) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Cast i _) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Borrow _ _ i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut arms)
          (or
            (macro-node-uses-macro? ctx decls scrut)
            (macro-arms-use-macro? ctx decls arms))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach _ _ s e b)
          (or
            (macro-node-uses-macro? ctx decls s)
            (macro-node-uses-macro? ctx decls e)
            (macro-node-uses-macro? ctx decls b))])]
    [(ast.AstExpr.StructGet i _) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.StructSet i _ v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(ast.AstExpr.WithEscape i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(ast.AstExpr.WithScratch exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.InArena i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(ast.AstExpr.Box i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.BoxGet i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.BoxTake i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.BoxSet i v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(ast.AstExpr.Comptime i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Try i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Return i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.PtrNullCheck i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.PtrRead i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.PtrWrite a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.PtrOffset a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.PtrCast i _) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.PtrToInt i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.IntToPtr i _) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.StringData i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.StringFromBytes a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.ArrayData i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.BinaryData _) false]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.CpuIdEax a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.CpuIdEbx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.CpuIdEcx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.CpuIdEdx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(ast.AstExpr.Xgetbv i) (macro-node-uses-macro? ctx decls i)]
    [(ast.AstExpr.Syscall exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.PtrNull _) false]
    [(ast.AstExpr.PtrAddrOf place) (macro-node-uses-macro? ctx decls place)]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.ProgramArgc) false]
    [(ast.AstExpr.ProgramArgv) false]
    [(ast.AstExpr.ProgramEnvp) false]
    [_ true]))

(define (macro-decl-uses-macro?
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (macro-node-uses-macro? ctx decls expr-box)]
    [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
      (macro-node-uses-macro? ctx decls body-box)]
    [(ast.AstDecl.Test _ _ _) true]
    [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(ast.AstImportKind.Macro _ _) true]
        [(ast.AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-decl-uses-macro? ctx decls (__tl-box-place inner-box))]
    [_ false]))

;; `macro-decl-uses-macro?` is also a conservative inspection gate: tests take
;; that path even though production macro expansion shares them verbatim.  Keep
;; the structural-change proof narrower than the inspection decision so an
;; unchanged Test (including one wrapped in Unsafe) cannot force a whole-program
;; detach.
(define (macro-decl-expansion-can-change-program? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Def _ _ _ _) true]
    [(ast.AstDecl.DefFn _ _ _ _ _ _) true]
    [(ast.AstDecl.Import _ (ast.AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(ast.AstImportKind.Macro _ _) true]
        [(ast.AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-decl-expansion-can-change-program? (__tl-box-place inner-box))]
    [_ false]))

;; Cheap, ctx-free, allocation-free over-approximation of "could the expander
;; fire a macro/compat call anywhere inside this expression". It is used as a
;; decl-level pre-filter in `macro-expand-decls`: a decl whose body cannot fire
;; is pushed to the output unchanged (shared, never copied through the expander),
;; skipping the per-decl `tc-context-with-module` allocation and the precise
;; `macro-decl-uses-macro?` walk (which resolves candidate calls via
;; `macro-call-decl`).
;;
;; SAFE BY CONSTRUCTION (must guarantee: if the expander could rewrite a child
;; expression, `macro-expr-might-fire? = true`, i.e. we never share what the
;; expander would expand). This is achieved by following child expressions that
;; can syntactically contain calls, with explicit false leaves for non-call
;; forms.
;;   - At `AstExpr.Call` it uses `macro-call-callee-maybe-macro?` -- the registry
;;     gate the expander itself checks before attempting expansion -- which is a
;;     superset of `macro-call-is-expandable?` (it skips the `macro-call-decl`
;;     resolution and treats any registry-name callee as a possible fire). So at
;;     every call mine flags at least whatever the precise walk flags.
;;   - Scoped/container forms (for example WithRegion, WithResource, and SPMD)
;;     recurse into their child expressions here as well, so ordinary
;;     scoped/resource/vector code without macro calls does not force the full
;;     macro setup path.
;; A bare `AstExpr.Var`/`AstExpr.Set` target is never a call -> false (matching
;; the gate). `AstExpr.PtrAddrOf` follows its place operand because addressable
;; places can now contain macro-expanded field/element forms. This walk covers
;; every expression position from which a macro can fire. Whether a transformer
;; asks for an operand's type changes how that call is evaluated, not how the
;; call is represented, so expr-type macros use the same syntactic call gate.
(define (macro-expr-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : bool
  (macro-expr-list-might-fire-at? state expr-bases (& exprs) 0))

(define (macro-expr-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0)))
      (macro-expr-list-might-fire-at? state expr-bases exprs (+ index 1)))))

(define (macro-let-binding-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]) : bool
  (macro-let-binding-list-might-fire-at? state expr-bases (& bindings) 0))

(define (macro-let-binding-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (macro-expr-might-fire? state expr-bases init)
            (macro-let-binding-list-might-fire-at?
              state
              expr-bases
              bindings
              (+ index 1))))])))

(define (macro-match-arms-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : bool
  (not (= (macro-match-arms-first-fire-index state expr-bases arms) -1)))

(define (macro-match-arms-first-fire-index
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : i64
  (macro-match-arms-first-fire-index-at state expr-bases (& arms) 0))

(define (macro-match-arms-first-fire-index-at
  [state : TcMacroState]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : i64
  (if (>= index arms.len)
    -1
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (if (macro-expr-might-fire? state expr-bases body)
            index
            (macro-match-arms-first-fire-index-at
              state
              expr-bases
              arms
              (+ index 1))))])))

(define (macro-resource-binding-list-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]) : bool
  (macro-resource-binding-list-might-fire-at? state expr-bases (& bindings) 0))

(define (macro-resource-binding-list-might-fire-at?
  [state : TcMacroState]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding _ init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (macro-expr-might-fire? state expr-bases init)
            (macro-expr-might-fire? state expr-bases cleanup)
            (macro-resource-binding-list-might-fire-at?
              state
              expr-bases
              bindings
              (+ index 1))))])))

(define (macro-expr-might-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (begin
    (cfg compile-profile (compiler-tc-walk-note-fire-touch!))
    (macro-expr-might-fire-uncounted? state expr-bases expr)))

(define (macro-expr-might-fire-uncounted?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var _) false]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (or
          (macro-call-callee-maybe-macro? state func)
          (macro-expr-might-fire? state expr-bases func)
          (macro-expr-list-might-fire? state expr-bases args)))]
    [(ast.AstExpr.BracketClause items)
      (macro-expr-list-might-fire? state expr-bases items)]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (or
          (macro-expr-might-fire? state expr-bases left)
          (macro-expr-might-fire? state expr-bases right)))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (or
          (macro-expr-might-fire? state expr-bases cond)
          (macro-expr-might-fire? state expr-bases then-branch)
          (macro-expr-might-fire? state expr-bases else-branch)))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-let-binding-list-might-fire? state expr-bases bindings)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (macro-expr-might-fire? state expr-bases body))])]
    [(ast.AstExpr.Tuple exprs)
      (macro-expr-list-might-fire? state expr-bases exprs)]
    [(ast.AstExpr.TupleRef tuple-box index-box)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases tuple)
          (macro-expr-might-fire? state expr-bases index)))]
    [(ast.AstExpr.Array exprs)
      (macro-expr-list-might-fire? state expr-bases exprs)]
    [(ast.AstExpr.DynArray exprs)
      (macro-expr-list-might-fire? state expr-bases exprs)]
    [(ast.AstExpr.MakeArray _ len-box)
      (let
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (macro-expr-might-fire? state expr-bases len))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases index)))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases index)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [live : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases live-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases live)
          (macro-expr-might-fire? state expr-bases index)))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (or
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases array-box))
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases index-box)))]
    [(ast.AstExpr.Replace place-box replacement-box)
      (or
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases place-box))
        (macro-expr-might-fire?
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases replacement-box)))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases array)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ast.AstExpr.StringRef str-box index-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (macro-expr-might-fire? state expr-bases str)
          (macro-expr-might-fire? state expr-bases index)))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (or
          (macro-expr-might-fire? state expr-bases cond)
          (macro-expr-might-fire? state expr-bases body)))]
    [(ast.AstExpr.ForOwnedState payload)
      (let
        [source : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-state-source (& payload)))]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-state-body (& payload)))]
        (or
          (macro-expr-might-fire? state expr-bases source)
          (macro-expr-might-fire? state expr-bases body)))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-for-owned-step-body (& payload)))]
        (or
          (if (>= expected-type 0)
            (macro-expr-might-fire?
              state
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases expected-type))
            false)
          (macro-expr-might-fire? state expr-bases body)))]
    [(ast.AstExpr.Begin exprs)
      (macro-expr-list-might-fire? state expr-bases exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (macro-expr-list-might-fire? state expr-bases exprs)]
    [(ast.AstExpr.Set _ value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (macro-expr-might-fire? state expr-bases value))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.Borrow _ _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (macro-expr-might-fire? state expr-bases place))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (or
              (macro-expr-might-fire? state expr-bases scrutinee)
              (macro-match-arms-might-fire? state expr-bases arms)))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach _ _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(ast.AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases init)
              (macro-expr-might-fire? state expr-bases value)))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(ast.AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (macro-expr-might-fire? state expr-bases start)
              (macro-expr-might-fire? state expr-bases end)
              (macro-expr-might-fire? state expr-bases init)
              (macro-expr-might-fire? state expr-bases value)
              (macro-expr-might-fire? state expr-bases body)))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (or
          (macro-expr-might-fire? state expr-bases value)
          (macro-expr-might-fire? state expr-bases lane)))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (or
          (macro-expr-might-fire? state expr-bases value)
          (macro-expr-might-fire? state expr-bases lane)))]
    [(ast.AstExpr.StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (macro-expr-might-fire? state expr-bases receiver))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases receiver)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ast.AstExpr.WithRegion _ body)
      (macro-expr-list-might-fire? state expr-bases body)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        (or
          (macro-expr-might-fire? state expr-bases scratch)
          (macro-expr-list-might-fire? state expr-bases body)))]
    [(ast.AstExpr.WithScratch body)
      (macro-expr-list-might-fire? state expr-bases body)]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        (or
          (macro-expr-might-fire? state expr-bases arena)
          (macro-expr-list-might-fire? state expr-bases body)))]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (or
            (macro-resource-binding-list-might-fire? state expr-bases bindings)
            (macro-expr-list-might-fire? state expr-bases body))])]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases inner)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (macro-expr-might-fire? state expr-bases inner))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (macro-expr-might-fire? state expr-bases ptr))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases value)))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases offset)))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (macro-expr-might-fire? state expr-bases ptr))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (macro-expr-might-fire? state expr-bases ptr))]
    [(ast.AstExpr.IntToPtr value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (macro-expr-might-fire? state expr-bases value))]
    [(ast.AstExpr.StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (macro-expr-might-fire? state expr-bases str))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (or
          (macro-expr-might-fire? state expr-bases ptr)
          (macro-expr-might-fire? state expr-bases len)))]
    [(ast.AstExpr.ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (macro-expr-might-fire? state expr-bases array))]
    [(ast.AstExpr.BinaryData _) false]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (macro-expr-might-fire? state expr-bases leaf)
          (macro-expr-might-fire? state expr-bases subleaf)))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (macro-expr-might-fire? state expr-bases leaf)
          (macro-expr-might-fire? state expr-bases subleaf)))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (macro-expr-might-fire? state expr-bases leaf)
          (macro-expr-might-fire? state expr-bases subleaf)))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (macro-expr-might-fire? state expr-bases leaf)
          (macro-expr-might-fire? state expr-bases subleaf)))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (macro-expr-might-fire? state expr-bases index))]
    [(ast.AstExpr.Syscall args)
      (macro-expr-list-might-fire? state expr-bases args)]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.PtrNull _) false]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (macro-expr-might-fire? state expr-bases place))]
    [(ast.AstExpr.ProgramArgc) false]
    [(ast.AstExpr.ProgramArgv) false]
    [(ast.AstExpr.ProgramEnvp) false]
    [_ true]))

;; Decl-level companion to `macro-expr-might-fire?`. Returns true only for the
;; value-bearing decl kinds whose entire macro-expandable surface is a single
;; body expression that provably contains no fireable call -- such a decl can be
;; pushed to the macro-expand output unchanged (shared). Every other decl kind
;; returns false so it falls through to the precise `macro-expand-decl-with-path`
;; path (which shares or expands import placeholders, splices, defmacro, unsafe,
;; comptime templates, etc. correctly).
(define (macro-decl-cannot-fire?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (if (ast.ast-decl-comptime-only? decl)
    false
    (match decl
      [(ast.AstDecl.Def decl-meta _ _ expr-box)
        (not
          (macro-expr-might-fire?
            state
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases expr-box)))]
      [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
        (not
          (macro-expr-might-fire?
            state
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box)))]
      [(ast.AstDecl.Test _ _ _) false]
      [_ false])))

;; Profile-instrumented wrapper for the per-decl share gate; non-profile
;; builds see a plain call.
(define (macro-decl-cannot-fire-gate?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (begin
    (cfg compile-profile (compiler-tc-walk-decl-gate-start!))
    (let
      [result : bool (macro-decl-cannot-fire? state expr-bases decl)]
      (begin
        (cfg compile-profile (compiler-tc-walk-decl-gate-finish!))
        result))))

;; Whether the program contains any `(type T)` literal (AstExpr.TypeLiteral). ALL
;; CTFE reflection/layout queries (ctfe-reflect-resolve-type for a `(type T)`,
;; and every reflection/layout builtin -- size-of/struct-field-*/enum-variant-*/
;; ...) take a type-literal argument, and type literals are comptime-only (they
;; can't appear in runtime code). So a program with no type literal never queries
;; the CTFE metadata, and `tc-ctfe-env` can hand back an empty env instead of
;; building the whole-program reflection + layout tables (tens of MB, O(types^2)).
;; Macro `expr-type` calls also need metadata, but macro expansion tracks those
;; from defmacro bodies instead of making this whole-program scan normalize every
;; call head.
;; Conservative: any unrecognized expression returns `true` (build), so a future
;; node that could host a type literal is never silently skipped.
(define (ctfe-node-has-type-literal? [state : TcMacroState] [id : i64]) : bool
  (ctfe-expr-has-type-literal? state (ast.ast-node-get id)))

(define (ctfe-node-is-module-value-query? [id : i64]) : bool
  (match (ast.ast-expr-unspan (ast.ast-node-get id))
    [(ast.AstExpr.Var raw-id)
      (let
        [source-id : i64 (macro-hygiene-global-source-name-id-or raw-id raw-id)]
        (ctfe_support.ctfe-builtin-module-value-id?
          (ctfe_support.ctfe-comptime-helper-call-name-id source-id)))]
    [_ false]))

;; Function arguments are eager. Use this at the declaration-list boundary so
;; an earlier type literal cannot stop the combined metadata/query prescan
;; before it reaches a later macro body.
(define (ctfe-reflection-prescan-or [left : bool] [right : bool]) : bool
  (or left right))

(define (ctfe-exprs-have-type-literal?
  [state : TcMacroState]
  [exprs : ast.AstExprList]) : bool
  (ctfe-exprs-have-type-literal-at? state (& exprs) 0))

(define (ctfe-exprs-have-type-literal-at?
  [state : TcMacroState]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (ctfe-reflection-prescan-or
      (ctfe-node-has-type-literal? state (ast.ast-expr-list-get exprs index 0))
      (ctfe-exprs-have-type-literal-at? state exprs (+ index 1)))))

(define (ctfe-arms-have-type-literal?
  [state : TcMacroState]
  [arms : ast.AstMatchArmList]) : bool
  (ctfe-arms-have-type-literal-at? state (& arms) 0))

(define (ctfe-arms-have-type-literal-at?
  [state : TcMacroState]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (ctfe-reflection-prescan-or
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(ast.AstMatchArm.Arm _ body-box)
          (ctfe-node-has-type-literal? state body-box)])
      (ctfe-arms-have-type-literal-at? state arms (+ index 1)))))

(define (ctfe-bindings-have-type-literal?
  [state : TcMacroState]
  [bindings : ast.AstLetBindingList]) : bool
  (ctfe-bindings-have-type-literal-at? state (& bindings) 0))

(define (ctfe-bindings-have-type-literal-at?
  [state : TcMacroState]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (ctfe-reflection-prescan-or
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (ctfe-node-has-type-literal? state init-box)])
      (ctfe-bindings-have-type-literal-at? state bindings (+ index 1)))))

(define (ctfe-expr-has-type-literal?
  [state : TcMacroState]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.TypeLiteral _) true]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.PtrNull _) false]
    [(ast.AstExpr.PtrAddrOf place) (ctfe-node-has-type-literal? state place)]
    [(ast.AstExpr.ProgramArgc) false]
    [(ast.AstExpr.ProgramArgv) false]
    [(ast.AstExpr.ProgramEnvp) false]
    [(ast.AstExpr.Spanned inner-box _)
      (ctfe-node-has-type-literal? state inner-box)]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (ctfe-node-has-type-literal? state inner-box)]
    [(ast.AstExpr.Call func-box args)
      (begin
        (if (ctfe-node-is-module-value-query? func-box)
          (ctfe_support.ctfe-module-value-reflection-enable-for-state!
            (tc-macro-ctfe-state state)
            true)
          unit)
        (ctfe-reflection-prescan-or
          (ctfe-node-has-type-literal? state func-box)
          (ctfe-exprs-have-type-literal? state args)))]
    [(ast.AstExpr.BracketClause items)
      (ctfe-exprs-have-type-literal? state items)]
    [(ast.AstExpr.Binary _ l r)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state l)
        (ctfe-node-has-type-literal? state r))]
    [(ast.AstExpr.Unary _ i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.If c t e)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state c)
        (ctfe-reflection-prescan-or
          (ctfe-node-has-type-literal? state t)
          (ctfe-node-has-type-literal? state e)))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body)
          (ctfe-reflection-prescan-or
            (ctfe-bindings-have-type-literal? state bindings)
            (ctfe-node-has-type-literal? state body))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda _ _ body)
          (ctfe-node-has-type-literal? state body)])]
    [(ast.AstExpr.Tuple exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.TupleRef a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.Array exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.DynArray exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.MakeArray _ len) (ctfe-node-has-type-literal? state len)]
    [(ast.AstExpr.ArrayRef a i)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state i))]
    [(ast.AstExpr.ArraySet a i v)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-reflection-prescan-or
          (ctfe-node-has-type-literal? state i)
          (ctfe-node-has-type-literal? state v)))]
    [(ast.AstExpr.ArrayTake a l i)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-reflection-prescan-or
          (ctfe-node-has-type-literal? state l)
          (ctfe-node-has-type-literal? state i)))]
    [(ast.AstExpr.FixedArrayTake a i)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state i))]
    [(ast.AstExpr.Replace place replacement)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state place)
        (ctfe-node-has-type-literal? state replacement))]
    [(ast.AstExpr.ArrayPush a v)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state v))]
    [(ast.AstExpr.StringRef a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.While c b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state c)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.Begin exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.Unsafe exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.Set _ rhs) (ctfe-node-has-type-literal? state rhs)]
    [(ast.AstExpr.Ann i _) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Cast i _) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Borrow _ _ i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut arms)
          (ctfe-reflection-prescan-or
            (ctfe-node-has-type-literal? state scrut)
            (ctfe-arms-have-type-literal? state arms))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach _ _ s e b)
          (ctfe-reflection-prescan-or
            (ctfe-node-has-type-literal? state s)
            (ctfe-reflection-prescan-or
              (ctfe-node-has-type-literal? state e)
              (ctfe-node-has-type-literal? state b)))])]
    [(ast.AstExpr.StructGet i _) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.StructSet i _ v)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state i)
        (ctfe-node-has-type-literal? state v))]
    [(ast.AstExpr.WithRegion _ exprs)
      (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.WithEscape i exprs)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state i)
        (ctfe-exprs-have-type-literal? state exprs))]
    [(ast.AstExpr.WithScratch exprs)
      (ctfe-exprs-have-type-literal? state exprs)]
    [(ast.AstExpr.InArena i exprs)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state i)
        (ctfe-exprs-have-type-literal? state exprs))]
    [(ast.AstExpr.Box i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.BoxGet i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.BoxTake i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.BoxSet i v)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state i)
        (ctfe-node-has-type-literal? state v))]
    [(ast.AstExpr.Comptime i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Quote i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Quasiquote i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Unquote i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.UnquoteSplicing i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Try i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Return i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.PtrNullCheck i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.PtrRead i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.PtrWrite a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.PtrOffset a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.PtrCast i _) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.PtrToInt i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.IntToPtr i _) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.StringData i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.StringFromBytes a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.ArrayData i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.BinaryData _) false]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.CpuIdEax a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.CpuIdEbx a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.CpuIdEcx a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.CpuIdEdx a b)
      (ctfe-reflection-prescan-or
        (ctfe-node-has-type-literal? state a)
        (ctfe-node-has-type-literal? state b))]
    [(ast.AstExpr.Xgetbv i) (ctfe-node-has-type-literal? state i)]
    [(ast.AstExpr.Syscall exprs) (ctfe-exprs-have-type-literal? state exprs)]
    [_ true]))

(define (ctfe-decl-has-type-literal?
  [state : TcMacroState]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (ctfe-node-has-type-literal? state expr-box)]
    [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
      (ctfe-node-has-type-literal? state body-box)]
    [(ast.AstDecl.Test _ expr-box _)
      (ctfe-node-has-type-literal? state expr-box)]
    [(ast.AstDecl.DefMacro decl-meta _ _ _ body-box)
      (ctfe-node-has-type-literal? state body-box)]
    [(ast.AstDecl.Unsafe inner-box)
      (ctfe-decl-has-type-literal? state (__tl-box-place inner-box))]
    [(ast.AstDecl.ModuleBody _ body-box)
      (ctfe-program-has-type-literal? state (__tl-box-place body-box))]
    [_ false]))

(define (ctfe-program-has-type-literal?
  [state : TcMacroState]
  [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (ctfe-reflection-prescan-or
        (ctfe-decl-has-type-literal? state decl)
        (ctfe-program-has-type-literal? state rest))]))

;; Reflection metadata only needs a refresh when a splice introduces a nominal
;; declaration. Keep ordinary expression/function splices on the shared CTFE
;; environment so the cache still avoids whole-program metadata walks.
(define (macro-decl-reflection-relevant? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.DefEnum decl-meta _ _ _) true]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ _ _) true]
    [(ast.AstDecl.DefStruct decl-meta _ _ _ _) true]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-decl-reflection-relevant? (__tl-box-place inner-box))]
    [(ast.AstDecl.ModuleBody _ body-box)
      (macro-decls-reflection-relevant? (__tl-box-place body-box))]
    [_ false]))

(define (macro-decls-reflection-relevant? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-reflection-relevant? decl)
        (macro-decls-reflection-relevant? rest))]))

;; A forced splice installs the current live symbols/registries in a new
;; context. Generated modules append to those tables; arbitrary splices and
;; materialized files rebuild them. Every top-env plan is additive: it revisits
;; only cached signatures that remain unresolved, binds the splice delta, and
;; publishes one explicit cache layer. Generated modules add their isolated
;; summary and marker through the same contract. `module` is the active
;; namespace at the splice site.
(define (tc-top-env-binding-context [ctx : TcContext] [name-id : i64]) : TcContext
  (if (tc-name-qualified-id? name-id)
    (let
      [module-id : i64 (tc-qualified-name-module-id name-id)]
      (if (>= module-id 0)
        (tc-context-with-module-id
          ctx
          (tc-env-key-name-text module-id)
          module-id)
        ctx))
    (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))

;; A splice updates symbols before it updates the type env. Final
;; nominal/scalar bindings cannot change; only signatures that still contain
;; Var/VarArgs nodes are candidates. Every cache records that candidate set at
;; construction, and this walk compacts it in place as names become resolvable.
;; The fixed-width scan is proportional to unresolved signatures, never the
;; retained top-env spine or source tail.
(define (tc-top-env-reresolve-cache-node!
  [ctx : TcContext]
  [cache-ptr : (Ptr TcTypeEnvCache)]) : i64
  (let
    [cache : TcTypeEnvCache
      (unsafe
        (ptr-read cache-ptr))]
    [ids : tc_i64_i64_map.Map cache.ids]
    [values : (__tl_dyn-array ast.AstType) cache.values]
    [sidecar : (__tl_dyn-array i64) cache.unsafe-flags]
    [capacity : i64 (array.length values)]
    [count : i64 (array-ref sidecar capacity)]
    [read-index : i64 0]
    [write-index : i64 0]
    (begin
      (while (< read-index count)
        (let
          [name-id : i64 (array-ref sidecar (+ capacity 1 read-index))]
          [value-slot : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
          (begin
            (if (and (>= value-slot 0) (< value-slot (array.length values)))
              (let
                [before : ast.AstType (array-ref values value-slot)]
                (if (tc-type-needs-resolution? before)
                  (let
                    [binding-ctx : TcContext
                      (tc-top-env-binding-context ctx name-id)]
                    [after : ast.AstType (tc-resolve-type binding-ctx before)]
                    (begin
                      (cfg
                        compile-profile
                        (set!
                          compiler-tc-walk-splice-env-reresolve-candidates
                          (+ compiler-tc-walk-splice-env-reresolve-candidates 1)))
                      (if (ast.ast-type-eq? before after)
                        unit
                        (begin
                          (set! (array-ref values value-slot) after)
                          (cfg
                            compile-profile
                            (set!
                              compiler-tc-walk-splice-env-reresolve-updates
                              (+
                                compiler-tc-walk-splice-env-reresolve-updates
                                1)))))
                      (if (tc-type-needs-resolution? after)
                        (begin
                          (set!
                            (array-ref sidecar (+ capacity 1 write-index))
                            name-id)
                          (set! write-index (+ write-index 1)))
                        unit)))
                  unit))
              (io.panic
                (str_cat.str-cat
                  "typecheck: top-env resolution slot out of bounds: "
                  (string.int->string value-slot)
                  " / "
                  (string.int->string (array.length values)))))
            (set! read-index (+ read-index 1)))))
      (set! (array-ref sidecar capacity) write-index)
      (cfg
        compile-profile
        (set!
          compiler-tc-walk-splice-env-reresolve-remaining
          (+ compiler-tc-walk-splice-env-reresolve-remaining write-index)))
      write-index)))

(define (tc-top-env-reresolve-caches! [ctx : TcContext] [env : TcTypeEnv]) : unit
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [done : bool false]
    (begin
      (cfg
        compile-profile
        (set!
          compiler-tc-walk-splice-env-reresolve-calls
          (+ compiler-tc-walk-splice-env-reresolve-calls 1)))
      ;; A batch of consecutive module markers can leave a small raw prefix.
      ;; Skip it to the first explicit layer, then follow only partial `below`
      ;; links, exactly like the lookup chain being invalidated.
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(>= head 0)
            (set!
              head
              (tc-type-env-binding-parent-at
                (tc-type-env-binding-ptr store-handle head)))]
          [else
            (let
              [cache-ptr : (Ptr TcTypeEnvCache)
                (unsafe
                  (int->ptr
                    (cast (tc-type-env-cache-index head) : u64)
                    : (Ptr TcTypeEnvCache)))]
              [cache : TcTypeEnvCache
                (unsafe
                  (ptr-read (ptr-cast cache-ptr : (Ptr TcTypeEnvCache))))]
              (begin
                (tc-top-env-reresolve-cache-node! ctx cache-ptr)
                (if cache.partial
                  (set! head cache.below)
                  (set! done true))))])))))

(define (tc-extend-top-env-for-splice
  [ctx : TcContext]
  [base-env : TcTypeEnv]
  [splice : ast.AstDeclList]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (begin
    (tc-top-env-reresolve-caches! ctx base-env)
    (match (tc-build-top-env-list-explicit-in-module
      ctx
      splice
      base-env
      module
      module-id)
      [(ResultTcEnv.Ok splice-env)
        (ResultTcEnv.Ok (tc-env-with-cache-layer-over-explicit splice-env))]
      [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))

(define (macro-splice-top-env
  [ctx : TcContext]
  [_program : ast.AstProgram]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [plan : MacroSpliceEnvPlan]) : ResultTcEnv
  (match plan
    [(MacroSpliceEnvPlan.Extend base-env splice)
      (tc-extend-top-env-for-splice ctx base-env splice module module-id)]
    [(MacroSpliceEnvPlan.ExtendGeneratedModule base-env summary marker)
      (match (env-extend-with-module ctx base-env summary)
        [(ResultTcEnv.Ok module-env)
          (match (macro-extend-top-env-with-module-marker
            ctx
            module-env
            decls
            marker
            module
            module-id)
            [(ResultTcEnv.Ok marker-env)
              (begin
                ;; The marker records a named lazy-import surface before old
                ;; unresolved signatures are revisited. The combined summary
                ;; + marker prefix is then cached once.
                (tc-top-env-reresolve-caches! ctx marker-env)
                (ResultTcEnv.Ok
                  (tc-env-with-cache-layer-over-explicit marker-env)))]
            [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]))

(define (macro-expand-rebuild-context-for-splice
  [cur-ctx : TcContext]
  [next-decls : ast.AstDeclList]
  [next-paths : ast.AstDeclPathList]
  [module : String]
  [module-id : i64]
  [env-plan : MacroSpliceEnvPlan]) : ResultMacroSpliceRebuild
  (let
    [state : TcMacroState (tc-context-macro-state cur-ctx)]
    [pools : ast.AstNodePoolContext (tc-context-pools cur-ctx)]
    [reuse-segmented? : bool
      (and
        (tc-macro-walk-field state macro-live-symbols-ready)
        (not (tc-macro-walk-field state macro-live-symbols-fallback))
        (tc-macro-walk-field state macro-live-registries-ready)
        (not (tc-macro-walk-field state macro-live-registries-fallback)))]
    [next-program : ast.AstProgram
      (if reuse-segmented?
        (tc-context-program cur-ctx)
        (macro-expand-scratch-program state next-decls))]
    (begin
      ;; Existing symbol handles and their cached owner names remain stable
      ;; across an append-only splice. The one-entry type lookup also caches a
      ;; missing result, so additions invalidate that entry alone. Cloneability
      ;; is reset at expansion entry and populated only after expansion; a
      ;; per-splice reset cannot change its state.
      (tc-resolve-type-name-cache-reset!)
      ;; Program-position and import-derived alias indexes can contain negative
      ;; answers and refer to the replaced flat program view. Keep their shared
      ;; invalidation until they gain an insert API of their own.
      (macro-alias-derived-cache-reset-for-state! state)
      (tc-job-state-reset-derived-caches! (tc-context-job-state cur-ctx))
      ;; Do not reset ctfe-module-macro-export here: the export set is stable
      ;; across the splice (additive-inert) and is owned by macro-live-prescan-
      ;; ensure!, which repopulates it when the prescan is recomputed. Clearing it
      ;; here would leave module-hook / module-export-macro? with an empty map for
      ;; the spliced tail's expansion.
      (match (macro-live-symbols-build-or-reuse! state next-program next-paths)
        [(csym.ResultCompilerSymbols.Ok next-symbols)
          (let
            [next-registries : csym.CompilerRegistries
              (macro-live-registries-shared-view state)]
            [next-ctx : TcContext
              (tc-context-new-with-source-names-and-body-state
                next-program
                next-symbols
                next-registries
                ""
                cbi.compiler-builtin-id-fix-empty
                pools
                (tc-context-source-names cur-ctx)
                (tc-context-body-state cur-ctx))]
            [_definition-paths : unit
              (macro-definition-paths-index! next-ctx next-decls next-paths)]
            (begin
              (tc-macro-walk-set! state macro-expand-active-module "")
              (macro-expand-set-macro-names!
                state
                (tc-macro-walk-field state macro-live-prescan-visible-names))
              (match (tc-stdlib-comptime-surface-ok-for-macro next-ctx)
                [(ResultTcUnit.Ok)
                  (match (macro-splice-top-env
                    next-ctx
                    next-program
                    next-decls
                    module
                    module-id
                    env-plan)
                    [(ResultTcEnv.Ok top-env)
                      (begin
                        (tc-hygiene-reset-active-top-env! state top-env)
                        (tc-context-capture-active-pools! next-ctx)
                        (macro-expand-ctfe-env-build-once! next-ctx)
                        (ResultMacroSpliceRebuild.Ok
                          (tc-context-with-module-id next-ctx module module-id)
                          top-env))]
                    [(ResultTcEnv.Err message)
                      (ResultMacroSpliceRebuild.Err
                        (box (tc-diag-at-start message)))])]
                [(ResultTcUnit.Err message)
                  (ResultMacroSpliceRebuild.Err
                    (box (tc-diag-at-start message)))])))]
        [(csym.ResultCompilerSymbols.Err message)
          (ResultMacroSpliceRebuild.Err
            (box (csym.compiler-symbols-last-error-diagnostic message)))]))))

(define (macro-decl-generated-normal-import? [decl : ast.AstDecl]) : bool
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.Some _ _ _ _ _ _) true]
    [(MacroMaybeGeneratedNormalImport.No) false]))

;; The single demand-driven expansion walk. Every macro placeholder is expanded
;; and its splice forced inline: the walk rebuilds the whole-program
;; symbols/env over the spliced view (macro-expand-rebuild-context-for-splice)
;; and then continues over the spliced body itself, so nested placeholders and
;; module placeholders resolve in this same pass. Generated *file* imports (a
;; generated module body importing a source file, or a generated module import
;; of a not-yet-loaded module) are loaded inline through the threaded loader
;; context (stdlib-roots + cfgs) exactly as the retired fixed-point loop's
;; macro-materialize-generated-imports step did -- there is no deferred
;; fallback pass and no follow-up worklist.
(define (macro-expand-decls
  [load-state : cload.CompilerLoadSessionState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [module : String]
  [module-id : i64]
  [can-share : bool]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [initial-materialize-seen : sym_i64_env.SymI64Env]
  [initial-out-rev : ast.AstDeclList]
  [initial-out-paths-rev : ast.AstDeclPathList]) : ResultMacroDeclsWithPaths
  (let
    ;; Generated file imports need the loader's duplicate-path/module set.
    ;; Seed it once, then extend it with each macro splice and loader result;
    ;; rebuilding it from the whole expanded program per import retained tens
    ;; of megabytes of obsolete persistent-env bindings.
    [cur-materialize-seen : sym_i64_env.SymI64Env initial-materialize-seen]
    [walk-state : TcJobState (tc-context-job-state ctx)]
    [macro-state : TcMacroState (tc-job-state-macro-state walk-state)]
    [cur-module : String module]
    [cur-module-id : i64 module-id]
    [cur-orig-decls : ast.AstDeclList orig-decls]
    [cur-ctx : TcContext ctx]
    [cur-top-env : TcTypeEnv top-env]
    [cur-can-share : bool can-share]
    [out-rev : ast.AstDeclList initial-out-rev]
    [out-paths-rev : ast.AstDeclPathList initial-out-paths-rev]
    [result : ResultMacroDeclsWithPaths
      (ResultMacroDeclsWithPaths.Err
        (box (tc-diag-at-start "macro: internal decl expansion walk")))]
    [done : bool false]
    (begin
      (macro-segmented-program-begin!
        walk-state
        out-rev
        out-paths-rev
        decls
        paths)
      (while (not done)
        (begin
          (cfg compile-profile (compiler-tc-walk-decl-sample-flush!))
          (match (if (macro-segmented-program-empty? walk-state)
            (ast.AstDeclListStep.Nil)
            (ast.AstDeclListStep.Cons
              (macro-segmented-program-current-decl walk-state)
              (ast.ast-decl-list-new)))
            [(ast.AstDeclListStep.Nil)
              (let
                [_final-flatten-start : unit
                  (cfg
                    compile-profile
                    (compiler-tc-walk-segment-final-flatten-start!))]
                [final-decls : ast.AstDeclList
                  (macro-decl-list-reverse out-rev)]
                [final-paths : ast.AstDeclPathList
                  (macro-decl-path-list-reverse out-paths-rev)]
                [_final-flatten-finish : unit
                  (cfg
                    compile-profile
                    (compiler-tc-walk-segment-final-flatten-finish!))]
                (begin
                  (set!
                    result
                    (ResultMacroDeclsWithPaths.Ok final-decls final-paths))
                  (set! done true)))]
            [(ast.AstDeclListStep.Cons decl _rest)
              (let
                [decl-path : String
                  (macro-segmented-program-current-path walk-state)]
                [decl-owner-id : i64
                  (macro-segmented-program-current-owner-id walk-state)]
                [decl-provenance-id : i64
                  (macro-segmented-program-current-provenance-id walk-state)]
                [_set-decl-owner : unit
                  (tc-macro-walk-set!
                    macro-state
                    macro-active-decl-owner-id
                    decl-owner-id)]
                [_set-decl-provenance : unit
                  (tc-macro-walk-set!
                    macro-state
                    macro-active-decl-provenance-id
                    decl-provenance-id)]
                (match decl
                  [(ast.AstDecl.Module next-module)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-tc-walk-decl-sample-note! 1))
                      (set!
                        out-rev
                        (ast.ast-decl-list-prepend-builder decl out-rev))
                      (set!
                        out-paths-rev
                        (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
                          decl-path
                          decl-owner-id
                          decl-provenance-id
                          out-paths-rev))
                      (macro-segmented-program-advance! walk-state)
                      (macro-segmented-program-prefix-set!
                        walk-state
                        out-rev
                        out-paths-rev)
                      (set! cur-module (tc-env-key-name-text next-module))
                      (set! cur-module-id next-module))]
                  [_
                    (cond
                      [(macro-decl-import-placeholder? decl)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-walk-decl-sample-note! 3))
                          ;; R3-P2b: an import placeholder's expansion is
                          ;; the single largest allocator left in the splice
                          ;; family (measured 113.1 MB retained over 88 events
                          ;; on the opt1 self-compile, 53% of the family) and
                          ;; R3-P1 left it on the ambient arena. Run it in its
                          ;; own generation, on the SPLICE ring -- see
                          ;; macro-splice-generation-enter! for why the ring,
                          ;; and not R3-P1's batch ring, is the sound one.
                          (match (macro-expand-decl-with-path-splice-generational
                            cur-ctx
                            cur-top-env
                            cur-top-env
                            cur-orig-decls
                            cur-module
                            cur-module-id
                            decl
                            decl-path)
                            [(ResultMacroDeclExpansion.Ok
                                expanded
                                expanded-paths)
                              ;; A deduplicated splice (see
                              ;; macro-decls-splice-with-memo) expands to nothing:
                              ;; drop the placeholder and keep walking -- there is
                              ;; no new name, so no context rebuild is needed.
                              (match (ast.ast-decl-list-step expanded)
                                [(ast.AstDeclListStep.Nil)
                                  (macro-segmented-program-advance! walk-state)]
                                [_
                                  (if (and
                                    (macro-decl-module-import-placeholder? decl)
                                    (macro-module-import-marker-only? expanded))
                                    (let
                                      [_update-materialize-seen : unit
                                        (set!
                                          cur-materialize-seen
                                          (macro-materialize-seen-from
                                            (& expanded)
                                            (& expanded-paths)
                                            cur-materialize-seen
                                            cur-module-id))]
                                      [_sp-probe-copy-start : unit
                                        (cfg
                                          compile-profile
                                          (compiler-tc-walk-sp-probe-start! 0)
                                          unit)]
                                      [_segment-splice : unit
                                        (macro-segmented-program-splice-current!
                                          walk-state
                                          expanded
                                          expanded-paths)]
                                      [_commit-marker-prefix : unit
                                        (let
                                          [remaining : i64
                                            (ast.ast-decl-list-len (& expanded))]
                                          (begin
                                            (set!
                                              out-rev
                                              (macro-decl-list-reverse-into
                                                expanded
                                                out-rev))
                                            (set!
                                              out-paths-rev
                                              (macro-decl-path-list-reverse-into
                                                expanded-paths
                                                out-paths-rev))
                                            (while (> remaining 0)
                                              (begin
                                                (macro-segmented-program-advance!
                                                  walk-state)
                                                (set! remaining (- remaining 1))))
                                            (macro-segmented-program-prefix-set!
                                              walk-state
                                              out-rev
                                              out-paths-rev)))]
                                      ;; Consecutive markers can share one raw
                                      ;; delta prefix. Lookups still see every
                                      ;; imported binding, but the explicit cache
                                      ;; and unresolved-signature pass are paid
                                      ;; once when the marker batch ends.
                                      [defer-cache? : bool
                                        (macro-segmented-program-current-starts-module-import-placeholder?
                                          walk-state)]
                                      [_sp-probe-copy-finish : unit
                                        (cfg
                                          compile-profile
                                          (compiler-tc-walk-sp-probe-finish! 0)
                                          unit)]
                                      (begin
                                        (cfg
                                          compile-profile
                                          (compiler-tc-walk-sp-probe-start! 1))
                                        (match (let
                                          [extend-result : ResultTcEnv
                                            (macro-extend-top-env-with-module-marker
                                              cur-ctx
                                              cur-top-env
                                              cur-orig-decls
                                              expanded
                                              cur-module
                                              cur-module-id)]
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-sp-probe-finish!
                                                1))
                                            extend-result))
                                          [(ResultTcEnv.Ok next-top-env)
                                            (begin
                                              (tc-nominal-owner-cache-reset!)
                                              (macro-alias-derived-cache-reset-for-state!
                                                macro-state)
                                              (tc-job-state-reset-derived-caches!
                                                (tc-context-job-state cur-ctx))
                                              (if defer-cache?
                                                (begin
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-decl-sample-note!
                                                      4))
                                                  (set!
                                                    cur-top-env
                                                    next-top-env))
                                                (begin
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-decl-sample-note!
                                                      5))
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-sp-probe-start!
                                                      4))
                                                  (tc-top-env-reresolve-caches!
                                                    cur-ctx
                                                    next-top-env)
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-sp-probe-finish!
                                                      4))
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-sp-probe-start!
                                                      2))
                                                  (set!
                                                    cur-top-env
                                                    (tc-env-with-cache-layer-over-explicit
                                                      next-top-env))
                                                  (cfg
                                                    compile-profile
                                                    (compiler-tc-walk-sp-probe-finish!
                                                      2))))
                                              unit)]
                                          [(ResultTcEnv.Err message)
                                            (begin
                                              (set!
                                                result
                                                (ResultMacroDeclsWithPaths.Err
                                                  (box
                                                    (tc-diag-at-start message))))
                                              (set! done true))])
                                        unit))
                                    ;; Force the splice inline: append the generated
                                    ;; symbols/registries and rebuild the context over
                                    ;; the spliced whole-program view. The top env takes
                                    ;; only the declaration delta, then the walk continues
                                    ;; over the spliced body itself (nested placeholders
                                    ;; and generated file imports included).
                                    (let
                                      [_update-materialize-seen : unit
                                        (set!
                                          cur-materialize-seen
                                          (macro-materialize-seen-from
                                            (& expanded)
                                            (& expanded-paths)
                                            cur-materialize-seen
                                            cur-module-id))]
                                      [_segment-splice : unit
                                        (macro-segmented-program-splice-current!
                                          walk-state
                                          expanded
                                          expanded-paths)]
                                      [generated-ext : MacroMaybeGeneratedModuleExtension
                                        (macro-generated-module-extension
                                          macro-state
                                          expanded
                                          cur-module-id)]
                                      [symbols-inserted : bool
                                        (and
                                          (csym.compiler-symbols-insert-aliases-self-contained?
                                            expanded
                                            expanded)
                                          (macro-live-symbols-insert-decls!
                                            (tc-context-macro-state cur-ctx)
                                            expanded
                                            cur-module-id))]
                                      [registries-inserted : bool
                                        (and
                                          symbols-inserted
                                          (macro-live-registries-append-decls!
                                            (tc-context-macro-state cur-ctx)
                                            expanded
                                            expanded-paths
                                            cur-module-id))]
                                      [incremental? : bool
                                        (and
                                          symbols-inserted
                                          registries-inserted)]
                                      [_invalidate-fallback : unit
                                        (if incremental?
                                          unit
                                          (begin
                                            (macro-live-symbols-invalidate!
                                              (tc-context-macro-state cur-ctx))
                                            (macro-live-registries-invalidate!
                                              (tc-context-macro-state cur-ctx))))]
                                      [flat-view : MacroSegmentedProgramFlatView
                                        (if incremental?
                                          (MacroSegmentedProgramFlatView
                                            expanded
                                            expanded-paths)
                                          (macro-segmented-program-flatten-fallback
                                            walk-state
                                            1))]
                                      [next-decls : ast.AstDeclList
                                        flat-view.decls]
                                      [next-paths : ast.AstDeclPathList
                                        flat-view.paths]
                                      [_prescan-delta : unit
                                        (if incremental?
                                          (macro-live-prescan-append-decls!
                                            macro-state
                                            expanded
                                            cur-module-id)
                                          unit)]
                                      ;; Any reflection-relevant delta gets the
                                      ;; append-safety classification after the
                                      ;; post-splice registries exist. Fresh
                                      ;; ordinary Decls and generated Modules can
                                      ;; therefore share the same O(delta) path.
                                      [extend-ctfe-metadata? : bool
                                        (macro-decls-reflection-relevant?
                                          expanded)]
                                      [ctfe-build-generation-before : i64
                                        (tc-macro-walk-field
                                          macro-state
                                          macro-expand-ctfe-env-build-generation)]
                                      (begin
                                        (cfg
                                          compile-profile
                                          (compiler-tc-walk-decl-sample-note! 6))
                                        (cfg
                                          compile-profile
                                          (compiler-tc-walk-splice-flag-note!
                                            (if incremental?
                                              1
                                              2))
                                          unit)
                                        (cfg
                                          compile-profile
                                          (if extend-ctfe-metadata?
                                            (compiler-tc-walk-splice-flag-note!
                                              3)
                                            unit)
                                          unit)
                                        ;; Generated Module catalogs are usually
                                        ;; inert additions, but a full catalog can
                                        ;; legitimately introduce a defmacro. Its
                                        ;; name must be visible to the remaining
                                        ;; declarations in this same expansion
                                        ;; walk (for example `api.one` immediately
                                        ;; after `(import (catalog) as api)`).
                                        ;; Refresh the otherwise additive-inert
                                        ;; prescan before rebuilding the splice
                                        ;; context so the macro-name gate and CTFE
                                        ;; export map include that generated macro.
                                        (if (macro-program-has-defmacro?
                                          expanded)
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-tc-walk-splice-flag-note!
                                                5))
                                            (if incremental?
                                              unit
                                              (begin
                                                (macro-live-prescan-reset!
                                                  macro-state)
                                                (macro-live-prescan-ensure!
                                                  macro-state
                                                  next-decls)
                                                (macro-expand-set-expr-type-macro-names!
                                                  macro-state
                                                  (tc-macro-walk-field
                                                    macro-state
                                                    macro-live-prescan-expr-type-names))))
                                            (tc-macro-walk-set!
                                              macro-state
                                              ctfe-needs-metadata
                                              (or
                                                (tc-macro-walk-field
                                                  macro-state
                                                  ctfe-needs-metadata)
                                                (tc-macro-walk-field
                                                  macro-state
                                                  macro-live-prescan-has-defmacro)))
                                            unit)
                                          unit)
                                        (match (macro-expand-rebuild-context-for-splice
                                          cur-ctx
                                          next-decls
                                          next-paths
                                          cur-module
                                          cur-module-id
                                          (match generated-ext
                                            [(MacroMaybeGeneratedModuleExtension.No)
                                              (MacroSpliceEnvPlan.Extend
                                                cur-top-env
                                                expanded)]
                                            [(MacroMaybeGeneratedModuleExtension.Some
                                                summary
                                                marker)
                                              (MacroSpliceEnvPlan.ExtendGeneratedModule
                                                cur-top-env
                                                summary
                                                marker)]))
                                          [(ResultMacroSpliceRebuild.Ok
                                              next-ctx
                                              next-top-env)
                                            (begin
                                              ;; Extend the reused CTFE metadata
                                              ;; with the spliced module's nominal
                                              ;; declarations now that next-ctx
                                              ;; carries the post-splice registries
                                              ;; the layout build resolves through.
                                              ;; On any inapplicability fall back to
                                              ;; the established clear, which makes
                                              ;; the next consumer rebuild the full
                                              ;; metadata over the spliced program.
                                              (if extend-ctfe-metadata?
                                                (match (compiler-typecheck-ctfe-env-extend-for-splice!
                                                  next-ctx
                                                  expanded
                                                  expanded-paths
                                                  cur-module
                                                  cur-module-id
                                                  (match generated-ext
                                                    [(MacroMaybeGeneratedModuleExtension.Some
                                                        _
                                                        _)
                                                      true]
                                                    [(MacroMaybeGeneratedModuleExtension.No)
                                                      false])
                                                  (tc-context-registries
                                                    next-ctx)
                                                  ctfe-build-generation-before)
                                                  [(CompilerCtfeSpliceExtensionResult.SemanticRejected)
                                                    (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                                      next-ctx
                                                      1)]
                                                  [(CompilerCtfeSpliceExtensionResult.CacheUnavailable)
                                                    (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                                      next-ctx
                                                      1)]
                                                  [_ unit])
                                                unit)
                                              (set! cur-ctx next-ctx)
                                              (if incremental?
                                                unit
                                                (set! cur-orig-decls next-decls))
                                              (set! cur-top-env next-top-env)
                                              unit)]
                                          [(ResultMacroSpliceRebuild.Err diag)
                                            (begin
                                              (set!
                                                result
                                                (ResultMacroDeclsWithPaths.Err
                                                  diag))
                                              (set! done true))])
                                        unit)))])]
                            [(ResultMacroDeclExpansion.Err diag)
                              (begin
                                (set!
                                  result
                                  (ResultMacroDeclsWithPaths.Err diag))
                                (set! done true))]))]
                      [(macro-decl-generated-normal-import? decl)
                        ;; A generated module body imports a source file (or a
                        ;; not-yet-loaded module). Load it inline with the
                        ;; threaded loader context, refresh the hoisted prescan
                        ;; (the loaded file may define macros the rest of this
                        ;; walk must see and fire), rebuild the live symbols over
                        ;; the loaded view, extend the current top environment
                        ;; with the newly loaded declarations, and continue the
                        ;; walk over the loaded content -- what the retired fixed-
                        ;; point loop's materialization + re-pass did, inline in
                        ;; this pass. Source-file materialization remains a full
                        ;; symbol/registry rebuild because it can add arbitrary
                        ;; index-bearing declarations; the environment itself is
                        ;; additive and can use the same refresh path as a macro
                        ;; splice instead of retaining another whole-program env.
                        (begin
                          (macro-expand-program-structural-change-note!
                            macro-state
                            4)
                          (cfg
                            compile-profile
                            (compiler-tc-walk-decl-sample-note! 7))
                          (let
                            ;; Keep the pools context's captured state current
                            ;; around the loader: it parses new content into the
                            ;; active pools, and a later install of a stale capture
                            ;; would roll the pool length back and let subsequent
                            ;; allocations overwrite the loaded (and previously
                            ;; spliced) nodes.
                            [_capture-before-load : unit
                              (tc-context-capture-active-pools! cur-ctx)]
                            (match (macro-materialize-generated-import-with-provenance
                              load-state
                              decl
                              decl-path
                              decl-owner-id
                              decl-provenance-id
                              cur-module
                              cur-module-id
                              cur-materialize-seen
                              stdlib-roots
                              cfgs
                              (tc-context-pools cur-ctx))
                              [(ResultMacroMaterializeImport.Ok
                                  materialized-decls
                                  materialized-paths
                                  next-materialize-seen)
                                (let
                                  [_install-after-load : unit
                                    (tc-context-install-pools! cur-ctx)]
                                  [_segment-splice : unit
                                    (macro-segmented-program-splice-current!
                                      walk-state
                                      materialized-decls
                                      materialized-paths)]
                                  ;; Source-file materialization is the explicit
                                  ;; conservative fallback: arbitrary aliases and
                                  ;; index-bearing declarations require fresh
                                  ;; whole-program symbols and registries.
                                  [flat-view : MacroSegmentedProgramFlatView
                                    (macro-segmented-program-flatten-fallback
                                      walk-state
                                      2)]
                                  [next-decls : ast.AstDeclList flat-view.decls]
                                  [next-paths : ast.AstDeclPathList
                                    flat-view.paths]
                                  [extend-ctfe-metadata? : bool
                                    (macro-decls-reflection-relevant?
                                      materialized-decls)]
                                  [ctfe-build-generation-before : i64
                                    (tc-macro-walk-field
                                      macro-state
                                      macro-expand-ctfe-env-build-generation)]
                                  (begin
                                    (set!
                                      cur-materialize-seen
                                      next-materialize-seen)
                                    ;; The loaded file may add defmacros or
                                    ;; expr-type macros: recompute the hoisted
                                    ;; prescan over the new whole-program view
                                    ;; before the context rebuild consumes its
                                    ;; visible-name set.
                                    (macro-live-symbols-invalidate!
                                      (tc-context-macro-state cur-ctx))
                                    ;; Source-file materialization can insert any
                                    ;; index-bearing declaration or alias surface,
                                    ;; so retain the full registry rebuild even
                                    ;; when it contains no nominal declaration.
                                    (macro-live-registries-invalidate!
                                      (tc-context-macro-state cur-ctx))
                                    (macro-live-prescan-ensure!
                                      macro-state
                                      next-decls)
                                    (macro-expand-set-expr-type-macro-names!
                                      macro-state
                                      (tc-macro-walk-field
                                        macro-state
                                        macro-live-prescan-expr-type-names))
                                    (tc-macro-walk-set!
                                      macro-state
                                      ctfe-needs-metadata
                                      (or
                                        (tc-macro-walk-field
                                          macro-state
                                          ctfe-needs-metadata)
                                        (tc-macro-walk-field
                                          macro-state
                                          macro-live-prescan-has-defmacro)))
                                    unit
                                    (match (macro-expand-rebuild-context-for-splice
                                      cur-ctx
                                      next-decls
                                      next-paths
                                      cur-module
                                      cur-module-id
                                      (MacroSpliceEnvPlan.Extend
                                        cur-top-env
                                        materialized-decls))
                                      [(ResultMacroSpliceRebuild.Ok
                                          next-ctx
                                          next-top-env)
                                        (begin
                                          (if extend-ctfe-metadata?
                                            (match (compiler-typecheck-ctfe-env-extend-for-splice!
                                              next-ctx
                                              materialized-decls
                                              materialized-paths
                                              cur-module
                                              cur-module-id
                                              false
                                              (tc-context-registries next-ctx)
                                              ctfe-build-generation-before)
                                              [(CompilerCtfeSpliceExtensionResult.SemanticRejected)
                                                (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                                  next-ctx
                                                  2)]
                                              [(CompilerCtfeSpliceExtensionResult.CacheUnavailable)
                                                (compiler-typecheck-ctfe-env-rebuild-for-splice!
                                                  next-ctx
                                                  2)]
                                              [_ unit])
                                            unit)
                                          (set! cur-ctx next-ctx)
                                          (set! cur-orig-decls next-decls)
                                          (set! cur-top-env next-top-env)
                                          unit)]
                                      [(ResultMacroSpliceRebuild.Err diag)
                                        (begin
                                          (set!
                                            result
                                            (ResultMacroDeclsWithPaths.Err diag))
                                          (set! done true))])))]
                              [(ResultMacroMaterializeImport.Err diag)
                                (begin
                                  (set!
                                    result
                                    (ResultMacroDeclsWithPaths.Err diag))
                                  (set! done true))])))]
                      [(and
                          cur-can-share
                          (macro-decl-cannot-fire-gate?
                            macro-state
                            (tc-context-expr-bases cur-ctx)
                            decl))
                        ;; Predict-skip: a macro-free value decl can never fire a
                        ;; macro, so share it unchanged (like the AstDecl.Module
                        ;; arm) instead of copying it through the expander. This
                        ;; avoids the per-decl `tc-context-with-module` allocation
                        ;; and the single-element relist that
                        ;; `macro-expand-decl-with-path` would otherwise retain in
                        ;; the installed pools. A non-module value decl never
                        ;; changes the active module, so `cur-module` is unchanged.
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-macro-profile-note-walk-decl-shared))
                          (cfg
                            compile-profile
                            (compiler-tc-walk-decl-sample-note! 1))
                          (set!
                            out-rev
                            (ast.ast-decl-list-prepend-builder decl out-rev))
                          (set!
                            out-paths-rev
                            (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
                              decl-path
                              decl-owner-id
                              decl-provenance-id
                              out-paths-rev))
                          (macro-segmented-program-advance! walk-state)
                          (macro-segmented-program-prefix-set!
                            walk-state
                            out-rev
                            out-paths-rev))]
                      [else
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-macro-profile-note-walk-decl-expanded))
                          (cfg
                            compile-profile
                            (compiler-tc-walk-decl-sample-note! 2))
                          ;; R3-P1: this is the only arm that runs a macro over
                          ;; a declaration body, and its superseded intermediate
                          ;; forms are the macro arena's dominant owner. Expand
                          ;; it in its own generation and commit the survivor.
                          (match (match (macro-env-for-module
                            cur-ctx
                            cur-top-env
                            cur-module
                            cur-module-id)
                            [(ResultTcEnv.Ok local-env)
                              (macro-expand-decl-with-path-generational
                                cur-ctx
                                cur-top-env
                                local-env
                                cur-orig-decls
                                cur-module
                                cur-module-id
                                decl
                                decl-path)]
                            [(ResultTcEnv.Err message)
                              (ResultMacroDeclExpansion.Err
                                (box (tc-decl-diag decl message)))])
                            [(ResultMacroDeclExpansion.Ok
                                expanded
                                expanded-paths)
                              (begin
                                (set!
                                  out-rev
                                  (macro-decl-list-reverse-into
                                    expanded
                                    out-rev))
                                (set!
                                  out-paths-rev
                                  (macro-decl-path-list-reverse-into
                                    expanded-paths
                                    out-paths-rev))
                                (set!
                                  cur-module-id
                                  (macro-decls-final-module-id
                                    expanded
                                    cur-module-id))
                                (set!
                                  cur-module
                                  (macro-decl-module-display cur-module-id))
                                (macro-segmented-program-advance! walk-state)
                                (macro-segmented-program-prefix-set!
                                  walk-state
                                  out-rev
                                  out-paths-rev))]
                            [(ResultMacroDeclExpansion.Err diag)
                              (begin
                                (set!
                                  result
                                  (ResultMacroDeclsWithPaths.Err diag))
                                (set! done true))]))])]))])))
      (macro-segmented-program-end! walk-state)
      result)))

(define (macro-expr-needs-compat-expansion?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [when-id : i64]
  [unless-id : i64]) : bool
  ;; One walk matching both ids; per-Var comparison is the exact id form of
  ;; the two string-keyed walks it replaces (see tc-env-key-source-id-or-neg).
  (tc-expr-uses-free-source-id?
    expr-bases
    expr
    when-id
    unless-id
    TcNameIdList.Nil))

(define (macro-decl-needs-expansion?
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [when-id : i64]
  [unless-id : i64]) : bool
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases expr-box)]
        (macro-expr-needs-compat-expansion? expr-bases expr when-id unless-id))]
    [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (macro-expr-needs-compat-expansion? expr-bases body when-id unless-id))]
    [(ast.AstDecl.DefMacro decl-meta _ _ _ _) true]
    [(ast.AstDecl.Test _ _ _) false]
    [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(ast.AstImportKind.Macro _ _) true]
        [(ast.AstImportKind.MacroDecls _ _) true]
        [_ false])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (macro-decl-needs-expansion? expr-bases inner when-id unless-id))]
    [_ false]))

(define (macro-decl-has-defmacro? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.DefMacro decl-meta _ _ _ _) true]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (macro-decl-has-defmacro? inner))]
    [_ false]))

;; Whether a program needs the macro expansion pass. The when/unless intern
;; ids are found once per scan and threaded through the per-declaration
;; prescan.
(define (macro-program-needs-expansion?
  [expr-bases : i64]
  [decls : ast.AstDeclList]) : bool
  (macro-program-needs-expansion-with-ids?
    expr-bases
    decls
    (ci.intern "when")
    (ci.intern "unless")))

(define (macro-program-needs-expansion-with-ids?
  [expr-bases : i64]
  [decls : ast.AstDeclList]
  [when-id : i64]
  [unless-id : i64]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (or
          (macro-decl-needs-expansion? expr-bases decl when-id unless-id)
          (macro-program-needs-expansion-with-ids?
            expr-bases
            rest
            when-id
            unless-id)))]))

(define (macro-program-has-defmacro? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (or (macro-decl-has-defmacro? decl) (macro-program-has-defmacro? rest)))]))

(define (macro-decl-might-fire-expression-macro?
  [state : TcMacroState]
  [expr-bases : i64]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases expr-box))]
    [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
      (macro-expr-might-fire?
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box))]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-decl-might-fire-expression-macro?
        state
        expr-bases
        (__tl-box-place inner-box))]
    [_ false]))

(define (macro-program-might-fire-expression-macro?
  [state : TcMacroState]
  [expr-bases : i64]
  [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-might-fire-expression-macro? state expr-bases decl)
        (macro-program-might-fire-expression-macro? state expr-bases rest))]))

(define (macro-import-kind-summary-backed? [kind : ast.AstImportKind]) : bool
  (match kind
    [(ast.AstImportKind.Module) true]
    [_ false]))

(define (macro-import-target-has-summary-macro?
  [kind : ast.AstImportKind]
  [target : ast.AstMaybeModuleName]) : bool
  (if (macro-import-kind-summary-backed? kind)
    (match target
      [(ast.AstMaybeModuleName.Some target-module)
        (macro-surface-module-has-macro? target-module)]
      [(ast.AstMaybeModuleName.No) false])
    false))

(define (macro-decl-has-summary-macro-import? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind _ target _ _))
      (macro-import-target-has-summary-macro? kind target)]
    [(ast.AstDecl.Unsafe inner-box)
      (macro-decl-has-summary-macro-import? (__tl-box-place inner-box))]
    [_ false]))

(define (macro-program-has-summary-macro-import? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-has-summary-macro-import? decl)
        (macro-program-has-summary-macro-import? rest))]))

(defstruct MacroSurfacePrefixModule
  (name String)
  (name-id i64))

(defenum MacroSurfacePrefixPlan
  (Cold)
  (Hydrated
    ast.AstDeclList
    ast.AstDeclPathList
    String
    i64
    sym_i64_env.SymI64Env
    ast.AstDeclList
    ast.AstDeclPathList
    i64))

(define (macro-surface-prefix-module [decls : ast.AstDeclList]) : MacroSurfacePrefixModule
  (let
    [cur : ast.AstDeclList decls]
    [module : String ""]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast.ast-decl-list-step cur)
          [(ast.AstDeclListStep.Nil) (set! done true)]
          [(ast.AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(ast.AstDecl.Module next-module)
                  (begin
                    (set! module (tc-env-key-name-text next-module))
                    (set! module-id next-module))]
                [_ unit])
              (set! cur rest))]))
      (MacroSurfacePrefixModule module module-id))))

(cfg
  compile-profile
  (define (macro-profile-surface-prefix-hit [count : i64]) : unit
    (cfg
      compile-profile-summary
      unit
      (begin
        (io.print-error
          "compile-profile-detail|prelude.macro_walk_decl_visits|0\n")
        (io.print-error
          (str_cat.str-cat
            "compile-profile-detail|prelude.macro_walk_skipped_decls|"
            (string.int->string count)
            "\n"))))))

;; Package imports are flattened at their source import sites, between
;; entry-owned module/alias markers. Provenance is the stable discriminator:
;; scan through the last declaration copied from an admitted dependency and
;; include every harmless marker before it in the authenticated prefix.
(define (tc-dependency-surface-prefix-candidate
  [load-state : cload.CompilerLoadSessionState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [cache-scope : String]
  [surface-count : i64]) : TcPrefixCandidate
  (let
    [decl-count : i64 (ast.ast-decl-list-len (& decls))]
    [path-count : i64 (ast.ast-decl-path-list-len (& paths))]
    [index : i64 0]
    [remaining : i64 surface-count]
    [module : String ""]
    [module-id : i64 cbi.compiler-builtin-id-fix-empty]
    (if (<= surface-count 0)
      TcPrefixCandidate.No
      (begin
        (while (and (> remaining 0) (< index decl-count) (< index path-count))
          (let
            [decl : ast.AstDecl
              (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
            [provenance-id : i64
              (ast.ast-decl-path-list-provenance-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty)]
            (begin
              (if (cload.compiler-load-session-state-dependency-surface-provenance?
                load-state
                provenance-id)
                (set! remaining (- remaining 1))
                unit)
              (match decl
                [(ast.AstDecl.Module next-module)
                  (begin
                    (set! module (tc-env-key-name-text next-module))
                    (set! module-id next-module))]
                [_ unit])
              (set! index (+ index 1)))))
        (if (= remaining 0)
          (TcPrefixCandidate.Some
            (tc-prefix-key-start cache-scope)
            index
            module
            module-id)
          TcPrefixCandidate.No)))))

(define (macro-surface-prefix-plan
  [load-state : cload.CompilerLoadSessionState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]) : MacroSurfacePrefixPlan
  (if (surface_facts.surface-typecheck-facts-active?)
    (let
      [facts : surface_facts.SurfaceTypecheckFacts
        (surface_facts.surface-typecheck-facts-current)]
      [count : i64
        (if (surface_facts.surface-typecheck-facts-composite-active?)
          (match (tc-dependency-surface-prefix-candidate
            load-state
            decls
            paths
            (tc-prefix-default-cache-scope)
            (cload.compiler-load-session-state-dependency-surface-provenance-count
              load-state))
            [(TcPrefixCandidate.Some _ candidate-count _ _)
              (if (surface_facts.surface-typecheck-facts-rebase-composite-macro-prefix!
                candidate-count)
                candidate-count
                0)]
            [(TcPrefixCandidate.No) 0])
          facts.macro-prefix-decl-count)]
      [decl-count : i64 (ast.ast-decl-list-len (& decls))]
      [path-count : i64 (ast.ast-decl-path-list-len (& paths))]
      (if (and (> count 0) (< count decl-count) (<= count path-count))
        (let
          [prefix-decls : ast.AstDeclList (tc-decl-list-take decls count)]
          [prefix-paths : ast.AstDeclPathList
            (tc-decl-path-list-take paths count)]
          [module : MacroSurfacePrefixModule
            (macro-surface-prefix-module prefix-decls)]
          (begin
            (if (surface_facts.surface-typecheck-facts-composite-active?)
              (cload.compiler-load-session-state-dependency-surface-note-macro-skip!
                load-state
                count)
              unit)
            (cfg compile-profile (macro-profile-surface-prefix-hit count))
            (MacroSurfacePrefixPlan.Hydrated
              (tc-decl-list-drop decls count)
              (tc-decl-path-list-drop paths count)
              module.name
              module.name-id
              (macro-materialize-seen-from
                (& decls)
                (& paths)
                (sym_i64_env.sym-i64-empty)
                cbi.compiler-builtin-id-fix-empty)
              (macro-decl-list-reverse prefix-decls)
              (macro-decl-path-list-reverse prefix-paths)
              count)))
        (begin
          (if (surface_facts.surface-typecheck-facts-composite-active?)
            (surface_facts.surface-typecheck-facts-clear!)
            unit)
          (MacroSurfacePrefixPlan.Cold))))
    (MacroSurfacePrefixPlan.Cold)))

(define (macro-expand-decls-with-surface-prefix
  [load-state : cload.CompilerLoadSessionState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroDeclsWithPaths
  (match (macro-surface-prefix-plan load-state decls paths)
    [(MacroSurfacePrefixPlan.Cold)
      (macro-expand-decls
        load-state
        ctx
        top-env
        decls
        decls
        paths
        ""
        cbi.compiler-builtin-id-fix-empty
        true
        stdlib-roots
        cfgs
        (macro-materialize-seen-from
          (& decls)
          (& paths)
          (sym_i64_env.sym-i64-empty)
          cbi.compiler-builtin-id-fix-empty)
        (ast.ast-decl-list-new)
        (ast.ast-decl-path-list-new))]
    [(MacroSurfacePrefixPlan.Hydrated
        suffix-decls
        suffix-paths
        module
        module-id
        materialize-seen
        prefix-rev
        prefix-paths-rev
        _)
      (macro-expand-decls
        load-state
        ctx
        top-env
        decls
        suffix-decls
        suffix-paths
        module
        module-id
        true
        stdlib-roots
        cfgs
        materialize-seen
        prefix-rev
        prefix-paths-rev)]))

;; Expand all macro calls in a parsed program before typechecking. Programs that
;; need no macro or guard-compatibility expansion are returned unchanged without
;; rebuilding the AST, so the expansion phase adds no allocation for the common
;; case.
(define (macro-expand-program-pass-with-paths-and-pools
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (begin
    (tc-install-pools! pools)
    (match program
      [(ast.AstProgram.Program decls-box)
        (let
          [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
          [decls : ast.AstDeclList (__tl-box-place decls-box)]
          [_prescan : unit (macro-live-prescan-ensure! macro-state decls)]
          [has-defmacro : bool
            (tc-macro-walk-field macro-state macro-live-prescan-has-defmacro)]
          [expr-type-macro-names : TcNameIdList
            (tc-macro-walk-field macro-state macro-live-prescan-expr-type-names)]
          [has-expr-type-macros : bool
            (match expr-type-macro-names
              [(TcNameIdList.Nil) false]
              [_ true])]
          [program-needs-expansion : bool
            (tc-macro-walk-field macro-state macro-live-prescan-needs-expansion)]
          [has-summary-macro-import : bool
            (tc-macro-walk-field macro-state macro-live-prescan-summary-import)]
          [prescan-macro-names : TcNameIdList
            (if has-summary-macro-import
              (tc-macro-walk-field macro-state macro-live-prescan-visible-names)
              (TcNameIdList.Nil))]
          [has-visible-macro-call : bool
            (if has-summary-macro-import
              (begin
                (macro-expand-set-macro-names! macro-state prescan-macro-names)
                (macro-program-might-fire-expression-macro?
                  macro-state
                  (ast.ast-node-pool-context-expr-segment-bases pools)
                  decls))
              false)]
          (begin
            ;; The CTFE-env cache is reset once per program at the macro-expand
            ;; entry and rebuilt at most once per run by
            ;; macro-expand-ctfe-env-build-once! below, then reused (rebased onto
            ;; the active pools) across every in-pass splice rebuild.
            (cfg compile-profile (compiler-tc-macro-profile-reset))
            (cfg compile-profile (compiler-tc-env-profile-reset))
            ;; Same per-compile reset for the clone-able type set cache.
            (tc-clone-able-cache-reset!)
            ;; Type-name misses are keyed only by lookup text; in-pass splice
            ;; rebuilds swap in a different expanded program, so a miss recorded
            ;; against an earlier view must not hide generated module-local
            ;; types introduced since.
            (tc-nominal-owner-cache-reset!)
            ;; Same per-compile reset for the qualified-alias resolution cache:
            ;; the (module, qualifier) -> target mapping is derived from this
            ;; program's declarations.
            (macro-alias-derived-cache-reset-for-state! macro-state)
            (tc-job-state-reset-derived-caches! job-state)
            ;; The ctfe-module-macro-export map is not reset per pass: it is owned
            ;; by macro-live-prescan-ensure!, which populates it once (with the
            ;; cached visible-name prescan) and repopulates it on the non-inert
            ;; splice fallback. Clearing it here left every pass after the first
            ;; with an empty export set, breaking module-hook.
            (macro-expand-set-expr-type-macro-names!
              macro-state
              expr-type-macro-names)
            ;; Scan once for type literals and module-value queries. The latter
            ;; enables only the compact signature index; it must not force the
            ;; much larger layout/nominal-reflection metadata build.
            (ctfe_support.ctfe-module-value-reflection-enable-for-state!
              (tc-macro-ctfe-state macro-state)
              false)
            (let
              [has-type-literal : bool
                (ctfe-program-has-type-literal? macro-state decls)]
              (begin
                ;; Source macro bodies and ordinary comptime expressions are
                ;; visited by the combined scan above. Surface-summary macro
                ;; bodies are outside this AST, so conservatively enable the
                ;; compact index only for that imported-summary case.
                (if has-summary-macro-import
                  (ctfe_support.ctfe-module-value-reflection-enable-for-state!
                    (tc-macro-ctfe-state macro-state)
                    true)
                  unit)
                ;; Only build the (tens-of-MB, O(types^2))
                ;; reflection/layout metadata if the program actually contains
                ;; a `(type T)` literal or macros need reflection.
                (tc-macro-walk-set!
                  macro-state
                  ctfe-needs-metadata
                  (or
                    has-defmacro
                    has-visible-macro-call
                    has-type-literal
                    has-expr-type-macros))))
            (if (or has-defmacro has-visible-macro-call program-needs-expansion)
              (let
                [prefix-reserve : i64 1024]
                [active-decls : ast.AstDeclList
                  (macro-decl-list-with-prefix-reserve decls prefix-reserve)]
                [active-paths : ast.AstDeclPathList
                  (macro-decl-path-list-with-prefix-reserve
                    paths
                    prefix-reserve)]
                [active-program : ast.AstProgram (ast.ast-program active-decls)]
                (begin
                  (macro-expand-scratch-begin! macro-state)
                  (cfg compile-profile (compiler-tc-profile-start))
                  (match (macro-live-symbols-build-or-reuse!
                    macro-state
                    active-program
                    active-paths)
                    [(csym.ResultCompilerSymbols.Ok symbols)
                      (let
                        [registries : csym.CompilerRegistries
                          (macro-live-registries-shared-view macro-state)]
                        (begin
                          (tc-macro-walk-set!
                            macro-state
                            macro-expand-active-module
                            "")
                          (macro-expand-set-macro-names!
                            macro-state
                            (tc-macro-walk-field
                              macro-state
                              macro-live-prescan-visible-names))
                          (let
                            [ctx : TcContext
                              (tc-context-new-with-source-names-and-job-state
                                active-program
                                symbols
                                registries
                                ""
                                cbi.compiler-builtin-id-fix-empty
                                pools
                                source-names
                                job-state)]
                            [_definition-paths : unit
                              (macro-definition-paths-index!
                                ctx
                                active-decls
                                active-paths)]
                            (match (tc-stdlib-comptime-surface-ok-for-macro ctx)
                              [(ResultTcUnit.Ok)
                                (match (tc-build-top-env ctx active-program)
                                  [(ResultTcEnv.Ok top-env)
                                    (begin
                                      (tc-hygiene-reset-active-top-env!
                                        macro-state
                                        top-env)
                                      (tc-context-capture-active-pools! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-finish
                                          "macro_setup"))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-start))
                                      (macro-expand-ctfe-env-build-once! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-finish
                                          "macro_materialize"))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-start))
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-note-walk-share-gate
                                          true))
                                      (match (macro-expand-decls-with-surface-prefix
                                        load-state
                                        ctx
                                        top-env
                                        active-decls
                                        active-paths
                                        stdlib-roots
                                        cfgs)
                                        [(ResultMacroDeclsWithPaths.Ok
                                            ndecls
                                            npaths)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-env-profile-emit-prefix
                                                "macro_"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpand.Ok
                                              (ast.ast-program ndecls)
                                              npaths))]
                                        [(ResultMacroDeclsWithPaths.Err diag)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-env-profile-emit-prefix
                                                "macro_"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpand.Err diag))]))]
                                  [(ResultTcEnv.Err message)
                                    (ResultMacroExpand.Err
                                      (box (tc-diag-at-start message)))])]
                              [(ResultTcUnit.Err message)
                                (ResultMacroExpand.Err
                                  (box (tc-diag-at-start message)))]))))]
                    [(csym.ResultCompilerSymbols.Err message)
                      (ResultMacroExpand.Err
                        (box
                          (csym.compiler-symbols-last-error-diagnostic message)))])))
              (ResultMacroExpand.Ok program paths))))])))

(defenum MacroMaybeGeneratedNormalImport
  (No)
  (Some
    ast.AstImportKind
    String
    ast.AstMaybeModuleName
    ast.AstMaybeImportAlias
    ast.AstSourceSpan
    ast.AstDecl))

(defenum ResultMacroMaterializeImport
  (Ok ast.AstDeclList ast.AstDeclPathList sym_i64_env.SymI64Env)
  (Err (Box cdiag.CompilerDiagnostic)))

(define (macro-generated-normal-import [decl : ast.AstDecl]) : MacroMaybeGeneratedNormalImport
  (match (ast.ast-decl-generated-meta decl)
    [(ast.AstGeneratedDeclMeta.Some _ _ _ _)
      (let
        [template : ast.AstDecl (ast.ast-decl-unwrapped decl)]
        (match template
          [(ast.AstDecl.Import
              decl-meta
              (ast.AstImportSpec.Spec kind import-path expected alias span))
            (if (macro-import-placeholder-kind? kind)
              (MacroMaybeGeneratedNormalImport.No)
              (MacroMaybeGeneratedNormalImport.Some
                kind
                import-path
                expected
                alias
                (__tl-box-place span)
                template))]
          [_ (MacroMaybeGeneratedNormalImport.No)]))]
    [(ast.AstGeneratedDeclMeta.No) (MacroMaybeGeneratedNormalImport.No)]))

(define (macro-materialize-seen-from
  [decls : (& decls ast.AstDeclList)]
  [paths : (& paths ast.AstDeclPathList)]
  [seen : sym_i64_env.SymI64Env]
  [module-id : i64]) : sym_i64_env.SymI64Env
  (let
    [count : i64 (ast.ast-decl-list-len decls)]
    [path-count : i64 (ast.ast-decl-path-list-len paths)]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [out : sym_i64_env.SymI64Env seen]
    (begin
      (while (< index count)
        (let
          [decl-path : String
            (if (< index path-count)
              (ast.ast-decl-path-list-get paths index "")
              "")]
          [decl-owner-id : i64
            (if (< index path-count)
              (ast.ast-decl-path-list-owner-id
                paths
                index
                cbi.compiler-builtin-id-fix-empty)
              cbi.compiler-builtin-id-fix-empty)]
          (begin
            (if (and
              (> (string.string-length decl-path) 0)
              (not (= decl-owner-id cbi.compiler-builtin-id-fix-empty)))
              (set!
                out
                (sym_i64_env.sym-i64-bind-id
                  out
                  (cload.compiler-load-seen-path-key-id
                    decl-owner-id
                    cur-module-id)
                  1))
              unit)
            (match (ast.ast-decl-list-ref-borrowed decls index)
              [(ast.AstDecl.Module _)
                (match (array-ref decls.slots (+ decls.offset index))
                  [(ast.AstDecl.Module name)
                    (begin
                      (if (= name cbi.compiler-builtin-id-fix-empty)
                        unit
                        (set! out (sym_i64_env.sym-i64-bind-id out name 1)))
                      (set! cur-module-id name))]
                  [_ unit])]
              [_ unit])
            (set! index (+ index 1)))))
      out)))

(define (macro-materialize-import-diagnostic
  [path : String]
  [span : ast.AstSourceSpan]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-canonical-diagnostic
    (cdiag.compiler-diagnostic-from-ast-span path span message)))

(define (macro-materialize-generated-import-with-provenance
  [load-state : cload.CompilerLoadSessionState]
  [decl : ast.AstDecl]
  [decl-path : String]
  [decl-owner-id : i64]
  [decl-provenance-id : i64]
  [module : String]
  [module-id : i64]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : ast.AstNodePoolContext]) : ResultMacroMaterializeImport
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.No)
      (ResultMacroMaterializeImport.Ok
        (ast.ast-decl-cons decl (ast.ast-decl-list-new))
        (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
          decl-path
          decl-owner-id
          decl-provenance-id
          (ast.ast-decl-path-list-new))
        seen)]
    [(MacroMaybeGeneratedNormalImport.Some
        kind
        import-path
        expected
        alias
        span
        _)
      (let
        [import-root : String (cload.compiler-load-dirname decl-path)]
        (match (cload.compiler-load-resolve-import-spec-with-roots
          decl-path
          import-root
          kind
          import-path
          expected
          stdlib-roots)
          [(cload.ResultPkgResolve.Ok resolved)
            (match (cload.compiler-load-file-with-paths-and-roots-expect-cfg-root-import-with-state-and-pools
              load-state
              resolved
              (cload.compiler-load-resolved-path-id-for-generated-import-with-state
                load-state
                resolved
                expected)
              seen
              stdlib-roots
              kind
              import-path
              expected
              import-root
              cfgs
              pools
              module
              module-id)
              [(cload.ResultCompilerLoadWithPaths.Ok
                  imported-decls
                  imported-paths
                  _
                  next-seen)
                (let
                  [after-import-expected : ast.AstMaybeModuleName
                    (cload.compiler-load-after-import-expected-module
                      load-state
                      (cload.compiler-load-resolved-path-id-for-generated-import-with-state
                        load-state
                        resolved
                        expected)
                      kind
                      expected
                      alias
                      imported-decls)]
                  [after-import-alias : ast.AstMaybeImportAlias
                    (cload.compiler-load-after-import-alias
                      load-state
                      (cload.compiler-load-resolved-path-id-for-generated-import-with-state
                        load-state
                        resolved
                        expected)
                      kind
                      expected
                      alias
                      imported-decls)]
                  [tail-decls : ast.AstDeclList
                    (cload.compiler-load-decls-after-import
                      kind
                      resolved
                      after-import-expected
                      after-import-alias
                      span
                      module
                      module-id
                      imported-decls
                      (ast.ast-decl-list-new))]
                  [tail-paths : ast.AstDeclPathList
                    (cload.compiler-load-paths-after-import
                      decl-path
                      decl-provenance-id
                      decl-owner-id
                      after-import-alias
                      imported-decls
                      (ast.ast-decl-path-list-new))]
                  [materialized-decls : ast.AstDeclList
                    (macro-decl-list-append imported-decls tail-decls)]
                  [materialized-paths : ast.AstDeclPathList
                    (macro-decl-path-list-append imported-paths tail-paths)]
                  (ResultMacroMaterializeImport.Ok
                    materialized-decls
                    materialized-paths
                    next-seen))]
              [(cload.ResultCompilerLoadWithPaths.Err diag)
                (ResultMacroMaterializeImport.Err diag)])]
          [(cload.ResultPkgResolve.Err message)
            (ResultMacroMaterializeImport.Err
              (box (macro-materialize-import-diagnostic decl-path span message)))]))]))

;; Compatibility entry point for focused callers that construct generated
;; declarations without a distinct physical provenance lane.
(define (macro-materialize-generated-import
  [load-state : cload.CompilerLoadSessionState]
  [decl : ast.AstDecl]
  [decl-path : String]
  [decl-owner-id : i64]
  [module : String]
  [module-id : i64]
  [seen : sym_i64_env.SymI64Env]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [pools : ast.AstNodePoolContext]) : ResultMacroMaterializeImport
  (macro-materialize-generated-import-with-provenance
    load-state
    decl
    decl-path
    decl-owner-id
    decl-owner-id
    module
    module-id
    seen
    stdlib-roots
    cfgs
    pools))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [intern-state : ci.InternCompatState]) : ResultMacroExpand
  (begin
    (tc-macro-state-bind-source-names!
      (tc-job-state-macro-state job-state)
      source-names)
    (tc-macro-walk-set!
      (tc-job-state-macro-state job-state)
      macro-dependency-catalog-handle
      (cload.compiler-load-session-state-dependency-catalog-handle load-state))
    (tc-dependency-tlci-route-counters-reset!
      (tc-job-state-macro-state job-state))
    ;; Legacy macro expansion still reads compatibility globals; bridge the
    ;; compile-owned pool and interner state at the phase boundary.
    (ast.ast-node-pool-context-install! pools)
    (ci.intern-compat-state-install! intern-state)
    (macro-expand-program-structural-change-reset!
      (tc-job-state-macro-state job-state))
    ;; The route is a property of the compiler's embedded image plus the exact
    ;; source provenance observed by this load session. Embedded source marks
    ;; the session directly; byte-identical disk source may mark individual
    ;; modules through the content-equivalence cache. Extra non-stdlib roots
    ;; (for example `src` during a self-compile) do not disable the route, while
    ;; modified/untrusted stdlib source never receives embedded provenance.
    ;; #5926 exercised the real macro walk beyond the historical failure point
    ;; and across five reset/release/remap cycles on hosted Linux and Windows,
    ;; so production routing now uses this same policy on both hosts. The
    ;; stress-only cfg controls durable telemetry, not route selection.
    (tc-macro-walk-set!
      (tc-job-state-macro-state job-state)
      macro-expand-stdlib-tlci-route-active
      (cfg
        embedded-stdlib-tlci
        (or
          (cload.compiler-load-session-state-embedded-stdlib-source-used?
            load-state)
          (cload.compiler-load-embedded-provenance-noted?))
        false))
    (cfg
      embedded-stdlib-tlci
      (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
    (cfg compile-profile (compiler-tc-macro-profile-reset-program-counters))
    (cfg
      (all embedded-stdlib-tlci tlci-native-route-stress)
      (compiler-tc-tlci-native-stress-pass-start!
        pools
        (tc-macro-walk-field
          (tc-job-state-macro-state job-state)
          macro-expand-stdlib-tlci-route-active)))
    (tc-stdlib-comptime-macro-surface-ok-reset!
      (tc-job-state-macro-state job-state))
    (tc-macro-identity-reset-for-state! (tc-job-state-macro-state job-state))
    (macro-generated-module-memo-reset! (tc-job-state-macro-state job-state))
    (tc-macro-abstract-proof-reset-for-state!
      (tc-job-state-macro-state job-state))
    (macro-generated-decls-memo-reset! (tc-job-state-macro-state job-state))
    ;; Reset the CTFE base-env cache once per program (plan P2). The pass
    ;; rebuilds it via macro-expand-ctfe-env-build-once!; it is then reused by
    ;; every in-pass splice rebuild and by the downstream typecheck/lower
    ;; comptime, never rebuilt per splice. This is the "build the CTFE-env
    ;; once, after expansion" boundary. The typecheck entry wraps that boundary
    ;; in macro-expand-then-build-envs-with-load-state.
    (compiler-typecheck-ctfe-env-cache-clear!
      (tc-job-state-macro-state job-state))
    ;; Reset the live symbols/registries cache once per program (plan P2): the
    ;; pass rebuilds them and in-pass splice rebuilds reuse or refresh them.
    (macro-live-symbols-reset! (tc-job-state-macro-state job-state))
    ;; Reset the hoisted whole-program prescans: computed at
    ;; pass setup and refreshed only when a generated file import loads new
    ;; declarations mid-walk.
    (macro-live-prescan-reset! (tc-job-state-macro-state job-state))
    (let
      [macro-result : ResultMacroExpand
        (macro-expand-program-pass-with-paths-and-pools
          load-state
          program
          paths
          pools
          (tc-macro-state-source-names (tc-job-state-macro-state job-state))
          job-state
          stdlib-roots
          cfgs)]
      (begin
        ;; Publish all legacy macro mutations before inspecting Ok or Err.
        (ast.ast-node-pool-context-capture-active! pools)
        (ci.intern-compat-state-capture-from-globals! intern-state)
        (match macro-result
          [(ResultMacroExpand.Ok expanded expanded-paths)
            (begin
              (cfg
                embedded-stdlib-tlci
                (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
              (cfg
                (all embedded-stdlib-tlci tlci-native-route-stress)
                (compiler-tc-tlci-native-stress-pass-finish! pools 0))
              (let
                [_profile-owners : unit
                  (macro-expand-allocation-profile-snapshot!
                    (tc-job-state-macro-state job-state)
                    0)]
                [_release-scratch : unit
                  (begin
                    (macro-expand-scratch-release!
                      (tc-job-state-macro-state job-state))
                    (tc-job-state-reset-derived-caches! job-state))]
                (if (spec.compiler-specialize-needed-with-pools expanded pools)
                  (begin
                    (macro-expand-program-structural-change-note!
                      (tc-job-state-macro-state job-state)
                      8)
                    (let
                      [normalized-result : spec.ResultGenProgramWithPaths
                        (spec.gen-normalize-program-with-paths-and-pools-and-intern-state
                          expanded
                          expanded-paths
                          (tc-decl-path-list-last expanded-paths "")
                          (spec.spec-owner-context-new pools intern-state))]
                      (begin
                        ;; Explicit normalization mutates owner cells directly;
                        ;; publish them before matching either result.
                        (ast.ast-node-pool-context-install! pools)
                        (ci.intern-compat-state-install! intern-state)
                        (match normalized-result
                          [(spec.ResultGenProgramWithPaths.Ok
                              normalized
                              normalized-paths)
                            (ResultMacroExpand.Ok normalized normalized-paths)]
                          [(spec.ResultGenProgramWithPaths.Err diag)
                            (ResultMacroExpand.Err diag)]))))
                  (ResultMacroExpand.Ok expanded expanded-paths))))]
          [(ResultMacroExpand.Err diag)
            (begin
              (cfg
                embedded-stdlib-tlci
                (embedded_tlci.compiler-embedded-stdlib-tlci-session-close!))
              (cfg
                (all embedded-stdlib-tlci tlci-native-route-stress)
                (compiler-tc-tlci-native-stress-pass-finish! pools 1))
              (macro-expand-allocation-profile-snapshot!
                (tc-job-state-macro-state job-state)
                0)
              (macro-expand-scratch-release!
                (tc-job-state-macro-state job-state))
              (tc-job-state-reset-derived-caches! job-state)
              (ResultMacroExpand.Err diag))])))))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
    load-state
    program
    paths
    pools
    source-names
    job-state
    stdlib-roots
    cfgs
    (ci.intern-compat-state-capture-active)))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [intern-state : ci.InternCompatState]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
    load-state
    program
    paths
    pools
    (ci.intern-source-name-session-handle-from-state intern-state)
    job-state
    stdlib-roots
    cfgs
    intern-state))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state
  [load-state : cload.CompilerLoadSessionState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state
    load-state
    program
    paths
    pools
    (ci.intern-source-name-session-capture-active-handle)
    job-state
    stdlib-roots
    cfgs))

(define (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state
  [load-state : cload.CompilerLoadSessionState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state
    load-state
    (tc-serial-job-state)
    program
    paths
    pools
    stdlib-roots
    cfgs))

;; Serial/test compatibility adapter. Production macro-expansion jobs call the
;; explicit load-state, job-state, and intern-state entry above.
(define (macro-expand-program-with-paths-and-pools-roots-cfg
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state
    (cload.compiler-load-serial-test-session-state)
    program
    paths
    pools
    stdlib-roots
    cfgs))

;; Expansion + build-once env boundary (plan P2). Runs the single demand-driven
;; expansion pass (which builds the CTFE base env exactly once and reuses it
;; across in-pass splice rebuilds) and hands the fully-expanded program to the
;; caller. The typecheck entry then builds the heavy top-env once over the
;; expanded program and reuses the CTFE env the expansion left cached, instead
;; of rebuilding either per pass.
(define (macro-expand-then-build-envs-with-load-state-and-job-state
  [load-state : cload.CompilerLoadSessionState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state
    load-state
    job-state
    program
    paths
    pools
    stdlib-roots
    cfgs))

(define (macro-expand-then-build-envs-with-load-state-and-job-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [intern-state : ci.InternCompatState]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg-with-load-state-and-job-state-and-intern-state
    load-state
    job-state
    program
    paths
    pools
    stdlib-roots
    cfgs
    intern-state))

;; Serial/test compatibility adapter. Production typecheck jobs call the
;; explicit load-state, job-state, and intern-state entry above.
(define (macro-expand-program-with-paths-and-pools
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [pools : ast.AstNodePoolContext]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg
    program
    paths
    pools
    (svec.new)
    (parser.compiler-cfg-empty)))

(define (macro-expand-program-with-paths
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools
    program
    paths
    (ast.ast-node-pool-context-capture-active)))

(define (macro-expand-program [program : ast.AstProgram]) : ResultMacroExpand
  (macro-expand-program-with-paths program (ast.ast-decl-path-list-new)))

(define (tc-cleanup-owning-struct-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Struct struct-name)
      (match (tc-struct-decl-id ctx struct-name)
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast.ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [(ast.AstType.StructArgs struct-name _)
      (match (tc-struct-decl-id ctx struct-name)
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast.ast-struct-cleanup? cleanup)])]
        [(ResultTcStructDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-enum-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Enum enum-name)
      (match (tc-enum-decl-id ctx enum-name)
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast.ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [(ast.AstType.EnumArgs enum-name _)
      (match (tc-enum-decl-id ctx enum-name)
        [(ResultTcEnumDecl.Ok decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast.ast-enum-cleanup? cleanup)])]
        [(ResultTcEnumDecl.Err _) false])]
    [_ false]))

(define (tc-cleanup-owning-aggregate-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (or
    (tc-cleanup-owning-struct-type? ctx ty)
    (tc-cleanup-owning-enum-type? ctx ty)))

(define (tc-struct-field-cleanup-outside-message
  [struct-name : String]
  [field-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " has cleanup metadata but struct is not cleanup-owning"))

(define (tc-struct-field-cleanup-owning-without-owned-message
  [struct-name : String]
  [field-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-struct-field-owned-non-cleanup-message
  [struct-name : String]
  [field-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-struct-field-cleanup-fn-mismatch-message
  [struct-name : String]
  [field-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-cleanup-source-slash-alias-helper-name
  [ctx : TcContext]
  [cleanup-name : i64]) : i64
  (match (tc-context-program ctx)
    [(ast.AstProgram.Program decls-box)
      (match (macro-import-alias-target-cached-id-in-context
        ctx
        (__tl-box-place decls-box)
        (tc-context-module-id ctx)
        (ci.intern-qualified-module-id cleanup-name))
        [(TcMaybeNameId.Some target-module-id)
          (csym.compiler-symbol-module-key-id-by-id
            target-module-id
            (ci.intern-qualified-base-id cleanup-name))]
        [(TcMaybeNameId.No) cleanup-name])]))

(define (tc-cleanup-field-helper-name
  [ctx : TcContext]
  [owner-name-id : i64]
  [cleanup-name : i64]) : i64
  (let
    [cleanup-str : String (ci.intern-str cleanup-name)]
    (if (tc-source-slash-qualified-id? cleanup-str cleanup-name)
      (tc-cleanup-source-slash-alias-helper-name ctx cleanup-name)
      (if (tc-name-qualified-id? cleanup-name)
        cleanup-name
        (csym.compiler-symbol-module-key-id-by-id
          (let
            [owner-module-id : i64 (tc-qualified-name-module-id owner-name-id)]
            (if (>= owner-module-id 0)
              owner-module-id
              cbi.compiler-builtin-id-fix-empty))
          cleanup-name)))))

(define (tc-check-struct-field-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [field-name : String]
  [cleanup-name : i64]
  [field-ty : ast.AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx struct-name-id cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions field-ty) (ast.AstType.Unit))
          (tc-struct-field-cleanup-fn-mismatch-message
            struct-name
            field-name
            (ci.intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [struct-cleanup : ast.AstStructCleanup]
  [field : ast.AstFieldDef]) : ResultTcUnit
  (match field
    [(ast.AstFieldDef.Def field-name ty field-cleanup)
      (let
        [field-name-str : String (ci.intern-str field-name)]
        [resolved-ty : ast.AstType
          (tc-type-strip-region (tc-resolve-type ctx ty))]
        [field-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        (if (not (ast.ast-struct-cleanup? struct-cleanup))
          (if (ast.ast-field-cleanup? field-cleanup)
            (ResultTcUnit.Err
              (tc-struct-field-cleanup-outside-message
                struct-name
                field-name-str))
            (if field-cleanup-owning
              (ResultTcUnit.Err
                (tc-struct-field-cleanup-owning-without-owned-message
                  struct-name
                  field-name-str
                  resolved-ty))
              ResultTcUnit.Ok))
          (match field-cleanup
            [(ast.AstFieldCleanup.Owned)
              (if field-cleanup-owning
                ResultTcUnit.Ok
                (ResultTcUnit.Err
                  (tc-struct-field-owned-non-cleanup-message
                    struct-name
                    field-name-str
                    resolved-ty)))]
            [(ast.AstFieldCleanup.Fn cleanup-name)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                (tc-check-struct-field-cleanup-fn
                  ctx
                  env
                  struct-name
                  struct-name-id
                  field-name-str
                  cleanup-name
                  resolved-ty))]
            [(ast.AstFieldCleanup.No)
              (if field-cleanup-owning
                (ResultTcUnit.Err
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                ResultTcUnit.Ok)])))]))

(define (tc-check-cleanup-struct-fields
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : ast.AstStructCleanup]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (tc-check-cleanup-struct-fields-at
    ctx
    env
    struct-name
    struct-name-id
    cleanup
    (& fields)
    0))

(define (tc-check-cleanup-struct-fields-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [cleanup : ast.AstStructCleanup]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index fields.len)
    ResultTcUnit.Ok
    (match (tc-check-cleanup-struct-field
      ctx
      env
      struct-name
      struct-name-id
      cleanup
      (ast.ast-field-def-list-get fields index (ast.ast-field-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-struct-fields-at
          ctx
          env
          struct-name
          struct-name-id
          cleanup
          fields
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-struct-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [repr : ast.AstStructRepr]
  [cleanup : ast.AstStructCleanup]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (let
    [struct-name : String (tc-nominal-name-id-display name-id)]
    (if (and (ast.ast-struct-repr-c? repr) (ast.ast-struct-cleanup? cleanup))
      (ResultTcUnit.Err (tc-struct-cleanup-repr-c-message struct-name))
      (tc-check-cleanup-struct-fields
        ctx
        env
        struct-name
        name-id
        cleanup
        fields))))

(define (tc-enum-payload-cleanup-outside-message
  [enum-name : String]
  [variant-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " has payload cleanup metadata but enum is not cleanup-owning"))

(define (tc-enum-payload-cleanup-owning-without-owned-message
  [enum-name : String]
  [variant-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-enum-payload-owned-non-cleanup-message
  [enum-name : String]
  [variant-name : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-enum-payload-cleanup-fn-mismatch-message
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-check-enum-payload-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [cleanup-name : i64]
  [payload-ty : ast.AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx enum-name-id cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(ResultTcType.Ok cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions payload-ty) (ast.AstType.Unit))
          (tc-enum-payload-cleanup-fn-mismatch-message
            enum-name
            variant-name
            (ci.intern-str cleanup-name)))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-payloads
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : ast.AstEnumCleanup]
  [payloads : ast.AstTypeList]
  [payload-cleanups : ast.AstVariantPayloadCleanupList]) : ResultTcUnit
  (tc-check-cleanup-enum-payloads-at
    ctx
    env
    enum-name
    enum-name-id
    variant-name
    enum-cleanup
    (& payloads)
    (& payload-cleanups)
    0))

(define (tc-check-cleanup-enum-payloads-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [variant-name : String]
  [enum-cleanup : ast.AstEnumCleanup]
  [payloads : (& payloads ast.AstTypeList)]
  [payload-cleanups : (& payload-cleanups ast.AstVariantPayloadCleanupList)]
  [cleanup-index : i64]) : ResultTcUnit
  (if (>= cleanup-index (ast.ast-type-list-len payloads))
    (if (>=
      cleanup-index
      (ast.ast-variant-payload-cleanup-list-len payload-cleanups))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata"))
    (if (>=
      cleanup-index
      (ast.ast-variant-payload-cleanup-list-len payload-cleanups))
      (ResultTcUnit.Err "typecheck: malformed enum payload cleanup metadata")
      (let
        [payload-cleanup : ast.AstVariantPayloadCleanup
          (ast.ast-variant-payload-cleanup-list-get
            payload-cleanups
            cleanup-index
            (ast.ast-variant-payload-cleanup-fallback))]
        [payload-ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get
              payloads
              cleanup-index
              (ast.ast-type-id-fallback)))]
        [resolved-ty : ast.AstType
          (tc-type-strip-region (tc-resolve-type ctx payload-ty))]
        [payload-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        [step : ResultTcUnit
          (if (not (ast.ast-enum-cleanup? enum-cleanup))
            (if (ast.ast-variant-payload-cleanup? payload-cleanup)
              (ResultTcUnit.Err
                (tc-enum-payload-cleanup-outside-message enum-name variant-name))
              (if payload-cleanup-owning
                (ResultTcUnit.Err
                  (tc-enum-payload-cleanup-owning-without-owned-message
                    enum-name
                    variant-name
                    resolved-ty))
                ResultTcUnit.Ok))
            (match payload-cleanup
              [(ast.AstVariantPayloadCleanup.Owned)
                (if payload-cleanup-owning
                  ResultTcUnit.Ok
                  (ResultTcUnit.Err
                    (tc-enum-payload-owned-non-cleanup-message
                      enum-name
                      variant-name
                      resolved-ty)))]
              [(ast.AstVariantPayloadCleanup.Fn cleanup-name)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  (tc-check-enum-payload-cleanup-fn
                    ctx
                    env
                    enum-name
                    enum-name-id
                    variant-name
                    cleanup-name
                    resolved-ty))]
              [(ast.AstVariantPayloadCleanup.No)
                (if payload-cleanup-owning
                  (ResultTcUnit.Err
                    (tc-enum-payload-cleanup-owning-without-owned-message
                      enum-name
                      variant-name
                      resolved-ty))
                  ResultTcUnit.Ok)]))]
        (match step
          [(ResultTcUnit.Ok)
            (tc-check-cleanup-enum-payloads-at
              ctx
              env
              enum-name
              enum-name-id
              variant-name
              enum-cleanup
              payloads
              payload-cleanups
              (+ cleanup-index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))))

(define (tc-check-cleanup-enum-variant
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variant : ast.AstVariantDef]) : ResultTcUnit
  (match variant
    [(ast.AstVariantDef.Def variant-name payloads payload-cleanups)
      (tc-check-cleanup-enum-payloads
        ctx
        env
        enum-name
        enum-name-id
        (ci.intern-str variant-name)
        cleanup
        payloads
        payload-cleanups)]))

(define (tc-check-cleanup-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (tc-check-cleanup-enum-variants-at
    ctx
    env
    enum-name
    enum-name-id
    cleanup
    (& variants)
    0))

(define (tc-check-cleanup-enum-variants-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    ResultTcUnit.Ok
    (match (tc-check-cleanup-enum-variant
      ctx
      env
      enum-name
      enum-name-id
      cleanup
      (ast.ast-variant-def-list-get
        variants
        index
        (ast.ast-variant-def-fallback)))
      [(ResultTcUnit.Ok)
        (tc-check-cleanup-enum-variants-at
          ctx
          env
          enum-name
          enum-name-id
          cleanup
          variants
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-cleanup-enum-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [_lifetimes : ast.AstLifetimeList]
  [cleanup : ast.AstEnumCleanup]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (let
    [enum-name : String (tc-nominal-name-id-display name-id)]
    ;; The declared cleanup name denotes the function synthesized by lowering.
    ;; Validate payload cleanup requirements without looking for a user body.
    (tc-check-cleanup-enum-variants ctx env enum-name name-id cleanup variants)))

(define (tc-check-fn-params-from-types-at
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstParamList)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (begin
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(ast.AstParam.Param name _ mutable? consume?)
          (ast.ast-param-list-push
            out
            (ast.AstParam.Param
              name
              (ast.ast-type-strip-consuming-param-with-pools
                (tc-context-pools ctx)
                (tc-context-type-get
                  ctx
                  (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
              mutable?
              consume?))])
      (tc-check-fn-params-from-types-at ctx params types (+ index 1) out))))

(define (tc-check-fn-params-from-types
  [ctx : TcContext]
  [params : ast.AstParamList]
  [types : ast.AstTypeList]) : ast.AstParamList
  (let
    [out : ast.AstParamList
      (ast.ast-param-list-with-capacity (ast.ast-param-list-len (& params)))]
    (begin
      (tc-check-fn-params-from-types-at ctx (& params) (& types) 0 (&mut out))
      out)))

(define (tc-check-fn-registered-params
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]) : ast.AstParamList
  (match (tc-lookup-persistent-id global-env name)
    [(ResultTcType.Ok (ast.AstType.Func types _))
      (let
        [registered : ast.AstTypeList (__tl-box-place types)]
        (if (=
          (ast.ast-type-list-len (& registered))
          (ast.ast-param-list-len (& params)))
          (tc-check-fn-params-from-types ctx params registered)
          params))]
    [_ params]))

;: Check one function declaration's body against its registered signature.
(define (tc-check-fn-decl-body
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
    [registered-params : ast.AstParamList
      (tc-check-fn-registered-params ctx global-env name params)]
    [resolved-ret : ast.AstType (tc-resolve-type ctx ret)]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-bind-return-type
        (tc-type-env-scoped-carrier-bind-params
          ctx
          (tc-type-env-scoped-carrier-from-env global-env)
          registered-params)
        resolved-ret)]
    [env : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
    ;; The scoped carrier keeps parameters out of the persistent spine. Final
    ;; result matching runs after the carrier is restored, so retain an ordinary
    ;; environment for lifetime-outlives queries at that boundary.
    [comparison-env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx global-env registered-params)
        resolved-ret)]
    [scoped-save : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter! carrier)]
    [body-state : TcBodyState (tc-context-body-state ctx)]
    [typed-result : ResultTcType
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (let
            [persistent : TcTypeEnv
              (tc-bind-return-type
                (tc-bind-params ctx global-env registered-params)
                resolved-ret)]
            (if (tc-type-env-scoped-carrier-fn-entry-matches-persistent?
              carrier
              persistent
              registered-params)
              unit
              (io.panic
                "typecheck: scoped carrier diverged from persistent function env")))
          unit)
        (tc-body-early-exit-function-start! body-state)
        (tc-body-type-facts-start-recording! body-state)
        (tc-expr-with-expected-or-actual-id ctx env body-box resolved-ret))]
    [_scoped-restored : unit (tc-type-env-scoped-runtime-restore! scoped-save)]
    [result : ResultTcUnit
      (match typed-result
        [(ResultTcType.Ok inferred)
          (let
            [matched-got : TcInferredTypeMatch
              (tc-match-inferred-type-for-expected
                ctx
                comparison-env
                inferred
                resolved-ret)]
            [got : ast.AstType
              (match matched-got
                [(TcInferredTypeMatch.Compatible actual) actual]
                [(TcInferredTypeMatch.Mismatch actual) actual])]
            [expect-result : ResultTcUnit
              (match matched-got
                [(TcInferredTypeMatch.Compatible _) ResultTcUnit.Ok]
                [(TcInferredTypeMatch.Mismatch actual)
                  (ResultTcUnit.Err
                    (tc-type-mismatch-message-in-context
                      ctx
                      comparison-env
                      actual
                      resolved-ret
                      "typecheck: return type mismatch"))])]
            (begin
              (tc-body-type-facts-start-consuming! body-state)
              (match expect-result
                [(ResultTcUnit.Ok)
                  (match (tc-ensure-region-value-can-flow-into
                    env
                    resolved-ret
                    got
                    "return value")
                    [(ResultTcUnit.Ok)
                      (match (tc-move-check-body-id
                        ctx
                        (tc-context-expr-bases ctx)
                        env
                        registered-params
                        body-box
                        resolved-ret)
                        [(ResultTcUnit.Ok)
                          (let
                            [result : ResultTcUnit
                              (tc-borrow-check-body-id-with-ret
                                ctx
                                (tc-context-expr-bases ctx)
                                env
                                registered-params
                                ret
                                body-box)]
                            (begin
                              (match result
                                [(ResultTcUnit.Ok)
                                  (tc-body-early-exit-function-finish!
                                    body-state
                                    body-box)]
                                [(ResultTcUnit.Err _) unit])
                              (tc-body-type-facts-clear! body-state)
                              result))]
                        [(ResultTcUnit.Err message)
                          (begin
                            (tc-body-type-facts-clear! body-state)
                            (ResultTcUnit.Err message))])]
                    [(ResultTcUnit.Err message)
                      (begin
                        (tc-body-type-facts-clear! body-state)
                        (ResultTcUnit.Err
                          (tc-rich-escape-at-expr
                            body
                            message
                            "function return type rejects this escaping value")))])]
                [(ResultTcUnit.Err message)
                  (begin
                    (tc-body-type-facts-clear! body-state)
                    (ResultTcUnit.Err message))])))]
        [(ResultTcType.Err message)
          (begin
            (tc-body-type-facts-clear! body-state)
            (ResultTcUnit.Err message))])]
    result))

;; Reusable scratch arena for per-function-body typechecks. Mirrors
;; lower-scratch-arena: created lazily, shared by every check in one job (the
;; body walk is never re-entrant into another function-decl check), reclaimed
;; by mark/rewind per check.
(define (tc-fn-scratch-arena-get [state : TcScratchArenaState]) : i64
  (let
    [data : TcScratchArenaStateData (tc-scratch-arena-state-data state)]
    [return-arena : i64 (arena.tl_arena_current)]
    (if (= data.fn-arena 0)
      (let
        [scratch : i64 (arena.tl_arena_make_small)]
        (begin
          (set! data.fn-arena scratch)
          (set! data.fn-return-arena return-arena)
          (tc-scratch-arena-state-data-set! state data)
          scratch))
      (begin
        (set! data.fn-return-arena return-arena)
        (tc-scratch-arena-state-data-set! state data)
        data.fn-arena))))

(define (tc-fn-scratch-arena-release! [state : TcScratchArenaState]) : unit
  (let
    [data : TcScratchArenaStateData (tc-scratch-arena-state-data state)]
    [scratch : i64 data.fn-arena]
    (if (= scratch 0)
      unit
      (begin
        (if (= (arena.tl_arena_current) scratch)
          (unsafe
            (arena.tl_arena_set data.fn-return-arena))
          unit)
        (unsafe
          (arena.tl_arena_destroy scratch))
        (set! data.fn-arena 0)
        (set! data.fn-return-arena 0)
        (tc-scratch-arena-state-data-set! state data)))))

;; Function bodies dominate typecheck allocation (~96% of the phase's live
;; delta) and the check returns only unit -- everything it allocates
;; is garbage once the body is checked, but the program-lifetime arena never
;; frees it. Run each body check through with-escape so the checker sees the
;; scratch extent and clones the error diagnostic out before rewinding (do NOT
;; re-run the check to regenerate the message -- the body check is not
;; idempotent and a second run can surface a different diagnostic). Stable-root
;; arena handles make a post-growth head recapture redundant; rewind retires
;; overflow segments itself. The interner owns new spellings at insertion, so
;; its entries survive this rewind. Node pools already grow in the persistent
;; base arena.
(define (tc-check-fn-decl-scoped
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [scratch-state : TcScratchArenaState
      (tc-job-state-scratch-arenas (tc-context-job-state ctx))]
    [scratch : i64 (tc-fn-scratch-arena-get scratch-state)]
    [escaped : ResultTcUnit
      (with-escape
        (arena.Arena scratch)
        (match (tc-check-fn-decl-body ctx global-env name params ret body-box)
          [(ResultTcUnit.Ok) ResultTcUnit.Ok]
          [(ResultTcUnit.Err message)
            (ResultTcUnit.Err (tc-unbound-finalize-located-error message))]))]
    (begin
      ;; Single-entry name caches may hold strings allocated in the scratch
      ;; that was just rewound; invalidate them before anything can compare
      ;; against freed memory.
      (tc-nominal-owner-cache-reset!)
      escaped)))

;; Reusable scratch arena for per-declaration checks that are not function
;; bodies (Def values, macros, externs, dispatches, enum/struct declarations).
;; Same mark/rewind/clone-out shape as the function-body scratch above, but a
;; SEPARATE job-owned arena so a function-body scope nested inside a
;; declaration scope (a comptime/unsafe template containing a DefFn) never
;; invalidates a live declaration mark.
(define (tc-decl-scratch-arena-get [state : TcScratchArenaState]) : i64
  (let
    [data : TcScratchArenaStateData (tc-scratch-arena-state-data state)]
    [return-arena : i64 (arena.tl_arena_current)]
    (if (= data.decl-arena 0)
      (let
        [scratch : i64 (arena.tl_arena_make_small)]
        (begin
          (set! data.decl-arena scratch)
          (set! data.decl-return-arena return-arena)
          (tc-scratch-arena-state-data-set! state data)
          scratch))
      (begin
        (set! data.decl-return-arena return-arena)
        (tc-scratch-arena-state-data-set! state data)
        data.decl-arena))))

(define (tc-decl-scratch-arena-release! [state : TcScratchArenaState]) : unit
  (let
    [data : TcScratchArenaStateData (tc-scratch-arena-state-data state)]
    [scratch : i64 data.decl-arena]
    (if (= scratch 0)
      unit
      (begin
        (if (= (arena.tl_arena_current) scratch)
          (unsafe
            (arena.tl_arena_set data.decl-return-arena))
          unit)
        (unsafe
          (arena.tl_arena_destroy scratch))
        (set! data.decl-arena 0)
        (set! data.decl-return-arena 0)
        (set! data.decl-depth 0)
        (tc-scratch-arena-state-data-set! state data)))))

(define (tc-decl-scratch-depth [state : TcScratchArenaState]) : i64
  (__tl-project-field (tc-scratch-arena-state-data state) decl-depth))

(define (tc-decl-scratch-depth-set! [state : TcScratchArenaState] [depth : i64]) : unit
  (let
    [data : TcScratchArenaStateData (tc-scratch-arena-state-data state)]
    (begin
      (set! data.decl-depth depth)
      (tc-scratch-arena-state-data-set! state data))))

(define (tc-scratch-arena-state-release! [state : TcScratchArenaState]) : unit
  (begin
    (tc-fn-scratch-arena-release! state)
    (tc-decl-scratch-arena-release! state)))

;; Non-function declaration checks pin their transient env layers, CTFE eval
;; trees, and partial caches in the persistent arena for the rest of the
;; compile even though the check returns only unit. Run each such check in the
;; shared declaration scratch arena through with-escape, cloning the error
;; diagnostic out before rewind (the same shape as tc-check-fn-decl-scoped).
;; State that must persist is unaffected: env bindings are built by the
;; module-env walk outside this scope, the interner owns new spellings at
;; insertion, node pools grow in the persistent base arena, and
;; cross-declaration caches live in dedicated persistent arenas. The one
;; cross-declaration cache that cannot be rewound safely, the macro helper env,
;; is rebuilt per declaration instead (reset at the end of this scope).
(define (tc-check-decl-scoped
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (let
    [scratch-state : TcScratchArenaState
      (tc-job-state-scratch-arenas (tc-context-job-state ctx))]
    (if (> (tc-decl-scratch-depth scratch-state) 0)
      ;; Compile-time metadata and Unsafe recursively dispatch their template.
      ;; Keep nested checks in the outer declaration scope: an inner rewind
      ;; would also free an error cloned into that same scratch arena, while the
      ;; outer scope already provides the required reclamation boundary.
      (tc-check-nonfn-decl-with-global-env ctx top-env global-env decl)
      (let
        [scratch : i64 (tc-decl-scratch-arena-get scratch-state)]
        (begin
          (tc-decl-scratch-depth-set! scratch-state 1)
          (let
            [escaped : ResultTcUnit
              (with-escape
                (arena.Arena scratch)
                (match (tc-check-nonfn-decl-with-global-env
                  ctx
                  top-env
                  global-env
                  decl)
                  [(ResultTcUnit.Ok) ResultTcUnit.Ok]
                  [(ResultTcUnit.Err message)
                    (ResultTcUnit.Err
                      (tc-unbound-finalize-located-error message))]))]
            (begin
              (tc-decl-scratch-depth-set!
                scratch-state
                (- (tc-decl-scratch-depth scratch-state) 1))
              ;; Single-entry name caches may hold strings allocated in the
              ;; scratch that was just rewound; invalidate them before anything
              ;; can compare against freed memory.
              (tc-nominal-owner-cache-reset!)
              ;; The macro helper env cache persists across declarations, but
              ;; its spine is extended with per-check partial cache layers while
              ;; a DefMacro body is checked; those layers (and any
              ;; rewind-sensitive content reached through them) must not outlive
              ;; this declaration, so rebuild the cache per declaration inside
              ;; the scratch scope.
              (tc-macro-helper-env-cache-reset! (tc-context-macro-state ctx))
              escaped)))))))

(define (tc-scratch-arena-state-isolation-self-test) : bool
  (let
    [job-a : TcJobState (tc-job-state-new)]
    [job-b : TcJobState (tc-job-state-new)]
    [state-a : TcScratchArenaState (tc-job-state-scratch-arenas job-a)]
    [state-b : TcScratchArenaState (tc-job-state-scratch-arenas job-b)]
    [fn-a : i64 (tc-fn-scratch-arena-get state-a)]
    [decl-a : i64 (tc-decl-scratch-arena-get state-a)]
    [fn-b : i64 (tc-fn-scratch-arena-get state-b)]
    [decl-b : i64 (tc-decl-scratch-arena-get state-b)]
    (begin
      (tc-decl-scratch-depth-set! state-a 2)
      (tc-decl-scratch-depth-set! state-b 1)
      ;; Exercise both active-arena teardown paths: a direct function release
      ;; and a full reset while A's declaration scratch is current.
      (unsafe
        (arena.tl_arena_set fn-a))
      (tc-fn-scratch-arena-release! state-a)
      (unsafe
        (arena.tl_arena_set decl-a))
      (tc-job-state-release-scratch-arenas! job-a)
      (tc-job-state-reset-file-state! job-a)
      (let
        [after-a-reset : TcScratchArenaStateData
          (tc-scratch-arena-state-data state-a)]
        [b-live : TcScratchArenaStateData (tc-scratch-arena-state-data state-b)]
        [isolated : bool
          (and
            (not (= fn-a 0))
            (not (= decl-a 0))
            (not (= fn-b 0))
            (not (= decl-b 0))
            (not (= fn-a fn-b))
            (not (= decl-a decl-b))
            (= after-a-reset.fn-arena 0)
            (= after-a-reset.decl-arena 0)
            (= after-a-reset.decl-depth 0)
            (= b-live.fn-arena fn-b)
            (= b-live.decl-arena decl-b)
            (= b-live.decl-depth 1))]
        [fn-a-reused : i64 (tc-fn-scratch-arena-get state-a)]
        [decl-a-reused : i64 (tc-decl-scratch-arena-get state-a)]
        (begin
          (tc-decl-scratch-depth-set! state-a 3)
          (let
            [b-after-a-reuse : TcScratchArenaStateData
              (tc-scratch-arena-state-data state-b)]
            [reused : bool
              (and
                (not (= fn-a-reused 0))
                (not (= decl-a-reused 0))
                (= (tc-decl-scratch-depth state-a) 3)
                (= b-after-a-reuse.fn-arena fn-b)
                (= b-after-a-reuse.decl-arena decl-b)
                (= b-after-a-reuse.decl-depth 1))]
            (begin
              (tc-job-state-release-scratch-arenas! job-a)
              (tc-job-state-reset-file-state! job-a)
              (tc-job-state-release-scratch-arenas! job-b)
              (tc-job-state-reset-file-state! job-b)
              (let
                [after-a-reuse-reset : TcScratchArenaStateData
                  (tc-scratch-arena-state-data state-a)]
                [after-b-reset : TcScratchArenaStateData
                  (tc-scratch-arena-state-data state-b)]
                (and
                  isolated
                  reused
                  (= after-a-reuse-reset.fn-arena 0)
                  (= after-a-reuse-reset.decl-arena 0)
                  (= after-a-reuse-reset.decl-depth 0)
                  (= after-b-reset.fn-arena 0)
                  (= after-b-reset.decl-arena 0)
                  (= after-b-reset.decl-depth 0))))))))))

(cfg
  test
  (test
    tc-scratch-arena-job-owned-reset-reuse
    (if (tc-scratch-arena-state-isolation-self-test)
      unit
      (io.panic "typecheck: job-owned scratch arena isolation failed"))))

(define (tc-check-decl-with-global-env-inner
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (begin
    ;; Type-name and owner caches are keyed by text/handle only. Helper passes
    ;; may typecheck with short-lived symbol tables before the final declaration
    ;; walk, so keep cache entries scoped to one checked declaration.
    (tc-nominal-owner-cache-reset!)
    (match decl
      [(ast.AstDecl.DefFn decl-meta name params ret body-box _)
        (match (tc-elide-function-signature
          (tc-context-type-bases ctx)
          params
          ret)
          [(ResultTcElidedSignature.Ok signature)
            (tc-check-fn-decl-scoped
              ctx
              global-env
              name
              signature.params
              signature.ret
              body-box)]
          [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
      [_ (tc-check-decl-scoped ctx top-env global-env decl)])))

;; Conservative proof-reuse lane for one generated declaration.  The first
;; successful identity in a (generator,item) family remains concrete; only a
;; later identity can reach the exact substitution walker after every bounded
;; provenance, scan, identity, and Rule-4 gate succeeds.
(defenum TcProofReuseGeneratedDeclDecision
  (TcProofReuseGeneratedDeclConcrete)
  (TcProofReuseGeneratedDeclConcreteSeed)
  (TcProofReuseGeneratedDeclSkip))

(define (tc-proof-reuse-generated-decl-decision
  [ctx : TcContext]
  [generator : String]
  [item : String]
  [identity : String]
  [decl : ast.AstDecl]) : TcProofReuseGeneratedDeclDecision
  ;; Keep the dark-lane fast path literal and outermost: before any metadata,
  ;; visible-name, or family work, a session with no complete proof returns
  ;; immediately.
  (if (not (tc-macro-proof-field (tc-context-macro-state ctx) qualified-active))
    (TcProofReuseGeneratedDeclConcrete)
    (if (not (complete-key-for-state (tc-context-macro-state ctx) generator))
      (TcProofReuseGeneratedDeclConcrete)
      (let
        ;; The caller has already destructured this declaration's immutable
        ;; generated metadata and passes those exact values here.
        [proof-state : TcMacroState (tc-context-macro-state ctx)]
        [right-id : i64 (lookup-key-id-for-state proof-state identity)]
        [slot : i64 (slot-id-for-state proof-state right-id)]
        [count : i64
          (if (and
            (>= slot 0)
            (< slot store-capacity)
            (>
              (array-ref (tc-macro-proof-field proof-state identity-bytes) slot)
              0))
            (let
              [count : i64
                (array-ref
                  (tc-macro-proof-field proof-state operand-count)
                  slot)]
              (if (and (>= count 0) (<= count expected-count))
                count
                -1))
            -1)]
        [ok : bool
          (and
            (>= right-id 0)
            (>= slot 0)
            (< slot store-capacity)
            (>
              (array-ref (tc-macro-proof-field proof-state identity-bytes) slot)
              0)
            (>= count 1)
            (<= count expected-count))]
        (if (not ok)
          (TcProofReuseGeneratedDeclConcrete)
          (let
            [key : i64
              (slot-index-for-state (tc-context-macro-state ctx) generator item)]
            (if (or (< key 0) (>= key additional-capacity))
              ;; A missing family is still eligible to seed after a
              ;; successful concrete check.  The exact walker below owns the
              ;; declaration, expression, and dependent-type gates for skips.
              (TcProofReuseGeneratedDeclConcreteSeed)
              (let
                [left-id : i64
                  (if (>
                    (array-ref
                      (tc-macro-proof-field
                        (tc-context-macro-state ctx)
                        storage-identity-vars)
                      key)
                    0)
                    (-
                      (array-ref
                        (tc-macro-proof-field
                          (tc-context-macro-state ctx)
                          storage-identity-vars)
                        key)
                      1)
                    -1)]
                (if (or (< left-id 0) (= left-id right-id))
                  (TcProofReuseGeneratedDeclConcrete)
                  (match (spec.gen-decl-visible-name decl)
                    [(spec.SpecMaybeString.Some name)
                      (if (not (string.eq name item))
                        (TcProofReuseGeneratedDeclConcrete)
                        (let
                          [other : ast.AstDecl
                            (tc-global-array-element-shared-view
                              (augmented-decls-shared-view-for-state
                                (tc-context-macro-state ctx))
                              key)]
                          ;; The exact walker performs identity preflight,
                          ;; declaration substitution, dependent-type vetoes,
                          ;; and Rule 4 in one bounded proof. Unsupported
                          ;; declarations and expressions fail closed there.
                          (if (begin
                            (scratch-reset-functions-for-state proof-state)
                            (tc-macro-proof-set!
                              proof-state
                              first-module-id
                              (if (>
                                (array-ref
                                  (tc-macro-proof-field
                                    (tc-context-macro-state ctx)
                                    storage-module-vars)
                                  key)
                                0)
                                (-
                                  (array-ref
                                    (tc-macro-proof-field
                                      (tc-context-macro-state ctx)
                                      storage-module-vars)
                                    key)
                                  1)
                                -1))
                            (tc-macro-proof-set!
                              proof-state
                              next-module-id
                              (tc-context-module-id ctx))
                            (and
                              (tc-proof-reuse-session-identity-preflight-ids-for-state?
                                proof-state
                                left-id
                                right-id)
                              (tc-proof-reuse-session-ast-decl-exact?
                                ctx
                                other
                                decl)
                              ;; Rule 4 is intentionally last: the exact walk
                              ;; must finish before literal/operator/
                              ;; reflection facts can authorize reuse.
                              (not
                                (or
                                  (tc-macro-proof-field
                                    proof-state
                                    active-invalid)
                                  (tc-macro-proof-field proof-state overflow-ok)
                                  (and
                                    (tc-macro-proof-field
                                      proof-state
                                      portable-pair)
                                    (tc-macro-proof-field proof-state local-use))
                                  (and
                                    (tc-macro-proof-field
                                      proof-state
                                      portable-pair)
                                    (tc-macro-proof-field
                                      proof-state
                                      fixed-call)
                                    (not
                                      (tc-macro-proof-field
                                        proof-state
                                        allow-cleanup)))
                                  (<
                                    (tc-macro-proof-field proof-state first-key)
                                    0)
                                  (<
                                    (tc-macro-proof-field proof-state next-id)
                                    0)
                                  (<
                                    (tc-macro-proof-field
                                      proof-state
                                      identity-count2)
                                    1)
                                  (>
                                    (tc-macro-proof-field
                                      proof-state
                                      identity-count2)
                                    expected-count)))
                              (let
                                [index : i64 0]
                                [ok : bool true]
                                (begin
                                  ;; The identity metadata table is bounded
                                  ;; to sixteen ordered operands.  Inspect
                                  ;; only operand bits that exact type
                                  ;; comparison actually marked as changed.
                                  (while (and ok (< index expected-count))
                                    (begin
                                      (if (=
                                        (bit-and
                                          (tc-macro-proof-field
                                            proof-state
                                            active-mask)
                                          (shl 1 index))
                                        0)
                                        unit
                                        (if (let
                                          [key : String
                                            (type-key-id-for-state
                                              proof-state
                                              (tc-macro-proof-field
                                                proof-state
                                                first-slot)
                                              index)]
                                          [value : String
                                            (type-key-id-for-state
                                              proof-state
                                              (tc-macro-proof-field
                                                proof-state
                                                next-slots)
                                              index)]
                                          [kind : String
                                            (kind-for-check-for-state
                                              proof-state
                                              (tc-macro-proof-field
                                                proof-state
                                                first-slot)
                                              index)]
                                          [other : String
                                            (kind-for-check-for-state
                                              proof-state
                                              (tc-macro-proof-field
                                                proof-state
                                                next-slots)
                                              index)]
                                          [first : bool
                                            (or
                                              (string.eq kind "f32")
                                              (string.eq kind "f64"))]
                                          [second : bool
                                            (or
                                              (string.eq other "f32")
                                              (string.eq other "f64"))]
                                          [left : bool
                                            (or
                                              (string.eq kind "struct")
                                              (string.eq kind "enum"))]
                                          [right : bool
                                            (or
                                              (string.eq other "struct")
                                              (string.eq other "enum"))]
                                          [result : bool
                                            (or
                                              (string.eq kind "string")
                                              (string.eq kind "bytes")
                                              (string.eq kind "array")
                                              (string.eq kind "dyn-array")
                                              (string.eq kind "box")
                                              (string.eq kind "tuple")
                                              (string.eq kind "struct")
                                              (string.eq kind "enum")
                                              (string.eq kind "expr")
                                              (string.eq kind "expr-list")
                                              (string.eq kind "function")
                                              (string.eq kind "consume-param"))]
                                          [saved : bool
                                            (or
                                              (string.eq other "string")
                                              (string.eq other "bytes")
                                              (string.eq other "array")
                                              (string.eq other "dyn-array")
                                              (string.eq other "box")
                                              (string.eq other "tuple")
                                              (string.eq other "struct")
                                              (string.eq other "enum")
                                              (string.eq other "expr")
                                              (string.eq other "expr-list")
                                              (string.eq other "function")
                                              (string.eq other "consume-param"))]
                                          [state : bool
                                            (or
                                              (string.eq other "i64")
                                              (string.eq other "i32")
                                              (string.eq other "i16")
                                              (string.eq other "i8")
                                              (string.eq other "u64")
                                              (string.eq other "u32")
                                              (string.eq other "u16")
                                              (string.eq other "u8")
                                              (string.eq other "char"))]
                                          (match (or
                                            (= (string.string-length key) 0)
                                            (= (string.string-length value) 0)
                                            (= (string.string-length kind) 0)
                                            (= (string.string-length other) 0))
                                            [true false]
                                            [false
                                              (match (string.eq key value)
                                                [true true]
                                                [false
                                                  (match (or
                                                    (tc-macro-proof-field
                                                      proof-state
                                                      checked-context)
                                                    first
                                                    second
                                                    left
                                                    right
                                                    result
                                                    saved
                                                    (tc-macro-proof-field
                                                      proof-state
                                                      shifted)
                                                    (tc-macro-proof-field
                                                      proof-state
                                                      has-operands)
                                                    (tc-macro-proof-field
                                                      proof-state
                                                      reflection-env)
                                                    (tc-macro-proof-field
                                                      proof-state
                                                      negative-literal)
                                                    (and
                                                      (>
                                                        (tc-macro-proof-field
                                                          proof-state
                                                          digit-count)
                                                        0)
                                                      (not state))
                                                    (and
                                                      (tc-macro-proof-field
                                                        proof-state
                                                        conditional-operand)
                                                      (not
                                                        (string.eq kind other))))
                                                    [true false]
                                                    [false
                                                      (type-dedup-ok-for-state?
                                                        proof-state
                                                        other
                                                        0)])])]))
                                          unit
                                          (set! ok false)))
                                      (set! index (+ index 1))))
                                  ok))))
                            (TcProofReuseGeneratedDeclSkip)
                            (TcProofReuseGeneratedDeclConcrete))))]
                    [(spec.SpecMaybeString.None)
                      (TcProofReuseGeneratedDeclConcrete)]))))))))))

(define (tc-check-nonfn-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (match decl
    [(ast.AstDecl.Def decl-meta _ maybe-ty expr-box)
      (match maybe-ty
        [(ast.AstMaybeType.Some want)
          (let
            [resolved-want : ast.AstType (tc-resolve-type ctx want)]
            (match (tc-expr-with-expected-or-actual-id
              ctx
              global-env
              expr-box
              resolved-want)
              [(ResultTcType.Ok inferred)
                (let
                  [matched-got : TcInferredTypeMatch
                    (tc-match-inferred-type-for-expected
                      ctx
                      global-env
                      inferred
                      resolved-want)]
                  [got : ast.AstType
                    (match matched-got
                      [(TcInferredTypeMatch.Compatible actual) actual]
                      [(TcInferredTypeMatch.Mismatch actual) actual])]
                  [expect-result : ResultTcUnit
                    (match matched-got
                      [(TcInferredTypeMatch.Compatible _) ResultTcUnit.Ok]
                      [(TcInferredTypeMatch.Mismatch actual)
                        (ResultTcUnit.Err
                          (tc-type-mismatch-message-in-context
                            ctx
                            global-env
                            actual
                            resolved-want
                            "typecheck: value definition type mismatch"))])]
                  (match expect-result
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-region-value-can-flow-into
                        global-env
                        resolved-want
                        got
                        "top-level value")
                        [(ResultTcUnit.Ok)
                          (tc-move-check-global-initializer-id
                            ctx
                            global-env
                            expr-box
                            resolved-want)]
                        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
              [(ResultTcType.Err message) (ResultTcUnit.Err message)]))]
        [(ast.AstMaybeType.No)
          (match (tc-expr-id ctx global-env expr-box)
            [(ResultTcType.Ok inferred)
              (tc-move-check-global-initializer-id
                ctx
                global-env
                expr-box
                inferred)]
            [(ResultTcType.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstDecl.DefFn decl-meta name params ret body-box _)
      ;; Unreachable via the dispatcher above; kept so a direct call can never
      ;; silently skip a function body check.
      (match (tc-elide-function-signature
        (tc-context-type-bases ctx)
        params
        ret)
        [(ResultTcElidedSignature.Ok signature)
          (tc-check-fn-decl-scoped
            ctx
            global-env
            name
            signature.params
            signature.ret
            body-box)]
        [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstDecl.DefMacro decl-meta name params ret body-box)
      (let
        [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
        (tc-check-defmacro name ctx top-env params ret body))]
    [(ast.AstDecl.Extern decl-meta _ kind metadata ty)
      (tc-check-extern-decl ctx kind (__tl-box-place metadata) ty)]
    [(ast.AstDecl.DefDispatch decl-meta name variants)
      (match (tc-dispatch-decl-type ctx name variants)
        [(ResultTcType.Ok _) ResultTcUnit.Ok]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstDecl.DefEnum decl-meta name cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        (ast.ast-lifetime-list-new)
        cleanup
        variants)]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (tc-check-cleanup-enum-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        lifetimes
        cleanup
        variants)]
    [(ast.AstDecl.DefStruct decl-meta name repr cleanup fields)
      (tc-check-cleanup-struct-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        repr
        cleanup
        fields)]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ repr cleanup fields)
      (tc-check-cleanup-struct-decl
        ctx
        top-env
        (tc-check-decl-scoped-name-id ctx name)
        repr
        cleanup
        fields)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (tc-check-decl-with-global-env ctx top-env global-env inner))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcUnit
  (begin
    (tc-unbound-suggestion-snapshot-reset!)
    (if (ast.ast-decl-comptime-only? decl)
      (let
        [template : ast.AstDecl
          (ast.ast-decl-with-meta (ast.ast-decl-meta-runtime-shared-view) decl)]
        (match (ast.ast-decl-generated-meta decl)
          [(ast.AstGeneratedDeclMeta.Some generator item _ identity)
            (begin
              ;; Every generated attempt starts concrete; the profile hook
              ;; reads this bit only after the declaration succeeds.
              (tc-macro-proof-set! (tc-context-macro-state ctx) next-skip false)
              (let
                [result : TcProofReuseGeneratedDeclDecision
                  (tc-proof-reuse-generated-decl-decision
                    ctx
                    generator
                    item
                    identity
                    decl)]
                (match result
                  [(TcProofReuseGeneratedDeclSkip)
                    (begin
                      (tc-macro-proof-set!
                        (tc-context-macro-state ctx)
                        next-skip
                        true)
                      (cfg
                        test
                        (set!
                          tc-proof-reuse-skips-total
                          (+ tc-proof-reuse-skips-total 1)))
                      ResultTcUnit.Ok)]
                  [(TcProofReuseGeneratedDeclConcrete)
                    (tc-check-decl-with-global-env-inner
                      ctx
                      top-env
                      global-env
                      template)]
                  [(TcProofReuseGeneratedDeclConcreteSeed)
                    (let
                      [result : ResultTcUnit
                        (tc-check-decl-with-global-env-inner
                          ctx
                          top-env
                          global-env
                          template)]
                      (begin
                        ;; A family row is seeded only by a successful
                        ;; concrete check.  The note operation preserves the
                        ;; first row and is never repeated for ordinary
                        ;; concrete decisions or failed checks.
                        (match result
                          [(ResultTcUnit.Ok)
                            (record-slot-for-state
                              (tc-context-macro-state ctx)
                              generator
                              item
                              identity
                              (tc-context-module-id ctx)
                              decl)]
                          [(ResultTcUnit.Err _) unit])
                        result))])))]
          [(ast.AstGeneratedDeclMeta.No)
            (match (tc-check-comptime-decl-purity ctx top-env template)
              [(ResultTcUnit.Ok)
                (tc-check-decl-with-global-env-inner
                  ctx
                  top-env
                  global-env
                  template)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]))
      (tc-check-decl-with-global-env-inner ctx top-env global-env decl))))

(define (tc-check-decl-scoped-name-id [ctx : TcContext] [name : i64]) : i64
  (if (and
    (> (string.string-length (tc-context-module ctx)) 0)
    (not (tc-name-qualified-id? name)))
    (tc-module-name-id-by-id (tc-context-module-id ctx) name)
    name))

(define (tc-check-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (tc-check-decls-with-paths-in-module
    ctx
    top-env
    decls
    (ast.ast-decl-path-list-new)
    summary
    ""
    cbi.compiler-builtin-id-fix-empty
    (tc-empty-module-local-env-cache)))

(define (tc-decl-path-list-last [paths : ast.AstDeclPathList] [last : String]) : String
  (match (ast.ast-decl-path-list-step paths)
    [(ast.AstDeclPathListStep.Nil) last]
    [(ast.AstDeclPathListStep.Cons path rest)
      (let
        [rest : ast.AstDeclPathList rest]
        (tc-decl-path-list-last rest path))]))

(define (tc-prefix-decl-key-inner [decl : ast.AstDecl]) : String
  (match decl
    [(ast.AstDecl.Module name)
      (str_cat.str-cat "module:" (tc-env-key-name-text name))]
    [(ast.AstDecl.ModuleBody name _)
      (str_cat.str-cat "module-body:" (tc-env-key-name-text name))]
    [(ast.AstDecl.Def decl-meta name _ _)
      (str_cat.str-cat "def:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (str_cat.str-cat "fn:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefMacro decl-meta name _ _ _)
      (str_cat.str-cat "macro:" (tc-env-key-name-text name))]
    [(ast.AstDecl.Extern decl-meta name _ _ _)
      (str_cat.str-cat "extern:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefEnum decl-meta name _ _)
      (str_cat.str-cat "enum:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (str_cat.str-cat "enum-lifetimes:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefStruct decl-meta name _ _ _)
      (str_cat.str-cat "struct:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (str_cat.str-cat "struct-lifetimes:" (tc-env-key-name-text name))]
    [(ast.AstDecl.Import decl-meta _) "import"]
    [(ast.AstDecl.IncludeStr name _)
      (str_cat.str-cat "include-str:" (tc-env-key-name-text name))]
    [(ast.AstDecl.IncludeStrComptime name _)
      (str_cat.str-cat "include-str-comptime:" (tc-env-key-name-text name))]
    [(ast.AstDecl.IncludeStrLzss name _)
      (str_cat.str-cat "include-str-lzss:" (tc-env-key-name-text name))]
    [(ast.AstDecl.IncludeBin name _)
      (str_cat.str-cat "include-bin:" (tc-env-key-name-text name))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (str_cat.str-cat "dispatch:" (tc-env-key-name-text name))]
    [(ast.AstDecl.Test name _ _)
      (str_cat.str-cat "test:" (tc-env-key-name-text name))]
    [(ast.AstDecl.Unsafe inner)
      (str_cat.str-cat
        "unsafe:"
        (tc-prefix-decl-key-inner (__tl-box-place inner)))]))

(define (tc-prefix-decl-key [decl : ast.AstDecl]) : String
  (if (ast.ast-decl-comptime-only? decl)
    (str_cat.str-cat "comptime:" (tc-prefix-decl-key-inner decl))
    (tc-prefix-decl-key-inner decl)))

(define (tc-prefix-key-add
  [key : String]
  [decl-path : String]
  [decl : ast.AstDecl]) : String
  (str_cat.str-cat
    key
    (string.int->string (string.string-length decl-path))
    ":"
    decl-path
    ":"
    (tc-prefix-decl-key decl)
    ";"))

(define (tc-prefix-key-add-entry-module-marker [key : String] [module : String]) : String
  (str_cat.str-cat
    key
    "entry-module:"
    (string.int->string (string.string-length module))
    ":"
    module
    ";"))

(define (tc-prefix-key-start [scope : String]) : String
  (str_cat.str-cat
    "tc-prefix-v3;"
    (string.int->string (string.string-length scope))
    ":"
    scope
    ";"))

(define (tc-prefix-default-cache-scope) : String
  "direct")

(define (tc-prefix-cache-stdlib-path? [path : String] [stdlib-roots : svec.Vec]) : bool
  (if (cload.compiler-load-stdlib-import? path)
    true
    (let
      [normalized : String (cload.compiler-load-normalize-path path)]
      (if (cload.compiler-load-stdlib-import? normalized)
        true
        (cload.compiler-load-path-under-roots-from?
          normalized
          stdlib-roots
          0
          (svec.len (& stdlib-roots)))))))

(define (tc-prefix-cache-module-marker? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Module name)
      (> (string.string-length (tc-env-key-name-text name)) 0)]
    [_ false]))

(define (tc-prefix-cache-decl-safe?
  [decl-path : String]
  [decl : ast.AstDecl]
  [stdlib-roots : svec.Vec]
  [same-path-module-safe : bool]) : bool
  (if (tc-prefix-cache-stdlib-path? decl-path stdlib-roots)
    true
    (or same-path-module-safe (tc-prefix-cache-module-marker? decl))))

(define (tc-prefix-candidate-from
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [entry-path : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [active-path : String]
  [active-path-module-safe : bool]
  [key : String]) : TcPrefixCandidate
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) (TcPrefixCandidate.No)]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) ""])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        [same-path : bool (string.eq active-path decl-path)]
        [same-path-module-safe : bool
          (if same-path
            active-path-module-safe
            false)]
        [decl-module-safe : bool
          (or same-path-module-safe (tc-prefix-cache-module-marker? decl))]
        (cond
          [(and
              (string.eq decl-path entry-path)
              (= count 0)
              (tc-prefix-cache-module-marker? decl))
            (let
              [next-module : String
                (match decl
                  [(ast.AstDecl.Module next-module)
                    (tc-env-key-name-text next-module)]
                  [_ module])]
              [next-module-id : i64
                (match decl
                  [(ast.AstDecl.Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                next-module-id
                decl-path
                true
                (tc-prefix-key-add-entry-module-marker key next-module)))]
          [(string.eq decl-path entry-path)
            (if (> count 0)
              (TcPrefixCandidate.Some key count module module-id)
              (TcPrefixCandidate.No))]
          [(tc-prefix-cache-decl-safe?
              decl-path
              decl
              stdlib-roots
              same-path-module-safe)
            (let
              [next-module : String
                (match decl
                  [(ast.AstDecl.Module next-module)
                    (tc-env-key-name-text next-module)]
                  [_ module])]
              [next-module-id : i64
                (match decl
                  [(ast.AstDecl.Module next-module) next-module]
                  [_ module-id])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                next-module-id
                decl-path
                decl-module-safe
                (tc-prefix-key-add key decl-path decl)))]
          [(> count 0) (TcPrefixCandidate.Some key count module module-id)]
          [else (TcPrefixCandidate.No)]))]))

(define (tc-prefix-candidate
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec (:consume)]
  [cache-scope : String]) : TcPrefixCandidate
  (let
    [entry-path : String (tc-decl-path-list-last paths "")]
    [effective-roots : svec.Vec
      (cload.compiler-load-roots-with-env stdlib-roots)]
    (if (string.eq entry-path "")
      (TcPrefixCandidate.No)
      (tc-prefix-candidate-from
        decls
        paths
        effective-roots
        entry-path
        0
        ""
        cbi.compiler-builtin-id-fix-empty
        ""
        false
        (tc-prefix-key-start cache-scope)))))

(define (tc-decl-list-take [decls : ast.AstDeclList] [count : i64]) : ast.AstDeclList
  (if (<= count 0)
    (ast.ast-decl-list-new)
    (let
      [len : i64 (ast.ast-decl-list-len (& decls))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (ast.AstDeclList decls.slots decls.offset take-count false))))

(define (tc-decl-path-list-take [paths : ast.AstDeclPathList] [count : i64]) : ast.AstDeclPathList
  (if (<= count 0)
    (ast.ast-decl-path-list-new)
    (let
      [len : i64 (ast.ast-decl-path-list-len (& paths))]
      [take-count : i64
        (if (< count len)
          count
          len)]
      (ast.AstDeclPathList
        paths.slots
        paths.owner-ids
        paths.offset
        take-count
        false))))

(define (tc-decl-list-drop [decls : ast.AstDeclList] [count : i64]) : ast.AstDeclList
  (if (<= count 0)
    decls
    (let
      [len : i64 (ast.ast-decl-list-len (& decls))]
      (if (>= count len)
        (ast.ast-decl-list-new)
        (ast.AstDeclList decls.slots (+ decls.offset count) (- len count) false)))))

(define (tc-decl-path-list-drop [paths : ast.AstDeclPathList] [count : i64]) : ast.AstDeclPathList
  (if (<= count 0)
    paths
    (let
      [len : i64 (ast.ast-decl-path-list-len (& paths))]
      (if (>= count len)
        (ast.ast-decl-path-list-new)
        (ast.AstDeclPathList
          paths.slots
          paths.owner-ids
          (+ paths.offset count)
          (- len count)
          false)))))

(define (tc-check-decls-with-paths-cold
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      decls
      paths
      summary
      ""
      cbi.compiler-builtin-id-fix-empty
      (tc-empty-module-local-env-cache))))

(define (tc-check-decls-with-prefix-hit
  [prefix-cache : TcPrefixSnapshotCacheState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-hit-for-state! prefix-cache)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      summary
      module
      module-id
      (tc-empty-module-local-env-cache))))

(define (tc-check-decls-with-prefix-miss
  [prefix-cache : TcPrefixSnapshotCacheState]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-miss-for-state! prefix-cache)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (match (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-take decls count)
      (tc-decl-path-list-take paths count)
      (CompilerTypecheckSummary 0 0 0)
      ""
      cbi.compiler-builtin-id-fix-empty
      (tc-empty-module-local-env-cache))
      [(ResultCompilerTypecheck.Ok prefix-summary)
        (begin
          (tc-prefix-snapshot-cache-store-persistent-for-state
            prefix-cache
            key
            count
            module
            module-id
            prefix-summary)
          (cfg compile-profile (compiler-tc-decl-profile-reset))
          (tc-check-decls-with-paths-in-module
            ctx
            top-env
            (tc-decl-list-drop decls count)
            (tc-decl-path-list-drop paths count)
            prefix-summary
            module
            module-id
            (tc-empty-module-local-env-cache)))]
      ;; Prefix snapshots only store successful summaries. If an imported
      ;; prefix is invalid, rerun the complete walk so diagnostic recovery can
      ;; continue through later imports and the entry source.
      [(ResultCompilerTypecheck.Err _)
        (tc-check-decls-with-paths-cold
          ctx
          top-env
          decls
          paths
          (CompilerTypecheckSummary 0 0 0))])))

(cfg
  compile-profile
  (define (tc-profile-surface-prefix-hit [count : i64]) : unit
    (cfg
      compile-profile-summary
      unit
      (begin
        (io.print-error
          "compile-profile-detail|prelude.typecheck_decl_checks|0\n")
        (io.print-error
          (str_cat.str-cat
            "compile-profile-detail|prelude.typecheck_skipped_decls|"
            (string.int->string count)
            "\n"))))))

(define (tc-check-decls-with-surface-prefix-hit
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [count : i64]
  [module : String]
  [module-id : i64]
  [facts : surface_facts.SurfaceTypecheckFacts]) : ResultCompilerTypecheck
  (begin
    (tc-clone-root-collection-apply-surface-facts!)
    (cfg compile-profile (tc-profile-surface-prefix-hit count))
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      (CompilerTypecheckSummary
        facts.summary-values
        facts.summary-functions
        facts.summary-externs)
      module
      module-id
      (tc-empty-module-local-env-cache))))

(define (tc-summary-decl-prefix [decls : ast.AstDeclList] [count : i64]) : CompilerTypecheckSummary
  (let
    [cursor : ast.AstDeclList decls]
    [index : i64 0]
    [summary : CompilerTypecheckSummary (CompilerTypecheckSummary 0 0 0)]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (match (ast.ast-decl-list-step cursor)
          [(ast.AstDeclListStep.Nil) (set! done true)]
          [(ast.AstDeclListStep.Cons decl rest)
            (begin
              (set! summary (tc-summary-add-decl summary decl))
              (set! cursor rest)
              (set! index (+ index 1)))]))
      summary)))

(define (tc-check-decls-with-paths
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [prefix-cache-active : bool]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [stdlib-roots : svec.Vec (:consume)]
  [cache-scope : String]) : ResultCompilerTypecheck
  ;; A cached prefix contains only its summary, not semantic observations from
  ;; the declarations it skipped. Clone-root collection therefore takes the
  ;; ordinary declaration walk even when the interactive prefix cache is on.
  (if (surface_facts.surface-typecheck-facts-active?)
    (match (if (surface_facts.surface-typecheck-facts-composite-active?)
      (tc-dependency-surface-prefix-candidate
        load-state
        decls
        paths
        cache-scope
        (cload.compiler-load-session-state-dependency-surface-provenance-count
          load-state))
      (tc-prefix-candidate decls paths stdlib-roots cache-scope))
      [(TcPrefixCandidate.Some _ count module module-id)
        (let
          [rebased : bool
            (if (surface_facts.surface-typecheck-facts-composite-active?)
              (match (tc-summary-decl-prefix decls count)
                [(CompilerTypecheckSummary values functions externs)
                  (surface_facts.surface-typecheck-facts-rebase-composite-typecheck-prefix!
                    count
                    values
                    functions
                    externs)])
              true)]
          [facts : surface_facts.SurfaceTypecheckFacts
            (surface_facts.surface-typecheck-facts-current)]
          (if (and rebased (= count facts.prefix-decl-count))
            (begin
              (if (surface_facts.surface-typecheck-facts-composite-active?)
                (cload.compiler-load-session-state-dependency-surface-note-typecheck-skip!
                  load-state
                  count)
                unit)
              (tc-check-decls-with-surface-prefix-hit
                ctx
                top-env
                decls
                paths
                count
                module
                module-id
                facts))
            (begin
              (surface_facts.surface-typecheck-facts-clear!)
              (tc-check-decls-with-paths-cold ctx top-env decls paths summary))))]
      [(TcPrefixCandidate.No)
        (begin
          (surface_facts.surface-typecheck-facts-clear!)
          (tc-check-decls-with-paths-cold ctx top-env decls paths summary))])
    (if (and prefix-cache-active (not tc-clone-root-collection-active))
      (match (tc-prefix-candidate decls paths stdlib-roots cache-scope)
        [(TcPrefixCandidate.Some key count module module-id)
          (match (tc-prefix-snapshot-cache-lookup-for-state prefix-cache key)
            [(TcPrefixSnapshotLookup.Hit
                cached-count
                cached-module
                cached-module-id
                cached-summary)
              (tc-check-decls-with-prefix-hit
                prefix-cache
                ctx
                top-env
                decls
                paths
                cached-count
                cached-module
                cached-module-id
                cached-summary)]
            [(TcPrefixSnapshotLookup.Miss)
              (tc-check-decls-with-prefix-miss
                prefix-cache
                ctx
                top-env
                decls
                paths
                key
                count
                module
                module-id)])]
        [(TcPrefixCandidate.No)
          (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])
      (tc-check-decls-with-paths-cold ctx top-env decls paths summary))))

(define (tc-typecheck-diag-with-maybe-origin-and-path
  [origin : parser.CompilerParseMaybeDeclSpan]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (let
    [diag : cdiag.CompilerDiagnostic
      (tc-decl-diag-with-maybe-origin origin decl message)]
    (cdiag.compiler-diagnostic-with-fallback-path diag path)))

(define (tc-typecheck-diag-with-path
  [decls : (& decls ast.AstDeclList)]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    (parser.compiler-parse-decl-origin-span decls 0)
    decl
    path
    message))

(define (tc-typecheck-diag-with-rest-path
  [rest : (& rest ast.AstDeclList)]
  [decl : ast.AstDecl]
  [path : String]
  [message : String]) : cdiag.CompilerDiagnostic
  (tc-typecheck-diag-with-maybe-origin-and-path
    (parser.compiler-parse-decl-origin-span-key-slot
      (parser.compiler-parse-decl-list-storage-key rest)
      (- rest.offset 1))
    decl
    path
    message))

;; Direct declaration typechecking stays below the self-build memory budget and
;; avoids the per-declaration scratch arena overhead.
(defstruct TcPoisonNameList
  ;; Poisoned declarations are rare error-path state. Keep each returned value
  ;; as an independent snapshot so declaration scratch arenas cannot invalidate
  ;; or mutate a sibling snapshot.
  (slots (__tl_dyn-array i64))
  (len i64))

(defenum TcMaybePoisonName
  (No)
  (Some i64))

;; Keep construction and append as ordinary declaration boundaries. Before the
;; dotted-constructor cache-domain fix (#6451), these exact helpers changed the
;; direct-mapped cache collision order and exposed #6324 during profile selfhost.
(cfg
  compile-profile
  (define (tc-poison-name-list-new) : TcPoisonNameList
    (TcPoisonNameList (array.make-array i64 0) 0)))

(cfg
  compile-profile
  (define (tc-poison-name-list-push [names : TcPoisonNameList] [name : i64]) : TcPoisonNameList
    (let
      [len : i64 names.len]
      [slots : (__tl_dyn-array i64) names.slots]
      [next : (__tl_dyn-array i64) (array.make-array i64 (+ len 1))]
      [index : i64 0]
      (begin
        (while (< index len)
          (begin
            (set! (array-ref next index) (array-ref slots index))
            (set! index (+ index 1))))
        (set! (array-ref next len) name)
        (TcPoisonNameList next (+ len 1))))))

(define (tc-decl-poison-name [module-id : i64] [decl : ast.AstDecl]) : TcMaybePoisonName
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.Extern decl-meta name _ _ _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.DefStruct decl-meta name _ _ _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (TcMaybePoisonName.Some (tc-module-name-id-by-id module-id name))]
    [(ast.AstDecl.Unsafe inner)
      (tc-decl-poison-name module-id (__tl-box-place inner))]
    [_ TcMaybePoisonName.No]))

(define (tc-poison-name-list-bind [env : TcTypeEnv] [names : TcPoisonNameList]) : TcTypeEnv
  (if (= names.len 0)
    env
    (let
      [index : i64 0]
      [out : TcTypeEnv env]
      (begin
        ;; Slots are appended oldest to newest, matching the former recursive
        ;; bind order and its duplicate-name shadowing behavior.
        (while (< index names.len)
          (begin
            (set!
              out
              (tc-bind-id out (array-ref names.slots index) (tc-poison-type)))
            (set! index (+ index 1))))
        out))))

(define (tc-poison-decl-env
  [env : TcTypeEnv]
  [module-id : i64]
  [decl : ast.AstDecl]) : TcTypeEnv
  (match (tc-decl-poison-name module-id decl)
    [(TcMaybePoisonName.No) env]
    [(TcMaybePoisonName.Some name) (tc-bind-id env name (tc-poison-type))]))

(define (tc-poison-name-list-add-decl
  [names : TcPoisonNameList]
  [module-id : i64]
  [decl : ast.AstDecl]) : TcPoisonNameList
  (match (tc-decl-poison-name module-id decl)
    [(TcMaybePoisonName.No) names]
    [(TcMaybePoisonName.Some name)
      (cfg
        compile-profile
        (tc-poison-name-list-push names name)
        (let
          [len : i64 names.len]
          [slots : (__tl_dyn-array i64) names.slots]
          [next : (__tl_dyn-array i64) (array.make-array i64 (+ len 1))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (set! (array-ref next index) (array-ref slots index))
                (set! index (+ index 1))))
            (set! (array-ref next len) name)
            (TcPoisonNameList next (+ len 1)))))]))

(define (tc-check-decls-with-paths-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-start-section))
    (match (tc-module-local-env-cached-id ctx top-env module module-id cache)
      [(ResultTcModuleLocalEnv.Ok local-env next-cache)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (tc-check-decls-with-paths-in-module-env
            ctx
            top-env
            decls
            paths
            summary
            module
            module-id
            next-cache
            local-env
            (tc-hygiene-global-env local-env)))]
      [(ResultTcModuleLocalEnv.Err message)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (ResultCompilerTypecheck.Err
            (box
              (cdiag.compiler-diagnostic-list-single (tc-diag-at-start message)))))])))

(define (tc-check-decls-with-paths-in-module-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]
  [local-env : TcTypeEnv]
  [global-env : TcTypeEnv]) : ResultCompilerTypecheck
  ;; This walks every expanded top-level declaration during self-compile.
  ;; Keep it iterative so a large program does not consume one native stack frame
  ;; per declaration on Windows selfhost binaries.
  (let
    [dotted-modules : sym_i64_env.SymI64Env
      (match (tc-context-program ctx)
        [(ast.AstProgram.Program decls-box)
          (__tl-project-field
            (csym.compiler-symbols-module-sets (__tl-box-place decls-box))
            dotted-modules)])]
    [cur-decls : ast.AstDeclList decls]
    [cur-paths : ast.AstDeclPathList paths]
    [cur-summary : CompilerTypecheckSummary summary]
    [cur-module-id : i64 module-id]
    [cur-module : String (clone module)]
    [cur-cache : TcModuleLocalEnvCache cache]
    [cur-local-env : TcTypeEnv local-env]
    [cur-global-env : TcTypeEnv global-env]
    [poison-names : TcPoisonNameList
      (cfg
        compile-profile
        (tc-poison-name-list-new)
        (TcPoisonNameList (array.make-array i64 0) 0))]
    [diagnostics : cdiag.CompilerDiagnosticList
      (cdiag.compiler-diagnostic-list-empty)]
    [type-module-cache-valid : bool false]
    [type-module-cache-path-owner-id : i64 -1]
    [type-module-cache-id : i64 -1]
    [result : ResultCompilerTypecheck
      (ResultCompilerTypecheck.Err
        (box
          (cdiag.compiler-diagnostic-list-single
            (tc-diag-at-start "typecheck: internal decls walk"))))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast.ast-decl-list-step cur-decls)
          [(ast.AstDeclListStep.Nil)
            (begin
              (cfg
                compile-profile
                (compiler-tc-dependency-tlci-route-profile-finish
                  (tc-context-macro-state ctx)))
              (cfg compile-profile (compiler-tc-decl-profile-finish))
              (set!
                result
                (if (= (cdiag.compiler-diagnostic-list-count diagnostics) 0)
                  (ResultCompilerTypecheck.Ok cur-summary)
                  (ResultCompilerTypecheck.Err (box diagnostics))))
              (set! done true))]
          [(ast.AstDeclListStep.Cons decl rest)
            (let
              [rest : ast.AstDeclList rest]
              [decl-path : String
                (match (ast.ast-decl-path-list-step cur-paths)
                  [(ast.AstDeclPathListStep.Cons path _) path]
                  [(ast.AstDeclPathListStep.Nil) ""])]
              [rest-paths : ast.AstDeclPathList
                (match (ast.ast-decl-path-list-step cur-paths)
                  [(ast.AstDeclPathListStep.Cons _ path-rest)
                    (let
                      [path-rest : ast.AstDeclPathList path-rest]
                      path-rest)]
                  [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
              [_select-clone-root-decl : unit
                (tc-clone-root-collection-select-decl! decl cur-module-id)]
              (match decl
                [(ast.AstDecl.Module next-module)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-tc-decl-profile-start-section))
                    (tc-context-capture-active-pools! ctx)
                    (match (tc-module-local-env-cached-id
                      ctx
                      top-env
                      (tc-env-key-name-text next-module)
                      next-module
                      cur-cache)
                      [(ResultTcModuleLocalEnv.Ok next-local-env next-cache)
                        (match (tc-module-local-env-cached-id
                          ctx
                          top-env
                          (tc-env-key-name-text next-module)
                          next-module
                          cur-cache)
                          [(ResultTcModuleLocalEnv.Ok next-local-env-copy _)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set!
                                cur-module
                                (tc-env-key-name-text next-module))
                              (set! cur-module-id next-module)
                              (set! cur-cache next-cache)
                              (set!
                                cur-global-env
                                (tc-poison-name-list-bind
                                  (tc-hygiene-global-env next-local-env)
                                  poison-names))
                              (set!
                                cur-local-env
                                (tc-poison-name-list-bind
                                  next-local-env-copy
                                  poison-names)))]
                          [(ResultTcModuleLocalEnv.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (cdiag.compiler-diagnostic-list-push!
                                (&mut diagnostics)
                                (tc-typecheck-diag-with-rest-path
                                  (& rest)
                                  decl
                                  decl-path
                                  message))
                              (set!
                                result
                                (ResultCompilerTypecheck.Err (box diagnostics)))
                              (set! done true))])]
                      [(ResultTcModuleLocalEnv.Err message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-decl-profile-add-local-env))
                          (cdiag.compiler-diagnostic-list-push!
                            (&mut diagnostics)
                            (tc-typecheck-diag-with-rest-path
                              (& rest)
                              decl
                              decl-path
                              message))
                          (set!
                            result
                            (ResultCompilerTypecheck.Err (box diagnostics)))
                          (set! done true))]))]
                [_
                  (if (and
                    (string.eq decl-path "")
                    (match decl
                      [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
                        (let
                          [name-text : String (tc-env-key-name-text name)]
                          (and
                            (>= (string.string-length name-text) 6)
                            (string.eq
                              (string.substring name-text 0 6)
                              "clone$")))]
                      [_ false]))
                    (begin
                      (set! cur-decls rest)
                      (set! cur-paths rest-paths)
                      (set! cur-summary (tc-summary-add-decl cur-summary decl)))
                    (let
                      [decl-base-ctx : TcContext
                        (tc-context-with-module-id ctx cur-module cur-module-id)]
                      [path-owner-id : i64
                        (ast.ast-decl-path-list-owner-id
                          (& cur-paths)
                          0
                          cbi.compiler-builtin-id-fix-empty)]
                      [type-module-id : i64
                        (if (and
                          (csym.compiler-symbol-root-module-id? cur-module-id)
                          (not (ast.ast-decl-comptime-only? decl))
                          (not (macro-decl-generated? decl)))
                          (if (and
                            type-module-cache-valid
                            (= path-owner-id type-module-cache-path-owner-id))
                            type-module-cache-id
                            (let
                              [resolved-type-module-id : i64
                                (tc-context-type-module-id-for-path-owner
                                  dotted-modules
                                  decl-path
                                  path-owner-id)]
                              (begin
                                (set! type-module-cache-valid true)
                                (set!
                                  type-module-cache-path-owner-id
                                  path-owner-id)
                                (set!
                                  type-module-cache-id
                                  resolved-type-module-id)
                                resolved-type-module-id)))
                          -1)]
                      [decl-ctx : TcContext
                        (if (>= type-module-id 0)
                          (tc-context-with-type-module-id
                            decl-base-ctx
                            type-module-id)
                          decl-base-ctx)]
                      [unused-unsafe : TcUnusedUnsafeState
                        (tc-job-state-unused-unsafe
                          (tc-context-job-state decl-ctx))]
                      [prev-path : String
                        (tc-unused-unsafe-set-current-path!
                          unused-unsafe
                          decl-path)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-decl-profile-start-section))
                        (tc-context-capture-active-pools! decl-ctx)
                        (tc-poison-observation-reset!)
                        (match (tc-check-decl-with-global-env
                          decl-ctx
                          cur-local-env
                          cur-global-env
                          decl)
                          [(ResultTcUnit.Ok)
                            (begin
                              (tc-unused-unsafe-restore-current-path!
                                unused-unsafe
                                prev-path)
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (if tc-poison-observed
                                (begin
                                  (set!
                                    cur-local-env
                                    (tc-poison-decl-env
                                      cur-local-env
                                      cur-module-id
                                      decl))
                                  (set!
                                    cur-global-env
                                    (tc-poison-decl-env
                                      cur-global-env
                                      cur-module-id
                                      decl))
                                  (set!
                                    poison-names
                                    (tc-poison-name-list-add-decl
                                      poison-names
                                      cur-module-id
                                      decl)))
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-tc-decl-profile-record
                                      decl-ctx
                                      decl))
                                  (set!
                                    cur-summary
                                    (tc-summary-add-decl cur-summary decl)))))]
                          [(ResultTcUnit.Err message)
                            (begin
                              (tc-unused-unsafe-restore-current-path!
                                unused-unsafe
                                prev-path)
                              (if tc-poison-observed
                                unit
                                (cdiag.compiler-diagnostic-list-push!
                                  (&mut diagnostics)
                                  (tc-typecheck-diag-with-rest-path
                                    (& rest)
                                    decl
                                    decl-path
                                    message)))
                              (set!
                                cur-local-env
                                (tc-poison-decl-env
                                  cur-local-env
                                  cur-module-id
                                  decl))
                              (set!
                                cur-global-env
                                (tc-poison-decl-env
                                  cur-global-env
                                  cur-module-id
                                  decl))
                              (set!
                                poison-names
                                (tc-poison-name-list-add-decl
                                  poison-names
                                  cur-module-id
                                  decl))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths))]))))]))]))
      result)))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools-and-source-names-and-prefix-cache-state
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [body-state : TcBodyState]) : ResultCompilerTypecheckChecked
  (begin
    (tc-prefix-snapshot-cache-prepare-for-job!
      prefix-cache
      (tc-prefix-snapshot-cache-provenance-from-job
        load-state
        pools
        source-names))
    (tc-nominal-owner-cache-reset!)
    (tc-install-pools! pools)
    (match (csym.build-compiler-symbols-diagnostic-with-paths program paths)
      [(csym.ResultCompilerSymbolsDiagnostic.Ok symbols)
        (match (csym.build-compiler-registries-diagnostic-with-symbols-and-paths
          program
          symbols
          paths)
          [(csym.ResultCompilerRegistriesDiagnostic.Ok registries)
            (let
              [ctx : TcContext
                (tc-context-new-with-source-names-and-body-state
                  program
                  symbols
                  registries
                  ""
                  cbi.compiler-builtin-id-fix-empty
                  pools
                  source-names
                  body-state)]
              (match (tc-stdlib-comptime-surface-ok ctx)
                [(ResultTcUnit.Ok)
                  (match (tc-program-source-types-policy-ok ctx program paths)
                    [(ResultTcSourcePolicyDiagnostic.Ok)
                      (match (tc-build-top-env ctx program)
                        [(ResultTcEnv.Ok top-env)
                          (match program
                            [(ast.AstProgram.Program decls-box)
                              (let
                                [decls : ast.AstDeclList
                                  (__tl-box-place decls-box)]
                                (begin
                                  (tc-hygiene-reset-active-top-env!
                                    (tc-context-macro-state ctx)
                                    top-env)
                                  (tc-context-capture-active-pools! ctx)
                                  (tc-clone-able-cache-populate! ctx)
                                  (tc-macro-helper-env-cache-reset!
                                    (tc-context-macro-state ctx))
                                  (match (tc-check-decls-with-paths
                                    load-state
                                    prefix-cache
                                    (tc-prefix-snapshot-cache-active-for-state?
                                      prefix-cache
                                      load-state)
                                    ctx
                                    top-env
                                    decls
                                    paths
                                    (CompilerTypecheckSummary 0 0 0)
                                    stdlib-roots
                                    cache-scope)
                                    [(ResultCompilerTypecheck.Ok summary)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (ResultCompilerTypecheckChecked.Ok
                                          summary
                                          ctx
                                          top-env
                                          paths))]
                                    [(ResultCompilerTypecheck.Err diag)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (ResultCompilerTypecheckChecked.Partial
                                          diag
                                          ctx
                                          top-env
                                          paths))])))])]
                        [(ResultTcEnv.Err message)
                          (ResultCompilerTypecheckChecked.Err
                            (box
                              (cdiag.compiler-diagnostic-list-single
                                (tc-diag-at-start message))))])]
                    [(ResultTcSourcePolicyDiagnostic.Err diag)
                      (ResultCompilerTypecheckChecked.Err
                        (cdiag.compiler-diagnostic-list-box-single diag))])]
                [(ResultTcUnit.Err message)
                  (ResultCompilerTypecheckChecked.Err
                    (box
                      (cdiag.compiler-diagnostic-list-single
                        (tc-diag-at-start message))))]))]
          [(csym.ResultCompilerRegistriesDiagnostic.Err diag)
            (ResultCompilerTypecheckChecked.Err
              (cdiag.compiler-diagnostic-list-box-single diag))])]
      [(csym.ResultCompilerSymbolsDiagnostic.Err diag)
        (ResultCompilerTypecheckChecked.Err
          (cdiag.compiler-diagnostic-list-box-single diag))])))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names-and-prefix-cache-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerTypecheckChecked
  ;; Publish owner-generated IDs before the legacy body/typecheck state runs.
  (ast.ast-node-pool-context-install! pools)
  (ci.intern-compat-state-install! intern-state)
  (tc-macro-state-bind-source-names!
    (tc-job-state-macro-state job-state)
    source-names)
  (let
    [job-source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names (tc-job-state-macro-state job-state))]
    [body-state : TcBodyState
      (tc-body-state-new-with-job-state-and-source-names
        job-state
        job-source-names)]
    [_start-body-state : unit
      (tc-body-early-exit-facts-start! body-state pools)]
    [checked : ResultCompilerTypecheckChecked
      (tc-typecheck-checked-result-with-pool-check
        job-state
        (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools-and-source-names-and-prefix-cache-state
          load-state
          prefix-cache
          program
          paths
          stdlib-roots
          cache-scope
          pools
          job-source-names
          body-state))]
    (begin
      (ast.ast-node-pool-context-capture-active! pools)
      (ci.intern-compat-state-capture-from-globals! intern-state)
      (match checked
        [(ResultCompilerTypecheckChecked.Ok summary ctx top-env checked-paths)
          (begin
            (tc-body-early-exit-facts-finish! body-state)
            (ResultCompilerTypecheckChecked.Ok
              summary
              ctx
              top-env
              checked-paths))]
        [(ResultCompilerTypecheckChecked.Partial diag ctx top-env checked-paths)
          (begin
            ;; Recovery has completed its one declaration walk. Publish the
            ;; facts proven by that walk just like a successful check; poisoned
            ;; or unresolved expressions have no fact for index consumers.
            (tc-body-early-exit-facts-finish! body-state)
            (ResultCompilerTypecheckChecked.Partial
              diag
              ctx
              top-env
              checked-paths))]
        [(ResultCompilerTypecheckChecked.Err diag)
          (begin
            (tc-body-early-exit-facts-abort! body-state)
            (ResultCompilerTypecheckChecked.Err diag))]))))

(define (typecheck-compiler-specialized-program-with-paths-cache-with-pools-and-prefix-cache-state-and-intern-state
  [load-state : cload.CompilerLoadSessionState]
  [prefix-cache : TcPrefixSnapshotCacheState]
  [job-state : TcJobState]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names-and-prefix-cache-state-and-intern-state
    load-state
    prefix-cache
    job-state
    program
    paths
    stdlib-roots
    cache-scope
    pools
    source-names
    intern-state)
    [(ResultCompilerTypecheckChecked.Ok summary _ _ _)
      (ResultCompilerTypecheck.Ok summary)]
    [(ResultCompilerTypecheckChecked.Partial diag _ _ _)
      (ResultCompilerTypecheck.Err diag)]
    [(ResultCompilerTypecheckChecked.Err diag)
      (ResultCompilerTypecheck.Err diag)]))

(define (compiler-typecheck-clear-macro-expanded-source-caches-for-job!
  [job-state : TcJobState]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    (begin
      ;; Checked lowering can retire the load/source pools before its macro pass.
      ;; Surface summaries are about to be destroyed, but lazy macro bodies may
      ;; still need their definition-site import aliases. Distill those aliases
      ;; into the id-only stub table while the summary strings are alive.
      (tc-lazy-import-surface-stubs-record-for-job! job-state)
      (tc-unbound-suggestion-snapshot-reset!)
      (tc-clone-able-cache-reset!)
      (tc-macro-helper-env-cache-reset! macro-state)
      (tc-macro-module-env-cache-clear! macro-state)
      (tc-spmd-inline-helper-stack-reset!)
      (tc-agg-caches-reset-for-job! job-state)
      (tc-nominal-owner-cache-reset!)
      (tc-stdlib-comptime-macro-surface-ok-reset! macro-state)
      (tc-unqualified-import-ambiguity-reset!)
      (macro-alias-derived-cache-reset-for-state! macro-state)
      (cload.compiler-load-surface-summaries-reset!)
      (ctfe_support.ctfe-build-seen-reset!)
      (tc-macro-walk-set! macro-state macro-expand-active-module "")
      (macro-expand-set-macro-names! macro-state (TcNameIdList.Nil))
      (macro-expand-set-expr-type-macro-names! macro-state (TcNameIdList.Nil))
      (compiler-typecheck-ctfe-env-cache-clear! macro-state)
      (macro-live-symbols-reset! macro-state)
      (macro-live-prescan-reset! macro-state)
      (tc-hygiene-clear-active-top-env! macro-state)
      (tc-lazy-import-summary-macro-force-reset-for-state! macro-state)
      (ctfe_support.ctfe-module-macro-export-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (ctfe_support.ctfe-module-value-reflection-enable-for-state!
        (tc-macro-ctfe-state macro-state)
        false)
      (ctfe_support.ctfe-module-value-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (tc-macro-walk-set! macro-state ctfe-needs-metadata true)
      (macro-generated-module-memo-reset! macro-state)
      (macro-generated-decls-memo-reset! macro-state))))

(define (compiler-typecheck-reset-file-state-for-job! [job-state : TcJobState]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    (begin
      (surface_facts.surface-typecheck-facts-clear!)
      (cfg
        (any
          compiler-surface-producer
          compiler-build-identity
          embedded-stdlib-tlci)
        (surface_facts.surface-typecheck-facts-recording-abort!)
        unit)
      (tc-unbound-suggestion-snapshot-reset!)
      (tc-job-state-release-scratch-arenas! job-state)
      (ctfe_support.ctfe-builtin-reset!)
      (set! tc-stdlib-comptime-syntax-type-cache-generation -1)
      (tc-clone-able-cache-reset!)
      (tc-macro-helper-env-cache-reset! macro-state)
      (tc-macro-module-env-cache-clear! macro-state)
      (tc-spmd-inline-helper-stack-reset!)
      (tc-agg-caches-reset-for-job! job-state)
      (tc-nominal-owner-cache-reset!)
      (tc-stdlib-comptime-macro-surface-ok-reset! macro-state)
      (tc-unqualified-import-ambiguity-reset!)
      (macro-alias-derived-cache-reset-for-state! macro-state)
      (tc-lazy-import-stubs-reset-for-job! job-state)
      (cload.compiler-load-surface-summaries-reset!)
      (ctfe_support.ctfe-build-seen-reset!)
      (tc-hygiene-clear-active-top-env! macro-state)
      (tc-macro-walk-set! macro-state macro-expand-active-module "")
      (macro-expand-set-macro-names! macro-state (TcNameIdList.Nil))
      (macro-expand-set-expr-type-macro-names! macro-state (TcNameIdList.Nil))
      (compiler-typecheck-ctfe-env-cache-clear! macro-state)
      (macro-live-symbols-reset! macro-state)
      (macro-live-prescan-reset! macro-state)
      (tc-lazy-import-summary-macro-force-reset-for-state! macro-state)
      (ctfe_support.ctfe-module-macro-export-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (ctfe_support.ctfe-module-value-reflection-enable-for-state!
        (tc-macro-ctfe-state macro-state)
        false)
      (ctfe_support.ctfe-module-value-reset-for-state!
        (tc-macro-ctfe-state macro-state))
      (tc-macro-walk-set! macro-state ctfe-needs-metadata true))))

;; Serial/test compatibility adapter. Production lowering owns and supplies a
;; job state so cache invalidation remains isolated between compiler requests.
(define (compiler-typecheck-clear-macro-expanded-source-caches!) : unit
  (compiler-typecheck-clear-macro-expanded-source-caches-for-job!
    (tc-serial-job-state)))

(define (compiler-typecheck-reset-file-state!) : unit
  (compiler-typecheck-reset-file-state-for-job! (tc-serial-job-state)))

(define (compiler-typecheck-reset-intern-owned-state!) : unit
  (begin
    (set! tc-type-env-scoped-runtime-marker-id-generation -1)
    (set! tc-signature-lifetime-marker-id-generation -1)
    (set! tc-stdlib-comptime-syntax-type-cache-generation -1)
    (set! tc-comptime-helper-prefix-cache-generation -1)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))