(cfg
  compile-profile
  (define (compiler-tc-decl-profile-record
    [ctx : TcContext]
    [decl : ast.AstDecl]) : unit
    (begin
      (match (ast.ast-decl-generated-meta decl)
        [(ast.AstGeneratedDeclMeta.Some generator _ _ _)
          (begin
            ;; The lane split is independent of whether this success was
            ;; concrete or proof-reused.  A declaration is invariant-eligible
            ;; exactly when its generator proof is complete and the tightened
            ;; dependency scan is clear; every other success is
            ;; concrete-required.
            (if (and
              (complete-key-for-state (tc-context-macro-state ctx) generator)
              (not (tc-generated-decl-dependent-construct? ctx decl)))
              (set!
                compiler-tc-macro-generated-decl-checks-invariant-eligible
                (+ compiler-tc-macro-generated-decl-checks-invariant-eligible 1))
              (set!
                compiler-tc-macro-generated-decl-checks-concrete-required
                (+ compiler-tc-macro-generated-decl-checks-concrete-required 1)))
            ;; Actual checker calls and proof reuses are mutually exclusive;
            ;; count the latter from the dispatch bit set for this attempt.
            (if (tc-macro-proof-field (tc-context-macro-state ctx) next-skip)
              (set! selected-count (+ selected-count 1))
              (set!
                compiler-tc-macro-generated-decl-checks
                (+ compiler-tc-macro-generated-decl-checks 1))))]
        [(ast.AstGeneratedDeclMeta.No) unit])
      (match decl
        [(ast.AstDecl.Def decl-meta _ _ _)
          (begin
            (compiler-tc-decl-profile-count-def)
            (compiler-tc-decl-profile-add-def-expr))]
        [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
          (begin
            (compiler-tc-decl-profile-count-fn)
            (compiler-tc-decl-profile-add-fn-expr-named
              (tc-env-key-name-text name)))]
        [(ast.AstDecl.DefMacro decl-meta _ _ _ _)
          (begin
            (compiler-tc-decl-profile-count-macro)
            (compiler-tc-decl-profile-add-macro))]
        [(ast.AstDecl.Extern decl-meta _ _ _ _)
          (begin
            (compiler-tc-decl-profile-count-extern)
            (compiler-tc-decl-profile-add-extern))]
        [_
          (begin
            (compiler-tc-decl-profile-count-other)
            (compiler-tc-decl-profile-add-arena))]))))

(cfg
  compile-profile
  (define (compiler-tc-decl-profile-line [phase : String] [value : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "compile-profile|typecheck.decl."
        phase
        (compiler-tc-profile-field value)
        "|0|0|0\n"))))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-line [phase : String] [value : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "compile-profile|typecheck.env."
        phase
        (compiler-tc-profile-field value)
        "|0|0|0\n"))))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-emit-prefix [prefix : String]) : unit
    (begin
      (compiler-tc-env-profile-line
        (str_cat.str-cat prefix "binds")
        compiler-tc-env-profile-binds)
      (compiler-tc-env-profile-line
        (str_cat.str-cat prefix "lookups")
        compiler-tc-env-profile-lookups)
      (compiler-tc-env-profile-line
