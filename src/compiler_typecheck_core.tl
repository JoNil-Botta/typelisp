      (compiler-tc-decl-profile-line-mem
        "fn_expr"
        compiler-tc-decl-profile-fn-expr-ms
        compiler-tc-decl-profile-fn-expr-alloc
        compiler-tc-decl-profile-fn-expr-live)
      (compiler-tc-decl-profile-line-mem
        "fn_move"
        compiler-tc-decl-profile-fn-move-ms
        compiler-tc-decl-profile-fn-move-alloc
        compiler-tc-decl-profile-fn-move-live)
      (compiler-tc-decl-profile-line-mem
        "macro"
        compiler-tc-decl-profile-macro-ms
        compiler-tc-decl-profile-macro-alloc
        compiler-tc-decl-profile-macro-live)
      (compiler-tc-decl-profile-line-mem
        "extern"
        compiler-tc-decl-profile-extern-ms
        compiler-tc-decl-profile-extern-alloc
        compiler-tc-decl-profile-extern-live)
      (compiler-tc-decl-profile-line
        "decl_count"
        compiler-tc-decl-profile-decl-count)
      (compiler-tc-decl-profile-line
        "def_count"
        compiler-tc-decl-profile-def-count)
      (compiler-tc-decl-profile-line
        "fn_count"
        compiler-tc-decl-profile-fn-count)
      (compiler-tc-decl-profile-line
        "macro_count"
        compiler-tc-decl-profile-macro-count)
      (compiler-tc-decl-profile-line
        "extern_count"
        compiler-tc-decl-profile-extern-count)
      (compiler-tc-decl-profile-line
        "other_count"
        compiler-tc-decl-profile-other-count)
      (compiler-tc-env-profile-line "binds" compiler-tc-env-profile-binds)
      (compiler-tc-env-profile-line "lookups" compiler-tc-env-profile-lookups)
      (compiler-tc-env-profile-line
        "cache_builds"
        compiler-tc-env-profile-cache-builds)
      (compiler-tc-env-profile-line
        "marker_scans"
        compiler-tc-env-profile-marker-scans)
      (compiler-tc-env-profile-line
        "module_local_hits"
        compiler-tc-env-profile-module-local-hits)
      (compiler-tc-env-profile-line
        "module_local_misses"
        compiler-tc-env-profile-module-local-misses)
      (compiler-tc-macro-counter-profile-line
        "fixed_point_passes"
        compiler-tc-macro-fixed-point-passes)
      (compiler-tc-macro-counter-profile-line
        "fixed_point_followup_needs_followup"
        compiler-tc-macro-followup-needs-followup)
      (compiler-tc-macro-counter-profile-line
        "fixed_point_followup_generated_imports"
        compiler-tc-macro-followup-generated-imports)
      (compiler-tc-macro-counter-profile-line
        "fixed_point_followup_module_placeholders"
        compiler-tc-macro-followup-module-placeholders)
      (compiler-tc-macro-counter-profile-line
        "generated_compare_passes"
        compiler-tc-macro-generated-compare-passes)
      (compiler-tc-macro-counter-profile-line
        "generated_fingerprint_cache_hits"
        compiler-tc-macro-generated-fingerprint-cache-hits)
      (compiler-tc-macro-counter-profile-line
        "generated_fingerprint_cache_misses"
        compiler-tc-macro-generated-fingerprint-cache-misses)
      (compiler-tc-reinfer-profile-emit)
      (tc-lp-line "repr_c_field_builds" 0)
      (tc-lp-line "repr_c_field_visits" 1)
      (tc-lp-line "inline_field_builds" 2)
      (tc-lp-line "inline_field_visits" 3)
      (tc-lp-line "inline_payload_builds" 4)
      (tc-lp-line "inline_payload_visits" 5)
      (tc-lp-line "inline_variant_builds" 6)
      (tc-lp-line "inline_variant_visits" 7)
      (tc-lp-line "stdlib_field_spec_builds" 8)
      (tc-lp-line "stdlib_field_spec_visits" 9)
      (tc-lp-line "stdlib_variant_spec_builds" 10)
      (tc-lp-line "stdlib_variant_spec_visits" 11)
      (tc-lp-line "cache_hits" 12)
      (tc-lp-line "cache_misses" 13)
      (tc-lp-line "cache_bypasses" 14))))

(define (tc-expr-diag [expr : AstExpr] [message : String]) : CompilerDiagnostic
  (if (tc-rich-error? message)
    (tc-rich-error-diag message)
    (if (tc-located-error? message)
      (tc-located-error-diag message)
      (match expr
        [(AstExprSpanned _ span)
          (tc-canonical-diagnostic
            (compiler-diagnostic-from-ast-span "" span message))]
        [_ (tc-diag-at-start message)]))))

;; Locate an error at the nearest available declaration body span. A top-level
;; `define` body is wrapped in `AstExprSpanned`, so its span points the
;; diagnostic at the offending declaration's expression; otherwise fall back 1:1.
(define (tc-generated-decl-diag
  [meta : AstGeneratedDeclMeta]
  [diag : CompilerDiagnostic]) : CompilerDiagnostic
  (match meta
    [(AstSomeGeneratedDeclMeta generator item _ key)
      (let
        [with-context : CompilerDiagnostic
          (compiler-diagnostic-with-note
            diag
            (string.string-append
              "generated declaration: "
              (string.string-append
                item
                (string.string-append " from " generator))))]
        (if (> (string.string-length key) 0)
          (compiler-diagnostic-with-note
            with-context
            (string.string-append "generated identity: " key))
          with-context))]
    [(AstNoGeneratedDeclMeta) diag]))

(define (tc-decl-diag [decl : AstDecl] [message : String]) : CompilerDiagnostic
  (if (tc-rich-error? message)
    (tc-rich-error-diag message)
    (if (tc-located-error? message)
      (tc-located-error-diag message)
      (match decl
        [(AstDeclDef _ _ expr-box)
          (let
            [expr : AstExpr (ast-node-get expr-box)]
            (tc-expr-diag expr message))]
        [(AstDeclDefFn _ _ _ body-box _)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-diag body message))]
        [(AstDeclDefMacro _ _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-diag body message))]
        [(AstDeclTest _ _ span)
          (tc-canonical-diagnostic
            (compiler-diagnostic-from-ast-span "" span message))]
        [(AstDeclUnsafe inner-box)
          (let
            [inner : AstDecl (box-get inner-box)]
            (tc-decl-diag inner message))]
        [(AstDeclComptimeDecl meta template-box)
          (let
            [template : AstDecl (box-get template-box)]
            (tc-generated-decl-diag meta (tc-decl-diag template message)))]
        [_ (tc-diag-at-start message)]))))

(define (tc-locate-error-at-expr [expr : AstExpr] [message : String]) : String
  (if (or (tc-rich-error? message) (tc-located-error? message))
    message
    (match expr
      [(AstExprSpanned _ span) (tc-located-error span message)]
      [_ message])))

(define (tc-expr-maybe-span [expr : AstExpr]) : TcMaybeAstSourceSpan
  (match expr
    [(AstExprSpanned _ span) (TcSomeAstSourceSpan span)]
    [_ (TcNoAstSourceSpan)]))

(define (tc-expr-list-last-maybe-span [exprs : AstExprList]) : TcMaybeAstSourceSpan
  (match exprs
    [(AstExprNil) (TcNoAstSourceSpan)]
    [(AstExprCons head rest-box)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest-box)]
        (match rest
          [(AstExprNil) (tc-expr-maybe-span head-expr)]
          [_ (tc-expr-list-last-maybe-span rest)]))]))

(define (tc-reference-escape-help) : String
  "return an owned clone, keep the reference inside its scope, or tie the returned reference lifetime to a parameter")

(define (tc-assignment-escape-help [target : String]) : String
  (str_cat.str-cat
    "store an owned value instead, or keep `"
    target
    "` inside the borrowed value's lifetime"))

(define (tc-arena-escape-help [region : String]) : String
  (str_cat.str-cat
    "use with-escape to clone one supported result out of `"
    region
    "`, or keep the value inside the with-arena scope"))

(define (tc-closure-escape-help) : String
  "move owned data into the closure or keep the closure inside the borrowed/arena scope")

(define (tc-reference-escape-message? [message : String]) : bool
  (or
    (string.string-eq
      message
      "typecheck: reference value would escape lexical scope")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into longer-lived")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into non-place")
    (string.string-eq
      message
      "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")
    (string.string-eq
      message
      "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")
    (string.string-eq
      message
      "typecheck: reference-capturing closure value would escape lexical scope")))

(define (tc-region-escape-message? [message : String]) : bool
  (or
    (tc-diag-string-prefix?
      message
      "typecheck: region-tagged value cannot escape with-arena '")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store region-tagged value into ")
    (string.string-eq
      message
      "typecheck: lambda cannot capture region-tagged value; region value would escape")
    (string.string-eq
      message
      "typecheck: lambda return value has region-tagged type; region value would escape")
    (string.string-eq
      message
      "typecheck: cannot pass region-tagged value to function parameter; region value would escape")))

(define (tc-cleanup-escape-message? [message : String]) : bool
  (or
    (string.string-eq
      message
      "typecheck: cleanup-required resource would escape with scope")
    (string.string-eq
      message
      "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")
    (string.string-eq
      message
      "typecheck: cannot store cleanup-required resource in longer-lived binding")))

(define (tc-escape-message? [message : String]) : bool
  (or
    (tc-reference-escape-message? message)
    (tc-region-escape-message? message)
    (tc-cleanup-escape-message? message)))

(define (tc-escape-help [message : String]) : String
  (if (tc-region-escape-message? message)
    "return an owned clone, keep the value inside the arena/scope, or use with-escape for supported clone-out"
    (if (tc-cleanup-escape-message? message)
      "keep the cleanup-required value inside its resource scope or return a non-resource result"
      (tc-reference-escape-help))))

(define (tc-rich-error-with-maybe-secondary
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [maybe-secondary : TcMaybeAstSourceSpan]
  [secondary-label : String]) : String
  (match maybe-secondary
    [(TcSomeAstSourceSpan secondary)
      (tc-rich-error-one-secondary
        primary
        message
        help
        secondary
        secondary-label)]
    [(TcNoAstSourceSpan)
      (tc-rich-error-one-secondary primary message help primary secondary-label)]))

(define (tc-rich-escape-at-expr
  [expr : AstExpr]
  [message : String]
  [secondary-label : String]) : String
  (match (tc-expr-maybe-span expr)
    [(TcSomeAstSourceSpan span)
      (tc-rich-error-one-secondary
        span
        message
        (tc-escape-help message)
        span
        secondary-label)]
    [(TcNoAstSourceSpan) message]))

(define (tc-spanned-escape-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : TcMaybeString
  (if (or (tc-rich-error? message) (tc-located-error? message))
    (TcNoString)
    (match inner
      [(AstExprWithRegion region body)
        (if (tc-diag-string-prefix?
          message
          "typecheck: region-tagged value cannot escape with-arena '")
          (match (tc-expr-list-last-maybe-span body)
            [(TcSomeAstSourceSpan value-span)
              (TcSomeString
                (tc-rich-error-one-secondary
                  value-span
                  message
                  (tc-arena-escape-help region)
                  span
                  (str_cat.str-cat
                    "with-arena `"
                    region
                    "` scope resets before this value can escape")))]
            [(TcNoAstSourceSpan)
              (TcSomeString
                (tc-rich-error-one-secondary
                  span
                  message
                  (tc-arena-escape-help region)
                  span
                  "with-arena scope boundary"))])
          (TcNoString))]
      [(AstExprReturn value-box)
        (if (tc-escape-message? message)
          (let
            [value : AstExpr (ast-node-get value-box)]
            (TcSomeString
              (tc-rich-error-with-maybe-secondary
                span
                message
                (tc-escape-help message)
                (tc-expr-maybe-span value)
                "returned value carries a lifetime or arena that cannot cross this boundary")))
          (TcNoString))]
      [(AstExprSet name value-box)
        (if (tc-escape-message? message)
          (let
            [value : AstExpr (ast-node-get value-box)]
            [target : String (intern-str name)]
            (match (tc-expr-maybe-span value)
              [(TcSomeAstSourceSpan value-span)
                (TcSomeString
                  (tc-rich-error-two-secondaries
                    span
                    message
                    (tc-assignment-escape-help target)
                    value-span
                    "assigned value carries a shorter lifetime"
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]
              [(TcNoAstSourceSpan)
                (TcSomeString
                  (tc-rich-error-one-secondary
                    span
                    message
                    (tc-assignment-escape-help target)
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]))
          (TcNoString))]
      [(AstExprLet let-box)
        (match (box-get let-box)
          [(AstLet _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : AstExpr (ast-node-get body-box)]
                (TcSomeString
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-escape-help message)
                    (tc-expr-maybe-span body)
                    "let result carries a lifetime that cannot outlive this binding scope")))
              (TcNoString))])]
      [(AstExprLambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda _ _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : AstExpr (ast-node-get body-box)]
                (TcSomeString
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-closure-escape-help)
                    (tc-expr-maybe-span body)
                    "closure body captures a value whose lifetime cannot escape")))
              (TcNoString))])]
      [_ (TcNoString)])))

(define (tc-expect-at-expr
  [expr : AstExpr]
  [actual : AstType]
  [expected : AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    OkTcUnit
    (ErrTcUnit (tc-locate-error-at-expr expr message))))

(define (tc-empty-env) : TcTypeEnv
  TcTypeNil)

(define (tc-local-cache-threshold) : i64
  32)

(define (tc-local-cache-partial-layer-cap) : i64
  8)

(define (tc-name-id [name : String]) : i64
  (intern name))

(define tc-marker-name-id-arena : i64
  0)

(define (tc-marker-name-id-arena-handle) : i64
  (begin
    (if (= tc-marker-name-id-arena 0)
      (set! tc-marker-name-id-arena (arena.tl_arena_make))
      unit)
    tc-marker-name-id-arena))

(define (tc-marker-name-id-arena-reset!) : unit
  (if (= tc-marker-name-id-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-marker-name-id-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-marker-name-id-arena))
      (set! tc-marker-name-id-arena 0))))

(define (tc-marker-name-id [name : String]) : i64
  (let
    [prev-persist : bool (intern-persistent-storage-on?)]
    [prev-arena : i64 (arena.tl_arena_current)]
    [id : i64
      (begin
        (if prev-persist
          (intern-persistent-storage-disable!)
          unit)
        (unsafe
          (arena.tl_arena_set (tc-marker-name-id-arena-handle)))
        (let
          [stable-name : String (string.string-copy (& name))]
          [stable-id : i64 (tc-name-id stable-name)]
          (begin
            (unsafe
              (arena.tl_arena_set prev-arena))
            (if prev-persist
              (intern-persistent-storage-enable!)
              unit)
            stable-id)))]
    id))

(define (tc-builtin-name-id [name : String]) : i64
  (begin
    (compiler-builtin-refresh!)
    (tc-name-id name)))

;; --- top-env build membership side table (#3792) ----------------------------
;; The whole-program top-level env is an UNCACHED spine of ~46K binds. The
;; threshold-compaction machinery (tc-env-compact-local-if-threshold) is for
;; single-bind function scopes and does not fire here: unsafe/c-abi decls
;; prepend two binds at once, breaking the exact-"32 binds above a cache"
;; alignment it needs, so the top env stays a plain list. The enum-variant
;; binder uses `tc-bind-alias-id-if-free`, whose guard `tc-name-bound-id?`
;; rescans that whole spine per variant -> O(decls^2) (measured: 46.4M node
;; visits, ~120ms of the top-env build of a self-compile, with the guard never
;; once finding a name already bound).
;;
;; This is a membership bloom keyed by name-id: every name bound during the
;; build (plus the seeded base env) is stamped with the current generation. An
;; UNMARKED id is provably absent from the env, so the guard binds directly
;; with no scan. A MARKED id (a real prior binding, or a transient local bind
;; from an un-annotated top-level `define` initializer) falls back to the exact
;; spine scan -- the bloom only ever SKIPS the scan when the name is definitely
;; unbound, so the bound env, lookups, and diagnostics are identical to the
;; unconditional scan. Generation stamps avoid clearing the array between
;; builds; the array never grows, so out-of-range ids (>= capacity)
;; conservatively report "maybe" and take the exact scan.
(define tc-topenv-membership-slots : (Array i64)
  (array.make-array i64 262144))
(define tc-topenv-membership-gen : i64
  0)
(define tc-topenv-membership-active : bool
  false)

(define (tc-topenv-membership-mark! [name-id : i64]) : unit
  (if (and (>= name-id 0) (< name-id 262144))
    (array.array-set!
      tc-topenv-membership-slots
      name-id
      tc-topenv-membership-gen)
    unit))

;; True when the id MIGHT be in the env (marked this generation, or out of
;; range); false only when it is provably absent.
(define (tc-topenv-membership-maybe? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id 262144))
    (=
      (array.array-ref tc-topenv-membership-slots name-id)
      tc-topenv-membership-gen)
    true))

(define (tc-topenv-membership-seed! [env : TcTypeEnv]) : unit
  (match env
    [(TcTypeNil) unit]
    [(TcTypeBind key _ rest)
      (begin
        (tc-topenv-membership-mark! key)
        (tc-topenv-membership-seed! (box-get rest)))]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-topenv-membership-seed! (box-get rest))]))

(define (tc-topenv-membership-begin! [env : TcTypeEnv]) : unit
  (begin
    (set! tc-topenv-membership-gen (+ tc-topenv-membership-gen 1))
    (set! tc-topenv-membership-active true)
    (tc-topenv-membership-seed! env)))

(define (tc-topenv-membership-end!) : unit
  (set! tc-topenv-membership-active false))

(define (tc-bind-raw-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-bind))
    (if tc-topenv-membership-active
      (tc-topenv-membership-mark! name-id)
      unit)
    (TcTypeBind name-id ty (box env))))

(define (tc-bind-raw [env : TcTypeEnv] [name : String] [ty : AstType]) : TcTypeEnv
  (tc-bind-raw-id env (tc-name-id name) ty))

(define (tc-env-uncached-prefix-reaches-cache?
  [env : TcTypeEnv]
  [remaining : i64]) : bool
  (if (<= remaining 0)
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ _ _) true]
      [_ false])
    (match env
      [(TcTypeBind _ _ rest)
        (tc-env-uncached-prefix-reaches-cache? (box-get rest) (- remaining 1))]
      [_ false])))

(define (tc-env-after-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (if (<= remaining 0)
    env
    (match env
      [(TcTypeBind _ _ rest)
        (tc-env-after-prefix (box-get rest) (- remaining 1))]
      [_ env])))

(define (tc-env-partial-layer-depth [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeCache _ _ _ _ _ _ partial _ below)
      (if partial
        (+ 1 (tc-env-partial-layer-depth (box-get below)))
        0)]
    [_ 0]))

(define (tc-env-compact-local-if-threshold [env : TcTypeEnv]) : TcTypeEnv
  (if (tc-env-uncached-prefix-reaches-cache? env (tc-local-cache-threshold))
    (let
      [below : TcTypeEnv (tc-env-after-prefix env (tc-local-cache-threshold))]
      (if (>=
        (tc-env-partial-layer-depth below)
        (tc-local-cache-partial-layer-cap))
        (tc-env-with-full-local-cache env)
        (tc-env-with-local-cache env)))
    env))

(define (tc-bind [env : TcTypeEnv] [name : String] [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold (tc-bind-raw env name ty)))

(define (tc-bind-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold (tc-bind-raw-id env name-id ty)))

(define (tc-marker-name-matches?
  [text : String]
  [prefix : String]
  [name : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    [name-len : i64 (string.string-length name)]
    (if (not (= text-len (+ prefix-len name-len)))
      false
      (let
        [ok : bool true]
        [i : i64 0]
        (begin
          (while (and ok (< i prefix-len))
            (begin
              (if (= (string.string-ref text i) (string.string-ref prefix i))
                unit
                (set! ok false))
              (set! i (+ i 1))))
          (set! i 0)
          (while (and ok (< i name-len))
            (begin
              (if (=
                (string.string-ref text (+ prefix-len i))
                (string.string-ref name i))
                unit
                (set! ok false))
              (set! i (+ i 1))))
          ok)))))

(define (tc-unsafe-decl-marker-prefix) : String
  " __tl_unsafe_decl:")

(define (tc-unsafe-decl-marker-name [name : String]) : String
  (string.string-append (tc-unsafe-decl-marker-prefix) name))

(define (tc-unsafe-decl-marker-key-id? [key : i64] [name-id : i64]) : bool
  (tc-marker-name-matches?
    (intern-str key)
    (tc-unsafe-decl-marker-prefix)
    (intern-str name-id)))

;; --- marker name-id memos -----------------------------------------------------
;; The Superluminal stage2 self-compile profile shows ~25% of CPU re-interning
;; marker names: every env walk re-hashes constant names like
;; "__tl_default_boundary" per node, and every unsafe-binding query allocates
;; " __tl_unsafe_decl:<name>" and re-interns it. These memos are gated on
;; (intern-generation) like the tc-agg caches. Each id is still interned lazily
;; at its FIRST use per generation, so intern insertion order -- and therefore
;; every assigned id and the emitted assembly -- exactly matches the uncached
;; code.
;; Capacities track (intern-capacity); ids at or above it fall back to the
;; uncached path. Generation slots store (intern-generation)+1 so the
;; zero-initialized arrays are invalid for every generation.
(define tc-unsafe-decl-marker-id-cache : (Array i64)
  (array.make-array i64 262144))
(define tc-unsafe-decl-marker-id-cache-gens : (Array i64)
  (array.make-array i64 262144))

(define (tc-unsafe-decl-marker-id-uncached [name-id : i64]) : i64
  (tc-marker-name-id (tc-unsafe-decl-marker-name (intern-str name-id))))

(define (tc-unsafe-decl-marker-id [name-id : i64]) : i64
  (if (>= name-id 262144)
    (tc-unsafe-decl-marker-id-uncached name-id)
    (let
      [gen : i64 (+ (intern-generation) 1)]
      (if (= (array.array-ref tc-unsafe-decl-marker-id-cache-gens name-id) gen)
        (array.array-ref tc-unsafe-decl-marker-id-cache name-id)
        (let
          [id : i64 (tc-unsafe-decl-marker-id-uncached name-id)]
          (begin
            (array.array-set! tc-unsafe-decl-marker-id-cache name-id id)
            (array.array-set! tc-unsafe-decl-marker-id-cache-gens name-id gen)
            id))))))

(define (tc-bind-unsafe [env : TcTypeEnv] [name : String] [ty : AstType]) : TcTypeEnv
  (tc-bind-unsafe-id env (tc-name-id name) ty))

(define (tc-bind-unsafe-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold
    (tc-bind-raw-id
      (tc-bind-raw-id env (tc-unsafe-decl-marker-id name-id) (AstTyUnit))
      name-id
      ty)))

(define (tc-c-abi-fnptr-marker-prefix) : String
  " __tl_c_abi_fnptr:")

(define (tc-c-abi-fnptr-marker-name [name : String]) : String
  (string.string-append (tc-c-abi-fnptr-marker-prefix) name))

(define (tc-c-abi-fnptr-marker-key-id? [key : i64] [name-id : i64]) : bool
  (tc-marker-name-matches?
    (intern-str key)
    (tc-c-abi-fnptr-marker-prefix)
    (intern-str name-id)))

(define tc-c-abi-fnptr-marker-id-cache : (Array i64)
  (array.make-array i64 262144))
(define tc-c-abi-fnptr-marker-id-cache-gens : (Array i64)
  (array.make-array i64 262144))

(define (tc-c-abi-fnptr-marker-id-uncached [name-id : i64]) : i64
  (tc-marker-name-id (tc-c-abi-fnptr-marker-name (intern-str name-id))))

(define (tc-c-abi-fnptr-marker-id [name-id : i64]) : i64
  (if (>= name-id 262144)
    (tc-c-abi-fnptr-marker-id-uncached name-id)
    (let
      [gen : i64 (+ (intern-generation) 1)]
      (if (= (array.array-ref tc-c-abi-fnptr-marker-id-cache-gens name-id) gen)
        (array.array-ref tc-c-abi-fnptr-marker-id-cache name-id)
        (let
          [id : i64 (tc-c-abi-fnptr-marker-id-uncached name-id)]
          (begin
            (array.array-set! tc-c-abi-fnptr-marker-id-cache name-id id)
            (array.array-set! tc-c-abi-fnptr-marker-id-cache-gens name-id gen)
            id))))))

(define (tc-bind-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold
    (tc-bind-raw-id
      (tc-bind-raw-id env (tc-c-abi-fnptr-marker-id name-id) (AstTyUnit))
      name-id
      ty)))

(define (tc-bind-c-abi-fnptr [env : TcTypeEnv] [name : String] [ty : AstType]) : TcTypeEnv
  (tc-bind-c-abi-fnptr-id env (tc-name-id name) ty))

(define (tc-bind-unsafe-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold
    (tc-bind-raw-id
      (tc-bind-raw-id
        (tc-bind-raw-id env (tc-c-abi-fnptr-marker-id name-id) (AstTyUnit))
        (tc-unsafe-decl-marker-id name-id)
        (AstTyUnit))
      name-id
      ty)))

(define (tc-c-abi-fnptr-marker-near-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [remaining : i64]) : bool
  (if (<= remaining 0)
    false
    (match env
      [(TcTypeNil) false]
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-c-abi-fnptr-marker-near-id? (box-get rest) name-id remaining)]
      [(TcTypeBind key _ rest)
        (if (tc-c-abi-fnptr-marker-key-id? key name-id)
          true
          (if (= key name-id)
            false
            (tc-c-abi-fnptr-marker-near-id?
              (box-get rest)
              name-id
              (- remaining 1))))])))

(define (tc-binding-c-abi-fnptr-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache ids _ _ c-abi-fnptr-flags _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound index)
          (= (array.array-ref c-abi-fnptr-flags index) 1)]
        [(hashmap.I64I64MapMissing)
          (if partial
            (tc-binding-c-abi-fnptr-id? (box-get below) name-id)
            false)])]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        (tc-c-abi-fnptr-marker-near-id? (box-get rest) name-id 3)
        (tc-binding-c-abi-fnptr-id? (box-get rest) name-id))]))

(define (tc-binding-c-abi-fnptr? [env : TcTypeEnv] [name : String]) : bool
  (tc-binding-c-abi-fnptr-id? env (tc-name-id name)))

(define (tc-binding-unsafe-marker-head-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeBind key _ _) (tc-unsafe-decl-marker-key-id? key name-id)]
    [_ false]))

(define (tc-binding-unsafe-marker-head? [env : TcTypeEnv] [name : String]) : bool
  (tc-binding-unsafe-marker-head-id? env (tc-name-id name)))

(define (tc-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache ids _ unsafe-flags _ _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound index)
          (= (array.array-ref unsafe-flags index) 1)]
        [(hashmap.I64I64MapMissing)
          (if partial
            (tc-binding-unsafe-id? (box-get below) name-id)
            false)])]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        (tc-binding-unsafe-marker-head-id? (box-get rest) name-id)
        (tc-binding-unsafe-id? (box-get rest) name-id))]))

(define (tc-binding-unsafe? [env : TcTypeEnv] [name : String]) : bool
  (tc-binding-unsafe-id? env (tc-name-id name)))

(define (tc-env-cache-count [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeNil) 0]
    [(TcTypeBind _ _ rest) (+ 1 (tc-env-cache-count (box-get rest)))]
    [(TcTypeCache _ _ _ _ _ _ _ rest _) (tc-env-cache-count (box-get rest))]))

(define (tc-env-cache-count-prefix [env : TcTypeEnv] [remaining : i64]) : i64
  (if (<= remaining 0)
    0
    (match env
      [(TcTypeBind _ _ rest)
        (+ 1 (tc-env-cache-count-prefix (box-get rest) (- remaining 1)))]
      [_ 0])))

(define (tc-env-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

;; Cache construction is the dominant i64 map workload of a self-compile
;; (~16% of stage2 CPU before this change): the previous shape walked the
;; spine FOUR times per compaction (entry count, shadow count, entry fill,
;; shadow fill) and built a second whole-env map just to answer "is this
;; default builtin shadowed?". Default-shadow membership is now a per-entry
;; flag array parallel to `values`/`unsafe-flags`, computed during the single
;; entry fill walk: an entry's flag is 1 when its head-most binding sits
;; above the first default-boundary marker. Head-first walk order means a
;; name bound both above and below the boundary keeps its head-most (above)
;; occurrence, which matches the old any-occurrence-above map exactly.
(define (tc-env-cache-add
  [ids : hashmap.I64I64Map]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [name-id : i64]
  [ty : AstType]
  [unsafe : bool]
  [c-abi-fnptr : bool]
  [shadow : bool]) : hashmap.I64I64Map
  (match (hashmap.i64-i64-map-get ids name-id)
    [(hashmap.I64I64MapFound _) ids]
    [(hashmap.I64I64MapMissing)
      (let
        [next : i64 (hashmap.i64-i64-map-len ids)]
        (begin
          (array.array-set! values next ty)
          (array.array-set!
            unsafe-flags
            next
            (if unsafe
              1
              0))
          (array.array-set!
            c-abi-fnptr-flags
            next
            (if c-abi-fnptr
              1
              0))
          (array.array-set!
            shadow-flags
            next
            (if shadow
              1
              0))
          (hashmap.i64-i64-map-put ids name-id next)))]))

(define (tc-env-cache-fill
  [env : TcTypeEnv]
  [ids : hashmap.I64I64Map]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [above-boundary : bool]) : hashmap.I64I64Map
  (match env
    [(TcTypeNil) ids]
    [(TcTypeBind name-id ty rest)
      (let
        ;; The boundary bind itself and everything below it are not default
        ;; shadows.
        [still-above : bool
          (if above-boundary
            (not (= name-id (tc-default-boundary-id)))
            false)]
        (tc-env-cache-fill
          (box-get rest)
          (tc-env-cache-add
            ids
            values
            unsafe-flags
            c-abi-fnptr-flags
            shadow-flags
            name-id
            ty
            (tc-binding-unsafe-marker-head-id? (box-get rest) name-id)
            (tc-c-abi-fnptr-marker-near-id? (box-get rest) name-id 3)
            still-above)
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          still-above))]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-env-cache-fill
        (box-get rest)
        ids
        values
        unsafe-flags
        c-abi-fnptr-flags
        shadow-flags
        above-boundary)]))

(define (tc-env-cache-fill-prefix
  [env : TcTypeEnv]
  [remaining : i64]
  [ids : hashmap.I64I64Map]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [above-boundary : bool]) : hashmap.I64I64Map
  (if (<= remaining 0)
    ids
    (match env
      [(TcTypeBind name-id ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [still-above : bool
            (if above-boundary
              (not (= name-id (tc-default-boundary-id)))
              false)]
          (tc-env-cache-fill-prefix
            rest-env
            (- remaining 1)
            (tc-env-cache-add
              ids
              values
              unsafe-flags
              c-abi-fnptr-flags
              shadow-flags
              name-id
              ty
              (tc-binding-unsafe-marker-head-id? rest-env name-id)
              (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
              still-above)
            values
            unsafe-flags
            c-abi-fnptr-flags
            shadow-flags
            still-above))]
      [_ ids])))

(define (tc-env-with-cache-mode [env : TcTypeEnv] [scan-through : bool]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [count : i64 (tc-env-cache-count env)]
      [values : (Array AstType) (array.make-array AstType count)]
      [unsafe-flags : (Array i64) (array.make-array i64 count)]
      [c-abi-fnptr-flags : (Array i64) (array.make-array i64 count)]
      [shadow-flags : (Array i64) (array.make-array i64 count)]
      [ids : hashmap.I64I64Map
        (tc-env-cache-fill
          env
          (hashmap.i64-i64-map-with-capacity (tc-env-cache-capacity count))
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      (TcTypeCache
        ids
        values
        unsafe-flags
        c-abi-fnptr-flags
        shadow-flags
        scan-through
        false
        (box env)
        (box env)))))

(define (tc-env-with-partial-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [count : i64 (tc-env-cache-count-prefix env (tc-local-cache-threshold))]
      [values : (Array AstType) (array.make-array AstType count)]
      [unsafe-flags : (Array i64) (array.make-array i64 count)]
      [c-abi-fnptr-flags : (Array i64) (array.make-array i64 count)]
      [shadow-flags : (Array i64) (array.make-array i64 count)]
      [ids : hashmap.I64I64Map
        (tc-env-cache-fill-prefix
          env
          (tc-local-cache-threshold)
          (hashmap.i64-i64-map-with-capacity (tc-env-cache-capacity count))
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      (TcTypeCache
        ids
        values
        unsafe-flags
        c-abi-fnptr-flags
        shadow-flags
        true
        true
        (box env)
        (box (tc-env-after-prefix env (tc-local-cache-threshold)))))))

;; Explicit top-env/module caches: marker scans terminate here.
(define (tc-env-with-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-mode env false))

;; Depth-cap fallback for function-body spines: full but still scan-through.
(define (tc-env-with-full-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-mode env true))

;; Threshold-compaction caches inside function-body spines: partial lookup
;; cache for the newest bind window; marker scans keep scanning the full spine
;; (#2661).
(define (tc-env-with-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-partial-local-cache env))

(define (tc-bind-alias-if-free [env : TcTypeEnv] [name : String] [ty : AstType]) : TcTypeEnv
  (if (tc-name-bound-id? env (tc-name-id name))
    env
    (tc-bind env name ty)))

(define (tc-bind-alias-id-if-free
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (if (and
    tc-topenv-membership-active
    (not (tc-topenv-membership-maybe? name-id)))
    ;; Provably unbound in the top-env spine: bind without the O(spine) scan.
    (tc-bind-id env name-id ty)
    (if (tc-name-bound-id? env name-id)
      env
      (tc-bind-id env name-id ty))))

(define (tc-module-name-id [module : String] [name-id : i64]) : i64
  (if (= (string.string-length module) 0)
    name-id
    (tc-name-id (compiler-symbol-module-key module (intern-str name-id)))))

(define (tc-bind-module-name
  [env : TcTypeEnv]
  [module : String]
  [name : String]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind env name ty)
    (tc-bind env (compiler-symbol-module-key module name) ty)))

(define (tc-bind-module-name-id
  [env : TcTypeEnv]
  [module : String]
  [name : i64]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind-id env name ty)
    (tc-bind env (compiler-symbol-module-key module (intern-str name)) ty)))

(define (tc-bind-module-name-unsafe
  [env : TcTypeEnv]
  [module : String]
  [name : String]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind-unsafe env name ty)
    (tc-bind-unsafe env (compiler-symbol-module-key module name) ty)))

(define (tc-bind-module-name-unsafe-id
  [env : TcTypeEnv]
  [module : String]
  [name : i64]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind-unsafe-id env name ty)
    (tc-bind-unsafe
      env
      (compiler-symbol-module-key module (intern-str name))
      ty)))

(define (tc-bind-module-name-id-c-abi-fnptr
  [env : TcTypeEnv]
  [module : String]
  [name : i64]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind-c-abi-fnptr-id env name ty)
    (tc-bind-c-abi-fnptr
      env
      (compiler-symbol-module-key module (intern-str name))
      ty)))

(define (tc-bind-module-name-unsafe-id-c-abi-fnptr
  [env : TcTypeEnv]
  [module : String]
  [name : i64]
  [ty : AstType]) : TcTypeEnv
  (if (string.string-eq module "")
    (tc-bind-unsafe-c-abi-fnptr-id env name ty)
    (tc-bind-unsafe-c-abi-fnptr-id
      env
      (tc-name-id (compiler-symbol-module-key module (intern-str name)))
      ty)))

(define tc-unqualified-import-owner-modules : SymI64Env
  (sym-i64-empty))
(define tc-unqualified-import-ambiguous-first-modules : SymI64Env
  (sym-i64-empty))
(define tc-unqualified-import-ambiguous-second-modules : SymI64Env
  (sym-i64-empty))
(define tc-unqualified-import-has-ambiguity : bool
  false)

(define (tc-unqualified-import-ambiguity-reset!) : unit
  (begin
    (set! tc-unqualified-import-owner-modules (sym-i64-empty))
    (set! tc-unqualified-import-ambiguous-first-modules (sym-i64-empty))
    (set! tc-unqualified-import-ambiguous-second-modules (sym-i64-empty))
    (set! tc-unqualified-import-has-ambiguity false)))

(define (tc-unqualified-import-key-id
  [importer-module : String]
  [name-id : i64]) : i64
  (if (string.string-eq importer-module "")
    name-id
    (compiler-symbol-module-key-id-by-name-id importer-module name-id)))

(define (tc-unqualified-import-note-value!
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [name-id : i64]) : unit
  (if import-unqualified
    (let
      [key-id : i64 (tc-unqualified-import-key-id importer-module name-id)]
      [source-id : i64 (intern source-module)]
      [binding-id : i64 (tc-module-name-id alias name-id)]
      (match (sym-i64-lookup-id tc-unqualified-import-owner-modules key-id)
        [(SomeI64 owner-id)
          (if (= owner-id source-id)
            unit
            (match (sym-i64-lookup-id
              tc-unqualified-import-ambiguous-first-modules
              key-id)
              [(SomeI64 _) unit]
              [NoneI64
                (begin
                  (set! tc-unqualified-import-has-ambiguity true)
                  (set!
                    tc-unqualified-import-ambiguous-first-modules
                    (sym-i64-bind-id
                      tc-unqualified-import-ambiguous-first-modules
                      key-id
                      owner-id))
                  (set!
                    tc-unqualified-import-ambiguous-second-modules
                    (sym-i64-bind-id
                      tc-unqualified-import-ambiguous-second-modules
                      key-id
                      source-id)))]))]
        [NoneI64
          (if (tc-name-bound-id? env binding-id)
            unit
            (set!
              tc-unqualified-import-owner-modules
              (sym-i64-bind-id
                tc-unqualified-import-owner-modules
                key-id
                source-id)))]))
    unit))

(define (tc-bind-import-alias-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias
      importer-module
      source-module
      import-unqualified
      name-id)
    (tc-bind-module-name-id env alias name-id ty)))

(define (tc-bind-import-alias-value-unsafe-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias
      importer-module
      source-module
      import-unqualified
      name-id)
    (tc-bind-module-name-unsafe-id env alias name-id ty)))

(define (tc-bind-import-alias-value-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias
      importer-module
      source-module
      import-unqualified
      name-id)
    (tc-bind-module-name-id-c-abi-fnptr env alias name-id ty)))

(define (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias
      importer-module
      source-module
      import-unqualified
      name-id)
    (tc-bind-module-name-unsafe-id-c-abi-fnptr env alias name-id ty)))

(define (tc-struct-cleanup-function-type [struct-ty : AstType]) : AstType
  (tc-fn1 struct-ty (AstTyUnit)))

(define (tc-enum-cleanup-function-type [enum-ty : AstType]) : AstType
  (tc-fn1 enum-ty (AstTyUnit)))

(define (tc-cleanup-value-handle? [handle : i64]) : bool
  (let
    [kind : i64 (compiler-symbol-handle-kind handle)]
    (or
      (= kind (compiler-symbol-kind-struct-cleanup))
      (= kind (compiler-symbol-kind-enum-cleanup)))))

(define (tc-struct-cleanup-decl-type [module : String] [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDeclDefStruct name _ _ _)
      (OkTcType
        (tc-struct-cleanup-function-type
          (AstTyStruct
            (intern (compiler-symbol-module-key module (intern-str name))))))]
    [(AstDeclDefStructLifetimes name lifetimes _ _ _)
      (OkTcType
        (tc-struct-cleanup-function-type
          (ast-ty-struct-args
            (intern (compiler-symbol-module-key module (intern-str name)))
            lifetimes)))]
    [_
      (ErrTcType "typecheck: exported struct cleanup has no struct declaration")]))

(define (tc-enum-cleanup-decl-type [module : String] [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDeclDefEnum name _ _)
      (OkTcType
        (tc-enum-cleanup-function-type
          (AstTyEnum
            (intern (compiler-symbol-module-key module (intern-str name))))))]
    [(AstDeclDefEnumLifetimes name lifetimes _ _)
      (OkTcType
        (tc-enum-cleanup-function-type
          (ast-ty-enum-args
            (intern (compiler-symbol-module-key module (intern-str name)))
            lifetimes)))]
    [_ (ErrTcType "typecheck: exported enum cleanup has no enum declaration")]))

(define (tc-cleanup-value-handle-type
  [module : String]
  [handle : i64]
  [decl : AstDecl]) : ResultTcType
  (let
    [kind : i64 (compiler-symbol-handle-kind handle)]
    (cond
      [(= kind (compiler-symbol-kind-struct-cleanup))
        (tc-struct-cleanup-decl-type module decl)]
      [(= kind (compiler-symbol-kind-enum-cleanup))
        (tc-enum-cleanup-decl-type module decl)]
      [else (ErrTcType "typecheck: value is not a generated cleanup")])))

(define (tc-bind-struct-cleanup-module-name
  [env : TcTypeEnv]
  [module : String]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructNoCleanup) env]
    [(AstStructCleanupFn cleanup-name)
      (tc-bind-module-name-id
        env
        module
        cleanup-name
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-module-name
  [env : TcTypeEnv]
  [module : String]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumNoCleanup) env]
    [(AstEnumCleanupFn cleanup-name)
      (tc-bind-module-name-id
        env
        module
        cleanup-name
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-local
  [env : TcTypeEnv]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructNoCleanup) env]
    [(AstStructCleanupFn cleanup-name)
      (tc-bind-id env cleanup-name (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-local
  [env : TcTypeEnv]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumNoCleanup) env]
    [(AstEnumCleanupFn cleanup-name)
      (tc-bind-id env cleanup-name (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-alias
  [env : TcTypeEnv]
  [alias : String]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructNoCleanup) env]
    [(AstStructCleanupFn cleanup-name)
      (tc-bind
        env
        (compiler-symbol-module-key alias (intern-str cleanup-name))
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-alias
  [env : TcTypeEnv]
  [alias : String]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumNoCleanup) env]
    [(AstEnumCleanupFn cleanup-name)
      (tc-bind
        env
        (compiler-symbol-module-key alias (intern-str cleanup-name))
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructNoCleanup) env]
    [(AstStructCleanupFn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias
        importer-module
        source-module
        import-unqualified
        cleanup-name
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumNoCleanup) env]
    [(AstEnumCleanupFn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias
        importer-module
        source-module
        import-unqualified
        cleanup-name
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-default-boundary-name) : String
  "__tl_default_boundary")

;; Generation-checked id memo for one constant marker name; see the marker
;; name-id memo comment above tc-unsafe-decl-marker-id.
(define tc-default-boundary-id-cache : i64
  -1)
(define tc-default-boundary-id-cache-generation : i64
  -1)

(define (tc-default-boundary-id) : i64
  (if (= tc-default-boundary-id-cache-generation (intern-generation))
    tc-default-boundary-id-cache
    (let
      [id : i64 (tc-name-id (tc-default-boundary-name))]
      (begin
        (set! tc-default-boundary-id-cache id)
        (set! tc-default-boundary-id-cache-generation (intern-generation))
        id))))

