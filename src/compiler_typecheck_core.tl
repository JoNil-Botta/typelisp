(define (tc-source-lambda-signature-policy-ok
  [ctx : TcContext]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]) : ResultTcUnit
  (match maybe-ret
    [(ast.AstMaybeType.Some ret)
      (match (tc-elide-function-signature
        (tc-context-type-bases ctx)
        params
        ret)
        [(ResultTcElidedSignature.Ok signature)
          (match (tc-source-param-list-policy-ok ctx signature.params)
            [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx signature.ret)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstMaybeType.No)
      (match (tc-elide-input-params-at
        (tc-context-type-bases ctx)
        (& params)
        0
        0
        (ast.ast-param-list-new))
        [(ResultTcElidedParams.Ok inputs)
          (tc-source-param-list-policy-ok ctx inputs.params)]
        [(ResultTcElidedParams.Err message) (ResultTcUnit.Err message)])]))

(define (tc-source-expr-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases left right))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (match (tc-source-expr-policy-ok ctx expr-bases func)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-policy-ok ctx expr-bases args)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.BracketClause items)
      (tc-source-expr-list-policy-ok ctx expr-bases items)]
    [(ast.AstExpr.TypeLiteral ty-id)
      (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id))]
    [(ast.AstExpr.Init maybe-ty-id)
