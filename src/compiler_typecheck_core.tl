(define (tc-source-dotted-alias-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (tc-source-dotted-alias-key-cache-put-for-state!
    (tc-job-state-source-key-cache (tc-serial-job-state))
    (ci.intern-active-table-id)
