(define (compiler-x64-template-render-kind-matches?
  [expected : x64.CompilerX64TemplateRenderKind]
  [actual : x64.CompilerX64TemplateRenderKind]) : bool
  (match expected
    [(x64.CompilerX64TemplateRenderKind.Assembly)
      (match actual
        [(x64.CompilerX64TemplateRenderKind.Assembly) true]
        [_ false])]
    [(x64.CompilerX64TemplateRenderKind.OpaqueBytes)
      (match actual
        [(x64.CompilerX64TemplateRenderKind.OpaqueBytes) true]
        [_ false])]
    [(x64.CompilerX64TemplateRenderKind.StructuredObject)
      (match actual
        [(x64.CompilerX64TemplateRenderKind.StructuredObject) true]
        [_ false])]))

(define (compiler-x64-template-abi-matches-target?
  [target : x64.CompilerX64TemplateTarget]
  [abi : x64.CompilerX64TemplateAbi]) : bool
  (match target
    [(x64.CompilerX64TemplateTarget.AnyX64)
      (match abi
        [(x64.CompilerX64TemplateAbi.InternalX64) true]
        [_ false])]
    [(x64.CompilerX64TemplateTarget.LinuxX64)
      (match abi
        [(x64.CompilerX64TemplateAbi.SystemV) true]
        [_ false])]
    [(x64.CompilerX64TemplateTarget.WindowsX64)
      (match abi
        [(x64.CompilerX64TemplateAbi.Win64) true]
        [_ false])]))

(define (compiler-x64-template-anchors-valid?
  [row : x64.CompilerX64ExecutableTemplate]) : bool
  (match row.render-kind
    [(x64.CompilerX64TemplateRenderKind.OpaqueBytes)
      (and
        (= (string.string-length (& row.entry-anchor)) 0)
        (= (string.string-length (& row.interior-anchors)) 0)
        (= (string.string-length (& row.end-anchor)) 0))]
    [_
      (and
        (> (string.string-length (& row.entry-anchor)) 0)
        (> (string.string-length (& row.end-anchor)) 0))]))

(define (compiler-x64-template-row-valid-for?
  [row : x64.CompilerX64ExecutableTemplate]
  [target : x64.CompilerX64TemplateTarget]
  [render-kind : x64.CompilerX64TemplateRenderKind]) : bool
  (and
    (= row.schema 1)
    (> (string.string-length (& row.producer)) 0)
    (compiler-x64-template-abi-matches-target? row.target row.abi)
    (compiler-x64-template-anchors-valid?
      (owned_view.compiler-owned-shared-view row))
    (x64.compiler-x64-template-target-matches? row.target target)
    (compiler-x64-template-render-kind-matches? row.render-kind render-kind)))

(define (compiler-x64-template-require-kind!
  [row : x64.CompilerX64ExecutableTemplate]
  [target : x64.CompilerX64TemplateTarget]
  [render-kind : x64.CompilerX64TemplateRenderKind]) : unit
  (let
    [id-name : String (compiler-x64-template-id-name row.id)]
    [producer : String
      (string.substring
        (& row.producer)
        0
        (string.string-length (& row.producer)))]
    [target-name : String (x64.compiler-x64-template-target-name target)]
    [render-name : String
      (x64.compiler-x64-template-render-kind-name render-kind)]
    (unless
      (compiler-x64-template-row-valid-for? row target render-kind)
      (io.panic
        (str_cat.str-cat
          "x64 executable template: target/render mismatch: id="
          id-name
          " producer="
          producer
          " target="
          target-name
          " render="
          render-name)))))

(define (compiler-x64-template-rendered-payload-valid?
  [row : x64.CompilerX64ExecutableTemplate]
  [rendered : (& rendered str)]) : bool
  (or
    (< row.expected-rendered-size 0)
    (and
      (= (string.string-length rendered) row.expected-rendered-size)
      (= (hash.string-key rendered) row.expected-rendered-hash))))

(define (compiler-x64-template-require-rendered-payload!
  [row : x64.CompilerX64ExecutableTemplate]
  [rendered : (& rendered str)]) : unit
  (let
    [id-name : String (compiler-x64-template-id-name row.id)]
    [producer : String
      (string.substring
        (& row.producer)
        0
        (string.string-length (& row.producer)))]
    [target-name : String (x64.compiler-x64-template-target-name row.target)]
    [expected-size : i64 row.expected-rendered-size]
    [expected-hash : i64 row.expected-rendered-hash]
    [actual-size : i64 (string.string-length rendered)]
    [actual-hash : i64 (hash.string-key rendered)]
    (unless
      (compiler-x64-template-rendered-payload-valid? row rendered)
      (io.panic
        (str_cat.str-cat
          "x64 executable template: rendered payload identity mismatch: id="
          id-name
          " producer="
          producer
          " target="
          target-name
          " expected-size="
          (string.int->string expected-size)
          " actual-size="
          (string.int->string actual-size)
          " expected-hash="
          (string.int->string expected-hash)
          " actual-hash="
          (string.int->string actual-hash))))))

(define (compiler-x64-template-render-assembly
  [id : x64.CompilerX64ExecutableTemplateId]
  [target : x64.CompilerX64TemplateTarget]
  [rendered : String]) : String
  (let
    [row : x64.CompilerX64ExecutableTemplate
      (compiler-x64-template-registry-row id)]
    (begin
      (compiler-x64-template-require-kind!
        (owned_view.compiler-owned-shared-view row)
        target
        (x64.CompilerX64TemplateRenderKind.Assembly))
      (compiler-x64-template-require-rendered-payload! row (& rendered))
      rendered)))

(define (compiler-x64-template-render-bytes
  [id : x64.CompilerX64ExecutableTemplateId]
  [target : x64.CompilerX64TemplateTarget]
  [rendered : String]) : String
  (let
    [row : x64.CompilerX64ExecutableTemplate
      (compiler-x64-template-registry-row id)]
    (begin
      (compiler-x64-template-require-kind!
        (owned_view.compiler-owned-shared-view row)
        target
        (x64.CompilerX64TemplateRenderKind.OpaqueBytes))
      (compiler-x64-template-require-rendered-payload! row (& rendered))
      rendered)))

(define (compiler-x64-template-semantic-identity
  [id : x64.CompilerX64ExecutableTemplateId]
  [target : x64.CompilerX64TemplateTarget]
  [render-kind : x64.CompilerX64TemplateRenderKind]
  [rendered : String]) : String
  (let
    [id-name : String
      (compiler-x64-template-id-name (owned_view.compiler-owned-shared-view id))]
    [row : x64.CompilerX64ExecutableTemplate
      (compiler-x64-template-registry-row id)]
    (begin
      (compiler-x64-template-require-kind!
        (owned_view.compiler-owned-shared-view row)
        target
        render-kind)
      (compiler-x64-template-require-rendered-payload!
        (owned_view.compiler-owned-shared-view row)
        (& rendered))
      (x64.compiler-x64-template-semantic-identity row id-name rendered))))

(define (compiler-x64-template-assert-structured!
  [id : x64.CompilerX64ExecutableTemplateId]
  [target : x64.CompilerX64TemplateTarget]) : unit
  (let
    [row : x64.CompilerX64ExecutableTemplate
      (compiler-x64-template-registry-row id)]
    (compiler-x64-template-require-kind!
      row
      target
      (x64.CompilerX64TemplateRenderKind.StructuredObject))))

