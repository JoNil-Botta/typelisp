;; doc_site_search_asset.tl - Shared browser client for generated doc sites.
;;
;; Keeping the client as TypeLisp-owned source preserves the repository's
;; implementation-language boundary while every local or published site emits
;; the same dependency-free JavaScript artifact.
(define (doc-site-search-client) : String
  "(() => {\n  \"use strict\";\n\n  const data = globalThis.TYPELISP_DOC_SEARCH;\n  const input = document.querySelector(\"[data-doc-search-input]\");\n  const status = document.querySelector(\"[data-doc-search-status]\");\n  const results = document.querySelector(\"[data-doc-search-results]\");\n  if (!data || !input || !status || !results) return;\n\n  const pageIdentity = (name) => {\n    const node = document.querySelector(`meta[name=\"${name}\"]`);\n    return node ? node.content : \"\";\n  };\n  const identitiesMatch =\n    data.schema === 1 &&\n    data.compilerIdentity === pageIdentity(\"typelisp-compiler-identity\") &&\n    data.sourceIdentity === pageIdentity(\"typelisp-source-identity\") &&\n    data.packageIdentity === pageIdentity(\"typelisp-package-identity\");\n  if (!identitiesMatch) {\n    input.disabled = true;\n    status.textContent = \"Search index identity does not match this page.\";\n    return;\n  }\n\n  const normalized = data.records.map((record, order) => ({\n    record,\n    order,\n    label: record.label.toLowerCase(),\n    module: record.module.toLowerCase(),\n    kind: record.kind.toLowerCase(),\n    text: `${record.signature} ${record.docs}`.toLowerCase(),\n  }));\n  let links = [];\n  let active = -1;\n\n  const scoreToken = (entry, token) => {\n    if (entry.label === token) return 0;\n    if (entry.label.startsWith(token)) return 10;\n    if (entry.label.includes(token)) return 20;\n    if (entry.module === token || entry.kind === token) return 30;\n    if (entry.module.includes(token) || entry.kind.includes(token)) return 40;\n    if (entry.text.includes(token)) return 50;\n    return -1;\n  };\n\n  const setActive = (next) => {\n    links.forEach((link, index) => {\n      link.tabIndex = index === next ? 0 : -1;\n    });\n    active = next;\n    if (active >= 0) links[active].focus();\n  };\n\n  const render = () => {\n    const query = input.value.trim().toLowerCase();\n    results.replaceChildren();\n    links = [];\n    active = -1;\n    if (!query) {\n      results.hidden = true;\n      status.textContent = \"\";\n      return;\n    }\n    const tokens = query.split(/\\s+/).filter(Boolean);\n    const matches = [];\n    for (const entry of normalized) {\n      let score = 0;\n      let found = true;\n      for (const token of tokens) {\n        const tokenScore = scoreToken(entry, token);\n        if (tokenScore < 0) {\n          found = false;\n          break;\n        }\n        score += tokenScore;\n      }\n      if (found) matches.push({ entry, score });\n    }\n    matches.sort((a, b) => a.score - b.score || a.entry.order - b.entry.order);\n    const visible = matches.slice(0, 20);\n    for (const { entry } of visible) {\n      const record = entry.record;\n      const item = document.createElement(\"li\");\n      const link = document.createElement(\"a\");\n      link.href = record.href;\n      link.tabIndex = 0;\n      const label = document.createElement(\"code\");\n      label.textContent = record.label;\n      const detail = document.createElement(\"span\");\n      detail.textContent = `${record.kind} · ${record.module}`;\n      link.append(label, detail);\n      item.append(link);\n      results.append(item);\n      links.push(link);\n    }\n    results.hidden = false;\n    status.textContent = matches.length === 1\n      ? \"1 search result\"\n      : `${matches.length} search results`;\n  };\n\n  input.addEventListener(\"input\", render);\n  input.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"ArrowDown\" && links.length) {\n      event.preventDefault();\n      setActive(0);\n    } else if (event.key === \"Escape\") {\n      input.value = \"\";\n      render();\n    }\n  });\n  results.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"ArrowDown\" && links.length) {\n      event.preventDefault();\n      setActive((active + 1) % links.length);\n    } else if (event.key === \"ArrowUp\" && links.length) {\n      event.preventDefault();\n      setActive((active + links.length - 1) % links.length);\n    } else if (event.key === \"Escape\") {\n      event.preventDefault();\n      input.focus();\n    }\n  });\n  document.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"/\" && !event.ctrlKey && !event.metaKey && !event.altKey &&\n        !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {\n      event.preventDefault();\n      input.focus();\n    }\n  });\n})();\n")