        (struct-get entry hash)))
    unit))

;: Lookup through an immutable generated i64 -> String map reference.
(define (hashmap-i64-string-backing-get-ref
  [map : (& map HashmapI64StringBacking)]
  [key : i64]) : HashmapI64StringBackingLookup
  (let
    [capacity : i64 (array-length (struct-get map slots))]
    (if (<= capacity 0)
      (HashmapI64StringBackingMissing)
      (let
        [hash : i64 (hashmap-i64-string-backing-hash-key key)]
        [cursor : i64
          (hashmap-i64-string-backing-normalized-bucket-index hash capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (array-ref (struct-get map slots) cursor)
              [(HashmapI64StringBackingEmpty)
                (return (HashmapI64StringBackingMissing))]
              [(HashmapI64StringBackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapI64StringBackingOccupied slot-key value slot-hash)
                (if (if (= slot-hash hash)
                  (= slot-key key)
                  false)
                  (return
                    (HashmapI64StringBackingFound (string.copy (& value))))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (HashmapI64StringBackingMissing))))))

;: Rehash a borrowed i64 -> String slot array into a fresh destination.
(define (hashmap-i64-string-backing-rehash-from-ref
  [src : (& src (Array HashmapI64StringBackingSlot))]
  [dst : (Array HashmapI64StringBackingSlot)]
  [dst-capacity : i64]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (match (array-ref src index)
        [(HashmapI64StringBackingOccupied key value hash)
          (hashmap-i64-string-backing-insert-into-empty
            dst
            dst-capacity
            key
            (string.copy (& value))
            hash)]
        [(HashmapI64StringBackingEmpty) unit]
        [(HashmapI64StringBackingTombstone) unit])
      (hashmap-i64-string-backing-rehash-from-ref
        src
        dst
        dst-capacity
        (+ index 1)
        count))))

;: Resize a generated i64 -> String map in place.
(define (hashmap-i64-string-backing-resize!
  [map : (&mut map HashmapI64StringBacking)]
  [new-capacity : i64]) : unit
  (let
    [old-capacity : i64 (array-length (struct-get map slots))]
    [requested-capacity : i64
      (if (> (struct-get map len) new-capacity)
        (struct-get map len)
        new-capacity)]
    [rounded-capacity : i64
      (hashmap-i64-string-backing-round-capacity requested-capacity)]
    [dst : (Array HashmapI64StringBackingSlot)
      (array.make-array HashmapI64StringBackingSlot rounded-capacity)]
    (begin
      (hashmap-i64-string-backing-rehash-from-ref
        (& (struct-get map slots))
        dst
        rounded-capacity
        0
        old-capacity)
      (set! (struct-get map slots) dst)
      (set! (struct-get map deleted) 0))))

