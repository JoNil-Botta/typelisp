(cfg
  test
  (test
    hashmap-string-i64-api
    (begin
      ;; --- map API: with-capacity / insert / get / contains? / len ---
      (let
        [alpha-key : String "alpha"]
        [missing-key : String "missing"]
        [m0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 8)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len m0)
            0
            "fresh map len 0")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-capacity
              (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 10))
            16
            "manual map rounds requested capacity")
          (test.assert-false
            (stdlib.hashmap.hashmap-string-i64-backing-contains? m0 "x")
            "fresh map has no key")
          (let
            [m1 : HashmapStringI64Backing
              (stdlib.hashmap.insert-result-map
                (stdlib.hashmap.hashmap-string-i64-backing-insert m0 "alpha" 11))]
            [m2 : HashmapStringI64Backing
              (stdlib.hashmap.insert-result-map
                (stdlib.hashmap.hashmap-string-i64-backing-insert m1 "beta" 22))]
            [m3 : HashmapStringI64Backing
              (stdlib.hashmap.insert-result-map
                (stdlib.hashmap.hashmap-string-i64-backing-insert m2 "gamma" 33))]
            (begin
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-len m3)
                3
                "len after three inserts")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get m3 "alpha")
                  -1)
                11
                "get alpha")
              (test.assert-true
                (stdlib.hashmap.string-i64-borrowed-value-found?
                  (stdlib.hashmap.hashmap-string-i64-backing-get-value-borrowed
                    (& m3)
                    (& alpha-key)))
                "StringI64 borrowed value get finds alpha")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get m3 "beta")
                  -1)
                22
                "get beta")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get m3 "gamma")
                  -1)
                33
                "get gamma")
              (test.assert-true
                (stdlib.hashmap.hashmap-string-i64-backing-contains? m3 "beta")
                "contains beta")
              (test.assert-false
                (stdlib.hashmap.hashmap-string-i64-backing-contains?
                  m3
                  "missing")
                "missing key absent")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get m3 "missing")
                  -1)
                -1
                "get missing -> fallback")
              (test.assert-false
                (stdlib.hashmap.string-i64-borrowed-value-found?
                  (stdlib.hashmap.hashmap-string-i64-backing-get-value-borrowed
                    (& m3)
                    (& missing-key)))
                "StringI64 missing borrowed value get")
              ;; updating an existing key keeps len and changes the value
              (let
                [m4 : HashmapStringI64Backing
                  (stdlib.hashmap.insert-result-map
                    (stdlib.hashmap.hashmap-string-i64-backing-insert
                      m3
                      "alpha"
                      99))]
                (begin
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-string-i64-backing-len m4)
                    3
                    "len unchanged on update")
                  (test.assert-i64-eq
                    (stdlib.hashmap.lookup-value-or
                      (stdlib.hashmap.hashmap-string-i64-backing-get m4 "alpha")
                      -1)
                    99
                    "alpha updated to 99")))
              ;; a fixed capacity-1 table is full for a second distinct key
              (let
                [s0 : HashmapStringI64Backing
                  (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 1)]
                [s1 : HashmapStringI64Backing
                  (stdlib.hashmap.insert-result-map
                    (stdlib.hashmap.hashmap-string-i64-backing-insert
                      s0
                      "only"
                      7))]
                (begin
                  (test.assert-i64-eq
                    (stdlib.hashmap.lookup-value-or
                      (stdlib.hashmap.hashmap-string-i64-backing-get s1 "only")
                      -1)
                    7
                    "capacity-1 get only")
                  (test.assert-false
                    (stdlib.hashmap.insert-ok?
                      (stdlib.hashmap.hashmap-string-i64-backing-insert
                        s1
                        "second"
                        8))
                    "capacity-1 second insert is full")))))))
      unit)))

(cfg
  test
  (test
    hashmap-string-i64-removal
    (begin
      ;; --- removal + tombstone accounting ---
      (let
        [r0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 8)]
        [r1 : HashmapStringI64Backing
          (stdlib.hashmap.insert-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-insert r0 "k1" 10))]
        [r2 : HashmapStringI64Backing
          (stdlib.hashmap.insert-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-insert r1 "k2" 20))]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len r2)
            2
            "removal: two inserts len 2")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-deleted r2)
            0
            "removal: no tombstones yet")
          ;; remove-miss: absent key leaves the map unchanged and untouched.
          (let
            [miss : HashmapStringI64BackingRemoveResult
              (stdlib.hashmap.hashmap-string-i64-backing-remove r2 "absent")]
            (begin
              (test.assert-false
                (stdlib.hashmap.remove-ok? miss)
                "remove-miss is not ok")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-len
                  (stdlib.hashmap.remove-result-map miss))
                2
                "remove-miss keeps len")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-deleted
                  (stdlib.hashmap.remove-result-map miss))
                0
                "remove-miss adds no tombstone")))
          ;; remove-hit: k1 becomes a tombstone; len-1, deleted+1, k2 survives.
          (let
            [hit : HashmapStringI64BackingRemoveResult
              (stdlib.hashmap.hashmap-string-i64-backing-remove r2 "k1")]
            (begin
              (test.assert-true
                (stdlib.hashmap.remove-ok? hit)
                "remove-hit is ok")
              (let
                [r3 : HashmapStringI64Backing
                  (stdlib.hashmap.remove-result-map hit)]
                (begin
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-string-i64-backing-len r3)
                    1
                    "remove-hit len 1")
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-string-i64-backing-deleted r3)
                    1
                    "remove-hit deleted 1")
                  (test.assert-i64-eq
                    (stdlib.hashmap.lookup-value-or
                      (stdlib.hashmap.hashmap-string-i64-backing-get r3 "k1")
                      -1)
                    -1
                    "k1 missing after remove")
                  (test.assert-true
                    (stdlib.hashmap.hashmap-string-i64-backing-contains?
                      r3
                      "k2")
                    "k2 survives k1 removal")
                  ;; reinsert after delete reuses the tombstone: len back to 2,
                  ;; deleted back to 0, new value visible.
                  (let
                    [r4 : HashmapStringI64Backing
                      (stdlib.hashmap.insert-result-map
                        (stdlib.hashmap.hashmap-string-i64-backing-insert
                          r3
                          "k1"
                          111))]
                    (begin
                      (test.assert-i64-eq
                        (stdlib.hashmap.hashmap-string-i64-backing-len r4)
                        2
                        "reinsert len 2")
                      (test.assert-i64-eq
                        (stdlib.hashmap.hashmap-string-i64-backing-deleted r4)
                        0
                        "reinsert reuses tombstone (deleted 0)")
                      (test.assert-i64-eq
                        (stdlib.hashmap.lookup-value-or
                          (stdlib.hashmap.hashmap-string-i64-backing-get
                            r4
                            "k1")
                          -1)
                        111
                        "k1 reinserted value")))))))))
      unit)))

(cfg
  test
  (test
    hashmap-string-i64-update-entry
    (begin
      ;; --- update / entry-or-insert API ---
      (let
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            10)]
        [u2 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u1
            "beta"
            20)]
        [hit : HashmapStringI64BackingUpdateResult
          (stdlib.hashmap.hashmap-string-i64-backing-update-if-present
            u2
            "alpha"
            70)]
        [u3 : HashmapStringI64Backing (stdlib.hashmap.update-result-map hit)]
        (begin
          (test.assert-true
            (stdlib.hashmap.update-ok? hit)
            "update-if-present hit is ok")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len u3)
            2
            "update hit keeps len")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u3 "alpha")
              -1)
            70
            "update hit overwrites alpha")))
      (let
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            10)]
        [miss : HashmapStringI64BackingUpdateResult
          (stdlib.hashmap.hashmap-string-i64-backing-update-if-present
            u1
            "missing"
            999)]
        [u2 : HashmapStringI64Backing (stdlib.hashmap.update-result-map miss)]
        (begin
          (test.assert-false
            (stdlib.hashmap.update-ok? miss)
            "update missing is not ok")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len u2)
            1
            "update missing keeps len")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u2 "missing")
              -1)
            -1
            "update missing does not insert")))
      (let
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "beta"
            20)]
        [borrow-key : String "beta"]
        [borrow-hit : HashmapStringI64BackingUpdateResult
          (stdlib.hashmap.hashmap-string-i64-backing-update-borrowed-if-present
            u1
            (& borrow-key)
            80)]
        [u2 : HashmapStringI64Backing
          (stdlib.hashmap.update-result-map borrow-hit)]
        (begin
          (test.assert-true
            (stdlib.hashmap.update-ok? borrow-hit)
            "borrowed update-if-present hit is ok")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u2 "beta")
              -1)
            80
            "borrowed update overwrites beta")))
      (let
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            10)]
        [u2 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u1
            "beta"
            20)]
        [removed : HashmapStringI64BackingRemoveResult
          (stdlib.hashmap.hashmap-string-i64-backing-remove u2 "alpha")]
        [u6 : HashmapStringI64Backing
          (stdlib.hashmap.remove-result-map removed)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-deleted u6)
            1
            "entry test starts with one tombstone")
          (let
            [inserted : HashmapStringI64BackingEntryOrInsertResult
              (stdlib.hashmap.hashmap-string-i64-backing-entry-or-insert
                u6
                "alpha"
                111)]
            [u7 : HashmapStringI64Backing
              (stdlib.hashmap.entry-or-insert-result-map inserted)]
            [found : HashmapStringI64BackingEntryOrInsertResult
              (stdlib.hashmap.hashmap-string-i64-backing-entry-or-insert
                u7
                "alpha"
                222)]
            [u8 : HashmapStringI64Backing
              (stdlib.hashmap.entry-or-insert-result-map found)]
            (begin
              (test.assert-true
                (stdlib.hashmap.entry-or-insert-inserted? inserted)
                "entry-or-insert inserts missing key")
              (test.assert-i64-eq
                (stdlib.hashmap.entry-or-insert-value-or inserted -1)
                111
                "entry-or-insert returns inserted default")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-deleted u7)
                0
                "entry-or-insert reuses tombstone")
              (test.assert-false
                (stdlib.hashmap.entry-or-insert-inserted? found)
                "entry-or-insert finds existing key")
              (test.assert-i64-eq
                (stdlib.hashmap.entry-or-insert-value-or found -1)
                111
                "entry-or-insert returns existing value")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get u8 "alpha")
                  -1)
                111
                "entry-or-insert found does not overwrite")))))
      (let
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            111)]
        [u9 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u1
            "alpha"
            333)]
        [grow0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 1)]
        [grow1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            grow0
            "a"
            1)]
        [grow2 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            grow1
            "b"
            2)]
        [grow3 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            grow2
            "c"
            3)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u9 "alpha")
              -1)
            333
            "insert-or-update overwrites existing key")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len grow3)
            3
            "insert-or-update inserts multiple keys")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-string-i64-backing-capacity grow3) 1)
            "insert-or-update grows tiny table")))
      (let
        [key : String "alpha"]
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            10)]
        (begin
          (let
            [entry : (HashmapStringI64BackingMutEntry u1)
              (stdlib.hashmap.hashmap-string-i64-backing-get-mut-entry-borrowed
                u1
                (& key))]
            (begin
              (test.assert-true
                (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-present?
                  entry)
                "mut entry finds existing key")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-value-or
                  entry
                  -1)
                10
                "mut entry reads existing value")
              (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-set!
                entry
                77)))
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u1 "alpha")
              -1)
            77
            "mut entry set updates map storage")))
      (let
        [key : String "missing"]
        [u0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [u1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-insert-or-update
            u0
            "alpha"
            10)]
        (begin
          (let
            [entry : (HashmapStringI64BackingMutEntry u1)
              (stdlib.hashmap.hashmap-string-i64-backing-get-mut-entry-borrowed
                u1
                (& key))]
            (begin
              (test.assert-false
                (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-present?
                  entry)
                "mut entry reports missing key")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-value-or
                  entry
                  -1)
                -1
                "missing mut entry returns fallback")
              (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-set!
                entry
                99)))
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len u1)
            1
            "missing mut entry no-op")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get u1 "alpha")
              -1)
            10
            "missing mut entry leaves map unchanged")))
      unit)))

(cfg
  test
  (test
    hashmap-string-i64-resize-rehash
    (begin
      ;; --- resize / rehash ---
      ;; needs-grow? threshold: a fresh capacity-4 table is below the 3/4 load.
      (test.assert-false
        (stdlib.hashmap.hashmap-string-i64-backing-needs-grow?
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4))
        "fresh cap-4 below load threshold")
      (test.assert-false
        (stdlib.hashmap.hashmap-string-i64-backing-needs-grow?
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 0))
        "zero requested capacity rounds to a fresh cap-1 table")
      ;; hashmap-string-i64-backing-put auto-grows past the fixed capacity and preserves every
      ;; entry across the rehash (collision preservation + lookup after rehash).
      (let
        [g0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [g1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g0 "a" 1)]
        [g2 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g1 "b" 2)]
        [g3 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g2 "c" 3)]
        [g4 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g3 "d" 4)]
        [g5 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g4 "e" 5)]
        [g6 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put g5 "f" 6)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len g6)
            6
            "put six -> len 6")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-string-i64-backing-capacity g6) 4)
            "table grew past the seed capacity")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-deleted g6)
            0
            "grown table has no tombstones")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get g6 "a")
              -1)
            1
            "get a after grow")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get g6 "c")
              -1)
            3
            "get c after grow")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get g6 "f")
              -1)
            6
            "get f after grow")
          (test.assert-i64-eq
            (stdlib.hashmap.lookup-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-get g6 "missing")
              -1)
            -1
            "absent key after grow")
          ;; overwrite across resize: updating an existing key keeps len.
          (let
            [g7 : HashmapStringI64Backing
              (stdlib.hashmap.hashmap-string-i64-backing-put g6 "a" 99)]
            (begin
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-len g7)
                6
                "update keeps len after grow")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get g7 "a")
                  -1)
                99
                "a updated to 99 after grow")))))
      ;; resized drops tombstones: insert 3, remove 1 (deleted=1), resize to 16.
      (let
        [t0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 8)]
        [t1 : HashmapStringI64Backing
          (stdlib.hashmap.insert-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-insert t0 "x" 10))]
        [t2 : HashmapStringI64Backing
          (stdlib.hashmap.insert-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-insert t1 "y" 20))]
        [t3 : HashmapStringI64Backing
          (stdlib.hashmap.insert-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-insert t2 "z" 30))]
        [t4 : HashmapStringI64Backing
          (stdlib.hashmap.remove-result-map
            (stdlib.hashmap.hashmap-string-i64-backing-remove t3 "y"))]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-deleted t4)
            1
            "one tombstone before resize")
          (let
            [t5 : HashmapStringI64Backing
              (stdlib.hashmap.hashmap-string-i64-backing-resized t4 16)]
            [t6 : HashmapStringI64Backing
              (stdlib.hashmap.hashmap-string-i64-backing-resized t4 10)]
            (begin
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-capacity t5)
                16
                "resized capacity 16")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-capacity t6)
                16
                "resized capacity rounds to power of two")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-len t5)
                2
                "resized len 2")
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-deleted t5)
                0
                "resize drops tombstones")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get t5 "x")
                  -1)
                10
                "x survives resize")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get t5 "z")
                  -1)
                30
                "z survives resize")
              (test.assert-i64-eq
                (stdlib.hashmap.lookup-value-or
                  (stdlib.hashmap.hashmap-string-i64-backing-get t5 "y")
                  -1)
                -1
                "removed y absent after resize")))))
      unit)))

(cfg
  test
  (test
    hashmap-string-i64-iteration
    (begin
      ;; --- deterministic bucket-order iteration ---
      ;; empty map: the cursor starts at the capacity; count and sum are zero.
      (let
        [e0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 8)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-next-occupied e0 0)
            8
            "empty map cursor starts at capacity")
          (test.assert-i64-eq
            (stdlib.hashmap.iter-count
              e0
              (stdlib.hashmap.hashmap-string-i64-backing-next-occupied e0 0)
              0)
            0
            "empty map iterates zero entries")
          (test.assert-i64-eq
            (stdlib.hashmap.iter-sum-values
              e0
              (stdlib.hashmap.hashmap-string-i64-backing-next-occupied e0 0)
              0)
            0
            "empty map sum is zero")))
      ;; non-empty map: the cursor visits exactly `len` entries, sums every value
      ;; once, and walks strictly increasing (deterministic bucket) indices.
      (let
        [i0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 8)]
        [i1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put i0 "a" 1)]
        [i2 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put i1 "b" 2)]
        [i3 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put i2 "c" 4)]
        [i4 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put i3 "d" 8)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-i64-backing-len i4)
            4
            "iteration map has four entries")
          (test.assert-i64-eq
            (stdlib.hashmap.iter-count
              i4
              (stdlib.hashmap.hashmap-string-i64-backing-next-occupied i4 0)
              0)
            4
            "cursor visits exactly len entries")
          (test.assert-i64-eq
            (stdlib.hashmap.iter-sum-values
              i4
              (stdlib.hashmap.hashmap-string-i64-backing-next-occupied i4 0)
              0)
            15
            "cursor sums every value once (1+2+4+8)")
          (test.assert-true
            (stdlib.hashmap.iter-monotonic?
              i4
              (stdlib.hashmap.hashmap-string-i64-backing-next-occupied i4 0))
            "cursor visits strictly increasing indices")
          ;; a removed key is skipped: its tombstone is not iterated.
          (let
            [i5 : HashmapStringI64Backing
              (stdlib.hashmap.remove-result-map
                (stdlib.hashmap.hashmap-string-i64-backing-remove i4 "b"))]
            (begin
              (test.assert-i64-eq
                (stdlib.hashmap.hashmap-string-i64-backing-len i5)
                3
                "len 3 after removing b")
              (test.assert-i64-eq
                (stdlib.hashmap.iter-count
                  i5
                  (stdlib.hashmap.hashmap-string-i64-backing-next-occupied i5 0)
                  0)
                3
                "cursor skips the tombstone (count 3)")
              (test.assert-i64-eq
                (stdlib.hashmap.iter-sum-values
                  i5
                  (stdlib.hashmap.hashmap-string-i64-backing-next-occupied i5 0)
                  0)
                13
                "cursor sum excludes the removed value (1+4+8)")))))
      ;; entry-at: out-of-range -> None, the only occupied slot -> Some value.
      (let
        [b0 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-with-capacity 4)]
        [b1 : HashmapStringI64Backing
          (stdlib.hashmap.hashmap-string-i64-backing-put b0 "only" 7)]
        (begin
          (test.assert-true
            (stdlib.hashmap.entry-none?
              (stdlib.hashmap.hashmap-string-i64-backing-entry-at b1 -1))
            "entry-at negative index is None")
          (test.assert-true
            (stdlib.hashmap.entry-none?
              (stdlib.hashmap.hashmap-string-i64-backing-entry-at b1 4))
            "entry-at out-of-range index is None")
          (test.assert-i64-eq
            (stdlib.hashmap.entry-value-or
              (stdlib.hashmap.hashmap-string-i64-backing-entry-at
                b1
                (stdlib.hashmap.hashmap-string-i64-backing-next-occupied b1 0))
              -1)
            7
            "entry-at the only occupied slot is Some 7")))
      unit)))

(cfg
  test
  (test
    hashmap-string-string-family
    (begin
      ;; --- generated String -> String map family ---
      (let
        [alpha : String "alpha"]
        [beta : String "beta"]
        [missing : String "missing"]
        [ss0 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-with-capacity 4)]
        [ss1 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-put ss0 "alpha" "red")]
        [ss2 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-put ss1 "beta" "amber")]
        [ss3 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-put ss2 "gamma" "blue")]
        [ss4 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-put ss3 "delta" "gold")]
        [ss5 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-put ss4 "alpha" "green")]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-string-backing-len ss5)
            4
            "StringString len")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-string-string-backing-capacity ss5) 4)
            "StringString grew past seed capacity")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get-borrowed
                ss5
                (& alpha))
              "fallback")
            "green"
            "StringString borrowed get updated alpha")
          (test.assert-i64-eq
            (stdlib.hashmap.string-string-borrowed-value-length-or
              (stdlib.hashmap.hashmap-string-string-backing-get-value-borrowed
                (& ss5)
                (& alpha))
              -1)
            5
            "StringString borrowed value get returns alpha by reference")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get ss5 "gamma")
              "fallback")
            "blue"
            "StringString owned get gamma")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get-borrowed
                ss5
                (& missing))
              "fallback")
            "fallback"
            "StringString missing borrowed get")
          (test.assert-i64-eq
            (stdlib.hashmap.string-string-borrowed-value-length-or
              (stdlib.hashmap.hashmap-string-string-backing-get-value-borrowed
                (& ss5)
                (& missing))
              -1)
            -1
            "StringString missing borrowed value get")
          (test.assert-true
            (stdlib.hashmap.hashmap-string-string-backing-contains-borrowed?
              ss5
              (& beta))
            "StringString borrowed contains beta")
          (let
            [removed : HashmapStringStringBackingRemoveResult
              (stdlib.hashmap.hashmap-string-string-backing-remove-borrowed
                ss5
                (& beta))]
            (begin
              (test.assert-true
                (stdlib.hashmap.string-string-remove-ok? removed)
                "StringString remove borrowed beta")
              (let
                [ss6 : HashmapStringStringBacking
                  (stdlib.hashmap.string-string-remove-result-map removed)]
                (begin
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-string-string-backing-len ss6)
                    3
                    "StringString len after remove")
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-string-string-backing-deleted ss6)
                    1
                    "StringString tombstone after remove")
                  (test.assert-false
                    (stdlib.hashmap.hashmap-string-string-backing-contains-borrowed?
                      ss6
                      (& beta))
                    "StringString beta absent after remove")
                  (test.assert-i64-eq
                    (stdlib.hashmap.string-string-iter-count
                      ss6
                      (stdlib.hashmap.hashmap-string-string-backing-next-occupied
                        ss6
                        0)
                      0)
                    3
                    "StringString iteration count")
                  (test.assert-i64-eq
                    (stdlib.hashmap.string-string-iter-value-length-sum
                      ss6
                      (stdlib.hashmap.hashmap-string-string-backing-next-occupied
                        ss6
                        0)
                      0)
                    13
                    "StringString iteration value length sum")))))))
      unit)))

(cfg
  test
  (test
    hashmap-string-string-update-entry
    (begin
      ;; --- generated String -> String update / entry-or-insert API ---
      (let
        [alpha-update : String "alpha"]
        [ssu0 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-with-capacity 4)]
        [ssu1 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu0
            "alpha"
            "red")]
        [ssu2 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu1
            "beta"
            "amber")]
        [ssu-hit : HashmapStringStringBackingUpdateResult
          (stdlib.hashmap.hashmap-string-string-backing-update-borrowed-if-present
            ssu2
            (& alpha-update)
            "green")]
        [ssu3 : HashmapStringStringBacking
          (stdlib.hashmap.string-string-update-result-map ssu-hit)]
        (begin
          (test.assert-true
            (stdlib.hashmap.string-string-update-ok? ssu-hit)
            "StringString borrowed update hit")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get ssu3 "alpha")
              "fallback")
            "green"
            "StringString update overwrites alpha")))
      (let
        [ssu0 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-with-capacity 4)]
        [ssu1 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu0
            "alpha"
            "red")]
        [ssu-miss : HashmapStringStringBackingUpdateResult
          (stdlib.hashmap.hashmap-string-string-backing-update-if-present
            ssu1
            "missing"
            "black")]
        [ssu2 : HashmapStringStringBacking
          (stdlib.hashmap.string-string-update-result-map ssu-miss)]
        (begin
          (test.assert-false
            (stdlib.hashmap.string-string-update-ok? ssu-miss)
            "StringString update miss")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-string-backing-len ssu2)
            1
            "StringString update miss keeps len")))
      (let
        [ssu0 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-with-capacity 4)]
        [ssu1 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu0
            "alpha"
            "green")]
        [ssu2 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu1
            "beta"
            "amber")]
        [ssu-removed : HashmapStringStringBackingRemoveResult
          (stdlib.hashmap.hashmap-string-string-backing-remove ssu2 "beta")]
        [ssu3 : HashmapStringStringBacking
          (stdlib.hashmap.string-string-remove-result-map ssu-removed)]
        [ssu-inserted : HashmapStringStringBackingEntryOrInsertResult
          (stdlib.hashmap.hashmap-string-string-backing-entry-or-insert
            ssu3
            "beta"
            "gold")]
        [ssu4 : HashmapStringStringBacking
          (stdlib.hashmap.string-string-entry-or-insert-result-map ssu-inserted)]
        [ssu-found : HashmapStringStringBackingEntryOrInsertResult
          (stdlib.hashmap.hashmap-string-string-backing-entry-or-insert
            ssu4
            "alpha"
            "purple")]
        [ssu5 : HashmapStringStringBacking
          (stdlib.hashmap.string-string-entry-or-insert-result-map ssu-found)]
        (begin
          (test.assert-true
            (stdlib.hashmap.string-string-entry-or-insert-inserted?
              ssu-inserted)
            "StringString entry-or-insert inserted")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-entry-or-insert-value-or
              ssu-inserted
              "fallback")
            "gold"
            "StringString entry-or-insert returns default")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-string-string-backing-deleted ssu4)
            0
            "StringString entry-or-insert reuses tombstone")
          (test.assert-false
            (stdlib.hashmap.string-string-entry-or-insert-inserted? ssu-found)
            "StringString entry-or-insert found")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-entry-or-insert-value-or
              ssu-found
              "fallback")
            "green"
            "StringString entry-or-insert returns existing")
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get ssu5 "alpha")
              "fallback")
            "green"
            "StringString entry-or-insert found does not overwrite")))
      (let
        [ssu0 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-with-capacity 2)]
        [ssu1 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu0
            "alpha"
            "green")]
        [ssu2 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu1
            "beta"
            "gold")]
        [ssu3 : HashmapStringStringBacking
          (stdlib.hashmap.hashmap-string-string-backing-insert-or-update
            ssu2
            "gamma"
            "blue")]
        (begin
          (stdlib.hashmap.hashmap-test-assert-owned-string-eq
            (stdlib.hashmap.string-string-lookup-value-or
              (stdlib.hashmap.hashmap-string-string-backing-get ssu3 "gamma")
              "fallback")
            "blue"
            "StringString insert-or-update inserts new key")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-string-string-backing-capacity ssu3) 2)
            "StringString insert-or-update grows")))
      unit)))

(cfg
  test
  (test
    hashmap-i64-i64-family
    (begin
      ;; --- generated i64 -> i64 map family ---
      (let
        [ii0 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 4)]
        [ii1 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-put ii0 1 10)]
        [ii2 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-put ii1 2 20)]
        [ii3 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-put ii2 3 30)]
        [ii4 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-put ii3 4 40)]
        [ii5 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-put ii4 1 99)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-i64-i64-backing-len ii5)
            4
            "I64I64 len")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-i64-i64-backing-capacity ii5) 4)
            "I64I64 grew past seed capacity")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get ii5 1)
              -1)
            99
            "I64I64 updated key 1")
          (test.assert-true
            (stdlib.hashmap.i64-i64-borrowed-value-found?
              (stdlib.hashmap.hashmap-i64-i64-backing-get-value-borrowed
                (& ii5)
                1))
            "I64I64 borrowed value get finds key 1")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get ii5 3)
              -1)
            30
            "I64I64 get key 3")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get ii5 99)
              -1)
            -1
            "I64I64 missing key")
          (test.assert-false
            (stdlib.hashmap.i64-i64-borrowed-value-found?
              (stdlib.hashmap.hashmap-i64-i64-backing-get-value-borrowed
                (& ii5)
                99))
            "I64I64 missing borrowed value get")
          (test.assert-true
            (stdlib.hashmap.hashmap-i64-i64-backing-contains? ii5 2)
            "I64I64 contains key 2")
          (let
            [removed : HashmapI64I64BackingRemoveResult
              (stdlib.hashmap.hashmap-i64-i64-backing-remove ii5 2)]
            (begin
              (test.assert-true
                (stdlib.hashmap.i64-i64-remove-ok? removed)
                "I64I64 remove key 2")
              (let
                [ii6 : HashmapI64I64Backing
                  (stdlib.hashmap.i64-i64-remove-result-map removed)]
                (begin
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-i64-i64-backing-len ii6)
                    3
                    "I64I64 len after remove")
                  (test.assert-i64-eq
                    (stdlib.hashmap.hashmap-i64-i64-backing-deleted ii6)
                    1
                    "I64I64 tombstone after remove")
                  (test.assert-false
                    (stdlib.hashmap.hashmap-i64-i64-backing-contains? ii6 2)
                    "I64I64 removed key absent")
                  (test.assert-i64-eq
                    (stdlib.hashmap.i64-i64-iter-count
                      ii6
                      (stdlib.hashmap.hashmap-i64-i64-backing-next-occupied
                        ii6
                        0)
                      0)
                    3
                    "I64I64 iteration count")
                  (test.assert-i64-eq
                    (stdlib.hashmap.i64-i64-iter-value-sum
                      ii6
                      (stdlib.hashmap.hashmap-i64-i64-backing-next-occupied
                        ii6
                        0)
                      0)
                    169
                    "I64I64 iteration value sum")))))))
      unit)))

(cfg
  test
  (test
    hashmap-i64-i64-update-entry
    (begin
      ;; --- generated i64 -> i64 update / entry-or-insert API ---
      (let
        [iiu0 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 4)]
        [iiu1 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu0 1 10)]
        [iiu2 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu1 2 20)]
        [iiu-hit : HashmapI64I64BackingUpdateResult
          (stdlib.hashmap.hashmap-i64-i64-backing-update-if-present iiu2 1 70)]
        [iiu3 : HashmapI64I64Backing
          (stdlib.hashmap.i64-i64-update-result-map iiu-hit)]
        (begin
          (test.assert-true
            (stdlib.hashmap.i64-i64-update-ok? iiu-hit)
            "I64I64 update hit")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get iiu3 1)
              -1)
            70
            "I64I64 update overwrites key 1")))
      (let
        [iiu0 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 4)]
        [iiu1 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu0 1 10)]
        [iiu-miss : HashmapI64I64BackingUpdateResult
          (stdlib.hashmap.hashmap-i64-i64-backing-update-if-present iiu1 99 990)]
        [iiu2 : HashmapI64I64Backing
          (stdlib.hashmap.i64-i64-update-result-map iiu-miss)]
        (begin
          (test.assert-false
            (stdlib.hashmap.i64-i64-update-ok? iiu-miss)
            "I64I64 update miss")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-i64-i64-backing-len iiu2)
            1
            "I64I64 update miss keeps len")))
      (let
        [iiu0 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 4)]
        [iiu1 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu0 1 70)]
        [iiu2 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu1 2 20)]
        [iiu-removed : HashmapI64I64BackingRemoveResult
          (stdlib.hashmap.hashmap-i64-i64-backing-remove iiu2 2)]
        [iiu5 : HashmapI64I64Backing
          (stdlib.hashmap.i64-i64-remove-result-map iiu-removed)]
        [iiu-inserted : HashmapI64I64BackingEntryOrInsertResult
          (stdlib.hashmap.hashmap-i64-i64-backing-entry-or-insert iiu5 2 222)]
        [iiu6 : HashmapI64I64Backing
          (stdlib.hashmap.i64-i64-entry-or-insert-result-map iiu-inserted)]
        [iiu-found : HashmapI64I64BackingEntryOrInsertResult
          (stdlib.hashmap.hashmap-i64-i64-backing-entry-or-insert iiu6 1 111)]
        [iiu7 : HashmapI64I64Backing
          (stdlib.hashmap.i64-i64-entry-or-insert-result-map iiu-found)]
        (begin
          (test.assert-true
            (stdlib.hashmap.i64-i64-entry-or-insert-inserted? iiu-inserted)
            "I64I64 entry-or-insert inserted")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-entry-or-insert-value-or iiu-inserted -1)
            222
            "I64I64 entry-or-insert returns default")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-i64-i64-backing-deleted iiu6)
            0
            "I64I64 entry-or-insert reuses tombstone")
          (test.assert-false
            (stdlib.hashmap.i64-i64-entry-or-insert-inserted? iiu-found)
            "I64I64 entry-or-insert found")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-entry-or-insert-value-or iiu-found -1)
            70
            "I64I64 entry-or-insert returns existing")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get iiu7 1)
              -1)
            70
            "I64I64 entry-or-insert found does not overwrite")))
      (let
        [iiu0 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 2)]
        [iiu1 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu0 1 70)]
        [iiu2 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu1 2 222)]
        [iiu8 : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-insert-or-update iiu2 3 30)]
        (begin
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get iiu8 3)
              -1)
            30
            "I64I64 insert-or-update inserts key 3")
          (test.assert-true
            (> (stdlib.hashmap.hashmap-i64-i64-backing-capacity iiu8) 2)
            "I64I64 insert-or-update grows")))
      (let
        [map : HashmapI64I64Backing
          (stdlib.hashmap.hashmap-i64-i64-backing-with-capacity 8)]
        (begin
          (test.assert-true
            (stdlib.hashmap.hashmap-i64-i64-backing-insert-if-absent!
              (&mut map)
              1
              10)
            "I64I64 insert-if-absent inserts missing key")
          (test.assert-false
            (stdlib.hashmap.hashmap-i64-i64-backing-insert-if-absent!
              (&mut map)
              1
              99)
            "I64I64 insert-if-absent preserves existing key")
          (test.assert-i64-eq
            (stdlib.hashmap.i64-i64-lookup-value-or
              (stdlib.hashmap.hashmap-i64-i64-backing-get-ref (& map) 1)
              -1)
            10
            "I64I64 insert-if-absent preserves existing value")
          (test.assert-true
            (stdlib.hashmap.hashmap-i64-i64-backing-remove! (&mut map) 1)
            "I64I64 insert-if-absent setup removes key")
          (test.assert-true
            (stdlib.hashmap.hashmap-i64-i64-backing-insert-if-absent!
              (&mut map)
              1
              70)
            "I64I64 insert-if-absent reuses tombstone")
          (test.assert-i64-eq
            (stdlib.hashmap.hashmap-i64-i64-backing-deleted map)
            0
            "I64I64 insert-if-absent clears reused tombstone")))
      unit)))