                              0
                              next))
                          (set! walked (+ walked 1)))))]))
              (if (>= first 0)
                (begin
                  (array-set!
                    slots
                    first
                    (HashmapI64StringBackingOccupied key value hash))
                  (set! (struct-get map len) (+ (struct-get map len) 1))
