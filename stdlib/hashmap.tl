                          cursor)]
                      [reused-tombstone : bool (>= first 0)]
                      (begin
                        (array-set!
                          slots
                          index
                          (HashmapI64I64BackingOccupied key value hash))
                        (set! (struct-get map len) (+ (struct-get map len) 1))
                        (if reused-tombstone
                          (set!
                            (struct-get map deleted)
                            (- (struct-get map deleted) 1))
                          unit)
                        (return unit)))]
                  [(HashmapI64I64BackingTombstone)
                    (let
                      [next : i64 (+ cursor 1)]
                      (begin
                        (if (< first 0)
                          (set! first cursor)
                          unit)
                        (set!
                          cursor
                          (if (>= next capacity)
                            0
                            next))
                        (set! walked (+ walked 1))))]
                  [(HashmapI64I64BackingOccupied slot-key _ slot-hash)
                    (if (if (= slot-hash hash)
                      (= slot-key key)
                      false)
                      (begin
                        (array-set!
                          slots
                          cursor
                          (HashmapI64I64BackingOccupied key value hash))
                        (return unit))
                      (let
                        [next : i64 (+ cursor 1)]
                        (begin
                          (set!
                            cursor
                            (if (>= next capacity)
                              0
                              next))
                          (set! walked (+ walked 1)))))]))
              (if (>= first 0)
                (begin
                  (array-set!
                    slots
                    first
                    (HashmapI64I64BackingOccupied key value hash))
                  (set! (struct-get map len) (+ (struct-get map len) 1))
                  (set! (struct-get map deleted) (- (struct-get map deleted) 1)))
                unit))))))))

;: Insert through a mutable i64 -> i64 map reference only when the key is absent.
(define (hashmap-i64-i64-backing-insert-if-absent!
  [map : (&mut map HashmapI64I64Backing)]
  [key : i64]
  [value : i64]) : bool
  (let
    [capacity-before : i64 (array-length (struct-get map slots))]
    [used-before : i64 (+ (struct-get map len) (struct-get map deleted))]
    (begin
      (if (if (<= capacity-before 0)
        true
        (>= (* used-before 4) (* capacity-before 3)))
        (hashmap-i64-i64-backing-resize!
          map
          (hashmap-i64-i64-backing-grow-capacity capacity-before))
        unit)
      (let
        [slots : (&mut map (Array HashmapI64I64BackingSlot))
          (&mut (struct-get map slots))]
        [capacity : i64 (array-length slots)]
        [hash : i64 (hashmap-i64-i64-backing-hash-key key)]
        [cursor : i64
          (hashmap-i64-i64-backing-normalized-bucket-index hash capacity)]
        [walked : i64 0]
        [first-tombstone : i64 -1]
        (begin
          (while (< walked capacity)
            (match (array-ref slots cursor)
              [(HashmapI64I64BackingEmpty)
                (let
                  [index : i64
                    (if (>= first-tombstone 0)
                      first-tombstone
                      cursor)]
                  (begin
                    (array-set!
                      slots
                      index
                      (HashmapI64I64BackingOccupied key value hash))
                    (set! (struct-get map len) (+ (struct-get map len) 1))
                    (if (>= first-tombstone 0)
                      (set!
                        (struct-get map deleted)
                        (- (struct-get map deleted) 1))
                      unit)
                    (return true)))]
              [(HashmapI64I64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (if (< first-tombstone 0)
                      (set! first-tombstone cursor)
                      unit)
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapI64I64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (= slot-key key)
                  false)
                  (return false)
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (if (>= first-tombstone 0)
            (begin
              (array-set!
                slots
                first-tombstone
                (HashmapI64I64BackingOccupied key value hash))
              (set! (struct-get map len) (+ (struct-get map len) 1))
              (set! (struct-get map deleted) (- (struct-get map deleted) 1))
              true)
            false))))))

;: Remove an i64 key from i64 -> i64 through a mutable map reference.
(define (hashmap-i64-i64-backing-remove!
  [map : (&mut map HashmapI64I64Backing)]
