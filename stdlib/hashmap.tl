;: One open-addressing slot: empty, a deleted tombstone, or an occupied entry
;: carrying the owned key, its copied value, and the cached key hash.
(defenum HashmapStringI64BackingSlot
  (HashmapStringI64BackingEmpty)
  (HashmapStringI64BackingTombstone)
  (HashmapStringI64BackingOccupied String i64 i64))

;: Result of probing for a key in a slot array:
;: - `Found` carries the slot index that holds the key.
;: - `Absent` carries the slot index where the key may be inserted (the first
;:   tombstone seen, otherwise the first empty slot).
;: - `Full` means the key is not present and the table has neither an empty
;:   slot nor a reusable tombstone.
(defenum HashmapStringI64BackingProbe
  (HashmapStringI64BackingProbeFound i64)
  (HashmapStringI64BackingProbeAbsent i64)
  (HashmapStringI64BackingProbeFull))

;: Return whether `capacity` is positive and a power of two.
(define (hashmap-string-i64-backing-power-two-capacity? [capacity : i64]) : bool
  (and (> capacity 0) (= (bit-and capacity (- capacity 1)) 0)))

;: Round `capacity` up to the next positive power of two. Non-positive requests
;: become capacity 1 so every constructed map keeps the mask invariant.
(define (hashmap-string-i64-backing-round-capacity [capacity : i64]) : i64
  (let
    [rounded : i64 1]
    (begin
      (while (< rounded capacity)
        (set! rounded (* rounded 2)))
      rounded)))

;: Return the start bucket when `hash` is already in the public hash range.
;: `capacity` must be a positive power of two.
(define (hashmap-string-i64-backing-normalized-bucket-index
  [hash : i64]
  [capacity : i64]) : i64
  (bit-and hash (- capacity 1)))

;: Return the start bucket for `hash` in a table of `capacity` slots.
;: `capacity` must be positive; the result is in `[0, capacity)`.
(define (hashmap-string-i64-backing-bucket-index [hash : i64] [capacity : i64]) : i64
  (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
    (hash_mod.normalize hash)
    capacity))

;: Advance a bucket index by one slot, wrapping around the table.
(define (hashmap-string-i64-backing-next-index [index : i64] [capacity : i64]) : i64
  (let
    [next : i64 (+ index 1)]
    (if (>= next capacity)
      0
      next)))

;: Read the slot at `index`. Probe/iteration indices are always in
;: `[0, capacity)`, so skip the redundant dynamic-array bounds check.
(define (hashmap-string-i64-backing-slot-at
  [slots : (Array HashmapStringI64BackingSlot)]
  [index : i64]) : HashmapStringI64BackingSlot
  (unsafe
    (ptr-read
      (ptr-offset
        (ptr-cast (array-data slots) : (Ptr HashmapStringI64BackingSlot))
        index))))

;: Pick the insertion slot for an absent key: reuse the first tombstone seen
;: (`first-tombstone` >= 0) so deletes do not strand keys, otherwise the empty
;: slot the probe stopped on.
(define (hashmap-string-i64-backing-insert-slot
  [first-tombstone : i64]
  [empty-index : i64]) : i64
  (if (>= first-tombstone 0)
    first-tombstone
    empty-index))

;: Linear-probing walk from `index`, having taken `steps` steps and remembered
;: the first tombstone index (`-1` when none seen yet). Terminates after at most
;: `capacity` steps so a full table never loops forever.
(define (hashmap-string-i64-backing-probe-from
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : String]
  [hash : i64]
  [index : i64]
  [steps : i64]
  [first-tombstone : i64]) : HashmapStringI64BackingProbe
  (let
    [cursor : i64 index]
    [walked : i64 steps]
    [first : i64 first-tombstone]
    (begin
      (while (< walked capacity)
        (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at slots cursor)
          [(HashmapStringI64BackingEmpty)
            (return
              (HashmapStringI64BackingProbeAbsent
                (if (>= first 0)
                  first
                  cursor)))]
          [(HashmapStringI64BackingTombstone)
            (let
              [next : i64 (+ cursor 1)]
              (begin
                (if (< first 0)
                  (set! first cursor)
                  unit)
                (set!
                  cursor
                  (if (>= next capacity)
                    0
                    next))
                (set! walked (+ walked 1))))]
          [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
            (if (if (= slot-hash hash)
              (hash_mod.key-string-eq? (& slot-key) (& key))
              false)
              (return (HashmapStringI64BackingProbeFound cursor))
              (let
                [next : i64 (+ cursor 1)]
                (begin
                  (set!
                    cursor
                    (if (>= next capacity)
                      0
                      next))
                  (set! walked (+ walked 1)))))]))
      (if (>= first 0)
        (HashmapStringI64BackingProbeAbsent first)
        (HashmapStringI64BackingProbeFull)))))

;: Probe `slots` (a `capacity`-length open-addressing table) for `key` with the
;: precomputed `hash`. Returns where the key lives (`Found`), where it could be
;: inserted (`Absent`), or `Full`. Callers compute `hash` with `hash.string-key`.
(define (hashmap-string-i64-backing-probe
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : String]
  [hash : i64]) : HashmapStringI64BackingProbe
  (stdlib.hashmap.hashmap-string-i64-backing-probe-borrowed
    slots
    capacity
    (& key)
    hash))

;: Borrowed-key probing for the compatibility `String -> i64` map. This keeps
;: old owned-key probe callers working while exposing the generated-family lookup
;: shape used by newer string-key maps.
(define (hashmap-string-i64-backing-probe-borrowed-from
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : (& key str)]
  [hash : i64]
  [index : i64]
  [steps : i64]
  [first-tombstone : i64]) : HashmapStringI64BackingProbe
  (let
    [cursor : i64 index]
    [walked : i64 steps]
    [first : i64 first-tombstone]
    (begin
      (while (< walked capacity)
        (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at slots cursor)
          [(HashmapStringI64BackingEmpty)
            (return
              (HashmapStringI64BackingProbeAbsent
                (stdlib.hashmap.hashmap-string-i64-backing-insert-slot
                  first
                  cursor)))]
          [(HashmapStringI64BackingTombstone)
            (let
              [next : i64 (+ cursor 1)]
              (begin
                (if (< first 0)
                  (set! first cursor)
                  unit)
                (set!
                  cursor
                  (if (>= next capacity)
                    0
                    next))
                (set! walked (+ walked 1))))]
          [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
            (if (if (= slot-hash hash)
              (hash_mod.key-string-eq? (& slot-key) key)
              false)
              (return (HashmapStringI64BackingProbeFound cursor))
              (let
                [next : i64 (+ cursor 1)]
                (begin
                  (set!
                    cursor
                    (if (>= next capacity)
                      0
                      next))
                  (set! walked (+ walked 1)))))]))
      (if (>= first 0)
        (HashmapStringI64BackingProbeAbsent first)
        (HashmapStringI64BackingProbeFull)))))

;: Probe `slots` for a borrowed string key with a precomputed `hash`.
(define (hashmap-string-i64-backing-probe-borrowed
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : (& key str)]
  [hash : i64]) : HashmapStringI64BackingProbe
  (if (<= capacity 0)
    (HashmapStringI64BackingProbeFull)
    (stdlib.hashmap.hashmap-string-i64-backing-probe-borrowed-from
      slots
      capacity
      key
      hash
      (stdlib.hashmap.hashmap-string-i64-backing-bucket-index hash capacity)
      0
      -1)))

;: Probe when `hash` is already normalized, as produced by `hash.string-key` or
;: copied from an occupied slot.
(define (hashmap-string-i64-backing-probe-normalized
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : String]
  [hash : i64]) : HashmapStringI64BackingProbe
  (if (<= capacity 0)
    (HashmapStringI64BackingProbeFull)
    (stdlib.hashmap.hashmap-string-i64-backing-probe-from
      slots
      capacity
      key
      hash
      (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
        hash
        capacity)
      0
      -1)))

;: The v1 fixed-capacity `String -> i64` map: the
;: open-addressing slot table, the live-entry count, and the tombstone count.
(defstruct HashmapStringI64Backing
  (slots (Array HashmapStringI64BackingSlot))
  (len i64)
  (deleted i64))

;: Result of a lookup: the key's copied value, or missing.
(defenum HashmapStringI64BackingLookup
  (HashmapStringI64BackingMissing)
  (HashmapStringI64BackingFound i64))

;: Result of a borrowed-value lookup: a reference to the map-owned value, or
;: missing. The returned reference is tied to the borrowed map.
(defenum HashmapStringI64BackingBorrowedValueLookup
  (:lifetimes map)
  (HashmapStringI64BackingBorrowedValueMissing)
  (HashmapStringI64BackingBorrowedValueFound (& map i64)))

;: Result of an insert: the updated map (the bucket array is mutated in place,
;: so callers thread the returned map forward), or `Full` when the
;: fixed-capacity table has no slot for a new key.
(defenum HashmapStringI64BackingInsertResult
  (HashmapStringI64BackingInsertOk HashmapStringI64Backing)
  (HashmapStringI64BackingInsertFull HashmapStringI64Backing))

;: Result of a removal: the updated map (a live slot becomes a tombstone in
;: place, so callers thread the returned map forward) when the key was present,
;: or `Missing` with the map unchanged when it was not.
(defenum HashmapStringI64BackingRemoveResult
  (HashmapStringI64BackingRemoveOk HashmapStringI64Backing)
  (HashmapStringI64BackingRemoveMissing HashmapStringI64Backing))

;: Result of an update-only operation: the updated map when the key was present,
;: or `Missing` with the map unchanged when it was absent.
(defenum HashmapStringI64BackingUpdateResult
  (HashmapStringI64BackingUpdateOk HashmapStringI64Backing)
  (HashmapStringI64BackingUpdateMissing HashmapStringI64Backing))

;: Result of `entry-or-insert`: the map plus the live value. `Found` means the
;: key already existed and the map was not changed; `Inserted` means the default
;: value was inserted, growing/rehashing first if needed.
(defenum HashmapStringI64BackingEntryOrInsertResult
  (HashmapStringI64BackingEntryOrInsertFound HashmapStringI64Backing i64)
  (HashmapStringI64BackingEntryOrInsertInserted HashmapStringI64Backing i64))

;: Probe metadata used to construct a live mutable entry after the caller takes
;: the unique slot borrow. `present=false` means `index` is a sentinel and the
;: entry setter is a no-op.
(defstruct HashmapStringI64BackingMutEntryInfo
  (index i64)
  (present bool)
  (key String)
  (hash i64))

;: Live mutable entry handle for an existing bucket. `borrow` carries the unique
;: slot-array borrow and is used for reads/writes, so the checker rejects
;: another mutable entry or table mutation while live.
(defstruct HashmapStringI64BackingMutEntry
  (:lifetimes map)
  (borrow (&mut map (Array HashmapStringI64BackingSlot)))
  (index i64)
  (present bool)
  (key String)
  (hash i64))

;: The map's backing slot array.
(define (hashmap-string-i64-backing-slots [map : HashmapStringI64Backing]) : (Array
    HashmapStringI64BackingSlot)
  (struct-get map slots))

;: Mutable access to the map's backing slot array for wrapper modules.
(define (hashmap-string-i64-backing-slots-mut
  [map : (&mut map HashmapStringI64Backing)]) : (&mut
    map
    (Array HashmapStringI64BackingSlot))
  (&mut (struct-get map slots)))

;: Number of live (occupied) entries.
(define (hashmap-string-i64-backing-len [map : HashmapStringI64Backing]) : i64
  (struct-get map len))

;: Number of slots in the backing table.
(define (hashmap-string-i64-backing-capacity [map : HashmapStringI64Backing]) : i64
  (array-length (struct-get map slots)))

;: Number of tombstone (deleted) slots awaiting reuse. Live entries plus
;: tombstones never exceed the capacity; this count feeds resize thresholds.
(define (hashmap-string-i64-backing-deleted [map : HashmapStringI64Backing]) : i64
  (struct-get map deleted))

;: Create an empty map with `capacity` rounded up to a positive power of two.
(define (hashmap-string-i64-backing-with-capacity [capacity : i64]) : HashmapStringI64Backing
  (let
    [rounded-capacity : i64
      (stdlib.hashmap.hashmap-string-i64-backing-round-capacity capacity)]
    [slots : (Array HashmapStringI64BackingSlot)
      (array.make-array HashmapStringI64BackingSlot rounded-capacity)]
    (HashmapStringI64Backing slots 0 0)))

;: Construct a missing borrowed-value lookup result tied to `map`.
(define (hashmap-string-i64-backing-borrowed-value-missing
  [_map : (& map HashmapStringI64Backing)]) : (HashmapStringI64BackingBorrowedValueLookup
    map)
  (HashmapStringI64BackingBorrowedValueMissing))

;: Construct a found borrowed-value lookup result tied to `map`.
(define (hashmap-string-i64-backing-borrowed-value-found [value : (& map i64)]) : (HashmapStringI64BackingBorrowedValueLookup
    map)
  (HashmapStringI64BackingBorrowedValueFound value))

;: Look up borrowed `key`, returning its copied `i64` value or `Missing`.
(define (hashmap-string-i64-backing-get-borrowed
  [map : HashmapStringI64Backing]
  [key : (& key str)]) : HashmapStringI64BackingLookup
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [capacity : i64 (array-length slots)]
    (if (<= capacity 0)
      (HashmapStringI64BackingMissing)
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
              slots
              cursor)
              [(HashmapStringI64BackingEmpty)
                (return (HashmapStringI64BackingMissing))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key value slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (return (HashmapStringI64BackingFound value))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (HashmapStringI64BackingMissing))))))

;: Compatibility owned-key lookup wrapper for existing callers.
(define (hashmap-string-i64-backing-get
  [map : HashmapStringI64Backing]
  [key : String]) : HashmapStringI64BackingLookup
  (stdlib.hashmap.hashmap-string-i64-backing-get-borrowed map (& key)))

;: Borrowed lookup through an immutable map reference.
(define (hashmap-string-i64-backing-get-borrowed-ref
  [map : (& map HashmapStringI64Backing)]
  [key : (& key str)]) : HashmapStringI64BackingLookup
  (let
    [capacity : i64 (array-length (struct-get map slots))]
    (if (<= capacity 0)
      (HashmapStringI64BackingMissing)
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (array-ref (struct-get map slots) cursor)
              [(HashmapStringI64BackingEmpty)
                (return (HashmapStringI64BackingMissing))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key value slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (return (HashmapStringI64BackingFound value))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (HashmapStringI64BackingMissing))))))

;: Borrowed lookup through a mutable map reference.
(define (hashmap-string-i64-backing-get-borrowed-mut
  [map : (&mut map HashmapStringI64Backing)]
  [key : (& key str)]) : HashmapStringI64BackingLookup
  (let
    [slots : (&mut map (Array HashmapStringI64BackingSlot))
      (stdlib.hashmap.hashmap-string-i64-backing-slots-mut map)]
    [capacity : i64 (array-length slots)]
    (if (<= capacity 0)
      (HashmapStringI64BackingMissing)
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (array-ref slots cursor)
              [(HashmapStringI64BackingEmpty)
                (return (HashmapStringI64BackingMissing))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key value slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (return (HashmapStringI64BackingFound value))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (HashmapStringI64BackingMissing))))))

;: Containment through an immutable map reference.
(define (hashmap-string-i64-backing-contains-borrowed-ref?
  [map : (& map HashmapStringI64Backing)]
  [key : (& key str)]) : bool
  (match (stdlib.hashmap.hashmap-string-i64-backing-get-borrowed-ref map key)
    [(HashmapStringI64BackingFound _) true]
    [(HashmapStringI64BackingMissing) false]))

;: Containment through a mutable map reference.
(define (hashmap-string-i64-backing-contains-borrowed-mut?
  [map : (&mut map HashmapStringI64Backing)]
  [key : (& key str)]) : bool
  (match (stdlib.hashmap.hashmap-string-i64-backing-get-borrowed-mut map key)
    [(HashmapStringI64BackingFound _) true]
    [(HashmapStringI64BackingMissing) false]))

;: Look up borrowed `key`, returning a reference to the map-owned `i64` value
;: or `Missing`. The reference is invalidated by any map mutation/resizing.
(define (hashmap-string-i64-backing-get-value-borrowed
  [map : (& map HashmapStringI64Backing)]
  [key : (& key str)]) : (HashmapStringI64BackingBorrowedValueLookup map)
  (let
    [capacity : i64 (array-length (struct-get map slots))]
    (if (<= capacity 0)
      (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-missing map)
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (array-ref (struct-get map slots) cursor)
              [(HashmapStringI64BackingEmpty)
                (return
                  (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-missing
                    map))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (match (& (array-ref (struct-get map slots) cursor))
                    [(HashmapStringI64BackingOccupied _ value _)
                      (return
                        (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-found
                          value))]
                    [(HashmapStringI64BackingEmpty)
                      (return
                        (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-missing
                          map))]
                    [(HashmapStringI64BackingTombstone)
                      (return
                        (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-missing
                          map))])
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (stdlib.hashmap.hashmap-string-i64-backing-borrowed-value-missing map))))))

;: True when borrowed `key` has a live value in `map`.
(define (hashmap-string-i64-backing-contains-borrowed?
  [map : HashmapStringI64Backing]
  [key : (& key str)]) : bool
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [capacity : i64 (array-length slots)]
    (if (<= capacity 0)
      false
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
              slots
              cursor)
              [(HashmapStringI64BackingEmpty) (return false)]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (return true)
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          false)))))

;: Compatibility owned-key containment wrapper for existing callers.
(define (hashmap-string-i64-backing-contains?
  [map : HashmapStringI64Backing]
  [key : String]) : bool
  (stdlib.hashmap.hashmap-string-i64-backing-contains-borrowed? map (& key)))

;: True when `slot` is a reusable tombstone.
(define (hashmap-string-i64-backing-slot-tombstone?
  [slot : HashmapStringI64BackingSlot]) : bool
  (match slot
    [(HashmapStringI64BackingTombstone) true]
    [(HashmapStringI64BackingEmpty) false]
    [(HashmapStringI64BackingOccupied _ _ _) false]))

;: Insert or update `key` -> `value`, mutating the backing slot array and
;: returning the updated map. Updating an existing key leaves `len` unchanged;
;: inserting a new key increments it; reusing a tombstone slot also decrements
;: the deleted count. `Full` when a fixed-capacity table cannot place a new key.
(define (hashmap-string-i64-backing-insert
  [map : HashmapStringI64Backing]
  [key : String]
  [value : i64]) : HashmapStringI64BackingInsertResult
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [capacity : i64 (array-length slots)]
    [hash : i64 (hash_mod.string-key (& key))]
    (if (<= capacity 0)
      (HashmapStringI64BackingInsertFull map)
      (let
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        [first : i64 -1]
        (begin
          (while (< walked capacity)
            (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
              slots
              cursor)
              [(HashmapStringI64BackingEmpty)
                (let
                  [index : i64
                    (if (>= first 0)
                      first
                      cursor)]
                  [reused-tombstone : bool (>= first 0)]
                  [deleted : i64
                    (stdlib.hashmap.hashmap-string-i64-backing-deleted map)]
                  (begin
                    (array-set!
                      slots
                      index
                      (HashmapStringI64BackingOccupied key value hash))
                    (set!
                      (struct-get map len)
                      (+ (stdlib.hashmap.hashmap-string-i64-backing-len map) 1))
                    (if reused-tombstone
                      (set! (struct-get map deleted) (- deleted 1))
                      unit)
                    (return (HashmapStringI64BackingInsertOk map))))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (if (< first 0)
                      (set! first cursor)
                      unit)
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) (& key))
                  false)
                  (begin
                    (array-set!
                      slots
                      cursor
                      (HashmapStringI64BackingOccupied key value hash))
                    (return (HashmapStringI64BackingInsertOk map)))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (if (>= first 0)
            (let
              [deleted : i64
                (stdlib.hashmap.hashmap-string-i64-backing-deleted map)]
              (begin
                (array-set!
                  slots
                  first
                  (HashmapStringI64BackingOccupied key value hash))
                (set!
                  (struct-get map len)
                  (+ (stdlib.hashmap.hashmap-string-i64-backing-len map) 1))
                (set! (struct-get map deleted) (- deleted 1))
                (HashmapStringI64BackingInsertOk map)))
            (HashmapStringI64BackingInsertFull map)))))))

;: Remove borrowed `key`, replacing its live slot with a tombstone (so probing
;: past it still finds later collided keys) and returning the updated map with
;: `len` decremented and the deleted count incremented. Returns `Missing` with
;: the map unchanged when the key is absent. A later insert can reuse the
;: tombstone. The backing array is mutated in place, so thread the result
;: forward.
(define (hashmap-string-i64-backing-remove-borrowed
  [map : HashmapStringI64Backing]
  [key : (& key str)]) : HashmapStringI64BackingRemoveResult
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [capacity : i64 (array-length slots)]
    (if (<= capacity 0)
      (HashmapStringI64BackingRemoveMissing map)
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
              slots
              cursor)
              [(HashmapStringI64BackingEmpty)
                (return (HashmapStringI64BackingRemoveMissing map))]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (begin
                    (array-set! slots cursor (HashmapStringI64BackingTombstone))
                    (set!
                      (struct-get map len)
                      (- (stdlib.hashmap.hashmap-string-i64-backing-len map) 1))
                    (set!
                      (struct-get map deleted)
                      (+
                        (stdlib.hashmap.hashmap-string-i64-backing-deleted map)
                        1))
                    (return (HashmapStringI64BackingRemoveOk map)))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          (HashmapStringI64BackingRemoveMissing map))))))

;: Compatibility owned-key remove wrapper for existing callers.
(define (hashmap-string-i64-backing-remove
  [map : HashmapStringI64Backing]
  [key : String]) : HashmapStringI64BackingRemoveResult
  (stdlib.hashmap.hashmap-string-i64-backing-remove-borrowed map (& key)))

;: Update borrowed `key` only when it is already present. This preserves the
;: stored key object and hash, mutating only the occupied slot value.
(define (hashmap-string-i64-backing-update-borrowed-if-present
  [map : HashmapStringI64Backing]
  [key : (& key str)]
  [value : i64]) : HashmapStringI64BackingUpdateResult
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [hash : i64 (hash_mod.string-key key)]
    (match (stdlib.hashmap.hashmap-string-i64-backing-probe-borrowed
      slots
      (stdlib.hashmap.hashmap-string-i64-backing-capacity map)
      key
      hash)
      [(HashmapStringI64BackingProbeFound index)
        (match (array-ref slots index)
          [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
            (begin
              (array-set!
                slots
                index
                (HashmapStringI64BackingOccupied slot-key value slot-hash))
              (HashmapStringI64BackingUpdateOk map))]
          [(HashmapStringI64BackingEmpty)
            (HashmapStringI64BackingUpdateMissing map)]
          [(HashmapStringI64BackingTombstone)
            (HashmapStringI64BackingUpdateMissing map)])]
      [(HashmapStringI64BackingProbeAbsent _)
        (HashmapStringI64BackingUpdateMissing map)]
      [(HashmapStringI64BackingProbeFull)
        (HashmapStringI64BackingUpdateMissing map)])))

;: Owned-key wrapper for update-only mutation.
(define (hashmap-string-i64-backing-update-if-present
  [map : HashmapStringI64Backing]
  [key : String]
  [value : i64]) : HashmapStringI64BackingUpdateResult
  (stdlib.hashmap.hashmap-string-i64-backing-update-borrowed-if-present
    map
    (& key)
    value))

;: Remove borrowed `key` in place through a mutable map reference.
(define (hashmap-string-i64-backing-remove-borrowed!
  [map : (&mut map HashmapStringI64Backing)]
  [key : (& key str)]) : bool
  (let
    [slots : (&mut map (Array HashmapStringI64BackingSlot))
      (stdlib.hashmap.hashmap-string-i64-backing-slots-mut map)]
    [capacity : i64 (array-length slots)]
    (if (<= capacity 0)
      false
      (let
        [hash : i64 (hash_mod.string-key key)]
        [cursor : i64
          (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
            hash
            capacity)]
        [walked : i64 0]
        (begin
          (while (< walked capacity)
            (match (array-ref slots cursor)
              [(HashmapStringI64BackingEmpty) (return false)]
              [(HashmapStringI64BackingTombstone)
                (let
                  [next : i64 (+ cursor 1)]
                  (begin
                    (set!
                      cursor
                      (if (>= next capacity)
                        0
                        next))
                    (set! walked (+ walked 1))))]
              [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                (if (if (= slot-hash hash)
                  (hash_mod.key-string-eq? (& slot-key) key)
                  false)
                  (begin
                    (array-set! slots cursor (HashmapStringI64BackingTombstone))
                    (set! (struct-get map len) (- (struct-get map len) 1))
                    (set!
                      (struct-get map deleted)
                      (+ (struct-get map deleted) 1))
                    (return true))
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1)))))]))
          false)))))

;: Insert into a fresh destination table during rehash_mod. Source entries are
;: unique, and the destination has no tombstones, so only the first empty slot
;: matters.
(define (hashmap-string-i64-backing-insert-into-empty
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : String]
  [value : i64]
  [hash : i64]) : unit
  (if (<= capacity 0)
    unit
    (let
      [cursor : i64
        (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
          hash
          capacity)]
      [walked : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< walked capacity))
          (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
            slots
            cursor)
            [(HashmapStringI64BackingEmpty)
              (begin
                (array-set!
                  slots
                  cursor
                  (HashmapStringI64BackingOccupied key value hash))
                (set! done true))]
            [_
              (begin
                (set!
                  cursor
                  (stdlib.hashmap.hashmap-string-i64-backing-next-index
                    cursor
                    capacity))
                (set! walked (+ walked 1)))]))
        unit))))

;: Re-insert every live (occupied) entry of `src` slots `[index, count)` into
;: the fresh `dst` table (`dst-capacity` empty slots), dropping tombstones.
(define (hashmap-string-i64-backing-rehash-from
  [src : (Array HashmapStringI64BackingSlot)]
  [dst : (Array HashmapStringI64BackingSlot)]
  [dst-capacity : i64]
  [index : i64]
  [count : i64]) : unit
  (let
    [i : i64 index]
    (begin
      (while (< i count)
        (begin
          (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at src i)
            [(HashmapStringI64BackingOccupied key value hash)
              (stdlib.hashmap.hashmap-string-i64-backing-insert-into-empty
                dst
                dst-capacity
                key
                value
                hash)]
            [(HashmapStringI64BackingEmpty) unit]
            [(HashmapStringI64BackingTombstone) unit])
          (set! i (+ i 1))))
      unit)))

;: Borrowed-source variant used by in-place resize helpers.
(define (hashmap-string-i64-backing-rehash-from-ref
  [src : (& src (Array HashmapStringI64BackingSlot))]
  [dst : (Array HashmapStringI64BackingSlot)]
  [dst-capacity : i64]
  [index : i64]
  [count : i64]) : unit
  (let
    [i : i64 index]
    (begin
      (while (< i count)
        (begin
          (match (array-ref src i)
            [(HashmapStringI64BackingOccupied key value hash)
              (stdlib.hashmap.hashmap-string-i64-backing-insert-into-empty
                dst
                dst-capacity
                key
                value
                hash)]
            [(HashmapStringI64BackingEmpty) unit]
            [(HashmapStringI64BackingTombstone) unit])
          (set! i (+ i 1))))
      unit)))

;: Rebuild `map` as a fresh power-of-two table holding only its live entries
;: (tombstones dropped, so the deleted count resets to 0). The backing array is
;: newly allocated; the old one is reclaimed when the arena resets.
(define (hashmap-string-i64-backing-resized
  [map : HashmapStringI64Backing]
  [new-capacity : i64]) : HashmapStringI64Backing
  (let
    [src : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [old-capacity : i64 (array-length src)]
    [requested-capacity : i64
      (if (> (stdlib.hashmap.hashmap-string-i64-backing-len map) new-capacity)
        (stdlib.hashmap.hashmap-string-i64-backing-len map)
        new-capacity)]
    [rounded-capacity : i64
      (stdlib.hashmap.hashmap-string-i64-backing-round-capacity
        requested-capacity)]
    [dst : (Array HashmapStringI64BackingSlot)
      (array.make-array HashmapStringI64BackingSlot rounded-capacity)]
    (begin
      (stdlib.hashmap.hashmap-string-i64-backing-rehash-from
        src
        dst
        rounded-capacity
        0
        old-capacity)
      (set! (struct-get map slots) dst)
      (set! (struct-get map deleted) 0)
      map)))

;: Next capacity when growing: double, with a small floor so a tiny or empty
;: table grows to a useful size in one step.
(define (hashmap-string-i64-backing-grow-capacity [capacity : i64]) : i64
  (if (< capacity 4)
    8
    (* (stdlib.hashmap.hashmap-string-i64-backing-round-capacity capacity) 2)))

;: Grow `map` to the next capacity, rehashing its live entries.
(define (hashmap-string-i64-backing-grow [map : HashmapStringI64Backing]) : HashmapStringI64Backing
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    (stdlib.hashmap.hashmap-string-i64-backing-resized
      map
      (stdlib.hashmap.hashmap-string-i64-backing-grow-capacity
        (array-length slots)))))

;: True when the table has reached the 3/4 load threshold, counting both live
;: entries and tombstones (both consume probe positions). A non-positive
;: capacity always needs to grow before it can hold anything.
(define (hashmap-string-i64-backing-needs-grow? [map : HashmapStringI64Backing]) : bool
  (let
    [capacity : i64
      (array-length (stdlib.hashmap.hashmap-string-i64-backing-slots map))]
    [used : i64
      (+
        (stdlib.hashmap.hashmap-string-i64-backing-len map)
        (stdlib.hashmap.hashmap-string-i64-backing-deleted map))]
    (if (<= capacity 0)
      true
      (>= (* used 4) (* capacity 3)))))

;: Mutable-reference variant of `hashmap-string-i64-backing-needs-grow?`.
(define (hashmap-string-i64-backing-needs-grow-mut?
  [map : (&mut map HashmapStringI64Backing)]) : bool
  (let
    [capacity : i64 (array-length (struct-get map slots))]
    [used : i64 (+ (struct-get map len) (struct-get map deleted))]
    (if (<= capacity 0)
      true
      (>= (* used 4) (* capacity 3)))))

;: Insert or update `key` -> `value`, growing (rehashing) the table first when
;: it has reached the load threshold so insertion never fails. Returns the
;: updated map directly. Use this instead of `hashmap-string-i64-backing-insert` when the
;: map should grow on demand rather than report `Full`.
(define (hashmap-string-i64-backing-put
  [map : HashmapStringI64Backing]
  [key : String]
  [value : i64]) : HashmapStringI64Backing
  (let
    [grown : HashmapStringI64Backing
      (if (stdlib.hashmap.hashmap-string-i64-backing-needs-grow? map)
        (stdlib.hashmap.hashmap-string-i64-backing-grow map)
        map)]
    (match (stdlib.hashmap.hashmap-string-i64-backing-insert grown key value)
      [(HashmapStringI64BackingInsertOk updated) updated]
      [(HashmapStringI64BackingInsertFull full)
        ;; `needs-grow?` keeps a positive-capacity table below full; a leftover
        ;; `Full` (e.g. a capacity-0 seed) is handled by one more grow + retry.
        (match (stdlib.hashmap.hashmap-string-i64-backing-insert
          (stdlib.hashmap.hashmap-string-i64-backing-grow full)
          key
          value)
          [(HashmapStringI64BackingInsertOk u) u]
          [(HashmapStringI64BackingInsertFull u) u])])))

;: Resize `map` in place, dropping tombstones and preserving live entries.
(define (hashmap-string-i64-backing-resize!
  [map : (&mut map HashmapStringI64Backing)]
  [new-capacity : i64]) : unit
  (let
    [old-capacity : i64 (array-length (struct-get map slots))]
    [requested-capacity : i64
      (if (> (struct-get map len) new-capacity)
        (struct-get map len)
        new-capacity)]
    [rounded-capacity : i64
      (stdlib.hashmap.hashmap-string-i64-backing-round-capacity
        requested-capacity)]
    [dst : (Array HashmapStringI64BackingSlot)
      (array.make-array HashmapStringI64BackingSlot rounded-capacity)]
    (begin
      (stdlib.hashmap.hashmap-string-i64-backing-rehash-from-ref
        (& (struct-get map slots))
        dst
        rounded-capacity
        0
        old-capacity)
      (set! (struct-get map slots) dst)
      (set! (struct-get map deleted) 0))))

;: Grow `map` in place to the next table capacity.
(define (hashmap-string-i64-backing-grow!
  [map : (&mut map HashmapStringI64Backing)]) : unit
  (stdlib.hashmap.hashmap-string-i64-backing-resize!
    map
    (stdlib.hashmap.hashmap-string-i64-backing-grow-capacity
      (array-length (struct-get map slots)))))

;: Insert or update through a mutable map reference.
(define (hashmap-string-i64-backing-put!
  [map : (&mut map HashmapStringI64Backing)]
  [key : String]
  [value : i64]) : unit
  (begin
    (if (stdlib.hashmap.hashmap-string-i64-backing-needs-grow-mut? map)
      (stdlib.hashmap.hashmap-string-i64-backing-grow! map)
      unit)
    (let
      [slots : (&mut map (Array HashmapStringI64BackingSlot))
        (stdlib.hashmap.hashmap-string-i64-backing-slots-mut map)]
      [capacity : i64 (array-length slots)]
      [hash : i64 (hash_mod.string-key (& key))]
      (if (<= capacity 0)
        unit
        (let
          [cursor : i64
            (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
              hash
              capacity)]
          [walked : i64 0]
          [first : i64 -1]
          (begin
            (while (< walked capacity)
              (match (array-ref slots cursor)
                [(HashmapStringI64BackingEmpty)
                  (let
                    [index : i64
                      (if (>= first 0)
                        first
                        cursor)]
                    [reused-tombstone : bool (>= first 0)]
                    (begin
                      (array-set!
                        slots
                        index
                        (HashmapStringI64BackingOccupied key value hash))
                      (set! (struct-get map len) (+ (struct-get map len) 1))
                      (if reused-tombstone
                        (set!
                          (struct-get map deleted)
                          (- (struct-get map deleted) 1))
                        unit)
                      (return unit)))]
                [(HashmapStringI64BackingTombstone)
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (if (< first 0)
                        (set! first cursor)
                        unit)
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1))))]
                [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                  (if (if (= slot-hash hash)
                    (hash_mod.key-string-eq? (& slot-key) (& key))
                    false)
                    (begin
                      (array-set!
                        slots
                        cursor
                        (HashmapStringI64BackingTombstone))
                      (set! (struct-get map len) (- (struct-get map len) 1))
                      (set!
                        (struct-get map deleted)
                        (+ (struct-get map deleted) 1))
                      (set! first cursor)
                      (set! walked capacity))
                    (let
                      [next : i64 (+ cursor 1)]
                      (begin
                        (set!
                          cursor
                          (if (>= next capacity)
                            0
                            next))
                        (set! walked (+ walked 1)))))]))
            (if (>= first 0)
              (begin
                (array-set!
                  slots
                  first
                  (HashmapStringI64BackingOccupied key value hash))
                (set! (struct-get map len) (+ (struct-get map len) 1))
                (set! (struct-get map deleted) (- (struct-get map deleted) 1)))
              unit)))))))

;: Insert `key -> value` only when `key` is absent. Returns true for a new
;: insertion and false when the key already exists.
(define (hashmap-string-i64-backing-insert-if-absent!
  [map : (&mut map HashmapStringI64Backing)]
  [key : String]
  [value : i64]) : bool
  (begin
    (if (stdlib.hashmap.hashmap-string-i64-backing-needs-grow-mut? map)
      (stdlib.hashmap.hashmap-string-i64-backing-grow! map)
      unit)
    (let
      [slots : (&mut map (Array HashmapStringI64BackingSlot))
        (stdlib.hashmap.hashmap-string-i64-backing-slots-mut map)]
      [capacity : i64 (array-length slots)]
      [hash : i64 (hash_mod.string-key (& key))]
      (if (<= capacity 0)
        false
        (let
          [cursor : i64
            (stdlib.hashmap.hashmap-string-i64-backing-normalized-bucket-index
              hash
              capacity)]
          [walked : i64 0]
          [first : i64 -1]
          (begin
            (while (< walked capacity)
              (match (array-ref slots cursor)
                [(HashmapStringI64BackingEmpty)
                  (let
                    [index : i64
                      (if (>= first 0)
                        first
                        cursor)]
                    [reused-tombstone : bool (>= first 0)]
                    (begin
                      (array-set!
                        slots
                        index
                        (HashmapStringI64BackingOccupied key value hash))
                      (set! (struct-get map len) (+ (struct-get map len) 1))
                      (if reused-tombstone
                        (set!
                          (struct-get map deleted)
                          (- (struct-get map deleted) 1))
                        unit)
                      (return true)))]
                [(HashmapStringI64BackingTombstone)
                  (let
                    [next : i64 (+ cursor 1)]
                    (begin
                      (if (< first 0)
                        (set! first cursor)
                        unit)
                      (set!
                        cursor
                        (if (>= next capacity)
                          0
                          next))
                      (set! walked (+ walked 1))))]
                [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
                  (if (if (= slot-hash hash)
                    (hash_mod.key-string-eq? (& slot-key) (& key))
                    false)
                    (return false)
                    (let
                      [next : i64 (+ cursor 1)]
                      (begin
                        (set!
                          cursor
                          (if (>= next capacity)
                            0
                            next))
                        (set! walked (+ walked 1)))))]))
            (if (>= first 0)
              (begin
                (array-set!
                  slots
                  first
                  (HashmapStringI64BackingOccupied key value hash))
                (set! (struct-get map len) (+ (struct-get map len) 1))
                (set! (struct-get map deleted) (- (struct-get map deleted) 1))
                true)
              false)))))))

;: Insert `key -> value`, or update the existing key to `value`.
(define (hashmap-string-i64-backing-insert-or-update
  [map : HashmapStringI64Backing]
  [key : String]
  [value : i64]) : HashmapStringI64Backing
  (stdlib.hashmap.hashmap-string-i64-backing-put map key value))

;: Return the existing value for `key`, or insert `default-value` and return it.
;: This does not expose a live bucket handle; callers thread the returned map.
(define (hashmap-string-i64-backing-entry-or-insert
  [map : HashmapStringI64Backing]
  [key : String]
  [default-value : i64]) : HashmapStringI64BackingEntryOrInsertResult
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    [hash : i64 (hash_mod.string-key (& key))]
    (match (stdlib.hashmap.hashmap-string-i64-backing-probe-borrowed
      slots
      (stdlib.hashmap.hashmap-string-i64-backing-capacity map)
      (& key)
      hash)
      [(HashmapStringI64BackingProbeFound index)
        (match (array-ref slots index)
          [(HashmapStringI64BackingOccupied _ value _)
            (HashmapStringI64BackingEntryOrInsertFound map value)]
          [(HashmapStringI64BackingEmpty)
            (let
              [updated : HashmapStringI64Backing
                (stdlib.hashmap.hashmap-string-i64-backing-put
                  map
                  key
                  default-value)]
              (HashmapStringI64BackingEntryOrInsertInserted
                updated
                default-value))]
          [(HashmapStringI64BackingTombstone)
            (let
              [updated : HashmapStringI64Backing
                (stdlib.hashmap.hashmap-string-i64-backing-put
                  map
                  key
                  default-value)]
              (HashmapStringI64BackingEntryOrInsertInserted
                updated
                default-value))])]
      [(HashmapStringI64BackingProbeAbsent _)
        (let
          [updated : HashmapStringI64Backing
            (stdlib.hashmap.hashmap-string-i64-backing-put
              map
              key
              default-value)]
          (HashmapStringI64BackingEntryOrInsertInserted updated default-value))]
      [(HashmapStringI64BackingProbeFull)
        (let
          [updated : HashmapStringI64Backing
            (stdlib.hashmap.hashmap-string-i64-backing-put
              map
              key
              default-value)]
          (HashmapStringI64BackingEntryOrInsertInserted updated default-value))])))

;: Probe for a borrowed key and return the immutable information needed to
;: construct a live mutable-entry handle. This helper does not borrow the map.
(define (hashmap-string-i64-backing-mut-entry-info
  [slots : (Array HashmapStringI64BackingSlot)]
  [capacity : i64]
  [key : (& key str)]) : HashmapStringI64BackingMutEntryInfo
  (if (<= capacity 0)
    (HashmapStringI64BackingMutEntryInfo -1 false "" 0)
    (let
      [hash : i64 (hash_mod.string-key key)]
      [cursor : i64
        (stdlib.hashmap.hashmap-string-i64-backing-bucket-index hash capacity)]
      [walked : i64 0]
      [found : i64 -1]
      [present : bool false]
      [entry-key : String ""]
      [entry-hash : i64 0]
      [done : bool false]
      (begin
        (while (and (< walked capacity) (not done))
          (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at
            slots
            cursor)
            [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
              (if (if (= slot-hash hash)
                (hash_mod.key-string-eq? (& slot-key) key)
                false)
                (begin
                  (set! found cursor)
                  (set! present true)
                  (set! entry-key slot-key)
                  (set! entry-hash slot-hash)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (stdlib.hashmap.hashmap-string-i64-backing-next-index
                      cursor
                      capacity))
                  (set! walked (+ walked 1))))]
            [(HashmapStringI64BackingEmpty) (set! done true)]
            [(HashmapStringI64BackingTombstone)
              (begin
                (set!
                  cursor
                  (stdlib.hashmap.hashmap-string-i64-backing-next-index
                    cursor
                    capacity))
                (set! walked (+ walked 1)))]))
        (HashmapStringI64BackingMutEntryInfo found present entry-key entry-hash)))))

;: Mutable-array variant of `hashmap-string-i64-backing-mut-entry-info` for wrapper APIs.
(define (hashmap-string-i64-backing-mut-entry-info-mut
  [slots : (&mut slots (Array HashmapStringI64BackingSlot))]
  [capacity : i64]
  [key : (& key str)]) : HashmapStringI64BackingMutEntryInfo
  (if (<= capacity 0)
    (HashmapStringI64BackingMutEntryInfo -1 false "" 0)
    (let
      [hash : i64 (hash_mod.string-key key)]
      [cursor : i64
        (stdlib.hashmap.hashmap-string-i64-backing-bucket-index hash capacity)]
      [walked : i64 0]
      [found : i64 -1]
      [present : bool false]
      [entry-key : String ""]
      [entry-hash : i64 0]
      [done : bool false]
      (begin
        (while (and (< walked capacity) (not done))
          (match (array-ref slots cursor)
            [(HashmapStringI64BackingOccupied slot-key _ slot-hash)
              (if (if (= slot-hash hash)
                (hash_mod.key-string-eq? (& slot-key) key)
                false)
                (begin
                  (set! found cursor)
                  (set! present true)
                  (set! entry-key slot-key)
                  (set! entry-hash slot-hash)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (stdlib.hashmap.hashmap-string-i64-backing-next-index
                      cursor
                      capacity))
                  (set! walked (+ walked 1))))]
            [(HashmapStringI64BackingEmpty) (set! done true)]
            [(HashmapStringI64BackingTombstone)
              (begin
                (set!
                  cursor
                  (stdlib.hashmap.hashmap-string-i64-backing-next-index
                    cursor
                    capacity))
                (set! walked (+ walked 1)))]))
        (HashmapStringI64BackingMutEntryInfo found present entry-key entry-hash)))))

;: Combine direct slot access, a live mutable slots borrow, and probe metadata
;: into a mutable-entry handle tied to the map borrow lifetime.
(define (hashmap-string-i64-backing-mut-entry-from-info
  [info : HashmapStringI64BackingMutEntryInfo]
  [borrow : (&mut map (Array HashmapStringI64BackingSlot))]) : (HashmapStringI64BackingMutEntry
    map)
  (HashmapStringI64BackingMutEntry
    borrow
    (struct-get info index)
    (struct-get info present)
    (struct-get info key)
    (struct-get info hash)))

;: Borrow `map` mutably and return a live mutable entry for borrowed `key`.
;: The handle can update an existing entry in place; missing entries are
;: reported as absent and are not inserted by the handle API.
(defmacro (hashmap-string-i64-backing-get-mut-entry-borrowed
  [map : Expr]
  [key : Expr]) : Expr
  `(hashmap-string-i64-backing-mut-entry-from-info
    (hashmap-string-i64-backing-mut-entry-info
      (struct-get ,map slots)
      (array-length (struct-get ,map slots))
      ,key)
    (&mut (struct-get ,map slots))))

;: Borrow `map` mutably and return a live mutable entry for borrowed `key`.
(define (hashmap-string-i64-backing-get-mut-entry-borrowed!
  [map : (&mut map HashmapStringI64Backing)]
  [key : (& key str)]) : (HashmapStringI64BackingMutEntry map)
  (let
    [slots : (&mut map (Array HashmapStringI64BackingSlot))
      (stdlib.hashmap.hashmap-string-i64-backing-slots-mut map)]
    (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-from-info
      (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-info-mut
        slots
        (array-length slots)
        key)
      slots)))

;: Return whether a mutable-entry handle currently points at an occupied slot.
(define (hashmap-string-i64-backing-mut-entry-present?
  [entry : (HashmapStringI64BackingMutEntry map)]) : bool
  (struct-get entry present))

;: Return the handle's current value when present, otherwise `fallback`.
(define (hashmap-string-i64-backing-mut-entry-value-or
  [entry : (HashmapStringI64BackingMutEntry map)]
  [fallback : i64]) : i64
  (if (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-present? entry)
    (match (array-ref (struct-get entry borrow) (struct-get entry index))
      [(HashmapStringI64BackingOccupied _ value _) value]
      [(HashmapStringI64BackingEmpty) fallback]
      [(HashmapStringI64BackingTombstone) fallback])
    fallback))

;: Update the handle's occupied slot in place. Missing-entry handles are a no-op.
(define (hashmap-string-i64-backing-mut-entry-set!
  [entry : (HashmapStringI64BackingMutEntry map)]
  [value : i64]) : unit
  (if (stdlib.hashmap.hashmap-string-i64-backing-mut-entry-present? entry)
    (array-set!
      (struct-get entry borrow)
      (struct-get entry index)
      (HashmapStringI64BackingOccupied
        (struct-get entry key)
        value
        (struct-get entry hash)))
    unit))

;: A single iteration step: an occupied entry (its key and value) or none.
;: `hashmap-string-i64-backing-entry-at` returns `None` for an empty slot, a tombstone, or
;: an out-of-range index, and `Some` for a live entry.
(defenum HashmapStringI64BackingEntry
  (HashmapStringI64BackingEntryNone)
  (HashmapStringI64BackingEntrySome String i64))

;: Scan `slots` from `index` forward for the first occupied slot, returning its
;: index or `capacity` when none remains. Bounded by `capacity` (the array
;: length), so it always terminates.
(define (hashmap-string-i64-backing-next-occupied-from
  [slots : (Array HashmapStringI64BackingSlot)]
  [index : i64]
  [capacity : i64]) : i64
  (let
    [i : i64 index]
    (begin
      (while (< i capacity)
        (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at slots i)
          [(HashmapStringI64BackingOccupied _ _ _) (return i)]
          [(HashmapStringI64BackingEmpty) (set! i (+ i 1))]
          [(HashmapStringI64BackingTombstone) (set! i (+ i 1))]))
      capacity)))

;: Iteration cursor: the index of the first occupied slot at or after `from`
;: (in ascending bucket order), or the capacity when no live entry remains.
;: A negative `from` is clamped to 0.
;:
;: v1 iterates in *bucket order* - ascending slot index, skipping empty and
;: tombstone slots. This order is deterministic for a fixed table state but is
;: NOT insertion order, and it can change across a resize/rehash. Walk
;: live entries by starting at `(hashmap-string-i64-backing-next-occupied map 0)` and
;: advancing with `(hashmap-string-i64-backing-next-occupied map (+ index 1))` until the
;: cursor reaches the capacity, reading each entry with
;: `hashmap-string-i64-backing-entry-at`. Do not insert into or remove from the map during
;: a walk: a resize rebuilds the slot array and invalidates live indices.
;:
;: ```typelisp
;: (import stdlib.hashmap)
;: (define (main) : i64
;:   (let
;:     [m : hashmap.HashmapStringI64Backing
;:       (hashmap.hashmap-string-i64-backing-put
;:         (hashmap.hashmap-string-i64-backing-with-capacity 8)
;:         "k"
;:         42)]
;:     (hashmap.hashmap-string-i64-backing-next-occupied m 0)))
;: ```
(define (hashmap-string-i64-backing-next-occupied
  [map : HashmapStringI64Backing]
  [from : i64]) : i64
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    (stdlib.hashmap.hashmap-string-i64-backing-next-occupied-from
      slots
      (if (< from 0)
        0
        from)
      (array-length slots))))

;: The live entry at `index`, or `None` for an empty slot, a tombstone, or an
;: index outside `[0, capacity)`. Pair with `hashmap-string-i64-backing-next-occupied` to
;: walk the map in bucket order. The key is handed back by value; v1 does not
;: yet enforce that the borrow outlives the map.
(define (hashmap-string-i64-backing-entry-at
  [map : HashmapStringI64Backing]
  [index : i64]) : HashmapStringI64BackingEntry
  (let
    [slots : (Array HashmapStringI64BackingSlot)
      (stdlib.hashmap.hashmap-string-i64-backing-slots map)]
    (if (if (< index 0)
      true
      (>= index (array-length slots)))
      (HashmapStringI64BackingEntryNone)
      (match (stdlib.hashmap.hashmap-string-i64-backing-slot-at slots index)
        [(HashmapStringI64BackingOccupied key value _)
          (HashmapStringI64BackingEntrySome key value)]
        [(HashmapStringI64BackingEmpty) (HashmapStringI64BackingEntryNone)]
        [(HashmapStringI64BackingTombstone) (HashmapStringI64BackingEntryNone)]))))

;: Reference variant of `hashmap-string-i64-backing-next-occupied`.
(define (hashmap-string-i64-backing-next-occupied-ref
  [map : (& map HashmapStringI64Backing)]
  [from : i64]) : i64
  (let
    [capacity : i64 (array-length (struct-get map slots))]
    [index : i64
      (if (< from 0)
        0
        from)]
    (begin
      (while (< index capacity)
        (match (array-ref (struct-get map slots) index)
          [(HashmapStringI64BackingOccupied _ _ _) (return index)]
          [(HashmapStringI64BackingEmpty) (set! index (+ index 1))]
          [(HashmapStringI64BackingTombstone) (set! index (+ index 1))]))
      capacity)))

;: Reference variant of `hashmap-string-i64-backing-entry-at`.
(define (hashmap-string-i64-backing-entry-at-ref
  [map : (& map HashmapStringI64Backing)]
  [index : i64]) : HashmapStringI64BackingEntry
  (if (if (< index 0)
    true
    (>= index (array-length (struct-get map slots))))
    (HashmapStringI64BackingEntryNone)
    (match (array-ref (struct-get map slots) index)
      [(HashmapStringI64BackingOccupied key value _)
        (HashmapStringI64BackingEntrySome (string.copy (& key)) value)]
      [(HashmapStringI64BackingEmpty) (HashmapStringI64BackingEntryNone)]
      [(HashmapStringI64BackingTombstone) (HashmapStringI64BackingEntryNone)])))

;: Checked-in `HashmapStringStringBacking` base family.
(defenum HashmapStringStringBackingSlot
  (HashmapStringStringBackingEmpty)
  (HashmapStringStringBackingTombstone)
  (HashmapStringStringBackingOccupied String String i64))

;: Generated concrete hashmap family helper.
(defenum HashmapStringStringBackingProbe
  (HashmapStringStringBackingProbeFound i64)
  (HashmapStringStringBackingProbeAbsent i64)
  (HashmapStringStringBackingProbeFull))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-hash-normalize [value : i64]) : i64
  (let
    [m : i64 2147483647]
    [raw : i64 (% value 2147483647)]
    (if (< raw 0)
      (+ raw m)
      raw)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-hash-key [key : (& key str)]) : i64
  (let
    [n : i64 (__tl_string_length key)]
    [i : i64 0]
    [hash : i64 0]
    (begin
      (while (< i n)
        (begin
          (set!
            hash
            (%
              (+ (+ (* hash 131) (cast (__tl_string_ref key i) : i64)) 1)
              2147483647))
          (set! i (+ i 1))))
      hash)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-power-two-capacity? [capacity : i64]) : bool
  (if (> capacity 0)
    (= (bit-and capacity (- capacity 1)) 0)
    false))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-round-capacity [capacity : i64]) : i64
  (let
    [rounded : i64 1]
    (begin
      (while (< rounded capacity)
        (set! rounded (* rounded 2)))
      rounded)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-normalized-bucket-index
  [hash : i64]
  [capacity : i64]) : i64
  (bit-and hash (- capacity 1)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-bucket-index
  [hash : i64]
  [capacity : i64]) : i64
  (hashmap-string-string-backing-normalized-bucket-index
    (hashmap-string-string-backing-hash-normalize hash)
    capacity))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-next-index
  [index : i64]
  [capacity : i64]) : i64
  (let
    [next : i64 (+ index 1)]
    (if (>= next capacity)
      0
      next)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-insert-slot
  [first-tombstone : i64]
  [empty-index : i64]) : i64
  (if (>= first-tombstone 0)
    first-tombstone
    empty-index))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-key-eq?
  [left : (& left str)]
  [right : (& right str)]) : bool
  (__tl_string_eq left right))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-probe-borrowed-from
  [slots : (Array HashmapStringStringBackingSlot)]
  [capacity : i64]
  [key : (& key str)]
  [hash : i64]
  [index : i64]
  [steps : i64]
  [first-tombstone : i64]) : HashmapStringStringBackingProbe
  (let
    [cursor : i64 index]
    [walked : i64 steps]
    [first : i64 first-tombstone]
    (begin
      (while (< walked capacity)
        (match (array-ref slots cursor)
          [(HashmapStringStringBackingEmpty)
            (return
              (HashmapStringStringBackingProbeAbsent
                (hashmap-string-string-backing-insert-slot first cursor)))]
          [(HashmapStringStringBackingTombstone)
            (let
              [next : i64 (+ cursor 1)]
              (begin
                (if (< first 0)
                  (set! first cursor)
                  unit)
                (set!
                  cursor
                  (if (>= next capacity)
                    0
                    next))
                (set! walked (+ walked 1))))]
          [(HashmapStringStringBackingOccupied slot-key _ slot-hash)
            (if (if (= slot-hash hash)
              (hashmap-string-string-backing-key-eq? (& slot-key) key)
              false)
              (return (HashmapStringStringBackingProbeFound cursor))
              (let
                [next : i64 (+ cursor 1)]
                (begin
                  (set!
                    cursor
                    (if (>= next capacity)
                      0
                      next))
                  (set! walked (+ walked 1)))))]))
      (if (>= first 0)
        (HashmapStringStringBackingProbeAbsent first)
        (HashmapStringStringBackingProbeFull)))))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-probe-borrowed
  [slots : (Array HashmapStringStringBackingSlot)]
  [capacity : i64]
  [key : (& key str)]
  [hash : i64]) : HashmapStringStringBackingProbe
  (if (<= capacity 0)
    (HashmapStringStringBackingProbeFull)
    (hashmap-string-string-backing-probe-borrowed-from
      slots
      capacity
      key
      hash
      (hashmap-string-string-backing-normalized-bucket-index hash capacity)
      0
      -1)))

;: Generated concrete hashmap family helper.
(define (hashmap-string-string-backing-probe
  [slots : (Array HashmapStringStringBackingSlot)]
  [capacity : i64]
  [key : String]
  [hash : i64]) : HashmapStringStringBackingProbe
  (hashmap-string-string-backing-probe-borrowed slots capacity (& key) hash))

;: Generated concrete hashmap family helper.
(defstruct HashmapStringStringBacking
  (slots (Array HashmapStringStringBackingSlot))
  (len i64)
  (deleted i64))

;: Generated concrete hashmap family helper.
(defenum HashmapStringStringBackingLookup
  (HashmapStringStringBackingMissing)
  (HashmapStringStringBackingFound String))

;: Generated concrete hashmap family helper.
(defenum HashmapStringStringBackingBorrowedValueLookup
  (:lifetimes map)
