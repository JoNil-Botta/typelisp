      [(HashmapI64I64BackingTombstone) (HashmapI64I64BackingEntryNone)])))

;: Probe mutable i64 -> i64 slots and return mutable-entry metadata.
(define (hashmap-i64-i64-backing-mut-entry-info-mut
  [slots : (&mut slots (Array HashmapI64I64BackingSlot))]
  [capacity : i64]
  [key : i64]) : HashmapI64I64BackingMutEntryInfo
  (if (<= capacity 0)
    (HashmapI64I64BackingMutEntryInfo -1 false 0 0)
    (let
      [hash : i64 (hashmap-i64-i64-backing-hash-key key)]
      [cursor : i64 (hashmap-i64-i64-backing-bucket-index hash capacity)]
      [walked : i64 0]
      [found : i64 -1]
      [present : bool false]
      [entry-key : i64 0]
      [entry-hash : i64 0]
      [done : bool false]
      (begin
        (while (if (< walked capacity)
          (not done)
          false)
          (match (array-ref slots cursor)
            [(HashmapI64I64BackingOccupied slot-key _ slot-hash)
              (if (if (= slot-hash hash)
                (= slot-key key)
                false)
                (begin
                  (set! found cursor)
                  (set! present true)
                  (set! entry-key slot-key)
                  (set! entry-hash slot-hash)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (hashmap-i64-i64-backing-next-index cursor capacity))
                  (set! walked (+ walked 1))))]
            [(HashmapI64I64BackingEmpty) (set! done true)]
            [(HashmapI64I64BackingTombstone)
              (begin
                (set!
                  cursor
                  (hashmap-i64-i64-backing-next-index cursor capacity))
                (set! walked (+ walked 1)))]))
        (HashmapI64I64BackingMutEntryInfo found present entry-key entry-hash)))))

;: Borrow i64 -> i64 slots mutably and return a wrapper mutable entry.
(define (hashmap-i64-i64-backing-get-mut-entry!
  [map : (&mut map HashmapI64I64Backing)]
  [key : i64]) : (HashmapI64I64BackingMutEntryRef map)
  (let
    [slots : (&mut map (Array HashmapI64I64BackingSlot))
