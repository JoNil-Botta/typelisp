              (define (entry-value-or [entry : Entry] [fallback : ,V]) : ,V
                (match entry
                  [(EntrySome _ value) value]
                  [(EntryNone) fallback])))]
          [_
            `(begin
              (module ,module-name)
              (import stdlib.comptime))])]
      [_
        (match (type-key K)
          ["struct_stdlib.hashmap/HashNestedKey"
            (match (type-key V)
              ["i64"
                `(begin
                  (module ,module-name)
                  (import stdlib.hashmap as base)
