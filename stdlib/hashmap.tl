                        (if (>= first 0)
                          first
                          cursor)]
                      [reused-tombstone : bool (>= first 0)]
                      (begin
                        (array-set!
                          slots
                          index
                          (HashmapStringStringBackingOccupied key value hash))
                        (set! (struct-get map len) (+ (struct-get map len) 1))
                        (if reused-tombstone
