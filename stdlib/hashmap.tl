;; Fill every slot of an `n`-length array with `HashmapStringI64BackingEmpty`.
(cfg
  test
  (define (fill-empty [slots : (Array HashmapStringI64BackingSlot)] [n : i64]) : (Array
      HashmapStringI64BackingSlot)
    (let
      [i : i64 0]
      (begin
        (while (< i n)
          (begin
            (array-set! slots i (HashmapStringI64BackingEmpty))
            (set! i (+ i 1))))
        slots))))

