        [cursor : i64
          (i64-hash-state-map-normalized-bucket-index hash capacity)]
        [walked : i64 0]
        [done : bool false]
        (begin
          (while (if done
            false
            (< walked capacity))
            (match (array-ref slots cursor)
              [(I64HashStateMapEmpty)
                (begin
                  (array-set!
                    slots
                    cursor
                    (I64HashStateMapOccupied key value hash))
                  (set! done true))]
              [_
                (begin
                  (set! cursor (i64-hash-state-map-next-index cursor capacity))
                  (set! walked (+ walked 1)))]))
          unit)))))

