                            0
                            next))
                        (set! walked (+ walked 1))))]
                  [(HashmapStringStringBackingOccupied slot-key _ slot-hash)
                    (if (if (= slot-hash hash)
                      (hashmap-string-string-backing-key-eq?
                        (& slot-key)
                        (& key))
                      false)
                      (begin
                        (array-set!
                          slots
                          cursor
                          (HashmapStringStringBackingOccupied key value hash))
                        (return unit))
                      (let
                        [next : i64 (+ cursor 1)]
                        (begin
                          (set!
                            cursor
                            (if (>= next capacity)
                              0
                              next))
                          (set! walked (+ walked 1)))))]))
