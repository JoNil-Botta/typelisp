;; Inline test coverage.
(cfg test (import stdlib.test))

(cfg
  test
  (define (hashmap-test-assert-owned-string-eq
    [actual : String]
    [expected : String]
    [message : String]) : unit
    (test.assert-string-eq (& actual) (& expected) message)))

(cfg
  test
  (defstruct HashPayload
    (score i64)
    (weight i64)))

(cfg
  test
  (defenum HashState
    (HashReady i64)
    (HashFailed)
    (HashPaused i64)))

(cfg
  test
  (defstruct HashPoint
    (x i64)
