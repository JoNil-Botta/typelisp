;; Iteration walkers (deterministic bucket order). No first-class
;; functions yet, so each walk is its own tail-recursive helper started at
;; `(stdlib.hashmap.hashmap-string-i64-backing-next-occupied m 0)` and advanced with the cursor.
;; Number of live entries the cursor visits (should equal the map's len).
(cfg
  test
  (define (iter-count [m : HashmapStringI64Backing] [i : i64] [acc : i64]) : i64
    (if (>= i (stdlib.hashmap.hashmap-string-i64-backing-capacity m))
      acc
      (stdlib.hashmap.iter-count
        m
        (stdlib.hashmap.hashmap-string-i64-backing-next-occupied m (+ i 1))
        (+ acc 1)))))

;; Sum of every live value, visiting entries once in bucket order.
(cfg
  test
  (define (iter-sum-values [m : HashmapStringI64Backing] [i : i64] [acc : i64]) : i64
    (if (>= i (stdlib.hashmap.hashmap-string-i64-backing-capacity m))
      acc
      (stdlib.hashmap.iter-sum-values
        m
        (stdlib.hashmap.hashmap-string-i64-backing-next-occupied m (+ i 1))
        (match (stdlib.hashmap.hashmap-string-i64-backing-entry-at m i)
          [(HashmapStringI64BackingEntrySome _ v) (+ acc v)]
          [(HashmapStringI64BackingEntryNone) acc])))))

;; True when the cursor visits strictly increasing indices: bucket order is
;; deterministic and monotonic, so each next index exceeds the current one.
(cfg
  test
  (define (iter-monotonic? [m : HashmapStringI64Backing] [i : i64]) : bool
    (if (>= i (stdlib.hashmap.hashmap-string-i64-backing-capacity m))
      true
      (let
        [nxt : i64
          (stdlib.hashmap.hashmap-string-i64-backing-next-occupied m (+ i 1))]
        (if (> nxt i)
          (stdlib.hashmap.iter-monotonic? m nxt)
          false)))))

