;# Generated hashmap modules (collections v1).
;#
;# Open-addressed, linear-probing maps generated by `(hashmap K V)` imports.
;# Scalar modules delegate to checked-in backing records in this file so each
;# import does not materialize another full implementation. Those backing
;# declarations are implementation details; user code should use the generated
;# module's `Map`, readers, and bang mutators. String-key maps use the same
;# string hash and equality rules as `hash.string-key`; i64-key maps normalize
;# the scalar key directly and compare with `=`.
;#
;# Public constructors and resizing round capacities up to a positive power of
;# two, so bucket selection is a mask instead of a modulo in the hot path.
;# Probing wraps with a branch. Each occupied slot caches its key hash so probing
;# compares the cheap `i64` hash before the full key comparison. The probe visits
;# at most `capacity` slots, so a full table terminates instead of looping
;# forever.
;# `make-array` default-initializes every slot to the `Empty` tag, so fresh slot
;# arrays need no explicit fill pass.
;#
;# Usage: `(import stdlib.hashmap)`
;#
;# Generic source syntax such as `HashMap<K,V>` is intentionally not exposed
;# yet; TypeLisp uses stdlib module macros instead of source-level generics or
;# traits. These maps are the stdlib choice for ordinary program data keyed by
;# `String` or `i64`; compiler-internal symbol tables may keep using specialized
;# maps when their value domain or lifecycle is tighter than a public stdlib
;# collection.
;#
;# Generated modules cover `String` and `i64` keys plus the aggregate fixture
;# families used by inline tests. String-key maps support borrowed key
;# lookup/contains/remove wrappers and borrowed value lookup results tied to the
;# map lifetime. i64-key maps use scalar keys directly and still expose borrowed
;# value lookup. Aggregate fixture keys derive deterministic hash/equality from
;# declaration-order struct fields or enum variant tag plus declaration-order
;# payloads for supported members (`i64`, `bool`, `char`, `String`, and nested
;# supported nominal aggregates).
;#
;# ```typelisp
;# (import stdlib.hashmap)
;# (import (hashmap String i64) as map)
;# (define (main) : i64
;#   (let
;#     [m : map.Map (map.new)]
;#     (begin
;#       (map.insert! m "k" 42)
;#       (map.lookup-value-or (map.get (& m) "k") 0))))
;# ```
(import stdlib.array)
(import stdlib.comptime)
(import stdlib.hash as hash_mod)

;; lint-allow: unused-import
(import stdlib.string)

;: Stable descriptor identity for generated `String`-key hashmap families.
(define (string-key-descriptor-key) : String
  "stdlib/hashmap/string-key-v1")

;: Stable descriptor identity for generated `i64`-key hashmap families.
(define (i64-key-descriptor-key) : String
  "stdlib/hashmap/i64-key-v1")

;: Stable descriptor identity for generated nominal aggregate-key hashmap families.
(define (aggregate-key-descriptor-key) : String
  "stdlib/hashmap/aggregate-key-v1")

;: Emit the module-shaped hashmap surface for supported key/value pairs.
;:
;: Scalar modules delegate to checked-in backing implementations while
;: presenting `&` readers and public bang place macros backed by explicit
;: `&mut` `*-ref!` helpers.
(defmacro (hashmap [K : type] [V : type]) : Module
  (let
    [module-key-k : String
      (match (type-key K)
        ["struct_stdlib.hashmap/HashNestedKey"
          "struct_stdlib.hashmap.HashNestedKey"]
        [_ (type-key K)])]
    [module-key-v : String
      (match (type-key V)
        ["struct_stdlib.hashmap/HashPayload"
          "struct_stdlib.hashmap.HashPayload"]
        ["enum_stdlib.hashmap/HashState" "enum_stdlib.hashmap.HashState"]
        [_ (type-key V)])]
    [module-name-text : String
      (comptime.string-append
        "stdlib.hashmap.generated."
        (comptime.string-append
          module-key-k
          (comptime.string-append "." module-key-v)))]
    [module-name : comptime.Expr (comptime.expr-var module-name-text)]
    [insert-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".insert-ref!"))]
    [insert-or-update-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".insert-or-update-ref!"))]
    [insert-if-absent-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".insert-if-absent-ref!"))]
    [remove-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".remove-ref!"))]
    [remove-borrowed-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".remove-borrowed-ref!"))]
    [entry-or-insert-helper-name : comptime.Expr
      (comptime.expr-string
        (comptime.string-append module-name-text ".entry-or-insert-ref!"))]
    ;; Each concrete module already imports its runtime backing implementation.
    ;; Its bang macros use direct CTFE helper aliases, avoiding a second
    ;; generated-module materialization of stdlib.comptime.
    (match (type-key K)
      ["String"
        (match (type-key V)
          ["i64"
            `(begin
              (module ,module-name)
              (import stdlib.array as array_ops)
              (import stdlib.hashmap as base)
              (defstruct Map
                (inner base.HashmapStringI64Backing))
              (defenum Lookup
                (LookupMissing)
                (LookupFound i64))
              (defenum BorrowedValueLookup
                (:lifetimes map)
                (BorrowedValueMissing)
                (BorrowedValueFound (& map i64)))
              (defenum RemoveResult
                (RemoveOk)
                (RemoveMissing))
              (defenum EntryOrInsertResult
                (EntryOrInsertFound i64)
                (EntryOrInsertInserted i64))
              (defstruct MutEntry
                (:lifetimes map)
                (inner (base.HashmapStringI64BackingMutEntry map)))
              (defenum Entry
                (EntryNone)
                (EntrySome String i64))
              (define (with-capacity [capacity : i64]) : Map
                (Map (base.hashmap-string-i64-backing-with-capacity capacity)))
              (define (new) : Map
                (with-capacity 4))
              (define (len [map : (& map Map)]) : i64
                (struct-get (struct-get map inner) len))
              (define (capacity [map : (& map Map)]) : i64
                (array_ops.length (struct-get (struct-get map inner) slots)))
              (define (deleted [map : (& map Map)]) : i64
                (struct-get (struct-get map inner) deleted))
              (define (inner-mut [map : (&mut map Map)]) : (&mut
                  map
                  base.HashmapStringI64Backing)
                (&mut (struct-get map inner)))
              (define (is-empty? [map : (& map Map)]) : bool
                (<= (len map) 0))
              (define (lookup-from-base
                [lookup : base.HashmapStringI64BackingLookup]) : Lookup
                (match lookup
                  [(base.HashmapStringI64BackingFound value)
                    (LookupFound value)]
                  [(base.HashmapStringI64BackingMissing) (LookupMissing)]))
              (define (get-borrowed [map : (& map Map)] [key : (& key str)]) : Lookup
                (lookup-from-base
                  (base.hashmap-string-i64-backing-get-borrowed-ref
                    (& (struct-get map inner))
                    key)))
              (define (get [map : (& map Map)] [key : String]) : Lookup
                (get-borrowed map (& key)))
              (define (lookup-value-or [lookup : Lookup] [fallback : i64]) : i64
                (match lookup
                  [(LookupFound value) value]
                  [(LookupMissing) fallback]))
              (define (borrowed-value-missing [_map : (& map Map)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueMissing))
              (define (borrowed-value-found [value : (& map i64)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueFound value))
              (define (get-value-borrowed
                [map : (& map Map)]
                [key : (& key str)]) : (BorrowedValueLookup map)
                (match (base.hashmap-string-i64-backing-get-value-borrowed
                  (& (struct-get map inner))
                  key)
                  [(base.HashmapStringI64BackingBorrowedValueFound value)
                    (borrowed-value-found value)]
                  [(base.HashmapStringI64BackingBorrowedValueMissing)
                    (borrowed-value-missing map)]))
              (define (borrowed-value-found?
                [lookup : (BorrowedValueLookup map)]) : bool
                (match lookup
                  [(BorrowedValueFound _) true]
                  [(BorrowedValueMissing) false]))
              (define (contains-borrowed?
                [map : (& map Map)]
                [key : (& key str)]) : bool
                (base.hashmap-string-i64-backing-contains-borrowed-ref?
                  (& (struct-get map inner))
                  key))
              (define (contains? [map : (& map Map)] [key : String]) : bool
                (contains-borrowed? map (& key)))
              (define (insert-ref!
                [map : (&mut map Map)]
                [key : String]
                [value : i64]) : unit
                (base.hashmap-string-i64-backing-put! (inner-mut map) key value))
              (define (insert-or-update-ref!
                [map : (&mut map Map)]
                [key : String]
                [value : i64]) : unit
                (insert-ref! map key value))
              (define (insert-if-absent-ref!
                [map : (&mut map Map)]
                [key : String]
                [value : i64]) : bool
                (base.hashmap-string-i64-backing-insert-if-absent!
                  (&mut (struct-get map inner))
                  key
                  value))
              (defmacro (insert-if-absent!
                [place : Expr]
                [key : Expr]
                [value : Expr]) : bool
                (expr-mut-call2
                  (expr-var ,insert-if-absent-helper-name)
                  place
                  key
                  value))
              (define (remove-borrowed-ref!
                [map : (&mut map Map)]
                [key : (& key str)]) : RemoveResult
                (if (base.hashmap-string-i64-backing-remove-borrowed!
                  (inner-mut map)
                  key)
                  (RemoveOk)
                  (RemoveMissing)))
              (defmacro (remove-borrowed! [place : Expr] [key : Expr]) : RemoveResult
                (expr-mut-call1
                  (expr-var ,remove-borrowed-helper-name)
                  place
                  key))
              (define (remove-ref! [map : (&mut map Map)] [key : String]) : RemoveResult
                (remove-borrowed-ref! map (& key)))
              (define (remove-ok? [result : RemoveResult]) : bool
                (match result
                  [(RemoveOk) true]
                  [(RemoveMissing) false]))
              (define (entry-or-insert-ref!
                [map : (&mut map Map)]
                [key : String]
                [default-value : i64]) : EntryOrInsertResult
                (let
                  [present : bool
                    (base.hashmap-string-i64-backing-contains-borrowed-mut?
                      (inner-mut map)
                      (& key))]
                  (if present
                    (EntryOrInsertFound
                      (lookup-value-or
                        (lookup-from-base
                          (base.hashmap-string-i64-backing-get-borrowed-mut
                            (inner-mut map)
                            (& key)))
                        default-value))
                    (begin
                      (insert-ref! map key default-value)
                      (EntryOrInsertInserted default-value)))))
              (defmacro (insert! [place : Expr] [key : Expr] [value : Expr]) : unit
                (expr-mut-call2 (expr-var ,insert-helper-name) place key value))
              (defmacro (insert-or-update!
                [place : Expr]
                [key : Expr]
                [value : Expr]) : unit
                (expr-mut-call2
                  (expr-var ,insert-or-update-helper-name)
                  place
                  key
                  value))
              (defmacro (remove! [place : Expr] [key : Expr]) : RemoveResult
                (expr-mut-call1 (expr-var ,remove-helper-name) place key))
              (defmacro (entry-or-insert!
                [place : Expr]
                [key : Expr]
                [default-value : Expr]) : EntryOrInsertResult
                (expr-mut-call2
                  (expr-var ,entry-or-insert-helper-name)
                  place
                  key
                  default-value))
              (define (entry-or-insert-inserted? [result : EntryOrInsertResult]) : bool
                (match result
                  [(EntryOrInsertInserted _) true]
                  [(EntryOrInsertFound _) false]))
              (define (entry-or-insert-value-or
                [result : EntryOrInsertResult]
                [fallback : i64]) : i64
                (match result
                  [(EntryOrInsertFound value) value]
                  [(EntryOrInsertInserted value) value]))
              (define (get-mut-entry-borrowed
                [map : (&mut map Map)]
                [key : (& key str)]) : (MutEntry map)
                (MutEntry
                  (base.hashmap-string-i64-backing-get-mut-entry-borrowed!
                    (inner-mut map)
                    key)))
              (define (mut-entry-present? [entry : (MutEntry map)]) : bool
                (base.hashmap-string-i64-backing-mut-entry-present?
                  (struct-get entry inner)))
              (define (mut-entry-value-or
                [entry : (MutEntry map)]
                [fallback : i64]) : i64
                (base.hashmap-string-i64-backing-mut-entry-value-or
                  (struct-get entry inner)
                  fallback))
              (define (mut-entry-set! [entry : (MutEntry map)] [value : i64]) : unit
                (base.hashmap-string-i64-backing-mut-entry-set!
                  (struct-get entry inner)
                  value))
              (define (next-occupied [map : (& map Map)] [from : i64]) : i64
                (base.hashmap-string-i64-backing-next-occupied-ref
                  (& (struct-get map inner))
                  from))
              (define (entry-at [map : (& map Map)] [index : i64]) : Entry
                (match (base.hashmap-string-i64-backing-entry-at-ref
                  (& (struct-get map inner))
                  index)
                  [(base.HashmapStringI64BackingEntrySome key value)
                    (EntrySome key value)]
                  [(base.HashmapStringI64BackingEntryNone) (EntryNone)]))
              (define (entry-value-or [entry : Entry] [fallback : i64]) : i64
                (match entry
                  [(EntrySome _ value) value]
                  [(EntryNone) fallback])))]
          ["String"
            `(begin
              (module ,module-name)
              (import stdlib.array as array_ops)
              (import stdlib.hashmap as base)
              (import stdlib.string)
              (defstruct Map
                (inner base.HashmapStringStringBacking))
              (defenum Lookup
                (LookupMissing)
                (LookupFound String))
              (defenum BorrowedValueLookup
                (:lifetimes map)
                (BorrowedValueMissing)
                (BorrowedValueFound (& map str)))
              (defenum RemoveResult
                (RemoveOk)
                (RemoveMissing))
              (defenum EntryOrInsertResult
                (EntryOrInsertFound String)
                (EntryOrInsertInserted String))
              (defstruct MutEntry
                (:lifetimes map)
                (inner (base.HashmapStringStringBackingMutEntryRef map)))
              (defenum Entry
                (EntryNone)
                (EntrySome String String))
              (define (with-capacity [capacity : i64]) : Map
                (Map
                  (base.hashmap-string-string-backing-with-capacity capacity)))
              (define (new) : Map
                (with-capacity 4))
              (define (len [map : (& map Map)]) : i64
                (struct-get (struct-get map inner) len))
              (define (capacity [map : (& map Map)]) : i64
                (array_ops.length (struct-get (struct-get map inner) slots)))
              (define (deleted [map : (& map Map)]) : i64
                (struct-get (struct-get map inner) deleted))
              (define (inner-mut [map : (&mut map Map)]) : (&mut
                  map
                  base.HashmapStringStringBacking)
                (&mut (struct-get map inner)))
              (define (is-empty? [map : (& map Map)]) : bool
                (<= (len map) 0))
              (define (lookup-from-base
                [lookup : base.HashmapStringStringBackingLookup]) : Lookup
                (match lookup
                  [(base.HashmapStringStringBackingFound value)
                    (LookupFound value)]
                  [(base.HashmapStringStringBackingMissing) (LookupMissing)]))
              (define (get-borrowed [map : (& map Map)] [key : (& key str)]) : Lookup
                (lookup-from-base
                  (base.hashmap-string-string-backing-get-borrowed-ref
                    (& (struct-get map inner))
                    key)))
              (define (get [map : (& map Map)] [key : String]) : Lookup
                (get-borrowed map (& key)))
              (define (lookup-value-or [lookup : Lookup] [fallback : String]) : String
                (match lookup
                  [(LookupFound value) value]
                  [(LookupMissing) fallback]))
              (define (borrowed-value-missing [_map : (& map Map)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueMissing))
              (define (borrowed-value-found [value : (& map str)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueFound value))
              (define (get-value-borrowed
                [map : (& map Map)]
                [key : (& key str)]) : (BorrowedValueLookup map)
                (match (base.hashmap-string-string-backing-get-value-borrowed
                  (& (struct-get map inner))
                  key)
                  [(base.HashmapStringStringBackingBorrowedValueFound value)
                    (borrowed-value-found value)]
                  [(base.HashmapStringStringBackingBorrowedValueMissing)
                    (borrowed-value-missing map)]))
              (define (borrowed-value-found?
                [lookup : (BorrowedValueLookup map)]) : bool
                (match lookup
                  [(BorrowedValueFound _) true]
                  [(BorrowedValueMissing) false]))
              (define (contains-borrowed?
                [map : (& map Map)]
                [key : (& key str)]) : bool
                (match (get-borrowed map key)
                  [(LookupFound _) true]
                  [(LookupMissing) false]))
              (define (contains? [map : (& map Map)] [key : String]) : bool
                (contains-borrowed? map (& key)))
              (define (insert-ref!
                [map : (&mut map Map)]
                [key : String]
                [value : String]) : unit
                (base.hashmap-string-string-backing-put!
                  (inner-mut map)
                  key
                  value))
              (define (insert-or-update-ref!
                [map : (&mut map Map)]
                [key : String]
                [value : String]) : unit
                (insert-ref! map key value))
              (define (remove-borrowed-ref!
                [map : (&mut map Map)]
                [key : (& key str)]) : RemoveResult
                (if (base.hashmap-string-string-backing-remove-borrowed!
                  (inner-mut map)
                  key)
                  (RemoveOk)
                  (RemoveMissing)))
              (defmacro (remove-borrowed! [place : Expr] [key : Expr]) : RemoveResult
                (expr-mut-call1
                  (expr-var ,remove-borrowed-helper-name)
                  place
                  key))
              (define (remove-ref! [map : (&mut map Map)] [key : String]) : RemoveResult
                (remove-borrowed-ref! map (& key)))
              (define (remove-ok? [result : RemoveResult]) : bool
                (match result
                  [(RemoveOk) true]
                  [(RemoveMissing) false]))
              (define (entry-or-insert-ref!
                [map : (&mut map Map)]
                [key : String]
                [default-value : String]) : EntryOrInsertResult
                (match (base.hashmap-string-string-backing-get-borrowed-ref
                  (& (struct-get map inner))
                  (& key))
                  [(base.HashmapStringStringBackingFound value)
                    (EntryOrInsertFound value)]
                  [(base.HashmapStringStringBackingMissing)
                    (begin
                      (insert-ref! map key default-value)
                      (EntryOrInsertInserted default-value))]))
              (defmacro (insert! [place : Expr] [key : Expr] [value : Expr]) : unit
                (expr-mut-call2 (expr-var ,insert-helper-name) place key value))
              (defmacro (insert-or-update!
                [place : Expr]
                [key : Expr]
                [value : Expr]) : unit
                (expr-mut-call2
                  (expr-var ,insert-or-update-helper-name)
                  place
                  key
                  value))
              (defmacro (remove! [place : Expr] [key : Expr]) : RemoveResult
                (expr-mut-call1 (expr-var ,remove-helper-name) place key))
              (defmacro (entry-or-insert!
                [place : Expr]
                [key : Expr]
                [default-value : Expr]) : EntryOrInsertResult
                (expr-mut-call2
                  (expr-var ,entry-or-insert-helper-name)
                  place
                  key
                  default-value))
              (define (entry-or-insert-inserted? [result : EntryOrInsertResult]) : bool
                (match result
                  [(EntryOrInsertInserted _) true]
                  [(EntryOrInsertFound _) false]))
              (define (entry-or-insert-value-or
                [result : EntryOrInsertResult]
                [fallback : String]) : String
                (match result
                  [(EntryOrInsertFound value) value]
                  [(EntryOrInsertInserted value) value]))
              (define (get-mut-entry-borrowed
                [map : (&mut map Map)]
                [key : (& key str)]) : (MutEntry map)
                (MutEntry
                  (base.hashmap-string-string-backing-get-mut-entry-borrowed!
                    (inner-mut map)
                    key)))
              (define (mut-entry-present? [entry : (MutEntry map)]) : bool
                (base.hashmap-string-string-backing-mut-entry-ref-present?
                  (struct-get entry inner)))
              (define (mut-entry-value-or
                [entry : (MutEntry map)]
                [fallback : String]) : String
                (base.hashmap-string-string-backing-mut-entry-ref-value-or
                  (struct-get entry inner)
                  fallback))
              (define (mut-entry-set! [entry : (MutEntry map)] [value : String]) : unit
                (base.hashmap-string-string-backing-mut-entry-ref-set!
                  (struct-get entry inner)
                  value))
              (define (next-occupied [map : (& map Map)] [from : i64]) : i64
                (base.hashmap-string-string-backing-next-occupied-ref
                  (& (struct-get map inner))
                  from))
              (define (entry-at [map : (& map Map)] [index : i64]) : Entry
                (match (base.hashmap-string-string-backing-entry-at-ref
                  (& (struct-get map inner))
                  index)
                  [(base.HashmapStringStringBackingEntrySome key value)
                    (EntrySome key value)]
                  [(base.HashmapStringStringBackingEntryNone) (EntryNone)]))
              (define (entry-value-or [entry : Entry] [fallback : String]) : String
                (match entry
                  [(EntrySome _ value) value]
                  [(EntryNone) fallback])))]
          ["struct_stdlib.hashmap/HashPayload"
            `(begin
              (module ,module-name)
              (import stdlib.hashmap as base)
              (defstruct Map
                (inner base.StringHashPayloadMap))
              (defenum Lookup
                (LookupMissing)
                (LookupFound ,V))
              (defenum BorrowedValueLookup
                (:lifetimes map)
                (BorrowedValueMissing)
                (BorrowedValueFound (& map ,V)))
              (defenum RemoveResult
                (RemoveOk)
                (RemoveMissing))
              (defenum EntryOrInsertResult
                (EntryOrInsertFound ,V)
                (EntryOrInsertInserted ,V))
              (defenum Entry
                (EntryNone)
                (EntrySome String ,V))
              (define (with-capacity [capacity : i64]) : Map
                (Map (base.string-hash-payload-map-with-capacity capacity)))
              (define (new) : Map
                (with-capacity 4))
              (define (len [map : Map]) : i64
                (base.string-hash-payload-map-len (struct-get map inner)))
              (define (capacity [map : Map]) : i64
                (base.string-hash-payload-map-capacity (struct-get map inner)))
              (define (deleted [map : Map]) : i64
                (base.string-hash-payload-map-deleted (struct-get map inner)))
              (define (inner-mut [map : (&mut map Map)]) : (&mut
                  map
                  base.StringHashPayloadMap)
                (&mut (struct-get map inner)))
              (define (is-empty? [map : Map]) : bool
                (<= (len map) 0))
              (define (lookup-from-base
                [lookup : base.StringHashPayloadMapLookup]) : Lookup
                (match lookup
                  [(base.StringHashPayloadMapFound value) (LookupFound value)]
                  [(base.StringHashPayloadMapMissing) (LookupMissing)]))
              (define (get-borrowed [map : Map] [key : (& key str)]) : Lookup
                (lookup-from-base
                  (base.string-hash-payload-map-get-borrowed
                    (struct-get map inner)
                    key)))
              (define (get [map : Map] [key : String]) : Lookup
                (get-borrowed map (& key)))
              (define (lookup-value-or [lookup : Lookup] [fallback : ,V]) : ,V
                (match lookup
                  [(LookupFound value) value]
                  [(LookupMissing) fallback]))
              (define (borrowed-value-missing [_map : (& map Map)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueMissing))
              (define (borrowed-value-found [value : (& map ,V)]) : (BorrowedValueLookup
                  map)
                (BorrowedValueFound value))
              (define (get-value-borrowed
                [map : (& map Map)]
                [key : (& key str)]) : (BorrowedValueLookup map)
                (match (base.string-hash-payload-map-get-value-borrowed
                  (& (struct-get map inner))
                  key)
                  [(base.StringHashPayloadMapBorrowedValueFound value)
                    (borrowed-value-found value)]
                  [(base.StringHashPayloadMapBorrowedValueMissing)
                    (borrowed-value-missing map)]))
              (define (borrowed-value-found?
                [lookup : (BorrowedValueLookup map)]) : bool
                (match lookup
                  [(BorrowedValueFound _) true]
                  [(BorrowedValueMissing) false]))
              (define (contains-borrowed? [map : Map] [key : (& key str)]) : bool
                (base.string-hash-payload-map-contains-borrowed?
                  (struct-get map inner)
                  key))
              (define (contains? [map : Map] [key : String]) : bool
                (contains-borrowed? map (& key)))
