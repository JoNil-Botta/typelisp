          map
          (hashmap-string-string-backing-grow-capacity capacity-before))
        unit)
      (let
        [slots : (&mut map (Array HashmapStringStringBackingSlot))
          (&mut (struct-get map slots))]
        [capacity : i64 (array-length slots)]
        [hash : i64 (hashmap-string-string-backing-hash-key (& key))]
        (if (<= capacity 0)
          unit
          (let
            [cursor : i64
              (hashmap-string-string-backing-normalized-bucket-index
                hash
                capacity)]
            [walked : i64 0]
            [first : i64 -1]
            (begin
