    [info : HashmapI64I64BackingMutEntryInfo
      (hashmap-i64-i64-backing-mut-entry-info-mut
        slots
        (array-length slots)
        key)]
    (HashmapI64I64BackingMutEntryRef
      slots
      (struct-get info index)
      (struct-get info present)
      (struct-get info key)
      (struct-get info hash))))

;: Return whether an i64 -> i64 wrapper mutable entry points at a live slot.
(define (hashmap-i64-i64-backing-mut-entry-ref-present?
  [entry : (HashmapI64I64BackingMutEntryRef map)]) : bool
  (struct-get entry present))

;: Read an i64 -> i64 wrapper mutable entry value, or `fallback`.
(define (hashmap-i64-i64-backing-mut-entry-ref-value-or
  [entry : (HashmapI64I64BackingMutEntryRef map)]
  [fallback : i64]) : i64
  (if (hashmap-i64-i64-backing-mut-entry-ref-present? entry)
    (match (array-ref (struct-get entry borrow) (struct-get entry index))
      [(HashmapI64I64BackingOccupied _ value _) value]
      [(HashmapI64I64BackingEmpty) fallback]
      [(HashmapI64I64BackingTombstone) fallback])
    fallback))

;: Update an i64 -> i64 wrapper mutable entry in place when present.
(define (hashmap-i64-i64-backing-mut-entry-ref-set!
  [entry : (HashmapI64I64BackingMutEntryRef map)]
