stderr not-contains runs-after-failed-file
step test-run
run test "{{work}}/inline-test.tl" --opt-level 1 --stdlib-root "{{root}}/stdlib"
stdout empty
stderr contains test inc-basic
stderr contains ok inc-basic
stderr contains TypeLisp tests: 1 passed; 0 failed; 0 ignored; 0 slow-skipped; 1 total
test ! -f "{{work}}/inline-test.tl.test.s"
step test-no-tests-check
file no-tests.tl
(define (main) : i64 0)
end-file
run test --check "{{dir}}/no-tests.tl"
stderr empty
stdout contains TypeLisp test typecheck passed: 0 test(s)
step test-no-tests-run
run test "{{dir}}/no-tests.tl"
stdout empty
stderr contains TypeLisp tests: 0 passed; 0 failed; 0 ignored; 0 slow-skipped; 0 total
step test-run-batch-zero
file -x inline-test-batch-zero.txt
{{dir}}/no-tests.tl
{{work}}/inline-test.tl
end-file
run test --batch "{{dir}}/inline-test-batch-zero.txt" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
stdout contains TypeLisp test file: {{dir}}/no-tests.tl (0 test(s))
stdout contains TypeLisp test batch passed: 1 test(s) in 2 file(s)
stderr contains TypeLisp tests: 0 passed; 0 failed; 0 ignored; 0 slow-skipped; 0 total
test ! -f "{{dir}}/no-tests.tl.test.s"

# Package discovery from a nested source directory: inline tests under src/,
# integration tests under tests/; target/, nested packages and formatter
# fixtures are not tests.
case test-package
file pkg/typelisp.pkg
(package
  (name "inline_test_pkg")
  (version "0.1.0")
  (kind "lib")
  (entry "src/lib.tl"))
end-file
file pkg/src/lib.tl
(import stdlib.test)

(define (inc [x : i64]) : i64 (+ x 1))

(test pkg-entry
  (if (= (inc 41) 42)
    unit
