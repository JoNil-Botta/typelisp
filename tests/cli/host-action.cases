end-file
file -x inline-test-batch-lower-bad.txt
{{dir}}/inline-test-batch-lower-bad.tl
{{dir}}/inline-test-batch-sentinel.tl
end-file
run test --batch "{{dir}}/inline-test-batch-lower-bad.txt" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
exit nonzero
