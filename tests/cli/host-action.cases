# Host-action CLI smoke of a TYPELISP_BIN-compatible compiler (gate
# stage2-cli-host-action-smoke, via scripts/check-stage1-wrapper.sh): compile,
# check, source and package build, run, repl, lsp, doc, test, fmt and lint, and
# the opt2 build-invariance reference handoff.
hosts linux
do none
target -
opt -

file smoke.tl
(define (main) : i64
  7)
end-file

file inline-test.tl
(import stdlib.test)

(define (inc [x : i64]) : i64 (+ x 1))

(test inc-basic
  (test.assert-i64-eq (inc 41) 42 "inc result"))
end-file

file lint_bad.tl
(define (main) : i64
  (let
    [a : i64 1]
    (let
      [b : i64 (+ a 1)]
      (+ a b))))
end-file

# ---------------------------------------------------------------- compile

case compile
run compile "{{work}}/smoke.tl" -o "{{dir}}/smoke.s"
test -f "{{dir}}/smoke.s"
stdout contains Wrote {{dir}}/smoke.s
# #7071: an executable needs an explicit `main`; nothing synthesizes one.
# Executable compile and run reject a source without it before emitting any
# code; check accepts it, test runs its inline tests under its own harness
# entry without letting a later executable compile pass, and `--no-entry`
# compiles it (alone or in a batch) as library assembly with no entry symbol.
step missing-main
file missing-main.tl
(define VALUE : i64 7)
end-file
run compile "{{dir}}/missing-main.tl" -o "{{dir}}/missing-main.s"
exit nonzero
stdout empty
stderr contains {{native-dir}}/missing-main.tl:1:1
stderr contains executable has no `main`: define `(define (main) : i64 ...)` as its entry point
test ! -e "{{dir}}/missing-main.s"
step missing-main-run
run run "{{dir}}/missing-main.tl"
exit nonzero
stderr contains executable has no `main`
step missing-main-check
run check "{{dir}}/missing-main.tl"
stderr empty
stdout contains Type checking passed!
# An unqualified import that binds a name its module also declares is a load
# error for every action, reported at the import: build and run stop before the
# backend would emit both bindings as one duplicate global symbol.
step import-local-collision-build
file collide_lib.tl
(module collide_lib)
(define answer : i64 42)
end-file
file collide-main.tl
(import collide_lib.answer as value)
(define value : i64 1)
(define (main) : i64 value)
end-file
run build "{{dir}}/collide-main.tl" -o "{{dir}}/collide-main{{exe}}"
exit nonzero
stderr contains {{native-dir}}/collide-main.tl:1:1
stderr contains collides with the declaration of 'value' in the entry module
stderr not-contains duplicate emitted global symbol
test ! -e "{{dir}}/collide-main{{exe}}"
step import-local-collision-run
run run "{{dir}}/collide-main.tl"
exit nonzero
stderr contains collides with the declaration of 'value'
stderr not-contains duplicate emitted global symbol
step import-local-collision-check
run check "{{dir}}/collide-main.tl"
exit nonzero
stderr contains collides with the declaration of 'value'
step missing-main-test
file missing-main-tests.tl
(import stdlib.test)
(define (add-one [x : i64]) : i64 (+ x 1))
(test add-one-basic
  (test.assert-i64-eq (add-one 41) 42 "add-one"))
end-file
run test "{{dir}}/missing-main-tests.tl"
stderr contains ok add-one-basic
stderr contains 1 passed; 0 failed
run compile "{{dir}}/missing-main-tests.tl" -o "{{dir}}/missing-main-tests.s"
exit nonzero
stderr contains executable has no `main`
step missing-main-no-entry
run compile "{{dir}}/missing-main-tests.tl" --no-entry -o "{{dir}}/missing-main-lib.s"
stderr empty
in file {{dir}}/missing-main-lib.s
contains _tl_missing_main_tests_add_one:
not-contains .globl _tl_start
not-contains .globl main
step missing-main-no-entry-batch
file -x missing-main-batch.txt
{{dir}}/missing-main.tl|{{dir}}/missing-main-batch.s
end-file
run compile --batch "{{dir}}/missing-main-batch.txt" --no-entry
stderr empty
in file {{dir}}/missing-main-batch.s
not-contains .globl _tl_start
step missing-main-no-entry-conflicts
run compile "{{dir}}/missing-main.tl" --no-entry --pic -o "{{dir}}/missing-main-pic.s"
exit nonzero
stderr contains compile: --no-entry cannot be combined with --pic
run compile "{{dir}}/missing-main.tl" --no-entry --emit-ir
exit nonzero
stderr contains compile: --no-entry selects assembly output
run compile "{{dir}}/missing-main.tl" --no-entry --no-entry
exit nonzero
stderr contains compile: --no-entry was provided more than once
step cfg
file cfg-feature.tl
(import stdlib.string)
(cfg feature (define marker : String "enabled-cfg-feature"))
(cfg (not feature) (define marker : String "disabled-cfg-feature"))
(define (main) : i64 (string.string-length marker))
end-file
run compile "{{dir}}/cfg-feature.tl" -o "{{dir}}/cfg-feature.s" --cfg feature
in file {{dir}}/cfg-feature.s
contains enabled-cfg-feature
not-contains disabled-cfg-feature
step cfg-batch
file cfg-batch-one.tl
(import stdlib.string)
(cfg feature (define marker : String "enabled-cfg-batch-one"))
(cfg (not feature) (define marker : String "disabled-cfg-batch-one"))
(define (main) : i64 (string.string-length marker))
end-file
file cfg-batch-two.tl
(import stdlib.string)
(cfg feature (define marker : String "enabled-cfg-batch-two"))
(cfg (not feature) (define marker : String "disabled-cfg-batch-two"))
(define (main) : i64 (string.string-length marker))
end-file
file -x cfg-batch.txt
{{dir}}/cfg-batch-one.tl|{{dir}}/cfg-batch-one.s
{{dir}}/cfg-batch-two.tl|{{dir}}/cfg-batch-two.s
end-file
run compile --batch "{{dir}}/cfg-batch.txt" --cfg feature
in file {{dir}}/cfg-batch-one.s
contains enabled-cfg-batch-one
not-contains disabled-cfg-batch-one
in file {{dir}}/cfg-batch-two.s
contains enabled-cfg-batch-two
not-contains disabled-cfg-batch-two
step emit-ir
sh cp "{{work}}/smoke.tl" "{{dir}}/smoke.tl"
run compile "{{dir}}/smoke.tl" --emit-ir
test -f "{{dir}}/smoke.ir"
stdout contains Wrote {{dir}}/smoke.ir
in file {{dir}}/smoke.ir
contains typelisp-ir-summary v1
step missing-source
run compile
exit nonzero
stdout empty
stderr contains compile: expected source path
# An unresolved qualified name reached through an imported module graph is the
# normal typecheck diagnostic and exit status 1 exactly: a signal exit is the
# bug this step exists to catch.
step unresolved-qualified-name
file unresolved-qualified-helper.tl
(define (helper-use) : i64
  (owned_view.compiler-owned-shared-view 0))
end-file
file unresolved-qualified-suite.tl
(import unresolved-qualified-helper)
(define (main) : i64 0)
end-file
run compile "{{dir}}/unresolved-qualified-suite.tl" -o "{{dir}}/unresolved-qualified.s"
exit 1
stdout empty
stderr contains error[E0200]: typecheck: unknown qualified name owned_view.compiler-owned-shared-view
stderr contains unresolved-qualified-helper.tl

case help-check
run help
stdout empty
step check
run check "{{work}}/smoke.tl"
stderr empty
stdout contains Type checking passed!
step check-stdlib-root
file check-root/repo-stdlib/helper.tl
(define (helper) : i64 42)
end-file
file check-root/app/main.tl
(import stdlib.helper)
(define (main) : i64 (helper.helper))
end-file
run check "{{dir}}/check-root/app/main.tl" --stdlib-root "{{dir}}/check-root/repo-stdlib"
stderr empty
stdout contains Type checking passed!

case build
run build "{{work}}/smoke.tl" -o "{{dir}}/smoke-bin"
test -x "{{dir}}/smoke-bin"
stdout contains Built {{dir}}/smoke-bin

# ---------------------------------------------------------------- packages

case package
file pkg/typelisp.pkg
(package
  (name "stage1_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl")
  (dependencies
    (math "vendor/math")))
end-file
file pkg/src/main.tl
(import macros)
(define (main) : i64 (macros.add-one-macro 41))
end-file
file pkg/src/macros.tl
(import math.src.lib as math)
(import stdlib.comptime)
(define stage1-exported-value : i64 7)
(defstruct Stage1Point
  (x i64)
  (y i64))
(defenum Stage1Tag
  (Stage1A)
  (Stage1B i64))
(defmacro (add-one-macro [value : i64]) : i64
  `(math.add-one ,value))
(defmacro (all-macro [items : Expr ...]) : bool
  (comptime.expr-list-fold-if
    items
    (comptime.expr-bool true)
    (comptime.expr-bool false)
    true))
(defmacro (unsupported-macro [value : Expr]) : Expr
  (match value [(comptime.Expr.If c t e) c] [_ value]))
end-file
file pkg/vendor/math/typelisp.pkg
(package
  (name "stage1_math")
  (version "0.1.0")
  (kind "lib")
  (entry "src/lib.tl"))
end-file
file pkg/vendor/math/src/lib.tl
(define (add-one [x : i64]) : i64 (+ x 1))
end-file
file pkg/target/ignored.tl
(define (ignored) : i64 true)
end-file
file pkg/vendor/math/src/non_entry_bad.tl
(define (nested-package-source) : i64 true)
end-file
sh mkdir -p "{{dir}}/pkg/src/nested/deeper"
step check-package
run check --manifest-path "{{dir}}/pkg/typelisp.pkg"
stderr empty
stdout contains Type checking passed!
step check-package-discover
cwd {{dir}}/pkg/src/nested/deeper
run check
stderr empty
stdout contains Type checking passed!
cwd -
# A bad source outside the entry's import graph does not fail the package
# check; checked alone it fails, naming the file once.
step check-package-orphan-bad
file pkg/src/non_entry_bad.tl
(define (package-non-entry) : i64 true)
end-file
run check --manifest-path "{{dir}}/pkg/typelisp.pkg"
stderr empty
stdout contains Type checking passed!
step check-file-bad
run check "{{dir}}/pkg/src/non_entry_bad.tl"
exit nonzero
stdout empty
stderr contains non_entry_bad.tl
stderr not-contains {{dir}}/pkg/src/non_entry_bad.tl{{dir}}/pkg/src/non_entry_bad.tl
sh rm "{{dir}}/pkg/src/non_entry_bad.tl"
step check-file-manifest
run check "{{work}}/smoke.tl" --manifest-path "{{dir}}/pkg/typelisp.pkg"
exit nonzero
stdout empty
stderr contains cannot combine input path with --manifest-path
step build-package
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --opt-level 0
test -x "{{dir}}/pkg/target/release/stage1_pkg"
test -f "{{dir}}/pkg/target/release/stage1_pkg.s"
test -s "{{dir}}/pkg/vendor/math/target/release/libstage1_math.a"
test -s "{{dir}}/pkg/target/release/stage1_pkg.tlci"
test -s "{{dir}}/pkg/vendor/math/target/release/stage1_math.tlci"
stdout contains Built {{dir}}/pkg/vendor/math/target/release/libstage1_math.a
stdout contains Built {{dir}}/pkg/target/release/stage1_pkg
stdout contains Built {{dir}}/pkg/vendor/math/target/release/stage1_math.tlci
stdout contains Built {{dir}}/pkg/target/release/stage1_pkg.tlci
in file {{dir}}/pkg/target/release/stage1_pkg.s
contains main:
contains .extern _tl_stage1_math_src_lib_add_one
not-contains _tl_stage1_math_src_lib_add_one:
step producer-identity
run --producer-identity
stdout capture producer ^([0-9a-f]{40})$
step inspect-package-tlci
run inspect "{{dir}}/pkg/target/release/stage1_pkg.tlci"
stderr empty
stdout contains tlci image
stdout contains package-name: stage1_pkg
stdout contains producer-compiler-identity: {{producer}}
stdout contains source-set-binding-schema: 1
stdout not-contains source-set-digest: unavailable
stdout contains code: offset=
stdout not-contains code: offset=0 bytes=0
stdout not-contains   (none)
# The only end-to-end proof that a package's emitted .tlci dispatches its
# macros natively. Building the verifier builds a large slice of the compiler
# (the native producer, tlci loader, embedded stdlib image and CTFE): this step
# is most of the gate's cost, and that cost is inherent.
step package-tlci-native-verify
run run "{{root}}/src/tests/compiler_tlci_native_producer_smoke.tl" --stdlib-root "{{root}}/stdlib" --stdlib-root "{{root}}/src" -- "{{dir}}/pkg/target/release/stage1_pkg.tlci" macros/add-one-macro math.add-one macros/all-macro macros/unsupported-macro
stdout empty
stderr empty
step build-package-repeat
sh cp "{{dir}}/pkg/target/release/stage1_pkg.tlci" "{{dir}}/stage1_pkg.first.tlci"
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --opt-level 0
same "{{dir}}/stage1_pkg.first.tlci" "{{dir}}/pkg/target/release/stage1_pkg.tlci"
step inspect-bad-tlci
file -n bad.tlci
bad
end-file
run inspect "{{dir}}/bad.tlci"
exit nonzero
stdout empty
stderr contains inspect: {{dir}}/bad.tlci: tlci: truncated header
step build-package-bin
exec "{{dir}}/pkg/target/release/stage1_pkg"
exit 42
step build-package-dev
sh rm -rf "{{dir}}/pkg/target"
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --profile dev
test -x "{{dir}}/pkg/target/dev/stage1_pkg"
test -f "{{dir}}/pkg/target/dev/stage1_pkg.s"
test -s "{{dir}}/pkg/vendor/math/target/dev/libstage1_math.a"
test -s "{{dir}}/pkg/target/dev/stage1_pkg.tlci"
test -s "{{dir}}/pkg/vendor/math/target/dev/stage1_math.tlci"
stdout contains Built {{dir}}/pkg/vendor/math/target/dev/libstage1_math.a
stdout contains Built {{dir}}/pkg/target/dev/stage1_pkg
stdout contains Built {{dir}}/pkg/vendor/math/target/dev/stage1_math.tlci
stdout contains Built {{dir}}/pkg/target/dev/stage1_pkg.tlci
step build-package-discover
sh rm -rf "{{dir}}/pkg/target"
cwd {{dir}}/pkg/src/nested/deeper
run build
cwd -
test -x "{{dir}}/pkg/target/release/stage1_pkg"
test -f "{{dir}}/pkg/target/release/stage1_pkg.s"
stdout contains Built ../../../target/release/stage1_pkg

case package-lib
file libpkg/typelisp.pkg
(package
  (name "stage1_lib")
  (version "0.1.0")
  (kind "lib")
  (entry "src/lib.tl"))
end-file
file libpkg/src/lib.tl
(define (add-two [x : i64]) : i64 (+ x 2))
end-file
run build --manifest-path "{{dir}}/libpkg/typelisp.pkg"
test -s "{{dir}}/libpkg/target/release/libstage1_lib.a"
test -s "{{dir}}/libpkg/target/release/stage1_lib.tlci"
stdout contains Built {{dir}}/libpkg/target/release/libstage1_lib.a
stdout contains Built {{dir}}/libpkg/target/release/stage1_lib.tlci

case package-missing
each build check
run {{each}} --manifest-path "{{dir}}/missing.pkg"
exit nonzero
stdout empty
stderr contains cannot read package manifest

# ---------------------------------------------------------------- run, repl, lsp

case run
run run "{{work}}/smoke.tl"
exit 7
stdout empty
stderr empty
step run-cfg
file run-cfg.tl
(define (main) : i64 (cfg feature 11 3))
end-file
run run "{{dir}}/run-cfg.tl" --cfg feature
exit 11
stdout empty
stderr empty

case repl
sh : > "{{dir}}/repl-empty.in"
run repl < "{{dir}}/repl-empty.in"
stdout contains TypeLisp REPL. Type .help for commands.
stdout match tl>[ ]
stderr empty
step repl-session
file repl-session.in
.help
.type true
(+ 1 2)
.exit
end-file
run repl < "{{dir}}/repl-session.in"
stdout contains TypeLisp REPL commands:
stdout contains .type <expr>
stdout contains bool
stdout contains tl> 3
stderr empty
step repl-args
run repl unexpected
exit nonzero
stdout empty
stderr contains Error: repl does not accept arguments

case lsp
sh b='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" > "{{dir}}/init.in"
sh b='{"jsonrpc":"2.0","id":2,"method":"shutdown","params":null}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" >> "{{dir}}/init.in"
run lsp < "{{dir}}/init.in"
stderr empty
stdout contains "id":1
stdout contains "textDocumentSync"
stdout contains "id":2
step lsp-missing-length
sh printf 'X-Test: 1\r\n\r\n' > "{{dir}}/missing-length.in"
run lsp < "{{dir}}/missing-length.in"
exit nonzero
stdout contains "code":-32700
stderr contains lsp: missing Content-Length
step lsp-diagnostics
sh mkdir -p "{{dir}}/lsp-project"
sh b='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" > "{{dir}}/diagnostics.in"
sh b='{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://'"{{dir}}"'/lsp-project/main.tl","languageId":"typelisp","version":1,"text":"(define (main) : i64 true)"}}}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" >> "{{dir}}/diagnostics.in"
sh b='{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file://'"{{dir}}"'/lsp-project/main.tl","version":2},"contentChanges":[{"text":"(define (main) : i64 0)"}]}}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" >> "{{dir}}/diagnostics.in"
sh b='{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file://'"{{dir}}"'/lsp-project/main.tl"}}}' && printf 'Content-Length: %s\r\n\r\n%s' "${#b}" "$b" >> "{{dir}}/diagnostics.in"
run lsp < "{{dir}}/diagnostics.in"
stderr empty
stdout contains "code":"E0206"
stdout contains typecheck: return type mismatch
stdout contains "diagnostics":[]

# ---------------------------------------------------------------- doc

case doc
file doc/local.tl
;# Local module docs.

;: Local answer docs.
(define local-answer : i64 7)
end-file
file doc/stdlib/docfixture.tl
;# Stdlib module docs.

;: Stdlib answer docs.
(define stdlib-answer : i64 35)
end-file
file doc/entry.tl
;# Entry module docs.
;# ```typelisp
;# (import stdlib.docfixture)
;# (define (main) : i64 docfixture.stdlib-answer)
;# ```

(import local)
(import stdlib.docfixture)

;: Entry docs.
(define (main) : i64 (+ local.local-answer docfixture.stdlib-answer))
end-file
run doc "{{dir}}/doc/entry.tl" -o "{{dir}}/doc/entry.md" --stdlib-root "{{dir}}/doc/stdlib"
stderr empty
stdout contains Wrote {{dir}}/doc/entry.md
in file {{dir}}/doc/entry.md
contains Entry module docs.
contains Local module docs.
contains Stdlib module docs.
step doc-test
run doc --test "{{dir}}/doc/entry.tl" --stdlib-root "{{dir}}/doc/stdlib"
stderr empty
stdout contains Doc tests passed: 1 example(s)

# ---------------------------------------------------------------- test

case test
run test --check "{{work}}/inline-test.tl" --target linux-x86_64 --opt-level 2 --stdlib-root "{{root}}/stdlib"
stderr empty
stdout contains TypeLisp test typecheck passed: 1 test(s)
step test-check-batch
file inline-test-batch.tl
(import stdlib.test)

(test batch-one
  (test.assert-i64-eq (+ 20 22) 42 "batch one"))

(test batch-two
  (test.assert-i64-eq (* 6 7) 42 "batch two"))
end-file
file -x inline-test-batch.txt
{{work}}/inline-test.tl
{{dir}}/inline-test-batch.tl
end-file
run test --check --batch "{{dir}}/inline-test-batch.txt" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
stderr empty
stdout contains TypeLisp test file: {{work}}/inline-test.tl (1 test(s))
stdout contains TypeLisp test typecheck passed: 1 test(s)
stdout contains TypeLisp test file: {{dir}}/inline-test-batch.tl (2 test(s))
stdout contains TypeLisp test typecheck passed: 2 test(s)
stdout contains TypeLisp test batch typecheck passed: 3 test(s) in 2 file(s)
step test-check-batch-with-file
run test --check --batch "{{dir}}/inline-test-batch.txt" "{{work}}/inline-test.tl" --stdlib-root "{{root}}/stdlib"
exit nonzero
stderr contains test: cannot combine input paths with --batch
step test-run-batch
run test --batch "{{dir}}/inline-test-batch.txt" --target linux-x86_64 --opt-level 2 --stdlib-root "{{root}}/stdlib"
stdout contains TypeLisp test file: {{work}}/inline-test.tl (1 test(s))
stdout contains TypeLisp test file: {{dir}}/inline-test-batch.tl (2 test(s))
stdout contains TypeLisp test batch passed: 3 test(s) in 2 file(s)
stderr contains test inc-basic
stderr contains ok inc-basic
stderr contains test batch-one
stderr contains ok batch-two
# One success summary per source.
stderr count = 2 ^TypeLisp tests: .* passed; 0 failed; .* ignored; .* slow-skipped; .* total$
# A failing file does not stop the batch; the later file still runs.
step test-run-batch-failure
file inline-test-batch-fail.tl
(import stdlib.test)

(test intentional-batch-failure
  (test.assert-i64-eq 1 2 "intentional batch failure"))
end-file
file inline-test-batch-sentinel.tl
(import stdlib.test)

(test runs-after-failed-file
  (test.assert-i64-eq 42 42 "isolation sentinel"))
end-file
file -x inline-test-batch-fail.txt
{{work}}/inline-test.tl
{{dir}}/inline-test-batch-fail.tl
{{dir}}/inline-test-batch-sentinel.tl
end-file
run test --batch "{{dir}}/inline-test-batch-fail.txt" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
exit nonzero
stderr contains intentional batch failure
stderr contains FAILED intentional-batch-failure
stderr contains ok runs-after-failed-file
stderr not-contains test: batch source failed: {{dir}}/inline-test-batch-fail.tl
stdout contains TypeLisp test batch failed: 1 of 3 file(s) failed; 3 test(s)
step test-run-batch-sentinel-fresh
run test "{{dir}}/inline-test-batch-sentinel.tl" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
stderr contains ok runs-after-failed-file
# A file that fails to compile stops the batch.
step test-run-batch-compile-error
file inline-test-batch-bad.tl
(test batch-compile-error
  (missing-inline-test-name))
end-file
file -x inline-test-batch-bad.txt
{{dir}}/inline-test-batch-bad.tl
{{dir}}/inline-test-batch-sentinel.tl
end-file
run test --batch "{{dir}}/inline-test-batch-bad.txt" --target linux-x86_64 --stdlib-root "{{root}}/stdlib"
exit nonzero
stderr contains unbound name missing-inline-test-name
stderr contains test: batch source failed: {{dir}}/inline-test-batch-bad.tl
