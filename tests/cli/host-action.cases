# ---------------------------------------------------------------- opt2 handoff

# Linux CI runs build-invariance before the opt2 regression gate, which reuses
# its validated opt1 reference. check-opt2-cli-regression.sh runs in a copy of
# its scripts against a fake seed and generated compiler that log their calls.
case opt2-handoff
in file scripts/ci-verify.sh
contains TYPELISP_BUILD_INVARIANCE_OPT1_REFERENCE_PATH_FILE
contains TYPELISP_OPT2_CLI_REFERENCE_ASM
test "$(awk -F '\t' '$1 == "stage2-opt1-opt2-build-invariance" { print NR; exit }' scripts/ci-gates.tsv)" -lt "$(awk -F '\t' '$1 == "stage2-opt2-built-cli-compile-cross-fixpoint-regression" { print NR; exit }' scripts/ci-gates.tsv)"
sh mkdir -p "{{dir}}/repo/scripts" && cp scripts/check-opt2-cli-regression.sh scripts/lib-native-link.sh scripts/lib-gate.sh scripts/lib-linux-entry.sh scripts/run-memory-bounded.sh scripts/lib-linux-memory-limit.sh "{{dir}}/repo/scripts/"
sh printf '.text\nvalidated opt1 reference\n' > "{{dir}}/repo/validated-opt1.s"
file repo/fake-seed
#!/usr/bin/env sh
set -eu

printf 'seed' >> "$OPT2_HANDOFF_TEST_LOG"
for arg in "$@"; do
    printf '|%s' "$arg" >> "$OPT2_HANDOFF_TEST_LOG"
done
printf '\n' >> "$OPT2_HANDOFF_TEST_LOG"

command=${1:-}
case "$command" in
    test)
        exit 0
        ;;
    build)
        if [ "${OPT2_HANDOFF_TEST_SKIP_GENERATED:-0}" -eq 0 ]; then
            mkdir -p target/release
            cp "$OPT2_HANDOFF_TEST_GENERATED" target/release/typelisp
            chmod +x target/release/typelisp
        fi
        ;;
    compile)
        out=""
        shift
        while [ "$#" -gt 0 ]; do
            if [ "$1" = -o ]; then
                shift
                out=$1
            fi
            shift
        done
        [ -n "$out" ] || exit 1
        cp "$OPT2_HANDOFF_TEST_REFERENCE" "$out"
        ;;
    *)
        exit 1
        ;;
esac
end-file
file repo/fake-generated
#!/usr/bin/env sh
set -eu

printf 'generated' >> "$OPT2_HANDOFF_TEST_LOG"
for arg in "$@"; do
    printf '|%s' "$arg" >> "$OPT2_HANDOFF_TEST_LOG"
done
printf '\n' >> "$OPT2_HANDOFF_TEST_LOG"

[ "${1:-}" = compile ] || exit 1
out=""
opt_level=""
shift
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            shift
            out=$1
            ;;
        --opt-level)
            shift
            opt_level=$1
            ;;
    esac
    shift
done
[ -n "$out" ] || exit 1
if [ "$opt_level" = 1 ] && [ "${OPT2_HANDOFF_TEST_CROSS_MISMATCH:-0}" -eq 1 ]; then
    printf '.text\ncross mismatch\n' > "$out"
else
    cp "$OPT2_HANDOFF_TEST_REFERENCE" "$out"
fi
end-file
sh chmod +x "{{dir}}/repo/fake-seed" "{{dir}}/repo/fake-generated" "{{dir}}/repo/scripts/check-opt2-cli-regression.sh"
file -x repo/check
#!/usr/bin/env sh
export OPT2_HANDOFF_TEST_LOG="{{dir}}/repo/invocations.log"
export OPT2_HANDOFF_TEST_GENERATED="{{dir}}/repo/fake-generated"
export OPT2_HANDOFF_TEST_REFERENCE="{{dir}}/repo/validated-opt1.s"
export TYPELISP_BIN="{{dir}}/repo/fake-seed"
exec "{{dir}}/repo/scripts/check-opt2-cli-regression.sh"
end-file
step opt2-handoff-supplied
sh : > "{{dir}}/repo/invocations.log"
exec env TYPELISP_OPT2_CLI_REFERENCE_ASM="{{dir}}/repo/validated-opt1.s" sh "{{dir}}/repo/check"
stdout contains reference: reuse validated build-invariance stage4 src/main @ opt1 assembly
stdout contains cross-fixpoint holds
in file {{dir}}/repo/target/opt2-cli-regression/build.memory
contains backend=systemd-user-cgroup
contains reason=success
contains exit_code=0
contains limit_bytes=8589934592
in file {{dir}}/repo/invocations.log
contains seed|build|--manifest-path|typelisp.pkg|--profile|release|--opt-level|2
contains generated|compile|src/main.tl|-o|{{dir}}/repo/target/opt2-cli-regression/cli-opt2.s
contains generated|compile|src/main.tl|-o|{{dir}}/repo/target/opt2-cli-regression/cli-opt2built-opt1.s
not-contains seed|compile|src/main.tl
step opt2-handoff-standalone
sh : > "{{dir}}/repo/invocations.log"
exec env -u TYPELISP_OPT2_CLI_REFERENCE_ASM sh "{{dir}}/repo/check"
stdout contains reference: converged compiler compiles src/main.tl at opt1
stdout contains cross-fixpoint holds
in file {{dir}}/repo/invocations.log
contains seed|compile|src/main.tl|-o|{{dir}}/repo/target/opt2-cli-regression/cli-opt1-ref.s
step opt2-handoff-empty-reference
exec env TYPELISP_OPT2_CLI_REFERENCE_ASM= sh "{{dir}}/repo/check"
exit nonzero
stderr contains supplied opt1 reference path is empty
step opt2-handoff-missing-release
exec env TYPELISP_OPT2_CLI_REFERENCE_ASM="{{dir}}/repo/validated-opt1.s" OPT2_HANDOFF_TEST_SKIP_GENERATED=1 sh "{{dir}}/repo/check"
exit nonzero
stderr contains generated compiler is missing or empty
step opt2-handoff-cross-mismatch
exec env TYPELISP_OPT2_CLI_REFERENCE_ASM="{{dir}}/repo/validated-opt1.s" OPT2_HANDOFF_TEST_CROSS_MISMATCH=1 sh "{{dir}}/repo/check"
exit nonzero
stderr contains CROSS-FIXPOINT MISMATCH
