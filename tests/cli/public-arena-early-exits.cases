stderr contains tests/safety/scratch_body_try_array_error_exit_reject.tl:12:37
run compile "{{root}}/tests/safety/scratch_body_try_array_error_exit_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
