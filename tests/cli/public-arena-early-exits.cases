stderr contains tests/safety/scratch_body_try_array_error_exit_reject.tl:12:37

# An early exit's declared result must carry the regions its value keeps.
case arena-return-untied-input-reject
run check "{{root}}/tests/safety/arena_return_untied_input_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0205]: typecheck: cannot store region-tagged value into return value; region value would escape
stderr contains tests/safety/arena_return_untied_input_reject.tl:5:11
stderr contains function return type rejects this escaping value
run compile "{{root}}/tests/safety/arena_return_untied_input_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0205]: typecheck: cannot store region-tagged value into return value; region value would escape
