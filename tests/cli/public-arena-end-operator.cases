# One end operator (#9476): a safe destroy, a safe rewind and an `:invalidate`
# call give the same E0212 while a live `with` owner holds the ended arena,
# located at the arena argument and naming the owner local. Check and compile
# agree on both ABIs at every optimization level.
do none
target linux-x86_64 windows-x86_64
opt 0 1 2

case arena-end-with-owner-destroy-reject
run check "{{root}}/tests/safety/with_owner_destroy_unannotated_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.destroy-safe! cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_destroy_unannotated_reject.tl:26:30
stderr not-contains arena-brand/
run compile "{{root}}/tests/safety/with_owner_destroy_unannotated_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.destroy-safe! cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_destroy_unannotated_reject.tl:26:30

case arena-end-with-owner-rewind-reject
run check "{{root}}/tests/safety/with_owner_rewind_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.rewind-safe! cannot invalidate `scratch` while `with` cleanup owner `owner` holds values from it
stderr contains tests/safety/with_owner_rewind_reject.tl:23:29
run compile "{{root}}/tests/safety/with_owner_rewind_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.rewind-safe! cannot invalidate `scratch` while `with` cleanup owner `owner` holds values from it
stderr contains tests/safety/with_owner_rewind_reject.tl:23:29

case arena-end-with-owner-invalidate-call-reject
run check "{{root}}/tests/safety/with_owner_invalidate_call_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_reject.tl:27:18
run compile "{{root}}/tests/safety/with_owner_invalidate_call_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_reject.tl:27:18

# A call ending two arenas is located at the argument whose arena the owner
# holds; a call through an owner place names the owner local of its brand.
case arena-end-with-owner-invalidate-call-arguments-reject
run check "{{root}}/tests/safety/with_owner_invalidate_call_second_brand_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `second` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_second_brand_reject.tl:30:29
run compile "{{root}}/tests/safety/with_owner_invalidate_call_second_brand_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `second` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_second_brand_reject.tl:30:29
run check "{{root}}/tests/safety/with_owner_invalidate_call_place_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_place_reject.tl:32:20
run compile "{{root}}/tests/safety/with_owner_invalidate_call_place_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot invalidate `o` while `with` cleanup owner `w` holds values from it
stderr contains tests/safety/with_owner_invalidate_call_place_reject.tl:32:20

# Typing's in-arena self-check runs before the end operator for every end
# kind: inside its own arena, each end reports that error, not the `with` owner.
case arena-end-inside-arena-destroy-before-operator
run check "{{root}}/tests/safety/with_owner_end_inside_arena_destroy_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.destroy-safe! cannot run inside the arena it destroys
stderr contains tests/safety/with_owner_end_inside_arena_destroy_reject.tl:26:32
stderr not-contains cleanup owner
run compile "{{root}}/tests/safety/with_owner_end_inside_arena_destroy_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.destroy-safe! cannot run inside the arena it destroys
stderr contains tests/safety/with_owner_end_inside_arena_destroy_reject.tl:26:32
stderr not-contains cleanup owner

case arena-end-inside-arena-rewind-before-operator
run check "{{root}}/tests/safety/with_owner_end_inside_arena_rewind_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.rewind-safe! cannot run inside the arena it rewinds
stderr contains tests/safety/with_owner_end_inside_arena_rewind_reject.tl:27:31
stderr not-contains cleanup owner
run compile "{{root}}/tests/safety/with_owner_end_inside_arena_rewind_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: arena.rewind-safe! cannot run inside the arena it rewinds
stderr contains tests/safety/with_owner_end_inside_arena_rewind_reject.tl:27:31
stderr not-contains cleanup owner

case arena-end-inside-arena-invalidate-call-before-operator
run check "{{root}}/tests/safety/with_owner_end_inside_arena_invalidate_call_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot run inside the arena it destroys
stderr contains tests/safety/with_owner_end_inside_arena_invalidate_call_reject.tl:29:20
stderr not-contains cleanup owner
run compile "{{root}}/tests/safety/with_owner_end_inside_arena_invalidate_call_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0212]: typecheck: an :invalidate call cannot run inside the arena it destroys
stderr contains tests/safety/with_owner_end_inside_arena_invalidate_call_reject.tl:29:20
stderr not-contains cleanup owner

case arena-end-with-owner-accepted
run check "{{root}}/tests/integration/arena_invalidate_with_owner.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 0
stdout contains Type checking passed!
stderr empty
run compile "{{root}}/tests/integration/arena_invalidate_with_owner.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/accepted.s"
exit 0
stdout contains Wrote {{native-dir}}/accepted.s
stderr empty
