# Ending a first-class arena ends every region the admitted stores of the body
# carried its values into, so a scoped container cannot outlive the arena it
# holds, and a region no such store reached stays usable (#9445). The safety
# manifest pins the read locations; compile agrees on both ABIs.
do none
target linux-x86_64 windows-x86_64
opt 0 1 2

case arena-scoped-store-destroy-reject
run check "{{root}}/tests/safety/arena_scoped_store_destroy_reject.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0208]
stderr contains after the end of an arena whose values a store in this body places in
stderr contains tests/safety/arena_scoped_store_destroy_reject.tl:18:32
stderr contains end the arena after the last use of that region's values
run compile "{{root}}/tests/safety/arena_scoped_store_destroy_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/rejected.s"
exit 1
stdout empty
stderr contains error[E0208]
stderr contains after the end of an arena whose values a store in this body places in
stderr contains tests/safety/arena_scoped_store_destroy_reject.tl:18:32
stderr contains end the arena after the last use of that region's values

