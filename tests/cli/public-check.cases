(import stdlib.arena)
(import stdlib.string)
(import invalidation)

(defstruct Pair
  (text String)
  (count i64))

(define (read-fields
  [owner : (arena.Arena r) (:invalidate r)]
  [pair : (in r Pair)]) : i64
  ({{each}} owner)
  (+ pair.count (string.string-length pair.text)))

(define (main) : i64 42)
end-file
file -x begin.tl
(import stdlib.arena)
(import stdlib.string)
(import invalidation)

