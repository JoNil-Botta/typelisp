# Public check/compile basics, clean, and doctest and inline-test typechecking
# in normal commands (gate stage2-public-tool-surface).
do none
target -
opt -

file bad-doctest.tl
;# ```typelisp
;# (define (bad) : i64 true)
;# ```
(define (main) : i64 0)
end-file

file bad-inline.tl
(define (main) : i64 0)
(test bad-inline
  (+ true 1))
end-file

file invalidation.tl
(import stdlib.arena)
(define (release [owner : (arena.Arena r) (:invalidate r)]) : unit
  (arena.destroy-safe! owner))
end-file

case check-hello
run check examples/hello.tl
stderr empty
stdout contains Type checking passed!

case loader-error-codes
target linux-x86_64 windows-x86_64
each check compile
file helper.tl
(define answer : i64 42)
end-file
file missing.tl
(import missing_module_8981)
(define (main) : i64 0)
end-file
file include.tl
(include-str contents "missing_8981.txt")
(define (main) : i64 0)
end-file
file resolution.tl
(import helper.answer.extra)
(define (main) : i64 0)
end-file
file selected.tl
(import helper.absent)
(define (main) : i64 0)
end-file
file ambiguous.tl
(import helper.answer)
(define answer : i64 0)
(define (main) : i64 0)
end-file
file identity.tl
(import mismatched)
(define (main) : i64 0)
end-file
file mismatched.tl
(module different)
(define answer : i64 42)
end-file
file duplicate.tl
(module first)
(module second)
(define (main) : i64 0)
end-file
file broken.tl
(define answer : i64 (if true 1))
end-file
file cross-file.tl
(import broken)
(define (main) : i64 0)
end-file
step missing-source
run {{each}} "{{dir}}/missing.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0301]: compiler-load: cannot read import
stderr contains missing_module_8981.tl:1:1
step missing-include
run {{each}} "{{dir}}/include.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0302]: compiler-load: cannot read include-str
stderr contains include.tl:1:1
step invalid-selection
run {{each}} "{{dir}}/resolution.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0303]: compiler-load: import 'helper.answer.extra'
stderr contains resolution.tl:1:1
step missing-selection
run {{each}} "{{dir}}/selected.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0304]: compiler-load: module 'helper' has no selected item 'absent'
stderr contains selected.tl:1:1
step ambiguous-binding
run {{each}} "{{dir}}/ambiguous.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0305]: compiler-load: unqualified import 'answer'
stderr contains ambiguous.tl:1:1
stderr contains ambiguous.tl:2:22
stderr contains 'answer' is declared here
step module-identity
# An explicit module declaration overrides the inferred file identity.
# Explicit loader-API expectations remain covered by compiler_load_tests.
run {{each}} "{{dir}}/identity.tl" --target {{target}}
stderr empty
step duplicate-module
run {{each}} "{{dir}}/duplicate.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0307]: compiler-load: duplicate module declaration
stderr contains duplicate.tl:1:1
step imported-parse-error
run {{each}} "{{dir}}/cross-file.tl" --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0103]: parse: if is missing its else branch
stderr contains broken.tl:1:22
stderr not-contains error[E03

case loader-selected-seen-span
target linux-x86_64 windows-x86_64
each p.answer value
file plain_provider.tl
(define answer : i64 42)
end-file
file -x entry.tl
(import plain_provider as p)
(import plain_provider.nothing as value)
(define (main) : i64 (+ {{each}} (- p.answer p.answer)))
end-file
step source-seen-check
run check "{{dir}}/entry.tl" --target {{target}}
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains entry.tl:2:1
step source-seen-compile
run compile "{{dir}}/entry.tl" --target {{target}} -o "{{dir}}/seen.s"
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains entry.tl:2:1
test ! -e "{{dir}}/seen.s"
file -x entry.tl
(import plain_provider.nothing as value)
(import plain_provider as p)
(define (main) : i64 (+ {{each}} (- p.answer p.answer)))
end-file
step source-first-check
run check "{{dir}}/entry.tl" --target {{target}}
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains entry.tl:1:1
step source-first-compile
run compile "{{dir}}/entry.tl" --target {{target}} -o "{{dir}}/first.s"
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains entry.tl:1:1
test ! -e "{{dir}}/first.s"
file typelisp.pkg
(package (name "selected_span") (version "0.1.0") (kind "bin") (entry "src/main.tl"))
end-file
file src/plain_provider.tl
(define answer : i64 42)
end-file
file -x src/main.tl
(import plain_provider as p)
(import plain_provider.nothing as value)
(define (main) : i64 (+ {{each}} (- p.answer p.answer)))
end-file
step package-seen
run check --manifest-path "{{dir}}/typelisp.pkg" --target {{target}}
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains src/main.tl:2:1
file -x src/main.tl
(import plain_provider.nothing as value)
(import plain_provider as p)
(define (main) : i64 (+ {{each}} (- p.answer p.answer)))
end-file
step package-first
run check --manifest-path "{{dir}}/typelisp.pkg" --target {{target}}
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains src/main.tl:1:1

case loader-selected-pending-span
target linux-x86_64 windows-x86_64
each check compile
file plain_provider.tl
(define answer : i64 42)
end-file
file generated.tl
(defmacro (emit-made) : Decls `(define made : i64 42))
(emit-made)
end-file
file consumer.tl
(import generated.made as future)
(import plain_provider as p)
(import plain_provider.nothing as value)
(define answer : i64 (+ future p.answer))
end-file
file entry.tl
(import consumer as c)
(define (main) : i64 c.answer)
end-file
step pending-before-missing
run {{each}} "{{dir}}/entry.tl" --target {{target}}
exit 1
stdout empty
stderr contains error[E0304]: compiler-load: module 'plain_provider' has no selected item 'nothing'
stderr contains consumer.tl:3:1
stderr not-contains has no selected item 'made'
file consumer.tl
(import generated.made as future)
(import plain_provider as p)
(import plain_provider.answer as value)
(define answer : i64 (+ future (- value p.answer)))
end-file
step pending-valid
run {{each}} "{{dir}}/entry.tl" --target {{target}}
stderr empty

case loader-selected-valid
target linux-x86_64 windows-x86_64
file typelisp.pkg
(package (name "selected_valid") (version "0.1.0") (kind "bin") (entry "src/main.tl"))
end-file
file src/provider.tl
(define answer : i64 40)
(define (get) : i64 2)
(defstruct Record (value i64))
(defenum Choice (Some i64) (None))
end-file
file src/main.tl
(import provider as unused)
(import provider.answer as value)
(import provider.get as get)
(import provider.Record as Record)
(import provider.Choice as Choice)
(import provider.Some as Some)
(import stdlib.string as unused-string)
(import stdlib.string.string-length as length)
(define (main) : i64
  (let [record : Record (Record value)] [choice : Choice (Some (get))]
    (match choice [(Some n) (+ record.value (+ n (length "")))] [_ 0])))
end-file
# Resolve the standard library through the embedded provider from an unrelated cwd.
cwd {{dir}}
run check "{{dir}}/src/main.tl" --target {{target}}
stderr empty
run compile "{{dir}}/src/main.tl" --target {{target}} -o "{{dir}}/valid.s"
stderr empty
test -s "{{dir}}/valid.s"
run check --manifest-path "{{dir}}/typelisp.pkg" --target {{target}}
stderr empty

case loader-explanations
each E0301 E0302 E0303 E0304 E0305 E0307
run explain {{each}}
stderr empty
stdout contains {{each}}:
stdout contains Description:
stdout contains Minimal failing example:
stdout contains Fix:
stdout contains See also:

case loader-unpublished-identity-code
run explain E0306
exit 1
stdout empty
stderr contains explain: unknown diagnostic code `E0306`
run explain --list
stderr empty
stdout not-contains E0306
stdout contains E0307: duplicate module declaration

case loader-package-include-resolution
target linux-x86_64 windows-x86_64
each include-str include-str-comptime include-str-lzss include-bin
file typelisp.pkg
(package
  (name "include_resolution")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file -x src/main.tl
({{each}} contents "pkg:missing/data.txt")
(define (main) : i64 0)
end-file
run check --manifest-path "{{dir}}/typelisp.pkg" --target {{target}}
exit 1
stdout empty
stderr contains error[E0303]: compiler-load: unknown package alias 'missing'
stderr contains main.tl:1:1
stderr not-contains __tl_tc_

case loader-include-explanation
run explain E0303
stderr empty
stdout contains E0303: cannot resolve import or include
stdout contains unknown pkg: alias
stdout contains include-str-comptime
stdout contains include-str-lzss or include-bin
stdout contains pkg:missing/data.txt

case loader-generated-error-codes
target linux-x86_64 windows-x86_64
each check compile
step generated-missing-import
run {{each}} tests/safety/decls_generated_missing_import_reject.tl --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0301]: compiler-load: cannot read import
step generated-missing-selection
run {{each}} tests/safety/decls_generated_missing_selected_import_reject.tl --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0304]: compiler-load: module 'decls_generated_conflict_left' has no selected item 'missing'
step generated-alias-collision
run {{each}} tests/safety/decls_generated_conflicting_import_reject.tl --target {{target}}
exit nonzero
stdout empty
stderr contains error[E0305]: compiler-load: ambiguous import alias 'dep'

case check-parser-recovery-diagnostics
file main.tl
(define)
(define (later-a) : i64 missing-a)
(define (later-b) : i64 missing-b)
(define (main) : i64 0)
end-file
run check "{{dir}}/main.tl"
exit nonzero
stdout empty
stderr contains parse: malformed define
stderr contains typecheck: unbound name missing-a
stderr contains typecheck: unbound name missing-b
stderr order parse: malformed define || typecheck: unbound name missing-a || typecheck: unbound name missing-b

case check-parse-error-codes
file delimiter.tl
(define (main) : i64
  (+ 1 2)
end-file
file token.tl
(define (main) : i64
  (cast '\q' : i64))
end-file
file form.tl
(define (main) : i64
  (if true 1))
end-file
file pattern.tl
(define (first-or-zero [items : (& (Slice i64))]) : i64
  (match items
    [(slice first &rest) first]
    [_ 0]))
(define (main) : i64 0)
end-file
file unclassified.tl
(define (main) : i64
  (box-get (box 42)))
end-file
file mixed.tl
(define (bad-form) : i64 (if true 1))
(define (bad-pattern [items : (& (Slice i64))]) : i64
  (match items [(slice a &rest) a] [_ 0]))
(define (removed) : i64 (box-get (box 1)))
(define (bad-close) : i64 (+ 1 2])
(define (later) : i64 missing-name)
(define (main) : i64 0)
end-file
step delimiter
run check "{{dir}}/delimiter.tl"
exit nonzero
stdout empty
stderr contains error[E0101]: reader: unterminated list
stderr contains {{native-dir}}/delimiter.tl:1:1
step token
run check "{{dir}}/token.tl"
exit nonzero
stdout empty
stderr contains error[E0102]: lexer: unknown character escape
stderr contains {{native-dir}}/token.tl:2:9
step form
run check "{{dir}}/form.tl"
exit nonzero
stdout empty
stderr contains error[E0103]: parse: if is missing its else branch
stderr contains {{native-dir}}/form.tl:2:3
step pattern
run check "{{dir}}/pattern.tl"
exit nonzero
stdout empty
stderr contains error[E0104]: parse: slice pattern rest needs a space after `&`
step unclassified
run check "{{dir}}/unclassified.tl"
exit nonzero
stdout empty
stderr contains error[E0100]: parse: box-get was removed
step mixed-recovery-order
run check "{{dir}}/mixed.tl"
exit nonzero
stdout empty
stderr contains {{native-dir}}/mixed.tl:1:26
stderr contains {{native-dir}}/mixed.tl:3:3
stderr contains {{native-dir}}/mixed.tl:4:25
stderr contains {{native-dir}}/mixed.tl:5:33
stderr contains {{native-dir}}/mixed.tl:6:23
stderr order error[E0103]: parse: if is missing its else branch || error[E0104]: parse: slice pattern || error[E0100]: parse: box-get was removed || error[E0101]: reader: mismatched delimiter || error[E0201]: typecheck: unbound name missing-name

case check-function-assignment-location
file main.tl
(define (cap) : i64 4096)
(define (big) : i64 42)

(define (main) : i64
  (begin
    (set!
      cap
      missing-replacement)
    42))
end-file
run check "{{dir}}/main.tl"
exit nonzero
stdout empty
stderr contains error[E0215]
stderr contains {{native-dir}}/main.tl:7:7
stderr contains typecheck: cannot assign to function
stderr not-contains typecheck: unbound name missing-replacement
stderr not-contains assignment type mismatch

case check-cfg
file main.tl
(cfg linux
  (define platform-value : i64 40))
(cfg windows
  (define platform-value : i64 40))
(cfg tooling-feature
  (define cfg-value : i64 2))
(define (main) : i64
  (+ platform-value cfg-value))
end-file
step check-cfg-default-target
run check "{{dir}}/main.tl" --cfg tooling-feature
stderr empty
stdout contains Type checking passed!
step check-cfg-windows-target
run check "{{dir}}/main.tl" --target windows-x86_64 --cfg tooling-feature
stderr empty
stdout contains Type checking passed!

case compile-hello
run compile examples/hello.tl -o "{{dir}}/hello.s"
stderr empty
stdout match Wrote[ ]
in file {{dir}}/hello.s
contains main:

case compile-emit-ir-core-macro
file main.tl
(define (main) : i64
  (if (and true true)
    42
    1))
end-file
run compile "{{dir}}/main.tl" --emit-ir --target {{host-target}} --opt-level 2 -o "{{dir}}/main.ir" --stdlib-root "{{root}}/stdlib" --stdlib-root "{{root}}/src"
stderr empty
stdout match Wrote[ ]
test -s "{{dir}}/main.ir"
in file {{dir}}/main.ir
contains score

case clean-source
file main.tl
(define (main) : i64 0)
end-file
sh for e in .s .ir .o .obj '' .exe; do : > "{{dir}}/main$e"; done
step clean-source-dry-run
run clean --dry-run "{{dir}}/main.tl"
stderr empty
stdout contains Would remove:
stdout contains main.s
test -f "{{dir}}/main.tl"
test -f "{{dir}}/main.s"
test -f "{{dir}}/main"
step clean-source
run clean "{{dir}}/main.tl"
stderr empty
stdout contains Removed:
test -f "{{dir}}/main.tl"
test ! -e "{{dir}}/main.s"
test ! -e "{{dir}}/main.ir"
test ! -e "{{dir}}/main.o"
test ! -e "{{dir}}/main.obj"
test ! -e "{{dir}}/main"
test ! -e "{{dir}}/main.exe"
step clean-source-idempotent
run clean "{{dir}}/main.tl"
stdout empty
stderr empty

case bad-target
run compile examples/hello.tl --target definitely-not-a-target -o "{{dir}}/bad-target.s"
exit nonzero
stdout empty
stderr contains invalid --target

case check-stdlib-root
file repo-stdlib/helper.tl
(define (helper) : i64 42)
end-file
file app/main.tl
(import stdlib.helper)
(define (main) : i64 (helper.helper))
end-file
run check "{{dir}}/app/main.tl" --stdlib-root "{{dir}}/repo-stdlib"
stderr empty
stdout contains Type checking passed!

case normal-doctest
file unexpected-pass.tl
;# ```tl expect-error
;# (define (bad) : i64 1)
;# ```
(define (main) : i64 0)
end-file
file run-only.tl
;# ```tl run
;# ;; doctest-exit: 0
;# (define (main) : i64 7)
;# ```
(define (main) : i64 0)
end-file
step normal-doctest-check-bad
run check "{{work}}/bad-doctest.tl"
exit nonzero
stdout empty
stderr contains doc tests failed
stderr contains {{native-work}}/bad-doctest.tl:1:
stderr contains return type mismatch
step normal-doctest-compile-bad
run compile "{{work}}/bad-doctest.tl" -o "{{dir}}/bad.s"
exit nonzero
stdout empty
stderr contains doc tests failed
test ! -e "{{dir}}/bad.s"
step normal-doctest-build-bad
run build "{{work}}/bad-doctest.tl" -o "{{dir}}/bad{{exe}}" --target {{host-target}}
exit nonzero
stdout empty
stderr contains doc tests failed
test ! -e "{{dir}}/bad{{exe}}"
step normal-doctest-run-bad
run run "{{work}}/bad-doctest.tl" --target {{host-target}}
exit nonzero
stdout empty
stderr contains doc tests failed
step normal-doctest-build-unexpected-pass
run build "{{dir}}/unexpected-pass.tl" -o "{{dir}}/unexpected-pass{{exe}}" --target {{host-target}}
exit nonzero
stdout empty
stderr contains was expected to fail
step normal-doctest-runnable-check
run check "{{dir}}/run-only.tl"
stderr empty
stdout contains Type checking passed!
step normal-doctest-runnable-compile
run compile "{{dir}}/run-only.tl" -o "{{dir}}/run-only.s"
stderr empty
in file {{dir}}/run-only.s
contains main:

# A failing doctest in a module the package entry does not reach, or in the
# stdlib, does not fail the package.
case normal-doctest-package-orphan
file pkg/typelisp.pkg
(package
  (name "doctest_orphan_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file pkg/src/main.tl
(define (main) : i64 0)
end-file
file pkg/src/lib.tl
;# ```typelisp
;# (define (bad) : i64 true)
;# ```
(define (helper) : i64 1)
end-file
file bad-stdlib-docs/core_macros.tl
;# ```typelisp
;# (define (bad) : i64 true)
;# ```
end-file
sh cat "{{root}}/stdlib/core_macros.tl" >> "{{dir}}/bad-stdlib-docs/core_macros.tl"
sh cp "{{root}}/stdlib/runtime.tl" "{{dir}}/bad-stdlib-docs/runtime.tl"
step normal-doctest-package-orphan-check
run check --manifest-path "{{dir}}/pkg/typelisp.pkg"
stderr empty
stdout contains Type checking passed!
step normal-doctest-package-orphan-build
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --target {{host-target}}
stderr empty
step normal-doctest-package-stdlib-doc-check
run check --manifest-path "{{dir}}/pkg/typelisp.pkg" --stdlib-root "{{dir}}/bad-stdlib-docs"
stderr empty
stdout contains Type checking passed!
step normal-doctest-package-stdlib-doc-build
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --target {{host-target}} --stdlib-root "{{dir}}/bad-stdlib-docs"
stderr empty

# A missing argv[0] makes the doctest worker's spawn fail without a test mode.
if-host linux
step normal-doctest-package-orphan-build-spawn-fallback
exec bash -c 'exec -a "$0" "$1" build --manifest-path "$2" --target "$3" --stdlib-root "$4"' "{{dir}}/missing-doctest-worker" "{{compiler}}" "{{dir}}/pkg/typelisp.pkg" "{{host-target}}" "{{root}}/stdlib"
stderr empty
end-if

case normal-doctest-package-reachable
file typelisp.pkg
(package
  (name "doctest_reachable_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file src/main.tl
(import lib)
(define (main) : i64 (lib.helper))
end-file
file src/lib.tl
;# ```typelisp
;# (define (bad) : i64 true)
;# ```
(define (helper) : i64 1)
end-file
step normal-doctest-package-check
run check --manifest-path "{{dir}}/typelisp.pkg"
exit nonzero
stdout empty
stderr contains {{native-dir}}/src/lib.tl:1:
step normal-doctest-package-build
run build --manifest-path "{{dir}}/typelisp.pkg" --target {{host-target}}
exit nonzero
stdout empty
stderr contains {{native-dir}}/src/lib.tl:1:

if-host linux
step normal-doctest-package-build-spawn-fallback
exec bash -c 'exec -a "$0" "$1" build --manifest-path "$2" --target "$3" --stdlib-root "$4"' "{{dir}}/missing-doctest-worker" "{{compiler}}" "{{dir}}/typelisp.pkg" "{{host-target}}" "{{root}}/stdlib"
exit nonzero
stdout empty
stderr contains {{native-dir}}/src/lib.tl:1:
end-if

