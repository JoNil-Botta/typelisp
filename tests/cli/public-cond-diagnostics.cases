# Missing final else is an authored macro error at the user's cond form.
# Check, compile and build reject before target code generation or linking.
do none
target linux-x86_64 windows-x86_64
opt 0 1 2
each check compile build

case cond-missing-else
run {{each}} "{{root}}/tests/safety/cond_missing_else_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_reject.tl:2:3$
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-nested
run {{each}} "{{root}}/tests/safety/cond_missing_else_nested_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_nested_reject.tl:2:15$
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-qualified
run {{each}} "{{root}}/tests/safety/cond_missing_else_qualified_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_qualified_reject.tl:4:3$
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-empty
run {{each}} "{{root}}/tests/safety/cond_missing_else_empty_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_empty_reject.tl:2:3$
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-test
run {{each}} "{{root}}/tests/safety/cond_missing_else_test_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_test_reject.tl:2:3$
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-generated
run {{each}} "{{root}}/tests/safety/cond_missing_else_generated_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_generated_reject.tl:2:4$
stderr contains in expansion of macro `choose` invoked here
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-missing-else-spliced
run {{each}} "{{root}}/tests/safety/cond_missing_else_spliced_reject.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: cond requires a final [else ...] arm
stderr after ^error\[E0505\]:
next-line .*cond_missing_else_spliced_reject.tl:5:13$
stderr contains in expansion of macro `identity` invoked here
stderr not-contains core-cond-missing-else
stderr not-contains stdlib/core_macros.tl:

case cond-arm-type-error
file main.tl
(define (main) : i64
  (cond [true (+ 1 true)] [else 0]))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0206]: typecheck: integer operator expects matching integer operands: expected i32, found bool
stderr after ^error\[E0206\]:
next-line .*main.tl:2:20$
stderr not-contains core-cond-missing-else

case cond-valid
opt 0 1 2
each -
run check "{{root}}/tests/integration/cond.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 0
stdout contains Type checking passed!
stderr empty
run compile "{{root}}/tests/integration/cond.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/valid.s"
exit 0
stdout contains Wrote
stderr empty

# A spliced user's explicit comptime error retains its own expression span.
case spliced-comptime-error-location
each check compile build
file main.tl
(defmacro (identity [value : Expr]) : Expr
  value)

(define (main) : i64
  (identity (comptime (comptime-error "invalid user expression"))))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: invalid user expression
stderr after ^error\[E0505\]:
next-line .*main.tl:5:13$

# An error authored by any macro's template, not only cond's, rejects the
# user's invocation: the primary span and the expansion note both name the
# invocation, and nothing points into the template's own source lines.
case user-template-comptime-error-location
each check compile build
file main.tl
(import stdlib.comptime)
(defmacro (needs-default) : i64
  `(comptime (comptime.comptime-error "sewing plan needs a default")))

(define (main) : i64
  (needs-default))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: sewing plan needs a default
stderr after ^error\[E0505\]:
next-line .*main.tl:6:3$
stderr count = 2 main\.tl:6:3$
stderr contains in expansion of macro `needs-default` invoked here
stderr count = 0 main\.tl:[23]:

# The same holds for an invocation nested inside another expression.
case user-template-comptime-error-nested-location
each check compile build
file main.tl
(import stdlib.comptime)
(defmacro (needs-default) : i64
  `(comptime (comptime.comptime-error "sewing plan needs a default")))

(define (main) : i64
  (+ 1 (needs-default)))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: sewing plan needs a default
stderr after ^error\[E0505\]:
next-line .*main.tl:6:8$
stderr count = 2 main\.tl:6:8$
stderr contains in expansion of macro `needs-default` invoked here
stderr count = 0 main\.tl:[23]:
