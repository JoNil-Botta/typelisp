# Message negatives: a user's authored error that contains a cond message, and
# a legitimate generated binding spelled with a cond message, behave as on main.
case user-error-containing-missing-else-message
file main.tl
(defmacro (identity [value : Expr]) : Expr
  value)

(define (main) : i64
  (identity
    (comptime
      (comptime-error
        "invalid macro name cond requires a final [else ...] arm: choose another name"))))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: invalid macro name cond requires a final [else ...] arm: choose another name
stderr after ^error\[E0505\]:
next-line .*main.tl:6:5$

case generated-binding-cond-message-type-error
file main.tl
(import stdlib.comptime)
(defmacro (generated-binding) : Expr
  (comptime.expr-let-scope
    "cond allows [else ...] only as the final arm"
    (comptime.expr-int 7)
    (comptime.expr-var "cond allows [else ...] only as the final arm")))

(define (main) : i64
  (generated-binding))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0206]: typecheck: return type mismatch: expected i64, found i32
stderr after ^error\[E0206\]:
next-line .*main.tl:9:3$

case generated-binding-cond-message-valid
each -
file main.tl
(import stdlib.comptime)
(defmacro (generated-binding) : Expr
  (comptime.expr-let-scope
    "cond allows [else ...] only as the final arm"
    (comptime.expr-int 7)
    (comptime.expr-var "cond allows [else ...] only as the final arm")))

(define (seven) : i32
  (generated-binding))

(define (main) : i64
  (if (= (seven) 7) 0 1))
end-file
run check "{{dir}}/main.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 0
stdout contains Type checking passed!
run compile "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/valid.s"
exit 0
stdout contains Wrote

# A valid cond inside comptime still folds.
case cond-comptime-valid
each -
file main.tl
(define k : i64 (comptime (cond [false 1] [else 2])))

(define (main) : i64
  (- (comptime (+ 1 (cond [false 1] [true 1] [else 3]))) k))
end-file
run check "{{dir}}/main.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 0
stdout contains Type checking passed!
run compile "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/valid.s"
exit 0
stdout contains Wrote

case cond-arm-type-error
file main.tl
(define (main) : i64
  (cond [true (+ 1 true)] [else 0]))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0206]: typecheck: integer operator expects matching integer operands: expected i32, found bool
stderr after ^error\[E0206\]:
next-line .*main.tl:2:20$
stderr not-contains core-cond-missing-else

case cond-valid
opt 0 1 2
each -
run check "{{root}}/tests/integration/cond.tl" --target {{target}} --stdlib-root "{{root}}/stdlib"
exit 0
stdout contains Type checking passed!
stderr empty
run compile "{{root}}/tests/integration/cond.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib" -o "{{dir}}/valid.s"
exit 0
stdout contains Wrote
stderr empty

# A spliced user's explicit comptime error retains its own expression span.
case spliced-comptime-error-location
each check compile build
file main.tl
(defmacro (identity [value : Expr]) : Expr
  value)

(define (main) : i64
  (identity (comptime (comptime-error "invalid user expression"))))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: invalid user expression
stderr after ^error\[E0505\]:
next-line .*main.tl:5:13$

# An error authored by any macro's template, not only cond's, rejects the
# user's invocation: the primary span and the expansion note both name the
# invocation, and nothing points into the template's own source lines.
case user-template-comptime-error-location
each check compile build
file main.tl
(import stdlib.comptime)
(defmacro (needs-default) : i64
  `(comptime (comptime.comptime-error "sewing plan needs a default")))

(define (main) : i64
  (needs-default))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: sewing plan needs a default
stderr after ^error\[E0505\]:
next-line .*main.tl:6:3$
stderr count = 2 main\.tl:6:3$
stderr contains in expansion of macro `needs-default` invoked here
stderr count = 0 main\.tl:[23]:

# The same holds for an invocation nested inside another expression.
case user-template-comptime-error-nested-location
each check compile build
file main.tl
(import stdlib.comptime)
(defmacro (needs-default) : i64
  `(comptime (comptime.comptime-error "sewing plan needs a default")))

(define (main) : i64
  (+ 1 (needs-default)))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: sewing plan needs a default
stderr after ^error\[E0505\]:
next-line .*main.tl:6:8$
stderr count = 2 main\.tl:6:8$
stderr contains in expansion of macro `needs-default` invoked here
stderr count = 0 main\.tl:[23]:
