# A user's authored error that merely mentions a cond message keeps its text.
case user-error-mentioning-cond-message
file main.tl
(defmacro (identity [value : Expr]) : Expr
  value)

(define (main) : i64
  (identity
    (comptime
      (comptime-error
        "invalid macro name cond allows [else ...] only as the final arm: choose another name"))))
end-file
run {{each}} "{{dir}}/main.tl" --target {{target}} --opt-level {{opt}} --stdlib-root "{{root}}/stdlib"
exit 1
stdout empty
stderr contains error[E0505]: invalid macro name cond allows [else ...] only as the final arm: choose another name

# A message-named generated binding (comptime.expr-let-scope) cannot capture a
