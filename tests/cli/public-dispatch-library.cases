# Ordinary defdispatch variants in mainless libraries use the build backend mode.
# Cross-package direct calls, unsupported scalar-only bodies, and main-rooted
# pruning run at every optimization/backend pair (stage2-public-tool-cli-transcripts-1).
do none
target -
opt 0 1 2
mode scalar avx2 avx512

case dispatch-library-direct-variants
file math/typelisp.pkg
(package
  (name "math")
  (version "0.1.0")
  (kind "staticlib"))
end-file
file math/src/lib.tl
(define (twice-a [n : i64]) : i64 (* n 2))
(define (twice-b [n : i64]) : i64 (+ n n))
(defdispatch twice (scalar twice-a) (avx2 twice-b) (avx512 twice-b))
end-file
file app/typelisp.pkg
(package
  (name "dispatch_app")
  (version "0.1.0")
  (kind "bin")
  (dependencies (math "../math")))
end-file
file app/src/main.tl
(import math.src.lib as math)
(define (main) : i64 (+ (math.twice-a 10) (math.twice-b 11)))
end-file
run build --manifest-path "{{dir}}/app/typelisp.pkg" --opt-level {{opt}} --backend-mode {{mode}}
exit 0
stderr empty
exec "{{dir}}/app/target/release/dispatch_app{{exe}}"
exit 42
stdout empty
stderr empty

case dispatch-library-scalar-only-no-entry
file lib.tl
(define (positive-scalar [x : i32]) : i64
  (let [src : (__tl_dyn-array i32) (__tl_make-array i32 1)]
    [out : (__tl_dyn-array f32) (__tl_make-array f32 1)]
    (set! (array-ref src 0) x)
    (foreach ([i : i64 0 1])
      (if (> (array-ref src i) (cast 0 : i32))
        (set! (array-ref out i) (cast (array-ref src i) : f32))
        unit))
    (cast (array-ref out 0) : i64)))

(define (positive-simd [x : i32]) : i64
  (if (> x (cast 0 : i32)) (cast (cast x : f32) : i64) 0))

(defdispatch positive (scalar positive-scalar) (avx2 positive-simd) (avx512 positive-simd))

(define (use-positive [x : i32]) : i64 (positive x))
end-file
run compile "{{dir}}/lib.tl" --no-entry --opt-level {{opt}} --backend-mode {{mode}} -o "{{dir}}/lib.s"
exit scalar=0 avx2=1 avx512=1
if-mode scalar
stderr empty
end-if
if-mode avx2
stderr contains SPMD numeric conversion from i32 to f32 is unsupported in masked control context for AVX2
end-if
if-mode avx512
stderr contains SPMD numeric conversion from i32 to f32 is unsupported in masked control context for AVX-512
end-if

case dispatch-library-scalar-only-staticlib
file typelisp.pkg
(package
  (name "scalar_dispatch")
  (version "0.1.0")
  (kind "staticlib"))
end-file
file src/lib.tl
(define (positive-scalar [x : i32]) : i64
  (let [src : (__tl_dyn-array i32) (__tl_make-array i32 1)]
    [out : (__tl_dyn-array f32) (__tl_make-array f32 1)]
    (set! (array-ref src 0) x)
    (foreach ([i : i64 0 1])
      (if (> (array-ref src i) (cast 0 : i32))
        (set! (array-ref out i) (cast (array-ref src i) : f32))
        unit))
    (cast (array-ref out 0) : i64)))

(define (positive-simd [x : i32]) : i64
  (if (> x (cast 0 : i32)) (cast (cast x : f32) : i64) 0))

(defdispatch positive (scalar positive-scalar) (avx2 positive-simd) (avx512 positive-simd))

(define (use-positive [x : i32]) : i64 (positive x))
end-file
run build --manifest-path "{{dir}}/typelisp.pkg" --opt-level {{opt}} --backend-mode {{mode}}
exit scalar=0 avx2=1 avx512=1
if-mode scalar
stderr empty
end-if
if-mode avx2
stderr contains SPMD numeric conversion from i32 to f32 is unsupported in masked control context for AVX2
end-if
if-mode avx512
stderr contains SPMD numeric conversion from i32 to f32 is unsupported in masked control context for AVX-512
end-if

case dispatch-library-scalar-only-with-main
file prog.tl
(define (positive-scalar [x : i32]) : i64
  (let [src : (__tl_dyn-array i32) (__tl_make-array i32 1)]
    [out : (__tl_dyn-array f32) (__tl_make-array f32 1)]
    (set! (array-ref src 0) x)
    (foreach ([i : i64 0 1])
      (if (> (array-ref src i) (cast 0 : i32))
        (set! (array-ref out i) (cast (array-ref src i) : f32))
        unit))
    (cast (array-ref out 0) : i64)))

(define (positive-simd [x : i32]) : i64
  (if (> x (cast 0 : i32)) (cast (cast x : f32) : i64) 0))

(defdispatch positive (scalar positive-scalar) (avx2 positive-simd) (avx512 positive-simd))

(define (use-positive [x : i32]) : i64 (positive x))
(define (main) : i64 (use-positive (cast 4 : i32)))
end-file
run run "{{dir}}/prog.tl" --opt-level {{opt}} --backend-mode {{mode}}
exit 4
stderr empty
