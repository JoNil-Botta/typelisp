# `typelisp expand`: the checked expansion of the innermost macro invocation at
# a source position (#7067). Inputs are relative to the case directory, so the
# reported spans are deterministic.
do none
target -
opt -

case expand-prelude-when
file when.tl
(define (main) : i64
  (let
    [total : i64 0]
    (when (> total -1)
      (set! total (+ total 1)))
    total))
end-file
cwd {{dir}}
run expand when.tl --at 4:6
stderr empty
stdout contains macro: stdlib.core_macros/when
stdout contains defined in: stdlib/core_macros.tl
stdout contains invoked at: when.tl:4:5-5:31
stdout contains   1. stdlib.core_macros/when at when.tl:4:5-5:31
stdout contains expansion:
stdout contains (if (> total -1)
stdout not-contains truncated
# Any position inside the invocation selects it, including its arguments.
run expand when.tl --at 5:20
stdout contains macro: stdlib.core_macros/when

# A `when` inside a `for` body: two frames from the outermost inward, and the
# outer `for` alone from a position outside the `when`.
case expand-nested-frames
file nested.tl
(import stdlib.iterator)

(define (main) : i64
  (let
    [total : i64 0]
    (for [i (iterator.range 0 3)]
      (when (> i 0)
        (set! total (+ total i))))
    total))
end-file
cwd {{dir}}
run expand nested.tl --at 7:8
stderr empty
stdout contains macro: stdlib.core_macros/when
stdout contains   1. stdlib.core_macros/for at nested.tl:6:5-8:34
stdout contains   2. stdlib.core_macros/when at nested.tl:7:7-8:33
run expand nested.tl --at 6:6
stderr empty
stdout contains macro: stdlib.core_macros/for
stdout not-contains   2.
stdout contains __for_source_0

# A user macro defined in the inspected file, whose template invokes `when`:
# the rendered expansion is the fully expanded form.
case expand-user-macro
file user.tl
(defmacro (twice [body : Expr]) : Expr
  `(begin
    (when true ,body)
    (when true ,body)))

(define (main) : i64
  (let
    [total : i64 0]
    (twice (set! total (+ total 20)))
    (+ total 2)))
end-file
cwd {{dir}}
run expand user.tl --at 9:6
stderr empty
stdout contains macro: twice
stdout contains defined in: user.tl
stdout contains invoked at: user.tl:9:5-9:37
stdout contains (begin
stdout not-contains (when

# String and character literals render in reader syntax, escapes included.
case expand-literal-syntax
file literals.tl
(import stdlib.io)

(defmacro (say [code : Expr]) : Expr
  `(begin
    (io.print "tab\tquote\"backslash\\newline\n")
    (if (= '\'' '\'')
      ,code
      0)))

(define (main) : i64
  (say 7))
end-file
cwd {{dir}}
run expand literals.tl --at 11:4
stderr empty
stdout contains "tab\tquote\"backslash\\newline\n"
stdout contains '\''

# A rendering longer than --max-bytes stops there and says so.
case expand-max-bytes
file long.tl
(define (main) : i64
  (cond
    [(< 1 0) 1]
    [(< 2 0) 2]
    [(< 3 0) 3]
    [else 0]))
end-file
cwd {{dir}}
run expand long.tl --at 2:4 --max-bytes 12
stderr empty
stdout contains ; truncated: the expansion is longer than 12 bytes
stdout not-contains (< 3 0)
run expand long.tl --at 2:4 --max-bytes 4096
stdout not-contains truncated
stdout contains (< 3 0)

# An expansion that fails to typecheck is still shown, with its diagnostics,
# and the command fails.
case expand-ill-typed-expansion
file bad.tl
(defmacro (add-text [n : Expr]) : Expr
  `(+ ,n "text"))

(define (main) : i64
  (add-text 1))
end-file
cwd {{dir}}
run expand bad.tl --at 5:4
exit 1
stdout contains macro: add-text
stdout contains (+ 1 "text")
stderr contains error

# Positions without an invocation, sources that do not load, and malformed
# arguments are refused.
case expand-refusals
file plain.tl
(define (main) : i64
  (+ 1 2))
end-file
file broken.tl
(define (main) : i64
  (when true
end-file
cwd {{dir}}
step no-invocation
run expand plain.tl --at 2:4
exit 1
stdout empty
stderr contains expand: no macro invocation at plain.tl:2:4
step past-the-end
run expand plain.tl --at 99:1
exit 1
stderr contains expand: no macro invocation at plain.tl:99:1
step does-not-parse
run expand broken.tl --at 2:4
exit 1
stdout empty
stderr contains error
step missing-file
run expand missing.tl --at 1:1
exit 1
stdout empty
stderr contains expand: cannot read 'missing.tl'
step missing-position
run expand plain.tl
exit 1
stderr contains expand: --at <line>:<column> is required
step missing-source
run expand --at 1:1
exit 1
stderr contains expand: expected a source file
step position-without-column
run expand plain.tl --at 2
exit 1
stderr contains expand: --at expects <line>:<column>
step zero-line
run expand plain.tl --at 0:1
exit 1
stderr contains expand: --at expects <line>:<column>
step zero-column
run expand plain.tl --at 1:0
exit 1
stderr contains expand: --at expects <line>:<column>
step not-a-number
run expand plain.tl --at 2x:1
exit 1
stderr contains expand: --at expects <line>:<column>
step empty-column
run expand plain.tl --at 2:
exit 1
stderr contains expand: --at expects <line>:<column>
step duplicate-position
run expand plain.tl --at 2:4 --at 2:5
exit 1
stderr contains expand: --at was provided more than once
step zero-max-bytes
run expand plain.tl --at 2:4 --max-bytes 0
exit 1
stderr contains expand: --max-bytes expects a positive byte count
step unknown-flag
run expand plain.tl --at 2:4 --types
exit 1
stderr contains expand: unknown flag --types
step second-source
run expand plain.tl other.tl --at 2:4
exit 1
stderr contains expand: unexpected argument other.tl
