# Windows environment names are case-insensitive, so an inherited git_dir or
# Git_Dir naming the application must not select its HEAD either; on Linux these
# variants are controls. The fake Git child reports its argv and every inherited
# GIT_DIR spelling as received: raw Win32 block entries on Windows, exact names
# on Linux. That shows the harness delivered the spelling unnormalised.
case gm
each lt lb mt mb
sh case "{{each}}" in ?t) CCV_pin=tag ;; ?b) CCV_pin=branch ;; esac
sh case "{{each}}" in l?) CCV_spell=git_dir ;; m?) CCV_spell=Git_Dir ;; esac
file git-env.tl
(import stdlib.io)
(import stdlib.env)
(cfg
  windows
  (extern (raw-environment) : (Ptr u8) (:symbol "GetEnvironmentStringsA")))
(define (report-exact [name : (& name str)]) : unit
  (when (env.var-exists? name) (io.eprintln "env {}={}" name (env.var-value name))))
(define (main) : i64
  (let [i : i64 1]
    (while (< i (io.arg-count))
      (io.eprintln "arg {}" (io.arg i))
      (set! i (+ i 1))))
  (cfg
    windows
    (unsafe
      (let [p : (Ptr u8) (raw-environment)]
        (while (not (= (ptr-read p) (cast 0 : u8)))
          (when (not (ptr-null? (env.match-entry "GIT_DIR" p true)))
            (io.eprintln "env {}" (env.copy-c-string p)))
          (set! p (ptr-offset p (+ (env.c-string-length p) 1))))))
    (begin (report-exact "GIT_DIR") (report-exact "git_dir") (report-exact "Git_Dir")))
  128)
end-file
