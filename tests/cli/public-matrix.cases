# Profiles and --opt-level reach package emission: release defaults to opt2
# (main folds to 45, or keeps calc as a lea of the two argument registers),
# dev and --opt-level 0 keep opt0's stack multiply, and --opt-level overrides
# the profile. Windows package emission is byte-encoded (no host assembler).
case selfhost-build-package-opt
file optpkg/typelisp.pkg
(package
  (name "selfhost_opt_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file optpkg/src/main.tl
(define (calc [a : i64] [b : i64]) : i64
  (let
    [x : i64 (+ a b)]
    [y : i64 (* x 2)]
    (+ y x)))
(define (main) : i64
  (calc 10 5))
end-file
file worker/typelisp.pkg
(package
  (name "selfhost_opt_worker")
  (version "0.1.0")
  (kind "staticlib")
  (entry "src/lib.tl"))
end-file
file worker/src/lib.tl
(define (worker_calc [a : i64] [b : i64]) : i64
  (let
    [x : i64 (+ a b)]
    [y : i64 (* x 2)]
    (+ y x)))
end-file
if-host windows
sh CCV_o2a='0x48,0xc7,0xc0,0x2d,0x00,0x00,0x00' CCV_o2b='    leaq (%rcx,%rdx), %rax' CCV_o0='    imulq 24(%rsp), %r8'
else
sh CCV_o2a='    movl $45, %eax' CCV_o2b='    leaq (%rdi,%rsi), %rax' CCV_o0='    imulq -24(%rsp), %r8'
end-if
step selfhost-build-package-opt-default
run build --direct --manifest-path "{{dir}}/optpkg/typelisp.pkg"
stderr empty
test -f "{{dir}}/optpkg/target/release/selfhost_opt_pkg.s"
in file {{dir}}/optpkg/target/release/selfhost_opt_pkg.s
contains-any {{o2a}} || {{o2b}}
not-contains {{o0}}
