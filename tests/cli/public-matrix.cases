# The direct build/run planners on paths with spaces.
case selfhost-build-tool
if-host linux
test -n "$(command -v as)"
test -n "$(command -v ld)"
test -n "$(command -v cc)"
test -n "$(command -v ar)"
end-if
sh mkdir -p "{{dir}}/with space" "{{dir}}/stdlib one"
file with space/main file.tl
(define (main) : i64 23)
end-file
step selfhost-build-tool
run build --direct "{{dir}}/with space/main file.tl" -o "{{dir}}/with space/the program{{exe}}" --target {{host-target}} --backend-mode scalar
stderr empty
stdout contains Built {{native-dir}}/with space/the program{{exe}}
test -f "{{dir}}/with space/the program{{exe}}"
step selfhost-build-tool-output
exec "{{dir}}/with space/the program{{exe}}"
exit 23
stderr empty
step selfhost-build-source-locked
run build --direct "{{dir}}/with space/main file.tl" --locked
exit nonzero
stdout empty
stderr contains build: --locked is only valid for package builds
step selfhost-build-source-update-lock
run build --direct "{{dir}}/with space/main file.tl" --update-lock
exit nonzero
stdout empty
stderr contains build: --update-lock is only valid for package builds
step selfhost-build-tool-avx2
run build --direct "{{dir}}/with space/main file.tl" -o "{{dir}}/with space/avx2 program{{exe}}" --target {{host-target}} --backend-mode avx2
stderr empty
stdout contains Built {{native-dir}}/with space/avx2 program{{exe}}
test -f "{{dir}}/with space/avx2 program{{exe}}"
step selfhost-run-tool-missing-target
run run --direct "{{dir}}/with space/main file.tl" --target
exit nonzero
stdout empty
stderr contains run: --target requires a value

# Native libraries through --link-lib, constructors, and a package manifest
# `(link ...)` section (#2892): a relative search path resolves against the
# manifest directory, and a windows-libraries entry is filtered out on Linux.
case link-lib
hosts linux
file ffi_add7.s
    .globl ffi_add7
ffi_add7:
    movq %rdi, %rax
    addq $7, %rax
    ret
    .section .note.GNU-stack,"",@progbits
end-file
file ffi_ctor.c
static long ffi_ctor_value_state = 0;

__attribute__((constructor)) static void ffi_ctor_init(void) {
    ffi_ctor_value_state = 42;
}

long ffi_ctor_value(void) {
    return ffi_ctor_value_state;
}
end-file
file with space/link file.tl
(extern (ffi_add7 [x : i64]) : i64)
(define (main) : i64 (ffi_add7 35))
end-file
file with space/ctor file.tl
(import stdlib.string)

(extern (ffi_ctor_value) : i64)
(define (main) : i64
  (if (string.eq (string.int->string (ffi_ctor_value)) "42")
    (ffi_ctor_value)
    1))
end-file
step link-lib-assemble
exec as "{{dir}}/ffi_add7.s" -o "{{dir}}/ffi_add7.o"
stdout empty
stderr empty
step link-lib-archive
exec ar rcs "{{dir}}/libffi_add7.a" "{{dir}}/ffi_add7.o"
stdout empty
stderr empty
step selfhost-build-tool-link-lib
run build --direct "{{dir}}/with space/link file.tl" -o "{{dir}}/with space/link program" --target linux-x86_64 --backend-mode scalar --link-search "{{dir}}" --link-lib ffi_add7
stderr empty
stdout contains Built {{dir}}/with space/link program
step selfhost-build-tool-link-output
exec "{{dir}}/with space/link program"
exit 42
stderr empty
step selfhost-run-tool-link-lib
run run --direct "{{dir}}/with space/link file.tl" --target linux-x86_64 --backend-mode scalar --link-search "{{dir}}" --link-lib ffi_add7
exit 42
stdout empty
stderr empty
step public-build-link-lib
run build "{{dir}}/with space/link file.tl" -o "{{dir}}/with space/public link program" --target linux-x86_64 --link-search "{{dir}}" --link-lib ffi_add7
stderr empty
stdout contains Built {{dir}}/with space/public link program
step public-build-link-output
exec "{{dir}}/with space/public link program"
exit 42
stderr empty
step public-run-link-lib
run run "{{dir}}/with space/link file.tl" --target linux-x86_64 --link-search "{{dir}}" --link-lib ffi_add7
exit 42
stdout empty
stderr empty
step link-lib-ctor-compile
exec cc -c "{{dir}}/ffi_ctor.c" -o "{{dir}}/ffi_ctor.o"
stdout empty
stderr empty
step link-lib-ctor-archive
exec ar rcs "{{dir}}/libffi_ctor.a" "{{dir}}/ffi_ctor.o"
stdout empty
stderr empty
step selfhost-run-tool-link-ctor
run run --direct "{{dir}}/with space/ctor file.tl" --target linux-x86_64 --backend-mode scalar --stdlib-root "{{root}}/stdlib" --link-search "{{dir}}" --link-lib ffi_ctor
exit 42
stdout empty
stderr empty
step public-run-link-ctor
run run "{{dir}}/with space/ctor file.tl" --target linux-x86_64 --stdlib-root "{{root}}/stdlib" --link-search "{{dir}}" --link-lib ffi_ctor
exit 42
stdout empty
stderr empty
file pkg-link/typelisp.pkg
(package
  (name "pkg_link_app")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl")
  (link
    (search-paths "vendor")
    (linux-libraries "ffi_add7")
    (windows-libraries "pkg_link_missing_on_linux")))
end-file
file pkg-link/src/main.tl
(extern (ffi_add7 [x : i64]) : i64)
(define (main) : i64 (ffi_add7 35))
end-file
sh mkdir -p "{{dir}}/pkg-link/vendor" && cp "{{dir}}/libffi_add7.a" "{{dir}}/pkg-link/vendor/"
step pkg-link-build
run build --manifest-path "{{dir}}/pkg-link/typelisp.pkg" --target linux-x86_64
stderr empty
stdout match Built[ ]
test -x "{{dir}}/pkg-link/target/release/pkg_link_app"
step pkg-link-output
exec "{{dir}}/pkg-link/target/release/pkg_link_app"
exit 42
stdout empty
stderr empty
# Manifest link inputs merge with extern metadata: the library name stays on
# the extern and only the search path comes from the manifest.
file pkg-link-metadata/typelisp.pkg
(package
  (name "pkg_link_metadata_app")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl")
  (link
    (search-paths "vendor")))
end-file
file pkg-link-metadata/src/main.tl
(extern (ffi_add7 [x : i64]) : i64 (:link-lib "ffi_add7"))
(define (main) : i64 (ffi_add7 35))
end-file
sh mkdir -p "{{dir}}/pkg-link-metadata/vendor" && cp "{{dir}}/libffi_add7.a" "{{dir}}/pkg-link-metadata/vendor/"
step pkg-link-metadata-build
run build --manifest-path "{{dir}}/pkg-link-metadata/typelisp.pkg" --target linux-x86_64
stderr empty
stdout match Built[ ]
test -x "{{dir}}/pkg-link-metadata/target/release/pkg_link_metadata_app"
step pkg-link-metadata-output
exec "{{dir}}/pkg-link-metadata/target/release/pkg_link_metadata_app"
exit 42
stdout empty
stderr empty

# A staticlib's `(link ...)` section reaches the executables that depend on it
# (#6982): the root manifest names no native input, the wrapper's relative
# search path resolves against the wrapper's manifest, only the target's scope
# applies, and the runtime-inputs sidecar records who declared each input.
case package-link-propagation
hosts linux
file ffi_add7.s
    .globl ffi_add7
ffi_add7:
    movq %rdi, %rax
    addq $7, %rax
    ret
    .section .note.GNU-stack,"",@progbits
end-file
file wrap/typelisp.pkg
(package
  (name "wrap")
  (version "0.1.0")
  (kind staticlib)
  (link
    (search-paths "vendor")
    (linux-libraries "ffi_add7")
    (windows-libraries "wrap_missing_on_linux")))
end-file
file wrap/src/lib.tl
(extern (ffi_add7 [x : i64]) : i64)
(define (wrap-add [x : i64]) : i64 (ffi_add7 x))
end-file
file app/typelisp.pkg
(package
  (name "wrap_app")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (wrap "../wrap")))
end-file
file app/src/main.tl
(import wrap.src.lib as w)
(define (main) : i64 (w.wrap-add 35))
end-file
sh mkdir -p "{{dir}}/wrap/vendor"
exec as "{{dir}}/ffi_add7.s" -o "{{dir}}/ffi_add7.o"
exec ar rcs "{{dir}}/wrap/vendor/libffi_add7.a" "{{dir}}/ffi_add7.o"
step propagated-build
run build --manifest-path "{{dir}}/app/typelisp.pkg" --target linux-x86_64 --opt-level 0
stderr empty
stdout contains Built {{dir}}/app/target/release/wrap_app
step propagated-run
exec "{{dir}}/app/target/release/wrap_app"
exit 42
in file {{dir}}/app/target/release/wrap_app.runtime-inputs
contains native-link-value 8:ffi_add7
contains field `linux-libraries`
match ^native-link-value [0-9]+:.*/wrap/vendor$
not-contains wrap_missing_on_linux
# The other target's scope is not a runtime input.
step inactive-scope-change
sh sed -i 's/wrap_missing_on_linux/wrap_still_missing_on_linux/' "{{dir}}/wrap/typelisp.pkg"
run build --manifest-path "{{dir}}/app/typelisp.pkg" --target linux-x86_64 --opt-level 0
stderr empty
stdout contains Fresh {{dir}}/app/target/release/wrap_app
# Replacing the wrapper's vendored archive relinks the binary; the TLCI image,
# which no native input reaches, stays fresh.
file ffi_add8.s
    .globl ffi_add7
ffi_add7:
    movq %rdi, %rax
    addq $8, %rax
    ret
    .section .note.GNU-stack,"",@progbits
end-file
step active-archive-change
exec as "{{dir}}/ffi_add8.s" -o "{{dir}}/ffi_add8.o"
sh rm "{{dir}}/wrap/vendor/libffi_add7.a" && ar rcs "{{dir}}/wrap/vendor/libffi_add7.a" "{{dir}}/ffi_add8.o"
run build --manifest-path "{{dir}}/app/typelisp.pkg" --target linux-x86_64 --opt-level 0
stderr empty
stdout match ^Built .*/app/target/release/wrap_app$
stdout contains Fresh {{dir}}/app/target/release/wrap_app.tlci
step active-archive-run
exec "{{dir}}/app/target/release/wrap_app"
exit 43
sh rm "{{dir}}/wrap/vendor/libffi_add7.a" && ar rcs "{{dir}}/wrap/vendor/libffi_add7.a" "{{dir}}/ffi_add7.o"
# A library the linker cannot find names the manifest field that asked for it.
step missing-library
sh sed -i 's/(linux-libraries "ffi_add7")/(linux-libraries "ffi_add7" "wrap_no_such_native_lib")/' "{{dir}}/wrap/typelisp.pkg"
run build --manifest-path "{{dir}}/app/typelisp.pkg" --target linux-x86_64 --opt-level 0
exit nonzero
stderr contains note: native library `wrap_no_such_native_lib` is required by package `wrap` ({{dir}}/wrap/typelisp.pkg) field `linux-libraries`
stderr contains note: search paths: '{{dir}}/wrap/vendor' and the linker's defaults
# Two wrappers whose vendored archives call each other: liba1's a_entry needs
# libb1's b_helper, which needs liba1's a_helper, from another member. No
# single order of archives and libraries links this; the dependency section is
# one linker group. Both wrappers also name `m`, which links once, and the same
# raw argument, which each keeps.
file a_entry.c
long b_helper(long x);
long a_entry(long x) { return b_helper(x) + 1; }
end-file
file a_helper.c
long a_helper(long x) { return x * 2; }
end-file
file b_helper.c
long a_helper(long x);
long b_helper(long x) { return a_helper(x) + 3; }
end-file
file wa/typelisp.pkg
(package
  (name "wa")
  (version "0.1.0")
  (kind staticlib)
  (link
    (search-paths "vendor")
    (libraries "m")
    (args "-Wl,--as-needed")
    (linux-libraries "a1")))
end-file
file wa/src/lib.tl
(extern (a_entry [x : i64]) : i64)
(define (wa-entry [x : i64]) : i64 (a_entry x))
end-file
file wb/typelisp.pkg
(package
  (name "wb")
  (version "0.1.0")
  (kind staticlib)
  (link
    (search-paths "vendor")
    (libraries "m")
    (args "-Wl,--as-needed")
    (linux-libraries "b1")))
end-file
file wb/src/lib.tl
(define (wb-marker) : i64 0)
end-file
file mutual/typelisp.pkg
(package
  (name "mutual_app")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (wa "../wa")
    (wb "../wb")))
end-file
file mutual/src/main.tl
(import wa.src.lib as wa)
(import wb.src.lib as wb)
(define (main) : i64 (+ (wa.wa-entry 5) (wb.wb-marker)))
end-file
sh mkdir -p "{{dir}}/wa/vendor" "{{dir}}/wb/vendor"
exec cc -c "{{dir}}/a_entry.c" -o "{{dir}}/a_entry.o"
exec cc -c "{{dir}}/a_helper.c" -o "{{dir}}/a_helper.o"
exec cc -c "{{dir}}/b_helper.c" -o "{{dir}}/b_helper.o"
exec ar rcs "{{dir}}/wa/vendor/liba1.a" "{{dir}}/a_entry.o" "{{dir}}/a_helper.o"
exec ar rcs "{{dir}}/wb/vendor/libb1.a" "{{dir}}/b_helper.o"
step mutual-build
run build --manifest-path "{{dir}}/mutual/typelisp.pkg" --target linux-x86_64 --opt-level 0
stderr empty
step mutual-run
exec "{{dir}}/mutual/target/release/mutual_app"
exit 14
in file {{dir}}/mutual/target/release/mutual_app.runtime-inputs
count-fixed = 1 arg 3:-lm
count-fixed = 2 arg 15:-Wl,--as-needed
count-fixed = 1 arg 17:-Wl,--start-group
# A fetched wrapper's relative search path resolves inside its locked checkout
# and may not leave it.
file fetched/typelisp.pkg
(package
  (name "fetched_app")
  (version "0.1.0")
  (kind bin)
  (dependencies
