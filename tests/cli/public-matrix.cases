end-file
sh mkdir -p "{{dir}}/src" && cp "{{work}}/simd-fill.tl" "{{dir}}/src/main.tl"
run build --manifest-path "{{dir}}/typelisp.pkg" --backend-mode avx512
stderr empty
stdout match Built[ ]
if-host linux
test -f "{{dir}}/target/release/backend_mode_build.s"
in file {{dir}}/target/release/backend_mode_build.s
