case run-stdin
file stdin.tl
(import stdlib.io)
(import stdlib.byte_buf)

(define (fixture-stdout-write [text : String]) : unit
  (io.stdout-write (byte_buf.str-as-bytes (& text))))
(define (fixture-read-stdin) : String
  (let
    [read : io.StdinRead (io.stdin-read-bytes 256)]
    (byte_buf.to-string (io.stdin-read-buffer read))))
(define (main) : unit
  (fixture-stdout-write (fixture-read-stdin)))
end-file
file stdin.in
hello from stdin
end-file
run run "{{dir}}/stdin.tl" < "{{dir}}/stdin.in"
stderr empty
stdout contains hello from stdin

# `run` executes a SIMD mode only where the host has the ISA.
case run-backend
mode avx2 avx512
if-isa {{mode}}
step run-backend-{{mode}}
run run "{{work}}/main42.tl" --backend-mode {{mode}} -- arg
exit 42
stdout empty
stderr empty
end-if

case spmd-exec
mode scalar avx2 avx512
file spmd.tl
(define (main) : i64
  (let
    [a : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [b : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [i : i64 0]
    (begin
      (while (< i 64)
        (begin
          (set! (array-ref a i) (+ i 1))
          (set! (array-ref b i) (* i 2))
          (set! i (+ i 1))))
      (foreach
        ([j : i64 0 64])
        (set! (array-ref out j) (+ (array-ref a j) (array-ref b j))))
      (bit-and (array-ref out 63) 255))))
end-file
if-isa {{mode}}
step spmd-exec-{{mode}}
run run "{{dir}}/spmd.tl" --backend-mode {{mode}} -- arg
exit 190
stdout empty
stderr empty
end-if

case build-package-avx512
file typelisp.pkg
(package
  (name "backend_mode_build")
  (version "0.1.0")
