# Public CLI command matrix: backend modes, targets, typecheck diagnostics, and
# run/build execution including the direct (--direct) planners, native link
# inputs and package profiles (gate stage2-public-tool-surface).
do none
target -
opt -

file main42.tl
(define (main) : i64 42)
end-file

file simd-fill.tl
(define (fill [a : (__tl_dyn-array i64)] [b : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a i) (array-ref b i)))))
(define (main) : i64
  (let
    [a : (__tl_dyn-array i64) (__tl_make-array i64 17)]
    [b : (__tl_dyn-array i64) (__tl_make-array i64 17)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 17)]
    (begin
      (fill a b out 17)
      42)))
end-file

file argv-echo.tl
(import stdlib.io)
(import stdlib.byte_buf)
(import stdlib.string)

(define (fixture-cstr-len [p : (Ptr u8)]) : i64
  (let
    [n : i64 0]
    (begin
      (while (not (= (unsafe (ptr-read (ptr-offset p n))) (cast 0 : u8)))
        (set! n (+ n 1)))
      n)))
(define (fixture-stdout-write [text : String]) : unit
  (io.stdout-write (byte_buf.str-as-bytes (& text))))
(define (fixture-arg [index : i64]) : String
  (let
    [argv : (Ptr (Ptr u8)) (unsafe (program-argv))]
    [raw : (Ptr u8) (unsafe (ptr-read (ptr-offset argv index)))]
    (unsafe (string-from-bytes raw (fixture-cstr-len raw)))))
(define (main) : i64
  (begin
    (fixture-stdout-write (fixture-arg 1))
    (if (string.eq (fixture-arg 2) "colon:arg") 13 2)))
end-file

file hello-status.tl
(import stdlib.io)
(import stdlib.byte_buf)

(define (fixture-stdout-write [text : String]) : unit
  (io.stdout-write (byte_buf.str-as-bytes (& text))))
(define (main) : i64
  (begin
    (fixture-stdout-write "hello")
    7))
end-file

case compile-backend
mode scalar avx2 avx512
step compile-backend-{{mode}}
run compile "{{work}}/main42.tl" --backend-mode {{mode}} -o "{{dir}}/main.s"
stderr empty
stdout match Wrote[ ]
in file {{dir}}/main.s
contains main:
if-mode avx2
contains vzeroupper
end-if

case compile-backend-avx512-shape
run compile "{{work}}/simd-fill.tl" --backend-mode avx512 -o "{{dir}}/main.s"
stderr empty
in file {{dir}}/main.s
contains %zmm
contains %k
contains vmovdqu64
not-contains vector/mask IR emission is not implemented

case compile-target
each windows-x86_64 windows_x86_64
file main.tl
(import stdlib.io)

(define (main) : i64
  (begin
    (io.print-format "{}" (cast 3 : i64))
    42))
end-file
run compile "{{dir}}/main.tl" --target {{each}} -o "{{dir}}/main.s"
stderr empty
in file {{dir}}/main.s
contains-any     .globl main || .globl main
not-contains     .globl _start
contains-any     .extern WriteFile || .extern WriteFile
contains     sub $32, %rsp
narrow ranges:^_tl_stdlib_runtime_(runtime|stdlib_runtime|stdlib_runtime_runtime)_os_write:$~^_tl_.*:$
not-contains     call tl_alloc
match     leaq [0-9]+\(%rsp\)

