case check-stdlib-region-escape
file main.tl
(import stdlib.string)

(define (main) : String
  (with-arena outer
    (with-arena inner
      (let
        [s : String "  scoped  "]
        (string.trim (& s))))))
end-file
run check "{{dir}}/main.tl" --stdlib-root "{{root}}/stdlib"
exit nonzero
stdout empty
