do none
target -
opt -

case package-opaque-field-provider
file owner/typelisp.pkg
(package (name "readings") (version "0.1.0") (kind "lib") (entry "src/readings.tl"))
end-file
file owner/src/readings.tl
(module readings)
(defstruct Reading (value i64) (scale i64 (:opaque)))
(define (reading) : Reading (Reading 40 2))
end-file
file consumer/typelisp.pkg
(package (name "consumer") (version "0.1.0") (kind "bin") (entry "src/main.tl"))
end-file
file consumer/src/main.tl
(module readings.detail)
(import readings as model)
(define (main) : i64 (unsafe (model.reading).scale))
end-file
file reflection/typelisp.pkg
(package (name "reflection") (version "0.1.0") (kind "bin") (entry "src/main.tl"))
end-file
file reflection/src/main.tl
(module readings.detail)
(import readings as model)
(define (main) : i64 (comptime (size-of (struct-field-type (type model.Reading) 1))))
end-file
step field-read-other-provider
run check --target {{host-target}} "{{dir}}/consumer/src/main.tl" --stdlib-root "{{dir}}/owner/src"
exit 1
stderr contains error[E0221]
step field-reflection-other-provider
run check --target {{host-target}} "{{dir}}/reflection/src/main.tl" --stdlib-root "{{dir}}/owner/src"
exit 1
stderr contains error[E0221]
