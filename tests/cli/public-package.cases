case package-errors
file typelisp.pkg
(package
  (name "bad_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl")
  (deps "not-yet"))
end-file
step package-parse-error
run build --manifest-path "{{dir}}/typelisp.pkg"
exit nonzero
stdout empty
stderr contains unknown manifest field `deps`
file typelisp.pkg
(package
  (name "missing_alias")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file src/main.tl
(import math.src.lib)
(define (main) : i64 0)
end-file
step package-missing-local-module
run build --manifest-path "{{dir}}/typelisp.pkg"
exit nonzero
stdout empty
stderr contains error[E0301]: compiler-load: cannot read import
stderr match math[/\\]src[/\\]lib\.tl:1:1

# Since the tail-call forwarder inlining, `(math.inc 41)` folds to 42, so the
# folded constant proves the upward-discovered module was compiled in.
case package-discover-upward
file typelisp.pkg
(package
  (name "walk_pkg")
  (version "0.1.0")
  (kind "bin")
  (entry "src/main.tl"))
end-file
file src/main.tl
(import math)
(define (main) : i64 (math.inc 41))
end-file
file src/math.tl
(define (inc [x : i64]) : i64 (+ x 1))
end-file
sh mkdir -p "{{dir}}/src/nested/deeper"
cwd src/nested/deeper
run build
stderr empty
test -f "{{dir}}/target/release/walk_pkg.s"
stdout match Built[ ]
in file {{dir}}/target/release/walk_pkg.s
contains main:
contains-any _tl_walk_pkg_src_math_inc || _tl_walk_pkg_src_math_math_inc ||     movl $42, %eax ||     movq $42, %rax

