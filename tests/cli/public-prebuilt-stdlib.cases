# Prebuilt stdlib sysroot discovery, archive linking and the
# --no-prebuilt-stdlib source fallback (gate stage2-public-tool-cli-transcripts-3).
# Run by scripts/verify-public-tools.sh.
do none
target -
opt -

case prebuilt-stdlib-sysroot-discovery
step found
run inspect sysroot
stderr empty
stdout contains format: tli
stdout contains stdlib.io:
step flag-disabled
run inspect sysroot --no-prebuilt-stdlib
exit nonzero
stderr contains inspect: prebuilt stdlib disabled

# The default target selects the host sysroot on both Linux and Windows.
case prebuilt-stdlib-compile-and-fallback
step prebuilt-compile
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" -o "{{dir}}/prebuilt.s"
stderr empty
in file {{dir}}/prebuilt.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains _tl___tl_mod_init_stdlib
step prebuilt-compile-opt2
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 2 -o "{{dir}}/prebuilt-o2.s"
stderr empty
in file {{dir}}/prebuilt-o2.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains _tl___tl_mod_init_stdlib
step source-compile
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --no-prebuilt-stdlib -o "{{dir}}/source.s"
stderr empty
in file {{dir}}/source.s
contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl___tl_mod_init_stdlib
step prebuilt-run
run run "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl"
exit 42
stdout contains hello prebuilt
step source-run
run run "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --no-prebuilt-stdlib
exit 42
stdout contains hello prebuilt
# -Os closes the executable, but archive members still call runtime entry
# points (`tl_alloc16`, `tl_array_zero`, ...) the program text never names,
# so the closed-executable runtime prune must keep them.
step prebuilt-run-size
run run "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" -Os
exit 42
stderr empty
stdout contains hello prebuilt

case prebuilt-stdlib-comptime-purity
step prebuilt-unsafe-wrapper
run check "{{root}}/tests/safety/prebuilt_stdlib_comptime_unsafe_wrapper_reject.tl"
exit nonzero
stderr contains unsupported compile-time call sha.new
step source-unsafe-wrapper
run check "{{root}}/tests/safety/prebuilt_stdlib_comptime_unsafe_wrapper_reject.tl" --no-prebuilt-stdlib
exit nonzero
stderr contains unsupported compile-time call sha.new
step prebuilt-runtime-abort
run check "{{root}}/tests/safety/prebuilt_stdlib_comptime_runtime_abort_reject.tl"
exit nonzero
stderr contains unsupported compile-time call test.assert-true
step source-runtime-abort
run check "{{root}}/tests/safety/prebuilt_stdlib_comptime_runtime_abort_reject.tl" --no-prebuilt-stdlib
exit nonzero
stderr contains unsupported compile-time call test.assert-true

# A --stdlib-root whose files match the embedded stdlib (inline tests aside)
# keeps the prebuilt stdlib; a root that modifies one falls back to source.
case prebuilt-stdlib-root-override
step pristine-root
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 1 --stdlib-root "{{root}}/stdlib" -o "{{dir}}/pristine.s"
stderr empty
in file {{dir}}/pristine.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains _tl___tl_mod_init_stdlib
sh mkdir -p "{{dir}}/modified-root" && cp "{{root}}/stdlib/io.tl" "{{dir}}/modified-root/io.tl" && printf '\n(define (prebuilt-root-probe) : i64 1)\n' >> "{{dir}}/modified-root/io.tl"
step modified-root
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 1 --stdlib-root "{{dir}}/modified-root" -o "{{dir}}/modified.s"
stderr empty
in file {{dir}}/modified.s
contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl___tl_mod_init_stdlib
sh mkdir -p "{{dir}}/modified-nested-root/net" && cp "{{root}}/stdlib/net/ip.tl" "{{dir}}/modified-nested-root/net/ip.tl" && printf '\n(define (prebuilt-nested-root-probe) : i64 1)\n' >> "{{dir}}/modified-nested-root/net/ip.tl"
step modified-nested-root
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 1 --stdlib-root "{{dir}}/modified-nested-root" -o "{{dir}}/modified-nested.s"
stderr empty
in file {{dir}}/modified-nested.s
contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl___tl_mod_init_stdlib

# An explicit sysroot without the archive is a clean error at every level.
case prebuilt-stdlib-missing-sysroot
step opt-level-0
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 0 --sysroot "{{dir}}/missing-sysroot" -o "{{dir}}/missing0.s"
exit 1
stderr contains sysroot: missing prebuilt stdlib archive:
step opt-level-1
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --opt-level 1 --sysroot "{{dir}}/missing-sysroot" -o "{{dir}}/missing1.s"
exit 1
stderr contains sysroot: missing prebuilt stdlib archive:

# Hydrated prebuilt stdlib `.tli` declarations keep the stdlib provider (#8733)
# even when `stdlib/` exists in cwd with no `--stdlib-root`, or when a package's
# own `stdlib/` subdirectory holds a same-named file. `check` defaults to the
# host target, so both host-default and explicit `--target {{host-target}}`
# open the prebuilt sysroot on Linux and Windows alike.
case prebuilt-stdlib-opaque-provider
file evil/stdlib/crypto_hmac_sha256.tl
(module stdlib.crypto_hmac_sha256.extra)
(import stdlib.crypto_hmac_sha256 as hmac)

(define (storage-phase [s : hmac.HmacSha256Storage]) : i64
  s.phase)

(define (main) : i64 0)
end-file
cwd {{root}}
step repo-root-spoof-check
run check tests/safety/opaque_provider_stdlib_spoof_reject.tl
exit 1
stderr contains error[E0221]
stderr contains opaque type stdlib.crypto_secret/SecretStorage outside its module family
cwd {{dir}}/evil
step same-name-stdlib-subdir-check
run check stdlib/crypto_hmac_sha256.tl
exit 1
stderr contains error[E0221]
stderr contains opaque type stdlib.crypto_hmac_sha256/HmacSha256Storage outside its module family
cwd -

# Non-stdlib `--cfg` flags do not defeat prebuilt stdlib hydration, while
# stdlib-affecting cfgs (`test`) still fall back cleanly to source stdlib;
# `compile --batch` caches the stdlib override scan and catalog across entries.
case prebuilt-stdlib-cfg-scoping-and-batch
step non-stdlib-cfg-manifest
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --cfg selfhost-compile-manifest -o "{{dir}}/manifest.s"
stderr empty
in file {{dir}}/manifest.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
step non-stdlib-cfg-audit
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --cfg compiler-dependency-audit -o "{{dir}}/audit.s"
stderr empty
in file {{dir}}/audit.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
step stdlib-cfg-test-fallback
run compile "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" --target {{host-target}} --cfg test -o "{{dir}}/test.s"
stderr empty
in file {{dir}}/test.s
contains _tl_stdlib_io_stdlib_io_platform_write:
not-contains .extern _tl_stdlib_io_stdlib_io_
sh printf '%s|%s\n%s|%s\n' "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" "{{dir}}/batch1.s" "{{root}}/tests/integration/prebuilt_stdlib_hello_io.tl" "{{dir}}/batch2.s" > "{{dir}}/batch.txt"
step batch-prebuilt-stdlib
run compile --batch "{{dir}}/batch.txt" --target {{host-target}} --stdlib-root "{{root}}/stdlib" --cfg selfhost-compile-manifest
stderr empty
in file {{dir}}/batch1.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:
in file {{dir}}/batch2.s
contains .extern _tl_stdlib_io_stdlib_io_
not-contains _tl_stdlib_io_stdlib_io_platform_write:

# `typelisp test` hydrates prebuilt stdlib.tli and links libstdlib.a for
# non-stdlib tests across single-file, --batch, --batch --combined, and package
# mode; respects --no-prebuilt-stdlib; and auto-disables prebuilt stdlib for
# stdlib/ sources so stdlib `(cfg test ...)` inline tests keep full coverage.
case prebuilt-stdlib-test-command
file test_a.tl
(import stdlib.io)
(import stdlib.test)

(cfg test
  (define (test-only-helper) : i64 40))

(test non-stdlib-uses-prebuilt-and-cfg-test
  (io.println "hello prebuilt test a")
  (test.assert-i64-eq (+ (test-only-helper) 2) 42 "cfg test active"))
end-file
file test_b.tl
(import stdlib.io)
(import stdlib.test)

(test non-stdlib-batch-second
  (io.println "hello prebuilt test b")
  (test.assert-i64-eq (+ 10 11) 21 "batch second"))
end-file
file batch.list
test_a.tl
test_b.tl
end-file
file pkg/typelisp.pkg
(package (name "prebuilt_test_pkg") (version "0.1.0") (kind "bin") (entry "src/main.tl"))
end-file
file pkg/src/main.tl
(import stdlib.io)
(import stdlib.test)

(cfg test
  (define (pkg-test-only) : i64 7))

(define (main) : i64 0)

(test pkg-uses-prebuilt-and-cfg-test
  (io.println "hello prebuilt pkg test")
  (test.assert-i64-eq (pkg-test-only) 7 "pkg cfg test"))
end-file
cwd {{dir}}
step single-prebuilt
run test "test_a.tl" --target {{host-target}}
stderr contains TypeLisp tests: 1 passed; 0 failed
stdout contains hello prebuilt test a
step single-missing-sysroot
run test "test_a.tl" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot"
exit 1
stderr contains sysroot: missing prebuilt stdlib archive:
step single-no-prebuilt
run test "test_a.tl" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot" --no-prebuilt-stdlib
stderr contains TypeLisp tests: 1 passed; 0 failed
stdout contains hello prebuilt test a
step batch-prebuilt
run test --batch "batch.list" --target {{host-target}}
stderr contains TypeLisp tests: 1 passed; 0 failed
stdout contains TypeLisp test batch passed: 2 test(s) in 2 file(s)
step batch-missing-sysroot
run test --batch "batch.list" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot"
exit 1
stderr contains sysroot: missing prebuilt stdlib archive:
step batch-no-prebuilt
run test --batch "batch.list" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot" --no-prebuilt-stdlib
stdout contains TypeLisp test batch passed: 2 test(s) in 2 file(s)
step combined-prebuilt
run test --batch "batch.list" --combined --target {{host-target}}
stderr not-contains fallback to single-file mode
stdout contains TypeLisp test batch passed: 2 test(s) in 2 file(s)
step combined-missing-sysroot
run test --batch "batch.list" --combined --target {{host-target}} --sysroot "{{dir}}/missing-sysroot"
exit 1
stderr contains sysroot: missing prebuilt stdlib archive:
stderr not-contains fallback to single-file mode
step combined-no-prebuilt
run test --batch "batch.list" --combined --target {{host-target}} --sysroot "{{dir}}/missing-sysroot" --no-prebuilt-stdlib
stderr not-contains fallback to single-file mode
stdout contains TypeLisp test batch passed: 2 test(s) in 2 file(s)
step stdlib-cfg-test-auto-source
run test "{{root}}/stdlib/byte_le.tl" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot"
stderr contains 0 failed
step package-prebuilt
run test --manifest-path "pkg/typelisp.pkg" --target {{host-target}}
stderr contains TypeLisp tests: 1 passed; 0 failed
stdout contains TypeLisp package tests passed
step package-missing-sysroot
run test --manifest-path "pkg/typelisp.pkg" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot"
exit 1
stderr contains sysroot:
stderr contains stdlib.tli
step package-no-prebuilt
run test --manifest-path "pkg/typelisp.pkg" --target {{host-target}} --sysroot "{{dir}}/missing-sysroot" --no-prebuilt-stdlib
stdout contains TypeLisp package tests passed
cwd -

# Metadata-only `.tli` extraction (`compile --emit-tli`) and hydration
# (`compile --extra-tli` in standalone and `--batch` modes), including macro
# expansion with module-local import aliases and negative CLI checks.
case extra-tli-emit-and-hydrate
file extra_lib/helper.tl
(define (extra-add [a : i64] [b : i64]) : i64
  (+ a b))
end-file
file extra_lib/mylib.tl
(import helper as h)

(define (mylib-double [x : i64]) : i64
  (h.extra-add x x))

(defmacro (mylib-bump [x : Expr]) : Expr
  `(h.extra-add ,x 1))
end-file
file extra_lib/root.tl
(import mylib)

(define (main) : i64
  (mylib.mylib-double 1))
end-file
file consumer_a.tl
(import mylib)

(define (main) : i64
  (mylib.mylib-bump (mylib.mylib-double 20)))
end-file
file consumer_b.tl
(import mylib)

(define (main) : i64
  (mylib.mylib-double 21))
end-file
cwd {{dir}}
step emit-tli
run compile "extra_lib/root.tl" --emit-tli --target {{host-target}} --stdlib-root "{{root}}/stdlib" --stdlib-root "{{dir}}/extra_lib" -o "{{dir}}/mylib.tli"
stderr empty
stdout contains Wrote
step inspect-tli
run inspect "{{dir}}/mylib.tli"
stderr empty
stdout contains format: tli
stdout contains mylib:
stdout contains helper:
step hydrate-standalone-a
run compile "consumer_a.tl" --target {{host-target}} --stdlib-root "{{root}}/stdlib" --stdlib-root "{{dir}}/extra_lib" --extra-tli "{{dir}}/mylib.tli" -o "{{dir}}/a-standalone.s"
stderr empty
in file {{dir}}/a-standalone.s
contains .extern _tl_
not-contains mylib_double:
not-contains extra_add:
step hydrate-standalone-b
run compile "consumer_b.tl" --target {{host-target}} --stdlib-root "{{root}}/stdlib" --stdlib-root "{{dir}}/extra_lib" --extra-tli "{{dir}}/mylib.tli" -o "{{dir}}/b-standalone.s"
stderr empty
in file {{dir}}/b-standalone.s
contains .extern _tl_
not-contains mylib_double:
not-contains extra_add:
sh printf '%s|%s\n%s|%s\n' "consumer_a.tl" "{{dir}}/a-batch.s" "consumer_b.tl" "{{dir}}/b-batch.s" > "{{dir}}/batch.txt"
step hydrate-batch
run compile --batch "{{dir}}/batch.txt" --target {{host-target}} --stdlib-root "{{root}}/stdlib" --stdlib-root "{{dir}}/extra_lib" --extra-tli "{{dir}}/mylib.tli"
stderr empty
sh cmp -s "{{dir}}/a-standalone.s" "{{dir}}/a-batch.s" && cmp -s "{{dir}}/b-standalone.s" "{{dir}}/b-batch.s"
step error-missing-extra-tli
run compile "consumer_a.tl" --target {{host-target}} --stdlib-root "{{root}}/stdlib" --stdlib-root "{{dir}}/extra_lib" --extra-tli "{{dir}}/does-not-exist.tli" -o "{{dir}}/err.s"
exit nonzero
stderr contains does-not-exist.tli
step error-emit-tli-with-emit-ir
run compile "extra_lib/mylib.tl" --emit-tli --emit-ir --target {{host-target}} -o "{{dir}}/bad.tli"
exit nonzero
stderr contains --emit-tli
step error-emit-tli-with-batch
run compile --batch "{{dir}}/batch.txt" --emit-tli --target {{host-target}}
exit nonzero
stderr contains --emit-tli
cwd -
