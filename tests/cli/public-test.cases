# The inline test command, package test discovery and test backend modes
# (gate stage2-public-tool-surface).
do none
target -
opt -

file inline_test_pass.tl
(import stdlib.test)

(define (inc [x : i64]) : i64 (+ x 1))

(define (main) : i64 0)

(test inc-basic
  (test.assert-i64-eq (inc 41) 42 "inc result"))

(test inc-zero
  (test.assert-i64-eq (inc 0) 1 "inc zero"))
end-file

file inline_test_fail.tl
(import stdlib.test)

(test passes-before
  (test.assert-true true "before"))

(test failing-case
  (test.assert-i64-eq 1 2 "first inline failure")
  (test.assert-true false "second inline failure"))

(test passes-after
  (test.assert-true true "after"))
end-file

file inline_test_metadata.tl
(test ordinary unit)
(test needle unit)
(test needle-extra unit)
(test ignored (:ignore "tracked issue") unit)
(test slow (:slow) unit)
(test ignored-slow (:ignore "waiting for dependency") (:slow) unit)
(cfg replayable-test-cfg (test cfg-enabled unit))
end-file

case inline-test-check
run test --check "{{work}}/inline_test_pass.tl" --target {{host-target}} --stdlib-root "{{root}}/stdlib"
stderr empty
stdout contains TypeLisp test typecheck passed: 2 test(s)

# #9684: a typecheck diagnostic located at the start of a file names the
# source path and line under `test --check` exactly as under `check`, for a
# file with no tests, a file with tests, a package source with inline tests and
# a package integration test.
case test-check-start-of-file-diagnostic-path
file unknown_type_no_tests.tl
(define (f) : Nope 0)
end-file
file unknown_type_with_test.tl
(define (f) : Nope 0)
(test uses-f (f) unit)
end-file
file pkg/typelisp.pkg
(package (name "start_diag_pkg") (version "0.1.0") (kind "lib") (entry "src/lib.tl"))
end-file
file pkg/src/lib.tl
(define (g) : i64 1)
end-file
file pkg/src/inline.tl
(define (f) : Nope 0)
(test uses-f (f) unit)
end-file
file integration/typelisp.pkg
(package (name "start_diag_int") (version "0.1.0") (kind "lib") (entry "src/lib.tl"))
end-file
file integration/src/lib.tl
(define (g) : i64 1)
end-file
file integration/tests/unknown.tl
(define (h) : Nope 0)
(define (main) : i64 (begin (h) 0))
end-file
