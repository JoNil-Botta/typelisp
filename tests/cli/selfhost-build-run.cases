# Changing commit metadata may change only the named forty-byte provenance
# field. Exercise the production identity module, both version inputs and the
# ordinary unstamped source-tool fallback at every optimization level.
case compiler-commit-stamp-field
opt 0 1 2
file identity/src/main.tl
(import compiler_build_identity as identity)
(import stdlib.io)
(define (main) : i64
  (io.print-format "{}\n{}\n"
    (identity.compiler-build-git-hash-shared-view)
    (identity.compiler-build-producer-identity))
  0)
end-file
file identity/target/build-stage0/tree-hash.txt
0123456789abcdef0123456789abcdef01234567
end-file
file stamp-a.expected
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
0123456789abcdef0123456789abcdef01234567
end-file
file stamp-b.expected
ffffffffffffffffffffffffffffffffffffffff
0123456789abcdef0123456789abcdef01234567
end-file
file unstamped.expected
unknown
unknown
end-file
sh cp "{{root}}/src/compiler_build_identity.tl" "{{dir}}/identity/src/compiler_build_identity.tl"
sh printf '%s' 0123456789abcdef0123456789abcdef01234567 > "{{dir}}/identity/target/build-stage0/tree-hash.txt"
sh printf '%s' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa > "{{dir}}/identity/target/build-stage0/git-hash.txt"
run compile "{{dir}}/identity/src/main.tl" -o "{{dir}}/a.s" --target {{host-target}} --opt-level {{opt}} --cfg compiler-build-identity --stdlib-root "{{dir}}/identity/src"
stderr empty
stdout match Wrote[ ]
run build "{{dir}}/identity/src/main.tl" -o "{{dir}}/stamp-a{{exe}}" --target {{host-target}} --opt-level {{opt}} --cfg compiler-build-identity --stdlib-root "{{dir}}/identity/src"
stderr empty
exec "{{dir}}/stamp-a{{exe}}"
stderr empty
same "{{stdout}}" "{{dir}}/stamp-a.expected"
sh printf '%s\r\n' ffffffffffffffffffffffffffffffffffffffff > "{{dir}}/identity/target/build-stage0/git-hash.txt"
run compile "{{dir}}/identity/src/main.tl" -o "{{dir}}/b.s" --target {{host-target}} --opt-level {{opt}} --cfg compiler-build-identity --stdlib-root "{{dir}}/identity/src"
stderr empty
stdout match Wrote[ ]
run build "{{dir}}/identity/src/main.tl" -o "{{dir}}/stamp-b{{exe}}" --target {{host-target}} --opt-level {{opt}} --cfg compiler-build-identity --stdlib-root "{{dir}}/identity/src"
stderr empty
exec "{{dir}}/stamp-b{{exe}}"
stderr empty
same "{{stdout}}" "{{dir}}/stamp-b.expected"
test "$(grep -c '^_tl_.*compiler_build_commit_bytes:$' "{{dir}}/a.s")" = 1
test "$(grep -c '^_tl_.*compiler_build_commit_bytes:$' "{{dir}}/b.s")" = 1
sh sed '/^_tl_.*compiler_build_commit_bytes:$/,/^    \.balign 8$/ { /^    \.byte /d; }' "{{dir}}/a.s" > "{{dir}}/a-normal.s"
sh sed '/^_tl_.*compiler_build_commit_bytes:$/,/^    \.balign 8$/ { /^    \.byte /d; }' "{{dir}}/b.s" > "{{dir}}/b-normal.s"
test "$(grep -c '^    \.byte ' "{{dir}}/a.s")" -gt "$(grep -c '^    \.byte ' "{{dir}}/a-normal.s")"
sh cmp "{{dir}}/a-normal.s" "{{dir}}/b-normal.s"
sh printf '%s' gggggggggggggggggggggggggggggggggggggggg > "{{dir}}/identity/target/build-stage0/git-hash.txt"
run compile "{{dir}}/identity/src/main.tl" -o "{{dir}}/invalid.s" --target {{host-target}} --opt-level {{opt}} --cfg compiler-build-identity --stdlib-root "{{dir}}/identity/src"
