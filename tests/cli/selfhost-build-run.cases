# Public build/run of the freshly bootstrapped compiler: source and package
# builds, the root package (the compiler itself), package graphs, git
# dependencies, the package cache and lock, scaffolding, run, REPL and the
# work-queue chooser (gate stage2-cli-build-run-and-chooser-smoke).
do none
target -
opt -

file wide-and.tl
(define (unconstrained-default) : i32
  (let
    [x (+ 1 2)]
    x))

(define (contextual-i64) : i64
  (let
    [x : i64 1]
    x))

(define (explicit-wide-cast) : i64
  (cast (cast 0x100000000 : u64) : i64))

(define (main) : i64
  (if (and
    (= (unconstrained-default) 3)
    (= (contextual-i64) 1)
    (= (explicit-wide-cast) 4294967296))
    42
    1))
end-file

case selfhost-cli-compile
file main.tl
(define (main) : i64 23)
end-file
run compile "{{dir}}/main.tl" -o "{{dir}}/main.s"
stderr empty
stdout match Wrote[ ]
in file {{dir}}/main.s
contains main:

case selfhost-cli-build-macro-dotted-root
opt 0 1 2
step nested
run build "{{root}}/tests/integration/macro_dotted_root_nested.tl" --opt-level {{opt}} -o "{{dir}}/nested{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/nested{{exe}}"
exit 6
stdout empty
stderr empty
step scalar
run build "{{root}}/tests/integration/macro_dotted_root_scalar.tl" --opt-level {{opt}} -o "{{dir}}/scalar{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/scalar{{exe}}"
exit 2
stdout empty
stderr empty
step small
run build "{{root}}/tests/integration/macro_dotted_root_small.tl" --opt-level {{opt}} -o "{{dir}}/small{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/small{{exe}}"
exit 2
stdout empty
stderr empty
step layout
run build "{{root}}/tests/integration/macro_dotted_root_layout.tl" --opt-level {{opt}} -o "{{dir}}/layout{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/layout{{exe}}"
exit 2
stdout empty
stderr empty
step same
run build "{{root}}/tests/integration/macro_dotted_root_same.tl" --opt-level {{opt}} -o "{{dir}}/same{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/same{{exe}}"
exit 2
stdout empty
stderr empty

case selfhost-cli-build-macro-dotted-root-borrow
opt 0 1 2
step shared
run build "{{root}}/tests/integration/macro_dotted_root_borrow.tl" --opt-level {{opt}} -o "{{dir}}/shared{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/shared{{exe}}"
exit 2
stdout empty
stderr empty
step mutable
run build "{{root}}/tests/integration/macro_dotted_root_mut_borrow.tl" --opt-level {{opt}} -o "{{dir}}/mutable{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/mutable{{exe}}"
exit 2
stdout empty
stderr empty
step reference
run build "{{root}}/tests/integration/macro_dotted_root_ref_borrow.tl" --opt-level {{opt}} -o "{{dir}}/reference{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/reference{{exe}}"
exit 2
stdout empty
stderr empty
step nested
run build "{{root}}/tests/integration/macro_dotted_root_nested_borrow.tl" --opt-level {{opt}} -o "{{dir}}/nested{{exe}}"
stderr empty
stdout match Built[ ]
exec "{{dir}}/nested{{exe}}"
exit 6
stdout empty
stderr empty

case selfhost-cli-build
file main.tl
(define (main) : i64 19)
end-file
run build "{{dir}}/main.tl" -o "{{dir}}/built-program{{exe}}"
stderr empty
stdout match Built[ ]
test -f "{{dir}}/built-program{{exe}}"
step built-program
exec "{{dir}}/built-program{{exe}}"
exit 19
stdout empty
stderr empty

# A source build links into a private directory beside its destination and
# replaces the destination only after the linker succeeded (#8192): a failed
# GNU `ld` deletes the file it was told to write. No private directory
# survives a success or a failure.
case selfhost-cli-build-failed-link-keeps-output
file unresolved.tl
(extern (missing-8192) : i64 (:symbol "tl_missing_8192"))
(define (main) : i64 (missing-8192))
end-file
sh printf 'previous build output\n' > "{{dir}}/kept{{exe}}"
sh chmod 640 "{{dir}}/kept{{exe}}"
# The reference copy keeps the {{exe}} suffix because MSYS derives the mode
# bits on Windows from the file name.
sh cp -p "{{dir}}/kept{{exe}}" "{{dir}}/kept-expected{{exe}}"
run build "{{dir}}/unresolved.tl" -o "{{dir}}/kept{{exe}}"
exit nonzero
same "{{dir}}/kept{{exe}}" "{{dir}}/kept-expected{{exe}}"
test "$(stat -c %a "{{dir}}/kept{{exe}}")" = "$(stat -c %a "{{dir}}/kept-expected{{exe}}")"
test "$(ls -A "{{dir}}" | grep -c '^[.]typelisp-link')" = 0

case selfhost-cli-build-replaces-output
file main.tl
(define (main) : i64 19)
end-file
sh printf 'stale output\n' > "{{dir}}/replaced{{exe}}"
run build "{{dir}}/main.tl" -o "{{dir}}/replaced{{exe}}"
stderr empty
stdout match Built[ ].*replaced
test -x "{{dir}}/replaced{{exe}}"
test "$(ls -A "{{dir}}" | grep -c '^[.]typelisp-link')" = 0
exec "{{dir}}/replaced{{exe}}"
exit 19

# A replace that fails (here onto a directory) leaves the destination alone and
# nothing private behind.
case selfhost-cli-build-replace-failure-cleans-up
file main.tl
(define (main) : i64 19)
end-file
sh mkdir -p "{{dir}}/occupied/inner"
run build "{{dir}}/main.tl" -o "{{dir}}/occupied"
exit nonzero
stderr contains build: failed to replace
test -d "{{dir}}/occupied/inner"
test "$(ls -A "{{dir}}" | grep -c '^[.]typelisp-link')" = 0

# Relative default and nested `-o` destinations; a destination whose parent is
# missing is linked directly, so the linker still reports it.
case selfhost-cli-build-relative-destinations
file nested/prog.tl
(define (main) : i64 23)
end-file
sh mkdir -p "{{dir}}/out/bin"
cwd .
step default
run build nested/prog.tl
stderr empty
stdout is Built nested/prog{{exe}}
exec "{{dir}}/nested/prog{{exe}}"
exit 23
step nested-output
run build nested/prog.tl -o out/bin/prog{{exe}}
stderr empty
stdout is Built out/bin/prog{{exe}}
test "$(ls -A out/bin | grep -c '^[.]typelisp-link')" = 0
exec "{{dir}}/out/bin/prog{{exe}}"
exit 23
step missing-parent
run build nested/prog.tl -o missing/prog{{exe}}
exit nonzero
test ! -e missing
test "$(ls -A nested | grep -c '^[.]typelisp-link')" = 0

# The private directory shares the destination's filesystem, not $TMPDIR's.
case selfhost-cli-build-tmpdir-other-filesystem
hosts linux
file main.tl
(define (main) : i64 19)
end-file
test -d /dev/shm
test "$(stat -f -c %T /dev/shm)" != "$(stat -f -c %T "{{dir}}")" -o "$(stat -c %d /dev/shm)" != "$(stat -c %d "{{dir}}")"
sh mkdir -p "/dev/shm/typelisp-8192-$$" && TMPDIR="/dev/shm/typelisp-8192-$$" "{{compiler}}" build "{{dir}}/main.tl" -o "{{dir}}/cross" > "{{dir}}/cross.out" && rmdir "/dev/shm/typelisp-8192-$$"
in file {{dir}}/cross.out
contains Built
exec "{{dir}}/cross"
exit 19

# A Windows debug build keeps its PDB beside the destination, named after it.
case selfhost-cli-build-debug-pdb
hosts windows
file main.tl
(define (main) : i64 19)
end-file
run build "{{dir}}/main.tl" -g -o "{{dir}}/debug-prog.exe"
stdout match Built[ ]
test -f "{{dir}}/debug-prog.pdb"
test "$(ls -A "{{dir}}" | grep -c '^[.]typelisp-link')" = 0
exec "{{dir}}/debug-prog.exe"
exit 19

case selfhost-cli-default-wide-and
step selfhost-cli-build-default-wide-and
run build "{{work}}/wide-and.tl" -o "{{dir}}/wide-and{{exe}}" --target {{host-target}}
stderr empty
stdout match Built[ ]
test -f "{{dir}}/wide-and{{exe}}"
exec "{{dir}}/wide-and{{exe}}"
exit 42
stdout empty
stderr empty
step selfhost-cli-run-default-wide-and
run run "{{work}}/wide-and.tl" --target {{host-target}}
exit 42
stdout empty
stderr empty

# Selected macro aliases follow generated exports through package preparation.
case selfhost-cli-package-selected-generated-macro
opt 0 1 2
file pkg/typelisp.pkg
(package (name "selected_generated_macro") (version "0.1.0") (kind bin))
end-file
sh mkdir -p "{{dir}}/pkg/src"
sh cp "{{root}}/tests/integration/source_selected_generated_export.tl" "{{dir}}/pkg/src/main.tl"
sh cp "{{root}}/tests/integration/source_selected_generated_dep.tl" "{{root}}/tests/integration/source_selected_generated_macro_dep.tl" "{{root}}/tests/integration/source_selected_generated_user.tl" "{{root}}/tests/integration/source_selected_generated_shadow.tl" "{{dir}}/pkg/src/"
run build --manifest-path "{{dir}}/pkg/typelisp.pkg" --target {{host-target}} --opt-level {{opt}}
stderr empty
stdout match Built[ ]
exec "{{dir}}/pkg/target/release/selected_generated_macro{{exe}}"
exit 42
stdout empty
stderr empty

# Generated target predicates survive package preparation, lowering and
# direct-object/assembly emission (#7812). The root package build derives the
# checked-in source identity itself: the shared bootstrap stamp is poisoned.
case selfhost-cli-package
file pkg/typelisp.pkg
(package
  (name "cli_pkg_smoke")
  (version "0.1.0")
  (kind bin))
end-file
file pkg/src/main.tl
(defmacro (target-module) : Module
  (let [head : Expr (expr-var "cfg")]
    `(begin
      (module generated.package_cfg)
      (,head linux (define (answer) : i64 29))
      (,head windows (define (answer) : i64 29))
      (,head (all linux windows) (import nonexistent_package_cfg_dependency)))))
(import (target-module) as selected)
(define (main) : i64 (selected.answer))
end-file
cwd pkg
step selfhost-cli-package-build
run build --target {{host-target}} --opt-level 0
stderr empty
stdout match Built[ ]
test -f "{{dir}}/pkg/target/release/cli_pkg_smoke{{exe}}"
step package-program
exec "{{dir}}/pkg/target/release/cli_pkg_smoke{{exe}}"
exit 29
stdout empty
stderr empty
sh rm -rf "{{dir}}/pkg/target"
step selfhost-cli-package-run-default
run run --target {{host-target}} --opt-level 0
exit 29
stdout empty
stderr empty
test -f "{{dir}}/pkg/target/release/cli_pkg_smoke{{exe}}"
sh rm -rf "{{dir}}/pkg/target"
step selfhost-cli-package-build-dev
run build --target {{host-target}} --profile dev
stderr empty
stdout match Built[ ]
test -f "{{dir}}/pkg/target/dev/cli_pkg_smoke{{exe}}"
sh CCV_head=$(git -C "{{root}}" rev-parse HEAD | tr -d '\r\n')
sh CCV_tree=$(git -C "{{root}}" rev-parse 'HEAD^{tree}' | tr -d '\r\n')
sh rm -rf "{{root}}/target/release" && mkdir -p "{{root}}/target/build-stage0"
sh printf '%s' 0000000000000000000000000000000000000000 > "{{root}}/target/build-stage0/git-hash.txt"
sh printf '%s' 0000000000000000000000000000000000000000 > "{{root}}/target/build-stage0/tree-hash.txt"
step selfhost-cli-root-package-build
cwd {{root}}
run build --target {{host-target}} --opt-level 0
stderr empty
stdout match Built[ ]
test -f "{{root}}/target/release/typelisp{{exe}}"
in file {{root}}/target/build-stage0/git-hash.txt
contains {{head}}
not-contains 0000000000000000000000000000000000000000
in file {{root}}/target/build-stage0/tree-hash.txt
contains {{tree}}
not-contains 0000000000000000000000000000000000000000
cwd -
step selfhost-cli-root-package-help
exec "{{root}}/target/release/typelisp{{exe}}" --help
stdout empty
in stderr
contains Usage:
contains Synopsis:
contains Commands:
contains typelisp build          Build a source file or package artifact
contains typelisp explain        Explain a diagnostic code
contains typelisp inspect        Inspect a TypeLisp comptime image
contains Run `typelisp <command> --help` for command-specific usage.
step selfhost-cli-root-package-version
exec "{{root}}/target/release/typelisp{{exe}}" --version
stderr empty
stdout match typelisp[ ]
stdout contains {{head}}
stdout match [ ]built[ ]
stdout not-contains typelisp unknown
step selfhost-cli-root-package-producer-identity
exec "{{root}}/target/release/typelisp{{exe}}" --producer-identity
stderr empty
stdout contains {{tree}}
stdout not-contains unknown
step selfhost-cli-root-package-build-help
exec "{{root}}/target/release/typelisp{{exe}}" build --help
stdout empty
in stderr
contains Summary:
contains typelisp build [--manifest-path <typelisp.pkg>]
contains --locked
contains --update-lock
sh rm -rf "{{dir}}/pkg/target"
step selfhost-cli-root-package-downstream-run
cwd pkg
exec "{{root}}/target/release/typelisp{{exe}}" run --target {{host-target}} --opt-level 0
exit 29
stdout empty
stderr empty
cwd -
# A library package cannot declare normal dependencies: the parent archive is
# not built and the child is not resolved.
file libdep/root/typelisp.pkg
(package
  (name "library_dependency_path_root")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (layer "../layer")))
end-file
file libdep/root/src/main.tl
(define (main) : i64 0)
end-file
file libdep/layer/typelisp.pkg
(package
  (name "path_layer")
  (version "0.1.0")
  (kind staticlib)
  (dependencies
    (runtime "../runtime")))
end-file
file libdep/layer/src/lib.tl
(define (layer-answer) : i64 42)
end-file
file libdep/runtime/typelisp.pkg
(package
  (name "path_runtime")
  (version "0.1.0")
  (kind staticlib))
end-file
file libdep/runtime/src/lib.tl
(define (runtime-answer) : i64 42)
end-file
step selfhost-cli-package-library-dependency-path
exec "{{root}}/target/release/typelisp{{exe}}" build --manifest-path "{{dir}}/libdep/root/typelisp.pkg" --target {{host-target}} --opt-level 0
exit 1
stdout empty
stderr contains library package `path_layer` cannot declare normal dependency `runtime`
stderr contains declare `runtime` directly in the consuming application
stderr contains use `link` for native libraries
test ! -d "{{dir}}/libdep/layer/target"
test ! -d "{{dir}}/libdep/runtime/target"

# A prefetched git dependency checkout builds without the network.
case selfhost-cli-package-graph-github-prefetch
file root/typelisp.pkg
(package
  (name "github_prefetch_root")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (remote (github "JoNil-Botta/typelisp-test-dep" (rev "abc123")))))
end-file
file root/src/main.tl
(import remote.src.lib as remote)
(define (main) : i64 (remote.remote-answer))
end-file
file root/target/typelisp/git-deps/remote/typelisp.pkg
(package
  (name "github_prefetch_remote")
  (version "0.1.0")
  (kind staticlib))
end-file
file root/target/typelisp/git-deps/remote/src/lib.tl
(define (remote-answer) : i64 43)
end-file
run build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
stdout contains Built {{native-dir}}/root/target/typelisp/git-deps/remote/target/release/{{lib-prefix}}github_prefetch_remote{{lib-suffix}}
stdout contains Built {{native-dir}}/root/target/release/github_prefetch_root{{exe}}
step package-graph-github-prefetch-program
exec "{{dir}}/root/target/release/github_prefetch_root{{exe}}"
exit 43
stdout empty
stderr empty

# The package cache: a first fetch fills it, an offline rebuild hits it, a
# cache entry is confined to its locked checkout, and a corrupt entry is
# preserved and refetched. The git remote is local, through insteadOf.
# Windows: the package cache nests its git staging checkout under the case
# directory and git refuses a $GIT_DIR over 220 characters, so the three
# remote-package cases keep short ids (the runner uses them as directory
# names; see verify-selfhost-cli-build-run.sh).
case ghc
file remote/typelisp.pkg
(package
  (name "gc_remote")
  (version "0.1.0")
  (kind staticlib))
end-file
file remote/src/lib.tl
(define (remote-answer) : i64 47)
end-file
sh git -C "{{dir}}/remote" init -q && git -C "{{dir}}/remote" add typelisp.pkg src/lib.tl
sh git -C "{{dir}}/remote" -c user.email=typelisp@example.invalid -c user.name=typelisp commit -q -m "seed cache smoke remote"
sh CCV_rev=$(git -C "{{dir}}/remote" rev-parse HEAD)
file -x root/typelisp.pkg
(package
  (name "gc_root")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (remote (github "a/b" (rev "{{rev}}")))))
end-file
file root/src/main.tl
(import remote.src.lib as remote)
(define (main) : i64 (remote.remote-answer))
end-file
file -x gitconfig
[url "{{dir}}/remote"]
    insteadOf = https://github.com/a/b.git
end-file
sh CCV_gitconfig=$(cc_native_path "{{dir}}/gitconfig")
step selfhost-cli-package-graph-github-cache-first
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
stdout contains Built {{native-dir}}/root/target/release/gc_root{{exe}}
sh CCV_entry=$(find "{{dir}}/root/target/typelisp/cache/packages/v1/git" -name typelisp.pkg -print | head -n 1)
test -n "{{entry}}"
sh CCV_entry=${CCV_entry%/typelisp.pkg}
test -f "{{entry}}/.typelisp-cache-complete"
in file {{entry}}/typelisp-cache-entry.txt
contains url=https://github.com/a/b.git
contains commit={{rev}}
test -f "{{dir}}/root/typelisp.lock"
in file {{dir}}/root/typelisp.lock
contains (typelisp-lock
contains (alias "remote")
contains (url "https://github.com/a/b.git")
contains (pin (rev "{{rev}}"))
contains (commit "{{rev}}")
sh mv "{{dir}}/remote" "{{dir}}/remote.offline"
step selfhost-cli-package-graph-github-cache-hit
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
stdout contains Fresh {{native-dir}}/root/target/release/gc_root{{exe}}
sh mv "{{entry}}" "{{entry}}.saved" && cp -R "{{entry}}.saved" "{{entry}}.manifest-outside"
sh echo outside-manifest-sentinel-was-read > "{{entry}}.manifest-outside/typelisp.pkg"
sh cc_dir_link "{{entry}}" "{{entry}}.manifest-outside"
step selfhost-cli-package-graph-github-cache-root-confined
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0 --locked
exit 1
stdout empty
stderr contains build: fetched package `remote` field `manifest` path `typelisp.pkg` is not confined to locked checkout `
stderr not-contains outside-manifest-sentinel-was-read
sh cc_dir_unlink "{{entry}}" && mv "{{entry}}.saved" "{{entry}}" && rm -rf "{{entry}}.manifest-outside"
sh mv "{{entry}}/src" "{{entry}}/src.saved" && mkdir -p "{{entry}}.outside"
sh echo outside-sentinel-was-read > "{{entry}}.outside/lib.tl"
sh cc_dir_link "{{entry}}/src" "{{entry}}.outside"
step selfhost-cli-package-graph-github-cache-confined
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0 --locked
exit 1
stdout empty
stderr contains build: fetched package `gc_remote` field `entry` path `src/lib.tl` is not confined to locked checkout `
stderr not-contains outside-sentinel-was-read
sh cc_dir_unlink "{{entry}}/src" && mv "{{entry}}/src.saved" "{{entry}}/src" && rm -rf "{{entry}}.outside"
sh mv "{{dir}}/remote.offline" "{{dir}}/remote"
sh printf 'typelisp-package-cache-v1\nurl=%s\ncommit=stale\n' https://github.com/a/b.git > "{{entry}}/typelisp-cache-entry.txt"
step selfhost-cli-package-graph-github-cache-refetch
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
stdout contains Fresh {{native-dir}}/root/target/release/gc_root{{exe}}
test -d "{{entry}}.corrupt.1"
in file {{entry}}/typelisp-cache-entry.txt
contains commit={{rev}}
step package-graph-github-cache-program
exec "{{dir}}/root/target/release/gc_root{{exe}}"
exit 47
stdout empty
stderr empty

# typelisp.lock: --locked needs an entry, the first build writes it, an
# equivalent build keeps it byte- and mtime-identical, --locked replays it
# offline, a moved pin is stale under --locked, failed transactions keep the
# old lock, --update-lock moves it, and concurrent writers serialize.
# Short id for Windows paths; see ghc.
case gl
sh . "{{root}}/scripts/lib-package-lock-test-wait.sh"
file remote/typelisp.pkg
(package
  (name "gl_remote")
  (version "0.1.0")
  (kind staticlib))
end-file
file remote/src/lib.tl
(define (remote-answer) : i64 51)
end-file
sh git -C "{{dir}}/remote" init -q && git -C "{{dir}}/remote" add typelisp.pkg src/lib.tl
sh git -C "{{dir}}/remote" -c user.email=typelisp@example.invalid -c user.name=typelisp commit -q -m "seed lock smoke remote"
sh git -C "{{dir}}/remote" branch -M main && CCV_rev1=$(git -C "{{dir}}/remote" rev-parse HEAD)
file root/typelisp.pkg
(package
  (name "gl_root")
  (version "0.1.0")
  (kind bin)
  (dependencies
    (remote (github "l/b" (branch "main")))))
end-file
file root/src/main.tl
(import remote.src.lib as remote)
(define (main) : i64 (remote.remote-answer))
end-file
file -x gitconfig
[url "{{dir}}/remote"]
    insteadOf = https://github.com/l/b.git
end-file
sh CCV_gitconfig=$(cc_native_path "{{dir}}/gitconfig")
step selfhost-cli-package-graph-github-lock-missing
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0 --locked
exit 1
stdout empty
stderr contains build: --locked requires typelisp.lock entry for remote dependency `remote`
test ! -f "{{dir}}/root/typelisp.lock"
step selfhost-cli-package-graph-github-lock-first
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
in file {{dir}}/root/typelisp.lock
contains (pin (branch "main"))
contains (commit "{{rev1}}")
step package-graph-github-lock-first-program
exec "{{dir}}/root/target/release/gl_root{{exe}}"
exit 51
stdout empty
stderr empty
file remote/src/lib.tl
(define (remote-answer) : i64 52)
end-file
sh git -C "{{dir}}/remote" add src/lib.tl
sh git -C "{{dir}}/remote" -c user.email=typelisp@example.invalid -c user.name=typelisp commit -q -m "move branch after lock"
sh CCV_rev2=$(git -C "{{dir}}/remote" rev-parse HEAD) && rm -rf "{{dir}}/root/target/typelisp/git-deps"
sh touch -r "{{dir}}/root/typelisp.lock" "{{dir}}/lock-before-replay.mtime" && sleep 2
step selfhost-cli-package-graph-github-lock-replay
exec env GIT_CONFIG_GLOBAL="{{gitconfig}}" "{{compiler}}" build --manifest-path "{{dir}}/root/typelisp.pkg" --target {{host-target}} --opt-level 0
stderr empty
in file {{dir}}/root/typelisp.lock
contains (commit "{{rev1}}")
test ! "{{dir}}/root/typelisp.lock" -nt "{{dir}}/lock-before-replay.mtime"
test ! "{{dir}}/lock-before-replay.mtime" -nt "{{dir}}/root/typelisp.lock"
step package-graph-github-lock-replay-program
exec "{{dir}}/root/target/release/gl_root{{exe}}"
exit 51
stdout empty
