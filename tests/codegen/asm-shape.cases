# opt2 assembly-shape gates for the regalloc/backend/optimizer fixtures (gate
# stage2-regalloc-backend-asm-shape-gates). The native integration manifest
# proves these fixtures still run correctly; these rows prove the optimizing
# shapes still fire, because a slow-but-correct fallback keeps every exit code
# green. Function bodies (`in fn`) end at the next column-0 .globl or the
# function's .size, so the hand-written runtime prelude is never part of one.

args --stdlib-root {{root}}/stdlib --stdlib-root {{root}}/src

# SROA-2: the four-word enum of the lattice join lives in registers -- no frame,
# no wide copy, no frame-slot store or compare; JT-2 threads the equality match
# away, leaving the three payload-word compares against memory.
case lattice-join-split
source tests/integration/lattice_join_split.tl
in fn _tl_lattice_join_split_lat_bind
not-match ^[[:space:]]+subq \$[0-9]+, %rsp$
not-contains movups
not-match ^[[:space:]]+movq %[a-z0-9]+, -?[0-9]+\(%rsp\)$
not-match ^[[:space:]]+cmpq -?[0-9]+\(%rsp\), %
not-match ^[[:space:]]+cmpq \$1, %[a-z0-9]+$
count >= 3 ^[[:space:]]+cmpq [0-9]+\(%r[a-z0-9]+\), %r[a-z0-9]+$

# UNR-1: the word-then-tail piece copy inlined into copy-fill!: the unsigned
# `n / 8` is one shift, the word loop's guard is `lea; test; jg`, and the byte
# tail is not versioned (one guard, one byte copy).
case short-trip-copy
source tests/integration/short_trip_copy.tl
in fn _tl_short_trip_copy_copy_fill_bang
match ^[[:space:]]+shrq \$3, %r
not-match ^[[:space:]]+sarq \$63, %r
after ^[[:space:]]+leaq -4[(]%r[a-z0-9]+[)], %r
next-line ^[[:space:]]+testq %r[a-z0-9]+, %r
not-match ^[[:space:]]+leaq -2\(%r[a-z0-9]+\), %r
count = 1 __unroll_guard:$
count = 1 ^[[:space:]]+movzbq[ ]

# Divisor magic hoisting: constant multiplies fold into imm32 imuls; the /7
# quotient reads the live dividend through %rax (one irreducible copy chain).
case divmagic-hoist
source tests/integration/divmagic_hoist.tl
in fn _tl_divmagic_hoist_modsum
not-contains movabsq $1000000007
count >= 1 ^[[:space:]]+imulq \$1000000007, %r[a-z0-9]+, %r[a-z0-9]+$
in fn _tl_divmagic_hoist_digitsum
count-fixed = 1 movabsq $7378697629483820647
not-contains movabsq $10
count >= 1 ^[[:space:]]+imulq \$10, %r[a-z0-9]+, %r[a-z0-9]+$
in fn _tl_divmagic_hoist_dividend_copy_pair
metric copy-chains-to-rax = 1

# A36 hoist priority: registers are awarded by site count (the three-site magic
# beats six one-site literals); ties fall back to program order.
case hoist-priority
source tests/integration/hoist_priority.tl
in fn _tl_hoist_priority_spread
count-fixed = 1 movabsq $-8543223828751151131
count >= 3 ^[[:space:]]+imulq \$1000000007, %r[a-z0-9]+, %r[a-z0-9]+$
count >= 1 ^[[:space:]]+movq \$26544357[0-9]+, %r
in fn _tl_hoist_priority_tie
count-fixed = 1 movabsq $3141592653589
count-fixed = 2 movabsq $-8543223828751151131

# LFTR retires the index counter: `walk` is absorbed into main, the loop steps
# a 16-byte pointer with one compare, and the end address is scaled once.
case lftr-counter-retire
source tests/integration/lftr_counter_retire.tl
not-contains _tl_lftr_counter_retire_walk:
in fn main
not-match ^[[:space:]]+addq \$1, %r[a-z0-9]+$
count = 1 ^[[:space:]]+leaq 16\(%r[a-z0-9]+\), %r[a-z0-9]+$
count = 1 ^[[:space:]]+cmpq %r[a-z0-9]+, %r[a-z0-9]+$
match ^[[:space:]]+(shlq \$4, %r[a-z0-9]+|imulq \$16, %r[a-z0-9]+, %r[a-z0-9]+)$
not-contains call tl_oob_abort

# No jmp may target a label reached by falling through label definitions only;
# a then-only branch loses its merge jump, a two-armed one keeps it, and the
# tail-recursive loop keeps its backward branch.
case fallthrough-jmp-chain
source tests/integration/fallthrough_jmp_chain.tl
target linux-x86_64 windows-x86_64
in fn _tl_fallthrough_jmp_chain_chain_drop_probe
metric fallthrough-jmps = 0
in fn _tl_fallthrough_jmp_chain_chain_keep_probe
metric fallthrough-jmps = 0
in fn main
metric fallthrough-jmps = 0
in fn _tl_fallthrough_jmp_chain_chain_drop_probe
match ^\.L[^ ]*_if_then\.[0-9.]+:$
match ^\.L[^ ]*_if_else\.[0-9.]+:$
match ^\.L[^ ]*_if_merge\.[0-9.]+:$
count = 0 ^[[:space:]]+jmp \.L[^ ]*_if_merge\.[0-9.]+$
metric backward-branches >= 1
in fn _tl_fallthrough_jmp_chain_chain_keep_probe
count = 1 ^[[:space:]]+jmp \.L[^ ]*_if_merge\.[0-9.]+$
metric backward-branches >= 1

# Backend block layout: a cold arm sinks behind the body, a small exit block is
# duplicated into the arm that jumps to it, and a register compare keeps IR order.
case block-layout
source tests/integration/block_layout.tl
target linux-x86_64 windows-x86_64
in fn _tl_block_layout_sink_probe
metric fallthrough-jmps = 0
in fn _tl_block_layout_dup_probe
metric fallthrough-jmps = 0
in fn _tl_block_layout_keep_probe
metric fallthrough-jmps = 0
in fn _tl_block_layout_sink_probe
after ^[[:space:]]+movzbq .*, %r[a-z0-9]+$
next-line ^[.]L.*_if_merge[.][0-9.]+
after ^[[:space:]]+movq [$]-1, %r[a-z0-9]+$
next-line ^[[:space:]]+jmp [.]L.*_if_merge[.][0-9]
count >= 2 ^[[:space:]]+j[a-z]+ \.L[^ ]*_if_else\.[0-9.]+$
in fn _tl_block_layout_dup_probe
count = 0 ^[[:space:]]+jmp \.L[^ ]*_while_exit\.[0-9.]+$
match ^\.L[^ ]*_while_exit\.[0-9.]+:$
count = 2 ^[[:space:]]+leaq \(,%r[a-z0-9]+,2\), %r[a-z0-9]+$
in fn _tl_block_layout_keep_probe
count = 1 ^[[:space:]]+jmp \.L[^ ]*_if_merge\.[0-9.]+$
match ^\.L[^ ]*_if_else\.[0-9.]+:$

# A wide constant is hoisted once in a leaf; across a call it stays in place.
case wide-const-hoist
source tests/integration/wide_const_hoist.tl
in fn _tl_wide_const_hoist_wide_leaf
count-fixed = 1 movabsq $2654435761
count >= 2 ^[[:space:]]+(imulq|xorq) %r[a-z0-9]+, %r[a-z0-9]+$
in fn _tl_wide_const_hoist_wide_call
count-fixed = 2 movq $2654435761

# A two-word call result lands directly in a caller-saved register pair.
case group-pair-home
source tests/integration/group_pair_home.tl
in fn _tl_group_pair_home_probe
contains call _tl_group_pair_home_mk
match ^[[:space:]]+movq %rax, %(r8|r9)$
match ^[[:space:]]+movq %rdx, %(r8|r9)$
not-match \(%rsp\)|\(%rbp\)

# ...also when the pair is a loop phi: no frame slots, no callee-saved copy
# (the segment-precise clobber test sees the phi is dead across the call).
case group-pair-phi-home
source tests/integration/group_pair_phi_home.tl
in fn _tl_group_pair_phi_home_probe
contains call _tl_group_pair_phi_home_mk
match ^[[:space:]]+movq %rax, %(r8|r9)$
match ^[[:space:]]+movq %rdx, %(r8|r9)$
count >= 2 ^[[:space:]]+movq %(r8|r9), %rax$
not-match ^[[:space:]]+movq [0-9]+\(%rsp\), %r(ax|dx)$

# Push-mode frames: callee-saves are pushed (never stored to slots) and a frame
# that names no slot reserves none -- only the alignment pad an even push run
# needs (analyzer dead-slot-region).
case csr-push-prologue
source tests/integration/csr_push_prologue.tl
in fn _tl_csr_push_prologue_churn3
metric csr-pushes >= 3
metric dead-slot-region = ok
not-match ^[[:space:]]+movq %r(12|13|14|15|bx|bp), -?[0-9]+\(%rsp\)$
in fn _tl_csr_push_prologue_deeprec
metric csr-pushes >= 3
metric dead-slot-region = ok
not-match ^[[:space:]]+movq %r(12|13|14|15|bx|bp), -?[0-9]+\(%rsp\)$

# RG-1 fix B: every callee-saved register the prologue pushes is named by the
# body at some width (a pushed-and-popped-only register is two wasted
# instructions per call).
case csr-unused-save
source tests/integration/csr_unused_save.tl
in fn _tl_csr_unused_save_insert_bang
metric prologue-csrs >= 1
metric unnamed-pushed-csrs = 0
in fn _tl_csr_unused_save_lookup
metric prologue-csrs >= 1
metric unnamed-pushed-csrs = 0

# ...on a call-carrying census loop, whose prologue must still keep the body's
# calls 16-byte aligned after the trim.
case csr-census-loop
source tests/integration/csr_census_loop.tl
in fn _tl_csr_census_loop_ccl_census_blocks
metric prologue-csrs >= 4
metric unnamed-pushed-csrs = 0
metric call-alignment:prologue = ok
contains call _tl_csr_census_loop_ccl_probe

# W1-frame: the frame adjust follows what the function needs -- a tail-jump
# forwarder owes nothing, an abort-only caller keeps its even push run but no
# pad, a returning caller keeps both and stays aligned.
case dead-frame-boundary
source tests/integration/dead_frame_boundary.tl
in fn tl_dfb_forward
contains jmp _tl_dead_frame_boundary_dfb_sink
not-match ^[[:space:]]+call[ ]
count = 0 ^[[:space:]]+subq \$[0-9]+, %rsp$
count = 0 ^[[:space:]]+addq \$[0-9]+, %rsp$
in fn tl_dfb_abort_only
metric csr-pushes >= 2
metric csr-pushes-parity = even
contains call tl_oob_abort
count = 1 ^[[:space:]]+call[ ]
count = 0 ^[[:space:]]+subq \$[0-9]+, %rsp$
count = 0 ^[[:space:]]+addq \$[0-9]+, %rsp$
in fn _tl_dead_frame_boundary_dfb_returning
contains call _tl_dead_frame_boundary_dfb_probe
metric call-alignment:pushes = ok

# The frameless abort-only shape at opt2, and its located abort splitter really
# firing from an %rsp that is 0 mod 16 (the safety corpus only runs opt0).
case dead-frame-abort-only-trap
source tests/safety/dead_frame_abort_only_trap.tl
in fn _tl_dead_frame_abort_only_trap_probe
metric csr-pushes >= 2
metric csr-pushes-parity = even
contains call tl_oob_abort_at
count = 0 ^[[:space:]]+subq \$[0-9]+, %rsp$
count = 0 ^[[:space:]]+addq \$[0-9]+, %rsp$

case dead-frame-abort-only-trap-run
source tests/safety/dead_frame_abort_only_trap.tl
do build-run
exit 134
in stderr
contains array index out of bounds: index=7 length=4

# Win64 reserves shadow space for every call-shaped instruction, so none of the
# three may lose its stack adjustment there, and callers stay aligned.
case dead-frame-boundary-win64
source tests/integration/dead_frame_boundary.tl
target windows-x86_64
in fn tl_dfb_forward
contains jmp _tl_dead_frame_boundary_dfb_sink
metric call-alignment:0 = ok
match \.seh_stackalloc[ ]
in fn tl_dfb_abort_only
contains call tl_oob_abort
match \.seh_stackalloc[ ]
in fn _tl_dead_frame_boundary_dfb_returning
contains call _tl_dead_frame_boundary_dfb_probe
metric call-alignment:pushes = ok

# Red zone: a call-free leaf with a small frame uses the 128 bytes below %rsp
# instead of adjusting it; a big frame, a call or Win64 still adjust.
case red-zone-leaf
source tests/integration/red_zone_leaf.tl
in fn tl_rzl_slots
count = 0 ^[[:space:]]+call[ ]
count = 0 ^[[:space:]]+subq \$[0-9]+, %rsp$
count = 0 ^[[:space:]]+addq \$[0-9]+, %rsp$
metric distinct:-[0-9]+\(%rsp\) >= 3
match [-]8\(%rsp\)
not-match [-](1[3-9][0-9]|[2-9][0-9][0-9])\(%rsp\)
not-match \(%rbp\)
in fn tl_rzl_big
count = 0 ^[[:space:]]+call[ ]
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-match [-][0-9]+\(%rsp\)
in fn tl_rzl_call
count >= 1 ^[[:space:]]+call[ ]
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-match [-][0-9]+\(%rsp\)
in fn tl_rzl_abort
contains call tl_oob_abort_at
count = 1 ^[[:space:]]+call[ ]
count = 0 ^[[:space:]]+subq \$[0-9]+, %rsp$
count = 0 ^[[:space:]]+addq \$[0-9]+, %rsp$
metric distinct:-[0-9]+\(%rsp\) >= 1
match [-]8\(%rsp\)
metric abort-staging-push-from-memory = 0
not-match [-](1[3-9][0-9]|[2-9][0-9][0-9])\(%rsp\)

case red-zone-leaf-win64
source tests/integration/red_zone_leaf.tl
target windows-x86_64
in fn tl_rzl_slots
count >= 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-match [-][0-9]+\(%rsp\)
in fn tl_rzl_big
count >= 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-match [-][0-9]+\(%rsp\)
in fn tl_rzl_abort
count >= 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-match [-][0-9]+\(%rsp\)

# A value saved across a call is not reloaded from its spill slot.
case save-reload-elide
source tests/integration/save_reload_elide.tl
in fn _tl_save_reload_elide_relay
contains call _tl_save_reload_elide_src
contains xorl %r8d, %r8d
contains movq %rax, %r9
contains call _tl_save_reload_elide_sink7
not-match ^[[:space:]]+movq -?[0-9]+\(%rsp\), %r9$

# The global array handle is loaded once.
case global-handle-cse
source tests/integration/global_handle_cse.tl
in fn _tl_global_handle_cse_probe
count-fixed = 1 _tl_global_handle_cse_gtab(%rip)
contains call tl_oob_abort

# GAP4: one length load and one data load survive the interleaved stores, and
# the store goes through the forwarded data register.
case loadcse-forward
source tests/integration/loadcse_forward.tl
in fn _tl_loadcse_forward_poke_sum
count = 1 ^[[:space:]]+movq 8\(%rdi\), %r[a-z0-9]+$
count = 1 ^[[:space:]]+movq \(%rdi\), %r[a-z0-9]+$
capture data_reg ^[[:space:]]*movq \(%rdi\), (%r[a-z0-9]*)$
count >= 1 ^[[:space:]]+movq %r[a-z0-9]+, 16\({{data_reg}}\)$

# Non-PIC Linux switch dispatch uses the absolute indexed form; no table
# register is borrowed under pressure.
case switch-dispatch-scavenge
source tests/integration/switch_dispatch_scavenge.tl
in fn _tl_switch_dispatch_scavenge_run_switch
count = 1 ^[[:space:]]+jmp \*\.Lf.*_switch_table\(,%r[a-z0-9]+,8\)$
not-match ^[[:space:]]+jmp \*%r

# The length compare reads memory directly and the check is eliminated.
case cmp-fold-load
source tests/integration/cmp_fold_load.tl
in fn _tl_cmp_fold_load_check
contains cmpq %rsi, 8(%rdi)
not-match ^[[:space:]]+movq .*\(%r[^)]*\), %r
not-contains call tl_oob_abort

# M6-I: a scalar global read folds into the compare's rip-relative operand, on
# either side, with the unfolded branch sense; a twice-read local refuses.
case global-cmp-mem-fold
source tests/integration/global_cmp_mem_fold.tl
target linux-x86_64 windows-x86_64
in fn _tl_global_cmp_mem_fold_probe_lhs
count = 1 ^[[:space:]]+cmpq %r[a-z0-9]+, _tl_global_cmp_mem_fold_gcmp_gen\(%rip\)$
not-match ^[[:space:]]+movq _tl_global_cmp_mem_fold_gcmp_gen\(%rip\), %r
after cmpq %r[a-z0-9]+, _tl_global_cmp_mem_fold_gcmp_gen[(]%rip[)]
next-line ^[[:space:]]+jne[ ]
in fn _tl_global_cmp_mem_fold_probe_rhs
count = 1 ^[[:space:]]+cmpq _tl_global_cmp_mem_fold_gcmp_limit\(%rip\), %r[a-z0-9]+$
not-match ^[[:space:]]+movq _tl_global_cmp_mem_fold_gcmp_limit\(%rip\), %r
after cmpq _tl_global_cmp_mem_fold_gcmp_limit[(]%rip[)], %r[a-z0-9]+
next-line ^[[:space:]]+jge[ ]
in fn _tl_global_cmp_mem_fold_probe_refused
match ^[[:space:]]+movq _tl_global_cmp_mem_fold_gcmp_gen\(%rip\), %r
not-match ^[[:space:]]+cmpq .*_tl_global_cmp_mem_fold_gcmp_gen\(%rip\)

# BE-6 / CANON-G: a global read on either side of an add folds into its
# rip-relative source operand; a twice-read local refuses.
case global-add-mem-fold
source tests/integration/global_add_mem_fold.tl
target linux-x86_64 windows-x86_64
in fn _tl_global_add_mem_fold_probe_rhs
count = 1 ^[[:space:]]+addq _tl_global_add_mem_fold_gadd_k\(%rip\), %r[a-z0-9]+$
not-match ^[[:space:]]+movq _tl_global_add_mem_fold_gadd_k\(%rip\), %r
in fn _tl_global_add_mem_fold_probe_lhs
count = 1 ^[[:space:]]+addq _tl_global_add_mem_fold_gadd_m\(%rip\), %r[a-z0-9]+$
not-match ^[[:space:]]+movq _tl_global_add_mem_fold_gadd_m\(%rip\), %r
in fn _tl_global_add_mem_fold_probe_refused
match ^[[:space:]]+movq _tl_global_add_mem_fold_gadd_k\(%rip\), %r
not-match ^[[:space:]]+addq _tl_global_add_mem_fold_gadd_k\(%rip\), %r

# BE-3: the bounds check compares the length through the handle register the
# line before loaded, reads the data word through the same register, and still
# has its located abort tail.
case global-len-fold
source tests/integration/global_len_fold.tl
target linux-x86_64 windows-x86_64
in fn _tl_global_len_fold_probe_sum
count = 1 ^[[:space:]]+cmpq 8\(%r[a-z0-9]+\), %r[a-z0-9]+$
after movq _tl_global_len_fold_glf_items[(]%rip[)], %r[a-z0-9]+$
next-line ^[[:space:]]+cmpq 8[(]%r[a-z0-9]+[)], %r[a-z0-9]+$
capture handle ^[[:space:]]+cmpq 8\((%r[a-z0-9]+)\), %r.*$
match ^[[:space:]]+movq \({{handle}}\), %r
match ^[[:space:]]+pushq 8\(%r[a-z0-9]+\)$

# RMW-2 / INL-6: each `g = g op k` update of a global cell is one
# memory-operand instruction with no staging load before or store after it,
# and a read after the write reloads the cell.
case rmw-mem-operand-fold
source tests/integration/rmw_mem_operand_fold.tl
target linux-x86_64 windows-x86_64
count = 1 ^[[:space:]]+(addq|subq|orq|andq|xorq) ([$][0-9-]+|%r[a-z0-9]+), _tl_rmw_mem_operand_fold_rmw_add\(%rip\)$
count = 1 ^[[:space:]]+(addq|subq|orq|andq|xorq) ([$][0-9-]+|%r[a-z0-9]+), _tl_rmw_mem_operand_fold_rmw_sub\(%rip\)$
count = 1 ^[[:space:]]+(addq|subq|orq|andq|xorq) ([$][0-9-]+|%r[a-z0-9]+), _tl_rmw_mem_operand_fold_rmw_or\(%rip\)$
count = 1 ^[[:space:]]+(addq|subq|orq|andq|xorq) ([$][0-9-]+|%r[a-z0-9]+), _tl_rmw_mem_operand_fold_rmw_and\(%rip\)$
count = 1 ^[[:space:]]+(addq|subq|orq|andq|xorq) ([$][0-9-]+|%r[a-z0-9]+), _tl_rmw_mem_operand_fold_rmw_xor\(%rip\)$
metric rmw-fold-staging:_tl_rmw_mem_operand_fold_rmw_add = 0
metric rmw-fold-staging:_tl_rmw_mem_operand_fold_rmw_sub = 0
metric rmw-fold-staging:_tl_rmw_mem_operand_fold_rmw_or = 0
metric rmw-fold-staging:_tl_rmw_mem_operand_fold_rmw_and = 0
metric rmw-fold-staging:_tl_rmw_mem_operand_fold_rmw_xor = 0
count = 1 ^[[:space:]]+addq %r[a-z0-9]+, _tl_rmw_mem_operand_fold_rmw_hits\(%rip\)$
after addq %r[a-z0-9]+, _tl_rmw_mem_operand_fold_rmw_hits[(]%rip[)]
next-line ^[[:space:]]+movq _tl_rmw_mem_operand_fold_rmw_hits[(]%rip[)], %r

# GAP8-C: commutative ops tie their destination to the accumulator, so every
# element load folds into a memory-operand ALU line in both loop clones.
case alu-mem-operand-tie
source tests/integration/alu_mem_operand_tie.tl
in fn _tl_alu_mem_operand_tie_fold_words
count = 8 ^[[:space:]]+(andq|orq|xorq|addq) \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %r[a-z0-9]+$
not-match ^[[:space:]]+movq \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %r
count = 4 ^[[:space:]]+movq %r[a-z0-9]+, %r[a-z0-9]+$

# ...and load sinking gets the same fold for one nested expression.
case alu-mem-operand-sink
source tests/integration/alu_mem_operand_tie.tl
in fn _tl_alu_mem_operand_tie_fold_nested
count = 8 ^[[:space:]]+(andq|orq|xorq) \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %r[a-z0-9]+$
not-match ^[[:space:]]+movq \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %r
count = 4 ^[[:space:]]+movq %r[a-z0-9]+, %r[a-z0-9]+$

# #5238: an immutable global mask reaches the same BCE-versioned x16 unrolled
# fast path as the literal spelling.
case const-global-mask-unroll
source tests/integration/const_global_mask_unroll.tl
in fn _tl_const_global_mask_unroll_mask_sum
contains __bce_fast__unroll_body
contains __bce_fast__unroll_guard
in fn _tl_const_global_mask_unroll_mask_sum_literal
contains __bce_fast__unroll_body

# CB-2(c): the measured tier copies the hash leaf into its loop-depth-0 site;
# the cold second reference still calls it.
case checked-depth0-site
source tests/integration/checked_depth0_site.tl
target linux-x86_64 windows-x86_64
in fn _tl_checked_depth0_site_probe
not-match ^[[:space:]]+call _tl_checked_depth0_site_hash_words$
match ^[[:space:]]+movq \$2166136261, %r
match ^\.L[A-Za-z0-9_]+_inl\.
in asm
match ^_tl_checked_depth0_site_hash_words:$
count = 1 ^[[:space:]]+call _tl_checked_depth0_site_hash_words$

# A seven-parameter setup builder at a hot caller's entry is offered to the
# verdict and kept; its cold second reference still calls it.
case checked-setup-helper
source tests/integration/checked_setup_helper.tl
target linux-x86_64 windows-x86_64
not-match ^_tl_checked_setup_helper_run:$
in fn main
match ^\.L[A-Za-z0-9_]+_inl\.
in asm
