# opt2 assembly-shape gates for the regalloc/backend/optimizer fixtures (gate
# stage2-regalloc-backend-asm-shape-gates). See tests/codegen/asm-shape.d/.

args --stdlib-root {{root}}/stdlib --stdlib-root {{root}}/src


case binary-interval-search
source tests/integration/bce_binary_interval.tl
in fn _tl_bce_binary_interval_search_div
count = 1 __bce_guard:$
count >= 1 __bce_fast:$
count = 1 call \.L_tl_abort_tl_oob_abort_at
in fn _tl_bce_binary_interval_search_shift
count = 1 __bce_guard:$
count >= 1 __bce_fast:$
count = 1 call \.L_tl_abort_tl_oob_abort_at

# SROA-2: the four-word enum of the lattice join lives in registers -- no frame,
# no wide copy, no frame-slot store or compare; JT-2 threads the equality match
# away, leaving the three payload-word compares against memory.
case lattice-join-split
source tests/integration/lattice_join_split.tl
in fn _tl_lattice_join_split_lat_bind
not-match ^[[:space:]]+subq \$[0-9]+, %rsp$
not-contains movups
not-match ^[[:space:]]+movq %[a-z0-9]+, -?[0-9]+\(%rsp\)$
not-match ^[[:space:]]+cmpq -?[0-9]+\(%rsp\), %
not-match ^[[:space:]]+cmpq \$1, %[a-z0-9]+$
count >= 3 ^[[:space:]]+cmpq [0-9]+\(%r[a-z0-9]+\), %r[a-z0-9]+$

# UNR-1: the word-then-tail piece copy inlined into copy-fill!: the unsigned
# `n / 8` is one shift, the word loop's guard is `lea; test; jg`, and the byte
# tail is not versioned (one guard, one byte copy).
case short-trip-copy
source tests/integration/short_trip_copy.tl
in fn _tl_short_trip_copy_copy_fill_bang
match ^[[:space:]]+shrq \$3, %r
not-match ^[[:space:]]+sarq \$63, %r
after ^[[:space:]]+leaq -4[(]%r[a-z0-9]+[)], %r
next-line ^[[:space:]]+testq %r[a-z0-9]+, %r
not-match ^[[:space:]]+leaq -2\(%r[a-z0-9]+\), %r
count = 1 __unroll_guard:$
count = 1 ^[[:space:]]+movzbl[ ]

# #8555: the iterator protocol over a range. `into-next` returns the two-word
# `IntoNext` register group, which the multiblock inliner admits; the match on
# the inlined result reads a join the group split takes apart, and the
# `IntoIter` state, `bool` lanes included, lives in registers: no call, no frame.
case range-protocol-inline
source tests/integration/range_loop_shapes.tl
in fn _tl_range_loop_shapes_protocol_sum
not-contains into_next
not-match ^[[:space:]]+subq \$[0-9]+, %rsp$

# #8555: a loop over an inlined range's fields, with the advance after the body
# and (the prelude `for` macro's order) before it. The `inclusive` lane folds,
# the loop collapses back into one block, and it is bounds-check versioned and
# unrolled like a counting `while`.
case range-fields-unroll
source tests/integration/range_loop_shapes.tl
in fn _tl_range_loop_shapes_fields_sum
not-match ^[[:space:]]+subq \$[0-9]+, %rsp$
count >= 1 __bce_fast:$
count >= 1 __bce_fast__unroll_body:$
in fn _tl_range_loop_shapes_advance_first_sum
not-match ^[[:space:]]+subq \$[0-9]+, %rsp$
count >= 1 __bce_fast:$
count >= 1 __bce_fast__unroll_body:$

# A `for` range loop advances its counter before the body, which kept the
# current and next index live together and closed both loops of a versioned
# `if` body with `jge exit; mov; jmp top`. The latch sink moves the add into
# the latch, so both close with `add; cmp; jl` like the `while` twin: no `lea`
# of the next index, no inverted exit branch.
# #8795: `string.eq` against a literal reads the literal's length and its
# leading data word as constants, so the inlined comparison keeps only the
# 4-byte arm: the length and the first four literal bytes ("%rax" as a
# little-endian word) compare against immediates, and neither the literal's
# length word, the 8-byte arm nor its word-count shift survive.
case string-literal-eq-width
source tests/integration/string_literal_eq.tl
in fn _tl_string_literal_eq_is_4
match ^[[:space:]]+cmpq \$4, %r
match ^[[:space:]]+cmpl \$2019652133, %r
not-match ^[[:space:]]+cmpq 8\(%r[a-z0-9]+\), %r
not-match ^[[:space:]]+cmpq \$8, %r
not-match ^[[:space:]]+sarq \$3, %r
case latch-sink-for-range
source tests/integration/latch_sink_for_loops.tl
in fn latch_sink_count_if_for
count = 2 ^[[:space:]]+jl \.L
not-match ^[[:space:]]+jge \.L
not-match ^[[:space:]]+leaq 1\(%r[a-z0-9]+\), %r
in fn latch_sink_count_if_while
count = 2 ^[[:space:]]+jl \.L
not-match ^[[:space:]]+jge \.L

# Counter sink: a loop that advances its counter before the body, as the prelude
# `for` expansions do, is rewritten before the loop passes so that it closes
# like its `while` twin. At level 1 the step `addq $1` is stored right before
# the jump back to the header; at level 2 the twins compile alike (the closing
# `jl`, no `leaq 1(...)` of a next index), and the copy idiom is one block copy.
case counter-sink-latch-opt1
opt 1
source tests/integration/counter_sink_loops.tl
in fn counter_sink_sum_bump
count = 1 ^[[:space:]]+addq \$1, %r
narrow ranges:addq \$1, %r~jmp \.L
count = 3 .
in fn counter_sink_sum_while
narrow ranges:addq \$1, %r~jmp \.L
count = 3 .

case counter-sink-opt2
source tests/integration/counter_sink_loops.tl
in fn counter_sink_sum_bump
count >= 1 ^[[:space:]]+jl \.L
not-match ^[[:space:]]+leaq 1\(%r[a-z0-9]+\), %r
in fn counter_sink_sum_while
count >= 1 ^[[:space:]]+jl \.L
in fn counter_sink_copy_bump
count = 1 ^[[:space:]]+call tl_mem_copy8_fwd$

# A `for` over a direct `iterator.range` call counts from the call's arguments,
# and the counter sink gives it its `while` twin's loop. At level 1 both close
# with the step stored right before the jump back to the header; at level 2
# they close with `jl` and no `leaq 1(...)` of a next index, and the copy idiom
# is one block copy.
case for-range-lean-opt1
opt 1
source tests/integration/for_range_lean.tl
in fn for_range_sum_for
count = 1 ^[[:space:]]+addq \$1, %r
narrow ranges:addq \$1, %r~jmp \.L
count = 3 .
in fn for_range_sum_while
narrow ranges:addq \$1, %r~jmp \.L
count = 3 .

case for-range-lean-opt2
source tests/integration/for_range_lean.tl
in fn for_range_sum_for
count >= 1 ^[[:space:]]+jl \.L
not-match ^[[:space:]]+leaq 1\(%r[a-z0-9]+\), %r
in fn for_range_count_above
not-match ^[[:space:]]+leaq 1\(%r[a-z0-9]+\), %r
in fn for_range_copy_for
count = 1 ^[[:space:]]+call tl_mem_copy8_fwd$
