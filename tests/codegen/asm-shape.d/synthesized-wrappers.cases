source tests/integration/checked_post_multi_call_abort.tl
target linux-x86_64 windows-x86_64
in fn _tl_checked_post_multi_call_abort_pm_lookup
not-match ^[[:space:]]+call _tl_checked_post_multi_call_abort_pm_probe$
