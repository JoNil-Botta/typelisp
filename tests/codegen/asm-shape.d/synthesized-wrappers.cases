case checked-dispatch-arm
source tests/integration/checked_dispatch_arm.tl
target linux-x86_64 windows-x86_64
match ^_tl_checked_dispatch_arm_da_dispatch:$
in fn _tl_checked_dispatch_arm_da_dispatch
not-match ^[[:space:]]+call _tl_checked_dispatch_arm_da_fold$
not-match ^[[:space:]]+jmp _tl_checked_dispatch_arm_da_fold$
count >= 8 ^[[:space:]]+call \.L_tl_abort_tl_oob_abort_at
in asm
match ^_tl_checked_dispatch_arm_da_fold:$

case checked-dispatch-arm-abort
source tests/integration/checked_dispatch_arm_abort.tl
target linux-x86_64 windows-x86_64
in fn _tl_checked_dispatch_arm_abort_da_dispatch
not-match ^[[:space:]]+call _tl_checked_dispatch_arm_abort_da_fold$
count >= 8 ^[[:space:]]+call \.L_tl_abort_tl_oob_abort_at
