# opt2 assembly-shape gates for the regalloc/backend/optimizer fixtures (gate
# stage2-regalloc-backend-asm-shape-gates). See tests/codegen/asm-shape.d/.

args --stdlib-root {{root}}/stdlib --stdlib-root {{root}}/src


# A `try` error exit returns the enclosing family's Err like a returned
# constructor: the 32-byte family is written straight into the caller's sret
# slot (one tag store per exit) and the 16-byte family travels in the register
# group, with no arena allocation on either path.
case try-err-return-slot
source tests/integration/try_propagation.tl
opt 0 2
in fn _tl_try_propagation_validate
not-contains tl_current_arena
not-match ^[[:space:]]+call .*alloc
count = 2 ^[[:space:]]+movq \$1, \(%r[a-z0-9]+\)$
in fn _tl_try_propagation_word_sum
not-contains tl_current_arena
not-match ^[[:space:]]+call .*alloc

# A function that uses `try` still takes its caller's sret slot: the try error
# exit builds its Err in that slot (#8563), so `forward` tail-jumps into
# `checked` instead of calling into a temporary and copying the 32-byte result.
case try-sret-forward
source tests/integration/try_sret_forward.tl
opt 0 1
in fn _tl_try_sret_forward_forward
match ^[[:space:]]+jmp _tl_try_sret_forward_checked$
not-contains movups
not-match ^[[:space:]]+call[[:space:]]

# A tail call whose argument re-borrows a reference parameter, `(& l)` or
# `(&mut l)` with `l` already a reference, passes that same pointer, so it jumps
# like the direct form (#9137); a borrow of a frame local, directly or through a
# local reference, keeps its call. At opt 2 the wrappers inline into `main`.
case tail-reborrow-param
source tests/integration/tail_reborrow_param.tl
opt 0 1
in fn _tl_tail_reborrow_param_wrap_reborrow
match ^[[:space:]]+jmp _tl_tail_reborrow_param_inner$
not-match ^[[:space:]]+call[[:space:]]
in fn _tl_tail_reborrow_param_wrap_shared_of_mut
match ^[[:space:]]+jmp _tl_tail_reborrow_param_inner$
not-match ^[[:space:]]+call[[:space:]]
in fn _tl_tail_reborrow_param_wrap_mut_reborrow
match ^[[:space:]]+jmp _tl_tail_reborrow_param_bump$
not-match ^[[:space:]]+call[[:space:]]
in fn _tl_tail_reborrow_param_wrap_local
count = 1 ^[[:space:]]+call _tl_tail_reborrow_param_inner$
not-match ^[[:space:]]+jmp _tl_tail_reborrow_param_inner$
in fn _tl_tail_reborrow_param_wrap_local_ref
count = 1 ^[[:space:]]+call _tl_tail_reborrow_param_inner$
not-match ^[[:space:]]+jmp _tl_tail_reborrow_param_inner$

# References and views into released frames must retain a call (#9183).
# At opt0 these checks observe lowering before inlining; the native corpus
# also runs all cases at opt1 and opt2 on both operating systems.
