in fn _tl_tail_call_frame_provenance_scalar_copy
match ^[[:space:]]+call _tl_tail_call_frame_provenance_scrub_ref$
not-match ^[[:space:]]+jmp _tl_tail_call_frame_provenance_scrub_ref$
in fn _tl_tail_call_frame_provenance_shadowed_ref
