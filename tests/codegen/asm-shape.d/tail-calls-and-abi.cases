# A shared borrow of a scalar or register-resident local copies it into a
# frame slot of the borrowing function, never into the current arena (#9297).
case borrow-local-no-alloc
source tests/integration/borrow_local_frame_storage.tl
target linux-x86_64 windows-x86_64
opt 0 1 2
in fn _tl_borrow_local_frame_storage_case_no_alloc
not-match call[[:space:]]+.*tl_alloc

# A self tail call in an arm of a match on a borrowed enum place jumps (#9044):
# an element through a reference parameter, a field through one, and a two-word
# enum the match spills to a slot. At opt 2 tailrec makes each walker a loop. A
# binding that borrows a frame local's aggregate payload keeps its call.
case tail-borrowed-enum-match
source tests/integration/tail_borrowed_enum_match.tl
target linux-x86_64 windows-x86_64
opt 0 1
in fn _tl_tail_borrowed_enum_match_walk_borrow
count = 2 ^[[:space:]]+jmp _tl_tail_borrowed_enum_match_walk_borrow$
not-match ^[[:space:]]+call _tl_tail_borrowed_enum_match_walk_borrow$
in fn _tl_tail_borrowed_enum_match_count_field
count = 2 ^[[:space:]]+jmp _tl_tail_borrowed_enum_match_count_field$
not-match ^[[:space:]]+call _tl_tail_borrowed_enum_match_count_field$
in fn _tl_tail_borrowed_enum_match_sum_on
count = 2 ^[[:space:]]+jmp _tl_tail_borrowed_enum_match_sum_on$
not-match ^[[:space:]]+call _tl_tail_borrowed_enum_match_sum_on$

case tail-borrowed-enum-match-loop
