in fn _tl_tail_borrowed_enum_match_walk_borrow
not-match ^[[:space:]]+(call|jmp) _tl_tail_borrowed_enum_match_walk_borrow$
in fn _tl_tail_borrowed_enum_match_count_field
not-match ^[[:space:]]+(call|jmp) _tl_tail_borrowed_enum_match_count_field$
in fn _tl_tail_borrowed_enum_match_sum_on
not-match ^[[:space:]]+(call|jmp) _tl_tail_borrowed_enum_match_sum_on$

