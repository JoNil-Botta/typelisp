# Refs #9695: the null path was already bare on SysV. Wrapping the CAS path
# must not replace its red-zone spill with a new stack allocation.
case shrinkwrap-red-zone-linux
source tests/integration/shrinkwrap_red_zone.tl
target linux-x86_64
in fn tl_rz_claim
contains lock cmpxchgq
match [-][0-9]+\(%rsp\)
not-match ^[[:space:]]+(subq|addq) \$[0-9]+, %rsp$
not-match ^[[:space:]]+(pushq|popq)[ ]
not-contains __shrinkwrap
in fn tl_rz_empty
contains __shrinkwrap
not-match %(rsp|rbp)

# Win64 has no red zone: bypassing the frame on the null path remains useful.
case shrinkwrap-red-zone-win64
source tests/integration/shrinkwrap_red_zone.tl
target windows-x86_64
in fn tl_rz_claim$typelisp
contains lock cmpxchgq
contains __shrinkwrap_save
order testq || __shrinkwrap_bare0: || ret || __shrinkwrap_save: || subq
not-match [-][0-9]+\(%rsp\)

# GAP5 precise leaq poison: a frame object whose address is taken keeps every
# store into its own slots, including a field address (base+8) and an element
# array whose callee reads every element. The stores are unread in the
# caller's text, so only the addressed object's extent may protect them.
case addr-taken-stack-aggregates
source tests/integration/addr_taken_stack_aggregates.tl
target linux-x86_64
opt 2
in fn _tl_addr_taken_stack_aggregates_array_case
count >= 1 ^[[:space:]]+leaq [0-9]+\(%rsp\), %r
count >= 4 ^[[:space:]]+movq %r[a-z0-9]+, .*\(%r[a-z0-9]+\)$
count = 1 ^[[:space:]]+call _tl_addr_taken_stack_aggregates_sum_all
in fn _tl_addr_taken_stack_aggregates_struct_case
count >= 1 ^[[:space:]]+leaq [0-9]+\(%rsp\), %r
count >= 2 ^[[:space:]]+movq %r[a-z0-9]+, [0-9]+\(%rsp\)$
count >= 1 ^[[:space:]]+addq \$8, %r
count = 1 ^[[:space:]]+call _tl_addr_taken_stack_aggregates_read_slot
in fn _tl_addr_taken_stack_aggregates_scalar_case
count >= 1 ^[[:space:]]+leaq [0-9]+\(%rsp\), %r
count >= 1 ^[[:space:]]+movq %r[a-z0-9]+, [0-9]+\(%rsp\)$
count = 1 ^[[:space:]]+call _tl_addr_taken_stack_aggregates_read_slot

# Two copies of the same saved value move ahead of a later argument setup.
# The different saved register and the single-site callee keep normal calls.
case arg-entry-linux
source tests/fixtures/arg_entry.tl
target linux-x86_64
opt 2
assemble
in asm
narrow ranges:^[[:space:]]+\.type _tl_arg_entry_record,@function$~^_tl_arg_entry_record:$
count = 1 ^[[:space:]]+\.local "__tl_arg_entry:[0-9]+"$
capture entry ^("__tl_arg_entry:[0-9]+"):$
order {{entry}}: || movq %r12, %rdi || .size {{entry}}, . - {{entry}} || _tl_arg_entry_record:
in fn main
count = 3 ^[[:space:]]+call {{entry}}$
count = 1 ^[[:space:]]+call _tl_arg_entry_record$
order movq %r15, %rdi || movl $4, %esi || call _tl_arg_entry_record
order movq %r12, %rdi || movl $7, %esi || call _tl_arg_entry_single
order movq %r12, %rsi || movl $4, %edx || call *(%r10)

case arg-entry-win64
source tests/fixtures/arg_entry.tl
target windows-x86_64
opt 2
assemble
not-contains __tl_arg_entry:
contains call _tl_arg_entry_record
contains call _tl_arg_entry_single

# A by-value array's lowered register copy can use the same alternate entry.
case arg-entry-by-value-array
source tests/fixtures/arg_entry_value.tl
target linux-x86_64
opt 2
assemble
in asm
narrow ranges:^[[:space:]]+\.type _tl_arg_entry_value_record,@function$~^_tl_arg_entry_value_record:$
capture entry ^("__tl_arg_entry:[0-9]+"):$
order {{entry}}: || movq %r12, %rdi || .size {{entry}}, . - {{entry}} || _tl_arg_entry_value_record:
in fn main
count = 2 ^[[:space:]]+call {{entry}}$
not-contains call _tl_arg_entry_value_record
not-match ^[[:space:]]+movq %r12, %rdi$
