# opt2 assembly-shape gates for the regalloc/backend/optimizer fixtures (gate
# stage2-regalloc-backend-asm-shape-gates). See tests/codegen/asm-shape.d/.

args --stdlib-root {{root}}/stdlib --stdlib-root {{root}}/src


# A constant index's bounds check compares an immediate.
case const-index-bounds
source tests/integration/const_index_bounds.tl
in fn _tl_const_index_bounds_get2
contains cmpq $2, %rax
not-match ^[[:space:]]+mov[lq][[:space:]]+\$2,
match call (\.L_tl_abort_)?tl_oob_abort

# %rbp is the sixth callee-saved register, used as a value (never a frame base).
case rbp-sixth-csr
source tests/integration/rbp_sixth_csr.tl
in fn _tl_rbp_sixth_csr_churn6
contains pushq %rbp
contains popq %rbp
match ^[[:space:]]+leaq 31\( %rbp\), %r[a-z0-9]+$
not-contains leaq 31(%rsp)
not-match \(%rbp\)

# Windows Internal has the same six homes; eight live values retain spill
# pressure while pinning RBP's SEH description and frame-pointer omission.
# The push prologue's unwind is the shared `.xdata` record its `.pdata` row
# names: a described prologue, no frame register, the RBP push and the frame.
case win64-rbp-eighth-csr
source tests/integration/win64_rbp_eighth_csr.tl
target windows-x86_64
in fn _tl_win64_rbp_eighth_csr_churn8
contains pushq %rbp
capture unwind ^[[:space:]]+\.rva _tl_win64_rbp_eighth_csr_churn8, \.L_tl_seh_end_[0-9]+, (\.L_tl_xdata_[0-9]+)$
contains popq %rbp
not-contains .seh_setframe
not-contains movq %rsp, %rbp
not-match \(%rbp\)
in asm
narrow ranges:^{{unwind}}:$~^[[:space:]]+\.popsection$
match ^[[:space:]]+\.byte 1, [1-9][0-9]*, [1-9][0-9]*, 0$
contains # UWOP_PUSH_NONVOL %rbp
match # UWOP_ALLOC_(SMALL|LARGE) [0-9]+$

# #7564: a Windows rbp frame that saves callee registers names no frame
# register, and each GP save is described before the prologue ends. An XMM save
# with an even GP save count keeps the rbp frame; the FPO victim is the push
# prologue control. scripts/verify-win64-seh-unwind.sh runs this fixture.
case win64-seh-framed-saves
source tests/fixtures/win64-seh/win64_seh_unwind.tl
target windows-x86_64
in fn tl_seh_victim_framed$typelisp
contains movq %rsp, %rbp
not-contains .seh_setframe
match ^[[:space:]]+\.seh_savexmm %xmm6, [0-9]+$
count = 2 ^[[:space:]]+\.seh_savereg %r[a-z0-9]+, [0-9]+$
after ^[[:space:]]+\.seh_endprologue$
next-line ^[[:space:]]+movq %rcx, %r[a-z0-9]+$
in fn tl_seh_victim_fpo$typelisp
capture fpo_unwind ^[[:space:]]+\.rva tl_seh_victim_fpo[$]typelisp, \.L_tl_seh_end_[0-9]+, (\.L_tl_xdata_[0-9]+)$
not-contains .seh_savereg
not-contains movq %rsp, %rbp
in asm
narrow ranges:^{{fpo_unwind}}:$~^[[:space:]]+\.popsection$
match # UWOP_PUSH_NONVOL %r
not-contains UWOP_SAVE

# #7564: Windows has no red zone, so a function that saves callee registers
# keeps an allocation covering them instead of storing them below %rsp, and
# the saves are described at nonnegative offsets. return-f32 then passes FPO;
# the shrink-wrapped saving path of reference-bits stays framed.
case win64-callee-saves-allocated
source tests/integration/float_comparisons.tl
target windows-x86_64
in fn _tl_float_comparisons_return_f32
match \.seh_stackalloc[ ]
match ^[[:space:]]+\.seh_savexmm %xmm6, [0-9]+$
not-match -[0-9]+\(%rbp\)

# All six predicates branch on UCOMIS flags. The opt2 layout takes the
# opposite edge of the opt0/1 layout; both need the equality parity guards.
case scalar-float-compare-branches
source tests/integration/float_comparisons.tl
opt 0 1 2
in fn tl_inverse_mask_f64
count >= 6 ^[[:space:]]+ucomisd[ ]
count = 2 ^[[:space:]]+jp[ ]
count >= 2 ^[[:space:]]+j(a|be)[ ]
count >= 2 ^[[:space:]]+j(ae|b)[ ]
not-match ^[[:space:]]+set[a-z]+[ ]
in fn tl_inverse_mask_f32
count >= 6 ^[[:space:]]+ucomiss[ ]
count = 2 ^[[:space:]]+jp[ ]
count >= 2 ^[[:space:]]+j(a|be)[ ]
count >= 2 ^[[:space:]]+j(ae|b)[ ]
not-match ^[[:space:]]+set[a-z]+[ ]

case scalar-float-div-unaltered-opt0
source tests/integration/float_comparisons.tl
opt 0
in fn tl_literal_div_f64
count = 8 ^[[:space:]]+divsd[ ]
in fn tl_literal_div_f32
count = 8 ^[[:space:]]+divss[ ]

# 3.0 and the two out-of-range exponents still require division.
case scalar-float-div-reciprocal
source tests/integration/float_comparisons.tl
opt 1 2
in fn tl_literal_div_f64
count = 3 ^[[:space:]]+divsd[ ]
count >= 5 ^[[:space:]]+mulsd[ ]
in fn tl_literal_div_f32
count = 3 ^[[:space:]]+divss[ ]
count >= 5 ^[[:space:]]+mulss[ ]

case win64-shrinkwrap-saves-allocated
source tests/integration/bit_length_loop.tl
target windows-x86_64
in fn _tl_bit_length_loop_reference_bits
match \.seh_stackalloc[ ]
count = 1 ^[[:space:]]+\.seh_savereg %r[a-z0-9]+, [0-9]+$
not-contains .seh_setframe
not-match -[0-9]+\(%rbp\)
