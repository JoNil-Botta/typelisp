# stdlib/crypto_secret.tl keeps its wipe stores and its fixed-work shape at
# every opt level on both targets, and offers no ordinary escape path. Runtime
# behaviour is in stdlib/tests/crypto_secret_inline.tl; these rows pin the
# compiled shape. Gate: --only 'secret-*'.
#
# The fixture is a --no-entry library, so every public helper is emitted as its
# own function at every opt level. A wipe loop is a volatile indirect store of a
# zero register and a backward branch. A fixed-work helper has no conditional
# branch, set/cmov, byte compare or indexed table load; the comparison loop's
# only conditional branches test its public count and index.

file secret_shape.tl
(import stdlib.crypto_secret)

;: Dead scratch that holds secret-derived words until the wipe.
(define (scratch-probe [seed : u64]) : u64
  (let
    [scratch : (Array u64 4)
      (array seed (+ seed (cast 1 : u64)) (* seed (cast 3 : u64)) (bit-xor seed (cast 5 : u64)))]
    [sum : u64 (+ (array-ref scratch 0) (array-ref scratch 3))]
    (unsafe
      (crypto_secret.wipe-words! (ptr-cast (ptr-addr-of scratch) : (MutPtr u64)) 4))
    sum))
end-file

file close_run.tl
(import stdlib.byte_buf)
(import stdlib.crypto_secret)

;: Close a secret, then read its retained storage: every capacity byte, the
;: length and the state must show the wipe.
(define (main) : i64
  (let
    [text : String "0123456789abcdefghij"]
    (match (crypto_secret.fixed-from-bytes
      (crypto_secret.Secret20)
      (byte_buf.str-as-bytes (& text)))
      [(crypto_secret.SecretFixedOk owner)
        (let
          [storage : (MutPtr crypto_secret.SecretStorage) owner.storage]
          [data : (MutPtr u8)
            (unsafe
              (crypto_secret.storage-data storage))]
          [left : u64 (cast 0 : u64)]
          [index : i64 0]
          (crypto_secret.close-fixed owner)
          (while (< index 24)
            (set!
              left
              (bit-or
                left
                (cast
                  (unsafe
                    (ptr-read (ptr-offset data index)))
                  : u64)))
            (set! index (+ index 1)))
          (if (and
            (= left (cast 0 : u64))
            (=
              (unsafe
                (crypto_secret.storage-header storage)).length
              (cast 0 : u64))
            (=
              (unsafe
                (crypto_secret.storage-header storage)).state
              (cast 2 : u64)))
            42
            1))]
      [(crypto_secret.SecretFixedErr _) 1])))
end-file

file format.tl
(import stdlib.crypto_secret)
(import stdlib.io)

(define (main) : i64
  (let
    [owner : crypto_secret.SecretFixed (crypto_secret.fixed-zero (crypto_secret.Secret16))]
    (io.print-format "{}\n" owner)
    42))
end-file

case secret-wipe
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 0 1 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_wipe_words_bang
match ^[[:space:]]+movq %[a-z0-9]+, \(%[a-z0-9]+(,%[a-z0-9]+,8)?\)$
metric backward-branches >= 1
in fn _tl_secret_shape_scratch_probe
match ^[[:space:]]+(call|jmp) _tl_stdlib_crypto_secret_stdlib_crypto_secret_wipe_words_bang$

# Closing poisons the header before wiping and marks it closed after, at any
# inlining of the wipe; the run row reads the retained storage back after
# close at every opt level.
case secret-close-order
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 1 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_storage_close
order $1, || $2,

case secret-close-wipes-at-every-opt
source {{work}}/close_run.tl
args --stdlib-root {{root}}/stdlib
do tl-run
target -
opt 0 1 2
exit 42

case secret-select-swap-branch-free
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 0 1 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_select_u64
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_select_u32
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_select_u8
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_mask_u64
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_swap_u64_bang
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_swap_u32_bang
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_swap_u8_bang
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)|\(,%

# At opt 0 the constant shift count keeps its deterministic trap check.
case secret-nonzero-mask-branch-free
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 1 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_nonzero_mask_u64
not-match ^[[:space:]]+(j[a-z]+|set[a-z]+|cmov[a-z]+|call) [^_]
not-match \(%rip\)|\(,%

case secret-difference-fixed-work
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 0 1
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_difference_bits
count = 1 ^[[:space:]]+j(e|ne|z|nz|l|le|g|ge|a|ae|b|be|s|ns)
metric backward-branches >= 1
not-match ^[[:space:]]+(cmpb|testb|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)

# Unrolled: every conditional branch tests the public count or index.
case secret-difference-unrolled
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_difference_bits
count <= 8 ^[[:space:]]+j(e|ne|z|nz|l|le|g|ge|a|ae|b|be|s|ns)
metric backward-branches >= 1
not-match ^[[:space:]]+(cmpb|testb|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)

# No clone, Debug, format, serialization, equality, hash or String helper.
case secret-no-escape-surface
do none
target -
opt -
in file stdlib/crypto_secret.tl
not-match ^\(define \((to-string|debug|show|format|clone|hash|serialize|to-bytes|as-bytes|to-hex)
not-match ^\(defdispatch

case secret-format-reject
do none
target -
opt -
run compile "{{work}}/format.tl" -o "{{dir}}/format.s" --stdlib-root "{{root}}/stdlib"
exit nonzero
stderr contains format: unsupported nominal type struct_stdlib.crypto_secret/SecretFixed
