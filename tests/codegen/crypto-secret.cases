# The secret load is only copied to the destination. All loop branches compare
# the public count/index; no byte comparison, data-dependent branch or table.
case secret-copy-fixed-work
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 0 1 2
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_copy_secret_range_bang
match ^[[:space:]]+movzbq \(%[a-z0-9]+(,%[a-z0-9]+,1)?\), %[a-z0-9]+
match ^[[:space:]]+movb %[a-z0-9]+, \(%[a-z0-9]+(,%[a-z0-9]+,1)?\)
count <= 8 ^[[:space:]]+j(e|ne|z|nz|l|le|g|ge|a|ae|b|be|s|ns)
metric backward-branches >= 1
not-match ^[[:space:]]+(cmpb|testb|set[a-z]+|cmov[a-z]+|call)
not-match \(%rip\)

# At opt0 the state constants remain calls; optimized bodies inline them.
# Outer poison precedes the sole nested cleanup, and outer closed follows it.
case secret-transfer-nested-close-opt0
source {{work}}/secret_shape.tl
args --stdlib-root {{root}}/stdlib --no-entry
target linux-x86_64 windows-x86_64
opt 0
in fn _tl_stdlib_crypto_secret_stdlib_crypto_secret_nominal_handle_close
order _tl_stdlib_crypto_secret_stdlib_crypto_secret_state_poisoned || _tl_stdlib_crypto_secret_stdlib_crypto_secret_close_fixed || _tl_stdlib_crypto_secret_stdlib_crypto_secret_state_closed
count = 1 call _tl_stdlib_crypto_secret_stdlib_crypto_secret_close_fixed

