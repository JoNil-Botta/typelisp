architecture x86_64
format ELF64-LSB-ET_DYN
gcc gcc (GCC) 16.2.1 20260810
clang clang version 23.1.3
linker GNU ld (GNU Binutils) 2.47
oracle GNU readelf (GNU Binutils) 2.47
libc glibc 2.44
producer scripts/generate-elf-dso-fixtures.sh
projection scripts/verify-elf-dso-reader-oracle.sh --project READELF_OUTPUT
