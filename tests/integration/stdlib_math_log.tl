(define (log-u64-within-one-ulp? [actual : u64] [expected : u64]) : bool
  (cond
    [(= (bit-and expected 0x7fffffffffffffff) (cast 0 : u64))
      (= actual expected)]
    [(!=
        (bit-and actual 0x8000000000000000)
        (bit-and expected 0x8000000000000000))
      false]
    [(> actual expected) (<= (- actual expected) (cast 1 : u64))]
    [else (<= (- expected actual) (cast 1 : u64))]))

(define (log-u32-within-one-ulp? [actual : u32] [expected : u32]) : bool
  (cond
    [(= (bit-and expected (cast 0x7fffffff : u32)) (cast 0 : u32))
      (= actual expected)]
    [(!=
        (bit-and actual (cast 0x80000000 : u32))
        (bit-and expected (cast 0x80000000 : u32)))
      false]
    [(> actual expected) (<= (- actual expected) (cast 1 : u32))]
    [else (<= (- expected actual) (cast 1 : u32))]))

(define (log-check-f64 [index : i64]) : bool
  (log-u64-within-one-ulp?
    (math.f64-to-bits
      (math.f64-log (math.f64-from-bits (array-ref log-f64-inputs index))))
    (array-ref log-f64-bits index)))

(define (log-check-f32 [index : i64]) : bool
  (log-u32-within-one-ulp?
    (math.f32-to-bits
      (math.f32-log (math.f32-from-bits (array-ref log-f32-inputs index))))
    (array-ref log-f32-bits index)))

(define (main) : i64
  (let
    [i : i64 0]
    (begin
      (while (< i 224)
        (begin
          (unless (log-check-f64 i) (return (+ 10 i)))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i 224)
        (begin
          (unless (log-check-f32 i) (return (+ 100010 i)))
          (set! i (+ i 1))))
      (unless
        (=
          (math.f64-to-bits (math.f64-log 0.0))
          (cast 0xfff0000000000000 : u64))
        (return 200001))
      (unless
        (=
          (math.f64-to-bits
            (math.f64-log (math.f64-from-bits 0x8000000000000000)))
          (cast 0xfff0000000000000 : u64))
        (return 200002))
      (unless (math.f64-nan? (math.f64-log -1.0)) (return 200003))
      (unless
        (math.f64-nan? (math.f64-log (math.f64-negative-infinity)))
        (return 200004))
      (unless
        (=
          (math.f64-to-bits (math.f64-log (math.f64-positive-infinity)))
          (cast 0x7ff0000000000000 : u64))
        (return 200005))
      (unless
        (math.f64-nan? (math.f64-log (math.f64-quiet-nan)))
        (return 200006))
      (unless
        (=
          (math.f32-to-bits (math.f32-log (cast 0.0 : f32)))
          (cast 0xff800000 : u32))
        (return 200007))
      (unless
        (=
          (math.f32-to-bits
            (math.f32-log (math.f32-from-bits (cast 0x80000000 : u32))))
          (cast 0xff800000 : u32))
        (return 200008))
      (unless (math.f32-nan? (math.f32-log (cast -1.0 : f32))) (return 200009))
      (unless
        (math.f32-nan? (math.f32-log (math.f32-negative-infinity)))
        (return 200010))
      (unless
        (=
          (math.f32-to-bits (math.f32-log (math.f32-positive-infinity)))
          (cast 0x7f800000 : u32))
        (return 200011))
      (unless
        (math.f32-nan? (math.f32-log (math.f32-quiet-nan)))
        (return 200012))
      0)))