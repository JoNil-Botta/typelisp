(define (pow-u64-key [bits : u64]) : u64
  (if (= (bit-and bits (cast 0x8000000000000000 : u64)) (cast 0 : u64))
    (+ bits (cast 0x8000000000000000 : u64))
    (- (cast 0xffffffffffffffff : u64) bits)))

(define (pow-u32-key [bits : u32]) : u32
  (if (= (bit-and bits (cast 0x80000000 : u32)) (cast 0 : u32))
    (+ bits (cast 0x80000000 : u32))
    (- (cast 0xffffffff : u32) bits)))

(define (pow-u64-result-ok? [actual : u64] [expected : u64]) : bool
  (let
    [magnitude : u64 (bit-and expected (cast 0x7fffffffffffffff : u64))]
    (cond
      [(> magnitude (cast 0x7ff0000000000000 : u64))
        (math.f64-nan? (math.f64-from-bits actual))]
      [(or
          (= magnitude (cast 0 : u64))
          (= magnitude (cast 0x7ff0000000000000 : u64)))
        (= actual expected)]
      [else
        (let
          [actual-key : u64 (pow-u64-key actual)]
          [expected-key : u64 (pow-u64-key expected)]
          (if (>= actual-key expected-key)
            (<= (- actual-key expected-key) (cast 1 : u64))
            (<= (- expected-key actual-key) (cast 1 : u64))))])))

(define (pow-u32-result-ok? [actual : u32] [expected : u32]) : bool
  (let
    [magnitude : u32 (bit-and expected (cast 0x7fffffff : u32))]
    (cond
      [(> magnitude (cast 0x7f800000 : u32))
        (math.f32-nan? (math.f32-from-bits actual))]
      [(or (= magnitude (cast 0 : u32)) (= magnitude (cast 0x7f800000 : u32)))
        (= actual expected)]
      [else
        (let
          [actual-key : u32 (pow-u32-key actual)]
          [expected-key : u32 (pow-u32-key expected)]
          (if (>= actual-key expected-key)
            (<= (- actual-key expected-key) (cast 1 : u32))
            (<= (- expected-key actual-key) (cast 1 : u32))))])))

(define (pow-check-f64 [index : i64]) : bool
  (pow-u64-result-ok?
    (math.f64-to-bits
      (math.f64-pow
        (math.f64-from-bits (array-ref pow-f64-bases index))
        (math.f64-from-bits (array-ref pow-f64-exponents index))))
    (array-ref pow-f64-bits index)))

(define (pow-check-f32 [index : i64]) : bool
  (pow-u32-result-ok?
    (math.f32-to-bits
      (math.f32-pow
        (math.f32-from-bits (array-ref pow-f32-bases index))
        (math.f32-from-bits (array-ref pow-f32-exponents index))))
    (array-ref pow-f32-bits index)))

(define (main) : i64
  (let
    [index : i64 0]
    (begin
      (while (< index 254)
        (begin
          (unless (pow-check-f64 index) (return (+ 10 index)))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index 186)
        (begin
          (unless (pow-check-f32 index) (return (+ 100010 index)))
          (set! index (+ index 1))))
      0)))