  {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"${{TMP_URI}}/semantic-nominal-navigation.tl","languageId":"typelisp","version":1,"text":"(module provider.matrix)\n(import provider.nominal as nd)\n;: Local pair documentation.\n(defstruct SemanticPair\n  (left i64)\n  (right i64))\n(defstruct OtherPair\n  (left i64))\n;: Local choice documentation.\n(defenum SemanticChoice\n  (SemanticEmpty)\n  (SemanticFull i64))\n(defenum OtherChoice\n  (OtherEmpty)\n  (SemanticFull String))\n(define (pair-sum [p : SemanticPair]) : i64\n  (+ p.left p.right))\n(define (set-left [p : SemanticPair]) : i64\n  (begin (set! p.left 9) p.left))\n(define (other-left [p : OtherPair]) : i64\n  p.left)\n(define default-choice : SemanticChoice\n  SemanticEmpty)\n(define (probe [c : SemanticChoice]) : i64\n  (match c\n    [SemanticEmpty 0]\n    [(SemanticFull item) item]))\n(define (probe-other [c : OtherChoice]) : i64\n  (match c\n    [OtherEmpty 0]\n    [(SemanticFull item) 1]))\n(define imported : nd.ImportedChoice\n  (nd.ImportedSome (nd.ImportedBox 3)))\n(define (imported-value [b : nd.ImportedBox]) : i64\n  b.value)\n(define (imported-probe [c : nd.ImportedChoice]) : i64\n  (match c\n    [nd.ImportedNone 0]\n    [(nd.ImportedSome item) item.value]))"}}},
