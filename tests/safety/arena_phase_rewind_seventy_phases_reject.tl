;; #9480: the parent chain of seventy phases, not a depth cap, decides that
;; rewinding `p1` ends the value allocated in `p70`.
(import stdlib.arena)
(import stdlib.string)

(define (main) : i64
  (let
    [o : arena.Arena (arena.make)]
    [p1 (arena.phase o)]
    [p2 (arena.phase o)]
    [p3 (arena.phase o)]
    [p4 (arena.phase o)]
    [p5 (arena.phase o)]
    [p6 (arena.phase o)]
    [p7 (arena.phase o)]
    [p8 (arena.phase o)]
    [p9 (arena.phase o)]
    [p10 (arena.phase o)]
    [p11 (arena.phase o)]
    [p12 (arena.phase o)]
    [p13 (arena.phase o)]
    [p14 (arena.phase o)]
    [p15 (arena.phase o)]
    [p16 (arena.phase o)]
    [p17 (arena.phase o)]
    [p18 (arena.phase o)]
    [p19 (arena.phase o)]
    [p20 (arena.phase o)]
    [p21 (arena.phase o)]
    [p22 (arena.phase o)]
    [p23 (arena.phase o)]
    [p24 (arena.phase o)]
    [p25 (arena.phase o)]
    [p26 (arena.phase o)]
    [p27 (arena.phase o)]
    [p28 (arena.phase o)]
    [p29 (arena.phase o)]
    [p30 (arena.phase o)]
    [p31 (arena.phase o)]
    [p32 (arena.phase o)]
    [p33 (arena.phase o)]
    [p34 (arena.phase o)]
    [p35 (arena.phase o)]
    [p36 (arena.phase o)]
    [p37 (arena.phase o)]
    [p38 (arena.phase o)]
    [p39 (arena.phase o)]
    [p40 (arena.phase o)]
    [p41 (arena.phase o)]
    [p42 (arena.phase o)]
    [p43 (arena.phase o)]
    [p44 (arena.phase o)]
    [p45 (arena.phase o)]
    [p46 (arena.phase o)]
    [p47 (arena.phase o)]
    [p48 (arena.phase o)]
    [p49 (arena.phase o)]
    [p50 (arena.phase o)]
    [p51 (arena.phase o)]
    [p52 (arena.phase o)]
    [p53 (arena.phase o)]
    [p54 (arena.phase o)]
    [p55 (arena.phase o)]
    [p56 (arena.phase o)]
    [p57 (arena.phase o)]
    [p58 (arena.phase o)]
    [p59 (arena.phase o)]
    [p60 (arena.phase o)]
    [p61 (arena.phase o)]
    [p62 (arena.phase o)]
    [p63 (arena.phase o)]
    [p64 (arena.phase o)]
    [p65 (arena.phase o)]
    [p66 (arena.phase o)]
    [p67 (arena.phase o)]
    [p68 (arena.phase o)]
    [p69 (arena.phase o)]
    [p70 (arena.phase o)]
    [v (in-arena o (string.append "owner" "-text"))]
    (begin
      (arena.rewind-safe! p1)
      (in-arena o (string.append "clobber" "-the-old-text"))
      (if (string.string=? (& v) "owner-text")
        42
        7))))