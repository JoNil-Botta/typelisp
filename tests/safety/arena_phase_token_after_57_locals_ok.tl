;: An arena phase token stays direct however many locals precede it: binding
;: it can cross the type environment's local-cache threshold (57 earlier locals
;: put a cache layer between the token and its markers), which must not hide
;: the token from `arena.rewind-safe!`.
(import stdlib.arena)

(define (main) : i64
  (let
    [scratch : arena.Arena (arena.make)]
    [_v0 : i64 0]
    [_v1 : i64 1]
    [_v2 : i64 2]
    [_v3 : i64 3]
    [_v4 : i64 4]
    [_v5 : i64 5]
    [_v6 : i64 6]
    [_v7 : i64 7]
    [_v8 : i64 8]
    [_v9 : i64 9]
    [_v10 : i64 10]
    [_v11 : i64 11]
    [_v12 : i64 12]
    [_v13 : i64 13]
    [_v14 : i64 14]
    [_v15 : i64 15]
    [_v16 : i64 16]
    [_v17 : i64 17]
    [_v18 : i64 18]
    [_v19 : i64 19]
    [_v20 : i64 20]
    [_v21 : i64 21]
    [_v22 : i64 22]
    [_v23 : i64 23]
    [_v24 : i64 24]
    [_v25 : i64 25]
    [_v26 : i64 26]
    [_v27 : i64 27]
    [_v28 : i64 28]
    [_v29 : i64 29]
    [_v30 : i64 30]
    [_v31 : i64 31]
    [_v32 : i64 32]
    [_v33 : i64 33]
    [_v34 : i64 34]
    [_v35 : i64 35]
    [_v36 : i64 36]
    [_v37 : i64 37]
    [_v38 : i64 38]
    [_v39 : i64 39]
    [_v40 : i64 40]
    [_v41 : i64 41]
    [_v42 : i64 42]
    [_v43 : i64 43]
    [_v44 : i64 44]
    [_v45 : i64 45]
    [_v46 : i64 46]
    [_v47 : i64 47]
    [_v48 : i64 48]
    [_v49 : i64 49]
    [_v50 : i64 50]
    [_v51 : i64 51]
    [_v52 : i64 52]
    [_v53 : i64 53]
    [_v54 : i64 54]
    [_v55 : i64 55]
    [_v56 : i64 56]
    [phase : arena.ArenaPhase (arena.phase scratch)]
    (arena.rewind-safe! phase)
    (arena.destroy-safe! scratch)
    42))