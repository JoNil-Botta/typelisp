# ------------------------------------------------------------ native Slices

# A native Slice foreach is a vector map; an ordinary while loop over Slices is
# not vectorized implicitly.
case native-slice
source tests/spmd/native_slice_surface_i64.tl
mode avx2 avx512
opt 2
in fn _tl_native_slice_surface_i64_slice_case
not-match %ymm[0-9]+|%zmm[0-9]+|%k[0-7]
in fn _tl_native_slice_surface_i64_fill_slice_foreach
contains vpaddq
if-mode avx2
contains %ymm
contains vmovdqu
contains vpmaskmovq
not-match %zmm[0-9]+|%k[0-7]
else
contains %zmm
contains vmovdqu64
contains {%k
not-contains vpmaskmovq
end-if

# Scalar mode consolidates the masked helper's bounds checks to one call for
# each of its four Slices.
case native-slice-scalar-masked-bounds
source tests/spmd/native_slice_surface_i64.tl
mode scalar
opt 2
in fn _tl_native_slice_surface_i64_masked_slice_foreach
count-fixed = 4 call tl_oob_abort_at

case native-slice-multi-output
source tests/spmd/native_slice_multi_output_i64.tl
mode avx2 avx512
opt 2
in fn _tl_native_slice_multi_output_i64_map_two_outputs
count = 4 ^[[:space:]]+call[[:space:]]+tl_oob_abort(_at)?
contains vpaddq
contains vpsubq
if-mode avx2
contains %ymm
else
match %zmm[0-9]+|%k[0-7]
end-if

# Every source and destination joins the fused safety proof: a short second
# destination leaves the SIMD path and keeps the scalar bounds trap.
case multi-output-bounds-trap
source tests/spmd/multi_output_bounds_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds
