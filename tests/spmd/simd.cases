# AVX2 masked bodies use native dword/qword masked moves with a blend instead of
# staging lanes; bool and i16/u16 lanes keep the staged fallback.
case native-mask-avx2
source tests/spmd/masked_if_value_types.tl
mode avx2
in fn _tl_masked_if_value_types_fill_u32_foreach
contains vpmaskmovd
contains vpblendvb
not-match _load_skip_|_store_skip_
in fn _tl_masked_if_value_types_fill_u64_foreach
contains vpmaskmovq
contains vpblendvb
not-match _load_skip_|_store_skip_
in fn _tl_masked_if_value_types_fill_f32_foreach
contains vmaskmovps
contains vpblendvb
not-match _load_skip_|_store_skip_
in fn _tl_masked_if_value_types_fill_f64_foreach
contains vmaskmovpd
contains vpblendvb
not-match _load_skip_|_store_skip_
in fn _tl_masked_if_value_types_fill_bool_foreach
not-match vpmaskmov|vmaskmov

case narrow-mask-fallback-avx2
source tests/spmd/masked_if_i16_u16.tl
mode avx2
contains _load_skip_
contains _store_skip_
not-match vpmaskmov|vmaskmov

