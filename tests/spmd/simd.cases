source tests/integration/spmd_shuffle_simd.tl
mode avx2 avx512
contains vpermd
not-match vector_shuffle_.*_skip_
if-mode avx2
not-match %zmm[0-9]+|%k[0-7]
contains vpcmpgtq
contains vpmovmskb
else
contains vpermq
contains vpcmpuq
contains kmovw
end-if

# The paired benchmark has only compile-time identity selectors; they are gone
# before backend shuffle emission.
case shuffle-identity-eliminated
source benchmarks/spmd_shuffle/bench.tl
mode avx2 avx512
not-match vpermd|vpermq|vector_shuffle_

# A three-lane partial gang with exactly sized value and selector arrays. SIMD
# modes only: scalar has one-lane gangs, a different selector contract.
