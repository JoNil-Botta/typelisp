count-fixed = 2 vpmullw
count-fixed = 3 vpsrlw $8
count-fixed = 2 vpsllw $8
not-match ^[[:space:]]+imul
if-mode avx2
count-fixed = 1 vpor
contains %ymm
else
count-fixed = 1 vpord
contains %zmm
end-if
in fn _tl_byte_mul_value_types_fill_masked
contains vpmullw
in fn _tl_byte_mul_value_types_fill_masked_u8
contains vpmullw
in fn _tl_byte_mul_value_types_fill_while
contains vpmullw
in fn _tl_byte_mul_value_types_fill_while_u8
contains vpmullw

