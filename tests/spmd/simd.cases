# Byte shifts widen to dwords, shift, and pack back inside the gang.
case byte-shift
source tests/spmd/byte_shift_value_types.tl
mode avx2 avx512
in fn _tl_byte_shift_value_types_run_direct_i8
narrow ranges:foreach_avx2_body~foreach_tail_header
contains vpmovsxbd
contains vpsllvd
contains vpsravd
contains vpackusdw
contains vpackuswb
contains vpermd
contains call tl_shift_abort
not-match ^[[:space:]]+(salb|sarb|shrb)[[:space:]]
in fn _tl_byte_shift_value_types_run_direct_u8
narrow ranges:foreach_avx2_body~foreach_tail_header
contains vpmovzxbd
contains vpsllvd
contains vpsrlvd
contains vpackusdw
contains vpackuswb
contains vpermd
contains call tl_shift_abort
not-match ^[[:space:]]+(salb|sarb|shrb)[[:space:]]

# Word shifts widen on AVX2 and use native word shifts on AVX-512.
case word-shift
source tests/spmd/word_shift_value_types.tl
mode avx2 avx512
in fn _tl_word_shift_value_types_run_direct_i16
narrow ranges:foreach_avx2_body~foreach_tail_header
contains call tl_shift_abort
not-match ^[[:space:]]+(salw|sarw|shrw)[[:space:]]
if-mode avx2
contains vpmovsxwd
contains vpsllvd
contains vpsravd
contains vpackusdw
contains vpermq
else
contains vpsllvw
contains vpsravw
not-match vpmov(sx|zx)wd|vpackusdw
end-if
in fn _tl_word_shift_value_types_run_direct_u16
narrow ranges:foreach_avx2_body~foreach_tail_header
contains call tl_shift_abort
not-match ^[[:space:]]+(salw|sarw|shrw)[[:space:]]
if-mode avx2
contains vpmovzxwd
contains vpsllvd
contains vpsrlvd
contains vpackusdw
contains vpermq
else
contains vpsllvw
contains vpsrlvw
not-match vpmov(sx|zx)wd|vpackusdw
end-if

# Active invalid counts keep scalar trap semantics in masked control flow and
# direct maps: signed negative counts, and unsigned counts equal to the byte,
# word and dword widths.
case masked-if-shift-negative-trap
source tests/spmd/masked_if_shift_negative_trap.tl
do link-run
mode scalar avx2 avx512
exit 129
in stderr
contains shift count out of range

