file inline_helper_unit_argument.tl
(define (ignore-unit [_u : unit]) : i64 7)
(define (fill [counts : (&mut counts (__tl_dyn-array i64))]
              [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n])
    (set! (array-ref out i)
      (ignore-unit (set! (array-ref counts i) 1)))))
(define (main) : i64
  (let [counts : (__tl_dyn-array i64) (__tl_make-array i64 7)]
       [out : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (begin
      (fill (&mut counts) (&mut out) 7)
      (if (and (= (array-ref counts 0) 1) (= (array-ref counts 6) 1)
               (= (array-ref out 0) 7) (= (array-ref out 6) 7)) 42 1))))
end-file

file inline_helper_variable_snapshot.tl
(define (first [a : i64] [_b : i64]) : i64 a)
(define (fill [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n])
    (let [x : i64 (+ i 1)]
      (set! (array-ref out i)
        (first x (begin (set! x 99) 0))))))
(define (main) : i64
  (let [out : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (begin
      (fill (&mut out) 7)
      (if (and (= (array-ref out 0) 1) (= (array-ref out 6) 7)) 42 1))))
end-file

# SPMD SIMD codegen shapes and trap paths, run by scripts/verify-spmd-simd.sh
# (gate stage2-spmd-simd-comparison) after its same-exit corpus. Shape cases
# only compile, so they run on every host; trap cases build and run each mode,
# and a SIMD mode the host cannot execute still compiles with its run rows
# skipped.

target -
opt -

# Programs for the inline-helper call-by-value cases below (#7541).

file inline_helper_unused_fault.tl
(define (ignore [value : i64]) : i64
  7)

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n]) (set! (array-ref out i) (ignore (array-ref short i)))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& short) (&mut out) n)
      (array-ref out 8))))
end-file

file inline_helper_reversed_fault.tl
(define (second-minus-first [a : i64] [b : i64]) : i64
  (- b a))

(define (fill
  [first : (& first (__tl_dyn-array i64))]
  [second : (& second (__tl_dyn-array i64))]
  [out : (&mut out (__tl_dyn-array i64))]
  [n : i64]) : unit
  (foreach ([i : i64 0 n]) (set! (array-ref out i) (second-minus-first (array-ref first i) (array-ref second i)))))

(define (main) : i64
  (let
    [n : i64 9]
    [first : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [second : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& first) (& second) (&mut out) n)
      (array-ref out 8))))
end-file

file inline_helper_masked_inactive.tl
(define (ignore [value : i64]) : i64
  7)

(define (twice [value : i64]) : i64
  (+ value value))

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 3)
      (set! (array-ref out i) (+ (twice (array-ref short i)) (ignore (array-ref short i))))
      (set! (array-ref out i) 1))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (set! (array-ref short 2) 10)
      (fill (& short) (&mut out) n)
      (+ (array-ref out 2) (array-ref out 8)))))
end-file

file inline_helper_masked_fault.tl
(define (ignore [value : i64]) : i64
  7)

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 5)
      (set! (array-ref out i) (ignore (array-ref short i)))
      (set! (array-ref out i) 1))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& short) (&mut out) n)
      (array-ref out 8))))
end-file

# ------------------------------------------------------------------ gathers

case gather-read-opcodes
source tests/integration/spmd_gather_read.tl
mode avx2 avx512
contains vpgatherqd
contains vpgatherqq
contains vgatherqps
contains vgatherqpd
# The computed gather adds the lane offset in a vector.
contains vpaddq

case gather-reduce-opcodes
source benchmarks/ispc/perfbench_gathers/bench.tl
mode avx2 avx512
contains vgatherqps
contains vaddps

# Gather safety is a runtime property: a full gang with several invalid active
# lanes takes the ordinary bounds abort in every mode, because the lowering
# checks logical lanes before the hardware gather.
case gather-oob
source tests/integration/spmd_gather_oob.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case gather-lane-offset-oob
source tests/integration/spmd_gather_lane_offset_oob.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

# Below opt2 a loop counter and the slice accessors keep several Mov
# definitions joined by back edges; the backend's SIMD copy-shape query must
# visit each variable once instead of exploring those chains exponentially
# (#8394). Both levels used to exhaust memory in the SIMD modes.
case loop-carried-copy-shape
source tests/integration/spmd_loop_carried_copy_shape.tl
do link-run
mode scalar avx2 avx512
opt 0 1
exit 42

# Fixed arrays, global, local and referenced, are SPMD operands through one
# preheader Slice view each (#8346): all eight foreach loops take the vector
# path, gathering every 32- and 64-bit lane type.
case fixed-array-sources-opcodes
source tests/spmd/fixed_array_sources.tl
mode avx2 avx512
contains vpgatherqq
contains vpgatherqd
contains vgatherqpd
contains vgatherqps
count = 8 foreach_avx2_body\.[0-9]+:

# A fixed-array gather keeps the ordinary per-lane bounds check, in logical
# lane order, before the hardware gather.
case fixed-array-gather-oob
source tests/spmd/fixed_array_gather_oob.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 134
in stderr
contains array index out of bounds

