# ------------------------------------------------------ SIMD staging region

# #7497: the staged SIMD sequences address one per-function frame region
# instead of moving %rsp: the variable-shift fallbacks, gather reassembly,
# shuffle staging, and AVX2 predicated and tail-mask lane staging. The only
# `subq` of %rsp in these kernels is the prologue's, on both targets. The
# rsp/FPO rebase rewrites the region with the rest of the frame.
case simd-staging-byte-shift
source tests/spmd/byte_shift_value_types.tl
target linux-x86_64 windows-x86_64
mode avx2 avx512
in fn _tl_byte_shift_value_types_run_direct_i8
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
match ^[[:space:]]+vpmovzxbd [0-9]+\(%rsp\), %[yz]mm0$
in fn _tl_byte_shift_value_types_run_masked_u8
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$

case simd-staging-word-shift
source tests/spmd/word_shift_value_types.tl
target linux-x86_64 windows-x86_64
mode avx2
in fn _tl_word_shift_value_types_run_direct_i16
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
match ^[[:space:]]+vpmovsxwd [0-9]+\(%rsp\), %ymm0$

case simd-staging-gather
source tests/integration/spmd_gather_read.tl
target linux-x86_64 windows-x86_64
mode avx2 avx512
in fn _tl_spmd_gather_read_case_i32_gather
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
after ^[[:space:]]+vpgatherqd .*%[xy]mm[0-9]+(\{%k7\})?$
next-line ^[[:space:]]+vmovdqu(32)? %[xy]mm[0-9]+, [0-9]+\(%rsp\)$

# The selector abort calls out while the region is live, from the ordinary
# frame: no call-site stack motion beyond the target's own call-space plan.
case simd-staging-shuffle
source tests/integration/spmd_shuffle_abort_nested.tl
target linux-x86_64 windows-x86_64
mode avx2 avx512
in fn _tl_spmd_shuffle_abort_nested_permute_kernel
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
not-contains pushq %rbp
after _abort:$
next-line ^[[:space:]]+call tl_oob_abort$
match ^[[:space:]]+vperm[dq] [0-9]+\(%rsp\), %[yz]mm0, %[yz]mm[0-9]+$

# A --backtrace frame keeps its %rbp chain; the region is ordinary frame
# state inside it.
case simd-staging-rbp-frame
source tests/integration/spmd_shuffle_abort_nested.tl
mode avx2 avx512
opt 0
args --backtrace
in fn _tl_spmd_shuffle_abort_nested_permute_kernel
contains movq %rsp, %rbp
count = 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
match ^[[:space:]]+vperm[dq] [0-9]+\(%rsp\), %[yz]mm0, %[yz]mm[0-9]+$

# A call-free leaf keeps its staged lanes in the SysV red zone, below the
# entry %rsp, with no stack adjustment at all. Windows has no red zone.
case simd-staging-red-zone
source tests/spmd/tail_i32_add.tl
target linux-x86_64
mode avx2
in fn _tl_tail_i32_add_fill
metric frame-size = 0
match ^[[:space:]]+vmovdqu %ymm0, -[0-9]+\(%rsp\)$
match ^[[:space:]]+movl \$-1, -[0-9]+\(%rsp\)$

case simd-staging-predicated
source tests/spmd/masked_if_i16_u16.tl
target linux-x86_64 windows-x86_64
mode avx2
in fn _tl_masked_if_i16_u16_fill_i16_foreach
count <= 1 ^[[:space:]]+subq \$[0-9]+, %rsp$
contains _load_skip_
contains _store_skip_

# The AVX-512 bool store builds its row of 1 bytes in registers instead of
# broadcasting a pushed immediate.
case simd-staging-bool-store
source tests/spmd/bool_lanes.tl
target linux-x86_64 windows-x86_64
mode avx512
in fn _tl_bool_lanes_fill_bool_copy_foreach
not-contains pushq $1
not-match vpbroadcastb .*%rsp
contains vpternlogd $255,
contains vpabsb

# A shuffle's selector abort, three calls below main, while its staging
# region is live: the fatal backtrace names every caller on both hosts.
case shuffle-abort-nested-backtrace
source tests/integration/spmd_shuffle_abort_nested.tl
do build-run
mode avx2 avx512
opt 0
args --backtrace
exit 134
in stderr
contains array index out of bounds
contains stack backtrace:
order spmd_shuffle_abort_nested.tl::permute-kernel || spmd_shuffle_abort_nested.tl::middle || spmd_shuffle_abort_nested.tl::outer || main at

# ------------------------------------------ inline-helper call-by-value

# #7541: an inlined helper evaluates each argument once, left to right,
# before its body, in every mode. An argument the helper never reads still
# faults, at the call's argument. With both arguments out of range the first
# faults, though the helper reads them in reverse. In a masked branch an
# active lane's unread argument faults and an inactive lane's does not.
# Earlier variable reads capture their value before later arguments mutate it.
case inline-helper-variable-snapshot
source {{work}}/inline_helper_variable_snapshot.tl
do link-run
mode scalar avx2 avx512
opt 2
exit 42
in stderr
empty

# An unread unit parameter still evaluates its store on every active lane.
case inline-helper-unit-argument
source {{work}}/inline_helper_unit_argument.tl
do link-run
mode scalar avx2 avx512
opt 2
exit 42
in stderr
empty

case inline-helper-unused-arg-fault
source {{work}}/inline_helper_unused_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_unused_fault.tl:5:77: array index out of bounds: index=3 length=3

case inline-helper-reversed-arg-fault
source {{work}}/inline_helper_reversed_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_reversed_fault.tl:9:89: array index out of bounds: index=3 length=3

case inline-helper-masked-inactive-args
source {{work}}/inline_helper_masked_inactive.tl
do link-run
mode scalar avx2 avx512
exit 28
in stderr
empty

case inline-helper-masked-active-arg-fault
source {{work}}/inline_helper_masked_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_masked_fault.tl:8:56: array index out of bounds: index=3 length=3

# Argument staging keeps today's vector code: the helper's arithmetic is
# packed in the foreach body, with no per-lane helper call.
case inline-helper-direct-map-shape
source tests/spmd/inline_helper_i64.tl
mode avx2 avx512
in fn _tl_inline_helper_i64_fill_inline
contains foreach_avx2_body
match ^[[:space:]]+vpaddq \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %[yz]mm[0-9]+, %[yz]mm[0-9]+$
not-contains _bump

case inline-helper-f64-direct-map-shape
source tests/spmd/inline_helper_f64.tl
mode avx2 avx512
contains foreach_avx2_body
match ^[[:space:]]+vmulpd %[yz]mm
match ^[[:space:]]+vaddpd
not-match call .*_scale$

case inline-helper-masked-shape
source tests/spmd/inline_helper_masked_if_i64.tl
mode avx2 avx512
in fn _tl_inline_helper_masked_if_i64_fill_inline
contains foreach_avx512_mask_body
match ^[[:space:]]+vpaddq %[yz]mm
not-match call .*(_bump|_non_negative)

