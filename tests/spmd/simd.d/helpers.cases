# SPMD SIMD codegen shapes and trap paths, run by scripts/verify-spmd-simd.sh
# (gate stage2-spmd-simd-comparison). See tests/spmd/simd.d/.

target -
opt -

file inline_helper_unit_argument.tl
(define (ignore-unit [_u : unit]) : i64 7)
(define (fill [counts : (&mut counts (__tl_dyn-array i64))]
              [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n])
    (set! (array-ref out i)
      (ignore-unit (set! (array-ref counts i) 1)))))
(define (main) : i64
  (let [counts : (__tl_dyn-array i64) (__tl_make-array i64 7)]
       [out : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (begin
      (fill (&mut counts) (&mut out) 7)
      (if (and (= (array-ref counts 0) 1) (= (array-ref counts 6) 1)
               (= (array-ref out 0) 7) (= (array-ref out 6) 7)) 42 1))))
end-file

file inline_helper_variable_snapshot.tl
(define (first [a : i64] [_b : i64]) : i64 a)
(define (fill [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n])
    (let [x : i64 (+ i 1)]
      (set! (array-ref out i)
        (first x (begin (set! x 99) 0))))))
(define (main) : i64
  (let [out : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (begin
      (fill (&mut out) 7)
      (if (and (= (array-ref out 0) 1) (= (array-ref out 6) 7)) 42 1))))
end-file

file call_arg_snapshot_out_of_line.tl
;; Over the inline node limit, so the call stays out of line.
(define (first-out-of-line [a : i64] [b : i64]) : i64
  (+ (+ (+ (+ (+ (+ (+ a 0) 0) 0) 0) 0) 0) (* b 0)))
(define (fill [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n])
    (let [x : i64 (+ i 1)]
      (set! (array-ref out i)
        (first-out-of-line x (begin (set! x 99) 0))))))
(define (main) : i64
  (let [out : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (begin
      (fill (&mut out) 7)
      (if (and (= (array-ref out 0) 1) (= (array-ref out 6) 7)) 42 1))))
end-file

# Programs for the inline-helper call-by-value cases below (#7541).

file inline_helper_unused_fault.tl
(define (ignore [value : i64]) : i64
  7)

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n]) (set! (array-ref out i) (ignore (array-ref short i)))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& short) (&mut out) n)
      (array-ref out 8))))
end-file

file inline_helper_reversed_fault.tl
(define (second-minus-first [a : i64] [b : i64]) : i64
  (- b a))

(define (fill
  [first : (& first (__tl_dyn-array i64))]
  [second : (& second (__tl_dyn-array i64))]
  [out : (&mut out (__tl_dyn-array i64))]
  [n : i64]) : unit
  (foreach ([i : i64 0 n]) (set! (array-ref out i) (second-minus-first (array-ref first i) (array-ref second i)))))

(define (main) : i64
  (let
    [n : i64 9]
    [first : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [second : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& first) (& second) (&mut out) n)
      (array-ref out 8))))
end-file

file inline_helper_masked_inactive.tl
(define (ignore [value : i64]) : i64
  7)

(define (twice [value : i64]) : i64
  (+ value value))

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 3)
      (set! (array-ref out i) (+ (twice (array-ref short i)) (ignore (array-ref short i))))
      (set! (array-ref out i) 1))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (set! (array-ref short 2) 10)
      (fill (& short) (&mut out) n)
      (+ (array-ref out 2) (array-ref out 8)))))
end-file

file inline_helper_masked_fault.tl
(define (ignore [value : i64]) : i64
  7)

(define (fill [short : (& short (__tl_dyn-array i64))] [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 5)
      (set! (array-ref out i) (ignore (array-ref short i)))
      (set! (array-ref out i) 1))))

(define (main) : i64
  (let
    [n : i64 9]
    [short : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    (begin
      (fill (& short) (&mut out) n)
      (array-ref out 8))))
end-file

# ------------------------------------------ inline-helper call-by-value

# #7541: an inlined helper evaluates each argument once, left to right,
# before its body, in every mode. An argument the helper never reads still
# faults, at the call's argument. With both arguments out of range the first
# faults, though the helper reads them in reverse. In a masked branch an
# active lane's unread argument faults and an inactive lane's does not.
# Earlier variable reads capture their value before later arguments mutate it.
case inline-helper-variable-snapshot
source {{work}}/inline_helper_variable_snapshot.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 42
in stderr
empty

# An unread unit parameter still evaluates its store on every active lane.
case inline-helper-unit-argument
source {{work}}/inline_helper_unit_argument.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 42
in stderr
empty

# #8433: an out-of-line call passes an earlier variable read's value too.
case call-arg-snapshot-out-of-line
source {{work}}/call_arg_snapshot_out_of_line.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 42
in stderr
empty

case inline-helper-unused-arg-fault
source {{work}}/inline_helper_unused_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_unused_fault.tl:5:77: array index out of bounds: index=3 length=3

case inline-helper-reversed-arg-fault
source {{work}}/inline_helper_reversed_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_reversed_fault.tl:9:89: array index out of bounds: index=3 length=3

case inline-helper-masked-inactive-args
source {{work}}/inline_helper_masked_inactive.tl
do link-run
mode scalar avx2 avx512
exit 28
in stderr
empty

case inline-helper-masked-active-arg-fault
source {{work}}/inline_helper_masked_fault.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains inline_helper_masked_fault.tl:8:56: array index out of bounds: index=3 length=3

# Argument staging keeps today's vector code: the helper's arithmetic is
# packed in the foreach body, with no per-lane helper call.
case inline-helper-direct-map-shape
source tests/spmd/inline_helper_i64.tl
mode avx2 avx512
in fn _tl_inline_helper_i64_fill_inline
contains foreach_avx2_body
match ^[[:space:]]+vpaddq \(%r[a-z0-9]+,%r[a-z0-9]+,8\), %[yz]mm[0-9]+, %[yz]mm[0-9]+$
not-contains _bump

case inline-helper-f64-direct-map-shape
source tests/spmd/inline_helper_f64.tl
mode avx2 avx512
contains foreach_avx2_body
match ^[[:space:]]+vmulpd %[yz]mm
match ^[[:space:]]+vaddpd
not-match call .*_scale$

case inline-helper-masked-shape
source tests/spmd/inline_helper_masked_if_i64.tl
mode avx2 avx512
in fn _tl_inline_helper_masked_if_i64_fill_inline
contains foreach_avx512_mask_body
match ^[[:space:]]+vpaddq %[yz]mm
not-match call .*(_bump|_non_negative)

case inline-helper-composition-shape
source tests/integration/spmd_inline_helper_composition.tl
target linux-x86_64 windows-x86_64
mode avx2 avx512
opt 0 1 2
assemble
in fn _tl_spmd_inline_helper_composition_fill
contains foreach_avx512_mask_body
match ^[[:space:]]+vpaddq .*%[yz]mm
not-match call .*(_bump|_compose|_combine)

# ------------------------------------------------------ private SPMD helpers

# AVX2 private helpers stay AVX2 and call the native private entry with the
# stack-block ABI pointer; atomic SPMD bodies keep the scalar fallback.
case private-helper-i64-avx2
source tests/spmd/private_helper_i64.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-f64-avx2
source tests/spmd/private_helper_f64.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-bool-avx2
source tests/spmd/private_helper_bool.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-mask-arg-avx2
source tests/spmd/private_helper_mask_arg.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

# The scalar helper call clobbers the caller-saved registers like any call, so
# the constant hoister must not keep the loop's `% 3` magic in one across it
# (#8198). Opt 2 scalar used to exit 1.
case private-helper-mask-arg-run
source tests/spmd/private_helper_mask_arg.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 42
in stderr
empty

case private-helper-uniform-stack-avx2
source tests/spmd/private_helper_uniform_stack.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-entry-uniform-float-run
source tests/spmd/private_helper_entry_uniform_float.tl
do link-run
mode scalar avx2 avx512
opt 0 1 2
exit 42
in stderr
empty
in asm
if-mode avx2 avx512
match call _tl___tl_spmd_
end-if
if-mode avx2
not-match %zmm[0-9]+|%k[0-7]
match vmovdqu .*%ymm
end-if
if-mode avx512
contains foreach_avx512_mask_body
end-if

case private-helper-masked-load-avx2
source tests/spmd/private_helper_masked_load.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-store-avx2
source tests/spmd/private_helper_store.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]
match call _tl___tl_spmd_
match leaq? .*\(%rsp\), %r10

case private-helper-effects-avx2
source tests/spmd/private_helper_effects.tl
mode avx2
not-match %zmm[0-9]+|%k[0-7]

# Dead helper bodies still have private ABI prologue writes. Opt0 unit literal
# lowering is covered independently by #7958.
case empty-private-params-run
source tests/spmd/empty_private_params.tl
do link-run
mode scalar avx2 avx512
opt 1 2
exit 42
in stderr
empty

case empty-private-params-debug-run
source tests/spmd/empty_private_params.tl
do link-run
mode scalar avx2 avx512
opt 1 2
args -g
exit 42
in stderr
empty
in asm
match \.loc |\.cv_loc

# #9340: debug SIMD callers use the same full-width home census as release.
# Keep the independent correct-result oracle, including inactive shifts and
# varying matches; agreement on a wrong exit is not sufficient.
case debug-caller-results
source tests/spmd/{{each}}.tl
each byte_mul_value_types byte_shift_inactive_invalid byte_shift_value_types map_fused_reduce_i64 map_shift_value_types masked_if_shift_inactive masked_if_shift_value_types private_helper_bool private_helper_entry_uniform_float private_helper_f64 private_helper_i64 private_helper_mask_arg private_helper_masked_load private_helper_store private_helper_uniform_stack private_helper_uniform_stack_f64 varying_match_enum_payload varying_match_i64 word_shift_inactive_invalid word_shift_value_types
do link-run
mode scalar avx2 avx512
opt 1 2
args -g
exit 42
in stdout
empty
in stderr
empty
in asm
match \.loc |\.cv_loc

case debug-caller-shift-traps
source tests/spmd/{{each}}.tl
each byte_shift_large_trap byte_shift_negative_trap map_shift_negative_trap masked_if_shift_large_trap masked_if_shift_negative_trap word_shift_large_trap word_shift_negative_trap
do link-run
mode scalar avx2 avx512
opt 1 2
args -g
exit 129
in stdout
empty
in stderr
contains shift count out of range

case debug-caller-wide-uniform-stack
source tests/spmd/private_helper_uniform_stack_f64_wide.tl
do link-run
mode scalar avx2
opt 1 2
args -g
exit 42
in stderr
empty

# This existing fixture exceeds the admitted AVX-512 private argument window.
# Debug must retain its release diagnostic, rather than execute a partial ABI.
case debug-caller-wide-avx512-boundary
source tests/spmd/private_helper_uniform_stack_f64_wide.tl
mode avx512
opt 1 2
args -g
exit 1
in stderr
contains backend: private AVX-512 SPMD call supports at most 8 varying value arguments

