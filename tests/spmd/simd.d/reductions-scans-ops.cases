# SPMD SIMD codegen shapes and trap paths, run by scripts/verify-spmd-simd.sh
# (gate stage2-spmd-simd-comparison). See tests/spmd/simd.d/.

target -
opt -

# --------------------------------------------------------------- reductions

# AVX2 sums accumulate four full gangs independently. The remainder updates
# one vector, and horizontal reduction stays outside both loops.
case reduce-accumulator
source tests/integration/spmd_reduce_scalar.tl
mode avx2 avx512
opt 2
in fn _tl_spmd_reduce_scalar_reduce_sum
match vextract|vpsrldq
narrow ranges:spmd_reduce_avx2_body~spmd_reduce_tail
count-fixed = 1 vpaddq
not-match vextract|vpsrldq
if-mode avx2
in fn _tl_spmd_reduce_scalar_reduce_sum
narrow ranges:spmd_reduce_group_body~spmd_reduce_group_merge
count-fixed = 4 vpaddq
not-match vextract|vpsrldq
end-if
in fn _tl_spmd_reduce_scalar_reduce_min
contains spmd_reduce_avx2_body
if-mode avx2
contains vextracti128
contains vpcmpgtq
contains vpblendvb
else
contains vpminsq
end-if
in fn _tl_spmd_reduce_scalar_reduce_max
contains spmd_reduce_avx2_body
if-mode avx2
contains vextracti128
contains vpcmpgtq
contains vpblendvb
else
contains vpmaxsq
end-if
in fn _tl_spmd_reduce_scalar_reduce_all_bool
contains spmd_reduce_avx2_body
if-mode avx2
contains vpmovmskb
contains sete
else
contains kortestq
contains setc
end-if
in fn _tl_spmd_reduce_scalar_reduce_any_bool
contains spmd_reduce_avx2_body
contains setne
if-mode avx2
contains vpmovmskb
else
contains kortestq
end-if

# The counted-loop unroller emits sixteen map+accumulator pairs and keeps one
# original pair as the remainder loop.
case map-fused-reduce
source tests/spmd/map_fused_reduce_i64.tl
mode avx2 avx512
opt 2
in fn _tl_map_fused_reduce_i64_reduce_map_fused
match vextract|vpsrldq
narrow ranges:spmd_reduce_value_body~spmd_reduce_value_tail_init
count-fixed = 34 vpaddq
not-match vextract|vpsrldq
if-mode avx2
in fn _tl_map_fused_reduce_i64_reduce_map_fused
narrow ranges:spmd_reduce_group_body~spmd_reduce_group_merge
count-fixed = 8 vpaddq
not-match vextract|vpsrldq
end-if
in fn _tl_map_fused_reduce_i64_reduce_map_surface
contains vpsubq
contains vpor
contains vpxor
contains vpaddq
in fn _tl_map_fused_reduce_i64_reduce_map_shift
contains vpsllvq
contains vpaddq
match call (\.L_tl_abort_)?tl_shift_abort

# -------------------------------------------------------------------- scans

case scan-prefix
source tests/integration/spmd_scan_scalar.tl
mode avx2 avx512
opt 2
if-mode avx2
contains spmd_scan_avx2_body
contains vpslldq
contains vperm2i128
contains vpaddq
contains vpaddd
contains vpminsd
contains vpmaxsd
contains vpcmpgtq
contains vpbroadcastb
not-match %zmm[0-9]+|%k[0-7]
in fn _tl_spmd_scan_scalar_scan_sum_i64
narrow ranges:spmd_scan_avx2_body~spmd_scan_tail_init
contains vpslldq
contains vperm2i128
contains vpermq $255
contains vpaddq
not-match vextract|vpsrldq
else
contains spmd_scan_avx512_body
contains valignd
contains valignq
contains vpaddd
contains vpaddq
contains vpminsd
contains vpminsq
contains vpmaxsd
contains vpmaxsq
contains kmovq
contains shlq $32
not-contains spmd_scan_avx2_body
in fn _tl_spmd_scan_scalar_scan_sum_i64
narrow ranges:spmd_scan_avx512_body~spmd_scan_tail_init
contains valignq
contains vpaddq
not-match vextract|vpsrldq
end-if

# Prefix work registers 14 and 15 are backend scratch, but their low halves
# are nonvolatile on Win64.
case scan-prefix-win64-scratch
source tests/integration/spmd_scan_scalar.tl
target windows-x86_64
mode avx2 avx512
opt 2
in fn _tl_spmd_scan_scalar_scan_min_i64
if-mode avx2
match vmovdqu %ymm14, [0-9]+\(%rsp\)
match vmovdqu [0-9]+\(%rsp\), %ymm14
else
match vmovdqu64 %zmm14, [0-9]+\(%rsp\)
match vmovdqu64 [0-9]+\(%rsp\), %zmm14
end-if

# Scan range and destination checks stay scalar-observable with vector
# prefixes; the short output completes one i64 gang before the scalar tail
# reaches the first invalid destination.
case scan-negative-start-trap
source tests/integration/spmd_scan_negative_start_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case scan-short-output-trap
source tests/integration/spmd_scan_short_output_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

# Compact uses the same ordered scalar scaffold in every mode: cursor overflow
# and an invalid selected destination abort before a later effect.
case compact-overflow-trap
source tests/integration/spmd_compact_overflow_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case compact-destination-oob-trap
source tests/integration/spmd_compact_destination_oob_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

# A rank-2 domain product beyond i64 aborts before the body in every mode
# (#7190).
case foreach-2d-product-trap
source tests/spmd/foreach_2d_product_trap.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

# Rank-2 rows are row-local native gangs (#7191). The row loop is scalar; each
# row enters the 1-D gang planner through row-origin views, so its hot gang
# body stores whole vectors while the row-major multiply and any division stay
# out of it, in the domain checks and the row's preheader.
case foreach-2d-native-row-gangs
source tests/spmd/foreach_2d_native.tl
mode avx2 avx512
in fn _tl_foreach_2d_native_map_i64
order foreach2_header || foreach2_row || foreach_avx2_body
contains row_origin_native
contains row_origin_scalar
contains foreach_tail_mask
narrow labeled-block:foreach_avx2_body
match ^[[:space:]]+vmovdqu(64)? %[yz]mm[0-9]+, \(%r[a-z0-9]+,%r[a-z0-9]+,8\)$
not-contains imul
not-contains idiv

# The narrow-lane kernel gangs 8 (AVX2) or 16 (AVX-512) i32 lanes per row.
case foreach-2d-native-row-gangs-i32
source tests/spmd/foreach_2d_native.tl
mode avx2 avx512
in fn _tl_foreach_2d_native_map_i32
narrow labeled-block:foreach_avx2_body
match ^[[:space:]]+vmovdqu(32)? %[yz]mm[0-9]+, \(%r[a-z0-9]+,%r[a-z0-9]+,4\)$

# Row-range safety (#7191): a destination or source first too short on a later
# row, a row origin before the array, and an origin whose index wraps past i64
# all abort at the scalar reference's first out-of-bounds access, and no gang
# touches memory outside the arrays.
case foreach-2d-native-short-dest
source tests/spmd/foreach_2d_native_short_dest.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case foreach-2d-native-short-src
source tests/spmd/foreach_2d_native_short_src.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case foreach-2d-native-negative-origin
source tests/spmd/foreach_2d_native_negative_origin.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

case foreach-2d-native-overflow-origin
source tests/spmd/foreach_2d_native_overflow_origin.tl
do link-run
mode scalar avx2 avx512
exit 134
in stderr
contains array index out of bounds

# ------------------------------------------------------------ map operators

case map-operator-surface
source tests/integration/spmd_foreach.tl
mode avx2 avx512
opt 2
in fn _tl_spmd_foreach_fill_i64_foreach
contains vpsubq
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_u64_foreach
contains vpsubq
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_i32_foreach
contains vpsubd
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_u32_foreach
contains vpsubd
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_i16_foreach
contains vpsubw
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_u16_foreach
contains vpsubw
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_i8_foreach
contains vpsubb
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_u8_foreach
contains vpsubb
contains vpor
contains vpxor
in fn _tl_spmd_foreach_fill_f64_foreach
contains vsubpd
in fn _tl_spmd_foreach_fill_f32_foreach
contains vsubps

# Byte multiplies expand to packed words (two vpmullw, three right and two left
# byte shifts) stitched back with one OR, never a scalar imul in the gang.
case byte-mul
source tests/spmd/byte_mul_value_types.tl
mode avx2 avx512
in fn _tl_byte_mul_value_types_fill_i8
narrow ranges:foreach_avx2_body~foreach_tail_header
count-fixed = 2 vpmullw
count-fixed = 3 vpsrlw $8
count-fixed = 2 vpsllw $8
not-match ^[[:space:]]+imul
if-mode avx2
count-fixed = 1 vpor
contains %ymm
else
count-fixed = 1 vpord
contains %zmm
end-if
in fn _tl_byte_mul_value_types_fill_u8
narrow ranges:foreach_avx2_body~foreach_tail_header
count-fixed = 2 vpmullw
count-fixed = 3 vpsrlw $8
count-fixed = 2 vpsllw $8
not-match ^[[:space:]]+imul
if-mode avx2
count-fixed = 1 vpor
contains %ymm
else
count-fixed = 1 vpord
contains %zmm
end-if
in fn _tl_byte_mul_value_types_fill_masked
contains vpmullw
in fn _tl_byte_mul_value_types_fill_masked_u8
contains vpmullw
in fn _tl_byte_mul_value_types_fill_while
contains vpmullw
in fn _tl_byte_mul_value_types_fill_while_u8
contains vpmullw

case byte-mul-reduce-reject
source tests/spmd/byte_mul_reduce_reject.tl
mode avx2 avx512
exit nonzero
in stderr
contains typecheck: spmd-reduce sum requires an i32, i64, f32, or f64 type

case map-compare
source tests/spmd/map_compare_surface.tl
mode avx2 avx512
in fn _tl_map_compare_surface_case_i64_predicates
if-mode avx2
contains vpcmpeqq
contains vpcmpgtq
else
contains vpcmpq
end-if
in fn _tl_map_compare_surface_case_other_lanes
contains vcmpps
contains vcmppd
if-mode avx2
contains vpcmpgtd
else
contains vpcmpud
end-if

