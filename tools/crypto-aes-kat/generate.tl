;; Deterministically translate the eight pinned CAVP [ENCRYPT] sections into
;; public TypeLisp vector fixtures. Input hashes are checked by the shell wrapper.
(import stdlib.byte_buf)
(import stdlib.io)
(import stdlib.str_cat)
(import stdlib.string)

(define (field [line : (& line str)] [prefix : String]) : String
  (let
    [length : i64 (string.string-length (& prefix))]
    (if (and
      (>= (string.string-length line) length)
      (string.eq (string.substring-view line 0 length) (& prefix)))
      (string.substring line length (- (string.string-length line) length))
      "")))

(define (hex? [value : (& value str)] [length : i64]) : bool
  (let
    [valid : bool (= (string.string-length value) length)]
    [index : i64 0]
    (while (< index (string.string-length value))
      (let
        [byte : char (string.string-ref value index)]
        (when
          (not
            (or
              (and (>= byte '0') (<= byte '9'))
              (and (>= byte 'a') (<= byte 'f'))))
          (set! valid false)))
      (set! index (+ index 1)))
    valid))

(define (section [path : String] [key-length : i64] [expected : i64]) : String
  (let
    [text : String (byte_buf.to-string (io.read-file path))]
    [offset : i64 0]
    [encrypt : bool false]
    [key : String ""]
    [plain : String ""]
    [output : String ""]
    [count : i64 0]
    [record : i64 0]
    (while (< offset (string.string-length (& text)))
      (let
        [end : i64 (string.index-of-byte (& text) offset (cast 10 : u8))]
        (when (< end 0) (set! end (string.string-length (& text))))
        (let
          [line : String
            (string.trim (string.substring-view (& text) offset (- end offset)))]
          (cond
            [(string.eq (& line) "[ENCRYPT]") (set! encrypt true)]
            [(string.eq (& line) "[DECRYPT]") (set! encrypt false)]
            [(and
                encrypt
                (> (string.string-length (& line)) 0)
                (!= (string.string-ref (& line) 0) '#'))
              (let
                [ordinal : String (field (& line) "COUNT = ")]
                [next-key : String (field (& line) "KEY = ")]
                [next-plain : String (field (& line) "PLAINTEXT = ")]
                [cipher : String (field (& line) "CIPHERTEXT = ")]
                [count-text : String (string.int->string count)]
                (cond
                  [(> (string.string-length (& ordinal)) 0)
                    (when
                      (or
                        (!= record 0)
                        (not (string.eq (& ordinal) (& count-text))))
                      (io.panic "bad CAVP ordinal"))
                    (set! record 1)]
                  [(> (string.string-length (& next-key)) 0)
                    (when
                      (or (!= record 1) (not (hex? (& next-key) key-length)))
                      (io.panic "bad CAVP key"))
                    (set! key next-key)
                    (set! record 2)]
                  [(> (string.string-length (& next-plain)) 0)
                    (when
                      (or (!= record 2) (not (hex? (& next-plain) 32)))
                      (io.panic "bad CAVP plaintext"))
                    (set! plain next-plain)
                    (set! record 3)]
                  [(> (string.string-length (& cipher)) 0)
                    (when
                      (or (!= record 3) (not (hex? (& cipher) 32)))
                      (io.panic "bad CAVP ciphertext"))
                    (set! output (str_cat.str-cat output key plain cipher))
                    (set! count (+ count 1))
                    (set! record 0)]
                  [else (io.panic "unexpected CAVP field")]))]
            [else unit]))
        (set! offset (+ end 1))))
    (when
      (or (!= count expected) (!= record 0))
      (io.panic "incomplete CAVP corpus"))
    output))

(define (main) : i64
  (if (!= (io.arg-count) 3)
    (begin
      (io.eprintln "usage: generate <pinned-rsp-directory> <output.tl>")
      2)
    (let
      [names : (Array String 8)
        (array
          "ECBGFSbox128"
          "ECBGFSbox256"
          "ECBKeySbox128"
          "ECBKeySbox256"
          "ECBVarKey128"
          "ECBVarKey256"
          "ECBVarTxt128"
          "ECBVarTxt256")]
      [counts : (Array i64 8) (array 7 5 21 16 128 256 128 128)]
      [output : String
        ";; Generated by scripts/regenerate-crypto-aes-kat.sh. Public NIST KAT data.\n;; Provenance and pinned source hashes: tests/fixtures/crypto-aes/README.md.\n(import stdlib.tests.crypto_aes_core_inline as driver)\n\n"]
      [index : i64 0]
      (while (< index 8)
        (let
          [wide : bool (= (% index 2) 1)]
          [name : String (string.copy (& (array-ref names index)))]
          [count : i64 (array-ref counts index)]
          [data : String
            (section
              (str_cat.str-cat (io.arg 1) "/" name ".rsp")
              (if wide
                64
                32)
              count)]
          (set!
            output
            (str_cat.str-cat
              output
              "(test aes-kat-"
              (string.int->string index)
              "\n  (driver.corpus "
              (if wide
                "true"
                "false")
              " "
              (string.int->string count)
              " \""
              data
              "\"))\n\n")))
        (set! index (+ index 1)))
      (io.write-file (io.arg 2) (byte_buf.str-as-bytes (& output)))
      0)))