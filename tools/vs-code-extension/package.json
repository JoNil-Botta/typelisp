{
  "name": "typelisp",
  "displayName": "TypeLisp",
  "description": "Syntax highlighting and LSP client for the TypeLisp language.",
  "version": "0.0.1",
  "publisher": "typelisp",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoNil-Botta/typelisp.git",
    "directory": "tools/vs-code-extension"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:typelisp",
    "workspaceContains:**/*.tl",
    "onCommand:typelisp.restartLanguageServer"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "lint": "npm run check",
    "package": "npm run package:smoke",
    "package:smoke": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/typelisp-0.0.1.vsix",
    "smoke": "npm run compile && npm run package:smoke"
  },
  "contributes": {
    "languages": [
      {
        "id": "typelisp",
        "aliases": [
          "TypeLisp",
          "typelisp"
        ],
        "extensions": [
          ".tl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typelisp",
        "scopeName": "source.typelisp",
        "path": "./syntaxes/typelisp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "typelisp.restartLanguageServer",
        "title": "TypeLisp: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "TypeLisp",
      "properties": {
        "typelisp.executablePath": {
          "type": "string",
          "default": "typelisp",
          "description": "Path to the `typelisp` executable used to launch the LSP server (`typelisp lsp`). Defaults to `typelisp` on PATH."
        },
        "typelisp.stdlibRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra `--stdlib-root` directories passed to `typelisp lsp`, in order."
        },
        "typelisp.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Connect to the TypeLisp LSP server (`typelisp lsp`) for diagnostics and editor features."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "8.1.0"
  },
  "devDependencies": {
    "@types/vscode": "1.75.1",
    "@vscode/vsce": "2.32.0",
    "typescript": "5.9.3"
  }
}
