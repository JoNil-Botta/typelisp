{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TypeLisp",
  "scopeName": "source.typelisp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#definition-name" },
    { "include": "#bindings" },
    { "include": "#user-types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.typelisp",
          "comment": "Public documentation comments: ;# module docs, ;: outer item docs.",
          "match": ";[#:].*$"
        },
        {
          "name": "comment.line.semicolon.typelisp",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.typelisp",
          "match": "\\\\(n|t|r|0|\\\\|\"|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "char-literals": {
      "patterns": [
        {
          "name": "constant.character.named.typelisp",
          "comment": "Named char literal: #\\space' #\\newline' #\\tab' #\\return' #\\nul'.",
          "match": "#\\\\[A-Za-z]{2,}'"
        },
        {
          "name": "constant.character.escape.typelisp",
          "comment": "Escaped char literal: #\\n' #\\t' #\\0' #\\a'.",
          "match": "#\\\\.'"
        },
        {
          "name": "constant.character.typelisp",
          "comment": "Single-character literal: #a' #0' #(' # '.",
          "match": "#.'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.typelisp",
          "match": "(?<![\\w-])-?0x[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.typelisp",
          "match": "(?<![\\w-])-?0b[01]+"
        },
        {
          "name": "constant.numeric.float.typelisp",
          "match": "(?<![\\w-])-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.integer.typelisp",
          "match": "(?<![\\w-])-?[0-9]+"
        }
      ]
    },
    "keywords": {
      "comment": "Special forms, declarations, and core macros, recognised only in head position.",
      "name": "keyword.control.typelisp",
      "match": "(?<=\\()(comptime-decls|comptime-decl|comptime|defdispatch|defstruct|defmacro|defenum|define|include-str|include-bin|spmd-broadcast|spmd-reduce|with-arena|with-escape|with|unquote-splicing|unquote|quasiquote|quote|foreach|unsafe|return|export|extern|import|module|lambda|begin|while|match|unless|when|cond|cast|test|try|set!|type|init|ann|let|and|or|if)(?=[\\s)])"
    },
    "builtins": {
      "comment": "Built-in intrinsic operations and constructors, recognised in head position.",
      "name": "support.function.builtin.typelisp",
      "match": "(?<=\\()(ptr-addr-of|ptr-offset|ptr-write!|ptr-null\\?|ptr-null|ptr-read|ptr-cast|ptr->int|int->ptr|array-push!|array-set!|array-data|array-ref|make-array|tuple-ref|struct-get|string-from-bytes|string-data|program-argc|program-argv|program-envp|cpuid-eax|cpuid-ebx|cpuid-ecx|cpuid-edx|xgetbv|syscall|box-get|box|array|tuple)(?=[\\s)])"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.typelisp",
          "comment": "Function-type arrow, only in head position so it never matches inside names like string->int.",
          "match": "(?<=\\()->(?=[\\s)])"
        },
        {
          "name": "keyword.operator.arithmetic.typelisp",
          "match": "(?<=\\()(!=|<=|>=|\\+|\\-|\\*|/|%|=|<|>)(?=[\\s)])"
        },
        {
          "name": "keyword.operator.word.typelisp",
          "match": "(?<=\\()(bit-and|bit-or|bit-xor|bit-not|shl|shr|not|neg)(?=[\\s)])"
        },
        {
          "name": "keyword.operator.reference.typelisp",
          "match": "(?<=\\()(&mut|&)(?=[\\s)])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.typelisp",
          "match": "(?<![\\w-])(true|false)(?![\\w-])"
        }
      ]
    },
    "types": {
      "comment": "Built-in primitive and constructor types.",
      "name": "storage.type.typelisp",
      "match": "(?<![\\w-])(i64|i32|i16|i8|u64|u32|u16|u8|f64|f32|bool|char|String|str|unit|never|Array|Tuple|Box|MutPtr|Ptr)(?![\\w-])"
    },
    "definition-name": {
      "patterns": [
        {
          "comment": "Function/value name introduced by (define ...).",
          "match": "(?<=\\(define\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_!?*/<>=+-]*)",
          "captures": {
            "1": { "name": "entity.name.function.typelisp" }
          }
        },
        {
          "comment": "Macro name introduced by (defmacro ...).",
          "match": "(?<=\\(defmacro\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_!?*/<>=+-]*)",
          "captures": {
            "1": { "name": "entity.name.function.typelisp" }
          }
        },
        {
          "comment": "Dispatch name introduced by (defdispatch ...).",
          "match": "(?<=\\(defdispatch\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_!?*/<>=+-]*)",
          "captures": {
            "1": { "name": "entity.name.function.typelisp" }
          }
        },
        {
          "comment": "Struct type name introduced by (defstruct ...).",
          "match": "(?<=\\(defstruct\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "entity.name.type.typelisp" }
          }
        },
        {
          "comment": "Enum type name introduced by (defenum ...).",
          "match": "(?<=\\(defenum\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "entity.name.type.typelisp" }
          }
        }
      ]
    },
    "bindings": {
      "comment": "Binding/parameter name: the first identifier inside [ ... ] (function params and let bindings).",
      "match": "(?<=\\[)\\s*([A-Za-z_][A-Za-z0-9_!?*/<>=+-]*)",
      "captures": {
        "1": { "name": "variable.parameter.typelisp" }
      }
    },
    "user-types": {
      "comment": "PascalCase identifiers (user types and enum constructors).",
      "name": "entity.name.type.typelisp",
      "match": "(?<![\\w-])[A-Z][A-Za-z0-9_]*(?![\\w-])"
    }
  }
}
