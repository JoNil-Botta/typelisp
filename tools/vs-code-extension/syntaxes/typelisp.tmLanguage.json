{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TypeLisp",
  "scopeName": "source.typelisp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#special-forms" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#definition-name" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.typelisp",
          "comment": "Public documentation comments: ;# module docs, ;: outer item docs.",
          "match": ";[#:].*$"
        },
        {
          "name": "comment.line.semicolon.typelisp",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.typelisp",
          "match": "\\\\(n|t|r|0|\\\\|\"|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "char-literals": {
      "patterns": [
        {
          "name": "constant.character.named.typelisp",
          "comment": "Named/escaped char literal, e.g. #\\space' or #\\a'.",
          "match": "#\\\\[A-Za-z]+'"
        },
        {
          "name": "constant.character.typelisp",
          "comment": "Single-character literal, e.g. #a' #(' #0' # '.",
          "match": "#.'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.typelisp",
          "match": "(?<![\\w-])-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.integer.typelisp",
          "match": "(?<![\\w-])-?[0-9]+"
        }
      ]
    },
    "special-forms": {
      "name": "keyword.control.typelisp",
      "match": "(?<=\\()(define|lambda|if|let|begin|while|set!|return|match|foreach|with-arena|with-arena|with|unsafe|ann|cast|extern|import|module|test|defenum|defstruct|comptime|spmd-reduce)(?=[\\s)])"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.typelisp",
          "match": "(?<![\\w-])(true|false)(?![\\w-])"
        },
        {
          "name": "constant.language.typelisp",
          "match": "(?<![\\w-])(unit)(?![\\w-])"
        }
      ]
    },
    "types": {
      "name": "storage.type.typelisp",
      "match": "(?<![\\w-])(i64|i32|i16|i8|u64|u32|u16|u8|f64|f32|bool|char|String|str|unit|never|Array|Tuple)(?![\\w-])"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.typelisp",
          "match": "->"
        },
        {
          "name": "keyword.operator.reference.typelisp",
          "match": "(?<=\\()(&mut|&)(?=[\\s)])"
        }
      ]
    },
    "definition-name": {
      "comment": "Highlight the name introduced by a (define ...) form.",
      "patterns": [
        {
          "match": "(?<=\\(define\\s)\\s*\\(?\\s*([A-Za-z_][A-Za-z0-9_!?*+/<>=-]*)",
          "captures": {
            "1": { "name": "entity.name.function.typelisp" }
          }
        }
      ]
    }
  }
}
